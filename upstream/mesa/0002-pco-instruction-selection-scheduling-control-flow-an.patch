+/* Ops with a phase 1 encoding, i.e. that can be co-issued in phase 1. */
+static bool is_p1_op(const pco_instr *instr)
+{
+   switch (instr->op) {
+   case PCO_OP_FADD:
+   case PCO_OP_FMUL:
+   case PCO_OP_FMAD:
+   case PCO_OP_MBYP:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* Phase 0 ops that a phase 1 op may be co-issued with. The single-unit ops
+ * (FRCP/FRSQ/FLOG/FEXP/FSINC, and FRED) are left out: co-issuing with them
+ * produced wrong results on BXM-4-64.
+ */
+static bool is_p0_pairable(const pco_instr *instr)
+{
+   switch (instr->op) {
+   case PCO_OP_FADD:
+   case PCO_OP_FMUL:
+   case PCO_OP_FMAD:
+   case PCO_OP_MBYP:
+   case PCO_OP_UNPCK:
+   case PCO_OP_IMADD32:
+   case PCO_OP_IADD32:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* Register-only ops that a phase 1 op may be hoisted across. */
+static bool is_plain_alu_op(pco_instr *instr)
+{
+   switch (instr->op) {
+   case PCO_OP_FADD:
+   case PCO_OP_FMUL:
+   case PCO_OP_FMAD:
+   case PCO_OP_MBYP:
+   case PCO_OP_FRCP:
+   case PCO_OP_FRSQ:
+   case PCO_OP_FLOG:
+   case PCO_OP_FEXP:
+   case PCO_OP_FRED:
+   case PCO_OP_FSINC:
+   case PCO_OP_PCK:
+   case PCO_OP_UNPCK:
+   case PCO_OP_IMADD32:
+   case PCO_OP_IADD32:
+   case PCO_OP_MIN:
+   case PCO_OP_MAX:
+   case PCO_OP_PSEL_TRIG:
+      return pco_instr_has_default_exec(instr);
+   default:
+      return false;
+   }
+}
+
+static inline bool refs_overlap(pco_ref a, pco_ref b)
+{
+   if (!pco_ref_is_reg(a) && !pco_ref_is_idx_reg(a))
+      return false;
+   if (!pco_ref_is_reg(b) && !pco_ref_is_idx_reg(b))
+      return false;
+   return pco_refs_are_overlapping_regs(a, b);
+}
+
+/* Whether moving "later" up to before "earlier" breaks a register dependency.
+ */
+static bool depends_on(const pco_instr *later, const pco_instr *earlier)
+{
+   for (unsigned d = 0; d < earlier->num_dests; ++d) {
+      for (unsigned s = 0; s < later->num_srcs; ++s)
+         if (refs_overlap(later->src[s], earlier->dest[d]))
+            return true;
+      for (unsigned ld = 0; ld < later->num_dests; ++ld)
+         if (refs_overlap(later->dest[ld], earlier->dest[d]))
+            return true;
+   }
+   for (unsigned ld = 0; ld < later->num_dests; ++ld)
+      for (unsigned s = 0; s < earlier->num_srcs; ++s)
+         if (refs_overlap(later->dest[ld], earlier->src[s]))
+            return true;
+   return false;
+}
+
+/* Upper source encodings: sA up to 3 bank/11 index bits, sB/sC 2/8. */
+static bool upper_src_ok(pco_ref ref, unsigned i)
+{
+   if (pco_ref_is_null(ref))
+      return true;
+   if (!pco_ref_is_reg(ref) || !ref_src_map_valid(ref, PCO_IO_S3 + i, NULL))
+      return false;
+   unsigned max_bank = i ? 2 : 3, max_idx = i ? 8 : 11;
+   return pco_map_reg_bank_bits(ref) <= max_bank &&
+          pco_map_reg_index_bits(ref) <= max_idx;
+}
+
+static bool p1_srcs_ok(const pco_instr *instr)
+{
+   for (unsigned s = 0; s < instr->num_srcs; ++s)
+      if (!upper_src_ok(instr->src[s], s))
+         return false;
+   return true;
+}
+
+static bool dual_dest_ok(pco_ref ref)
+{
+   return pco_ref_is_reg(ref) && pco_map_reg_bank_bits(ref) <= 3 &&
+          pco_map_reg_index_bits(ref) <= 11;
+}
+
+/* Swaps the first two (commutative) sources unless a modifier forbids it. */
+static bool swap_commutative_srcs(pco_instr *instr)
+{
+   pco_ref *s0 = &instr->src[0], *s1 = &instr->src[1];
+   if (instr->op == PCO_OP_MBYP || s0->neg || s1->neg || s0->flr || s1->flr)
+      return false;
+   if (instr->op == PCO_OP_FMAD && (s0->abs || s1->abs))
+      return false;
+   pco_ref tmp = *s0;
+   *s0 = *s1;
+   *s1 = tmp;
+   return true;
+}
+
+/* Header fields a phase 1 op would set; must match the group's. */
+static bool hdr_compatible(const pco_igrp *igrp, pco_instr *instr)
+{
+   return igrp->hdr.olchk == pco_instr_get_mod(instr, PCO_OP_MOD_OLCHK) &&
+          igrp->hdr.cc == pco_map_exec_cnd_to_cc(
+                             pco_instr_get_mod(instr, PCO_OP_MOD_EXEC_CND)) &&
+          igrp->hdr.end == pco_instr_get_mod(instr, PCO_OP_MOD_END) &&
+          igrp->hdr.atom == pco_instr_get_mod(instr, PCO_OP_MOD_ATOM) &&
+          igrp->hdr.rpt == pco_instr_get_mod(instr, PCO_OP_MOD_RPT);
+}
+
+static void map_p1(pco_igrp *igrp, pco_instr *instr)
+{
+   pco_instr_set_mod(instr, PCO_OP_MOD_OLCHK, 0);
+   pco_instr_set_mod(instr, PCO_OP_MOD_EXEC_CND, 0);
+   pco_instr_set_mod(instr, PCO_OP_MOD_END, 0);
+   pco_instr_set_mod(instr, PCO_OP_MOD_ATOM, 0);
+   pco_instr_set_mod(instr, PCO_OP_MOD_RPT, 1);
+
+   list_del(&instr->link);
+   igrp->instrs[PCO_OP_PHASE_1] = instr;
+   instr->phase = PCO_OP_PHASE_1;
+   instr->parent_igrp = igrp;
+   ralloc_steal(igrp, instr);
+
+   for (unsigned s = 0; s < instr->num_srcs; ++s) {
+      igrp->srcs.s[3 + s] = instr->src[s];
+      instr->src[s] = pco_ref_io(PCO_IO_S3 + s);
+      pco_ref_xfer_mods(&instr->src[s], &igrp->srcs.s[3 + s], true);
+   }
+
+   igrp->iss.is[5] = pco_ref_io(PCO_IO_FT1);
+   igrp->dests.w[1] = instr->dest[0];
+   instr->dest[0] = pco_ref_io(PCO_IO_FT1);
+   pco_ref_xfer_mods(&instr->dest[0], &igrp->dests.w[1], true);
+
+   switch (instr->op) {
+   case PCO_OP_FADD:
+      igrp->variant.instr[PCO_OP_PHASE_1].main = pco_fadd_variant(instr);
+      break;
+   case PCO_OP_FMUL:
+      igrp->variant.instr[PCO_OP_PHASE_1].main = pco_fmul_variant(instr);
+      break;
+   case PCO_OP_FMAD:
+      igrp->variant.instr[PCO_OP_PHASE_1].main = pco_fmad_variant(instr);
+      break;
+   case PCO_OP_MBYP:
+      igrp->variant.instr[PCO_OP_PHASE_1].main = pco_mbyp_variant(instr);
+      break;
+   default:
+      UNREACHABLE("");
+   }
+
+   igrp->hdr.oporg = PCO_OPORG_P0_P1;
+   igrp->hdr.w1p = true;
+   igrp->variant.hdr = pco_igrp_hdr_variant(igrp);
+   igrp->variant.upper_src = pco_igrp_src_variant(igrp, true);
+   igrp->variant.dest = pco_igrp_dest_variant(igrp);
+}
+
+#define DUAL_ISSUE_WINDOW 8
+
+/**
+ * \brief Co-issues a later, independent op in phase 1 of a phase 0-only main
+ *        ALU group; the two phases execute in parallel, so this halves the
+ *        issue cost of the pair.
+ *
+ * \param[in,out] igrp Freshly mapped instruction group.
+ * \param[in] next First not yet grouped instruction.
+ * \param[in] end Block instruction list head.
+ */
+static void
+try_dual_issue(pco_igrp *igrp, struct list_head *next, struct list_head *end)
+{
+   if (PCO_DEBUG(NO_DUAL_ISSUE))
+      return;
+
+   if (igrp->hdr.alutype != PCO_ALUTYPE_MAIN ||
+       igrp->hdr.oporg != PCO_OPORG_P0 || !igrp->instrs[PCO_OP_PHASE_0] ||
+       !is_p0_pairable(igrp->instrs[PCO_OP_PHASE_0]) ||
+       !dual_dest_ok(igrp->dests.w[0]) || !pco_ref_is_null(igrp->dests.w[1]) ||
+       !pco_ref_is_null(igrp->iss.is[5]))
+      return;
+
+   for (unsigned s = 3; s < ARRAY_SIZE(igrp->srcs.s); ++s)
+      if (!pco_ref_is_null(igrp->srcs.s[s]))
+         return;
+
+   pco_instr *between[DUAL_ISSUE_WINDOW];
+   unsigned num_between = 0;
+
+   for (struct list_head *n = next; n != end; n = n->next) {
+      pco_instr *cand = list_entry(n, pco_instr, link);
+
+      if (is_p1_op(cand) && cand->num_dests == 1 &&
+          dual_dest_ok(cand->dest[0]) && hdr_compatible(igrp, cand)) {
+         /* All sources are read before either phase writes back, so the
+          * phase 1 op may overwrite a phase 0 source, but must neither read
+          * nor write the phase 0 dest.
+          */
+         bool ok = !refs_overlap(cand->dest[0], igrp->dests.w[0]);
+         for (unsigned s = 0; s < cand->num_srcs && ok; ++s)
+            ok = !refs_overlap(cand->src[s], igrp->dests.w[0]);
+         for (unsigned i = 0; i < num_between && ok; ++i)
+            ok = !depends_on(cand, between[i]);
+
+         if (ok && !p1_srcs_ok(cand)) {
+            ok = swap_commutative_srcs(cand);
+            if (ok && !p1_srcs_ok(cand)) {
+               swap_commutative_srcs(cand);
+               ok = false;
+            }
+         }
+
+         if (ok) {
+            map_p1(igrp, cand);
+            return;
+         }
+      }
+
+      if (!is_plain_alu_op(cand) || num_between == DUAL_ISSUE_WINDOW)
+         return;
+      between[num_between++] = cand;
+   }
+}
+
+/* Phase 0-only ops whose result can feed phase 2 of the next group. */
+static bool is_p0_foldable(const pco_instr *instr)
+{
+   switch (instr->op) {
+   case PCO_OP_FADD:
+   case PCO_OP_FMUL:
+   case PCO_OP_FMAD:
+   case PCO_OP_IMADD32:
+   case PCO_OP_IADD32:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/**
+ * \brief Folds a phase 0-only group into the next group when that group's
+ *        phase 0 only moves the first group's result (e.g. min/max after an
+ *        ALU op): the op then runs in phase 0 and phase 2 reads its ft0.
+ *
+ * \param[in,out] prev Previous instruction group (removed on success).
+ * \param[in,out] igrp Current instruction group.
+ * \return True if prev was folded into igrp.
+ */
+static bool try_fold_into_next(pco_igrp *prev, pco_igrp *igrp)
+{
+   if (PCO_DEBUG(NO_DUAL_ISSUE))
+      return false;
+
+   if (prev->hdr.alutype != PCO_ALUTYPE_MAIN ||
+       prev->hdr.oporg != PCO_OPORG_P0 || !prev->instrs[PCO_OP_PHASE_0] ||
+       !is_p0_foldable(prev->instrs[PCO_OP_PHASE_0]) ||
+       !dual_dest_ok(prev->dests.w[0]) || !pco_ref_is_null(prev->dests.w[1]))
+      return false;
+
+   for (unsigned s = 3; s < ARRAY_SIZE(prev->srcs.s); ++s)
+      if (!pco_ref_is_null(prev->srcs.s[s]))
+         return false;
+
+   pco_instr *mov = igrp->instrs[PCO_OP_PHASE_0];
+   pco_ref result = prev->dests.w[0];
+   if (igrp->hdr.alutype != PCO_ALUTYPE_MAIN || !mov ||
+       mov->op != PCO_OP_MBYP || mov->src[0].neg || mov->src[0].abs ||
+       !pco_ref_is_reg(igrp->srcs.s[0]) ||
+       pco_ref_get_reg_class(igrp->srcs.s[0]) !=
+          pco_ref_get_reg_class(result) ||
+       pco_ref_get_reg_index(igrp->srcs.s[0]) !=
+          pco_ref_get_reg_index(result) ||
+       pco_ref_get_chans(igrp->srcs.s[0]) != pco_ref_get_chans(result) ||
+       !pco_ref_is_null(igrp->srcs.s[1]) || !pco_ref_is_null(igrp->srcs.s[2]) ||
+       !pco_ref_is_null(igrp->iss.is[0]))
+      return false;
+
+   if (igrp->hdr.olchk != prev->hdr.olchk || igrp->hdr.cc != prev->hdr.cc ||
+       igrp->hdr.end != prev->hdr.end || igrp->hdr.atom != prev->hdr.atom ||
+       igrp->hdr.rpt != prev->hdr.rpt)
+      return false;
+
+   /* The other sources are read before the folded op writes back. */
+   for (unsigned s = 3; s < ARRAY_SIZE(igrp->srcs.s); ++s)
+      if (refs_overlap(igrp->srcs.s[s], result))
+         return false;
+
+   /* Keep the folded op's own write unless igrp overwrites it anyway. */
+   bool keep_result = !refs_overlap(igrp->dests.w[0], result) &&
+                      !refs_overlap(igrp->dests.w[1], result);
+   if (keep_result && (!pco_ref_is_null(igrp->dests.w[1]) ||
+                       !pco_ref_is_null(igrp->iss.is[5])))
+      return false;
+
+   pco_instr *op = prev->instrs[PCO_OP_PHASE_0];
+   igrp->instrs[PCO_OP_PHASE_0] = op;
+   op->parent_igrp = igrp;
+   ralloc_steal(igrp, op);
+   ralloc_free(mov);
+
+   for (unsigned s = 0; s < 3; ++s)
+      igrp->srcs.s[s] = prev->srcs.s[s];
+   igrp->variant.instr[PCO_OP_PHASE_0] = prev->variant.instr[PCO_OP_PHASE_0];
+
+   if (keep_result) {
+      igrp->iss.is[5] = pco_ref_io(PCO_IO_FT0);
+      igrp->dests.w[1] = result;
+      igrp->hdr.w1p = true;
+   }
+
+   igrp->variant.hdr = pco_igrp_hdr_variant(igrp);
+   igrp->variant.lower_src = pco_igrp_src_variant(igrp, false);
+   igrp->variant.dest = pco_igrp_dest_variant(igrp);
+
+   list_del(&prev->link);
+   return true;
+}
+
+/* Whether instr reads a value that earlier defines (SSA or hardware register).
+ */
+static bool reads_def_of(const pco_instr *instr, const pco_instr *earlier)
+{
+   for (unsigned d = 0; d < earlier->num_dests; ++d) {
+      pco_ref dest = earlier->dest[d];
+      for (unsigned s = 0; s < instr->num_srcs; ++s) {
+         pco_ref src = instr->src[s];
+         if (pco_ref_is_ssa(dest) && pco_ref_is_ssa(src) && src.val == dest.val)
+            return true;
+         if (refs_overlap(src, dest))
+            return true;
+      }
+   }
+   return false;
+}
+
+/* Pre-RA phase 1 candidate: hardware-register sources must fit s3-s5. */
+static bool is_p1_candidate(pco_instr *instr)
+{
+   if (!is_p1_op(instr) || instr->num_dests != 1 ||
+       !pco_ref_is_ssa(instr->dest[0]) || !pco_instr_has_default_exec(instr))
+      return false;
+
+   for (unsigned s = 0; s < instr->num_srcs; ++s) {
+      pco_ref ref = instr->src[s];
+      if (pco_ref_is_hwreg(ref) && !upper_src_ok(ref, s))
+         return false;
+   }
+   return true;
+}
+
+#define DUAL_ISSUE_SCHED_WINDOW 8
+
+/* A later candidate that can move up to just after a. */
+static pco_instr *find_hoist(pco_block *block, pco_instr *a, struct set *paired)
+{
+   pco_instr *between[DUAL_ISSUE_SCHED_WINDOW];
+   unsigned num_between = 0;
+
+   for (struct list_head *n = a->link.next; n != &block->instrs; n = n->next) {
+      pco_instr *b = list_entry(n, pco_instr, link);
+      if (!_mesa_set_search(paired, b) && is_p1_candidate(b) &&
+          !reads_def_of(b, a)) {
+         bool ok = true;
+         for (unsigned i = 0; i < num_between && ok; ++i)
+            ok = !reads_def_of(b, between[i]);
+         if (ok)
+            return b;
+      }
+      if (!is_plain_alu_op(b) || num_between == DUAL_ISSUE_SCHED_WINDOW)
+         return NULL;
+      between[num_between++] = b;
+   }
+   return NULL;
+}
+
+/* An earlier candidate whose result nothing up to a reads, to sink after a. */
+static pco_instr *find_sink(pco_block *block, pco_instr *a, struct set *paired)
+{
+   unsigned seen = 0;
+
+   for (struct list_head *n = a->link.prev; n != &block->instrs; n = n->prev) {
+      pco_instr *b = list_entry(n, pco_instr, link);
+      if (!is_plain_alu_op(b) || ++seen > DUAL_ISSUE_SCHED_WINDOW)
+         return NULL;
+      if (_mesa_set_search(paired, b) || !is_p1_candidate(b))
+         continue;
+
+      bool used = false;
+      for (struct list_head *m = b->link.next;; m = m->next) {
+         pco_instr *user = list_entry(m, pco_instr, link);
+         /* Nothing up to a may read b's result, nor write a register b
+          * reads (a virtual register, with b after its load was propagated).
+          */
+         if (reads_def_of(user, b) || depends_on(b, user)) {
+            used = true;
+            break;
+         }
+         if (user == a)
+            break;
+      }
+      if (!used)
+         return b;
+   }
+   return NULL;
+}
+
+/**
+ * \brief Pre-RA scheduling for dual issue: on SSA there are no false
+ *        dependencies, so place an independent phase 1-capable op right
+ *        after each phase 0 op (hoisting a later one or sinking an earlier
+ *        one); pco_group_instrs then co-issues the pair.
+ */
+bool pco_dual_issue_sched(pco_shader *shader)
+{
+   bool progress = false;
+
+   if (PCO_DEBUG(NO_DUAL_ISSUE))
+      return false;
+
+   pco_foreach_func_in_shader (func, shader) {
+      struct set *paired = _mesa_pointer_set_create(NULL);
+
+      pco_foreach_block_in_func (block, func) {
+         for (struct list_head *pos = block->instrs.next; pos != &block->instrs;
+              pos = pos->next) {
+            pco_instr *a = list_entry(pos, pco_instr, link);
+            if (_mesa_set_search(paired, a) || !is_p0_pairable(a) ||
+                !pco_instr_has_default_exec(a))
+               continue;
+
+            pco_instr *b = find_hoist(block, a, paired);
+            if (!b)
+               b = find_sink(block, a, paired);
+            if (!b)
+               continue;
+
+            if (a->link.next != &b->link) {
+               list_del(&b->link);
+               list_add(&b->link, &a->link);
+               progress = true;
+            }
+            _mesa_set_add(paired, a);
+            _mesa_set_add(paired, b);
+            pos = &b->link;
+         }
+      }
+
+      _mesa_set_destroy(paired, NULL);
+   }
+
+   return progress;
+}
