diff --git a/src/imagination/common/pvr_limits.h b/src/imagination/common/pvr_limits.h
index ffe812fe..e2ec468d 100644
--- a/src/imagination/common/pvr_limits.h
+++ b/src/imagination/common/pvr_limits.h
@@ -84,6 +84,8 @@
 #define PVR_XFB_MAX_PTEMPS_SETS \
    (PVR_XFB_MAX_BUFFERS * PVR_XFB_PTEMP_ENTRIES_PER_VARYING)
 #define PVR_XFB_MAX_TOTAL_VARYINGS 128U
+#define PVR_XFB_MAX_DATA_SIZE 512U
+#define PVR_XFB_MAX_DATA_STRIDE 2048U
 
 #define PVR_TEXEL_BUFFER_OFFSET_ALIGNMENT 16U
 #define PVR_UNIFORM_BUFFER_OFFSET_ALIGNMENT 4U
diff --git a/src/imagination/vulkan/pvr_physical_device.c b/src/imagination/vulkan/pvr_physical_device.c
index c100c9ca..d2b172ed 100644
--- a/src/imagination/vulkan/pvr_physical_device.c
+++ b/src/imagination/vulkan/pvr_physical_device.c
@@ -238,6 +238,7 @@ static void pvr_physical_device_get_supported_extensions(
       .EXT_subgroup_size_control = true,
       .EXT_texel_buffer_alignment = true,
       .EXT_tooling_info = true,
+      .EXT_transform_feedback = true,
       .EXT_vertex_attribute_divisor = true,
       .EXT_zero_initialize_device_memory = true,
 #ifdef PVR_USE_WSI_PLATFORM
@@ -537,6 +538,9 @@ static void pvr_physical_device_get_supported_features(
       /* Vulkan 1.3 / VK_EXT_texel_buffer_alignment */
       .texelBufferAlignment = true,
 
+      /* VK_EXT_transform_feedback */
+      .transformFeedback = true,
+
       /* Vulkan 1.2 / VK_KHR_buffer_device_address / VK_EXT_buffer_device_address.
        *
        * The GPU addresses global memory with a 64-bit device VA, and that is
@@ -1136,6 +1140,18 @@ static bool pvr_physical_device_get_properties(
       .maxCustomBorderColorSamplers =
          get_custom_border_color_samplers(&pdevice->dev_info),
 
+      /* EXT_transform_feedback */
+      .maxTransformFeedbackStreams = PVR_XFB_MAX_STREAMS,
+      .maxTransformFeedbackBuffers = PVR_XFB_MAX_BUFFERS,
+      .maxTransformFeedbackBufferSize = UINT32_MAX,
+      .maxTransformFeedbackStreamDataSize = PVR_XFB_MAX_DATA_SIZE,
+      .maxTransformFeedbackBufferDataSize = PVR_XFB_MAX_DATA_SIZE,
+      .maxTransformFeedbackBufferDataStride = PVR_XFB_MAX_DATA_STRIDE,
+      .transformFeedbackQueries = false,
+      .transformFeedbackStreamsLinesTriangles = false,
+      .transformFeedbackRasterizationStreamSelect = false,
+      .transformFeedbackDraw = true,
+
       /* VK_EXT_physical_device_drm */
       .drmHasPrimary = pdevice->has_primary,
       .drmPrimaryMajor = (int64_t) major(pdevice->primary_devid),
