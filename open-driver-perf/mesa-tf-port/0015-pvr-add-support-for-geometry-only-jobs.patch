@@ -1557,7 +1557,7 @@ VkResult pvr_arch_render_job_submit(struct pvr_render_ctx *ctx,
          (rt_dataset->rt_data_idx + 1) % ARRAY_SIZE(rt_dataset->rt_datas);
 
       rt_dataset->need_frag = false;
-   } else {
