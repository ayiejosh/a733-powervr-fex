+      struct pvr_rt_dataset *rt_dataset;
+      struct pvr_suballoc_bo *ppp_state_bo;
+      size_t ppp_state_size;
+   } dummy_rt;
+
    struct {
       pdsc_program *xfb_init;
       pdsc_program *xfb_main;
