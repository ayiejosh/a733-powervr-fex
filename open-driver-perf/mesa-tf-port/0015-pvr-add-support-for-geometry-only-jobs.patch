+
    bool wait_on_previous_transfer;
 
    bool has_depth_feedback;
diff --git a/src/imagination/vulkan/pvr_device.h b/src/imagination/vulkan/pvr_device.h
index d5f2de62..cfb5e87a 100644
--- a/src/imagination/vulkan/pvr_device.h
+++ b/src/imagination/vulkan/pvr_device.h
@@ -187,6 +187,13 @@ struct pvr_device {
 
    struct pvr_border_color_table *border_color_table;
 
