  *
  * Returns: Number of non-signaled native deps remaining.
  */
+static bool
+is_paired_job_fence(struct dma_fence *fence, struct pvr_job *job)
+{
+	/* A fence between paired jobs cannot be turned into a pvr_queue_fence
+	 * (i.e. be backed by a UFO) until both jobs have been submitted, so it
+	 * must be counted as a remaining native dependency manually: the
+	 * submitting code inserts a partial render fence command for it.
+	 */
+	return job->type == DRM_PVR_JOB_TYPE_FRAGMENT && job->paired_job &&
+	       &job->paired_job->base.s_fence->scheduled == fence;
+}
