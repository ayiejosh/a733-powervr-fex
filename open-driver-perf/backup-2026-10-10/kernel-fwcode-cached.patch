+/* Firmware code and data in the device cache, as the vendor driver maps them
+ * (FIRMWARE_CACHED | GPU_CACHE_INCOHERENT). Uncached, every firmware I/D-cache
+ * refill goes to DRAM and each firmware step takes about twice as long (TA ->
+ * 3D handoff ~40 us/frame slower). The CPU only writes these before the
+ * firmware boots, and a reset reinitialises the GPU.
+ */
+static bool fw_code_cached = true;
+module_param(fw_code_cached, bool, 0444);
+MODULE_PARM_DESC(fw_code_cached, "Map firmware code and data through the device cache");
+
+static u64 fw_code_data_flags(void)
+{
+	return fw_code_cached ? PVR_BO_FW_FLAGS_DEVICE_CACHED : PVR_BO_FW_FLAGS_DEVICE_UNCACHED;
+}
