+
+static bool combine_pr = true;
+module_param(combine_pr, bool, 0644);
+MODULE_PARM_DESC(combine_pr,
+		 "Drop the partial render command when it matches the chained fragment command");
+
+/*
+ * A partial render job followed by a chained fragment job with the same
+ * command (userspace builds them from the same state when the partial render
+ * needs no scratch buffer): only its fence goes to the CCCB and the firmware
+ * uses the fragment command if a partial render is needed, as the vendor
+ * driver does when it is given no separate 3D-PR command. The partial render
+ * job's done fence is satisfied by the fragment job's timeline update, which
+ * carries a later seqno.
+ */
+static bool pvr_pr_job_combinable(struct pvr_job *pr_job, struct pvr_job *frag_job)
+{
+	return combine_pr && frag_job &&
+	       pr_job->fw_ccb_cmd_type == ROGUE_FWIF_CCB_CMD_TYPE_FRAG_PR &&
+	       frag_job->fw_ccb_cmd_type == ROGUE_FWIF_CCB_CMD_TYPE_FRAG &&
+	       pr_job->cmd_len == frag_job->cmd_len &&
+	       !memcmp(pr_job->cmd, frag_job->cmd, pr_job->cmd_len);
+}
