    PCO_DEBUG_RA_SKIP_OPT = BITFIELD64_BIT(7),
    PCO_DEBUG_NO_DMA_CACHE = BITFIELD64_BIT(8),
+   PCO_DEBUG_NO_DUAL_ISSUE = BITFIELD64_BIT(9),
 };
 
 extern uint64_t pco_debug;
