+/* A fragment job can ride along a geometry + partial render pair if it targets
+ * the same context and HWRT and it doesn't wait on anything the geometry job
+ * isn't already waiting on, so chaining never delays the geometry job.
+ */
+static bool can_chain_frag_job(struct pvr_job *geom_job, struct pvr_job *pr_job,
+			       struct pvr_job *frag_job)
+{
+	struct dma_fence *f;
+	unsigned long index;
+
+	if (!chain_frag ||
+	    pr_job->fw_ccb_cmd_type != ROGUE_FWIF_CCB_CMD_TYPE_FRAG_PR ||
+	    frag_job->type != DRM_PVR_JOB_TYPE_FRAGMENT ||
+	    frag_job->fw_ccb_cmd_type != ROGUE_FWIF_CCB_CMD_TYPE_FRAG ||
+	    frag_job->ctx != geom_job->ctx ||
+	    frag_job->hwrt != geom_job->hwrt)
+		return false;
+
+	xa_for_each(&frag_job->base.dependencies, index, f) {
+		if (dma_fence_is_signaled(f))
+			continue;
+		if (!drm_sched_job_has_dependency(&geom_job->base, f))
+			return false;
+	}
+
+	return true;
+}
