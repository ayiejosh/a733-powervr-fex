diff --git a/system/zram/zram-writeback-loop.service b/system/zram/zram-writeback-loop.service
new file mode 100644
index 0000000..2051168
--- /dev/null
+++ b/system/zram/zram-writeback-loop.service
@@ -0,0 +1,14 @@
+[Unit]
+Description=Attach the zram writeback backing file as a loop device
+DefaultDependencies=no
+After=local-fs.target
+Before=zramswap.service
+ConditionPathExists=/home/radxa/zram-writeback.img
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+ExecStart=/bin/sh -c 'losetup -j /home/radxa/zram-writeback.img | grep -q . || losetup --find --show /home/radxa/zram-writeback.img'
+
+[Install]
+WantedBy=multi-user.target
diff --git a/system/zram/zramswap.default b/system/zram/zramswap.default
new file mode 100644
index 0000000..a398cd6
--- /dev/null
+++ b/system/zram/zramswap.default
@@ -0,0 +1,22 @@
+# Compression algorithm selection
+# speed: lz4 > zstd 
+# compression: zstd > lz4
+# This is not inclusive of all that is available in latest kernels
+# See /sys/block/zram0/comp_algorithm (when zram module is loaded) to see
+# what is currently set and available for your kernel[1]
+# [1]  https://www.kernel.org/doc/html/latest/admin-guide/blockdev/zram.html#select-compression-algorithm
+ALGO=lz4
+
+# Specifies the amount of RAM that should be used for zram
+# based on a percentage the total amount of available memory
+# This takes precedence and overrides SIZE below
+PERCENT=100
+
+# Specifies a static amount of RAM that should be used for
+# the ZRAM devices, this is in MiB
+SIZE=512
+
+# Specifies the priority for the swap devices, see swapon(2)
+# for more details. Higher number = higher priority
+# This should probably be higher than hdd/ssd swaps.
+PRIORITY=100
diff --git a/system/zram/zramswap.service.d/10-recomp.conf b/system/zram/zramswap.service.d/10-recomp.conf
new file mode 100644
index 0000000..54c599a
--- /dev/null
+++ b/system/zram/zramswap.service.d/10-recomp.conf
@@ -0,0 +1,6 @@
+# Prepare the zram device and register the recompression algorithm before
+# zramswap initialises it. The kernel only accepts algorithm changes while
+# disksize is 0, so this must be an ExecStartPre. The '-' keeps swap available
+# even if preparation ever fails (it logs to ~/zram-multicomp/recompress.log).
+[Service]
+ExecStartPre=-/usr/local/sbin/zram-multicomp-prepare.sh
