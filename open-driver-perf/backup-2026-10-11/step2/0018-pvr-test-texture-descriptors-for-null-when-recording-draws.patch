From 9ee9b61fb5ad23bc3d979e9cf12249ecdaa34924 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:02:27 +0800
Subject: [PATCH] pvr: test texture descriptors for null when recording draws

The versioned null descriptor checks only took the draw time path for
UBOs. Every texture and image test stayed in the shader, so a shader with
two or more texture accesses kept both copies of its body with the tests
inside them.

Record the texture descriptors too when the shader has at least two
terms, or a texture and a UBO. With a single texture term and no UBO the
checked copy folds to zeros, so that test stays in the shader.

For a combined image sampler the driver now tests dwords 2 and 3 of the
descriptor only. That is the texture address the shader tests, and the
part a null image view zeroes.

PVR_DEBUG=notexchecks restores the tests in the shader.

glmark2 through zink, off-screen, 3 interleaved rounds: bump +11%,
shadow +6%, jellyfish +4%, the rest within noise.
---
 src/imagination/common/pvr_debug.c                |  2 ++
 src/imagination/common/pvr_debug.h                |  1 +
 src/imagination/pco/pco_data.h                    |  4 ++++
 .../pco/pco_nir_lower_null_descriptors.c          | 15 ++++++++++-----
 src/imagination/vulkan/pvr_arch_cmd_buffer.c      | 12 +++++++-----
 src/imagination/vulkan/pvr_arch_pipeline.c        |  1 +
 6 files changed, 25 insertions(+), 10 deletions(-)

diff --git a/src/imagination/common/pvr_debug.c b/src/imagination/common/pvr_debug.c
index 24a9e29..92ba0a4 100644
--- a/src/imagination/common/pvr_debug.c
+++ b/src/imagination/common/pvr_debug.c
@@ -44,6 +44,8 @@ static const struct debug_named_value debug_control[] = {
      "Submit every clear-only render pass instead of folding it into a later pass." },
    { "noaltfs", PVR_DEBUG_NO_ALT_FS,
      "Do not build the fragment shader variant without the colour write enable select." },
+   { "notexchecks", PVR_DEBUG_NO_TEX_CHECKS,
+     "Test texture and image descriptors for null in the shader instead of when recording draws." },
    DEBUG_NAMED_VALUE_END
 };
 /* clang-format on */
diff --git a/src/imagination/common/pvr_debug.h b/src/imagination/common/pvr_debug.h
index a87f4be..91f21ed 100644
--- a/src/imagination/common/pvr_debug.h
+++ b/src/imagination/common/pvr_debug.h
@@ -41,6 +41,7 @@ extern uint32_t PVR_DEBUG;
 #define PVR_DEBUG_NO_FBC BITFIELD_BIT(4)
 #define PVR_DEBUG_NO_CLEAR_FOLD BITFIELD_BIT(5)
 #define PVR_DEBUG_NO_ALT_FS BITFIELD_BIT(6)
+#define PVR_DEBUG_NO_TEX_CHECKS BITFIELD_BIT(7)
 
 void pvr_process_debug_variable(void);
 
diff --git a/src/imagination/pco/pco_data.h b/src/imagination/pco/pco_data.h
index 6b022fa..9e3fc20 100644
--- a/src/imagination/pco/pco_data.h
+++ b/src/imagination/pco/pco_data.h
@@ -311,6 +311,10 @@ typedef struct _pco_common_data {
 
    bool robust_buffer_access;
    bool null_descriptor;
+   /** The driver can test texture and image descriptors for null when it
+    * records a draw, see record_desc_checks().
+    */
+   bool texture_desc_checks;
    /** Set by the driver to compile without versioned descriptor checks. */
    bool no_check_versioning;
    /** Whether pco_lower_nir() versioned the descriptor checks. */
diff --git a/src/imagination/pco/pco_nir_lower_null_descriptors.c b/src/imagination/pco/pco_nir_lower_null_descriptors.c
index 638f27f..c02ba0f 100644
--- a/src/imagination/pco/pco_nir_lower_null_descriptors.c
+++ b/src/imagination/pco/pco_nir_lower_null_descriptors.c
@@ -381,12 +381,17 @@ static bool record_desc_checks(pco_common_data *common,
    pco_desc_check checks[PCO_MAX_DESC_CHECKS];
    unsigned num_checks = 0;
 
-   /* With null descriptor tests in the shader, the checked copy folds down
-    * to returning zeros (each access's null test is known inside it); with
-    * a test the shader can't see through, both full copies stay, and the
-    * register pressure of the checked one costs more than the tests save.
+   if (num_descs + num_ubos > PCO_MAX_DESC_CHECKS)
+      return false;
+
+   /* With a single null descriptor test in the shader, the checked copy folds
+    * down to returning zeros (the access's null test is known inside it), so
+    * the test stays in the shader. With two or more, or a test the shader
+    * can't see through, both full copies stay, and a draw time test does not
+    * add temps to the checked one.
     */
-   if (num_descs || num_ubos > PCO_MAX_DESC_CHECKS)
+   if (num_descs && (!common->texture_desc_checks ||
+                     (num_descs == 1 && !num_ubos)))
       return false;
 
    for (unsigned i = 0; i < num_descs; i++) {
diff --git a/src/imagination/vulkan/pvr_arch_cmd_buffer.c b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
index fde135e..b9e6c29 100644
--- a/src/imagination/vulkan/pvr_arch_cmd_buffer.c
+++ b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
@@ -6396,12 +6396,14 @@ static bool pvr_desc_checks_fail(const struct pvr_descriptor_state *desc_state,
          continue;
       }
 
-      /* As the shader's is_null_descriptor: all dwords zero. */
+      /* As the shader's is_null_descriptor: the texture address of a combined
+       * image sampler, every dword of any other descriptor.
+       */
       const pco_binding_data *binding_data =
          &common->desc_sets[check->desc_set].bindings[check->binding];
-      const unsigned dwords = binding_data->is_img_smp
-                                 ? ROGUE_NUM_TEXSTATE_DWORDS
-                                 : binding_data->range.stride;
+      const unsigned first_dword = binding_data->is_img_smp ? 2 : 0;
+      const unsigned end_dword =
+         binding_data->is_img_smp ? 4 : binding_data->range.stride;
       const struct pvr_descriptor_set_layout_binding *binding =
          &set->layout->bindings[check->binding];
       const uint32_t *words =
@@ -6409,7 +6411,7 @@ static bool pvr_desc_checks_fail(const struct pvr_descriptor_state *desc_state,
                             check->elem * binding->stride);
 
       bool null = true;
-      for (unsigned i = 0; i < dwords; i++)
+      for (unsigned i = first_dword; i < end_dword; i++)
          null &= !words[i];
 
       if (null)
diff --git a/src/imagination/vulkan/pvr_arch_pipeline.c b/src/imagination/vulkan/pvr_arch_pipeline.c
index 7013288..e61e59a 100644
--- a/src/imagination/vulkan/pvr_arch_pipeline.c
+++ b/src/imagination/vulkan/pvr_arch_pipeline.c
@@ -2990,6 +2990,7 @@ static void pvr_early_init_shader_data(pco_data *data,
       device->vk.enabled_features.robustBufferAccess;
 
    data->common.null_descriptor = device->vk.enabled_features.nullDescriptor;
+   data->common.texture_desc_checks = !PVR_IS_DEBUG_SET(NO_TEX_CHECKS);
 
    data->common.image_2d_view_of_3d =
       device->vk.enabled_features.image2DViewOf3D;
-- 
2.47.3

