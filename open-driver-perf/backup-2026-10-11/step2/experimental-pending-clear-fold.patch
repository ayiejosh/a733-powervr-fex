+/* Pending clears
+ *
+ * zink submits a pending glClear as its own render pass whenever the app
+ * switches framebuffer before drawing: an empty pass that clears and stores a
+ * whole attachment, and later a pass on the same image that loads it back and
+ * overwrites it. Each pass costs kernel jobs and a full tile store, and the
+ * load re-reads what the empty pass just wrote.
+ *
+ * A dynamic render pass that only clears (loadOp CLEAR, storeOp STORE, render
+ * area equal to the whole view, no draws) is not submitted. Its attachments are
+ * kept as pending clears instead. A later pass that attaches the same image
+ * view over the same area takes the clear as its own load op (a LOAD becomes a
+ * CLEAR); every other access submits the clears first, at that point of the
+ * command stream: a pass that attaches the image in any other way, a
+ * non-graphics sub-command, a barrier that names the image or makes attachment
+ * writes visible, ExecuteCommands and EndCommandBuffer. Draws and state
+ * commands need no hook: reading the cleared image any other way needs one of
+ * those first.
+ */
+
 void PVR_PER_ARCH(CmdBeginRendering)(VkCommandBuffer commandBuffer,
-                                     const VkRenderingInfo *pRenderingInfo)
+                                     const VkRenderingInfo *pRenderingInfo);
+void PVR_PER_ARCH(CmdEndRendering)(VkCommandBuffer commandBuffer);
+
+#define PVR_CLEAR_WRITE_STAGES                                  \
+   (VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |           \
+    VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |              \
+    VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |               \
+    VK_PIPELINE_STAGE_2_ALL_GRAPHICS_BIT |                      \
+    VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT |                      \
+    VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT)
+
+#define PVR_CLEAR_WRITE_ACCESS                                  \
+   (VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |                    \
+    VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |            \
+    VK_ACCESS_2_MEMORY_WRITE_BIT)
+
+static bool
+pvr_pending_clear_same_target(const struct pvr_pending_clear *pc,
+                              const struct pvr_image_view *iview,
+                              VkImageAspectFlagBits aspect)
+{
+   const struct vk_image_view *a = &pc->iview->vk;
+   const struct vk_image_view *b = &iview->vk;
+
+   return pc->aspect == aspect && a->image == b->image &&
+          a->format == b->format && a->base_mip_level == b->base_mip_level &&
+          a->base_array_layer == b->base_array_layer &&
+          a->layer_count == b->layer_count;
+}
+
+static bool pvr_attachment_layout_is_plain(VkImageLayout layout)
+{
+   return layout == VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL ||
+          layout == VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL ||
+          layout == VK_IMAGE_LAYOUT_ATTACHMENT_OPTIMAL;
+}
+
+static bool pvr_view_area_is_whole(const struct pvr_image_view *iview,
+                                   const VkRect2D *area)
+{
+   return area->offset.x == 0 && area->offset.y == 0 &&
+          area->extent.width == iview->vk.extent.width &&
+          area->extent.height == iview->vk.extent.height;
+}
+
+static bool pvr_rect_equal(const VkRect2D *a, const VkRect2D *b)
+{
+   return a->offset.x == b->offset.x && a->offset.y == b->offset.y &&
+          a->extent.width == b->extent.width &&
+          a->extent.height == b->extent.height;
+}
+
+/* Submits the pending clears, one render pass per original pass. */
+static void pvr_clear_fold_flush(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+   struct pvr_pending_clear list[PVR_MAX_PENDING_CLEARS];
+   uint32_t count = state->pending_clear_count;
+
+   if (!count || state->pending_clear_flushing ||
+       state->render_pass_info.dynamic_render)
+      return;
+
+   memcpy(list, state->pending_clears, count * sizeof(list[0]));
+   state->pending_clear_count = 0;
+   state->pending_clear_flushing = true;
+
+   for (uint32_t i = 0; i < count;) {
+      VkRenderingAttachmentInfo colors[PVR_MAX_COLOR_ATTACHMENTS];
+      VkRenderingAttachmentInfo depth = { 0 };
+      VkRenderingAttachmentInfo stencil = { 0 };
+      bool has_depth = false;
+      bool has_stencil = false;
+      uint32_t num_colors = 0;
+      uint32_t j = i;
+
+      for (; j < count && list[j].pass_id == list[i].pass_id; j++) {
+         VkRenderingAttachmentInfo info = {
+            .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+            .imageView = pvr_image_view_to_handle(list[j].iview),
+            .imageLayout = list[j].layout,
+            .resolveMode = VK_RESOLVE_MODE_NONE,
+            .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+            .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+            .clearValue = list[j].clear_value,
+         };
+
+         if (list[j].aspect == VK_IMAGE_ASPECT_DEPTH_BIT) {
+            depth = info;
+            has_depth = true;
+         } else if (list[j].aspect == VK_IMAGE_ASPECT_STENCIL_BIT) {
+            stencil = info;
+            has_stencil = true;
+         } else {
+            assert(num_colors < PVR_MAX_COLOR_ATTACHMENTS);
+            colors[num_colors++] = info;
+         }
+      }
+
+      const VkRenderingInfo rendering_info = {
+         .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+         .renderArea = list[i].area,
+         .layerCount = 1,
+         .colorAttachmentCount = num_colors,
+         .pColorAttachments = colors,
+         .pDepthAttachment = has_depth ? &depth : NULL,
+         .pStencilAttachment = has_stencil ? &stencil : NULL,
+      };
+      const VkCommandBuffer handle = pvr_cmd_buffer_to_handle(cmd_buffer);
+
+      PVR_PER_ARCH(CmdBeginRendering)(handle, &rendering_info);
+      PVR_PER_ARCH(CmdEndRendering)(handle);
+
+      i = j;
+   }
+
+   state->pending_clear_flushing = false;
+}
+
+/* Called by vkCmdBeginRendering: applies pending clears to the new pass and
+ * decides whether the new pass is itself a candidate to be held back. Returns
+ * the rendering info to use.
+ */
+static const VkRenderingInfo *
+pvr_clear_fold_begin(struct pvr_cmd_buffer *cmd_buffer,
+                     const VkRenderingInfo *info,
+                     VkRenderingInfo *local_info,
+                     VkRenderingAttachmentInfo local_atts[PVR_MAX_COLOR_ATTACHMENTS + 2])
 {
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+   const uint32_t depth_slot = PVR_MAX_COLOR_ATTACHMENTS;
+   const uint32_t stencil_slot = PVR_MAX_COLOR_ATTACHMENTS + 1;
+   struct {
+      struct pvr_image_view *iview;
+      VkImageAspectFlagBits aspect;
+      VkRenderingAttachmentInfo *info;
+   } atts[PVR_MAX_COLOR_ATTACHMENTS + 2];
+   struct vk_image *resolve_images[PVR_MAX_COLOR_ATTACHMENTS + 2];
+   uint32_t num_atts = 0;
+   uint32_t num_resolve = 0;
+   bool rewritten = false;
+
+   state->candidate_clear_count = 0;
+
+   if (state->pending_clear_flushing || PVR_IS_DEBUG_SET(NO_CLEAR_FOLD) ||
+       info->colorAttachmentCount > PVR_MAX_COLOR_ATTACHMENTS)
+      return info;
+
+   const bool simple_pass =
+      !(info->flags & (VK_RENDERING_SUSPENDING_BIT |
+                       VK_RENDERING_RESUMING_BIT |
+                       VK_RENDERING_CONTENTS_SECONDARY_COMMAND_BUFFERS_BIT)) &&
+      !info->viewMask && info->layerCount == 1;
+
+   /* Work on a copy: the attachment infos may be rewritten. */
+   *local_info = *info;
+   for (uint32_t i = 0; i < info->colorAttachmentCount; i++) {
+      local_atts[i] = info->pColorAttachments[i];
+      if (local_atts[i].imageView) {
+         atts[num_atts].iview = pvr_image_view_from_handle(local_atts[i].imageView);
+         atts[num_atts].aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+         atts[num_atts++].info = &local_atts[i];
+      }
+      if (local_atts[i].resolveMode != VK_RESOLVE_MODE_NONE &&
+          local_atts[i].resolveImageView) {
+         resolve_images[num_resolve++] =
+            pvr_image_view_from_handle(local_atts[i].resolveImageView)->vk.image;
+      }
+   }
+   local_info->pColorAttachments = local_atts;
+
+   const struct {
+      const VkRenderingAttachmentInfo *src;
+      uint32_t slot;
+      VkImageAspectFlagBits aspect;
+      const VkRenderingAttachmentInfo **dst;
+   } ds[2] = {
+      { info->pDepthAttachment, depth_slot, VK_IMAGE_ASPECT_DEPTH_BIT,
+        &local_info->pDepthAttachment },
+      { info->pStencilAttachment, stencil_slot, VK_IMAGE_ASPECT_STENCIL_BIT,
+        &local_info->pStencilAttachment },
+   };
+   for (uint32_t i = 0; i < 2; i++) {
+      if (!ds[i].src)
+         continue;
+
+      local_atts[ds[i].slot] = *ds[i].src;
+      *ds[i].dst = &local_atts[ds[i].slot];
+      if (ds[i].src->imageView) {
+         atts[num_atts].iview = pvr_image_view_from_handle(ds[i].src->imageView);
+         atts[num_atts].aspect = ds[i].aspect;
+         atts[num_atts++].info = &local_atts[ds[i].slot];
+      }
+      if (ds[i].src->resolveMode != VK_RESOLVE_MODE_NONE &&
+          ds[i].src->resolveImageView) {
+         resolve_images[num_resolve++] =
+            pvr_image_view_from_handle(ds[i].src->resolveImageView)->vk.image;
+      }
+   }
+
+   if (state->pending_clear_count) {
+      bool consumed[PVR_MAX_PENDING_CLEARS] = { false };
+      uint32_t match[PVR_MAX_PENDING_CLEARS];
+      bool conflict = false;
+
+      for (uint32_t e = 0; e < state->pending_clear_count && !conflict; e++) {
+         const struct pvr_pending_clear *pc = &state->pending_clears[e];
+         bool image_used = false;
+
+         for (uint32_t r = 0; r < num_resolve; r++)
+            conflict |= resolve_images[r] == pc->iview->vk.image;
+
+         for (uint32_t a = 0; a < num_atts; a++) {
+            if (atts[a].iview->vk.image != pc->iview->vk.image)
+               continue;
+
+            image_used = true;
+            if (simple_pass &&
+                pvr_attachment_layout_is_plain(atts[a].info->imageLayout) &&
+                pvr_pending_clear_same_target(pc, atts[a].iview, atts[a].aspect) &&
+                pvr_rect_equal(&pc->area, &info->renderArea) &&
+                pvr_view_area_is_whole(atts[a].iview, &info->renderArea)) {
+               consumed[e] = true;
+               match[e] = a;
+            }
+         }
+
+         conflict |= image_used && !consumed[e];
+      }
+
+      if (conflict) {
+         pvr_clear_fold_flush(cmd_buffer);
+         return info;
+      }
+
+      uint32_t kept = 0;
+      for (uint32_t e = 0; e < state->pending_clear_count; e++) {
+         if (!consumed[e]) {
+            state->pending_clears[kept++] = state->pending_clears[e];
+            continue;
+         }
+
+         VkRenderingAttachmentInfo *att = atts[match[e]].info;
+         if (att->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD) {
+            att->loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            att->clearValue = state->pending_clears[e].clear_value;
+            rewritten = true;
+         }
+      }
+      state->pending_clear_count = kept;
+
+      /* A barrier exposed these clears to shader reads and this pass does not
+       * consume them: submit them before it.
+       */
+      for (uint32_t e = 0; e < state->pending_clear_count; e++) {
+         if (state->pending_clears[e].exposed) {
+            pvr_clear_fold_flush(cmd_buffer);
+            break;
+         }
+      }
+   }
+
+   /* Can this pass be held back if it turns out to draw nothing? */
+   bool candidate = simple_pass && num_atts > 0 && !num_resolve &&
+                    num_atts <= PVR_MAX_PENDING_CLEARS;
+   for (uint32_t a = 0; candidate && a < num_atts; a++) {
+      candidate &= atts[a].info->loadOp == VK_ATTACHMENT_LOAD_OP_CLEAR &&
+                   atts[a].info->storeOp == VK_ATTACHMENT_STORE_OP_STORE &&
+                   pvr_view_area_is_whole(atts[a].iview, &info->renderArea);
+   }
+   if (candidate) {
+      for (uint32_t a = 0; a < num_atts; a++) {
+         state->candidate_clears[a] = (struct pvr_pending_clear){
+            .iview = atts[a].iview,
+            .aspect = atts[a].aspect,
+            .layout = atts[a].info->imageLayout,
+            .clear_value = atts[a].info->clearValue,
+            .area = info->renderArea,
+         };
+      }
+      state->candidate_clear_count = num_atts;
+   }
+
+   return rewritten ? local_info : info;
+}
+
+/* Called by vkCmdEndRendering once the pass was cancelled. */
+static void pvr_clear_fold_push(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+
+   if (state->pending_clear_count + state->candidate_clear_count >
+       PVR_MAX_PENDING_CLEARS)
+      pvr_clear_fold_flush(cmd_buffer);
+
+   const uint32_t pass_id = state->pending_clear_next_pass++;
+   for (uint32_t i = 0; i < state->candidate_clear_count; i++) {
+      state->pending_clears[state->pending_clear_count] =
+         state->candidate_clears[i];
+      state->pending_clears[state->pending_clear_count++].pass_id = pass_id;
+   }
+}
+
+/* True if the barrier only orders attachment access against attachment access.
+ * Nothing but a render pass can see the pending clears through it, and a render
+ * pass that attaches the image consumes or flushes them itself.
+ */
+static bool pvr_barrier_dst_is_attachment_only(VkPipelineStageFlags2 stages,
+                                               VkAccessFlags2 access)
+{
+   return stages &&
+          !(stages & ~(VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                       VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                       VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT)) &&
+          !(access & ~(VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+                       VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+                       VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+                       VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT));
+}
+
+/* True if the barrier only orders attachment writes against fragment work.
+ * Fragment jobs run in order on this hardware, so a clear submitted just
+ * before the next render pass is still ordered against the shader reads.
+ */
+static bool pvr_barrier_dst_is_fragment_only(VkPipelineStageFlags2 stages)
+{
+   return stages &&
+          !(stages & ~(VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+                       VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                       VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                       VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT));
+}
+
+/* Returns true if the pending clears must be submitted before this barrier.
+ * A fragment-only barrier only marks them exposed: vkCmdBeginRendering consumes
+ * an exposed clear or submits it before the pass that could read it.
+ */
+static bool
+pvr_dependency_exposes_pending_clear(struct pvr_cmd_buffer *cmd_buffer,
+                                     const VkDependencyInfo *dep)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *b = &dep->pMemoryBarriers[i];
+
+      if ((b->srcStageMask & PVR_CLEAR_WRITE_STAGES) &&
+          (b->srcAccessMask & PVR_CLEAR_WRITE_ACCESS) &&
+          !pvr_barrier_dst_is_attachment_only(b->dstStageMask,
+                                              b->dstAccessMask)) {
+         if (!pvr_barrier_dst_is_fragment_only(b->dstStageMask))
+            return true;
+
+         for (uint32_t e = 0; e < state->pending_clear_count; e++)
+            state->pending_clears[e].exposed = true;
+      }
+   }
+
+   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
+      const VkImageMemoryBarrier2 *b = &dep->pImageMemoryBarriers[i];
+      VK_FROM_HANDLE(pvr_image, image, b->image);
+
+      if (b->oldLayout == b->newLayout &&
+          pvr_barrier_dst_is_attachment_only(b->dstStageMask,
+                                             b->dstAccessMask))
+         continue;
+
+      for (uint32_t e = 0; e < state->pending_clear_count; e++) {
+         if (state->pending_clears[e].iview->vk.image == &image->vk)
+            return true;
+      }
+   }
+
+   return false;
+}
