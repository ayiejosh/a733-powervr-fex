-      &state->gfx_pipeline->shader_state.fragment;
+      pvr_gfx_fs_state(state);
    const struct pvr_stage_allocation_descriptor_state *descriptor_shader_state =
       &fragment_shader_state->descriptor_state;
    const struct pvr_pipeline_stage_state *fragment_state =
@@ -8981,7 +9005,7 @@ pvr_emit_dirty_ppp_state(struct pvr_cmd_buffer *const cmd_buffer,
    struct vk_dynamic_graphics_state *const dynamic_state =
       &cmd_buffer->vk.dynamic_graphics_state;
    const struct pvr_fragment_shader_state *fragment_state =
-      &state->gfx_pipeline->shader_state.fragment;
+      pvr_gfx_fs_state(state);
    VkResult result;
 
    /* TODO: The emit_header will be dirty only if
@@ -9010,8 +9034,8 @@ pvr_emit_dirty_ppp_state(struct pvr_cmd_buffer *const cmd_buffer,
                   !pvr_needs_fs_passthrough(dynamic_state);
    if (!dynamic_state->rs.rasterizer_discard_enable &&
        state->dirty.fragment_descriptors &&
-       state->gfx_pipeline->shader_state.fragment.shader_bo &&
-       !state->gfx_pipeline->fs_data.common.uses.empty && !skip_fs) {
+       pvr_gfx_fs_state(state)->shader_bo &&
+       !pvr_gfx_fs_data(state)->common.uses.empty && !skip_fs) {
       result = pvr_setup_fragment_state_pointers(cmd_buffer, sub_cmd);
       if (result != VK_SUCCESS)
          return result;
@@ -9261,6 +9285,27 @@ static void pvr_emit_dirty_vdm_state(struct pvr_cmd_buffer *const cmd_buffer,
    pvr_csb_clear_relocation_mark(csb);
 }
 
+/* Picks the fragment shader build for the draw: the one without the colour
+ * write enable select when every colour output the shader writes is enabled.
+ * Returns its data, and whether the choice changed since the last draw: the
+ * caller marks the fragment descriptors dirty, after it has recomputed them.
+ */
+static const pco_data *
+pvr_gfx_select_fs_variant(struct pvr_cmd_buffer *cmd_buffer, bool *flipped)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+   const struct pvr_graphics_pipeline *const gfx_pipeline = state->gfx_pipeline;
+   const bool alt =
+      gfx_pipeline->has_alt_fs &&
+      !pvr_fs_cwe_reads_fb(&cmd_buffer->vk.dynamic_graphics_state,
+                           &gfx_pipeline->fs_data.fs);
+
+   *flipped = alt != state->fs_alt;
+   state->fs_alt = alt;
+
+   return pvr_gfx_fs_data(state);
+}
+
 static VkResult pvr_validate_draw_state(struct pvr_cmd_buffer *cmd_buffer)
 {
    struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
@@ -9268,7 +9313,9 @@ static VkResult pvr_validate_draw_state(struct pvr_cmd_buffer *cmd_buffer)
       &cmd_buffer->vk.dynamic_graphics_state;
    const struct pvr_graphics_pipeline *const gfx_pipeline = state->gfx_pipeline;
    const pco_data *const vs_data = &gfx_pipeline->vs_data;
-   const pco_data *const fs_data = &gfx_pipeline->fs_data;
+   bool fs_flipped;
+   const pco_data *const fs_data =
+      pvr_gfx_select_fs_variant(cmd_buffer, &fs_flipped);
    struct pvr_sub_cmd_gfx *sub_cmd;
    bool fstencil_writemask_zero;
    bool bstencil_writemask_zero;
@@ -9392,6 +9439,7 @@ static VkResult pvr_validate_draw_state(struct pvr_cmd_buffer *cmd_buffer)
     */
    state->dirty.vertex_descriptors |= state->dirty.gfx_desc_dirty;
    state->dirty.fragment_descriptors |= state->dirty.gfx_desc_dirty;
+   state->dirty.fragment_descriptors |= fs_flipped;
 
    if (BITSET_TEST(dynamic_state->dirty, MESA_VK_DYNAMIC_CB_BLEND_CONSTANTS) ||
        BITSET_TEST(dynamic_state->dirty, MESA_VK_DYNAMIC_RS_FRONT_FACE) ||
@@ -9402,13 +9450,15 @@ static VkResult pvr_validate_draw_state(struct pvr_cmd_buffer *cmd_buffer)
        BITSET_TEST(dynamic_state->dirty,
                    MESA_VK_DYNAMIC_MS_ALPHA_TO_COVERAGE_ENABLE) ||
        BITSET_TEST(dynamic_state->dirty, MESA_VK_DYNAMIC_MS_SAMPLE_MASK) ||
+       BITSET_TEST(dynamic_state->dirty,
+                   MESA_VK_DYNAMIC_RS_RASTERIZER_DISCARD_ENABLE) ||
        BITSET_TEST(dynamic_state->dirty,
                    MESA_VK_DYNAMIC_MS_RASTERIZATION_SAMPLES)) {
       state->dirty.fragment_descriptors = true;
    }
 
    const struct pvr_fragment_shader_state *const fragment_shader_state =
-      &gfx_pipeline->shader_state.fragment;
+      pvr_gfx_fs_state(state);
    bool skip_fs = fragment_shader_state->is_passthrough &&
                   !pvr_needs_fs_passthrough(dynamic_state);
 
@@ -9416,7 +9466,7 @@ static VkResult pvr_validate_draw_state(struct pvr_cmd_buffer *cmd_buffer)
       result = pvr_setup_descriptor_mappings(
          cmd_buffer,
          PVR_STAGE_ALLOCATION_FRAGMENT,
-         &state->gfx_pipeline->shader_state.fragment.descriptor_state,
+         &pvr_gfx_fs_state(state)->descriptor_state,
          NULL,
          &state->pds_fragment_descriptor_data_offset);
       if (result != VK_SUCCESS) {
diff --git a/src/imagination/vulkan/pvr_arch_pipeline.c b/src/imagination/vulkan/pvr_arch_pipeline.c
index 3de794b..7013288 100644
--- a/src/imagination/vulkan/pvr_arch_pipeline.c
+++ b/src/imagination/vulkan/pvr_arch_pipeline.c
@@ -24,6 +24,7 @@
  * SOFTWARE.
  */
 
+#include "pvr_debug.h"
 #include "pvr_pipeline.h"
 
 #include <assert.h>
@@ -964,6 +965,17 @@ static void pvr_early_init_shader_data(pco_data *data,
                                        const void *pCreateInfo,
                                        struct pvr_device *const device);
 
+/* Whether the colour write enables of the pipeline can leave an output
+ * masked out.
+ */
+static bool
+pvr_cb_color_write_enable_possible(const struct vk_graphics_pipeline_state *state)
+{
+   return BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_CB_COLOR_WRITE_ENABLES) ||
+          (state->cb && state->cb->color_write_enables !=
+                           BITFIELD_MASK(MESA_VK_MAX_COLOR_ATTACHMENTS));
+}
+
 static void
 pvr_preprocess_shader_data(pco_data *data,
                            nir_shader *nir,
@@ -1364,6 +1376,24 @@ static void pvr_pipeline_destroy_shader_data(pco_data *data)
    }
 }
 
+static void
+pvr_destroy_alt_fragment_variant(struct pvr_device *const device,
+                                 const VkAllocationCallbacks *const allocator,
+                                 struct pvr_graphics_pipeline *const gfx_pipeline)
+{
+   struct pvr_fragment_shader_state *alt = &gfx_pipeline->fragment_alt;
+
+   if (!gfx_pipeline->has_alt_fs)
+      return;
+
+   pvr_pds_descriptor_program_destroy(device, allocator, &alt->descriptor_state);
+   vk_free2(&device->vk.alloc, allocator, alt->pds_fragment_program_buffer);
+   vk_free2(&device->vk.alloc, allocator, alt->pds_coeff_program_buffer);
+   pvr_bo_suballoc_free(alt->shader_bo);
+   pvr_pipeline_destroy_shader_data(&gfx_pipeline->fs_data_alt);
+   gfx_pipeline->has_alt_fs = false;
+}
+
 static void
 pvr_graphics_pipeline_destroy(struct pvr_device *const device,
                               const VkAllocationCallbacks *const allocator,
@@ -1406,6 +1436,8 @@ pvr_graphics_pipeline_destroy(struct pvr_device *const device,
    pvr_pipeline_destroy_shader_data(&gfx_pipeline->vs_data);
    pvr_pipeline_destroy_shader_data(&gfx_pipeline->fs_data);
 
+   pvr_destroy_alt_fragment_variant(device, allocator, gfx_pipeline);
+
    vk_free2(&device->vk.alloc, allocator, gfx_pipeline->vs_stats);
    vk_free2(&device->vk.alloc, allocator, gfx_pipeline->fs_stats);
 
@@ -2848,9 +2880,7 @@ pvr_preprocess_shader_data(pco_data *data,
          state->ms->rasterization_samples == VK_SAMPLE_COUNT_1_BIT &&
          (state->ms->sample_mask & 1) && !state->ms->sample_shading_enable;
 
-      if (BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_CB_COLOR_WRITE_ENABLES) ||
-          (state->cb && state->cb->color_write_enables !=
-                           BITFIELD_MASK(MESA_VK_MAX_COLOR_ATTACHMENTS))) {
+      if (!data->fs.no_cwe && pvr_cb_color_write_enable_possible(state)) {
          data->fs.meta_present.color_write_enable = true;
       }
       if (BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_MS_ALPHA_TO_ONE_ENABLE) ||
@@ -3045,6 +3075,102 @@ pvr_graphics_lower_stage(pco_ctx *pco_ctx,
    pvr_postprocess_shader_data(data, nir, pCreateInfo, layout, mrt_setup);
 }
 
+/* True if the job and PPP state that only follows the pipeline bind stays valid
+ * when draws switch between two builds of the fragment shader.
+ */
+static bool pvr_fs_variants_compatible(const pco_data *a, const pco_data *b)
+{
+   return a->common.coeffs == b->common.coeffs &&
+          a->common.multiview == b->common.multiview &&
+          !memcmp(&a->common.uses, &b->common.uses, sizeof(a->common.uses)) &&
+          !memcmp(&a->fs.tile_buffers,
+                  &b->fs.tile_buffers,
+                  sizeof(a->fs.tile_buffers)) &&
+          a->fs.uses.w == b->fs.uses.w && a->fs.uses.z == b->fs.uses.z &&
+          a->fs.uses.pntc == b->fs.uses.pntc &&
+          a->fs.uses.phase_change == b->fs.uses.phase_change &&
+          a->fs.uses.fbfetch == b->fs.uses.fbfetch &&
+          a->fs.uses.depth_feedback == b->fs.uses.depth_feedback &&
+          a->fs.uses.discard == b->fs.uses.discard &&
+          a->fs.uses.sample_shading == b->fs.uses.sample_shading &&
+          a->fs.uses.sample_locations == b->fs.uses.sample_locations &&
+          a->fs.uses.alpha_to_coverage == b->fs.uses.alpha_to_coverage &&
+          a->fs.uses.fbfetch_static == b->fs.uses.fbfetch_static;
+}
+
+/* Builds the alternate fragment shader variant with the pipeline's own helpers:
+ * the checked variant is moved out of the primary slots while they are filled,
+ * then the new one is moved into the alternate slots. A failure only drops the
+ * variant.
+ */
+static void
+pvr_build_alt_fragment_variant(struct pvr_device *device,
+                               const VkAllocationCallbacks *allocator,
+                               struct vk_pipeline_layout *layout,
+                               struct pvr_graphics_pipeline *gfx_pipeline,
+                               pco_shader *alt_fs,
+                               nir_shader *alt_nir,
+                               uint32_t cache_line_size)
+{
+   struct pvr_fragment_shader_state *slot =
+      &gfx_pipeline->shader_state.fragment;
+   const pco_data checked_data = gfx_pipeline->fs_data;
+   const struct pvr_fragment_shader_state checked_state = *slot;
+   VkResult result;
+
+   memset(slot, 0, sizeof(*slot));
+   pvr_fragment_state_save(gfx_pipeline, alt_fs);
+
+   if (!pvr_fs_variants_compatible(&checked_data, &gfx_pipeline->fs_data))
+      goto err_destroy_data;
+
+   pvr_graphics_pipeline_setup_fragment_coeff_program(gfx_pipeline, alt_nir);
+
+   result = pvr_gpu_upload_usc(device,
+                               pco_shader_binary_data(alt_fs),
+                               pco_shader_binary_size(alt_fs),
+                               cache_line_size,
+                               &slot->shader_bo);
+   if (result != VK_SUCCESS)
+      goto err_destroy_data;
+
+   result = pvr_pds_coeff_program_create_and_upload(device, allocator, slot);
+   if (result != VK_SUCCESS)
+      goto err_free_bo;
+
+   result = pvr_pds_fragment_program_create(device, allocator, alt_fs, slot);
+   if (result != VK_SUCCESS)
+      goto err_free_coeff_program;
+
+   result =
+      pvr_pds_descriptor_program_create_and_upload(device,
+                                                   allocator,
+                                                   layout,
+                                                   MESA_SHADER_FRAGMENT,
+                                                   &gfx_pipeline->fs_data,
+                                                   &slot->descriptor_state);
+   if (result != VK_SUCCESS)
+      goto err_free_frag_program;
+
+   gfx_pipeline->fs_data_alt = gfx_pipeline->fs_data;
+   gfx_pipeline->fragment_alt = *slot;
+   gfx_pipeline->has_alt_fs = true;
+   goto restore;
+
+err_free_frag_program:
+   vk_free2(&device->vk.alloc, allocator, slot->pds_fragment_program_buffer);
+err_free_coeff_program:
+   vk_free2(&device->vk.alloc, allocator, slot->pds_coeff_program_buffer);
+err_free_bo:
+   pvr_bo_suballoc_free(slot->shader_bo);
+err_destroy_data:
+   pvr_pipeline_destroy_shader_data(&gfx_pipeline->fs_data);
+
+restore:
+   gfx_pipeline->fs_data = checked_data;
+   *slot = checked_state;
+}
+
 static VkResult
 pvr_graphics_pipeline_compile(struct pvr_device *const device,
                               struct vk_pipeline_cache *cache,
@@ -3192,12 +3318,27 @@ pvr_graphics_pipeline_compile(struct pvr_device *const device,
     * versioned descriptor checks (see below).
     */
    nir_shader *unversioned_nir[MESA_SHADER_STAGES] = { 0 };
+   nir_shader *alt_fs_nir = NULL;
+   pco_data *alt_fs_data = NULL;
+   pco_shader *alt_fs_shader = NULL;
    pco_data *unversioned_data[MESA_SHADER_STAGES] = { 0 };
 
    for (mesa_shader_stage stage = 0; stage < MESA_SHADER_STAGES; ++stage) {
