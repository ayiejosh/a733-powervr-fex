+/* The fragment shader build the draws use: the alternate one has no colour
+ * write enable select, see pvr_gfx_select_fs_variant().
+ */
+static inline const pco_data *
+pvr_gfx_fs_data(const struct pvr_cmd_buffer_state *state)
+{
+   return state->fs_alt && state->gfx_pipeline->has_alt_fs
+             ? &state->gfx_pipeline->fs_data_alt
+             : &state->gfx_pipeline->fs_data;
+}
+
+static inline const struct pvr_fragment_shader_state *
+pvr_gfx_fs_state(const struct pvr_cmd_buffer_state *state)
+{
+   return state->fs_alt && state->gfx_pipeline->has_alt_fs
+             ? &state->gfx_pipeline->fragment_alt
+             : &state->gfx_pipeline->shader_state.fragment;
+}
+
