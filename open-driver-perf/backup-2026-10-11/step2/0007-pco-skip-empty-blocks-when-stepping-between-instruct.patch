From b65685c6552a43d6eb7ce7f20fe1f73140a8d78f Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sun, 11 Oct 2026 11:29:39 +0800
Subject: [PATCH 07/11] pco: skip empty blocks when stepping between
 instruction groups

pco_next_igrp() and pco_prev_igrp() returned the first or last group of the
adjacent block even when that block was empty, so they gave NULL in the
middle of a function. calc_align_padding() then dereferenced it when the
last group was preceded by an empty block, e.g. an if epilogue that has no
instructions. Use pco_{next,prev}_block_nonempty(), as pco_cf_node_offset()
already does.
---
 src/imagination/pco/pco_internal.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/imagination/pco/pco_internal.h b/src/imagination/pco/pco_internal.h
index 86527c0..092fdb5 100644
--- a/src/imagination/pco/pco_internal.h
+++ b/src/imagination/pco/pco_internal.h
@@ -1602,7 +1602,7 @@ static inline pco_igrp *pco_next_igrp(pco_igrp *igrp)
    if (igrp != pco_last_igrp(igrp->parent_block))
       return list_entry(igrp->link.next, pco_igrp, link);
 
-   pco_block *block = pco_next_block(igrp->parent_block);
+   pco_block *block = pco_next_block_nonempty(igrp->parent_block);
    return !block ? NULL : pco_first_igrp(block);
 }
 
@@ -1621,7 +1621,7 @@ static inline pco_igrp *pco_prev_igrp(pco_igrp *igrp)
    if (igrp != pco_first_igrp(igrp->parent_block))
       return list_entry(igrp->link.prev, pco_igrp, link);
 
-   pco_block *block = pco_prev_block(igrp->parent_block);
+   pco_block *block = pco_prev_block_nonempty(igrp->parent_block);
    return !block ? NULL : pco_last_igrp(block);
 }
 
