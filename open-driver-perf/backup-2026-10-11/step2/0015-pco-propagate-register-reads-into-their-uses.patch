diff --git a/src/imagination/pco/pco_opt.c b/src/imagination/pco/pco_opt.c
index 76afe3a..0ed126d 100644
--- a/src/imagination/pco/pco_opt.c
+++ b/src/imagination/pco/pco_opt.c
@@ -406,19 +406,40 @@ static inline bool can_fwd_prop_src(const pco_instr *to_instr,
  * \param[in] instr Instruction to try and forward-propagate.
  * \return True if forward-propagation was successful.
  */
+/* Whether a virtual register keeps its value from one instruction to a later
+ * one: both in the same block, with no write to the register in between.
+ */
+static bool vreg_unchanged_between(pco_ref vreg, pco_instr *from, pco_instr *to)
+{
+   if (from->parent_block != to->parent_block)
+      return false;
+
+   for (pco_instr *instr = list_entry(from->link.next, pco_instr, link);
+        instr != to;
+        instr = list_entry(instr->link.next, pco_instr, link)) {
+      pco_foreach_instr_dest_vreg (pdest, instr) {
+         if (pdest->val == vreg.val)
+            return false;
+      }
+   }
+
+   return true;
+}
+
 static inline bool try_fwd_prop_instr(pco_instr **writes, pco_instr *instr)
 {
    bool progress = false;
-
    pco_foreach_instr_src_ssa (psrc, instr) {
       pco_instr *parent_instr = writes[psrc->val];
-
       if (!parent_instr || parent_instr->op != PCO_OP_MOV)
          continue;
-
       if (!can_fwd_prop_src(instr, psrc, &parent_instr->src[0]))
          continue;
 
+      /* A register read must stay before the next write to the register. */
+      if (pco_ref_is_vreg(parent_instr->src[0]) &&
+          !vreg_unchanged_between(parent_instr->src[0], parent_instr, instr))
+         continue;
       /* Propagate the source. */
       pco_ref repl = parent_instr->src[0];
       if (psrc->flr)
