--- a/src/imagination/pco/pco_cf.c
+++ b/src/imagination/pco/pco_cf.c
@@ -133,13 +133,30 @@ static inline void set_body_exec_cnd(struct list_head *body,
 }
 
 /* Whether a comparison source has the same value wherever the comparison is
- * recomputed before its if.
+ * recomputed before its if: a virtual register must not be written between
+ * the comparison and the if, which follows the comparison's block.
  */
-static inline bool cmp_src_is_stable(pco_ref ref)
+static inline bool cmp_src_is_stable(pco_ref ref, pco_instr *cmp, pco_if *pif)
 {
    if (pco_ref_is_ssa(ref) || pco_ref_is_imm(ref))
       return true;
 
+   if (pco_ref_is_vreg(ref)) {
+      pco_block *block = cmp->parent_block;
+      if (pif->cf_node.link.prev != &block->cf_node.link)
+         return false;
+
+      for (pco_instr *instr = list_entry(cmp->link.next, pco_instr, link);
+           &instr->link != &block->instrs;
+           instr = list_entry(instr->link.next, pco_instr, link)) {
+         pco_foreach_instr_dest_vreg (pdest, instr) {
+            if (pdest->val == ref.val)
+               return false;
+         }
+      }
+
+      return true;
+   }
    if (!pco_ref_is_hwreg(ref))
       return false;
 
@@ -153,6 +170,7 @@ static inline bool cmp_src_is_stable(pco_ref ref)
  * comparison if nothing else uses it.
  */
 static bool set_p0_from_cond(pco_builder *b,
+                             pco_if *pif,
                              pco_ref cond,
                              enum pco_exec_cnd exec_cnd,
                              pco_instr **writes,
@@ -162,8 +180,9 @@ static bool set_p0_from_cond(pco_builder *b,
                        ? writes[cond.val]
                        : NULL;
 
-   if (cmp && cmp->op == PCO_OP_BCMP && cmp_src_is_stable(cmp->src[0]) &&
-       cmp_src_is_stable(cmp->src[1])) {
+   if (cmp && cmp->op == PCO_OP_BCMP &&
+       cmp_src_is_stable(cmp->src[0], cmp, pif) &&
+       cmp_src_is_stable(cmp->src[1], cmp, pif)) {
       pco_tstp(b,
                pco_ref_null(),
                pco_ref_pred(PCO_PRED_P0),
@@ -201,7 +220,7 @@ lower_if_pred_exec(pco_if *pif,
    pco_builder b = pco_builder_create(func, pco_cursor_after_block(prologue));
 
    invert_cond ^=
-      set_p0_from_cond(&b, pif->cond, PCO_EXEC_CND_E1_ZX, writes, num_writes);
+      set_p0_from_cond(&b, pif, pif->cond, PCO_EXEC_CND_E1_ZX, writes, num_writes);
 
    set_body_exec_cnd(&pif->then_body,
                      invert_cond ? PCO_EXEC_CND_E1_Z1 : PCO_EXEC_CND_E1_Z0);
@@ -242,7 +261,7 @@ lower_if_cond_exec(pco_if *pif,
    pco_ref emc = pco_emc_ref(func, &b);
 
    invert_cond ^=
-      set_p0_from_cond(&b, pif->cond, PCO_EXEC_CND_E1_ZX, writes, num_writes);
+      set_p0_from_cond(&b, pif, pif->cond, PCO_EXEC_CND_E1_ZX, writes, num_writes);
 
    pco_cndst(&b,
              pco_ref_pred(PCO_PRED_PE),
@@ -312,7 +331,7 @@ lower_if_uniform(pco_if *pif,
 
    pco_builder b = pco_builder_create(func, pco_cursor_after_block(prologue));
    invert_cond ^=
-      set_p0_from_cond(&b, pif->cond, PCO_EXEC_CND_EX_ZX, writes, num_writes);
+      set_p0_from_cond(&b, pif, pif->cond, PCO_EXEC_CND_EX_ZX, writes, num_writes);
 
    /* Skip the then body when the condition is false. */
    pco_br(&b,
diff --git a/src/imagination/pco/pco_group_instrs.c b/src/imagination/pco/pco_group_instrs.c
