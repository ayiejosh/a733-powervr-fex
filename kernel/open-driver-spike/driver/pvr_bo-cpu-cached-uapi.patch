PowerVR: add a userspace flag for a CPU-cacheable BO mapping

The kernel already knows how to map a PowerVR BO cacheable (map_wc is cleared
for PVR_BO_CPU_CACHED), but that flag is kernel-only (bit 63), so userspace
cannot ask for it and every mapping ends up write-combined: CPU writes are
fast (5 GB/s) but CPU reads are ~330 MB/s against ~2.6-6.6 GB/s for a
cacheable mapping. The vendor driver offers both kinds of memory type.

--- a/drivers/gpu/drm/imagination/pvr_gem.c
+++ b/drivers/gpu/drm/imagination/pvr_gem.c
@@ -350,7 +350,12 @@
 		return ERR_CAST(shmem_obj);
 
 	shmem_obj->pages_mark_dirty_on_put = true;
-	shmem_obj->map_wc = !(flags & PVR_BO_CPU_CACHED);
+	/* Write-combined unless the caller asked for a CPU-cacheable mapping, either
+	 * through the kernel-only flag or the userspace one (DRM_PVR_BO_CPU_CACHED).
+	 * Write-combined makes CPU writes fast and CPU reads very slow (330 MB/s
+	 * measured); cacheable is the other way round and is what a readback needs.
+	 */
+	if (flags & DRM_PVR_BO_CPU_CACHED)
+		flags |= PVR_BO_CPU_CACHED;
+
+	shmem_obj->map_wc = !(flags & (PVR_BO_CPU_CACHED | DRM_PVR_BO_CPU_CACHED));
 	pvr_obj = shmem_gem_to_pvr_gem(shmem_obj);
 	pvr_obj->flags = flags;
 
--- a/drivers/gpu/drm/imagination/pvr_gem.h
+++ b/drivers/gpu/drm/imagination/pvr_gem.h
@@ -61,6 +61,19 @@
 /* Bits 2..0 are defined in the UAPI. */
 
 /* Other utilities. */
+/*
+ * The installed kernel headers this module builds against still describe bits
+ * 3..63 of the BO flags as reserved, so define the userspace flag here. Mesa's
+ * copy of the UAPI header carries the same definition; both sides must agree.
+ */
+#ifndef DRM_PVR_BO_CPU_CACHED
+#define DRM_PVR_BO_CPU_CACHED BIT_ULL(3)
+#undef DRM_PVR_BO_FLAGS_MASK
+#define DRM_PVR_BO_FLAGS_MASK \
+	(DRM_PVR_BO_BYPASS_DEVICE_CACHE | DRM_PVR_BO_PM_FW_PROTECT | \
+	 DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS | DRM_PVR_BO_CPU_CACHED)
+#endif
+
 #define PVR_BO_UNDEFINED_MASK ~(PVR_BO_KERNEL_FLAGS_MASK | DRM_PVR_BO_FLAGS_MASK)
 
 /*

# ---- follow-up: the userspace flag must imply the kernel one -----------------
#
# The hunk above makes the mapping cacheable for either spelling of the flag, but
# the cache maintenance in pvr_gem_object_vmap()/vunmap() is keyed on the
# kernel-only flag, and userspace cannot set bit 63 (pvr_drv.c rejects anything
# outside DRM_PVR_BO_FLAGS_MASK). So a userspace-created cached BO was mapped
# cacheable and never synchronised: the CPU read stale data after a GPU write and
# the GPU could miss CPU writes. Measured on the Cubie A7A: GL through zink with
# this memory type enabled was wrong by 59408 and 73952 of 262144 pixels; after
# this hunk, 8032, 528 and 2144 - much better, still not correct.
#
# What remains is Vulkan's per-submit flush/invalidate: pvr_Flush and
# InvalidateMappedMemoryRanges are still no-ops in the Mesa driver, and the type
# still advertises HOST_COHERENT when it is not. Doing this at map/unmap only
# covers the map-write-unmap-submit pattern, not map-once-then-submit-repeatedly.
# Until a flush/invalidate UAPI exists, Mesa keeps this memory type opt-in
# (PVR_ENABLE_CACHED_MEMORY_TYPE=1).
@@ -337,6 +337,18 @@
 	struct sg_table *sgt;
 	int err;
 
 	/* Verify @size and @flags before continuing. */
 	if (size == 0 || !pvr_gem_object_flags_validate(flags))
 		return ERR_PTR(-EINVAL);
 
 	shmem_obj = drm_gem_shmem_create(from_pvr_device(pvr_dev), size);
 	if (IS_ERR(shmem_obj))
 		return ERR_CAST(shmem_obj);
 
 	shmem_obj->pages_mark_dirty_on_put = true;
+
+	/* A request for a CPU-cacheable mapping must set the kernel-only flag as
+	 * well. map_wc below is cleared for either spelling, but the cache
+	 * maintenance in pvr_gem_object_vmap()/vunmap() is keyed on the kernel flag,
+	 * so without this the object is mapped cacheable and never synchronised.
+	 */
+	if (flags & DRM_PVR_BO_CPU_CACHED)
+		flags |= PVR_BO_CPU_CACHED;
+
 	/* Write-combined unless the caller asked for a CPU-cacheable mapping, either
 	 * through the kernel-only flag or the userspace one (DRM_PVR_BO_CPU_CACHED).
 	 */
 	shmem_obj->map_wc = !(flags & (PVR_BO_CPU_CACHED | DRM_PVR_BO_CPU_CACHED));
