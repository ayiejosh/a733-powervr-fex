From 2d6136e4f3b75e3c85e445159d5e570e0d1b236e Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:17:25 +0800
Subject: [PATCH 1/2] pvr_fw: add os_config_flags test knob for the firmware
 per-OS config flags (ROGUE_FWIF_INICFG_OS_*); vendor driver passes
 context-switch DM_ALL by default, mainline passes 0. Default stays 0 -
 sweeping the bits on this board changed nothing for the native TA kick

---
 pvr_fw.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/pvr_fw.c b/pvr_fw.c
index 4eb4cf9..b583453 100644
--- a/pvr_fw.c
+++ b/pvr_fw.c
@@ -337,6 +337,11 @@ fw_osinit_init(void *cpu_ptr, void *priv)
 	rogue_fwif_compchecks_bvnc_init(&fwif_osinit->rogue_comp_checks.fw_bvnc);
 }
 
+static uint os_config_flags;
+module_param(os_config_flags, uint, 0644);
+MODULE_PARM_DESC(os_config_flags,
+		 "Firmware per-OS config flags (ROGUE_FWIF_INICFG_OS_*): vendor driver passes context-switch DM_ALL by default, mainline passes 0");
+
 static void
 fw_osdata_init(void *cpu_ptr, void *priv)
 {
@@ -345,6 +350,7 @@ fw_osdata_init(void *cpu_ptr, void *priv)
 	struct pvr_fw_mem *fw_mem = &pvr_dev->fw_dev.mem;
 
 	pvr_fw_object_get_fw_addr(fw_mem->power_sync_obj, &fwif_osdata->power_sync_fw_addr);
+	fwif_osdata->fw_os_config_flags = os_config_flags;
 }
 
 static void
