From 8fff2298c0671d90cb228987cae3ee76afdc893f Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 02:00:33 +0800
Subject: [PATCH 055/294] pco: skip the compute instance check for whole-task
 workgroups

Compute workgroups are launched padded to a multiple of
ROGUE_MAX_INSTANCES_PER_TASK (pvr_compute_flat_pad_workgroup_size, and
at least one whole task), so the "local index < workgroup size" check
only ever masks padding instances. When the workgroup size is fixed and
already a multiple of the task size, there are none: drop the check and
its predication setup/teardown.

local_size 64: cstp 26 -> 19 groups, cstpf/cstpi 126 -> 119.
BXM-4-64, interleaved A/B x4 against the previous commit:
  cstp  ~342 -> ~351, cstpf 130 -> 141, cstpi 120 -> 141 M inv/s
Output hashes for 48-wide (check kept) and 96-wide (check dropped)
workgroups are identical to the previous build; other checks unchanged.
---
 src/imagination/pco/pco_nir_compute.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/imagination/pco/pco_nir_compute.c b/src/imagination/pco/pco_nir_compute.c
index c4c5cee8..564c28e0 100644
--- a/src/imagination/pco/pco_nir_compute.c
+++ b/src/imagination/pco/pco_nir_compute.c
@@ -10,6 +10,7 @@
  * \brief PCO NIR compute-specific passes.
  */
 
+#include "hwdef/rogue_hw_defs.h"
 #include "nir.h"
 #include "nir_builder.h"
 #include "pco.h"
@@ -63,6 +64,15 @@ bool pco_nir_compute_instance_check(nir_shader *shader)
 {
    assert(shader->info.stage == MESA_SHADER_COMPUTE);
 
+   /* Workgroups are launched padded to a whole number of tasks; when the
+    * size already is one, no padding instance exists to be skipped.
+    */
+   if (!shader->info.workgroup_size_variable) {
+      const uint16_t *size = shader->info.workgroup_size;
+      if ((size[0] * size[1] * size[2]) % ROGUE_MAX_INSTANCES_PER_TASK == 0)
+         return false;
+   }
+
    nir_function_impl *entrypoint = nir_shader_get_entrypoint(shader);
 
    if (nir_cf_list_is_empty_block(&entrypoint->body))
