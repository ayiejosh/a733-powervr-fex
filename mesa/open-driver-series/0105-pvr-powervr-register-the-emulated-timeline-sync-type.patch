From 03af16c845f3c2dffc4ebd1a158f1e45447c5bef Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Wed, 14 Oct 2026 02:03:37 +0800
Subject: [PATCH 105/294] pvr/powervr: register the emulated timeline sync type
 only without kernel timeline syncobj

The winsys always appended the emulated timeline sync type after the DRM
syncobj type. With kernel timeline syncobj support both types advertise
VK_SYNC_FEATURE_TIMELINE, but the runtime supports a single timeline
type: debug builds assert in get_timeline_mode(), and release builds took
the last type (emulated) as the device timeline mode while timeline
semaphores were still created from the first matching type, the native
one.

Register the emulated type only when the syncobj type has no timeline
support, as anv and radv do. With timeline syncobj the device then runs
in assisted timeline mode on the native type.

The emulated type is then left uninitialised, so drop the per queue
job_sync[] timeline syncobjs that were created from it. They were never
used by the job paths.
---
 src/imagination/vulkan/pvr_arch_queue.c       | 23 ----------------
 src/imagination/vulkan/pvr_queue.h            |  7 -----
 .../vulkan/winsys/powervr/pvr_drm.c           | 26 +++++++++++--------
 3 files changed, 15 insertions(+), 41 deletions(-)

diff --git a/src/imagination/vulkan/pvr_arch_queue.c b/src/imagination/vulkan/pvr_arch_queue.c
index 42aeb84f..657f076e 100644
--- a/src/imagination/vulkan/pvr_arch_queue.c
+++ b/src/imagination/vulkan/pvr_arch_queue.c
@@ -150,27 +150,8 @@ static VkResult pvr_queue_init(struct pvr_device *device,
 
    queue->vk.driver_submit = pvr_driver_queue_submit;
 
-   /* Persistent timeline syncobj per job type. Created here, destroyed in pvr_queue_finish.
-    * Unused for now: the job paths still create and destroy a syncobj per job, so this commit
-    * changes no behaviour. See SYNC-TIMELINE-ATTEMPT-2026-10-08.md. */
-   for (uint32_t i = 0; i < PVR_JOB_TYPE_MAX; i++) {
-      result = vk_sync_create(&device->vk,
-                              &device->pdevice->ws->timeline_syncobj_type.sync,
-                              0U,
-                              0UL,
-                              &queue->job_sync[i]);
-      if (result != VK_SUCCESS)
-         goto err_job_syncs_destroy;
-   }
-
    return VK_SUCCESS;
 
-err_job_syncs_destroy:
-   for (uint32_t i = 0; i < PVR_JOB_TYPE_MAX; i++) {
-      if (queue->job_sync[i])
-         vk_sync_destroy(&device->vk, queue->job_sync[i]);
-   }
-
 err_query_ctx_destroy:
    pvr_arch_compute_ctx_destroy(query_ctx);
 
@@ -225,10 +206,6 @@ err_queues_finish:
 
 static void pvr_queue_finish(struct pvr_queue *queue)
 {
-   for (uint32_t i = 0; i < ARRAY_SIZE(queue->job_sync); i++) {
-      if (queue->job_sync[i])
-         vk_sync_destroy(&queue->device->vk, queue->job_sync[i]);
-   }
 
    for (uint32_t i = 0; i < ARRAY_SIZE(queue->next_job_wait_sync); i++) {
       if (queue->next_job_wait_sync[i])
diff --git a/src/imagination/vulkan/pvr_queue.h b/src/imagination/vulkan/pvr_queue.h
index b5194a93..1bb4ea43 100644
--- a/src/imagination/vulkan/pvr_queue.h
+++ b/src/imagination/vulkan/pvr_queue.h
@@ -39,13 +39,6 @@ struct pvr_queue {
    struct vk_sync *last_job_signal_sync[PVR_JOB_TYPE_MAX];
    struct vk_sync *next_job_wait_sync[PVR_JOB_TYPE_MAX];
 
-   /* Persistent timeline syncobj per job type, created once in pvr_queue_init and destroyed in
-    * pvr_queue_finish. Once the job paths use them, jobs of a type are ordered by timeline
-    * point rather than by creating and destroying a syncobj per job: the previous job
-    * signalled job_value[type], the next one signals job_value[type] + 1. Currently created
-    * but unused - see SYNC-TIMELINE-ATTEMPT-2026-10-08.md for the migration plan. */
-   struct vk_sync *job_sync[PVR_JOB_TYPE_MAX];
-   uint64_t job_value[PVR_JOB_TYPE_MAX];
 };
 
 VK_DEFINE_HANDLE_CASTS(pvr_queue, vk.base, VkQueue, VK_OBJECT_TYPE_QUEUE)
diff --git a/src/imagination/vulkan/winsys/powervr/pvr_drm.c b/src/imagination/vulkan/winsys/powervr/pvr_drm.c
index bdac96bb..d03ad5fd 100644
--- a/src/imagination/vulkan/winsys/powervr/pvr_drm.c
+++ b/src/imagination/vulkan/winsys/powervr/pvr_drm.c
@@ -678,6 +678,7 @@ VkResult pvr_drm_winsys_create(const int render_fd,
 
    struct pvr_drm_winsys *drm_ws;
    VkResult result;
+   unsigned num_sync_types;
    int err;
 
    drm_ws =
@@ -697,18 +698,21 @@ VkResult pvr_drm_winsys_create(const int render_fd,
 
    drm_ws->base.syncobj_type = vk_drm_syncobj_get_type(render_fd);
    drm_ws->base.sync_types[0] = &drm_ws->base.syncobj_type;
+   num_sync_types = 1;
 
-   /* The pvrsrvkm winsys registers a timeline type here (pvr_srv.c) but this one left
-    * sync_types[1] NULL, so every vk_sync was a separate binary DRM syncobj. Measured on
-    * the open stack, that costs Xwayland ~52 SYNCOBJ_CREATE + ~52 SYNCOBJ_DESTROY + ~72
-    * SYNCOBJ_TRANSFER per frame (~190 ioctls, ~10 ms of kernel time per frame), which
-    * serialises the display loop: Xwayland burns 57% of a core while weston sits at 0%.
-    * A timeline syncobj carries many points on one object, so those per-operation
-    * create/transfer/destroy pairs go away. Same construction the sibling winsys uses. */
-   drm_ws->base.timeline_syncobj_type =
-      vk_sync_timeline_get_type(drm_ws->base.sync_types[0]);
-   drm_ws->base.sync_types[1] = &drm_ws->base.timeline_syncobj_type.sync;
-   drm_ws->base.sync_types[2] = NULL;
+   /* The runtime supports a single timeline type. With kernel timeline
+    * syncobj support the syncobj type is it (assisted timeline mode, as in
+    * anv and radv); otherwise emulate timelines on top of binary syncobjs, so
+    * that timeline semaphores do not need one binary syncobj per point.
+    */
+   if (!(drm_ws->base.syncobj_type.features & VK_SYNC_FEATURE_TIMELINE)) {
+      drm_ws->base.timeline_syncobj_type =
+         vk_sync_timeline_get_type(drm_ws->base.sync_types[0]);
+      drm_ws->base.sync_types[num_sync_types++] =
+         &drm_ws->base.timeline_syncobj_type.sync;
+   }
+
+   drm_ws->base.sync_types[num_sync_types] = NULL;
 
    err = u_rwlock_init(&drm_ws->dmabuf_bo_lock);
    if (err) {
