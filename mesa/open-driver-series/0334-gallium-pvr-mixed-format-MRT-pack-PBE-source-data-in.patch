From 5027d7c44d59e76d4bfa192eec08f0e63ee20879 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:09:04 +0800
Subject: [PATCH] gallium/pvr: mixed-format MRT - pack PBE source data in
 logical channel order

A BGRA8 colour target cleared through the PBE came back with red and blue swapped, and mixed-format
MRT could not be enabled on top of that. The cause is in how the two consumers pack pixel data: pco
packs shader colour outputs in *logical* channel order and lets the PBE apply the target format's
channel swizzle (the reference does the same through to_pbe_format, which maps B8G8R8A8 to R8G8B8A8),
but the background clear program packed the clear colour with util_format_pack_rgba() of the *target*
format, i.e. in memory order - so the PBE swizzled a second time. Pack the background colour with the
format pco would use (draw_pbe_pack_format(): B8G8R8A8/B5G5R5A1/A4R4G4B4 -> R8G8B8A8, B5G6R5 ->
R8G8B8), same as the shader path.

With that fixed, mixed-format MRT works and is enabled: the flush no longer falls back to attachment 0,
the fragment variant is built for the actual attachment format set (pco packs each output for its own
format), and the GPU clear covers mixed formats since the background program now carries one packed
colour per attachment.

Verified with open-perf/mrt_test (RGBA8 attachment 0 + BGRA8 attachment 1):
- clear: attachment0 (64 128 191 255), attachment1 (64 128 191 255) - BGRA8 channel order correct;
- draw: attachment0 (128 0 0 255) from gl_FragData[0]=vec4(0.5,0,0,1), attachment1 (255 0 0 255)
  from gl_FragData[1]=vec4(1,0,0,1) - the second format's own pack is used;
- same-format 2- and 4-attachment modes unchanged; full gate green: 49 gltri modes (all native
  glGetError 0x0), 28 mip modes, rttest PASS (bad=0/262144), rt8test unchanged (255 0 / 255 128),
  0 MMU faults.
Remaining MRT limits: every attachment must be a one-dword-per-pixel format (the PBE's source_pos has
four start positions; formats wider than 32 bits would need a cumulative output-dword mapping), and
per-render-target blend state is not tracked (ES2 has none).
---
 src/gallium/drivers/pvr_native/pvr_context.c |  9 +----
 src/gallium/drivers/pvr_native/pvr_draw.c    | 42 ++++++++++----------
 2 files changed, 21 insertions(+), 30 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index d77fc078..cab2b5a0 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -622,15 +622,8 @@ pvr_clear(struct pipe_context *pctx, unsigned buffers, uint32_t color_clear_mask
     * attachment, each packed for that attachment's format, so mixed-format MRT clears too); then
     * there is nothing for the CPU to fill for it. */
    bool gpu_cleared = false;
-   /* Mixed-format MRT falls back to per-attachment CPU clears (the GPU clear writes one packed
-    * colour per attachment from a single background program, which is only verified while every
-    * attachment shares a format). */
-   bool mrt_same_fmt = true;
-   for (unsigned i = 1; i < ctx->fb.nr_cbufs; i++)
-      if (ctx->fb.cbufs[i].format != ctx->fb.cbufs[0].format)
-         mrt_same_fmt = false;
    if ((buffers & PIPE_CLEAR_COLOR0) && (color_clear_mask & 0xf) == 0xf && scissor_state == NULL &&
-       ctx->fb.nr_cbufs >= 1 && ctx->fb.nr_cbufs <= PVR_MAX_COLOR_ATTACHMENTS && mrt_same_fmt) {
+       ctx->fb.nr_cbufs >= 1 && ctx->fb.nr_cbufs <= PVR_MAX_COLOR_ATTACHMENTS) {
       gpu_cleared = pvr_draw_note_clear(ctx, color);
       /* MRT: one background colour covers every attachment (v1), so submit the clear render now -
        * deferred clears are single-resource only. */
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 82fa3d33..80aba820 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -1105,6 +1105,25 @@ draw_topology(enum mesa_prim mode, enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY *out)
    }
 }
 
+/* The format the PBE's source data must be packed in: logical channel order, because the PBE applies
+ * the target format's channel swizzle itself. pco does the same for shader outputs (to_pbe_format
+ * maps B8G8R8A8 to R8G8B8A8 before packing), so the background clear colour must follow it too -
+ * packing it in the target's memory order swapped red and blue on a BGRA8 target. */
+static enum pipe_format
+draw_pbe_pack_format(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_B5G6R5_UNORM:
+      return PIPE_FORMAT_R8G8B8_UNORM;
+   case PIPE_FORMAT_A4R4G4B4_UNORM:
+   case PIPE_FORMAT_B5G5R5A1_UNORM:
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+      return PIPE_FORMAT_R8G8B8A8_UNORM;
+   default:
+      return format;
+   }
+}
+
 /* Pack a clear colour for an 8-bit-per-channel target. */
 static uint32_t
 draw_pack_color(enum pipe_format format, const union pipe_color_union *c)
@@ -1388,12 +1407,6 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
    unsigned nr_formats = MIN2(ctx->fb.nr_cbufs, PVR_MAX_COLOR_ATTACHMENTS);
    for (unsigned i = 0; i < nr_formats; i++)
       rt_formats[i] = ctx->fb.cbufs[i].format;
-   for (unsigned i = 1; i < nr_formats; i++) {
-      if (rt_formats[i] != rt_formats[0]) {
-         nr_formats = 1;
-         break;
-      }
-   }
    nir_lower_blend_options blend;
    memset(&blend, 0, sizeof(blend));
    {
@@ -1864,26 +1877,11 @@ pvr_draw_flush(struct pvr_context *ctx)
          }
       }
    }
-   /* Mixed formats are still single-attachment: the per-attachment write path is not validated
-    * yet (and until it is, attachment 0 is the honest fallback rather than a wrong second target). */
-   if (nr_attach > 1) {
-      for (unsigned i = 1; i < nr_attach; i++) {
-         if (eot_formats[i] != eot_formats[0]) {
-            static bool warned;
-            if (!warned) {
-               warned = true;
-               mesa_logw("pvr: mixed-format MRT is not supported yet; rendering to attachment 0");
-            }
-            nr_attach = 1;
-            break;
-         }
-      }
-   }
    const uint64_t eot = draw_eot_program(ctx, d, nr_attach, eot_addrs, eot_formats, zonly);
    uint32_t bg_colors[PVR_MAX_COLOR_ATTACHMENTS] = { 0 };
    for (unsigned i = 0; i < nr_attach; i++)
       if (d->clear_valid)
-         bg_colors[i] = draw_pack_color(eot_formats[i], &d->clear_value);
+         bg_colors[i] = draw_pack_color(draw_pbe_pack_format(eot_formats[i]), &d->clear_value);
    const uint64_t bg = draw_bg_program(ctx, d, bg_colors, zonly ? 1 : nr_attach);
    uint64_t pbe_words[PVR_MAX_COLOR_ATTACHMENTS * 3] = { 0 };
    if (eot == 0 || bg == 0 || !pvr_csb_pbe_words(eot_formats[0], pvr_resource_level_stride(rt, d->rt_level),
-- 
2.47.3

