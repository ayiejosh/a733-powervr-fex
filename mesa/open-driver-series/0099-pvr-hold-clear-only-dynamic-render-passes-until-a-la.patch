+static inline void pvr_set_track_image(struct pvr_descriptor_set *set,
+                                       const void *image)
+{
+   if (set->images_overflow)
+      return;
+
+   for (uint32_t i = 0; i < set->num_images; i++) {
+      if (set->images[i] == image)
+         return;
+   }
+
+   if (set->num_images == ARRAY_SIZE(set->images))
+      set->images_overflow = true;
+   else
+      set->images[set->num_images++] = image;
+}
