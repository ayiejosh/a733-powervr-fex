+   }
+
    pvr_cmd_buffer_update_barriers(cmd_buffer, type);
 
    /* TODO: Add proper support for joining consecutive event sub_cmd? */
@@ -4202,6 +4215,11 @@ void PVR_PER_ARCH(CmdBeginRenderPass2)(
 
    PVR_CHECK_COMMAND_BUFFER_BUILDING_STATE(cmd_buffer);
 
+   /* The nested render passes of the flush would overwrite the state set up
+    * below.
+    */
