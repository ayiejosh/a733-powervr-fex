+static void pvr_clear_fold_flush(struct pvr_cmd_buffer *cmd_buffer);
+
 static void pvr_cmd_buffer_free_sub_cmd(struct pvr_cmd_buffer *cmd_buffer,
                                         struct pvr_sub_cmd *sub_cmd)
 {
@@ -2900,6 +2903,16 @@ VkResult pvr_arch_cmd_buffer_start_sub_cmd(struct pvr_cmd_buffer *cmd_buffer,
    if (vk_command_buffer_has_error(&cmd_buffer->vk))
       return vk_command_buffer_get_record_result(&cmd_buffer->vk);
 
+   /* Clears held back from an earlier pass are submitted before anything but
+    * the next dynamic render pass can see the cleared image.
+    */
+   if (state->pending_clear_count && !state->pending_clear_flushing &&
+       type != PVR_SUB_CMD_TYPE_GRAPHICS) {
+      pvr_clear_fold_flush(cmd_buffer);
