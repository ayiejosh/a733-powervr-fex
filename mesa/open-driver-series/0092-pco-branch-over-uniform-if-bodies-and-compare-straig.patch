+                   pco_instr **writes,
+                   unsigned num_writes)
 {
    pco_block *prologue = cf_section_create(func,
                                            &pif->cf_node,
@@ -137,12 +200,8 @@ lower_if_pred_exec(pco_if *pif, pco_func *func, bool has_else, bool invert_cond)
    /* Setup the prologue. */
    pco_builder b = pco_builder_create(func, pco_cursor_after_block(prologue));
 
-   /* TODO: see if the cond producer can set p0 directly. */
-   pco_tstz(&b,
-            pco_ref_null(),
-            pco_ref_pred(PCO_PRED_P0),
-            pif->cond,
-            .tst_type_main = PCO_TST_TYPE_MAIN_U32);
+   invert_cond ^=
+      set_p0_from_cond(&b, pif->cond, PCO_EXEC_CND_E1_ZX, writes, num_writes);
 
    set_body_exec_cnd(&pif->then_body,
                      invert_cond ? PCO_EXEC_CND_E1_Z1 : PCO_EXEC_CND_E1_Z0);
@@ -154,7 +213,12 @@ lower_if_pred_exec(pco_if *pif, pco_func *func, bool has_else, bool invert_cond)
 }
 
 static inline void
-lower_if_cond_exec(pco_if *pif, pco_func *func, bool has_else, bool invert_cond)
+lower_if_cond_exec(pco_if *pif,
+                   pco_func *func,
+                   bool has_else,
+                   bool invert_cond,
+                   pco_instr **writes,
+                   unsigned num_writes)
 {
    pco_block *prologue = cf_section_create(func,
                                            &pif->cf_node,
@@ -177,12 +241,8 @@ lower_if_cond_exec(pco_if *pif, pco_func *func, bool has_else, bool invert_cond)
    pco_builder b = pco_builder_create(func, pco_cursor_after_block(prologue));
    pco_ref emc = pco_emc_ref(func, &b);
 
-   /* TODO: see if the cond producer can set p0 directly. */
-   pco_tstz(&b,
-            pco_ref_null(),
-            pco_ref_pred(PCO_PRED_P0),
-            pif->cond,
-            .tst_type_main = PCO_TST_TYPE_MAIN_U32);
+   invert_cond ^=
+      set_p0_from_cond(&b, pif->cond, PCO_EXEC_CND_E1_ZX, writes, num_writes);
 
    pco_cndst(&b,
              pco_ref_pred(PCO_PRED_PE),
@@ -222,7 +282,118 @@ lower_if_cond_exec(pco_if *pif, pco_func *func, bool has_else, bool invert_cond)
               .exec_cnd = PCO_EXEC_CND_EX_ZX);
 }
 
-static inline void lower_if(pco_if *pif, pco_func *func)
+/* An if whose condition is the same in every instance, outside of any loop or
+ * conditionally executed if, so that no instance is masked: branch over the
+ * body that isn't taken instead of masking instances. The condition producers
+ * run in every instance so that p0 is valid in all of them.
+ */
+static inline void
+lower_if_uniform(pco_if *pif,
+                 pco_func *func,
+                 bool has_else,
+                 bool invert_cond,
+                 pco_instr **writes,
+                 unsigned num_writes)
+{
+   pco_block *prologue = cf_section_create(func,
+                                           &pif->cf_node,
+                                           &pif->prologue,
+                                           PCO_CF_NODE_FLAG_PROLOGUE);
+   pco_block *interlogue = has_else
+                              ? cf_section_create(func,
+                                                  &pif->cf_node,
+                                                  &pif->interlogue,
+                                                  PCO_CF_NODE_FLAG_INTERLOGUE)
+                              : NULL;
+   pco_block *epilogue = cf_section_create(func,
+                                           &pif->cf_node,
+                                           &pif->epilogue,
+                                           PCO_CF_NODE_FLAG_EPILOGUE);
+
+   pco_builder b = pco_builder_create(func, pco_cursor_after_block(prologue));
+   invert_cond ^=
+      set_p0_from_cond(&b, pif->cond, PCO_EXEC_CND_EX_ZX, writes, num_writes);
+
+   /* Skip the then body when the condition is false. */
+   pco_br(&b,
+          has_else ? pco_cf_node_head(&pif->else_body) : &epilogue->cf_node,
+          .exec_cnd = invert_cond ? PCO_EXEC_CND_E1_Z0 : PCO_EXEC_CND_E1_Z1);
+
+   if (has_else) {
+      b.cursor = pco_cursor_after_block(interlogue);
+      pco_br(&b, &epilogue->cf_node, .exec_cnd = PCO_EXEC_CND_EX_ZX);
+   }
+}
+
+/* Whether a value is the same in every instance: computed only by pure ALU
+ * ops from shared registers, constants and immediates.
+ */
+static bool ref_is_uniform(pco_instr **writes,
+                           unsigned num_writes,
+                           pco_ref ref,
+                           struct util_dynarray *producers,
+                           unsigned depth)
+{
+   if (pco_ref_is_null(ref) || pco_ref_is_imm(ref))
+      return true;
+
+   if (pco_ref_is_hwreg(ref)) {
+      enum pco_reg_class reg_class = pco_ref_get_reg_class(ref);
+      return reg_class == PCO_REG_CLASS_SHARED ||
+             reg_class == PCO_REG_CLASS_CONST;
+   }
+
+   if (!pco_ref_is_ssa(ref) || ref.val >= num_writes || !depth)
+      return false;
+
+   /* (ignorepe) producers come from an earlier uniform if. */
+   pco_instr *instr = writes[ref.val];
+   if (!instr || !pco_instr_has_exec_cnd(instr) ||
+       (!pco_instr_has_default_exec(instr) &&
+        pco_instr_get_exec_cnd(instr) != PCO_EXEC_CND_EX_ZX))
+      return false;
+
+   switch (instr->op) {
+   case PCO_OP_MOV:
+   case PCO_OP_MOVI32:
+   case PCO_OP_MBYP:
+   case PCO_OP_LOGICAL:
+   case PCO_OP_SHIFT:
+   case PCO_OP_IADD32:
+   case PCO_OP_BCMP:
+   case PCO_OP_BCSEL:
+   case PCO_OP_CSEL:
+   case PCO_OP_TSTZ:
+      break;
+   default:
+      return false;
+   }
+
+   pco_foreach_instr_dest (pdest, instr) {
+      if (pco_ref_is_pred(*pdest))
+         return false;
+   }
+
+   pco_foreach_instr_src (psrc, instr) {
+      if (!ref_is_uniform(writes, num_writes, *psrc, producers, depth - 1))
+         return false;
+   }
+
+   util_dynarray_append(producers, instr);
+   return true;
+}
+
+static inline unsigned body_num_instrs(struct list_head *body)
+{
+   if (list_is_empty(body))
+      return 0;
+
+   pco_block *block = pco_cf_node_as_block(pco_cf_node_head(body));
+   return list_length(&block->instrs);
+}
+
+static inline void
+lower_if(pco_if *pif, pco_func *func, pco_instr **writes, unsigned num_writes)
 {
    assert(!pco_ref_is_null(pif->cond));
    assert(list_is_empty(&pif->prologue));
@@ -249,9 +420,11 @@ static inline void lower_if(pco_if *pif, pco_func *func)
    assert(has_then);
 
    if (pif->pred_exec)
-      lower_if_pred_exec(pif, func, has_else, invert_cond);
+      lower_if_pred_exec(pif, func, has_else, invert_cond, writes, num_writes);
+   else if (pif->uniform)
+      lower_if_uniform(pif, func, has_else, invert_cond, writes, num_writes);
    else
-      lower_if_cond_exec(pif, func, has_else, invert_cond);
+      lower_if_cond_exec(pif, func, has_else, invert_cond, writes, num_writes);
 
    pif->cond = pco_ref_null();
 }
@@ -390,6 +563,15 @@ static inline bool pco_lower_cf(pco_func *func)
    util_dynarray_init(&pif_stack, mem_ctx);
    util_dynarray_init(&loop_stack, mem_ctx);
 
+   /* Loops and conditionally executed ifs that can mask instances. */
+   unsigned masking_nestings = 0;
+   unsigned num_writes = func->next_ssa;
+   pco_instr **writes = rzalloc_array(mem_ctx, pco_instr *, num_writes);
+   pco_foreach_instr_in_func (instr, func) {
+      pco_foreach_instr_dest_ssa (pdest, instr) {
+         writes[pdest->val] = instr;
+      }
+   }
    pco_foreach_cf_node_in_func_structured (cf_node, cf_node_completed, func) {
       /* Handle the end of an if/loop. */
       if (cf_node_completed) {
@@ -399,9 +581,10 @@ static inline bool pco_lower_cf(pco_func *func)
 
             ASSERTED pco_if *last_pif = util_dynarray_pop(&pif_stack, pco_if *);
             assert(pif == last_pif);
-
-            if (!pif->pred_exec)
+            if (!pif->pred_exec && !pif->uniform) {
                --loop_nestings;
+               --masking_nestings;
+            }
 
             break;
          }
@@ -414,6 +597,7 @@ static inline bool pco_lower_cf(pco_func *func)
 
             assert(loop_nestings == 0);
             loop_nestings = util_dynarray_pop(&loop_nestings_stack, unsigned);
+            --masking_nestings;
             break;
          }
 
@@ -427,12 +611,37 @@ static inline bool pco_lower_cf(pco_func *func)
       case PCO_CF_NODE_TYPE_IF: {
          pco_if *pif = pco_cf_node_as_if(cf_node);
          pif->pred_exec = can_pred_exec(pif);
-         util_dynarray_append(&pif_stack, pif);
 
-         if (!pif->pred_exec)
+         struct util_dynarray producers;
+         util_dynarray_init(&producers, mem_ctx);
+         bool uniform = !masking_nestings && !PCO_DEBUG(NO_PRED_CF) &&
+                        ref_is_uniform(writes,
+                                       num_writes,
+                                       pif->cond,
+                                       &producers,
+                                       8);
+
+         /* Predicated bodies are issued either way; branch over large ones. */
+         if (pif->pred_exec && uniform &&
+             body_num_instrs(&pif->then_body) +
+                   body_num_instrs(&pif->else_body) >
+                4) {
+            pif->pred_exec = false;
+         }
+
+         pif->uniform = uniform && !pif->pred_exec;
+         if (pif->uniform) {
+            util_dynarray_foreach (&producers, pco_instr *, producer)
+               pco_instr_set_exec_cnd(*producer, PCO_EXEC_CND_EX_ZX);
+         }
+
+         util_dynarray_append(&pif_stack, pif);
+         if (!pif->pred_exec && !pif->uniform) {
             ++loop_nestings;
+            ++masking_nestings;
+         }
 
-         lower_if(pif, func);
+         lower_if(pif, func, writes, num_writes);
          progress = true;
 
          break;
@@ -441,6 +650,7 @@ static inline bool pco_lower_cf(pco_func *func)
       case PCO_CF_NODE_TYPE_LOOP: {
          util_dynarray_append(&loop_nestings_stack, loop_nestings);
          loop_nestings = 0;
+         ++masking_nestings;
 
          pco_loop *loop = pco_cf_node_as_loop(cf_node);
          util_dynarray_append(&loop_stack, loop);
