+++ b/src/imagination/pco/pco_cf.c
@@ -22,13 +22,19 @@
 #include <assert.h>
 #include <stdbool.h>
 
-pco_ref pco_emc_ref(pco_func *func, pco_builder *b)
+pco_ref pco_emc_ref(pco_func *func, UNUSED pco_builder *b)
 {
    if (pco_ref_is_null(func->emc)) {
-      /* Allocate and initialize the emc. */
+      /* Allocate and initialize the emc at the start of the function, so that
+       * it is initialized on every path, including the ones that branch over
+       * uniform if bodies.
+       */
       func->emc = pco_ref_new_vreg(func);
+      pco_builder init_b =
+         pco_builder_create(func,
+                            pco_cursor_before_block(pco_func_first_block(func)));
 
-      pco_cndst(b,
+      pco_cndst(&init_b,
                 pco_ref_pred(PCO_PRED_PE),
                 func->emc,
                 pco_zero,
@@ -126,8 +132,65 @@ static inline void set_body_exec_cnd(struct list_head *body,
    }
 }
 
+/* Whether a comparison source has the same value wherever the comparison is
+ * recomputed before its if.
+ */
+static inline bool cmp_src_is_stable(pco_ref ref)
+{
+   if (pco_ref_is_ssa(ref) || pco_ref_is_imm(ref))
+      return true;
+
+   if (!pco_ref_is_hwreg(ref))
+      return false;
+
+   enum pco_reg_class reg_class = pco_ref_get_reg_class(ref);
+   return reg_class == PCO_REG_CLASS_SHARED || reg_class == PCO_REG_CLASS_CONST;
+}
+
+/* Sets p0 from the if condition and returns whether p0 is set when the
+ * condition is true. A condition that comes straight from a comparison is
+ * recomputed into p0, instead of testing its boolean result; DCE removes the
+ * comparison if nothing else uses it.
+ */
+static bool set_p0_from_cond(pco_builder *b,
+                             pco_ref cond,
+                             enum pco_exec_cnd exec_cnd,
+                             pco_instr **writes,
+                             unsigned num_writes)
+{
+   pco_instr *cmp = pco_ref_is_ssa(cond) && cond.val < num_writes
+                       ? writes[cond.val]
+                       : NULL;
+
+   if (cmp && cmp->op == PCO_OP_BCMP && cmp_src_is_stable(cmp->src[0]) &&
+       cmp_src_is_stable(cmp->src[1])) {
+      pco_tstp(b,
+               pco_ref_null(),
+               pco_ref_pred(PCO_PRED_P0),
+               cmp->src[0],
+               cmp->src[1],
+               .exec_cnd = exec_cnd,
+               .tst_op_main = pco_instr_get_tst_op_main(cmp),
+               .tst_type_main = pco_instr_get_tst_type_main(cmp));
+      return true;
+   }
+
+   pco_tstz(b,
+            pco_ref_null(),
+            pco_ref_pred(PCO_PRED_P0),
+            cond,
+            .exec_cnd = exec_cnd,
+            .tst_type_main = PCO_TST_TYPE_MAIN_U32);
+   return false;
+}
+
 static inline void
-lower_if_pred_exec(pco_if *pif, pco_func *func, bool has_else, bool invert_cond)
+lower_if_pred_exec(pco_if *pif,
