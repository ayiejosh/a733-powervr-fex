From d8e187e1aa395938322be4e7aceed25f8b1076e2 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:46:36 +0800
Subject: [PATCH 107/269] gallium/pvr: enumerate the device via
 DRM_IOCTL_PVR_DEV_QUERY

Reads the GPU identity through the same kernel interface the Vulkan driver uses and decodes
drm_pvr_dev_query_gpu_info.gpu_id, which packs BVNC as four 16-bit fields (B|V|N|C), naming the
screen from it and logging the result. A failed query is reported as such rather than papered
over - it is not fatal for a skeleton.

The UAPI comes from Mesa's synced copy, include/drm-uapi/pvr_drm.h, NOT the copy under
src/imagination/vulkan/winsys/powervr/. That means the Vulkan driver is untouched, which was a
constraint - and it also means the earlier plan to 'move the UAPI to a shared location' was
solving a problem that did not exist.

Builds clean: ninja -C build src/gallium/drivers/pvr/libpvr.a
NOT YET VERIFIED against hardware: pvr_screen_create needs a DRM fd for the PowerVR device, so
exercising it requires the powervr driver bound. That verification is the next step.
---
 src/gallium/drivers/pvr/pvr_screen.c | 37 +++++++++++++++++++++++++---
 1 file changed, 33 insertions(+), 4 deletions(-)

diff --git a/src/gallium/drivers/pvr/pvr_screen.c b/src/gallium/drivers/pvr/pvr_screen.c
index c6582a77..2bed94cf 100644
--- a/src/gallium/drivers/pvr/pvr_screen.c
+++ b/src/gallium/drivers/pvr/pvr_screen.c
@@ -12,6 +12,12 @@
 #include <unistd.h>
 #include <sys/ioctl.h>
 
+#include <xf86drm.h>
+
+/* The kernel UAPI, from Mesa's synced copy - the same header the Vulkan driver uses.
+ * Deliberately NOT the copy inside src/imagination/vulkan/winsys/powervr/. */
+#include "drm-uapi/pvr_drm.h"
+
 #include "util/u_memory.h"
 #include "util/os_file.h"
 #include "util/log.h"
@@ -55,10 +61,33 @@ pvr_screen_create(int fd, const struct pipe_screen_config *config,
    screen->fd = fd;
    screen->gpu_id = 0;
 
-   /* Enumeration is deliberately minimal for the skeleton: confirm we were handed a
-    * usable device and say so. The kernel UAPI query (DRM_IOCTL_PVR_DEV_QUERY) is the
-    * next step, and it needs the UAPI header moved out of the Vulkan winsys first. */
-   snprintf(screen->name, sizeof(screen->name), "PowerVR Rogue (gallium skeleton)");
+   /* Enumerate the device through the same DRM interface the Vulkan driver uses.
+    * drm_pvr_dev_query_gpu_info.gpu_id packs BVNC as four 16-bit fields: B|V|N|C. */
+   {
+      struct drm_pvr_dev_query_gpu_info query = { 0 };
+      struct drm_pvr_ioctl_dev_query_args args = {
+         .type = DRM_PVR_DEV_QUERY_GPU_INFO_GET,
+         .size = sizeof(query),
+         .pointer = (__u64)&query,
+      };
+
+      if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) == 0) {
+         const unsigned b = (query.gpu_id >> 48) & 0xffff;
+         const unsigned v = (query.gpu_id >> 32) & 0xffff;
+         const unsigned n = (query.gpu_id >> 16) & 0xffff;
+         const unsigned c = query.gpu_id & 0xffff;
+
+         screen->gpu_id = v;
+         snprintf(screen->name, sizeof(screen->name),
+                  "PowerVR Rogue B%d.%d.%d.%d", b, v, n, c);
+         mesa_logi("pvr: enumerated BVNC %u.%u.%u.%u (gpu_id 0x%llx)", b, v, n, c,
+                   (unsigned long long)query.gpu_id);
+      } else {
+         /* Not fatal for a skeleton: report that we could not query rather than pretend. */
+         snprintf(screen->name, sizeof(screen->name), "PowerVR Rogue (query failed)");
+         mesa_logi("pvr: DRM_IOCTL_PVR_DEV_QUERY failed on fd=%d", fd);
+      }
+   }
    mesa_logi("pvr: pvr_screen_create fd=%d -> %s (skeleton: no draw path)", fd, screen->name);
 
    screen->base.destroy = pvr_destroy_screen;
-- 
