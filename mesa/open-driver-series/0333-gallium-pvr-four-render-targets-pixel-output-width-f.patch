From 6b92b7687d841c9df71790f88f747391718db2a3 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Thu, 29 Oct 2026 21:59:49 +0800
Subject: [PATCH] gallium/pvr: four render targets - pixel-output width from
 the colour dword count

ES3 requires four colour attachments (MAX_DRAW_BUFFERS/MAX_COLOR_ATTACHMENTS >= 4) and the cap was
already 4, but a 3- or 4-attachment framebuffer rendered nothing: the fragment static stream hardcoded
USC_PIXEL_OUTPUT_CTRL's width to 2REGISTERS (the value from the verified single-colour 512x512
capture), and the USC pixel-output path only carries as many dwords as that width says. Derive the
width from the render instead, exactly as the reference does from hw_render->output_regs_count: the
total colour dwords per pixel (sum of each attachment's format size in dwords), rounded up to a power
of two and clamped to the core minimum of two, encoded in bits [0:1] (2REGISTERS = 0, 4REGISTERS = 1,
8REGISTERS = 2).

The background clear program now takes one packed clear colour per attachment instead of a single
dword; while every attachment shares a format the values are identical, so this is only groundwork
for mixed-format MRT (which still falls back to attachment 0 with a warning until its write path is
validated).

Verified with open-perf/mrt_test extended to N attachments (MRT_ATT=4):
- 4x RGBA8 with glDrawBuffersEXT(4): attachment0 red, 1 blue, 2 green, 3 yellow - exactly the
  gl_FragData[] values, 2 targets unchanged;
- clear covers all four attachments; full gltri gate 49 modes (all native glGetError 0x0), mip gate
  28 modes, rttest PASS (bad=0/262144), rt8test unchanged (255 0 / 255 128), 0 MMU faults.
New finding while testing mixed formats (not introduced here, documented for follow-up): a BGRA8
colour target cleared via the PBE and sampled back returns red/blue swapped, i.e. the BGRA8
render-target byte order is wrong somewhere between PBE write and TPU decode.
---
 src/gallium/drivers/pvr_native/pvr_context.c |  8 ++-
 src/gallium/drivers/pvr_native/pvr_draw.c    | 69 ++++++++++++++------
 2 files changed, 54 insertions(+), 23 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index 74a29af5..d77fc078 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -618,9 +618,13 @@ pvr_clear(struct pipe_context *pctx, unsigned buffers, uint32_t color_clear_mask
          return;
    }
 
-   /* A full colour clear of buffer 0 becomes the render's background object; then there is
-    * nothing for the CPU to fill for it. */
+   /* A full colour clear of buffer 0 becomes the render's background object (one store per
+    * attachment, each packed for that attachment's format, so mixed-format MRT clears too); then
+    * there is nothing for the CPU to fill for it. */
    bool gpu_cleared = false;
+   /* Mixed-format MRT falls back to per-attachment CPU clears (the GPU clear writes one packed
+    * colour per attachment from a single background program, which is only verified while every
+    * attachment shares a format). */
    bool mrt_same_fmt = true;
    for (unsigned i = 1; i < ctx->fb.nr_cbufs; i++)
       if (ctx->fb.cbufs[i].format != ctx->fb.cbufs[0].format)
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 958e6fd9..82fa3d33 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -59,7 +59,7 @@ struct pvr_draw_pds_prog {
 };
 
 struct pvr_draw_bg {
-   uint32_t color;
+   uint32_t colors[PVR_MAX_COLOR_ATTACHMENTS];
    unsigned nr_outputs;
    uint64_t pds_offset;
 };
@@ -148,6 +148,7 @@ struct pvr_draw_state {
 
    bool clear_valid;
    uint32_t clear_color;
+   union pipe_color_union clear_value;
    /* The render's depth buffer (NULL: none) and its recorded clear. */
    struct pipe_resource *zs;
    bool zclear_valid;
@@ -890,17 +891,20 @@ draw_uniform_program(struct pvr_context *ctx, struct pvr_draw_state *d,
                            data_off, data_dwords, temps);
 }
 
-/* The background object for a clear colour: a constant-colour fragment program. */
+/* The background object for a clear colour: a constant-colour fragment program. Each attachment
+ * gets the clear colour packed for its own format, so a mixed-format MRT clear needs one program
+ * with one store per output dword. */
 static uint64_t
-draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint32_t color,
-                unsigned nr_outputs)
+draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d,
+                const uint32_t *colors, unsigned nr_outputs)
 {
    struct pvr_screen *scr = draw_screen(ctx);
    nir_builder b;
    struct pvr_shader *bg;
 
    for (unsigned i = 0; i < d->nr_bg; i++) {
-      if (d->bg[i].color == color && d->bg[i].nr_outputs == nr_outputs)
+      if (d->bg[i].nr_outputs == nr_outputs &&
+          !memcmp(d->bg[i].colors, colors, nr_outputs * sizeof(colors[0])))
          return d->bg[i].pds_offset;
    }
    b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(), "pvr_bg");
@@ -908,15 +912,16 @@ draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint32_t colo
    /* One packed colour into each colour attachment's pixel output dword: the EOT emit for
     * attachment i reads dword i. */
    for (unsigned i = 0; i < nr_outputs; i++)
-      nir_frag_store_pco(&b, nir_imm_int(&b, (int)color), .base = i);
+      nir_frag_store_pco(&b, nir_imm_int(&b, (int)colors[i]), .base = i);
    nir_jump(&b, nir_jump_return);
    bg = pvr_shader_create(b.shader, scr->pco_ctx);
    if (bg == NULL || !draw_upload_fs(scr, bg))
       return 0;
    /* shortcut: four cached colours, round robin; the evicted programs stay allocated. */
-   const unsigned slot = d->nr_bg < ARRAY_SIZE(d->bg) ? d->nr_bg++ : (color & 3);
-   d->bg[slot] = (struct pvr_draw_bg){ .color = color, .nr_outputs = nr_outputs,
+   const unsigned slot = d->nr_bg < ARRAY_SIZE(d->bg) ? d->nr_bg++ : (colors[0] & 3);
+   d->bg[slot] = (struct pvr_draw_bg){ .nr_outputs = nr_outputs,
                                        .pds_offset = bg->pds_offset };
+   memcpy(d->bg[slot].colors, colors, nr_outputs * sizeof(colors[0]));
    return bg->pds_offset;
 }
 
@@ -1653,6 +1658,7 @@ pvr_draw_note_clear(struct pvr_context *ctx, const union pipe_color_union *color
                                ctx->fb.width, ctx->fb.height, ctx->fb.zsbuf.texture)))
       return false;
    d->clear_valid = true;
+   d->clear_value = *color;
    d->clear_color = draw_pack_color(ctx->fb.cbufs[0].format, color);
    return true;
 }
@@ -1856,22 +1862,29 @@ pvr_draw_flush(struct pvr_context *ctx)
             eot_addrs[i] = pvr_resource_level_addr(ri, ctx->fb.cbufs[i].level);
             eot_formats[i] = ctx->fb.cbufs[i].format;
          }
-         for (unsigned i = 1; i < nr_attach; i++) {
-            if (eot_formats[i] != eot_formats[0]) {
-               static bool warned;
-               if (!warned) {
-                  warned = true;
-                  mesa_logw("pvr: mixed-format MRT is not supported yet; rendering to attachment 0");
-               }
-               nr_attach = 1;
-               break;
+      }
+   }
+   /* Mixed formats are still single-attachment: the per-attachment write path is not validated
+    * yet (and until it is, attachment 0 is the honest fallback rather than a wrong second target). */
+   if (nr_attach > 1) {
+      for (unsigned i = 1; i < nr_attach; i++) {
+         if (eot_formats[i] != eot_formats[0]) {
+            static bool warned;
+            if (!warned) {
+               warned = true;
+               mesa_logw("pvr: mixed-format MRT is not supported yet; rendering to attachment 0");
             }
+            nr_attach = 1;
+            break;
          }
       }
    }
    const uint64_t eot = draw_eot_program(ctx, d, nr_attach, eot_addrs, eot_formats, zonly);
-   const uint64_t bg = draw_bg_program(ctx, d, d->clear_valid ? d->clear_color : 0,
-                                       zonly ? 1 : nr_attach);
+   uint32_t bg_colors[PVR_MAX_COLOR_ATTACHMENTS] = { 0 };
+   for (unsigned i = 0; i < nr_attach; i++)
+      if (d->clear_valid)
+         bg_colors[i] = draw_pack_color(eot_formats[i], &d->clear_value);
+   const uint64_t bg = draw_bg_program(ctx, d, bg_colors, zonly ? 1 : nr_attach);
    uint64_t pbe_words[PVR_MAX_COLOR_ATTACHMENTS * 3] = { 0 };
    if (eot == 0 || bg == 0 || !pvr_csb_pbe_words(eot_formats[0], pvr_resource_level_stride(rt, d->rt_level),
                                                  d->rt_w, d->rt_h,
@@ -1915,8 +1928,22 @@ pvr_draw_flush(struct pvr_context *ctx)
       pvr_csb_pds_bgnd_words((uint32_t)bg, (uint32_t)bg, (uint32_t)bg, 0, 0, 0, bgnd);
    memcpy(pr_bgnd, bgnd, sizeof(bgnd));
    pvr_frag_static_stream_fill_bgnd(fstream, sizeof(fstream), d->bct_addr, bgnd, pr_bgnd);
-   /* shortcut: ISP scalars from the verified 512x512 single-colour draw (review item A14). */
-   pvr_frag_static_stream_set_isp(fstream, sizeof(fstream), 0x00007ff8u, 0x80035000u, 0x00000201u);
+   /* USC pixel-output width: the total colour dwords per pixel, rounded up to a power of two and
+    * clamped to the core minimum of two registers (the reference derives it the same way from
+    * hw_render->output_regs_count). The value sits in bits [0:1] of USC_PIXEL_OUTPUT_CTRL:
+    * 2REGISTERS = 0, 4REGISTERS = 1, 8REGISTERS = 2. */
+   unsigned total_dwords = 0;
+   for (unsigned i = 0; i < nr_attach; i++)
+      total_dwords += DIV_ROUND_UP(util_format_get_blocksize(eot_formats[i]), 4u);
+   const unsigned width_regs = MAX2(util_next_power_of_two(total_dwords), 2u);
+   uint32_t usc_pixel_output_ctrl = 0x00007ff8u & ~0x3u;
+   if (width_regs == 4)
+      usc_pixel_output_ctrl |= 1u;   /* ROGUE_CR_PIXEL_WIDTH_4REGISTERS */
+   else if (width_regs == 8)
+      usc_pixel_output_ctrl |= 2u;   /* ROGUE_CR_PIXEL_WIDTH_8REGISTERS */
+   /* shortcut: the remaining ISP scalars are from the verified 512x512 single-colour draw. */
+   pvr_frag_static_stream_set_isp(fstream, sizeof(fstream), usc_pixel_output_ctrl, 0x80035000u,
+                                  0x00000201u);
    uint32_t frag_flags = 0;
    if (d->zs != NULL) {
       const struct pvr_resource *zr = pvr_resource(d->zs);
-- 
2.47.3

