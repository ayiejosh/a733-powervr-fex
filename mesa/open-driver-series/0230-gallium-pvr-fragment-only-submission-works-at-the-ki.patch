diff --git a/src/gallium/drivers/pvr_native/pvr_csb.c b/src/gallium/drivers/pvr_native/pvr_csb.c
index 4dc1a964..7e24112f 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.c
+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -1450,3 +1450,52 @@ pvr_geom_static_stream(void *stream, uint32_t stream_size,
 
    return total_bytes;
 }
+
+void
+pvr_csb_pds_bgnd_words(uint32_t shader_off, uint32_t texunicode_off,
+                       uint32_t texturedata_off, uint32_t temps_dwords,
+                       uint32_t shared_dwords, uint32_t texturestate_dwords,
+                       uint64_t words[3])
+{
+   struct ROGUE_CR_PDS_BGRND0_BASE bgnd0 = {
+      .shader_addr = shader_off,
+      .texunicode_addr = texunicode_off,
+   };
+   struct ROGUE_CR_PDS_BGRND1_BASE bgnd1 = {
+      .texturedata_addr = texturedata_off,
+   };
+   struct ROGUE_CR_PDS_BGRND3_SIZEINFO sizeinfo = {
+      .usc_sharedsize = DIV_ROUND_UP(shared_dwords,
+                                     ROGUE_CR_PDS_BGRND3_SIZEINFO_USC_SHAREDSIZE_UNIT_SIZE),
+      .pds_texturestatesize = DIV_ROUND_UP(texturestate_dwords,
+                                           ROGUE_CR_PDS_BGRND3_SIZEINFO_PDS_TEXTURESTATESIZE_UNIT_SIZE),
+      .pds_tempsize = DIV_ROUND_UP(temps_dwords,
+                                   ROGUE_CR_PDS_BGRND3_SIZEINFO_PDS_TEMPSIZE_UNIT_SIZE),
+   };
+
+   ROGUE_CR_PDS_BGRND0_BASE_pack(&words[0], &bgnd0);
+   ROGUE_CR_PDS_BGRND1_BASE_pack(&words[1], &bgnd1);
+   ROGUE_CR_PDS_BGRND3_SIZEINFO_pack(&words[2], &sizeinfo);
+}
+
+void
+pvr_frag_static_stream_fill_bgnd(void *stream, uint32_t stream_size,
+                                 uint64_t tpu_border_table_addr,
+                                 const uint64_t bgnd[3], const uint64_t pr_bgnd[3])
+{
+   const uint32_t pbe_dwords = PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
+   const uint32_t tpu_off = (PVR_FRAG_PRE_PBE_DWORDS + pbe_dwords) * 4;
+   const uint32_t bgnd_off = tpu_off + PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_PDM) * 4;
+   const uint32_t pr_bgnd_off = bgnd_off + ROGUE_NUM_CR_PDS_BGRND_WORDS * 8;
+   uint32_t *dw = (uint32_t *)stream;
+   struct ROGUE_CR_TPU_BORDER_COLOUR_TABLE_PDM tpu = {
+      .border_colour_table_address = tpu_border_table_addr,
+   };
+
+   if (pr_bgnd_off + ROGUE_NUM_CR_PDS_BGRND_WORDS * 8 > stream_size)
+      return;
+
+   ROGUE_CR_TPU_BORDER_COLOUR_TABLE_PDM_pack(&dw[tpu_off / 4], &tpu);
+   memcpy((uint8_t *)stream + bgnd_off, bgnd, ROGUE_NUM_CR_PDS_BGRND_WORDS * 8);
+   memcpy((uint8_t *)stream + pr_bgnd_off, pr_bgnd, ROGUE_NUM_CR_PDS_BGRND_WORDS * 8);
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.h b/src/gallium/drivers/pvr_native/pvr_csb.h
index 2050f737..a51645f6 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.h
+++ b/src/gallium/drivers/pvr_native/pvr_csb.h
@@ -731,6 +731,21 @@ uint32_t pvr_frag_static_stream(void *stream, uint32_t stream_size,
                                 const uint64_t *pbe_words, unsigned nr_attachments,
                                 uint32_t eot_pds_offset, bool cluster_grouping);
 
+/* Fill the parts of a built fragment stream that the reference always sets but this driver had left
+ * zero: the TPU border-colour table address and the PDS background programs (the pixel shader the
+ * 3D stage runs for tiles with no fragments, and its partial-render variant). A zero there is not
+ * "unused" - it is PDS heap base + 0, whatever program lives at the bottom of the PDS heap, which
+ * the hardware then tries to execute. */
+void pvr_frag_static_stream_fill_bgnd(void *stream, uint32_t stream_size,
+                                      uint64_t tpu_border_table_addr,
+                                      const uint64_t bgnd[3], const uint64_t pr_bgnd[3]);
+
+/* Pack the three CR_PDS_BGRND words for a background program. */
+void pvr_csb_pds_bgnd_words(uint32_t shader_off, uint32_t texunicode_off,
+                            uint32_t texturedata_off, uint32_t temps_dwords,
+                            uint32_t shared_dwords, uint32_t texturestate_dwords,
+                            uint64_t words[3]);
+
 /* Dwords a stream link occupies - what the guard must be at minimum. */
 #define PVR_CSB_LINK_DWORDS (ROGUE_VDMCTRL_STREAM_LINK0_length + \
                              ROGUE_VDMCTRL_STREAM_LINK1_length)
