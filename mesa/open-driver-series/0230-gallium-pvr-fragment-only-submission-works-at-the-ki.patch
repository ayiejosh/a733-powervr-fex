index e6987cf9..f02d8a64 100644
--- a/src/gallium/drivers/pvr_native/pvr_probe.c
+++ b/src/gallium/drivers/pvr_native/pvr_probe.c
@@ -1201,7 +1201,33 @@ real_job_done:
                                                    dset_handle, 0, 2000);
                   printf("hwrt:          minimal geometry job (terminate-only control) %s\n",
                          gdone ? "COMPLETED" : "did not complete in 2 s");
-               } else if (getenv("PVR_PROBE_GEOM_ONLY")) {
+               } else if (getenv("PVR_PROBE_FRAG_ONLY")) {
+                  /* Does the context dispatch a job at all when no geometry kick is involved? */
+                  const bool fdone = pvr_job_submit_frag_sync(vm, gpu_ctx.handle, fstream, f2,
+                                                              dset_handle, 0, 2000);
+
+                  printf("hwrt:          fragment-only submission %s\n",
+                         fdone ? "COMPLETED" : "did not complete in 2 s");
+               }
+               /* Fill the fragment stream's PDS background programs and TPU border table. The
+                * reference always sets these; left at zero they are "PDS heap base + 0", so the 3D
+                * stage executes whatever program sits at the bottom of the PDS heap. Reuse the
+                * fragment PDS program as the background program for now - this is about making the
+                * kick valid, not about the background colour. */
+               {
+                  uint64_t bgnd[3], pr_bgnd[3];
+
+                  pvr_csb_pds_bgnd_words(g_fs_pds_base_offset, g_fs_pds_base_offset,
+                                         g_fs_pds_base_offset, 0, 0, 0, bgnd);
+                  pvr_csb_pds_bgnd_words(g_fs_pds_base_offset, g_fs_pds_base_offset,
+                                         g_fs_pds_base_offset, 0, 0, 0, pr_bgnd);
+                  pvr_frag_static_stream_fill_bgnd(fstream, sizeof(fstream), rbctaddr, bgnd,
+                                                   pr_bgnd);
+                  printf("hwrt:          fragment stream: PDS bgnd = PDS+0x%x, border table 0x%"
+                         PRIx64 "\n", (unsigned)g_fs_pds_base_offset, rbctaddr);
+               }
+
+               if (getenv("PVR_PROBE_GEOM_ONLY")) {
                   const bool gdone = pvr_job_submit_geom_sync(vm, gpu_ctx.handle, gstream, glen,
                                                               dset_handle, 0, 2000);
 
diff --git a/src/gallium/drivers/pvr_native/pvr_vm.c b/src/gallium/drivers/pvr_native/pvr_vm.c
index edf3ad0c..2de214ac 100644
--- a/src/gallium/drivers/pvr_native/pvr_vm.c
+++ b/src/gallium/drivers/pvr_native/pvr_vm.c
@@ -454,6 +454,50 @@ pvr_job_submit_geom_sync(struct pvr_vm *vm, uint32_t context_handle,
    return completed;
 }
 
+bool
+pvr_job_submit_frag_sync(struct pvr_vm *vm, uint32_t context_handle,
+                         const void *frag_stream, uint32_t frag_len,
+                         uint32_t hwrt_set_handle, uint32_t hwrt_data_index,
+                         uint32_t timeout_ms)
+{
+   uint32_t done_sync = 0;
+   struct drm_pvr_sync_op ops[1];
+   struct drm_pvr_job job;
+   struct drm_pvr_ioctl_submit_jobs_args args = {
+      .jobs = { .stride = sizeof(job), .count = 1, .array = (__u64)(uintptr_t)&job },
+   };
+   bool completed;
+
+   if (drmSyncobjCreate(vm->fd, 0, &done_sync) != 0)
+      return false;
+
+   ops[0] = (struct drm_pvr_sync_op){
+      .handle = done_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   job = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_FRAGMENT,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)frag_stream,
+      .cmd_stream_len = frag_len,
+      .sync_ops = { .stride = sizeof(ops[0]), .count = 1, .array = (__u64)(uintptr_t)ops },
+      .hwrt = { .set_handle = hwrt_set_handle, .data_index = hwrt_data_index },
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+      mesa_loge("pvr: SUBMIT_JOBS fragment-only (%u B) failed: %s", frag_len, strerror(errno));
+      drmSyncobjDestroy(vm->fd, done_sync);
+      return false;
+   }
+
+   completed = drmSyncobjWait(vm->fd, &done_sync, 1, (int64_t)timeout_ms * 1000000LL, 0, NULL) == 0;
+   if (!completed)
+      mesa_loge("pvr: fragment-only job did not signal completion within %u ms", timeout_ms);
+
+   drmSyncobjDestroy(vm->fd, done_sync);
+   return completed;
+}
+
 bool
 pvr_job_submit_render(struct pvr_vm *vm, uint32_t context_handle,
                       const void *geom_stream, uint32_t geom_len,
