+/* Builds the CDM control stream for the current workgroup counts. */
+static bool
+pvr_compute_build_ctrl_stream(struct pvr_compute_state *st)
+{
+   struct pvr_csb csb;
+   static const uint32_t wg1[3] = { 1, 1, 1 }, l1[3] = { 1, 1, 1 };
+   uint32_t wg[3] = { st->wg_x, st->wg_y, 1 };
+   uint32_t work_items = st->usc_unified_units ? 0 : 0; /* set below from the pco data */
+   uint32_t l[3] = { 1, 1, 1 };
+   bool emitted;
+
+   /* pco flattens the shader's 8x8x1 local size into a 64x1x1 PDS task. */
+   work_items = PVR_COMPUTE_LOCAL_X * PVR_COMPUTE_LOCAL_Y;
+   if (work_items > PVR_COMPUTE_MAX_INSTANCES)
+      work_items = ALIGN_POT(work_items, PVR_COMPUTE_MAX_INSTANCES);
+   l[0] = work_items;
+
+   memset(st->ctrl_bo.map, 0, 4096);
+   pvr_csb_init(&csb, st->ctrl_bo.map, 4096, 0);
+   emitted = pvr_compute_emit_kernel(
+      &csb, st->usc_common_units, 0, 0, DIV_ROUND_UP(st->desc_data_dw * 4, 16), false, false,
+      st->pds_base_addr + PDS_DESC_DATA_OFF, st->pds_base_addr + PDS_DESC_CODE_OFF,
+      ROGUE_CDMCTRL_SD_TYPE_NONE, true, wg1, l1, 8);
+   if (emitted)
+      emitted = pvr_compute_emit_kernel(
+         &csb, st->usc_common_units, st->usc_unified_units, st->pds_temp_units,
+         DIV_ROUND_UP(st->kern_data_dw * 4, 16), true, false,
+         st->pds_base_addr + PDS_KERN_DATA_OFF, st->pds_base_addr + st->kern_code_off,
+         ROGUE_CDMCTRL_SD_TYPE_USC, false, wg, l, 0);
+   if (emitted)
+      emitted = pvr_compute_emit_kernel(
+         &csb, 0, 0, 0, DIV_ROUND_UP(st->fence_data_dw * 4, 16), true, true,
+         st->pds_base_addr + PDS_FENCE_DATA_OFF, st->pds_base_addr + st->fence_code_off,
+         ROGUE_CDMCTRL_SD_TYPE_PDS, true, wg1, l1, 8);
+   if (emitted) {
+      struct ROGUE_CDMCTRL_STREAM_TERMINATE t = {
+         .block_type = ROGUE_CDMCTRL_BLOCK_TYPE_STREAM_TERMINATE,
+      };
+      uint32_t *dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_STREAM_TERMINATE_length);
+
+      if (dw != NULL)
+         ROGUE_CDMCTRL_STREAM_TERMINATE_pack(dw, &t);
+      else
+         emitted = false;
+   }
+   st->ctrl_valid = emitted;
+   return emitted;
+}
