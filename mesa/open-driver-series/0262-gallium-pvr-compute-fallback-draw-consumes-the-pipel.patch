  * The first one logs loudly and once per context, because a driver that silently accepts draws it
  * cannot perform is the worst of the available behaviours: an application would see no error and no
  * picture, and would have nothing to report against. */
+/* Collects the three clip-space vertices for the compute fallback: from the bound vertex buffer when
+ * there is one, otherwise a triangle that fills the middle of the target the way the fallback's first
+ * version did. w is filled as 1: the fallback's vertex stage writes gl_Position = vec4(pos, 1). */
+static void
+pvr_collect_draw_vertices(struct pvr_context *ctx, float v[12])
+{
+   static const float fallback[12] = {
+      -0.75f, 0.75f, 0.0f, 1.0f,
+      0.75f,  0.75f, 0.0f, 1.0f,
+      0.0f,  -0.75f, 0.0f, 1.0f,
+   };
+
+   memcpy(v, fallback, sizeof(fallback));
+   if (ctx->nr_vertex_buffers > 0 && ctx->vertex_buffers[0].buffer.resource != NULL) {
+      struct pvr_resource *vb = pvr_resource(ctx->vertex_buffers[0].buffer.resource);
+      struct pvr_screen *screen = pvr_screen(ctx->base.screen);
+      /* The fallback's vertex stage consumes vec3 positions: this Mesa's pipe_vertex_buffer has no
+       * stride field, so the fallback fixes it at one vec3. */
+      unsigned stride = 3 * sizeof(float);
+      uint64_t base = ctx->vertex_buffers[0].buffer_offset;
+
+      if (vb->bo.map == NULL)
+         pvr_bo_map(screen->fd, &vb->bo);
+      if (vb->bo.map != NULL && base + 2 * stride + 3 * sizeof(float) <= vb->bo.size) {
+         for (unsigned i = 0; i < 3; i++) {
+            const float *p = (const float *)((const uint8_t *)vb->bo.map + base + i * stride);
+
+            v[i * 4 + 0] = p[0];
+            v[i * 4 + 1] = p[1];
+            v[i * 4 + 2] = p[2];
+            v[i * 4 + 3] = 1.0f;
+         }
+      }
+   }
+}
