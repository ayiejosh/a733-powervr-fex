From db76299410401a9d66ab2a620453f04d12c99345 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 24 Oct 2026 03:36:29 +0800
Subject: [PATCH 197/269] gallium/pvr: build the PDS launcher that makes a
 compiled shader run

The USC binary is only half of a runnable program: the hardware reaches it through a PDS launcher
built with a doutu instruction that names the shader's offset in the USC code heap and its temp count.
pvr_shader_pds_launcher() builds that, and for this device's position-only vertex shader it produces:

  shader: PDS launcher for the VS: 36 bytes (zero temps)

That 36-byte launcher plus the 56-byte USC it kicks is the complete program side of a draw - the same
shape the VDM sync program already uses, which is why the zero-temps case was worth establishing first.

Two corrections along the way: the doutu sample-rate constant is
PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, and pvr_pds_kick_usc returns an end pointer
rather than a size, so the length is the pointer delta (with a caller-sized destination and a refusal
below 64 bytes rather than a silent overrun).
---
 src/gallium/drivers/pvr_native/pvr_probe.c  |  9 ++++++++
 src/gallium/drivers/pvr_native/pvr_shader.c | 24 +++++++++++++++++++++
 src/gallium/drivers/pvr_native/pvr_shader.h |  9 ++++++++
 3 files changed, 42 insertions(+)

diff --git a/src/gallium/drivers/pvr_native/pvr_probe.c b/src/gallium/drivers/pvr_native/pvr_probe.c
index 3e9fd544..c0097a19 100644
--- a/src/gallium/drivers/pvr_native/pvr_probe.c
+++ b/src/gallium/drivers/pvr_native/pvr_probe.c
@@ -1139,6 +1139,15 @@ shader_compile_check(struct pipe_screen *pscreen)
       if (vobj != NULL) {
          printf("shader:        pco encoded %u bytes of USC for a VERTEX shader; PDS kick needs "
                 "temps=%u vtxins=%u\n", vobj->binary_size, vobj->temps, vobj->vtxins);
+         {
+            uint8_t launcher[256];
+            const uint32_t llen = pvr_shader_pds_launcher(vobj, 0, launcher, sizeof(launcher));
+
+            if (llen > 0)
+               printf("shader:        PDS launcher for the VS: %u bytes (zero temps)\n", llen);
+            else
+               printf("shader:        FAIL: no PDS launcher for the VS\n");
+         }
       } else {
          printf("shader:        FAIL: pco produced no vertex code\n");
          ok = false;
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.c b/src/gallium/drivers/pvr_native/pvr_shader.c
index 56c29011..7766e8e3 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.c
+++ b/src/gallium/drivers/pvr_native/pvr_shader.c
@@ -5,6 +5,8 @@
 
 #include "pco/pco_data.h"
 #include "pco/pco_internal.h"
+#include "pco_uscgen_programs.h"
+#include "pvr_pds.h"
 
 #include "stdlib.h"
 
@@ -36,6 +38,28 @@ pvr_shader_create(struct nir_shader *nir, pco_ctx *ctx)
    return shader;
 }
 
+uint32_t
+pvr_shader_pds_launcher(const struct pvr_shader *shader, uint32_t usc_offset,
+                        void *dst, uint32_t dst_size)
+{
+   struct pvr_pds_kickusc_program program = { 0 };
+   uint32_t *end;
+
+   /* ponytail: one pass, fixed layout. pvr_pds_kick_usc returns the end pointer rather than a size,
+    * so there is no size query to do here; a launcher is a few instructions and dst is caller-sized
+    * generously. If the returned end ever exceeds dst+dst_size that is a caller bug worth an assert,
+    * not a silent overrun. */
+   if (shader == NULL || dst == NULL || dst_size < 64)
+      return 0;
+
+   pvr_pds_setup_doutu(&program.usc_task_control, usc_offset, shader->temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, false);
+
+   end = pvr_pds_kick_usc(&program, (uint32_t *)dst, 0, false, PDS_GENERATE_CODEDATA_SEGMENTS);
+
+   return end == NULL ? 0 : (uint32_t)((uint8_t *)end - (uint8_t *)dst);
+}
+
 void
 pvr_shader_destroy(struct pvr_shader *shader)
 {
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.h b/src/gallium/drivers/pvr_native/pvr_shader.h
index 189768d6..4b6c09d7 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.h
+++ b/src/gallium/drivers/pvr_native/pvr_shader.h
@@ -32,6 +32,15 @@ struct pvr_shader {
 struct pvr_shader *pvr_shader_create(struct nir_shader *nir, pco_ctx *ctx);
 void pvr_shader_destroy(struct pvr_shader *shader);
 
+/* Builds the PDS launcher for a compiled shader into a byte buffer: the program that makes the
+ * USC run. `usc_offset` is the shader's offset within the USC code heap, which is what the hardware's
+ * doutu instruction takes. Returns the number of bytes written, or 0.
+ *
+ * The temps count comes from the compiled shader, so a position-only vertex shader (temps = 0) gets
+ * the simplest possible kick - the same shape the VDM sync program uses. */
+uint32_t pvr_shader_pds_launcher(const struct pvr_shader *shader, uint32_t usc_offset,
+                                 void *dst, uint32_t dst_size);
+
 /* Runs the full pco pipeline over a NIR shader and returns the encoded binary.
  *
  * The sequence is the one the Vulkan driver uses (pvr_usc.c build_shader): preprocess,
-- 
