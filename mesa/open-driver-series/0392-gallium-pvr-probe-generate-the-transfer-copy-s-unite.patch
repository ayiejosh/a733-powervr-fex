From d5150193a622f250f8900db036c672c647c5ecb8 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:34:03 +0800
Subject: [PATCH 392/393] gallium/pvr: probe: generate the transfer copy's
 unitex program

The TQ copy probe installed two zero words as the unitex ("texture
unicode") program at PDS+0x1e40, copied from a debug dump that printed
every code-only PDS upload as zeros; earlier versions of the probe had the
right words. With the zeros, the captured reference copy job that the
probe replays faulted (CTXRESET, page fault at USC heap + 0x4b080):
decoded statically, zero words do not halt the PDS, which runs on into the
next program and kicks the USC at the texture-state address. This was
earlier misread, in the messages of 0361 and 0363 too, as missing firmware
context state.

Generate the program with the libpowervr_pds calls the reference transfer
context uses for one texture DMA kick (DOUTD.end + HALT, f4020000
d3000000, the words the reference capture holds). The replayed copy job
now copies 4096/4096 words on the open powervr kernel driver.
---
 src/gallium/drivers/pvr_native/pvr_probe.c | 26 +++++++++++++++++-----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_probe.c b/src/gallium/drivers/pvr_native/pvr_probe.c
index 72f28844..602620f7 100644
--- a/src/gallium/drivers/pvr_native/pvr_probe.c
+++ b/src/gallium/drivers/pvr_native/pvr_probe.c
@@ -5879,10 +5879,6 @@ tq_copy_check(int fd, struct pipe_screen *pscreen)
       0x81040000, 0x00080061, 0x80020000, 0xa057ff6a, 0x8044e400, 0x88088062, 0xff00a080,
       0xff6a8002, 0x87008a36, 0x20000040, 0xfffffff2, 0x87808a34, 0x21000041,
    };
-   /* Captured unitex "texture unicode" program at PDS+0x1e40 for this copy job: two zero words
-    * (the reference uploads a 2-word no-op here; the shader's inputs come from the texturedata
-    * DMA at PDS+0x2640). */
-   static const uint32_t texdata_code[2] = { 0x00000000, 0x00000000 };
    struct drm_pvr_ioctl_create_context_args cargs = {
       .type = DRM_PVR_CTX_TYPE_TRANSFER_FRAG,
       .vm_context_handle = vm->context_handle,
@@ -6086,7 +6082,27 @@ tq_copy_check(int fd, struct pipe_screen *pscreen)
       memcpy((uint8_t *)pdsbo.map + (0x2600 - 0x1000), fill_data, sizeof(fill_data));
       memcpy((uint8_t *)pdsbo.map + (0x2620 - 0x1000), fill_code, sizeof(fill_code));
    }
-   memcpy((uint8_t *)pdsbo.map + (0x1e40 - 0x1000), texdata_code, sizeof(texdata_code));
+   {
+      /* The unitex "texture unicode" program at PDS+0x1e40: the DOUTD that DMAs the texture state
+       * from the texturedata segment (PDS+0x2640/0x2700) into the shader's shared registers, then
+       * HALT. Generated by the libpowervr_pds call the reference transfer context uses for one
+       * texture DMA kick (pvr_arch_pds_unitex_state_program_create_and_upload); the reference
+       * single-run capture holds the same f4020000 d3000000. With zero words here (an earlier
+       * dump printed code-only uploads as zeros) the copy faulted: decoded statically, the PDS
+       * runs on into the next program, which kicks the USC at the texture-state address
+       * (CTXRESET, PF at USC heap + texdata low word). */
+      struct pvr_pds_pixel_shader_sa_program up = { .num_texture_dma_kicks = 1 };
+      static uint32_t unitex[16] __attribute__((aligned(64)));
+
+      pvr_pds_set_sizes_pixel_shader_uniform_texture_code(&up);
+      if (up.code_size != 2) {
+         printf("tqcopy:        FAIL: unitex code is %u words, expected 2\n", up.code_size);
+         goto out_bo;
+      }
+      pvr_pds_generate_pixel_shader_sa_code_segment(&up, unitex);
+      memcpy((uint8_t *)pdsbo.map + (0x1e40 - 0x1000), unitex, 2 * sizeof(uint32_t));
+      printf("tqcopy:        PDS+0x1e40 unitex = %08x %08x\n", unitex[0], unitex[1]);
+   }
    memcpy((uint8_t *)pdsbo.map + (0x2680 - 0x1000), ev_data, sizeof(ev_data));
    memcpy((uint8_t *)pdsbo.map + (0x26a0 - 0x1000), ev_code, sizeof(ev_code));
 
