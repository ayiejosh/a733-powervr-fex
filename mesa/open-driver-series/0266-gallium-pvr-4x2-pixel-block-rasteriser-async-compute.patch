+static void
+probe_gpu_warmup(struct pipe_screen *screen)
+{
+   struct pipe_context *pctx;
+   struct pipe_resource templ = { 0 };
+   struct pipe_resource *res;
+   struct pipe_framebuffer_state fb = { 0 };
+   struct pipe_draw_info info = { 0 };
+   struct pipe_draw_start_count_bias draw = { 0 };
+
+   pctx = screen->context_create(screen, NULL, 0);
+   if (pctx == NULL)
+      return;
+
+   templ.target = PIPE_TEXTURE_2D;
+   templ.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   templ.width0 = 64;
+   templ.height0 = 64;
+   templ.depth0 = 1;
+   templ.array_size = 1;
+   templ.bind = PIPE_BIND_RENDER_TARGET;
+   res = screen->resource_create(screen, &templ);
+   if (res != NULL) {
+      fb.width = 64;
+      fb.height = 64;
+      fb.nr_cbufs = 1;
+      fb.cbufs[0].texture = res;
+      pctx->set_framebuffer_state(pctx, &fb);
+      info.mode = MESA_PRIM_TRIANGLES;
+      info.instance_count = 1;
+      draw.count = 3;
+      pctx->draw_vbo(pctx, &info, 0, NULL, &draw, 1);
+      pctx->set_framebuffer_state(pctx, &(struct pipe_framebuffer_state){ 0 });
+      screen->resource_destroy(screen, res);
+   }
+   pctx->destroy(pctx);
+}
