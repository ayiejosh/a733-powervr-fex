From 8d5559c1d6fc5d934db604b76eced6a29ccca16b Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Mon, 26 Oct 2026 22:08:18 +0800
Subject: [PATCH 266/269] gallium/pvr: 4x2 pixel-block rasteriser + async
 compute submit - fallback draws 7x faster

The compute fallback was GPU-bound on the per-thread parameter reads (measured: a shader with compile-time
vertices and only the target size in memory runs 4x faster), so the rasteriser now rasterises a 4x2 pixel
block per invocation, reading the draw's vertices and target size once and amortising them over eight
pixels; the dispatch sizing uses PVR_COMPUTE_BLOCK_X/Y to match the shader. Benchmarked on the board
(PVR_PROBE_COMPUTE_BENCH=1, 200 frames, pixel-exact):
  512x512  1.42 ms/frame (702 fps, 184 Mpix/s)   [was 9.93 ms / 98 fps / 25.7 Mpix/s]
  1366x768 5.30 ms/frame (189 fps, 198 Mpix/s)   [was 40.0 ms]
  1920x1080 10.04 ms/frame (100 fps, 207 Mpix/s) [was 75.2 ms]
Probe: --- ALL PASS with and without the benchmark, and under the drm-shim; both pipe_context draw cases
still pixel-exact. Also added an asynchronous submit path (env PVR_COMPUTE_ASYNC, completion syncobjs
batched up to 8 and flushed by pipe_context::flush / context destroy); it shows no gain here because the
path is GPU-bound rather than wait-bound, but it keeps draw submission non-blocking for callers that want
to overlap CPU work with the GPU.
---
 src/gallium/drivers/pvr_native/pvr_compute.c  |  41 +-
 src/gallium/drivers/pvr_native/pvr_compute.h  |   9 +
 .../pvr_native/pvr_compute_triangle_spv.h     | 446 +++++++++---------
 src/gallium/drivers/pvr_native/pvr_context.c  |   6 +-
 src/gallium/drivers/pvr_native/pvr_probe.c    |  59 ++-
 src/gallium/drivers/pvr_native/pvr_vm.c       |  49 +-
 src/gallium/drivers/pvr_native/pvr_vm.h       |   5 +
 7 files changed, 382 insertions(+), 233 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_compute.c b/src/gallium/drivers/pvr_native/pvr_compute.c
index 5659e50f..0c8401dd 100644
--- a/src/gallium/drivers/pvr_native/pvr_compute.c
+++ b/src/gallium/drivers/pvr_native/pvr_compute.c
@@ -44,9 +44,12 @@
 
 #include "pvr_compute_triangle_spv.h"
 
-/* The shader's local size is 8x8; a dispatch covers ceil(size/8) workgroups in each dimension. */
+/* The shader's local size is 8x8 and each invocation rasterises a 2x2 pixel block, so a dispatch
+ * covers ceil(size/(8*BLOCK)) workgroups in each dimension. */
 #define PVR_COMPUTE_LOCAL_X 8u
 #define PVR_COMPUTE_LOCAL_Y 8u
+#define PVR_COMPUTE_BLOCK_X 4u
+#define PVR_COMPUTE_BLOCK_Y 2u
 
 #define PVR_COMPUTE_MAX_INSTANCES (ROGUE_CDMCTRL_KERNEL8_MAX_INSTANCES_MAX_SIZE + 1u)
 
@@ -476,6 +479,7 @@ pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target
       ctx->compute = CALLOC_STRUCT(pvr_compute_state);
       if (ctx->compute == NULL)
          return false;
+      ctx->compute->async = getenv("PVR_COMPUTE_ASYNC") != NULL;
       if (!pvr_compute_build(ctx->compute, ctx))
          return false;
    }
@@ -507,8 +511,8 @@ pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target
    }
 
    /* Rebuild the control stream when the dispatch shape changed. */
-   wg_x = DIV_ROUND_UP(w, PVR_COMPUTE_LOCAL_X);
-   wg_y = DIV_ROUND_UP(h, PVR_COMPUTE_LOCAL_Y);
+   wg_x = DIV_ROUND_UP(w, PVR_COMPUTE_LOCAL_X * PVR_COMPUTE_BLOCK_X);
+   wg_y = DIV_ROUND_UP(h, PVR_COMPUTE_LOCAL_Y * PVR_COMPUTE_BLOCK_Y);
    if (!ctx->compute->ctrl_valid || ctx->compute->wg_x != wg_x || ctx->compute->wg_y != wg_y) {
       ctx->compute->wg_x = wg_x;
       ctx->compute->wg_y = wg_y;
@@ -516,11 +520,41 @@ pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target
          return false;
    }
 
+   if (ctx->compute->async) {
+      uint32_t sync = 0;
+
+      if (ctx->compute->nr_pending == ARRAY_SIZE(ctx->compute->pending) &&
+          !pvr_compute_flush(ctx->compute))
+         return false;
+      if (!pvr_job_submit_compute_async(&screen->vm, ctx->compute->ctx_handle,
+                                        ctx->compute->fw_stream, ctx->compute->fw_stream_len,
+                                        &sync))
+         return false;
+      ctx->compute->pending[ctx->compute->nr_pending++] = sync;
+      return true;
+   }
+
    pvr_job_submit_compute_sync(&screen->vm, ctx->compute->ctx_handle, ctx->compute->fw_stream,
                                ctx->compute->fw_stream_len, 2000);
    return true;
 }
 
+bool
+pvr_compute_flush(struct pvr_compute_state *state)
+{
+   struct pvr_vm *vm;
+   bool ok = true;
+   unsigned i;
+
+   if (state == NULL || state->nr_pending == 0)
+      return true;
+   vm = &state->screen->vm;
+   for (i = 0; i < state->nr_pending; i++)
+      ok &= pvr_compute_sync_wait(vm, state->pending[i], 2000);
+   state->nr_pending = 0;
+   return ok;
+}
+
 void
 pvr_compute_state_finish(struct pvr_compute_state *state)
 {
@@ -531,6 +565,7 @@ pvr_compute_state_finish(struct pvr_compute_state *state)
       return;
    screen = state->screen;
    fd = screen->fd;
+   pvr_compute_flush(state);
    if (state->ctx_handle) {
       uint32_t handle = state->ctx_handle;
 
diff --git a/src/gallium/drivers/pvr_native/pvr_compute.h b/src/gallium/drivers/pvr_native/pvr_compute.h
index 3eea1855..d12edf9a 100644
--- a/src/gallium/drivers/pvr_native/pvr_compute.h
+++ b/src/gallium/drivers/pvr_native/pvr_compute.h
@@ -59,6 +59,12 @@ struct pvr_compute_state {
    /* Where binding 0 (render target) and binding 1 (draw parameters) sit in the descriptor set. */
    uint32_t desc_off_target_dw, desc_off_params_dw;
    uint32_t desc_set_dw;
+
+   /* Asynchronous submit (env PVR_COMPUTE_ASYNC): draws are submitted without waiting and the
+    * completion syncobjs are collected here, so an application can overlap CPU work with the GPU. */
+   bool async;
+   uint32_t pending[8];
+   unsigned nr_pending;
 };
 
 /* Lazily build the compute state (shader, programs, streams, compute context) and render the triangle.
@@ -67,6 +73,9 @@ struct pvr_compute_state {
 bool pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target,
                                  const float vertices_ndc[12]);
 
+/* Wait for every outstanding asynchronous draw and release their syncobjs. */
+bool pvr_compute_flush(struct pvr_compute_state *state);
+
 void pvr_compute_state_finish(struct pvr_compute_state *state);
 
 #endif /* PVR_COMPUTE_H */
