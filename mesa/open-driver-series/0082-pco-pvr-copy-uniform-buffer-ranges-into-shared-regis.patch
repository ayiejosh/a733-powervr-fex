diff --git a/src/imagination/pco/pco_data.h b/src/imagination/pco/pco_data.h
index e37d9d5..8b9d43a 100644
--- a/src/imagination/pco/pco_data.h
+++ b/src/imagination/pco/pco_data.h
@@ -192,6 +192,12 @@ typedef struct _pco_binding_data {
     * other buffer descriptors is always 0.
     */
    bool is_dynamic;
+
+   /** Whether the descriptor may still change, or be invalid, when a draw
+    * is recorded (update after bind, partially bound), so that its contents
+    * can't be read then.
+    */
