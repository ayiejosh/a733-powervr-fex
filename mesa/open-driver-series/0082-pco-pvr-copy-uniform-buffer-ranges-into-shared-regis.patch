 } pco_binding_data;
 
 /** PCO descriptor set data. */
@@ -213,6 +219,21 @@ typedef struct _pco_push_const_data {
 } pco_push_const_data;
 
 /** PCO common data. */
+/** A uniform buffer range that the descriptor upload program copies into
+ * shared registers, so that the shader reads it from there instead of from
+ * memory at every invocation.
+ */
+typedef struct _pco_ubo_preload {
+   uint16_t desc_set;
+   uint16_t binding;
+   uint16_t elem;
+   uint16_t offset; /** First dword copied. */
+   uint16_t count; /** Number of dwords copied. */
+   uint16_t start; /** Destination shared register, set by the driver. */
+} pco_ubo_preload;
+
+#define PCO_MAX_UBO_PRELOADS 4
+
 typedef struct _pco_common_data {
    /** System value mappings. */
    pco_range sys_vals[SYSTEM_VALUE_MAX];
@@ -246,6 +267,9 @@ typedef struct _pco_common_data {
    pco_range literals; /** Shared registers holding literal_vals. */
    uint32_t literal_vals[32];
 
+   pco_ubo_preload ubo_preloads[PCO_MAX_UBO_PRELOADS];
+   unsigned num_ubo_preloads;
+
    unsigned entry_offset; /** Offset of the shader entrypoint. */
 
    struct {
diff --git a/src/imagination/pco/pco_nir.c b/src/imagination/pco/pco_nir.c
index 4201d4d..f12cbf9 100644
--- a/src/imagination/pco/pco_nir.c
+++ b/src/imagination/pco/pco_nir.c
@@ -1320,6 +1320,108 @@ remat_load_const(nir_builder *b, nir_instr *instr, UNUSED void *cb_data)
  * \param[in,out] nir NIR shader.
  * \param[in,out] data Shader data.
  */
+/* Uniform buffer ranges larger than this stay in memory. */
+#define PCO_UBO_PRELOAD_MAX_DWORDS 64U
+#define PCO_UBO_PRELOAD_TOTAL_DWORDS 128U
+
+/**
+ * \brief Picks the uniform buffer ranges read at constant offsets for the
+ * driver to copy into shared registers (see pco_ubo_preload).
+ *
+ * Bounds checked loads have computed offsets, so they are not affected.
+ *
+ * \param[in] nir NIR shader.
+ * \param[in,out] common Shader common data.
+ */
+static void gather_ubo_preloads(nir_shader *nir, pco_common_data *common)
+{
+   struct {
+      uint32_t packed_desc;
+      uint32_t elem;
+      uint32_t lo; /* First dword read. */
+      uint32_t hi; /* Dword after the last one read. */
+   } ubos[16];
+   unsigned num_ubos = 0;
+
+   common->num_ubo_preloads = 0;
+
+   nir_foreach_function_impl (impl, nir) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_load_ubo ||
+                intr->def.bit_size != 32 || !nir_src_is_const(intr->src[0]) ||
+                !nir_src_is_const(intr->src[1]) ||
+                nir_src_as_uint(intr->src[1]) % 4)
+               continue;
+
+            uint32_t packed_desc = nir_src_comp_as_uint(intr->src[0], 0);
+            uint32_t elem = nir_src_comp_as_uint(intr->src[0], 1);
+            unsigned desc_set;
+            unsigned binding;
+            pco_unpack_desc(packed_desc, &desc_set, &binding);
+            if (is_inline_ubo(desc_set, binding, common) ||
+                common->desc_sets[desc_set].bindings[binding].no_preload)
+               continue;
+
+            uint32_t lo = nir_src_as_uint(intr->src[1]) / 4;
+            uint32_t hi = lo + intr->def.num_components;
+
+            unsigned u;
+            for (u = 0; u < num_ubos; u++) {
+               if (ubos[u].packed_desc == packed_desc && ubos[u].elem == elem)
+                  break;
+            }
+
+            if (u == num_ubos) {
+               if (num_ubos == ARRAY_SIZE(ubos))
+                  continue;
+
+               ubos[num_ubos].packed_desc = packed_desc;
+               ubos[num_ubos].elem = elem;
+               ubos[num_ubos].lo = lo;
+               ubos[num_ubos].hi = hi;
+               num_ubos++;
+               continue;
+            }
+
+            ubos[u].lo = MIN2(ubos[u].lo, lo);
+            ubos[u].hi = MAX2(ubos[u].hi, hi);
+         }
+      }
+   }
+
+   unsigned total = 0;
+   for (unsigned u = 0;
+        u < num_ubos && common->num_ubo_preloads < PCO_MAX_UBO_PRELOADS;
+        u++) {
+      /* Start the copy on a 16-byte boundary; never extend it past the last
+       * dword read, which could be the end of the buffer.
+       */
+      uint32_t lo = ubos[u].lo & ~3U;
+      uint32_t count = ubos[u].hi - lo;
+      if (count > PCO_UBO_PRELOAD_MAX_DWORDS ||
+          total + count > PCO_UBO_PRELOAD_TOTAL_DWORDS)
+         continue;
+
+      unsigned desc_set;
+      unsigned binding;
+      pco_unpack_desc(ubos[u].packed_desc, &desc_set, &binding);
+
+      common->ubo_preloads[common->num_ubo_preloads++] = (pco_ubo_preload){
+         .desc_set = desc_set,
+         .binding = binding,
+         .elem = ubos[u].elem,
+         .offset = lo,
+         .count = count,
+      };
+      total += count;
+   }
+}
+
 void pco_postprocess_nir(pco_ctx *ctx, nir_shader *nir, pco_data *data)
 {
    bool internal = nir->info.internal;
@@ -1352,6 +1454,9 @@ void pco_postprocess_nir(pco_ctx *ctx, nir_shader *nir, pco_data *data)
          NIR_PASS(_, nir, nir_opt_dce);
    }
 
+   if (!internal)
+      gather_ubo_preloads(nir, &data->common);
+
    NIR_PASS(_, nir, nir_lower_all_phis_to_scalar);
 
    /* Temporary: lower phi undefs to zero because at this stage we don't want to
diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index 98b441b..c770bb8 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -1360,6 +1360,30 @@ static pco_instr *trans_load_buffer(trans_ctx *tctx,
                                      });
    }
 
+   /* Read uniform buffer ranges the driver copied into shared registers
+    * (see pco_ubo_preload) from there.
+    */
+   if (intr->intrinsic == nir_intrinsic_load_ubo && !is_dynidx &&
+       nir_src_is_const(intr->src[1]) && !(nir_src_as_uint(intr->src[1]) % 4)) {
+      const unsigned dword = nir_src_as_uint(intr->src[1]) / 4;
+      unsigned desc_set;
+      unsigned binding;
+      pco_unpack_desc(packed_desc, &desc_set, &binding);
+
+      for (unsigned u = 0; u < common->num_ubo_preloads; u++) {
+         const pco_ubo_preload *preload = &common->ubo_preloads[u];
+         if (preload->desc_set != desc_set || preload->binding != binding ||
+             preload->elem != elem || dword < preload->offset ||
+             dword + chans > preload->offset + preload->count)
+            continue;
+
+         pco_ref src = pco_ref_hwreg_vec(preload->start + dword - preload->offset,
+                                         PCO_REG_CLASS_SHARED,
+                                         chans);
+         return pco_mov(&tctx->b, dest, src, .rpt = chans);
+      }
+   }
+
    pco_ref base_addr[2];
    pco_ref_hwreg_addr_comps(sh_index, PCO_REG_CLASS_SHARED, base_addr);
 
