diff --git a/src/imagination/vulkan/pvr_arch_cmd_buffer.c b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
index 805889c..0cb207e 100644
--- a/src/imagination/vulkan/pvr_arch_cmd_buffer.c
+++ b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
@@ -5735,6 +5735,43 @@ pvr_setup_vertex_buffers(struct pvr_cmd_buffer *cmd_buffer,
 static VkResult pvr_cmd_upload_push_consts(struct pvr_cmd_buffer *cmd_buffer,
                                            enum pvr_stage_allocation stage);
 
+/* Where the descriptor upload program copies a uniform buffer range from
+ * (see pco_ubo_preload): the buffer, or zeros if the descriptor is null or
+ * too small for the range, in which case a bounds checked shader takes the
+ * path that doesn't read the copy.
+ */
+static pvr_dev_addr_t
+pvr_ubo_preload_addr(const struct pvr_cmd_buffer *cmd_buffer,
+                     const struct pvr_descriptor_state *desc_state,
+                     const pco_ubo_preload *preload)
+{
+   const pvr_dev_addr_t zeros =
+      cmd_buffer->device->null_state.zero_bo->vma->dev_addr;
+   const struct pvr_descriptor_set *set = desc_state->sets[preload->desc_set];
+   if (!set)
+      return zeros;
+
+   const struct pvr_descriptor_set_layout_binding *binding =
+      &set->layout->bindings[preload->binding];
+   const struct pvr_buffer_descriptor *desc;
+   if (binding->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC) {
+      desc = &set->dynamic_buffers[binding->dynamic_buffer_idx + preload->elem];
+   } else {
+      desc = (const struct pvr_buffer_descriptor *)((const uint8_t *)set->mapping +
+                                                    binding->offset +
+                                                    preload->elem *
+                                                       binding->stride);
+   }
+
+   const uint64_t end =
+      (uint64_t)(preload->offset + preload->count) * sizeof(uint32_t);
+   if (!desc->addr || end > desc->size)
+      return zeros;
+
+   return PVR_DEV_ADDR(desc->addr + desc->offset +
+                       preload->offset * sizeof(uint32_t));
+}
+
 static VkResult pvr_setup_descriptor_mappings(
    struct pvr_cmd_buffer *const cmd_buffer,
    enum pvr_stage_allocation stage,
@@ -5836,6 +5873,19 @@ static VkResult pvr_setup_descriptor_mappings(
             (struct pvr_const_map_entry_special_buffer *)entries;
 
          switch (special_buff_entry->buffer_type) {
+         case PVR_BUFFER_TYPE_UBO_PRELOAD: {
+            const pco_ubo_preload *preload =
+               &data->common.ubo_preloads[special_buff_entry->buffer_index];
+            const pvr_dev_addr_t addr =
+               pvr_ubo_preload_addr(cmd_buffer, desc_state, preload);
+
+            PVR_WRITE(qword_buffer,
+                      addr.addr,
+                      special_buff_entry->const_offset,
+                      pds_info->data_size_in_dwords);
+            break;
+         }
+
          case PVR_BUFFER_TYPE_DYNAMIC: {
             unsigned desc_set = special_buff_entry->data;
             const struct pvr_descriptor_set *descriptor_set;
diff --git a/src/imagination/vulkan/pvr_arch_pipeline.c b/src/imagination/vulkan/pvr_arch_pipeline.c
index 9164bc6..283cb27 100644
--- a/src/imagination/vulkan/pvr_arch_pipeline.c
+++ b/src/imagination/vulkan/pvr_arch_pipeline.c
@@ -584,6 +584,15 @@ static VkResult pvr_pds_descriptor_program_create_and_upload(
       };
    }
 
+   for (unsigned u = 0; u < data->common.num_ubo_preloads; u++) {
+      program.buffers[program.buffer_count++] = (struct pvr_pds_buffer){
+         .type = PVR_BUFFER_TYPE_UBO_PRELOAD,
+         .size_in_dwords = data->common.ubo_preloads[u].count,
+         .destination = data->common.ubo_preloads[u].start,
+         .buffer_id = u,
+      };
+   }
+
    if (stage == MESA_SHADER_FRAGMENT &&
        data->common.sys_vals[SYSTEM_VALUE_FRONT_FACE].count > 0) {
       program.buffers[program.buffer_count++] = (struct pvr_pds_buffer){
@@ -2597,6 +2606,10 @@ static void pvr_init_descriptors(pco_data *data,
 
          binding_data->is_inline_ubo = layout_binding->type ==
                                        VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK;
+         binding_data->no_preload =
+            layout_binding->flags &
+            (VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT |
+             VK_DESCRIPTOR_BINDING_PARTIALLY_BOUND_BIT);
       }
    }
 }
@@ -2914,6 +2927,11 @@ static void pvr_postprocess_shader_data(pco_data *data,
 
    pvr_setup_descriptors(data, nir, layout);
 
+   for (unsigned u = 0; u < data->common.num_ubo_preloads; u++) {
+      data->common.ubo_preloads[u].start = data->common.shareds;
+      data->common.shareds += data->common.ubo_preloads[u].count;
+   }
+
    /* TODO: common things, like large constants being put into shareds. */
 }
 
