From d6df66f3758027fe8023c27543d58690a79eb4f2 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 01:50:28 +0800
Subject: [PATCH 053/294] pco: swap commutative sources instead of inserting a
 mov

Special registers can only be sourced from S1/S2/S4, so forward
propagation of e.g. the fragment position into fmul src0 made the
legalizer insert a movs1 (a whole instruction group) per use. For
fadd/fmul/fmad, swap src0 and src1 when that maps both to valid
sources and their modifiers are supported in the new position.

vkrender fragment shader 7 -> 4 groups (both frag-coord moves gone,
which also lets the two fmuls co-issue). BXM-4-64, interleaved A/B x3
for this and the previous commit together:
  vkrender render-only 2048  3.33 -> 2.95 ms
  vkrender 2048 (render + copy)  7.30 -> 6.97 ms
All correctness checks unchanged.
---
 src/imagination/pco/pco_legalize.c | 48 ++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/src/imagination/pco/pco_legalize.c b/src/imagination/pco/pco_legalize.c
index 8935c460..7763f334 100644
--- a/src/imagination/pco/pco_legalize.c
+++ b/src/imagination/pco/pco_legalize.c
@@ -86,6 +86,53 @@ static void insert_mov_ref(pco_instr *instr, pco_ref *ref, bool needs_s124)
    *ref = new_ref;
 }
 
+/**
+ * \brief Whether every modifier set on ref is supported by source src_index.
+ */
+static bool src_mods_supported(const pco_instr *instr,
+                               unsigned src_index,
+                               pco_ref ref)
+{
+   return (!ref.neg || pco_instr_src_has_neg(instr, src_index)) &&
+          (!ref.abs || pco_instr_src_has_abs(instr, src_index)) &&
+          (!ref.flr || pco_instr_src_has_flr(instr, src_index)) &&
+          (!ref.oneminus || pco_instr_src_has_oneminus(instr, src_index)) &&
+          (!ref.clamp || pco_instr_src_has_clamp(instr, src_index)) &&
+          (!ref.elem || pco_instr_src_has_elem(instr, src_index));
+}
+
+/**
+ * \brief Swaps the commutative sources of fadd/fmul/fmad when that maps
+ *        both to valid hardware sources, saving a mov (e.g. a special
+ *        register such as the fragment position into S1).
+ */
+static void try_swap_commutative_srcs(pco_instr *instr,
+                                      const struct pco_op_info *info)
+{
+   if (instr->op != PCO_OP_FADD && instr->op != PCO_OP_FMUL &&
+       instr->op != PCO_OP_FMAD)
+      return;
+
+   if (!info->src_intrn_map[0] || !info->src_intrn_map[1])
+      return;
+
+   enum pco_io m0 = PCO_IO_S0 + info->src_intrn_map[0] - 1;
+   enum pco_io m1 = PCO_IO_S0 + info->src_intrn_map[1] - 1;
+   pco_ref s0 = instr->src[0], s1 = instr->src[1];
+
+   if (ref_src_map_valid(s0, m0, NULL) && ref_src_map_valid(s1, m1, NULL))
+      return;
+
+   if (!ref_src_map_valid(s0, m1, NULL) || !ref_src_map_valid(s1, m0, NULL))
+      return;
+
+   if (!src_mods_supported(instr, 1, s0) || !src_mods_supported(instr, 0, s1))
+      return;
+
+   instr->src[0] = s1;
+   instr->src[1] = s0;
+}
+
 /**
  * \brief Try to legalize an instruction's hardware source mappings.
  *
@@ -115,6 +162,7 @@ static bool try_legalize_src_mappings(pco_instr *instr,
    }
 
    /* Check srcs. */
+   try_swap_commutative_srcs(instr, info);
    pco_foreach_instr_src (psrc, instr) {
       unsigned src_index = psrc - instr->src;
       if (!info->src_intrn_map[src_index])
