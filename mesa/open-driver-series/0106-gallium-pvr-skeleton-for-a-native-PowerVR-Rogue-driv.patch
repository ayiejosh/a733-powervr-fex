new file mode 100644
index 00000000..8068dc1a
--- /dev/null
+++ b/src/gallium/drivers/pvr/meson.build
@@ -0,0 +1,23 @@
+# Copyright 2026 The Mesa authors
+# SPDX-License-Identifier: MIT
+#
+# SKELETON: milestone 1 is that this builds in-tree, registers a pipe_screen and
+# enumerates the device. src/imagination/pco (the NIR-based PowerVR compiler, ~25k
+# lines) is the piece to link against next, not to rewrite.
+
+files_pvr = files(
+  'pvr_screen.c',
+)
+
+libpvr = static_library(
+  'pvr',
+  files_pvr,
+  include_directories : [inc_gallium_aux, inc_gallium, inc_include, inc_src],
+  gnu_symbol_visibility : 'hidden',
+  dependencies : [idep_mesautil, dep_libdrm],
+)
+
+driver_pvr = declare_dependency(
+  compile_args : '-DGALLIUM_PVR',
+  link_with : [libpvr],
+)
diff --git a/src/gallium/drivers/pvr/pvr_public.h b/src/gallium/drivers/pvr/pvr_public.h
new file mode 100644
index 00000000..dab58714
--- /dev/null
+++ b/src/gallium/drivers/pvr/pvr_public.h
@@ -0,0 +1,22 @@
+/*
+ * Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * Native PowerVR (Imagination Rogue) gallium driver - SKELETON.
+ *
+ * Milestone 1: register a pipe_screen and enumerate the device. There is no draw path,
+ * no rasterisation and no resource management yet, and none is claimed.
+ * See docs in the repository's Recovery log for the plan and the scale (10k-30k lines).
+ */
+#ifndef PVR_PUBLIC_H
+#define PVR_PUBLIC_H
+
+struct pipe_screen;
+struct pipe_screen_config;
+struct renderonly;
+
+struct pipe_screen *pvr_screen_create(int fd,
+                                      const struct pipe_screen_config *config,
+                                      struct renderonly *ro);
+
+#endif /* PVR_PUBLIC_H */
diff --git a/src/gallium/drivers/pvr/pvr_screen.c b/src/gallium/drivers/pvr/pvr_screen.c
new file mode 100644
index 00000000..c6582a77
--- /dev/null
+++ b/src/gallium/drivers/pvr/pvr_screen.c
@@ -0,0 +1,70 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * SKELETON. Registers a pipe_screen and enumerates the device.
+ * No draw path, no rasterisation, no resource management - none is claimed.
+ */
+#include "pvr_screen.h"
+#include "pvr_public.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+#include "util/u_memory.h"
+#include "util/os_file.h"
+#include "util/log.h"
+
+static const char *
+pvr_get_name(struct pipe_screen *pscreen)
+{
+   return pvr_screen(pscreen)->name;
+}
+
+static const char *
+pvr_get_vendor(struct pipe_screen *pscreen)
+{
+   return "Imagination Technologies";
+}
+
+static const char *
+pvr_get_device_vendor(struct pipe_screen *pscreen)
+{
+   return "Imagination Technologies";
+}
+
+static void
+pvr_destroy_screen(struct pipe_screen *pscreen)
+{
+   struct pvr_screen *screen = pvr_screen(pscreen);
+
+   if (screen->fd >= 0)
+      close(screen->fd);
+   ralloc_free(screen);
+}
+
+struct pipe_screen *
+pvr_screen_create(int fd, const struct pipe_screen_config *config,
+                  struct renderonly *ro)
+{
+   struct pvr_screen *screen = rzalloc(NULL, struct pvr_screen);
+   if (!screen)
+      return NULL;
+
+   screen->fd = fd;
+   screen->gpu_id = 0;
+
+   /* Enumeration is deliberately minimal for the skeleton: confirm we were handed a
+    * usable device and say so. The kernel UAPI query (DRM_IOCTL_PVR_DEV_QUERY) is the
+    * next step, and it needs the UAPI header moved out of the Vulkan winsys first. */
+   snprintf(screen->name, sizeof(screen->name), "PowerVR Rogue (gallium skeleton)");
+   mesa_logi("pvr: pvr_screen_create fd=%d -> %s (skeleton: no draw path)", fd, screen->name);
+
+   screen->base.destroy = pvr_destroy_screen;
+   screen->base.get_name = pvr_get_name;
+   screen->base.get_vendor = pvr_get_vendor;
+   screen->base.get_device_vendor = pvr_get_device_vendor;
+
+   return &screen->base;
+}
diff --git a/src/gallium/drivers/pvr/pvr_screen.h b/src/gallium/drivers/pvr/pvr_screen.h
new file mode 100644
index 00000000..ec236a4f
--- /dev/null
+++ b/src/gallium/drivers/pvr/pvr_screen.h
@@ -0,0 +1,25 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef PVR_SCREEN_H
+#define PVR_SCREEN_H
+
+#include "pipe/p_screen.h"
+
+struct pvr_screen {
+   struct pipe_screen base;
+
+   int fd;
+
+   /* Device identity, from the kernel UAPI query. Populated by pvr_screen_create. */
+   char name[64];
+   unsigned int gpu_id;
+};
+
+static inline struct pvr_screen *
+pvr_screen(struct pipe_screen *pscreen)
+{
+   return (struct pvr_screen *)pscreen;
+}
+
+#endif /* PVR_SCREEN_H */
diff --git a/src/gallium/meson.build b/src/gallium/meson.build
index 67011f56..cbb166db 100644
--- a/src/gallium/meson.build
+++ b/src/gallium/meson.build
@@ -196,6 +196,11 @@ if with_gallium_ethosu
 else
   driver_ethosu = declare_dependency()
 endif
+if with_gallium_pvr
+  subdir('drivers/pvr')
+else
+  driver_pvr = declare_dependency()
+endif
 if with_gallium_zink
   if not with_platform_windows
     subdir('winsys/zink/drm')
