From bd29bc00a730a96514f4102cf5338c09082f6ebc Mon Sep 17 00:00:00 2001
From: radxa <radxa@radxa-cubie-a7a>
Date: Sun, 1 Nov 2026 21:38:05 +0800
Subject: [PATCH] gallium/pvr: pick the vertex shader variant from the bound
 vertex element formats

The vertex shader derived each attribute's fetch format from the shader's
declared type, so a vec4 attribute fed by a vertex element with three
components was fetched as four dwords: the missing w came from whatever the
previous draw left in the fourth vertex-input register instead of GL's
default 1.  That broke every draw whose position attribute is fed three
floats, most visibly the state tracker's clear quad (a scissored or
colour-masked glClear draws one), and it is a general GL bug, not a clear
one: any app with attribute vec4 fed by glVertexAttribPointer(size 3) drew
garbage.

Keep the vertex shader's source NIR (the fragment stage already did) and
build vertex variants keyed on the bound pipe_vertex_element formats, the
same way fragment variants are keyed on the render target formats.  The
variant's attrib_formats[] come from the element formats, and pco's
attribute synthesizer fills a missing w with 1 from the format's swizzle
(pco_nir_pvfio.c unpack_from_format already does that).  Selection happens
at draw time in pvr_draw_3d() before the vertex fetch program is built; the
fetch program's DMA already uses the bound element's size, so only the
shader side was wrong.

Verified on the board (pvr override): clear_diag now passes every case -
D1-D4 scissored/colour-masked clears at all depths, D9 scissored clear
after a draw, D17 a 3-component attribute right after a w = 2 draw, D18/D19
scissored clears right after draws (all failed before); scissor_probe S5/S7
pass, which had been open.  The gate gains a 'clear quad (D1-D19)' group and
the scissor group now requires S1-S8; ALL GROUPS PASS.  No performance claim
is made here (not measured).
---
 src/gallium/drivers/pvr_native/pvr_context.c |  6 +-
 src/gallium/drivers/pvr_native/pvr_draw.c    | 48 +++++++++++++
 src/gallium/drivers/pvr_native/pvr_shader.c  | 73 ++++++++++++++++----
 src/gallium/drivers/pvr_native/pvr_shader.h  | 17 +++++
 4 files changed, 128 insertions(+), 16 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index 579af1ab..54645949 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -713,9 +713,9 @@ pvr_shader_from_state(struct pipe_context *pctx, const struct pipe_shader_state
       return NULL;
    }
 
-   struct nir_shader *src = state->ir.nir->info.stage == MESA_SHADER_FRAGMENT
-                               ? nir_shader_clone(NULL, state->ir.nir)
-                               : NULL;
+   /* Both stages keep their source NIR: the fragment shader builds per-format variants from it and
+    * the vertex shader builds per-vertex-element-format variants from it. */
+   struct nir_shader *src = nir_shader_clone(NULL, state->ir.nir);
    struct pvr_shader *shader = pvr_shader_create(state->ir.nir, screen->pco_ctx);
    if (shader != NULL)
       shader->src_nir = src;
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index bfde46c1..8633d892 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -1569,6 +1569,51 @@ draw_fb_level(struct pvr_context *ctx)
    return ctx->fb.nr_cbufs && ctx->fb.cbufs[0].texture ? ctx->fb.cbufs[0].level : 0;
 }
 
+/* The vertex shader derives each attribute's fetch format from the declared type. GL lets the bound
+ * vertex element supply fewer components (a vec4 attribute fed three floats gets w = 1) and pco's
+ * unpack fills the missing components from the format's swizzle, so pick a variant compiled against
+ * the bound element formats, like the fragment variants keyed on the render target format. */
+static struct pvr_shader *
+draw_vs_variant(struct pvr_context *ctx, struct pvr_screen *scr, struct pvr_shader *vs)
+{
+   const struct pvr_vertex_elements *ve = ctx->velements_state;
+   enum pipe_format formats[16] = { PIPE_FORMAT_NONE };
+   bool differ = false;
+
+   if (ve == NULL || vs->src_nir == NULL || vs->nr_inputs == 0)
+      return vs;
+
+   for (unsigned i = 0; i < vs->nr_inputs; i++) {
+      const unsigned element = vs->inputs[i].element;
+
+      if (element >= ARRAY_SIZE(formats) || element >= ve->count)
+         continue;
+
+      formats[element] = ve->elements[element].src_format;
+      if (vs->vs_element_formats[element] != formats[element])
+         differ = true;
+   }
+   if (!differ)
+      return vs;
+
+   for (unsigned i = 0; i < vs->nr_vs_variants; i++) {
+      if (!memcmp(vs->vs_variants[i].element_formats, formats, sizeof(formats)))
+         return vs->vs_variants[i].sh;
+   }
+
+   struct pvr_shader *variant =
+      pvr_shader_create_vs_with_formats(nir_shader_clone(NULL, vs->src_nir), scr->pco_ctx, formats);
+   if (variant == NULL)
+      return vs;
+
+   /* Shortcut: round robin past PVR_SHADER_MAX_VARIANTS; the evicted variant stays allocated, as
+    * the fragment variants' shortcuts do. */
+   const unsigned slot = vs->nr_vs_variants < PVR_SHADER_MAX_VARIANTS ? vs->nr_vs_variants++ : 0;
+   memcpy(vs->vs_variants[slot].element_formats, formats, sizeof(formats));
+   vs->vs_variants[slot].sh = variant;
+   return variant;
+}
+
 /* The open render is the framebuffer's (target rt): same target, level, size and depth buffer. */
 static bool
 draw_open_is_fb(struct pvr_context *ctx, struct pvr_draw_state *d, struct pipe_resource *rt)
@@ -1591,6 +1636,9 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
    struct pvr_shader *vs = ctx->vs, *fs = ctx->fs;
    enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY topo;
 
+   if (vs != NULL)
+      vs = draw_vs_variant(ctx, scr, vs);
+
    if (num_draws != 1 || rt == NULL || vs == NULL ||
        fs == NULL || fs->src_nir == NULL || !draw_format_ok(rt_format) ||
        !draw_topology(info->mode, &topo) || draws[0].count == 0)
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.c b/src/gallium/drivers/pvr_native/pvr_shader.c
index 101e5a9c..379140af 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.c
+++ b/src/gallium/drivers/pvr_native/pvr_shader.c
@@ -17,6 +17,13 @@ bool pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir,
                                     pco_data *data, pco_shader **shader_out,
                                     const void **data_out, unsigned *size_out);
 
+/* The same pipeline with the bound vertex element formats supplied (NULL: derive each attribute's
+ * format from the shader's declared type). */
+static bool pvr_shader_compile_data_with(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
+                                         const enum pipe_format *vs_element_formats,
+                                         pco_shader **shader_out, const void **data_out,
+                                         unsigned *size_out);
+
 /* Fills the driver half of pco's vertex-input interface. pco cannot discover either fact from the
  * NIR alone: pco_nir_pvi() synthesises the fetch/convert instructions only for attribute locations
  * whose attrib_formats[] entry is not NONE, and pco_trans_nir.c's trans_load_input_vs() names the
@@ -83,14 +90,26 @@ pvr_shader_vs_inputs_to_generic(struct nir_shader *nir)
  * which attributes to synthesise from attrib_formats[]; a location with no format is skipped and
  * its loads stay unlowered, which is the silent failure this project paid two rounds for. */
 static void
-pvr_shader_init_vs_formats(struct nir_shader *nir, pco_data *data)
+pvr_shader_init_vs_formats(struct nir_shader *nir, pco_data *data,
+                           const enum pipe_format *element_formats)
 {
    nir_foreach_shader_in_variable (var, nir) {
+      enum pipe_format format;
+
       if (var->data.location < 0 || var->data.location >= VERT_ATTRIB_MAX)
          continue;
 
-      data->vs.attrib_formats[var->data.location] =
-         pvr_shader_attr_format(var->type);
+      format = pvr_shader_attr_format(var->type);
+      /* The bound vertex element's own format wins: its component count and type are what the
+       * fetch must follow (GL fills a missing w with 1, which pco's unpack does from the format's
+       * swizzle). element_formats is indexed by the input's driver_location, the pipe_vertex_element
+       * index the fetch uses. */
+      if (element_formats != NULL && var->data.driver_location >= 0 &&
+          var->data.driver_location < 16 &&
+          element_formats[var->data.driver_location] != PIPE_FORMAT_NONE)
+         format = element_formats[var->data.driver_location];
+
+      data->vs.attrib_formats[var->data.location] = format;
    }
 }
 
@@ -308,9 +327,11 @@ pvr_shader_init_vs_alloc(struct nir_shader *nir, pco_data *data)
 
 static struct pvr_shader *
 pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_format *color_formats,
-                       unsigned nr_formats, const nir_lower_blend_options *blend)
+                       unsigned nr_formats, const nir_lower_blend_options *blend,
+                       const enum pipe_format *vs_element_formats)
 {
    struct pvr_shader *shader = calloc(1, sizeof(*shader));
+   enum pipe_format used_element_formats[16] = { PIPE_FORMAT_NONE };
    pco_data data = { 0 };
    if (shader == NULL)
       return NULL;
@@ -342,8 +363,8 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_for
       data.fs.no_alpha_to_coverage = true;
       data.fs.skip_sample_check = true;
    }
-   if (!pvr_shader_compile_data(ctx, nir, &data, &shader->pco, &shader->binary,
-                                &shader->binary_size)) {
+   if (!pvr_shader_compile_data_with(ctx, nir, &data, vs_element_formats, &shader->pco,
+                                     &shader->binary, &shader->binary_size)) {
       free(shader);
       return NULL;
    }
@@ -430,6 +451,14 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_for
          shader->inputs[shader->nr_inputs].dwords = r->count;
          shader->nr_inputs++;
       }
+      nir_foreach_shader_in_variable (var, nir) {
+         const int element = var->data.driver_location;
+         if (element >= 0 && element < 16 && var->data.location >= 0 &&
+             var->data.location < VERT_ATTRIB_MAX)
+            used_element_formats[element] = data.vs.attrib_formats[var->data.location];
+      }
+      memcpy(shader->vs_element_formats, used_element_formats,
+             sizeof(shader->vs_element_formats));
    }
 
    return shader;
@@ -438,14 +467,21 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_for
 struct pvr_shader *
 pvr_shader_create(struct nir_shader *nir, pco_ctx *ctx)
 {
-   return pvr_shader_create_with(nir, ctx, NULL, 0, NULL);
+   return pvr_shader_create_with(nir, ctx, NULL, 0, NULL, NULL);
 }
 
 struct pvr_shader *
 pvr_shader_create_fs(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_format *color_formats,
                      unsigned nr_formats, const nir_lower_blend_options *blend)
 {
-   return pvr_shader_create_with(nir, ctx, color_formats, nr_formats, blend);
+   return pvr_shader_create_with(nir, ctx, color_formats, nr_formats, blend, NULL);
+}
+
+struct pvr_shader *
+pvr_shader_create_vs_with_formats(struct nir_shader *nir, pco_ctx *ctx,
+                                  const enum pipe_format *element_formats)
+{
+   return pvr_shader_create_with(nir, ctx, NULL, 0, NULL, element_formats);
 }
 
 /* The one-attribute vertex DMA both builders are generated from. Shared so the code and its data
@@ -686,15 +722,18 @@ pvr_shader_destroy(struct pvr_shader *shader)
 
    for (unsigned i = 0; i < shader->nr_variants; i++)
       pvr_shader_destroy(shader->variants[i].sh);
+   for (unsigned i = 0; i < ARRAY_SIZE(shader->vs_variants); i++)
+      pvr_shader_destroy(shader->vs_variants[i].sh);
    ralloc_free(shader->src_nir);
    ralloc_free(shader->pco);
    free(shader);
 }
 
-bool
-pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
-                        pco_shader **shader_out, const void **data_out,
-                        unsigned *size_out)
+static bool
+pvr_shader_compile_data_with(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
+                             const enum pipe_format *vs_element_formats,
+                             pco_shader **shader_out, const void **data_out,
+                             unsigned *size_out)
 {
    pco_shader *shader;
    unsigned size;
@@ -709,7 +748,7 @@ pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
     * lowering because pco's lowering both consumes the formats and adds outputs. */
    if (nir->info.stage == MESA_SHADER_VERTEX) {
       pvr_shader_vs_inputs_to_generic(nir);
-      pvr_shader_init_vs_formats(nir, data);
+      pvr_shader_init_vs_formats(nir, data, vs_element_formats);
    }
 
    /* GL's single colour output arrives as FRAG_RESULT_COLOR; pco and the output map work on
@@ -1002,6 +1041,14 @@ pvr_shader_eot_create(pco_ctx *ctx, struct pvr_shader_eot *eot,
    return true;
 }
 
+bool
+pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
+                        pco_shader **shader_out, const void **data_out,
+                        unsigned *size_out)
+{
+   return pvr_shader_compile_data_with(ctx, nir, data, NULL, shader_out, data_out, size_out);
+}
+
 bool
 pvr_shader_compile(pco_ctx *ctx, struct nir_shader *nir, pco_shader **shader_out,
                    const void **data_out, unsigned *size_out)
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.h b/src/gallium/drivers/pvr_native/pvr_shader.h
index 0748a4e3..7f8c348c 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.h
+++ b/src/gallium/drivers/pvr_native/pvr_shader.h
@@ -98,6 +98,19 @@ struct pvr_shader {
    } variants[PVR_SHADER_MAX_VARIANTS];
    unsigned nr_variants;
 
+   /* Vertex shader variants keyed on the bound vertex element formats, like the fragment variants
+    * are keyed on the render target formats. The base shader derives each attribute's format from
+    * the declared type; GL lets the bound element supply fewer components (a vec4 attribute fed
+    * three floats gets w = 1), so a variant compiled with the element's own format is what makes
+    * the fetch correct. element_formats is indexed by pipe_vertex_element index (the input's
+    * driver_location). */
+   enum pipe_format vs_element_formats[16];
+   struct {
+      enum pipe_format element_formats[16];
+      struct pvr_shader *sh;
+   } vs_variants[PVR_SHADER_MAX_VARIANTS];
+   unsigned nr_vs_variants;
+
    /* Fragment variant: what the ISP pass type follows from (discard, framebuffer fetch from
     * blending, a masked colour output), and its blend constants in shared registers. */
    bool discard, fbfetch, masked;
@@ -151,6 +164,10 @@ struct pvr_shader *pvr_shader_create_fs(struct nir_shader *nir, pco_ctx *ctx,
                                         const enum pipe_format *color_formats,
                                         unsigned nr_formats,
                                         const nir_lower_blend_options *blend);
+/* A vertex shader built for the bound vertex element formats: attrib_formats[] come from the
+ * element formats instead of the declared types (see vs_element_formats above). */
+struct pvr_shader *pvr_shader_create_vs_with_formats(struct nir_shader *nir, pco_ctx *ctx,
+                                                     const enum pipe_format *element_formats);
 
 /* Compile any stage and hand back pco's data section as well (the compute path needs it). */
 bool pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
