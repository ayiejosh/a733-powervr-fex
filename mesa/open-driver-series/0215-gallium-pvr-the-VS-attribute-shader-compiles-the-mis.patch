+/* Fills the driver half of pco's vertex-input interface. pco cannot discover either fact from the
+ * NIR alone: pco_nir_pvi() synthesises the fetch/convert instructions only for attribute locations
+ * whose attrib_formats[] entry is not NONE, and pco_trans_nir.c's trans_load_input_vs() names the
+ * vtxin registers through attribs[]. The Vulkan driver fills both from pipeline state
+ * (pvr_alloc_vs_attribs / pvr_init_vs_attribs); this is the same data from the same source, the
+ * shader's declared inputs.
+ *
+ * ponytail: the format is derived from the declared type instead of taken from vertex element
+ * state, so only 32-bit float attributes are described. A GL vertex element can disagree (half,
+ * int, normalised), which is a different format, not a different count - when the frontend feeds
+ * real vertex elements, pass their pipe_format in here instead of deriving it. */
+static enum pipe_format
+pvr_shader_attr_format(const struct glsl_type *type)
+{
+   const struct glsl_type *scalar = glsl_without_array(type);
+
+   if (!glsl_type_is_vector_or_scalar(scalar) || glsl_get_bit_size(scalar) != 32 ||
+       !glsl_base_type_is_float(glsl_get_base_type(scalar)))
+      return PIPE_FORMAT_NONE;
+
+   switch (glsl_get_vector_elements(scalar)) {
+   case 1: return PIPE_FORMAT_R32_FLOAT;
+   case 2: return PIPE_FORMAT_R32G32_FLOAT;
+   case 3: return PIPE_FORMAT_R32G32B32_FLOAT;
+   case 4: return PIPE_FORMAT_R32G32B32A32_FLOAT;
+   default: return PIPE_FORMAT_NONE;
+   }
+}
+
+static void
+pvr_shader_alloc_vs_range(pco_range *ranges, unsigned *counter, nir_variable *var)
+{
+   unsigned slots = glsl_count_dword_slots(var->type, false);
+
+   ranges[var->data.location] = (pco_range){ .start = *counter, .count = slots };
+   *counter += slots;
+}
+
+static void
+pvr_shader_init_vs_data(struct nir_shader *nir, pco_data *data)
+{
+   nir_foreach_shader_in_variable (var, nir) {
+      /* The arrays are indexed by the GL attribute/varying enum, and NIR can carry a location
+       * outside it (a driver bug or a malformed shader). Skip rather than write out of bounds. */
+      if (var->data.location < 0 || var->data.location >= VERT_ATTRIB_MAX)
+         continue;
+
+      pvr_shader_alloc_vs_range(data->vs.attribs, &data->common.vtxins, var);
+      data->vs.attrib_formats[var->data.location] =
+         pvr_shader_attr_format(var->type);
+   }
+
+   /* GL writes gl_Position; the other built-in outputs (point size, layer, clip distances) and
+    * generic varyings get their ranges when the frontend links them - pco only needs the ranges of
+    * the outputs the shader actually writes. */
+   nir_foreach_shader_out_variable (var, nir) {
+      if (var->data.location == VARYING_SLOT_POS)
+         pvr_shader_alloc_vs_range(data->vs.varyings, &data->vs.vtxouts, var);
+   }
+}
