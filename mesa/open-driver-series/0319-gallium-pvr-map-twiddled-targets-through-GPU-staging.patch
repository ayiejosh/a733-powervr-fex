              * stride, swizzles, clip extents - the address and format live in the pixel-event
              * program). They have to be built BEFORE the stream, and into their own buffer: building
              * the stream over its own PBE source replaces the words with the stream header. */
-            if (!pvr_csb_pbe_words(PIPE_FORMAT_R8G8B8A8_UNORM, RTW * 4, RTW, RTH, pbe_words)) {
+            if (!pvr_csb_pbe_words(PIPE_FORMAT_R8G8B8A8_UNORM, RTW * 4, RTW, RTH, false, false, pbe_words)) {
                printf("hwrt:          could not encode the PBE words\n");
                ok2 = false;
             }
diff --git a/src/gallium/drivers/pvr_native/pvr_resource.c b/src/gallium/drivers/pvr_native/pvr_resource.c
