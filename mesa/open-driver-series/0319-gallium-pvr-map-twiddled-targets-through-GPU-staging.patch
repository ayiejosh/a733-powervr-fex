@@ -128,8 +122,6 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
       mesa_logd("pvr: no layout for target %u", templ->target);
       return NULL;
    }
-   if (rt_format && (templ->bind & PIPE_BIND_RENDER_TARGET) && templ->target != PIPE_BUFFER)
