--- a/src/gallium/drivers/pvr_native/pvr_draw.h
+++ b/src/gallium/drivers/pvr_native/pvr_draw.h
@@ -12,6 +12,8 @@
 #include <stdint.h>
 #include "util/format/u_formats.h"
 
+struct pipe_resource;
+
 struct pvr_context;
 struct pipe_draw_info;
 struct pipe_draw_start_count_bias;
@@ -25,6 +27,14 @@ void pvr_draw_flush(struct pvr_context *ctx);
 bool pvr_draw_note_clear(struct pvr_context *ctx, const union pipe_color_union *color);
 void pvr_draw_destroy(struct pvr_context *ctx);
 
+/* A full depth clear of the framebuffer's depth buffer as the render's background depth, opening a
+ * render (that reloads the colour target) if none without draws is open. */
+bool pvr_draw_clear_depth(struct pvr_context *ctx, float depth);
+
+/* GPU copy of src into dst (same size and format, colour target formats): one render whose
+ * background reads src. Asynchronous; a CPU map of dst waits for it. */
+bool pvr_draw_blit(struct pvr_context *ctx, struct pipe_resource *dst, struct pipe_resource *src);
+
 /* Records a full depth clear for the render a colour clear just opened; false if not possible. */
 bool pvr_draw_note_zclear(struct pvr_context *ctx, float depth);
 
