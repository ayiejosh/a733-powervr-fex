@@ -80,11 +80,6 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
    const bool rt_format = fmt == PIPE_FORMAT_R8G8B8A8_UNORM || fmt == PIPE_FORMAT_B8G8R8A8_UNORM ||
                           fmt == PIPE_FORMAT_R8G8B8X8_UNORM || fmt == PIPE_FORMAT_B8G8R8X8_UNORM;
 
-   static int rt_created;
-   /* Debug-only: force one render-target resource (by creation order) to stay linear, so a test can
