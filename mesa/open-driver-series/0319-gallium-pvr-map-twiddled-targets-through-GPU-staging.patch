 src/gallium/drivers/pvr_native/pvr_draw.c     | 90 ++++++++++++++++---
 src/gallium/drivers/pvr_native/pvr_draw.h     | 10 +++
 src/gallium/drivers/pvr_native/pvr_probe.c    |  2 +-
 src/gallium/drivers/pvr_native/pvr_resource.c | 12 +--
 5 files changed, 134 insertions(+), 38 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index 94728c03..e98003db 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -24,6 +24,8 @@
 
 struct pvr_transfer {
    struct pipe_transfer base;
+   /* A twiddled/TFBC target is mapped through a linear copy the GPU makes (and writes back). */
+   struct pipe_resource *staging;
 };
 
 /* Shared by the buffer and texture entry points: this Mesa version split the old
@@ -46,13 +48,36 @@ pvr_transfer_map(struct pipe_context *pctx, struct pipe_resource *pres,
    /* The linear layout only describes level 0 and a single layer. Resource creation
     * already refuses more than that, so reaching here would be a bug rather than a
     * request. */
-   /* ponytail: a twiddled/TFBC target cannot be mapped linearly yet - readback needs a GPU blit to a
-    * linear staging resource (NATIVE-TFBC-PORT.md step 5). glmark2 does not read its targets back, so
-    * the benchmark path stays on the fast layout while readback users get an error instead of
-    * scrambled pixels. */
-   if (res->twiddled && getenv("PVR_TWIDDLED_RAW_READBACK") == NULL) {
-      mesa_loge("pvr: transfer_map on a twiddled resource is not implemented yet");
-      return NULL;
+   /* A twiddled/TFBC colour target is read and written through a linear copy: the GPU decodes it
+    * into the staging resource (unless the whole content is discarded) and, after a write, encodes
+    * it back on unmap. Twiddled depth is only written by the ZLS. */
+   if (res->twiddled) {
+      struct pvr_context *ctx = pvr_context(pctx);
+      if (util_format_is_depth_or_stencil(pres->format) || level != 0 || box->depth != 1) {
+         mesa_loge("pvr: transfer_map on a twiddled depth or mipmapped resource is not supported");
+         return NULL;
+      }
+      struct pipe_resource templ = *pres;
+      templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_LINEAR;
+      templ.last_level = 0;
+      templ.next = NULL;
+      struct pipe_resource *staging = pctx->screen->resource_create(pctx->screen, &templ);
+      if (staging == NULL)
+         return NULL;
+      if (!(usage & PIPE_MAP_DISCARD_WHOLE_RESOURCE) && !pvr_draw_blit(ctx, staging, pres)) {
+         pipe_resource_reference(&staging, NULL);
+         return NULL;
+      }
+      void *map = pvr_transfer_map(pctx, staging, 0, usage & ~PIPE_MAP_UNSYNCHRONIZED, box,
+                                   out_transfer);
+      if (map == NULL) {
+         pipe_resource_reference(&staging, NULL);
+         return NULL;
+      }
+      struct pvr_transfer *t = (struct pvr_transfer *)*out_transfer;
+      pipe_resource_reference(&t->base.resource, pres);
+      t->staging = staging;
+      return map;
    }
    if (level != 0 || box->depth != 1) {
       mesa_loge("pvr: refusing a transfer at level %u depth %u", level, box->depth);
@@ -84,10 +109,6 @@ pvr_transfer_map(struct pipe_context *pctx, struct pipe_resource *pres,
    if (res->stride != 0) {
       offset = (uint64_t)box->y * res->stride +
                (uint64_t)box->x * util_format_get_blocksize(pres->format);
-      /* Debug raw mode: expose the twiddled data area with the physical row pitch, so a test can
-       * inspect the layout the PBE actually produced (no twiddle/decode applied). */
-      if (res->twiddled)
-         offset += res->fbc_header_size;
    } else {
       offset = box->x;
    }
@@ -98,10 +119,14 @@ pvr_transfer_map(struct pipe_context *pctx, struct pipe_resource *pres,
 }
 
 static void
-pvr_transfer_unmap(UNUSED struct pipe_context *pctx, struct pipe_transfer *transfer)
+pvr_transfer_unmap(struct pipe_context *pctx, struct pipe_transfer *transfer)
 {
    struct pvr_transfer *trans = (struct pvr_transfer *)transfer;
-
+   if (trans->staging != NULL) {
+      if (trans->base.usage & PIPE_MAP_WRITE)
+         pvr_draw_blit(pvr_context(pctx), trans->base.resource, trans->staging);
+      pipe_resource_reference(&trans->staging, NULL);
+   }
    pipe_resource_reference(&trans->base.resource, NULL);
    FREE(trans);
 }
@@ -630,9 +655,10 @@ pvr_clear(struct pipe_context *pctx, unsigned buffers, uint32_t color_clear_mask
       }
 
       /* A full depth clear with a GPU colour clear is the render's background depth. */
-      if ((flags & PIPE_CLEAR_DEPTH) && gpu_cleared &&
-          !util_format_has_stencil(util_format_description(ctx->fb.zsbuf.format)) &&
-          pvr_draw_note_zclear(ctx, depth))
+      /* Any full depth clear is the render's background depth (the ZLS writes it); the CPU
+       * cannot fill a twiddled depth buffer. Stencil is not supported yet. */
+      if ((flags & PIPE_CLEAR_DEPTH) && scissor_state == NULL &&
+          ((gpu_cleared && pvr_draw_note_zclear(ctx, depth)) || pvr_draw_clear_depth(ctx, depth)))
          flags &= ~PIPE_CLEAR_DEPTH;
       if (flags != 0) {
          util_clear_depth_stencil(pctx, &ctx->fb.zsbuf, flags, depth, stencil, dstx,
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 74438bc4..b98c2f4c 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -143,6 +143,8 @@ struct pvr_draw_state {
    unsigned nr_load;
    /* The colour target of a depth-only framebuffer, and the texture an unbound unit reads. */
    struct pipe_resource *scratch_rt;
+   /* A blit render: the background loads this resource instead of the target. */
+   struct pipe_resource *load_src;
    struct pipe_resource *black;
    unsigned nr_bg;
 };
@@ -836,7 +838,9 @@ static bool
 draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bgnd[3])
 {
    struct pvr_screen *scr = draw_screen(ctx);
-   const struct pvr_resource *rt = pvr_resource(d->rt);
+   /* The texture read: the target itself, or a blit's source (same size and format). */
+   struct pipe_resource *src = d->load_src ? d->load_src : d->rt;
+   const struct pvr_resource *rt = pvr_resource(src);
    const enum pipe_format format = d->rt->format;
    struct pvr_shader *fs = NULL;
    struct pvr_format_layout layout;
@@ -885,8 +889,8 @@ draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bg
    uint32_t *binding = u + (fs->tex_dst[0] - fs->shared_dma_start);
    struct pvr_tex_desc tex = {
       .components = layout.components,
-      .width = d->rt->width0,
-      .height = d->rt->height0,
+      .width = src->width0,
+      .height = src->height0,
       .stride = rt->stride / util_format_get_blocksize(format),
       .addr = rt->data_addr,
       .twiddled = rt->twiddled,
@@ -1104,14 +1108,12 @@ draw_open(struct pvr_context *ctx, struct pvr_draw_state *d, struct pipe_resourc
    return true;
 }
 
-bool
-pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
-            const struct pipe_draw_start_count_bias *draws, unsigned num_draws)
+/* The colour target the framebuffer renders into: colour buffer 0, or for a depth-only framebuffer
+ * a scratch colour target of its size. */
+static struct pipe_resource *
+draw_fb_target(struct pvr_context *ctx)
 {
-   struct pvr_screen *scr = draw_screen(ctx);
-   struct pvr_draw_state *d;
    struct pipe_resource *rt = ctx->fb.nr_cbufs ? ctx->fb.cbufs[0].texture : NULL;
-   /* A depth-only framebuffer renders into a scratch colour target of its size. */
    if (rt == NULL && ctx->fb.zsbuf.texture != NULL && ctx->draw != NULL) {
       struct pvr_draw_state *dd = ctx->draw;
       if (dd->scratch_rt == NULL || dd->scratch_rt->width0 != ctx->fb.width ||
@@ -1128,11 +1130,21 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
       }
       rt = dd->scratch_rt;
    }
+   return rt;
+}
+
+bool
+pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
+            const struct pipe_draw_start_count_bias *draws, unsigned num_draws)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   struct pvr_draw_state *d;
+   struct pipe_resource *rt = draw_fb_target(ctx);
    const enum pipe_format rt_format = rt ? rt->format : PIPE_FORMAT_NONE;
    struct pvr_shader *vs = ctx->vs, *fs = ctx->fs;
    enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY topo;
 
-   if (getenv("PVR_NATIVE_COMPUTE_FALLBACK") || num_draws != 1 || rt == NULL || vs == NULL ||
+   if (num_draws != 1 || rt == NULL || vs == NULL ||
        fs == NULL || fs->src_nir == NULL || !draw_format_ok(rt_format) ||
        !draw_topology(info->mode, &topo) ||
        info->instance_count != 1 || draws[0].count == 0)
@@ -1411,6 +1423,61 @@ pvr_draw_note_zclear(struct pvr_context *ctx, float depth)
    return true;
 }
 
+/* Opens a render on the framebuffer for a clear, keeping one already open without draws. */
+static bool
+draw_open_fb(struct pvr_context *ctx)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (d == NULL) {
+      ctx->draw = d = calloc(1, sizeof(struct pvr_draw_state));
+      if (d == NULL)
+         return false;
+   }
+   struct pipe_resource *rt = draw_fb_target(ctx);
+   if (rt == NULL || !draw_format_ok(rt->format))
+      return false;
+   if (d->open && (d->ndraws != 0 || d->rt != rt || d->zs != ctx->fb.zsbuf.texture))
+      pvr_draw_flush(ctx);
+   return d->open || (draw_init(ctx, d) && draw_open(ctx, d, rt, ctx->fb.width, ctx->fb.height));
+}
+
+bool
+pvr_draw_clear_depth(struct pvr_context *ctx, float depth)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (ctx->fb.zsbuf.texture == NULL || draw_zls_format(ctx->fb.zsbuf.texture->format) < 0 ||
+       !draw_open_fb(ctx))
+      return false;
+   d = ctx->draw;
+   if (d->zs != ctx->fb.zsbuf.texture)
+      return false;
+   d->zclear_valid = true;
+   d->zclear = depth;
+   return true;
+}
+
+bool
+pvr_draw_blit(struct pvr_context *ctx, struct pipe_resource *dst, struct pipe_resource *src)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (dst->width0 != src->width0 || dst->height0 != src->height0 ||
+       dst->format != src->format || !draw_format_ok(dst->format))
+      return false;
+   pvr_draw_flush(ctx);
+   if (d == NULL) {
+      ctx->draw = d = calloc(1, sizeof(struct pvr_draw_state));
+      if (d == NULL)
+         return false;
+   }
+   if (!draw_init(ctx, d) || !draw_open(ctx, d, dst, dst->width0, dst->height0))
+      return false;
+   pipe_resource_reference(&d->zs, NULL);
+   draw_use(d, src);
+   pipe_resource_reference(&d->load_src, src);
+   pvr_draw_flush(ctx);
+   return true;
+}
+
 void
 pvr_draw_resource_sync(struct pvr_context *ctx, const struct pvr_resource *res)
 {
@@ -1448,7 +1515,7 @@ pvr_draw_flush(struct pvr_context *ctx)
       return;
    d->open = false;
    /* A recorded clear is a render even without draws: it is the only place the clear happens. */
-   if (d->ndraws == 0 && !d->clear_valid)
+   if (d->ndraws == 0 && !d->clear_valid && d->load_src == NULL && !d->zclear_valid)
       goto done;
 
    struct pvr_resource *rt = pvr_resource(d->rt);
@@ -1537,6 +1604,7 @@ done:
    d->clear_valid = false;
    d->zclear_valid = false;
    pipe_resource_reference(&d->zs, NULL);
+   pipe_resource_reference(&d->load_src, NULL);
    d->ndraws = 0;
    pipe_resource_reference(&d->rt, NULL);
 }
