From 33f0958a1ee0f2793d0b0c6b8f2987745ea2f6c9 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Tue, 13 Oct 2026 23:12:13 +0800
Subject: [PATCH 102/294] pco: shrink vecs that have collated sources

pco_shrink_vecs only trimmed vecs made of single channel sources. A vec
that mixes in a multi channel source, such as the result of a varying
iteration used as texture coordinates, kept all of its dead trailing
channels, each one a zero copy and a temporary: the coordinate vec of a
texture sample was 16 channels wide for 4 used ones.

Drop the trailing sources that start after the last used channel, whole
sources only.

effect2d goes from 31 to 16 temporaries and 58 to 52 groups, bump from 18
to 16 temporaries and 233 to 218 groups. glmark2 through zink, off-screen:
effect2d +15%, desktop shadow +16%, bump +3%.

pco_opt_comp_only_vecs counted sources to recognise vecs without collated
elements; a shrunk collated vec can now match that count, so check it
explicitly.
---
 src/imagination/pco/pco_opt.c | 26 +++++++++++++++++++++-----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/src/imagination/pco/pco_opt.c b/src/imagination/pco/pco_opt.c
index 0ed126d9..b1d961d5 100644
--- a/src/imagination/pco/pco_opt.c
+++ b/src/imagination/pco/pco_opt.c
@@ -730,9 +730,7 @@ bool pco_shrink_vecs(pco_shader *shader)
          if (vec->op != PCO_OP_VEC)
             continue;
 
-         /* Can't shrink if has collated elems. */
-         if (!only_uncollated_elems(vec))
-            continue;
+         bool collated = !only_uncollated_elems(vec);
 
          pco_ref *pdest = &vec->dest[0];
          unsigned chans_used = 0;
@@ -766,10 +764,27 @@ bool pco_shrink_vecs(pco_shader *shader)
          if (chans_used == chans)
             continue;
 
+         if (collated) {
+            /* Only whole sources can be dropped: keep the ones that start
+             * before the end of the last used channel.
+             */
+            unsigned keep_srcs = 0;
+            unsigned keep_chans = 0;
+            while (keep_srcs < vec->num_srcs && keep_chans < chans_used)
+               keep_chans += pco_ref_get_chans(vec->src[keep_srcs++]);
+
+            if (keep_chans >= chans)
+               continue;
+
+            vec->num_srcs = keep_srcs;
+            *pdest = pco_ref_chans(*pdest, keep_chans);
+            progress = true;
+            continue;
+         }
+
          /* Update the vec. */
          vec->num_srcs = chans_used;
          *pdest = pco_ref_chans(*pdest, chans_used);
-
          progress = true;
       }
    }
@@ -818,7 +833,8 @@ bool pco_opt_comp_only_vecs(pco_shader *shader)
 
          /* Has collated vec, skip. */
          /* TODO: support this. */
-         if (vec->num_srcs != util_dynarray_num_elements(&comps, pco_instr *)) {
+         if (!only_uncollated_elems(vec) ||
+             vec->num_srcs != util_dynarray_num_elements(&comps, pco_instr *)) {
             util_dynarray_fini(&comps);
             continue;
          }
