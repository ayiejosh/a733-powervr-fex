+      /* Context-switch support: the static context state must name the context-state buffers and
+       * carry real store/resume task programs. A context created without them is accepted by the
+       * kernel and its jobs never run; the state stream is where that is visible. */
+      {
+         uint8_t stream[192];
+         uint64_t *words = (uint64_t *)stream;
+         const uint32_t len =
+            pvr_static_context_state(stream, sizeof(stream), &gpu_ctx.cswitch);
+         struct ROGUE_CR_VDM_CONTEXT_STATE_BASE vdm_read = { 0 };
+         struct ROGUE_CR_TA_CONTEXT_STATE_BASE geom_read = { 0 };
+         bool ok_ctx = len == sizeof(stream) && words[0] == len;
+
+         if (ok_ctx) {
+            ROGUE_CR_VDM_CONTEXT_STATE_BASE_unpack(&words[1], &vdm_read);
+            ROGUE_CR_TA_CONTEXT_STATE_BASE_unpack(&words[3], &geom_read);
+            ok_ctx = vdm_read.addr == gpu_ctx.cswitch.vdm_state_addr &&
+                     geom_read.addr == gpu_ctx.cswitch.geom_state_addr;
+         }
+
+         /* The store/resume task words are the PDS programs; a group whose tasks are all zero is a
+          * context switch that saves nothing. Compare against the programs that were built rather
+          * than merely requiring non-zero. */
+         for (unsigned i = 0; ok_ctx && i < 2; i++) {
+            const struct pvr_ctx_switch_programs *p = &gpu_ctx.cswitch.programs[i];
+            struct ROGUE_CR_VDM_CONTEXT_STORE_TASK0 store0 = { 0 };
+            struct ROGUE_CR_VDM_CONTEXT_RESUME_TASK0 resume0 = { 0 };
+
+            ROGUE_CR_VDM_CONTEXT_STORE_TASK0_unpack(&words[4 + i * 10], &store0);
+            ROGUE_CR_VDM_CONTEXT_RESUME_TASK0_unpack(&words[9 + i * 10], &resume0);
+            ok_ctx = store0.pds_state0 != 0 && store0.pds_state1 != 0 &&
+                     resume0.pds_state0 != 0 && resume0.pds_state1 != 0 &&
+                     p->sr_store.data_dwords != 0 && p->sr_load.code_dwords != 0 &&
+                     p->pt_store.data_dwords != 0 && p->pt_resume.code_dwords != 0;
+         }
+
+         if (!ok_ctx) {
+            printf("vm:            FAIL: context-switch state is incomplete (len %u, VDM 0x%"
+                   PRIx64 ", GEOM 0x%" PRIx64 ")\n", len,
+                   (uint64_t)vdm_read.addr, (uint64_t)geom_read.addr);
+            pvr_gpu_context_destroy(&vm, &gpu_ctx);
+            goto out;
+         }
+
+         printf("vm:            context switch: VDM/GEOM state buffers named, SR store/load and "
+                "PT store/resume PDS programs built, %u-byte static state\n", len);
+      }
+
       printf("vm:            sizes: drm_pvr_job=%zu obj_array=%zu hwrt_ref=%zu\n",
              sizeof(struct drm_pvr_job), sizeof(struct drm_pvr_obj_array),
              sizeof(struct drm_pvr_hwrt_data_ref));
@@ -536,7 +553,10 @@ vm_roundtrip(int fd, const struct pvr_device_info *dev_info)
          uint64_t mli2addr = 0, mta2addr = 0, rgn2addr = 0, rtcaddr = 0;
          uint32_t flhandle[2] = {0};
          bool okb = true;
-         const uint64_t sz[11] = { 4096, 4096, 4096, 1536, 4096, 4096, 256, 4096, 4096, 256, 256 };
+         /* Sizes from the device formulas and a capture of the reference's dataset for 512x512:
+          * tpc 2048 (probe rounds to a page), vheap 384 entries x 4 B, one region-header stride
+          * (1536 B) per render-target data set, no RTC and no macrotile array for one layer. */
+         const uint64_t sz[11] = { 4096, 4096, 4096, 1536, 4096, 4096, 4096, 4096, 4096, 4096, 256 };
          struct pvr_bo *bos[11] = { &flbo[0], &flbo[1], &tpcbo, &vhbo, &mlibo, &mtabo, &rgnbo, &mli2, &mta2, &rgn2, &rtcbo };
