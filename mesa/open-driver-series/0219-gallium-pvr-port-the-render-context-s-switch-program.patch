@@ -566,14 +586,18 @@ vm_roundtrip(int fd, const struct pvr_device_info *dev_info)
             if (okb) {
                struct pvr_hwrt_dataset_desc d = {
                   .tpc_dev_addr = tpcaddr, .tpc_size = 4096, .tpc_stride = 0,
-                  .vheap_table_dev_addr = vhaddr, .rtc_dev_addr = rtcaddr,
+                  /* (sz computed above; 4 KiB page covers the 2048-byte tail-pointer cache) */
+                  /* Value for value what the reference's create_info carries for 512x512 on this
+                   * device: no RTC (one layer), no macrotile array, and ISP-merge registers left at
+                   * zero because the merge enhancement is absent. */
+                  .vheap_table_dev_addr = vhaddr, .rtc_dev_addr = 0,
                   .pm_mlist_dev_addr = { mliaddr, mli2addr },
-                  .macrotile_array_dev_addr = { mtaaddr, mta2addr },
+                  .macrotile_array_dev_addr = { 0, 0 },
                   .region_header_dev_addr = { rgnaddr, rgn2addr },
                   .free_list_handles = { flhandle[0], flhandle[1] },
                   .width = 512, .height = 512, .samples = 1, .layers = 1,
                   .isp_merge_lower_x = 0, .isp_merge_lower_y = 0,
-                  .isp_merge_scale_x = 0x3f800000u, .isp_merge_scale_y = 0x3f800000u,
+                  .isp_merge_scale_x = 0, .isp_merge_scale_y = 0,
                   .isp_merge_upper_x = 0, .isp_merge_upper_y = 0,
                   .region_header_size = 256,
                };
diff --git a/src/gallium/drivers/pvr_native/pvr_static.c b/src/gallium/drivers/pvr_native/pvr_static.c
index d6f6dca7..5d43aa5b 100644
--- a/src/gallium/drivers/pvr_native/pvr_static.c
+++ b/src/gallium/drivers/pvr_native/pvr_static.c
@@ -135,34 +135,334 @@ pvr_fill_pixel_event(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
    return true;
 }
 
+/* Upload a generated PDS program into the PDS heap as [data][code], returning heap-relative
+ * offsets. The hardware names the data segment and, where the route allows it, expects the code to
+ * follow it. */
+static bool
+pvr_static_pds_upload(struct pvr_vm *vm, const uint32_t *data, uint32_t data_dwords,
+                      const uint32_t *code, uint32_t code_dwords,
+                      struct pvr_pds_program *out)
+{
+   const struct pvr_heap *heap = &vm->heaps[DRM_PVR_HEAP_PDS_CODE_DATA];
+   struct pvr_bo bo = { 0 };
+   uint64_t addr = pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_PDS_CODE_DATA,
+                                     ((uint64_t)data_dwords + code_dwords) * 4, 16, &bo);
+
+   if (addr == 0 || !pvr_bo_map(vm->fd, &bo))
+      return false;
+
+   memcpy(bo.map, data, data_dwords * 4);
+   memcpy((uint8_t *)bo.map + data_dwords * 4, code, code_dwords * 4);
+
+   *out = (struct pvr_pds_program){
+      .data_offset = addr - heap->base,
+      .code_offset = addr - heap->base + (uint64_t)data_dwords * 4,
+      .data_dwords = data_dwords,
+      .code_dwords = code_dwords,
+   };
+   return true;
+}
+
+/* Upload one of the USC state save/restore binaries into the USC heap. They are precompiled (the
+ * pco USC library carries them), and their DOUTU execution address is a USC-heap offset. */
+static bool
+pvr_static_usc_upload(struct pvr_vm *vm, unsigned program,
+                      uint32_t *offset_out, unsigned *temps_out)
+{
+   const pco_precomp_data *precomp = (const pco_precomp_data *)pco_usclib_common[program];
+   const struct pvr_heap *heap = &vm->heaps[DRM_PVR_HEAP_USC_CODE];
+   const uint32_t size = precomp->size_dwords * 4;
+   struct pvr_bo bo = { 0 };
+   uint64_t addr;
+
+   if (precomp == NULL || size == 0)
+      return false;
+
+   addr = pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_USC_CODE, size, 16, &bo);
+   if (addr == 0 || !pvr_bo_map(vm->fd, &bo))
+      return false;
+
+   memcpy(bo.map, precomp->binary, size);
+   *offset_out = addr - heap->base;
+   *temps_out = precomp->temps;
+   return true;
+}
+
+/* The SR store/load programs: a DOUTW that writes the USC shared registers to the SR buffer, then a
+ * DOUTU that runs the precompiled USC store/load binary. `store` selects the USC target. */
+static bool
+pvr_static_sr_program(struct pvr_vm *vm, const struct pvr_device_info *dev_info, bool store,
+                      const struct pvr_ctx_switch *cs, struct pvr_pds_program *out)
+{
+   struct pvr_pds_shared_storing_program program = { 0 };
+   uint32_t staging[256];
+   uint32_t data_dwords, code_dwords, code_at;
+   uint32_t usc_offset = store ? cs->usc_store_offset : cs->usc_load_offset;
+   unsigned temps = store ? cs->usc_store_temps : cs->usc_load_temps;
+
+   memset(staging, 0, sizeof(staging));
+
+   program.doutw_control = (struct pvr_pds_doutw_control){
+      .dest_store = PDS_UNIFIED_STORE,
+      .num_const64 = 2,
+      .doutw_data = {
+         cs->sr_buffer_addr,
+         cs->sr_buffer_addr + ROGUE_LLS_SHARED_REGS_RESERVE_SIZE,
+      },
+      .last_instruction = false,
+   };
+   pvr_pds_setup_doutu(&program.usc_task.usc_task_control, usc_offset, temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, false);
+
+   pvr_pds_generate_shared_storing_program(&program, staging, PDS_GENERATE_DATA_SEGMENT,
+                                           dev_info);
+   data_dwords = program.data_size;
+   code_at = ALIGN_POT(data_dwords,
+                       ROGUE_VDMCTRL_PDS_STATE0_PDS_DATA_SIZE_UNIT_SIZE / 4);
+   pvr_pds_generate_shared_storing_program(&program, staging + code_at,
+                                           PDS_GENERATE_CODE_SEGMENT, dev_info);
+   code_dwords = program.code_size;
+
+   return pvr_static_pds_upload(vm, staging, data_dwords, staging + code_at, code_dwords, out);
+}
+
+/* The PT store program: writes N persistent temps to the PT buffer and terminates stream out.
+ * The resume program initialises stream out from the same buffer. Both are PDS programs the
+ * context-switch state names directly. */
+static bool
+pvr_static_pt_programs(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                       const struct pvr_ctx_switch *cs, struct pvr_pds_program *store_out,
+                       struct pvr_pds_program *resume_out)
+{
+   const uint32_t pt_dwords = ROGUE_LLS_PDS_PERSISTENT_TEMPS_BUFFER_SIZE / 4;
+   uint32_t staging[256];
+   uint32_t *code;
+   uint32_t data_dwords, code_dwords, code_at;
+
+   /* Store. */
+   {
+      struct pvr_pds_stream_out_terminate_program program = {
+         .pds_persistent_temp_size_to_store = pt_dwords,
+         .dev_address_for_storing_persistent_temp = cs->pt_buffer_addr,
+      };
+
+      memset(staging, 0, sizeof(staging));
+      pvr_pds_generate_stream_out_terminate_program(&program, NULL, PDS_GENERATE_SIZES,
+                                                    dev_info);
+      data_dwords = program.stream_out_terminate_pds_data_size;
+      code_dwords = program.stream_out_terminate_pds_code_size;
+      pvr_pds_generate_stream_out_terminate_program(&program, staging,
+                                                    PDS_GENERATE_DATA_SEGMENT, dev_info);
+      pvr_pds_generate_stream_out_terminate_program(
+         &program, staging + data_dwords, PDS_GENERATE_CODE_SEGMENT, dev_info);
+
+      if (!pvr_static_pds_upload(vm, staging, data_dwords, staging + data_dwords,
+                                 code_dwords, store_out))
+         return false;
+   }
+
+   /* Resume. */
+   {
+      struct pvr_pds_stream_out_init_program program = { .num_buffers = 1 };
+
+      program.pds_buffer_data_size[0] = pt_dwords;
+      program.dev_address_for_buffer_data[0] = cs->pt_buffer_addr;
+
+      memset(staging, 0, sizeof(staging));
+      pvr_pds_generate_stream_out_init_program(&program, NULL, false, PDS_GENERATE_SIZES,
+                                               dev_info);
+      data_dwords = program.stream_out_init_pds_data_size;
+      code_dwords = program.stream_out_init_pds_code_size;
+
+      code_at = data_dwords;
+      pvr_pds_generate_stream_out_init_program(&program, staging, false,
+                                               PDS_GENERATE_DATA_SEGMENT, dev_info);
+      code = pvr_pds_generate_stream_out_init_program(&program, staging + code_at, false,
+                                                      PDS_GENERATE_CODE_SEGMENT, dev_info);
+      (void)code;
+
+      if (!pvr_static_pds_upload(vm, staging, data_dwords, staging + code_at,
+                                 code_dwords, resume_out))
+         return false;
+   }
+
+   return true;
+}
+
+/* One 256-byte staging buffer is enough for every PDS task program here: the reference asserts the
+ * same limit (ROGUE_PDS_TASK_PROGRAM_SIZE) for exactly these. */
+
+bool
+pvr_static_ctx_switch_init(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                           struct pvr_ctx_switch *cs)
+{
+   const struct pvr_heap *pds = &vm->heaps[DRM_PVR_HEAP_PDS_CODE_DATA];
+   const uint64_t sr_size =
+      ROGUE_LLS_USC_SHARED_REGS_BUFFER_SIZE + ROGUE_LLS_SHARED_REGS_RESERVE_SIZE;
+   struct pvr_bo sr_bo = { 0 }, pt_bo = { 0 };
+
+   memset(cs, 0, sizeof(*cs));
+
+   cs->vdm_state_addr = pvr_vm_alloc(vm, ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_SIZE,
+                                     ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_ALIGNMENT);
+   if (cs->vdm_state_addr == 0 ||
+       !pvr_bo_create(vm->fd, ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_SIZE,
+                      ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_ALIGNMENT, &cs->vdm_state_bo) ||
+       !pvr_vm_map(vm, cs->vdm_state_addr, cs->vdm_state_bo.handle, cs->vdm_state_bo.size))
+      return false;
+
+   cs->geom_state_addr = pvr_vm_alloc(vm, ROGUE_LLS_TA_STATE_BUFFER_SIZE,
+                                      ROGUE_LLS_TA_STATE_BUFFER_ALIGNMENT);
+   if (cs->geom_state_addr == 0 ||
+       !pvr_bo_create(vm->fd, ROGUE_LLS_TA_STATE_BUFFER_SIZE,
+                      ROGUE_LLS_TA_STATE_BUFFER_ALIGNMENT, &cs->geom_state_bo) ||
+       !pvr_vm_map(vm, cs->geom_state_addr, cs->geom_state_bo.handle, cs->geom_state_bo.size))
+      return false;
+
+   /* The USC shared-register save buffer (DOUTW target) and the persistent-temps buffer. */
+   cs->sr_buffer_addr = pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_PDS_CODE_DATA, sr_size, 16, &sr_bo);
+   if (cs->sr_buffer_addr == 0)
+      return false;
+   cs->pt_buffer_addr = pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_PDS_CODE_DATA,
+                                          ROGUE_LLS_PDS_PERSISTENT_TEMPS_BUFFER_SIZE,
+                                          ROGUE_LLS_PDS_PERSISTENT_TEMPS_BUFFER_ALIGNMENT,
+                                          &pt_bo);
+   if (cs->pt_buffer_addr == 0)
+      return false;
+
+   /* The state save/restore binaries. The 64-byte USC store/load workspace is expressed in
+    * VDMCTRL_PDS_STATE0 units (16 bytes), as the reference does. */
+   cs->usc_unified_size =
+      DIV_ROUND_UP(64, ROGUE_VDMCTRL_PDS_STATE0_USC_UNIFIED_SIZE_UNIT_SIZE);
+
+   if (!pvr_static_usc_upload(vm, CS_STORE_SR_1024_COMMON, &cs->usc_store_offset,
+                              &cs->usc_store_temps) ||
+       !pvr_static_usc_upload(vm, CS_LOAD_SR_256_COMMON, &cs->usc_load_offset,
+                              &cs->usc_load_temps))
+      return false;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(cs->programs); i++) {
+      struct pvr_ctx_switch_programs *p = &cs->programs[i];
+
+      if (!pvr_static_sr_program(vm, dev_info, true, cs, &p->sr_store) ||
+          !pvr_static_sr_program(vm, dev_info, false, cs, &p->sr_load) ||
+          !pvr_static_pt_programs(vm, dev_info, cs, &p->pt_store, &p->pt_resume))
+         return false;
+   }
+
+   (void)pds;
+   return true;
+}
+
+static void
