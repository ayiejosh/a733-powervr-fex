From aa8ad284ac2b2ec19a68ec354ac801ebcd6f538a Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Mon, 2 Nov 2026 10:20:52 +0800
Subject: [PATCH] gallium/pvr: let pco pool 32-bit literals into the
 shared-register block

The native graphics path never told pco that the driver can fill the literal
pool, so every 32-bit immediate that is not a hardware constant-register value
was materialised by the shader itself: a MOVI32 is lowered to a bbyp0bm_imm32
bitwise group, one full instruction group per distinct literal. The Vulkan
driver and the native compute path already enable pco's pool (pco_const_imms.c
places up to 32 such values in shared registers after the driver-allocated
ones, and only when every use can read a shared register); the GL driver can do
the same because its per-draw shared block is already DMA'd into those
registers by the PDS descriptor program.

Enable it, and carry the compiler's result correctly:

- pco_trans_nir() copies the caller's pco_data before the compiler passes run,
  so the final shared-register count and the literal pool only exist in
  pco_shader_data(shader->pco). pvr_shader_create_with() now takes the
  shared-register count from that final data - the literal pool is the only
  pass that grows it after translation - and records literals.start/count/vals.
- The pool lives inside [shared_dma_start, shareds), so the existing
  PVR_BUFFER_TYPE_PUSH_CONSTS DMA and usc_shared_count cover it; the draw path
  only has to copy the values into the per-draw block (pvr_draw.c, draw and
  load-program builders).

Measured on the board in a same-session A/B against the clean fe34d38c build,
on the committed build of this patch (all raw outputs archived in
open-perf/tasks/T-2026-11-02-codegen/runs/001-literal-pool-graphics/; every
replay cell prints a centre-pixel readback and all readbacks are identical to
the pre-change values):

  loop FS         19 -> 14 instruction groups (224 -> 176 B), temps 5 -> 4
  conditionals FS 18 -> 12 groups
  bump FS         34 -> 25 groups (offline pco, 6 literals pooled)
  math FS         26 -> 23 groups (offline pco, 3 literals pooled)
  db2 loop replay fl=0 1117/813 -> 1188/1283 fps (noisy cell), fl=16 375/380 ->
    403/402, fl=64 125/125 -> 129/127
  db2 conditionals replay 996/1019/1019 -> 1211/1200/1229 fps
  glmark2-es2 --off-screen (weston/Xwayland), 2 interleaved rounds: loop
    1225/1231 -> 1325/1354, conditionals 1203/1206 -> 1377/1331, bump
    1504/1500 -> 1571/1601; fragment-lit shading variants blinn-phong-inf
    794/798 -> 847/845 and cel 537/540 -> 568/566, vertex-lit gouraud flat
  db2 math 952 -> 1045 fps (+10%); ilp/alu/trans within +-2%, fill -1.4% (all
    inside run-to-run spread)

The native correctness gate passes (20/20 groups, README "verify gate"), with
the build identity recorded in the gate log.
---
 src/gallium/drivers/pvr_native/pvr_draw.c   |  8 ++++
 src/gallium/drivers/pvr_native/pvr_shader.c | 45 ++++++++++++++++-----
 src/gallium/drivers/pvr_native/pvr_shader.h | 12 ++++++
 3 files changed, 55 insertions(+), 10 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index e8abbc80..b9cecf1b 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -1042,6 +1042,11 @@ draw_uniform_program(struct pvr_context *ctx, struct pvr_draw_state *d,
                             (uint32_t *)(u + (sh->tex_dst[t] - sh->shared_dma_start) * 4)))
          return false;
    }
+   /* pco's literal pool: 32-bit literals the compiler put in the shared block after the registers
+    * the driver allocated (pvr_shader.h). The same DMA carries them to the shader. */
+   if (sh->literal_count)
+      memcpy(&((uint32_t *)u)[sh->literal_start - sh->shared_dma_start], sh->literal_vals,
+             sh->literal_count * sizeof(sh->literal_vals[0]));
 
    /* The descriptor program and its data segment. */
    din.buffer_count = 1;
@@ -1200,6 +1205,9 @@ draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bg
    pvr_csb_init(&csb, binding + 2 * ROGUE_NUM_TEXSTATE_DWORDS, ROGUE_NUM_TEXSTATE_DWORDS * 4, 0);
    if (!pvr_csb_emit_sampler_desc(&csb, &smp) || csb.overflowed)
       return false;
+   if (fs->literal_count)
+      memcpy(&u[fs->literal_start - fs->shared_dma_start], fs->literal_vals,
+             fs->literal_count * sizeof(fs->literal_vals[0]));
 
    struct pvr_pds_descriptor_program_input din = { .buffer_count = 1 };
    din.buffers[0] = (struct pvr_pds_buffer){
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.c b/src/gallium/drivers/pvr_native/pvr_shader.c
index 83f62d26..250087fb 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.c
+++ b/src/gallium/drivers/pvr_native/pvr_shader.c
@@ -9,10 +9,15 @@
 #include "pvr_pds.h"
 
 #include "stdlib.h"
+#include <string.h>
 
 #include "util/log.h"
 #include "util/format/u_format.h"
 
+/* The literal pool copied into struct pvr_shader must stay in sync with the compiler's array. */
+static_assert(PVR_SHADER_MAX_LITERALS == ARRAY_SIZE(((pco_common_data *)0)->literal_vals),
+              "PVR_SHADER_MAX_LITERALS must match pco_data.literal_vals[]");
+
 bool pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir,
                                     pco_data *data, pco_shader **shader_out,
                                     const void **data_out, unsigned *size_out);
@@ -363,12 +368,22 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_for
       data.fs.no_alpha_to_coverage = true;
       data.fs.skip_sample_check = true;
    }
+   /* Let pco pool the 32-bit immediates that are not hardware constant-register values into
+    * shared registers (pco_const_imms.c): each one would otherwise cost a whole instruction group
+    * to materialise per use. The pool is allocated after the shared registers pco allocated above,
+    * so the draw path's shared-block DMA can fill it (see shared_dma_start/dwords below). */
+   data.common.literal_pool = true;
    if (!pvr_shader_compile_data_with(ctx, nir, &data, vs_element_formats, &shader->pco,
                                      &shader->binary, &shader->binary_size)) {
       free(shader);
       return NULL;
    }
 
+   /* pco_trans_nir copies the caller's pco_data before the compiler passes run, so the final
+    * shared-register count and the literal pool only exist in the shader's own data. */
+   const pco_data *compiled = shader->pco != NULL ? pco_shader_data(shader->pco) : &data;
+   const pco_common_data *common = &compiled->common;
+
    /* The entry function is the first in the list; its temps are what the PDS kick program is built
     * from. The vtxin count is the driver-side attribute allocation: pco's register allocator
     * currently allocates no vtxins of its own (pco_ra.c has a FIXME that disables it) because the
@@ -378,17 +393,17 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_for
       struct _pco_func *entry = list_first_entry(&shader->pco->funcs, struct _pco_func, link);
 
       shader->temps = entry->temps;
-      shader->vtxins = data.common.vtxins;
+      shader->vtxins = common->vtxins;
    }
    shader->vtxouts = data.vs.vtxouts;
-   shader->uniform_dwords = data.common.push_consts.range.count;
-   shader->uniform_dst = data.common.push_consts.range.start;
+   shader->uniform_dwords = common->push_consts.range.count;
+   shader->uniform_dst = common->push_consts.range.start;
    shader->tex_mask = 0;
-   shader->shared_dma_start = data.common.shareds;
+   shader->shared_dma_start = common->shareds;
    if (shader->uniform_dwords)
       shader->shared_dma_start = shader->uniform_dst;
-   if (data.common.desc_sets[0].used) {
-      const pco_descriptor_set_data *set = &data.common.desc_sets[0];
+   if (common->desc_sets[0].used) {
+      const pco_descriptor_set_data *set = &common->desc_sets[0];
       for (unsigned u = 0; u < set->binding_count; u++) {
          if (!set->bindings[u].used)
             continue;
@@ -407,8 +422,18 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_for
          shader->shared_dma_start = MIN2(shader->shared_dma_start, shader->blend_dst);
       }
    }
-   shader->shared_dma_dwords = data.common.shareds - shader->shared_dma_start;
-   shader->shareds = data.common.shareds;
+   /* The literal pool sits inside the DMA'd shared block: its values travel with the uniforms. */
+   if (common->literals.count) {
+      assert(common->literals.count <= ARRAY_SIZE(shader->literal_vals));
+      shader->literal_start = common->literals.start;
+      shader->literal_count = common->literals.count;
+      memcpy(shader->literal_vals, common->literal_vals,
+             common->literals.count * sizeof(shader->literal_vals[0]));
+      shader->shared_dma_start = MIN2(shader->shared_dma_start, shader->literal_start);
+   }
+
+   shader->shared_dma_dwords = common->shareds - shader->shared_dma_start;
+   shader->shareds = common->shareds;
    if (nir->info.stage == MESA_SHADER_VERTEX) {
       for (unsigned l = 0; l < ARRAY_SIZE(shader->varyings); l++) {
          shader->varyings[l].start = data.vs.varyings[l].start;
@@ -434,8 +459,8 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_for
    }
 
    if (nir->info.stage == MESA_SHADER_FRAGMENT) {
-      shader->shareds = data.common.shareds;
-      shader->coeffs = data.common.coeffs;
+      shader->shareds = common->shareds;
+      shader->coeffs = common->coeffs;
       shader->phase_change = data.fs.uses.phase_change;
    }
 
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.h b/src/gallium/drivers/pvr_native/pvr_shader.h
index 7f8c348c..776e9376 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.h
+++ b/src/gallium/drivers/pvr_native/pvr_shader.h
@@ -52,6 +52,9 @@ pvr_pbe_output_dwords(enum pipe_format format)
 #define PVR_TEX_BINDING_DWORDS 16
 #define PVR_SHADER_MAX_TEX 16
 #define PVR_SHADER_MAX_VARIANTS 6
+/* Matches pco_data's literal_vals[] (pco_const_imms.c / pco_data.h): the compiler's literal pool
+ * holds at most 32 distinct 32-bit values. */
+#define PVR_SHADER_MAX_LITERALS 32
 
 struct pvr_shader {
    pco_shader *pco;
@@ -149,6 +152,15 @@ struct pvr_shader {
    unsigned shared_dma_start;
    unsigned shared_dma_dwords;
 
+   /* 32-bit literals pco pooled into shared registers (pco_const_imms.c): the draw path writes
+    * literal_vals into the shared block at (literal_start - shared_dma_start) alongside the
+    * uniforms, and the block's DMA and usc_shared_count cover them. The pool is only used when the
+    * driver's upload program can fill it, and it lives at the end of the shared registers pco
+    * allocated for this shader, so the range is always inside [shared_dma_start, shareds). */
+   unsigned literal_start;
+   unsigned literal_count;
+   uint32_t literal_vals[PVR_SHADER_MAX_LITERALS];
+
    /* Draw-path coefficient program of this fragment variant, for the vertex shader it was built
     * against (pvr_draw.c). */
    const struct pvr_shader *coeff_vs;
-- 
2.47.3

