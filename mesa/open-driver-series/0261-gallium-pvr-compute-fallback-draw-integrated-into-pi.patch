index 3fce7d04..577ab7f1 100644
--- a/src/gallium/drivers/pvr_native/meson.build
+++ b/src/gallium/drivers/pvr_native/meson.build
@@ -11,6 +11,7 @@ files_pvr = files(
   'pvr_resource.c',
   'pvr_shader.c',
