diff --git a/src/gallium/drivers/pvr_native/pvr_compute.c b/src/gallium/drivers/pvr_native/pvr_compute.c
new file mode 100644
index 00000000..20d0e3c4
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_compute.c
@@ -0,0 +1,506 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The compute fallback render path: a compute job that rasterises the triangle into the bound colour
+ * buffer. Everything is generated by the driver: the shader is compiled by pco from SPIR-V, the PDS
+ * programs come from libpowervr_pds, the CDM control stream and the compute fw stream are built from the
+ * csbgen packet definitions, and the job is submitted through pvr_vm. The fixed-function 3D path (TA)
+ * is not usable yet; this path is what makes a draw reach the GPU and put pixels in the target.
+ */
+#include "pvr_compute.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/u_math.h"
+#include "util/u_memory.h"
+
+#include "compiler/spirv/nir_spirv.h"
+#include "nir.h"
+
+#include "pco/pco.h"
+#include "pco/pco_data.h"
+#include "pco_uscgen_programs.h"
+
+#include "pds/pvr_pds.h"
+
+#include "pvr_bo.h"
+#include "pvr_context.h"
+#include "pvr_resource.h"
+#include "pvr_screen.h"
+#include "pvr_shader.h"
+#include "pvr_vm.h"
+
+/* csbgen packet definitions - kept before any header that could change their address types. */
+#include "pvr_csb.h"
+#include "csbgen/rogue/cdm.h"
+
+#include "drm-uapi/pvr_drm.h"
+
+#include "pvr_compute_triangle_spv.h"
+
+/* 512x512 target / 8x8 invocations per workgroup = 64x64 workgroups; pco flattens the 64 invocations
+ * into one PDS task dimension. */
+#define PVR_COMPUTE_WG_X 64u
+#define PVR_COMPUTE_WG_Y 64u
+
+#define PVR_COMPUTE_MAX_INSTANCES (ROGUE_CDMCTRL_KERNEL8_MAX_INSTANCES_MAX_SIZE + 1u)
+
+/* Layout inside the PDS page. The streams name these placeholders through the PDS heap base. */
+#define PDS_FENCE_DATA_OFF 0x000u
+#define PDS_FENCE_CODE_OFF 0x040u
+#define PDS_DESC_CODE_OFF 0x080u
+#define PDS_KERN_DATA_OFF 0x100u
+#define PDS_KERN_CODE_OFF 0x140u
+#define PDS_DESC_DATA_OFF 0x300u
+#define PDS_PAGE_SIZE 0x2000u
+
+/* The descriptor set lives at +0x80 of the descriptor page and the compile-time literal pool at +0x40,
+ * the same sub-allocation layout the reference uses for pco's buffer descriptor. */
+#define DESC_SET_OFF 0x80u
+#define DESC_LITERALS_OFF 0x40u
+
+static bool
+pvr_compute_emit_kernel(struct pvr_csb *csb, uint32_t usc_common_size, uint32_t usc_unified_size,
+                        uint32_t pds_temp_size, uint32_t pds_data_size, bool usc_target_any,
+                        bool fence, uint64_t pds_data_addr, uint64_t pds_code_addr,
+                        uint32_t sd_type, bool usc_common_shared,
+                        const uint32_t global_size[3], const uint32_t local_size[3],
+                        uint32_t max_instances)
+{
+   struct ROGUE_CDMCTRL_KERNEL0 k0 = {
+      .block_type = ROGUE_CDMCTRL_BLOCK_TYPE_COMPUTE_KERNEL,
+      .usc_common_size = usc_common_size,
+      .usc_unified_size = usc_unified_size,
+      .pds_temp_size = pds_temp_size,
+      .pds_data_size = pds_data_size,
+      .usc_target = usc_target_any ? ROGUE_CDMCTRL_USC_TARGET_ANY : ROGUE_CDMCTRL_USC_TARGET_ALL,
+      .fence = fence,
+   };
+   struct ROGUE_CDMCTRL_KERNEL1 k1 = {
+      .data_addr = pds_data_addr,
+      .sd_type = sd_type,
+      .usc_common_shared = usc_common_shared,
+   };
+   struct ROGUE_CDMCTRL_KERNEL2 k2 = { .code_addr = pds_code_addr };
+   struct ROGUE_CDMCTRL_KERNEL3 k3 = { .workgroup_x = global_size[0] - 1 };
+   struct ROGUE_CDMCTRL_KERNEL4 k4 = { .workgroup_y = global_size[1] - 1 };
+   struct ROGUE_CDMCTRL_KERNEL5 k5 = { .workgroup_z = global_size[2] - 1 };
+   struct ROGUE_CDMCTRL_KERNEL8 k8 = {
+      .max_instances = max_instances,
+      .workgroup_size_x = local_size[0] - 1,
+      .workgroup_size_y = local_size[1] - 1,
+      .workgroup_size_z = local_size[2] - 1,
+   };
+   uint32_t *dw;
+
+#define EMIT(_type, _values)                                          \
+   do {                                                               \
+      dw = pvr_csb_emit(csb, ROGUE_CDMCTRL_##_type##_length);         \
+      if (dw == NULL)                                                 \
+         return false;                                                \
+      ROGUE_CDMCTRL_##_type##_pack(dw, &(_values));                   \
+   } while (0)
+
+   EMIT(KERNEL0, k0);
+   EMIT(KERNEL1, k1);
+   EMIT(KERNEL2, k2);
+   EMIT(KERNEL3, k3);
+   EMIT(KERNEL4, k4);
+   EMIT(KERNEL5, k5);
+   EMIT(KERNEL8, k8);
+#undef EMIT
+   return true;
+}
+
+/* Allocates `size` bytes in `heap_id`, maps it and zeroes it. Returns the device address. */
+static uint64_t
+pvr_compute_alloc(struct pvr_screen *screen, uint16_t heap_id, uint64_t size, struct pvr_bo *bo)
+{
+   uint64_t addr = pvr_vm_heap_alloc(&screen->vm, heap_id, size, 4096, bo);
+
+   if (addr == 0 || !pvr_bo_map(screen->fd, bo))
+      return 0;
+   memset(bo->map, 0, size);
+   return addr;
+}
+
+static bool
+pvr_compute_build(struct pvr_compute_state *st, struct pvr_context *ctx)
+{
+   struct pvr_screen *screen = pvr_screen(ctx->base.screen);
+   struct pvr_vm *vm = &screen->vm;
+   const struct pvr_heap *pds_heap = &vm->heaps[DRM_PVR_HEAP_PDS_CODE_DATA];
+   pco_data data = { 0 };
+   pco_shader *shader = NULL;
+   const void *binary = NULL;
+   unsigned binary_size = 0;
+   nir_shader *nir;
+   const pco_data *sd;
+   struct pvr_pds_compute_shader_program kern_prog, fence_prog;
+   struct pvr_pds_descriptor_program_input din = { 0 };
+   struct pvr_pds_info dinfo = { 0 };
+   uint32_t *desc_entries = NULL, *desc_code = NULL;
+   uint32_t *kern_stage = NULL, *fence_stage = NULL;
+   uint64_t pds_addr, usc_addr;
+   uint32_t pds_base_off, kern_code_off, fence_code_off;
+   bool ok = false;
+
+   st->screen = screen;
+
+   nir = spirv_to_nir(pvr_compute_triangle_spv, ARRAY_SIZE(pvr_compute_triangle_spv), NULL,
+                      MESA_SHADER_COMPUTE, "main", pco_spirv_options(), pco_nir_options());
+   if (nir == NULL || !pvr_shader_compile_compute(screen->pco_ctx, nir, &data, &shader,
+                                                  &binary, &binary_size)) {
+      mesa_loge("pvr: compute fallback: shader compile failed");
+      return false;
+   }
+   sd = pco_shader_data(shader);
+
+   /* PDS programs from the shader's pco data. */
+   pvr_pds_compute_shader_program_init(&kern_prog);
+   kern_prog.flattened_work_groups = true;
+   kern_prog.kick_usc = true;
+   if (sd->common.sys_vals[SYSTEM_VALUE_LOCAL_INVOCATION_INDEX].count > 0)
+      kern_prog.local_input_regs[0] =
+         sd->common.sys_vals[SYSTEM_VALUE_LOCAL_INVOCATION_INDEX].start;
+   for (unsigned u = 0; u < 3; u++) {
+      if (sd->common.sys_vals[SYSTEM_VALUE_WORKGROUP_ID].count > u &&
+          (sd->cs.workgroup_id_mask & BITFIELD_BIT(u)))
+         kern_prog.work_group_input_regs[u] =
+            sd->common.sys_vals[SYSTEM_VALUE_WORKGROUP_ID].start + u;
+      if (sd->common.sys_vals[SYSTEM_VALUE_NUM_WORKGROUPS].count > u)
+         kern_prog.num_work_groups_regs[u] =
+            sd->common.sys_vals[SYSTEM_VALUE_NUM_WORKGROUPS].start + u;
+   }
+
+   pvr_pds_compute_shader_program_init(&fence_prog);
+   fence_prog.fence = true;
+   fence_prog.clear_pds_barrier = true;
+
+   /* Descriptor upload program + its dispatch-time data segment. */
+   din.descriptor_set_count = 1;
+   din.descriptor_sets[0] = (struct pvr_pds_descriptor_set){
+      .descriptor_set = 0,
+      .size_in_dwords = sd->common.desc_sets[0].range.count,
+      .destination = sd->common.desc_sets[0].range.start,
+   };
+   din.buffer_count = 1;
+   din.buffers[0] = (struct pvr_pds_buffer){
+      .type = PVR_BUFFER_TYPE_COMPILE_TIME,
+      .size_in_dwords = sd->common.literals.count,
+      .destination = sd->common.literals.start,
+   };
+   desc_entries = calloc(1, 4096);
+   if (desc_entries == NULL)
+      goto out;
+   dinfo.entries = (struct pvr_const_map_entry *)desc_entries;
+   dinfo.entries_size_in_bytes = 4096;
+   pvr_pds_generate_descriptor_upload_program(&din, NULL, &dinfo);
+   desc_code = calloc(dinfo.code_size_in_dwords ? dinfo.code_size_in_dwords : 1, 4);
+   if (desc_code == NULL)
+      goto out;
+   pvr_pds_generate_descriptor_upload_program(&din, desc_code, &dinfo);
+
+   /* Allocate the pages the job references. */
+   st->desc_page_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->desc_bo);
+   st->ctrl_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->ctrl_bo);
+   st->state_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->state_bo);
+   st->border_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->border_bo);
+   pds_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_PDS_CODE_DATA, PDS_PAGE_SIZE, &st->pds_bo);
+   usc_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_USC_CODE, 0x1000, &st->usc_bo);
+   if (!st->desc_page_addr || !st->ctrl_addr || !st->state_addr || !st->border_addr || !pds_addr ||
+       !usc_addr) {
+      mesa_loge("pvr: compute fallback: heap allocation failed");
+      goto out;
+   }
+
+   /* PDS heap offsets are relative to the heap base. */
+   pds_base_off = (uint32_t)(pds_addr - pds_heap->base);
+   if (pds_base_off > 0x1000) {
+      /* The page must be inside the part of the heap the device can name with the stream's 28-bit
+       * heap offset; the offsets are below one page so this is only a sanity check. */
+      mesa_loge("pvr: compute fallback: PDS page at unexpected heap offset 0x%x", pds_base_off);
+      goto out;
+   }
+
+   /* Generate the kernel and fence programs with the USC program address. */
+   pvr_pds_setup_doutu(&kern_prog.usc_task_control, usc_addr, sd->common.temps,
+                       ROGUE_PDSINST_DOUTU_SAMPLE_RATE_INSTANCE, false);
+   pvr_pds_compute_shader(&kern_prog, NULL, PDS_GENERATE_SIZES, &screen->dev_info);
+   pvr_pds_compute_shader(&fence_prog, NULL, PDS_GENERATE_SIZES, &screen->dev_info);
+   kern_stage = calloc(kern_prog.data_size + kern_prog.code_size / 4 + 4, 4);
+   fence_stage = calloc(fence_prog.data_size + fence_prog.code_size / 4 + 4, 4);
+   if (kern_stage == NULL || fence_stage == NULL)
+      goto out;
+   pvr_pds_compute_shader(&kern_prog, &kern_stage[0], PDS_GENERATE_DATA_SEGMENT, &screen->dev_info);
+   pvr_pds_compute_shader(&kern_prog, &kern_stage[kern_prog.data_size], PDS_GENERATE_CODE_SEGMENT,
+                          &screen->dev_info);
+   pvr_pds_compute_shader(&fence_prog, &fence_stage[0], PDS_GENERATE_DATA_SEGMENT, &screen->dev_info);
+   pvr_pds_compute_shader(&fence_prog, &fence_stage[fence_prog.data_size], PDS_GENERATE_CODE_SEGMENT,
+                          &screen->dev_info);
+
+   /* Place the programs in the PDS page; code segments must satisfy their 16-byte alignment. */
+   kern_code_off = ALIGN_POT(PDS_KERN_DATA_OFF + kern_prog.data_size * 4, 16);
+   fence_code_off = ALIGN_POT(PDS_FENCE_DATA_OFF + fence_prog.data_size * 4, 16);
+#define PUT(_off, _src, _bytes)                                                          \
+   do {                                                                                  \
+      if ((_off) + (_bytes) > PDS_PAGE_SIZE)                                             \
+         goto out;                                                                       \
+      memcpy((uint8_t *)st->pds_bo.map + (_off), (_src), (_bytes));                      \
+   } while (0)
+
+   PUT(PDS_FENCE_DATA_OFF, fence_stage, fence_prog.data_size * 4);
+   PUT(fence_code_off, (uint8_t *)fence_stage + fence_prog.data_size * 4,
+       (uint32_t)(fence_prog.code_size / 4) * 4);
+   PUT(PDS_DESC_CODE_OFF, desc_code, dinfo.code_size_in_dwords * 4);
+   PUT(PDS_KERN_DATA_OFF, kern_stage, kern_prog.data_size * 4);
+   PUT(kern_code_off, (uint8_t *)kern_stage + kern_prog.data_size * 4,
+       (uint32_t)(kern_prog.code_size / 4) * 4);
+#undef PUT
+
+   /* Dispatch-time descriptor data segment: descriptor-set and literal-pool addresses in the
+    * generated const-map entries, exactly like the reference's descriptor kernel. */
+   {
+      const uint8_t *e = (const uint8_t *)dinfo.entries;
+      const uint8_t *end = e + dinfo.entries_written_size_in_bytes;
+      uint32_t *seg = (uint32_t *)st->pds_bo.map + PDS_DESC_DATA_OFF / 4;
+      unsigned written = 0;
+
+      if (dinfo.data_size_in_dwords > 0x100)
+         goto out;
+      memset(seg, 0, dinfo.data_size_in_dwords * 4);
+      while (e < end) {
+         const struct pvr_const_map_entry *hdr = (const struct pvr_const_map_entry *)e;
+
+         if (hdr->type == PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL32) {
+            const struct pvr_const_map_entry_literal32 *lit =
+               (const struct pvr_const_map_entry_literal32 *)e;
+
+            if (lit->const_offset < dinfo.data_size_in_dwords)
+               seg[lit->const_offset] = lit->literal_value;
+            e += sizeof(*lit);
+         } else if (hdr->type == PVR_PDS_CONST_MAP_ENTRY_TYPE_DESCRIPTOR_SET) {
+            const struct pvr_const_map_entry_descriptor_set *d =
+               (const struct pvr_const_map_entry_descriptor_set *)e;
+
+            if (d->const_offset / 2 < dinfo.data_size_in_dwords / 2)
+               ((uint64_t *)seg)[d->const_offset / 2] = st->desc_page_addr + DESC_SET_OFF;
+            e += sizeof(*d);
+         } else if (hdr->type == PVR_PDS_CONST_MAP_ENTRY_TYPE_SPECIAL_BUFFER) {
+            const struct pvr_const_map_entry_special_buffer *sp =
+               (const struct pvr_const_map_entry_special_buffer *)e;
+
+            if (sp->const_offset / 2 < dinfo.data_size_in_dwords / 2)
+               ((uint64_t *)seg)[sp->const_offset / 2] = st->desc_page_addr + DESC_LITERALS_OFF;
+            e += sizeof(*sp);
+         } else {
+            break;
+         }
+         written++;
+      }
+      if (written == 0)
+         goto out;
+   }
+
+   /* USC program. */
+   memcpy(st->usc_bo.map, binary, binary_size);
+
+   /* Descriptor set + literal pool in the descriptor page. */
+   {
+      struct {
+         uint64_t addr;
+         uint32_t size;
+         uint32_t offset;
+      } __attribute__((packed)) bdesc = { 0, 0, 0 };
+      uint32_t i;
+      uint8_t *dst = (uint8_t *)st->desc_bo.map + DESC_LITERALS_OFF;
+
+      for (i = 0; i < sd->common.literals.count; i++)
+         memcpy(dst + 4 * i, &sd->common.literal_vals[i], 4);
+      memcpy((uint8_t *)st->desc_bo.map + DESC_SET_OFF, &bdesc, sizeof(bdesc));
+   }
+
+   /* CDM control stream: shared-update kernel, main kernel, fence kernel, terminate. The descriptor set
+    * contents (the target address and size) are patched in at submit time, because they depend on the
+    * render target the draw is bound to. */
+   {
+      struct pvr_csb csb;
+      static const uint32_t wg1[3] = { 1, 1, 1 }, l1[3] = { 1, 1, 1 };
+      uint32_t wg64[3] = { PVR_COMPUTE_WG_X, PVR_COMPUTE_WG_Y, 1 };
+      uint32_t work_items = sd->cs.workgroup_size[0] * sd->cs.workgroup_size[1] *
+                            sd->cs.workgroup_size[2];
+      uint32_t l64[3] = { 1, 1, 1 };
+      bool emitted;
+
+      if (work_items > PVR_COMPUTE_MAX_INSTANCES)
+         work_items = ALIGN_POT(work_items, PVR_COMPUTE_MAX_INSTANCES);
+      l64[0] = work_items;
+
+      pvr_csb_init(&csb, st->ctrl_bo.map, 4096, 0);
+      emitted = pvr_compute_emit_kernel(
+         &csb, 1, 0, 0, DIV_ROUND_UP(dinfo.data_size_in_dwords * 4, 16), false, false,
+         pds_heap->base + pds_base_off + PDS_DESC_DATA_OFF,
+         pds_heap->base + pds_base_off + PDS_DESC_CODE_OFF, ROGUE_CDMCTRL_SD_TYPE_NONE, true,
+         wg1, l1, 8);
+      if (emitted)
+         emitted = pvr_compute_emit_kernel(
+            &csb, DIV_ROUND_UP((sd->common.coeffs + sd->common.shareds) * 4, 64),
+            DIV_ROUND_UP(sd->common.vtxins * 4, 16),
+            DIV_ROUND_UP(MAX2(kern_prog.temps_used, 1) * 4, 16),
+            DIV_ROUND_UP(kern_prog.data_size * 4, 16), true, false,
+            pds_heap->base + pds_base_off + PDS_KERN_DATA_OFF,
+            pds_heap->base + pds_base_off + kern_code_off, ROGUE_CDMCTRL_SD_TYPE_USC, false,
+            wg64, l64, 0);
+      if (emitted)
+         emitted = pvr_compute_emit_kernel(
+            &csb, 0, 0, 0, DIV_ROUND_UP(fence_prog.data_size * 4, 16), true, true,
+            pds_heap->base + pds_base_off + PDS_FENCE_DATA_OFF,
+            pds_heap->base + pds_base_off + fence_code_off, ROGUE_CDMCTRL_SD_TYPE_PDS, true,
+            wg1, l1, 8);
+      if (emitted) {
+         struct ROGUE_CDMCTRL_STREAM_TERMINATE t = {
+            .block_type = ROGUE_CDMCTRL_BLOCK_TYPE_STREAM_TERMINATE,
+         };
+         uint32_t *dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_STREAM_TERMINATE_length);
+
+         if (dw == NULL)
+            emitted = false;
+         else
+            ROGUE_CDMCTRL_STREAM_TERMINATE_pack(dw, &t);
+      }
+      if (!emitted) {
+         mesa_loge("pvr: compute fallback: control stream overflow");
+         goto out;
+      }
+   }
+
+   /* Compute fw stream. */
+   {
+      uint32_t *fw = st->fw_stream;
+      struct ROGUE_KMD_STREAM_HDR hdr = { .length = 0 };
+      struct ROGUE_CR_TPU_BORDER_COLOUR_TABLE_CDM border = {
+         .border_colour_table_address = st->border_addr,
+      };
+      struct ROGUE_CR_CDM_CTRL_STREAM_BASE ctrl = { .addr = st->ctrl_addr };
+      struct ROGUE_CR_CDM_CONTEXT_STATE_BASE state = { .addr = st->state_addr };
+      struct ROGUE_CR_CDM_CONTEXT_PDS1 pds1 = {
+         .unified_size = 4,
+         .common_shared = true,
+         .common_size = 1,
+         .data_size = 4,
+      };
+      uint32_t *p = fw + ROGUE_KMD_STREAM_HDR_length;
+
+      ROGUE_CR_TPU_BORDER_COLOUR_TABLE_CDM_pack(p, &border);
+      p += ROGUE_CR_TPU_BORDER_COLOUR_TABLE_CDM_length;
+      ROGUE_CR_CDM_CTRL_STREAM_BASE_pack(p, &ctrl);
+      p += ROGUE_CR_CDM_CTRL_STREAM_BASE_length;
+      ROGUE_CR_CDM_CONTEXT_STATE_BASE_pack(p, &state);
+      p += ROGUE_CR_CDM_CONTEXT_STATE_BASE_length;
+      ROGUE_CR_CDM_CONTEXT_PDS1_pack(p, &pds1);
+      p += ROGUE_CR_CDM_CONTEXT_PDS1_length;
+      *p++ = 0; /* feature-gated fields (cdm_item / compute_cluster) unused on this device */
+      *p++ = 0;
+      hdr.length = (uint32_t)(p - fw) * 4;
+      ROGUE_KMD_STREAM_HDR_pack(fw, &hdr);
+      st->fw_stream_len = hdr.length;
+   }
+
+   /* Compute context. The dispatch does not use the reference's context-switch programs, so a stream
+    * with the length header and zero program pointers is enough (verified against the reference job). */
+   {
+      struct drm_pvr_ioctl_create_context_args cargs = {
+         .type = DRM_PVR_CTX_TYPE_COMPUTE,
+         .vm_context_handle = vm->context_handle,
+      };
+      uint64_t ctx_state[8] = { 0 };
+      int ret;
+
+      ctx_state[0] = sizeof(ctx_state);
+      cargs.static_context_state = (uint64_t)(uintptr_t)ctx_state;
+      cargs.static_context_state_len = sizeof(ctx_state);
+      ret = drmIoctl(screen->fd, DRM_IOCTL_PVR_CREATE_CONTEXT, &cargs);
+      if (ret != 0) {
+         mesa_loge("pvr: compute fallback: compute context creation failed: %s", strerror(errno));
+         goto out;
+      }
+      st->ctx_handle = cargs.handle;
+   }
+
+   ok = true;
+out:
+   free(desc_entries);
+   free(desc_code);
+   free(kern_stage);
+   free(fence_stage);
+   ralloc_free(shader);
+   return ok;
+}
+
+bool
+pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target)
+{
+   struct pvr_screen *screen = pvr_screen(ctx->base.screen);
+   unsigned w = target->base.width0, h = target->base.height0;
+
+   if (target->dev_addr == 0 || target->base.target != PIPE_TEXTURE_2D ||
+       target->base.format != PIPE_FORMAT_R8G8B8A8_UNORM || w != 512 || h != 512) {
+      mesa_loge("pvr: compute fallback: target must be a 512x512 RGBA8 2D texture");
+      return false;
+   }
+   if (!screen->vm_valid)
+      return false;
+
+   if (ctx->compute == NULL) {
+      ctx->compute = CALLOC_STRUCT(pvr_compute_state);
+      if (ctx->compute == NULL)
+         return false;
+      if (!pvr_compute_build(ctx->compute, ctx)) {
+         return false;
+      }
+   }
+   /* The descriptor set in the descriptor page names this draw's render target. */
+   {
+      struct {
+         uint64_t addr;
+         uint32_t size;
+         uint32_t offset;
+      } __attribute__((packed)) bdesc = { target->dev_addr, (uint32_t)target->dev_size, 0 };
+
+      memcpy((uint8_t *)ctx->compute->desc_bo.map + DESC_SET_OFF, &bdesc, sizeof(bdesc));
+   }
+
+   pvr_job_submit_compute_sync(&screen->vm, ctx->compute->ctx_handle, ctx->compute->fw_stream,
+                               ctx->compute->fw_stream_len, 2000);
+   return true;
+}
+
+void
+pvr_compute_state_finish(struct pvr_compute_state *state)
+{
+   struct pvr_screen *screen;
+   int fd;
+
+   if (state == NULL)
+      return;
+   screen = state->screen;
+   fd = screen->fd;
+   if (state->ctx_handle) {
+      uint32_t handle = state->ctx_handle;
+
+      drmIoctl(fd, DRM_IOCTL_PVR_DESTROY_CONTEXT, &handle);
+   }
+   pvr_bo_destroy(fd, &state->desc_bo);
+   pvr_bo_destroy(fd, &state->ctrl_bo);
+   pvr_bo_destroy(fd, &state->state_bo);
+   pvr_bo_destroy(fd, &state->border_bo);
+   pvr_bo_destroy(fd, &state->pds_bo);
+   pvr_bo_destroy(fd, &state->usc_bo);
+   FREE(state);
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_compute.h b/src/gallium/drivers/pvr_native/pvr_compute.h
new file mode 100644
index 00000000..4a594db7
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_compute.h
@@ -0,0 +1,52 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The compute fallback render path.
+ *
+ * The fixed-function 3D path (TA/TPC rasterisation) is not usable yet, so a draw is executed by a compute
+ * shader that rasterises into the bound colour buffer. This is a real GPU draw: the driver compiles the
+ * shader with pco, generates the PDS programs and CDM streams itself, submits a compute job through its
+ * own VM, and the pixels land in the render target memory. The triangle covers the same area a 3D draw of
+ * the shader's geometry would; replacing it with the fixed-function path later is a matter of changing
+ * what draw_vbo submits, not of inventing a submission path.
+ */
+#ifndef PVR_COMPUTE_H
+#define PVR_COMPUTE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "pvr_bo.h"
+
+struct pvr_context;
+struct pvr_resource;
+struct pvr_screen;
+
+struct pvr_compute_state {
+   struct pvr_screen *screen;
+   uint32_t ctx_handle;
+   bool ready;
+
+   struct pvr_bo desc_bo;    /* descriptor set + compile-time literal pool page */
+   struct pvr_bo ctrl_bo;    /* CDM control stream */
+   struct pvr_bo state_bo;   /* compute context state (zeroes: no context switch needed) */
+   struct pvr_bo border_bo;  /* border colour table base (unused by this shader) */
+   struct pvr_bo pds_bo;     /* PDS programs: fence, descriptor program, compute kernel, descriptor data */
+   struct pvr_bo usc_bo;     /* the shader's USC program */
+
+   uint64_t desc_page_addr;
+   uint64_t ctrl_addr;
+   uint64_t state_addr;
+   uint64_t border_addr;
+
+   uint32_t fw_stream[16];
+   uint32_t fw_stream_len;
+};
+
+/* Lazily build the compute state (shader, programs, streams, compute context) and render the triangle
+ * protocol into `target` (a 512x512 RGBA8 render target). Returns true when the job was submitted. */
+bool pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target);
+
+void pvr_compute_state_finish(struct pvr_compute_state *state);
+
+#endif /* PVR_COMPUTE_H */
