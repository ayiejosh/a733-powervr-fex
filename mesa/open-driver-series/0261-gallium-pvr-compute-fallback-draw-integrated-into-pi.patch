diff --git a/src/gallium/drivers/pvr_native/pvr_probe.c b/src/gallium/drivers/pvr_native/pvr_probe.c
index 10e692a2..b4a1046b 100644
--- a/src/gallium/drivers/pvr_native/pvr_probe.c
+++ b/src/gallium/drivers/pvr_native/pvr_probe.c
@@ -4393,6 +4393,104 @@ cdm_compile_check(struct pipe_screen *pscreen)
 }
 
 
+
+/* Exercises the driver's own draw path through the pipe_context API with the compute fallback: create a
+ * context, bind a 512x512 RGBA8 render target, issue a draw, and read the pixels back. This is the
+ * end-to-end driver path - no captured reference data and no direct job submission from the probe. */
+static bool
+compute_draw_check(struct pipe_screen *screen)
+{
+   struct pvr_screen *scr = pvr_screen(screen);
+   struct pipe_context *pctx;
+   struct pipe_resource templ = { 0 };
+   struct pipe_resource *res;
+   struct pvr_resource *rt;
+   struct pipe_framebuffer_state fb = { 0 };
+   struct pipe_draw_info info = { 0 };
+   struct pipe_draw_start_count_bias draw = { 0 };
+   uint32_t *px;
+   unsigned waited_us = 0;
+   uint32_t inside = 0, outside = 0;
+   bool ok = false;
+
+   if (!scr->vm_valid) {
+      printf("draw:          SKIP (no GPU VM; shim run)\n");
+      return true;
+   }
+
+   pctx = screen->context_create(screen, NULL, 0);
+   if (pctx == NULL) {
+      printf("draw:          FAIL: pipe_context creation\n");
+      return false;
+   }
+
+   templ.target = PIPE_TEXTURE_2D;
+   templ.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+   templ.width0 = 512;
+   templ.height0 = 512;
+   templ.depth0 = 1;
+   templ.array_size = 1;
+   templ.last_level = 0;
+   templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+   res = screen->resource_create(screen, &templ);
+   if (res == NULL) {
+      printf("draw:          FAIL: render-target creation\n");
+      pctx->destroy(pctx);
+      return false;
+   }
+   rt = pvr_resource(res);
+   if (rt->dev_addr == 0 || !pvr_bo_map(scr->fd, &rt->bo)) {
+      printf("draw:          FAIL: render target is not GPU addressable\n");
+      goto out_res;
+   }
+   memset(rt->bo.map, 0, rt->bo.size);
+
+   fb.width = 512;
+   fb.height = 512;
+   fb.nr_cbufs = 1;
+   fb.cbufs[0].texture = res;
+   pctx->set_framebuffer_state(pctx, &fb);
+
+   info.mode = MESA_PRIM_TRIANGLES;
+   info.instance_count = 1;
+   draw.start = 0;
+   draw.count = 3;
+   pctx->draw_vbo(pctx, &info, 0, NULL, &draw, 1);
+
+   px = rt->bo.map;
+   while (waited_us < 3000000) {
+      uint32_t i;
+
+      inside = outside = 0;
+      for (i = 0; i < 512 * 512; i++) {
+         if (px[i] == 0xFF0000FFu)
+            inside++;
+         else if (px[i] == 0xFFFF0000u)
+            outside++;
+      }
+      if (inside > 1000 && outside > 1000)
+         break;
+      usleep(1000);
+      waited_us += 1000;
+   }
+   printf("draw:           pipe_context draw -> readback inside=%u outside=%u (waited %u us) "
+          "center=0x%08x corner=0x%08x\n", inside, outside, waited_us,
+          px[200 * 512 + 256], px[10 * 512 + 10]);
+   ok = inside > 1000 && outside > 1000;
+   if (pvr_context(pctx)->draws_executed == 0) {
+      printf("draw:          FAIL: the draw did not reach the driver's execution path\n");
+      ok = false;
+   }
+   printf("draw:          %s (driver draw path via compute fallback, %u draws executed)\n",
+          ok ? "PASS" : "FAIL", pvr_context(pctx)->draws_executed);
+
+out_res:
+   pctx->set_framebuffer_state(pctx, &(struct pipe_framebuffer_state){ 0 });
+   pctx->destroy(pctx);
+   screen->resource_destroy(screen, res);
+   return ok;
+}
+
 static void *cdm_map_at(int fd, struct pvr_vm *vm, uint64_t addr, uint64_t size, struct pvr_bo *bo);
 static uint8_t *cdm_read_capture(const char *dir, const char *name, uint32_t *size_out);
 
@@ -5425,6 +5523,8 @@ main(int argc, char **argv)
       cdm_compile_check(screen);
    if (getenv("PVR_PROBE_CDM_NATIVE"))
       cdm_native_draw_check(fd, screen);
+   const bool compute_draw_pass =
+      getenv("PVR_PROBE_COMPUTE_DRAW") ? compute_draw_check(screen) : true;
    const bool cdm_pass = getenv("PVR_PROBE_CDM_DIR") ? cdm_draw_check(fd, screen) : true;
    const bool tq_pass = getenv("PVR_PROBE_TQ_STREAM") ? tq_fill_check(fd, screen) : true;
 
@@ -5448,7 +5548,7 @@ main(int argc, char **argv)
 
    const bool all = enum_pass && bo_pass && vm_pass && res_pass && ctx_pass &&
                     shader_pass && state_pass && fb_pass && pipe_pass && csb_pass &&
-                    clear_pass && tq_pass && cdm_pass;
+                    clear_pass && tq_pass && cdm_pass && compute_draw_pass;
    printf("--- %s\n", all ? "ALL PASS" : "FAILURES ABOVE");
    return all ? 0 : 1;
 }
