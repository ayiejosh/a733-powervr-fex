@@ -170,6 +176,47 @@ pvr_screen_create(int fd, const struct pipe_screen_config *config,
       caps->device_id = ident->device_id;
    }
 
+   /* Runtime info: free-list sizing and the shader limits, which pco needs before it
+    * can be created. Same dev-queries and the same translation the Vulkan driver
+    * performs (winsys/powervr/pvr_drm.c). */
+   {
+      struct drm_pvr_dev_query_runtime_info kmd = { 0 };
+      struct drm_pvr_ioctl_dev_query_args rt_args = {
+         .type = DRM_PVR_DEV_QUERY_RUNTIME_INFO_GET,
+         .size = sizeof(kmd),
+         .pointer = (__u64)&kmd,
+      };
+
+      if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &rt_args) == 0) {
+         screen->dev_runtime_info.min_free_list_size =
+            (uint64_t)kmd.free_list_min_pages << ROGUE_BIF_PM_PHYSICAL_PAGE_SHIFT;
+         screen->dev_runtime_info.max_free_list_size =
+            (uint64_t)kmd.free_list_max_pages << ROGUE_BIF_PM_PHYSICAL_PAGE_SHIFT;
+         screen->dev_runtime_info.reserved_shared_size =
+            kmd.common_store_alloc_region_size;
+         screen->dev_runtime_info.total_reserved_partition_size =
+            kmd.common_store_partition_space_size;
+         screen->dev_runtime_info.max_coeffs = kmd.max_coeffs;
+         screen->dev_runtime_info.cdm_max_local_mem_size_regs =
+            kmd.cdm_max_local_mem_size_regs;
+
+         /* The kernel has no core-count query yet; the Vulkan driver also pins this to
+          * 1 with a finishme, and matching that is more honest than inventing one. */
+         screen->dev_runtime_info.core_count = 1;
+         screen->dev_runtime_info.num_phantoms = screen->num_phantoms;
+      } else {
+         mesa_logi("pvr: runtime info query failed; the compiler will not be created");
+      }
+   }
+
+   /* The compiler. pco_ctx_create needs the device and runtime info; the USC library
+    * is a blob generated at build time from the OpenCL sources in pco/usclib. */
+   screen->pco_ctx = pco_ctx_create(&screen->dev_info, &screen->dev_runtime_info, NULL);
+   if (screen->pco_ctx != NULL)
+      pco_ctx_setup_usclib(screen->pco_ctx, pco_usclib_0_nir, sizeof(pco_usclib_0_nir));
+   else
+      mesa_logi("pvr: could not create the pco compiler context");
+
    /* GPU address space. Failure here is not fatal to enumeration - it only means no
     * resource can be created, which is worth being able to see when probing a node
     * this driver cannot actually drive. */
