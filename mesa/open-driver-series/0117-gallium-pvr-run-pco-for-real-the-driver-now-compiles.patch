+/* Run the linked compiler over a shader and check it produces code. This is the whole
+ * point of having linked pco rather than written one: the driver must be able to get
+ * a NIR shader through it and out as an encoded binary. */
+static bool
+shader_compile_check(struct pipe_screen *pscreen)
+{
+   struct pvr_screen *screen = pvr_screen(pscreen);
+   pco_shader *shader = NULL;
+   const void *binary = NULL;
+   unsigned size = 0;
+   nir_builder b;
+   bool ok;
+
+   printf("runtime:       free list %" PRIu64 "..%" PRIu64 " bytes, shared %" PRIu64
+          ", coeffs %" PRIu64 ", phantoms %" PRIu64 ", cores %u\n",
+          screen->dev_runtime_info.min_free_list_size,
+          screen->dev_runtime_info.max_free_list_size,
+          screen->dev_runtime_info.reserved_shared_size,
+          screen->dev_runtime_info.max_coeffs,
+          screen->dev_runtime_info.num_phantoms,
+          screen->dev_runtime_info.core_count);
+
+   if (screen->pco_ctx == NULL) {
+      printf("shader:        FAIL: no pco context - the runtime info query must have failed\n");
+      return false;
+   }
+
+   /* The smallest fragment shader that goes through the real pipeline: pco's own
+    * passthrough shape, which stores a dummy value. */
+   b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(),
+                                      "pvr_check_fs");
+   b.shader->info.internal = false;
+   nir_frag_store_pco(&b, nir_imm_int(&b, 0), .base = 0);
+   nir_jump(&b, nir_jump_return);
+
+   if (!pvr_shader_compile(screen->pco_ctx, b.shader, &shader, &binary, &size)) {
+      printf("shader:        FAIL: pco produced no code\n");
+      ralloc_free(b.shader);
+      return false;
+   }
+
+   ok = binary != NULL && size > 0;
+
+   printf("shader:        pco encoded %u bytes of USC for a fragment shader\n", size);
+
+   /* A single non-zero number could be a constant. Compile a shader that does strictly
+    * more work and require strictly more code: that is the difference between "the
+    * compiler ran" and "something returned a plausible integer". */
+   {
+      pco_shader *bigger = NULL;
+      const void *bigger_bin = NULL;
+      unsigned bigger_size = 0;
+      nir_builder b2 = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT,
+                                                      pco_nir_options(),
+                                                      "pvr_check_fs_two_stores");
+      b2.shader->info.internal = false;
+      nir_frag_store_pco(&b2, nir_imm_int(&b2, 0), .base = 0);
+      nir_frag_store_pco(&b2, nir_imm_int(&b2, 0), .base = 1);
+      nir_frag_store_pco(&b2, nir_imm_int(&b2, 0), .base = 2);
+      nir_jump(&b2, nir_jump_return);
+
+      if (!pvr_shader_compile(screen->pco_ctx, b2.shader, &bigger, &bigger_bin,
+                              &bigger_size)) {
+         printf("shader:        FAIL: the second shader produced no code\n");
+         ralloc_free(b.shader);
+         return false;
+      }
+
+      printf("shader:        a three-store shader encodes %u bytes (vs %u)\n",
+             bigger_size, size);
+
+      if (bigger_size <= size) {
+         printf("shader:        FAIL: more work did not produce more code - the size is\n"
+                "               not being derived from the shader\n");
+         ralloc_free(bigger);
+         ralloc_free(b.shader);
+         return false;
+      }
+
+      ralloc_free(bigger);
+   }
+   printf("shader:        %s (nir -> pco pipeline -> encoded binary)\n",
+          ok ? "PASS" : "FAIL");
+
+   ralloc_free(shader);
+   return ok;
+}
+
 int
 main(int argc, char **argv)
 {
@@ -392,10 +484,11 @@ main(int argc, char **argv)
    const bool vm_pass = vm_roundtrip(fd);
    const bool res_pass = resource_roundtrip(screen);
    const bool ctx_pass = transfer_roundtrip(screen);
+   const bool shader_pass = shader_compile_check(screen);
 
    screen->destroy(screen);
 
-   const bool all = enum_pass && bo_pass && vm_pass && res_pass && ctx_pass;
+   const bool all = enum_pass && bo_pass && vm_pass && res_pass && ctx_pass && shader_pass;
    printf("--- %s\n", all ? "ALL PASS" : "FAILURES ABOVE");
    return all ? 0 : 1;
 }
