diff --git a/src/gallium/drivers/pvr/pvr_shader.c b/src/gallium/drivers/pvr/pvr_shader.c
new file mode 100644
index 00000000..59e9dd2a
--- /dev/null
+++ b/src/gallium/drivers/pvr/pvr_shader.c
@@ -0,0 +1,49 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#include "pvr_shader.h"
+
+#include "pco/pco_data.h"
+
+#include "util/log.h"
+
+bool
+pvr_shader_compile(pco_ctx *ctx, struct nir_shader *nir, pco_shader **shader_out,
+                   const void **data_out, unsigned *size_out)
+{
+   pco_data data = { 0 };
+   pco_shader *shader;
+   unsigned size;
+
+   if (ctx == NULL) {
+      mesa_loge("pvr: no pco context; the compiler was never initialised");
+      return false;
+   }
+
+   /* Order matters and is copied from the Vulkan driver's build_shader(). Getting it
+    * wrong yields a plausible binary rather than an error. */
+   pco_preprocess_nir(ctx, nir, &data);
+   pco_lower_nir(ctx, nir, &data);
+   pco_postprocess_nir(ctx, nir, &data);
+
+   shader = pco_trans_nir(ctx, nir, &data, NULL);
+   if (shader == NULL) {
+      mesa_loge("pvr: pco failed to translate %s", nir->info.name);
+      return false;
+   }
+
+   pco_process_ir(ctx, shader);
+   pco_encode_ir(ctx, shader);
+
+   size = pco_shader_binary_size(shader);
+   if (size == 0) {
+      mesa_loge("pvr: pco encoded no code for %s", nir->info.name);
+      return false;
+   }
+
+   *shader_out = shader;
+   *data_out = pco_shader_binary_data(shader);
+   *size_out = size;
+
+   return true;
+}
diff --git a/src/gallium/drivers/pvr/pvr_shader.h b/src/gallium/drivers/pvr/pvr_shader.h
new file mode 100644
index 00000000..8d262286
--- /dev/null
+++ b/src/gallium/drivers/pvr/pvr_shader.h
@@ -0,0 +1,31 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * GLSL/SPIR-V-independent shader entry points: this is where pco, the compiler the
+ * Vulkan driver also uses, is actually run. Nothing here invents a compiler; it runs
+ * the linked one over the NIR the state tracker hands us.
+ */
+#ifndef PVR_SHADER_H
+#define PVR_SHADER_H
+
+#include <stdbool.h>
+
+#include <stdint.h>
+
+#include "pco/pco.h"
+
+struct nir_shader;
+
+/* Runs the full pco pipeline over a NIR shader and returns the encoded binary.
+ *
+ * The sequence is the one the Vulkan driver uses (pvr_usc.c build_shader): preprocess,
+ * lower, postprocess, translate, process, encode. Reordering it produces a binary that
+ * is wrong rather than an error, which is why it is copied rather than guessed.
+ *
+ * Returns false if the compiler produced nothing. On success *data_out points at the
+ * binary, owned by the returned shader, and *size_out is its size in bytes.
+ */
+bool pvr_shader_compile(pco_ctx *ctx, struct nir_shader *nir, pco_shader **shader_out,
+                        const void **data_out, unsigned *size_out);
+
+#endif /* PVR_SHADER_H */
