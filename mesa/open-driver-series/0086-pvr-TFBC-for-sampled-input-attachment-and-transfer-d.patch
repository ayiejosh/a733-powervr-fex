From dd17f331a104ae4d9ed195af6ecd8582b520461c Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sun, 11 Oct 2026 08:09:31 +0800
Subject: [PATCH 86/98] pvr: TFBC for sampled, input attachment and transfer
 destination images

Compression was limited to images used only as colour attachments and
transfer sources, with no create flags. zink creates GL colour buffers
with sampled, input attachment and transfer destination usage too, and
mutable format with a list of the UNORM and SRGB variants, so they were
never compressed. All of those are read through the TPU, which
decompresses using the image view's TFBC flag, or written through the
PBE (transfers included), so allow them. A mutable image qualifies when
its format list only differs from its format in being sRGB, and the SRGB
variants of the RGBA8 and BGRA8 formats qualify too.

glmark2-es2 through zink, off-screen 800x600, FPS of two runs each,
before -> after: build 758/745 -> 907/919, texture 793/815 -> 965/969,
phong 420/425 -> 457/457, effect2d 3x3 379/378 -> 403/402, pulsar
662/666 -> 713/681, the others unchanged. glmark2 --validate: 27 pass,
0 fail.

CTS: TFBC list (9170), TFBC copy/clear/texture sample (4223), render
pass load_store_op_none/attachment_allocation/render_area sample (1446),
dynamic rendering sample (6745), 5062 list, loops/indexing/graphicsfuzz
list (6428), synchronization (1718), robustness list (4025): identical
to before.
---
 src/imagination/vulkan/pvr_image.c | 36 +++++++++++++++++++++++++++---
 src/imagination/vulkan/pvr_image.h |  4 +++-
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/src/imagination/vulkan/pvr_image.c b/src/imagination/vulkan/pvr_image.c
index 932531e..d57265d 100644
--- a/src/imagination/vulkan/pvr_image.c
+++ b/src/imagination/vulkan/pvr_image.c
@@ -299,6 +299,31 @@ void pvr_DestroyImage(VkDevice _device,
    vk_image_destroy(&device->vk, pAllocator, &image->vk);
 }
 
+/* Whether all the formats the image may be viewed with (it may only be viewed
+ * with its own format unless it is mutable) differ from its format at most in
+ * being sRGB, which TFBC data does not depend on.
+ */
+static bool pvr_image_view_formats_may_fbc(const VkImageCreateInfo *pCreateInfo)
+{
+   if (!(pCreateInfo->flags & VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT))
+      return true;
+
+   const VkImageFormatListCreateInfo *format_list =
+      vk_find_struct_const(pCreateInfo->pNext, IMAGE_FORMAT_LIST_CREATE_INFO);
+   if (!format_list || !format_list->viewFormatCount)
+      return false;
+
+   const enum pipe_format format =
+      util_format_linear(vk_format_to_pipe_format(pCreateInfo->format));
+   for (uint32_t i = 0; i < format_list->viewFormatCount; i++) {
+      const VkFormat view_format = format_list->pViewFormats[i];
+      if (util_format_linear(vk_format_to_pipe_format(view_format)) != format)
+         return false;
+   }
+
+   return true;
+}
+
 void pvr_image_init(struct pvr_device *device,
                     const VkImageCreateInfo *pCreateInfo,
                     struct pvr_image *image)
@@ -325,11 +350,14 @@ void pvr_image_init(struct pvr_device *device,
    /* Lossless TFBC for plain colour targets: the PBE compresses 8x8 blocks in
     * place and the TPU decompresses them. Writers other than the PBE (host
     * copies, storage, ...) can't keep the headers in step, hence the usage
-    * limit.
+    * limit; transfers write through the PBE.
     */
    const struct pvr_device_info *dev_info = &device->pdevice->dev_info;
    const VkImageUsageFlags fbc_usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
-                                       VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+                                       VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT |
+                                       VK_IMAGE_USAGE_SAMPLED_BIT |
+                                       VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                                       VK_IMAGE_USAGE_TRANSFER_DST_BIT;
    image->fbc = !PVR_IS_DEBUG_SET(NO_FBC) &&
                 PVR_HAS_FEATURE(dev_info, tpu_image_state_v2) &&
                 PVR_GET_FEATURE_VALUE(dev_info, fbcdc_algorithm, 0) == 50 &&
@@ -340,7 +368,9 @@ void pvr_image_init(struct pvr_device *device,
                 image->vk.image_type == VK_IMAGE_TYPE_2D &&
                 image->vk.samples == VK_SAMPLE_COUNT_1_BIT &&
                 image->vk.mip_levels == 1 && image->vk.array_layers == 1 &&
-                image->plane_count == 1 && !pCreateInfo->flags &&
+                image->plane_count == 1 &&
+                !(pCreateInfo->flags & ~VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT) &&
+                pvr_image_view_formats_may_fbc(pCreateInfo) &&
                 !image->vk.external_handle_types &&
                 (pCreateInfo->usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) &&
                 !(pCreateInfo->usage & ~fbc_usage) &&
diff --git a/src/imagination/vulkan/pvr_image.h b/src/imagination/vulkan/pvr_image.h
index 353f36a..41a9ee2 100644
--- a/src/imagination/vulkan/pvr_image.h
+++ b/src/imagination/vulkan/pvr_image.h
@@ -143,7 +143,9 @@ pvr_plane_from_aspect_const(const struct pvr_image *image,
 static inline bool pvr_image_format_may_fbc(VkFormat format)
 {
    return format == VK_FORMAT_R8G8B8A8_UNORM ||
-          format == VK_FORMAT_B8G8R8A8_UNORM;
+          format == VK_FORMAT_R8G8B8A8_SRGB ||
+          format == VK_FORMAT_B8G8R8A8_UNORM ||
+          format == VK_FORMAT_B8G8R8A8_SRGB;
 }
 
 struct pvr_image_view {
