From 1dad9cc7d02aaa447d015993f36d999027c9b18a Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Wed, 28 Oct 2026 09:27:58 +0800
Subject: [PATCH] gallium/pvr: accept mipmapped textures so mipmap-filtered
 render targets exist

glmark2's refract scene creates its colour render target with GL_LINEAR_MIPMAP_LINEAR before
glTexImage2D; the state tracker then asks the driver for a full mip chain (last_level=9). The
driver refused any mipmapped resource, so glTexImage2D failed with GL_OUT_OF_MEMORY, the FBO
lost its colour attachment and glCheckFramebufferStatus returned GL_FRAMEBUFFER_UNSUPPORTED
(0x8cdd) - the scene was skipped and its score was not real.

The draw path samples level 0 only (linear, one descriptor), so allocate level 0 and report
last_level 0; a non-NULL generate_mipmap that accepts the call keeps the state tracker from
falling back to util_gen_mipmap(), whose per-level transfers this driver does not implement.
Refract now sets up and runs through the native driver (score 82, previously skipped).
---
 src/gallium/drivers/pvr_native/pvr_context.c  | 15 +++++++++++++++
 src/gallium/drivers/pvr_native/pvr_resource.c |  9 +++++++--
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index cffc2896..cc362f67 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -798,6 +798,20 @@ pvr_context_destroy(struct pipe_context *pctx)
    FREE(ctx);
 }
 
+/* ponytail: the draw path samples level 0 only (linear, one descriptor), so generating a mip
+ * chain would allocate data nothing can read. Keep the entry point non-NULL so the state
+ * tracker does not fall back to util_gen_mipmap(), which would need per-level transfers this
+ * driver does not have. Add real mip sampling with the TFBC/twiddled texture work. */
+static bool
+pvr_generate_mipmap(struct pipe_context *pctx, struct pipe_resource *pres,
+                    enum pipe_format format, unsigned base_level, unsigned last_level,
+                    unsigned first_layer, unsigned last_layer)
+{
+   (void)pctx; (void)pres; (void)format; (void)base_level; (void)last_level;
+   (void)first_layer; (void)last_layer;
+   return true;
+}
+
 struct pipe_context *
 pvr_context_create(struct pipe_screen *pscreen, UNUSED void *priv,
                    UNUSED unsigned flags)
@@ -815,6 +829,7 @@ pvr_context_create(struct pipe_screen *pscreen, UNUSED void *priv,
    ctx->base.sampler_view_release = pvr_sampler_view_release;
 
    ctx->base.buffer_map = pvr_transfer_map;
+   ctx->base.generate_mipmap = pvr_generate_mipmap;
    ctx->base.buffer_unmap = pvr_transfer_unmap;
    ctx->base.texture_map = pvr_transfer_map;
    ctx->base.texture_unmap = pvr_transfer_unmap;
diff --git a/src/gallium/drivers/pvr_native/pvr_resource.c b/src/gallium/drivers/pvr_native/pvr_resource.c
index 4b928015..a9980aae 100644
--- a/src/gallium/drivers/pvr_native/pvr_resource.c
+++ b/src/gallium/drivers/pvr_native/pvr_resource.c
@@ -56,8 +56,12 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
    uint32_t stride = 0;
    uint64_t size = 0;
 
-   if (templ->last_level != 0 || templ->array_size != 1 || templ->nr_samples > 1) {
-      mesa_logd("pvr: refusing a mipmapped/arrayed/multisampled resource");
+   /* ponytail: mip chains are not sampled by the level-0-only texture descriptors, so it is
+    * enough that the resource exists - allocate level 0 and let generate_mipmap() be a
+    * no-op. Refusing mipmapped textures made any GL texture with a mipmap min filter fail
+    * with GL_OUT_OF_MEMORY (glmark2 refract's colour target). */
+   if (templ->array_size != 1 || templ->nr_samples > 1) {
+      mesa_logd("pvr: refusing an arrayed/multisampled resource");
       return NULL;
    }
 
@@ -76,6 +80,7 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
       return NULL;
 
    res->base = *templ;
+   res->base.last_level = 0;
    res->base.screen = pscreen;
    pipe_reference_init(&res->base.reference, 1);
 
-- 
2.47.3

