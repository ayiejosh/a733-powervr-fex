From 57635d92a2a7a9e5a0e91db0f4f309442128ee53 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 17 Oct 2026 10:30:15 +0800
Subject: [PATCH 164/294] gallium/pvr: the PBE swizzle translation

  csb: PBE swizzle: 6 pipe selectors -> distinct hardware values, NONE refused
  --- ALL PASS        (real open kernel)

Same correspondence as the texture side - the hardware enum names SOURCE_CHAN0..3 / ZERO / ONE, which
are PIPE_SWIZZLE_X/Y/Z/W/0/1 - so the translation is a switch, not a table.

It TRANSLATES and does not DECIDE. Which channel order a given render-target format needs is a
per-format question, which the reference answers with a long conditional chain per source_format.
This driver has not mapped any target format to a PBESTATE source format yet, so the caller supplies
the swizzle. Translating and deciding are different jobs and only the first is done here; the header
says so rather than implying the driver knows a target's channel order.

The check asserts six distinct values, because a collapse would read two channels from the same
source and silently permute a target's colours. PIPE_SWIZZLE_NONE is refused for the same reason as
on the texture side: it states the format has no channel there, which is not a selector.
---
 src/gallium/drivers/pvr/pvr_csb.c   | 15 +++++++++++++
 src/gallium/drivers/pvr/pvr_csb.h   | 12 +++++++++++
 src/gallium/drivers/pvr/pvr_probe.c | 33 +++++++++++++++++++++++++++++
 3 files changed, 60 insertions(+)

diff --git a/src/gallium/drivers/pvr/pvr_csb.c b/src/gallium/drivers/pvr/pvr_csb.c
index 6deba238..47fb0675 100644
--- a/src/gallium/drivers/pvr/pvr_csb.c
+++ b/src/gallium/drivers/pvr/pvr_csb.c
@@ -383,6 +383,21 @@ pvr_pbe_linestride(uint32_t stride_bytes)
    return (stride_bytes - 1) / ROGUE_PBESTATE_REG_WORD0_LINESTRIDE_UNIT_SIZE;
 }
 
+bool
+pvr_pbe_swizzle_from_pipe(uint8_t pipe_swizzle, enum ROGUE_PBESTATE_SWIZ *out)
+{
+   switch (pipe_swizzle) {
+   case PIPE_SWIZZLE_X: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN0; return true;
+   case PIPE_SWIZZLE_Y: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN1; return true;
+   case PIPE_SWIZZLE_Z: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN2; return true;
+   case PIPE_SWIZZLE_W: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN3; return true;
+   case PIPE_SWIZZLE_0: *out = ROGUE_PBESTATE_SWIZ_ZERO; return true;
+   case PIPE_SWIZZLE_1: *out = ROGUE_PBESTATE_SWIZ_ONE; return true;
+   default:
+      return false;
+   }
+}
+
 void
 pvr_pbe_clip_from_area(uint32_t off_x, uint32_t off_y, uint32_t width, uint32_t height,
                        uint32_t surface_width, uint32_t surface_height,
diff --git a/src/gallium/drivers/pvr/pvr_csb.h b/src/gallium/drivers/pvr/pvr_csb.h
index fe41cd97..62486506 100644
--- a/src/gallium/drivers/pvr/pvr_csb.h
+++ b/src/gallium/drivers/pvr/pvr_csb.h
@@ -487,6 +487,18 @@ struct pvr_pbe_clip {
    uint32_t max_y;
 };
 
+/* The PBE's per-channel swizzle, the same correspondence the texture side uses: the hardware enum
+ * names SOURCE_CHAN0..3 / ZERO / ONE, which are PIPE_SWIZZLE_X/Y/Z/W/0/1.
+ *
+ * This TRANSLATES; it does not decide. Which channel order a given render-target format needs is a
+ * per-format question - the reference answers it with a long conditional chain per source_format -
+ * and this driver has not mapped any target format to a PBESTATE source format yet, so the caller
+ * supplies the swizzle. Translating and deciding are different jobs and only the first is done.
+ *
+ * PIPE_SWIZZLE_NONE is refused for the same reason as on the texture side: it states the format has
+ * no channel there, which is not a selector, and mapping it to a zero would change what is written. */
+bool pvr_pbe_swizzle_from_pipe(uint8_t pipe_swizzle, enum ROGUE_PBESTATE_SWIZ *out);
+
 void pvr_pbe_clip_from_area(uint32_t off_x, uint32_t off_y, uint32_t width, uint32_t height,
                             uint32_t surface_width, uint32_t surface_height,
                             struct pvr_pbe_clip *out);
diff --git a/src/gallium/drivers/pvr/pvr_probe.c b/src/gallium/drivers/pvr/pvr_probe.c
index 80e08790..9930d35c 100644
--- a/src/gallium/drivers/pvr/pvr_probe.c
+++ b/src/gallium/drivers/pvr/pvr_probe.c
@@ -1891,6 +1891,39 @@ csb_check(int fd, struct pipe_screen *pscreen)
                goto out;
             }
 
+            /* The PBE swizzle translation, checked the same way as the texture one: six distinct
+             * pipe selectors must give six distinct hardware values, or two channels would be read
+             * from the same source and a target's colours would be permuted silently. */
+            {
+               const uint8_t pipes[] = { PIPE_SWIZZLE_X, PIPE_SWIZZLE_Y, PIPE_SWIZZLE_Z,
+                                         PIPE_SWIZZLE_W, PIPE_SWIZZLE_0, PIPE_SWIZZLE_1 };
+               enum ROGUE_PBESTATE_SWIZ got[ARRAY_SIZE(pipes)];
+
+               for (unsigned i = 0; i < ARRAY_SIZE(pipes); i++) {
+                  if (!pvr_pbe_swizzle_from_pipe(pipes[i], &got[i])) {
+                     printf("csb:           FAIL: PBE swizzle %u has no hardware value\n",
+                            pipes[i]);
+                     goto out;
+                  }
+                  for (unsigned j = 0; j < i; j++) {
+                     if (got[j] == got[i]) {
+                        printf("csb:           FAIL: PBE swizzles %u and %u collapsed\n",
+                               pipes[j], pipes[i]);
+                        goto out;
+                     }
+                  }
+               }
+
+               if (pvr_pbe_swizzle_from_pipe(PIPE_SWIZZLE_NONE, &got[0])) {
+                  printf("csb:           FAIL: PBE swizzle accepted NONE, which is not a "
+                         "selector\n");
+                  goto out;
+               }
+
+               printf("csb:           PBE swizzle: %zu pipe selectors -> distinct hardware values, "
+                      "NONE refused\n", ARRAY_SIZE(pipes));
+            }
+
             printf("csb:           PBE clip: inclusive pixels (whole 0,0..799,599; offset "
                    "10,20..109,69; overhang clamped; zero extent does not wrap)\n");
          }
-- 
