-/* The HWRT data set for a target size, sized from pvr_hwrt_sizes(). */
+static void
+draw_general_bo_free(struct pvr_screen *scr, struct pvr_bo *bo, uint64_t *addr)
+{
+   pvr_bo_unmap(bo);
+   if (*addr != 0) {
+      pvr_vm_unmap(&scr->vm, *addr, bo->size);
+      pvr_vm_free(&scr->vm, *addr, bo->size);
+      *addr = 0;
+   }
+   if (bo->handle != 0)
+      pvr_bo_destroy(scr->fd, bo);
+   memset(bo, 0, sizeof(*bo));
+}
+
+static void
+draw_hwrt_free(struct pvr_screen *scr, struct pvr_draw_hwrt *e)
+{
+   /* The data set first (it references the free list), then the free list, then the buffers. */
+   pvr_hwrt_dataset_destroy(&scr->vm, e->dset);
+   pvr_free_list_destroy(&scr->vm, e->fl_handle);
+   for (unsigned i = 0; i < ARRAY_SIZE(e->bo); i++)
+      draw_general_bo_free(scr, &e->bo[i], &e->addr[i]);
+   memset(e, 0, sizeof(*e));
+}
+
+/* The HWRT data set for a target size, sized from pvr_hwrt_sizes(). Renders are waited for before
+ * the next one is built, so an evicted data set is idle. */
 static bool
 draw_hwrt(struct pvr_context *ctx, struct pvr_draw_state *d, uint32_t w, uint32_t h)
 {
    struct pvr_screen *scr = draw_screen(ctx);
+   struct pvr_draw_hwrt *e = NULL;
    struct pvr_hwrt_sizes sz;
-   uint64_t sizes[6];
-   static const uint64_t flags[6] = { 0, 0, DRM_PVR_BO_PM_FW_PROTECT, DRM_PVR_BO_PM_FW_PROTECT,
-                                      0, 0 };
+   uint64_t sizes[7];
+   static const uint64_t flags[7] = { 0, 0, DRM_PVR_BO_PM_FW_PROTECT, DRM_PVR_BO_PM_FW_PROTECT,
+                                      0, 0, DRM_PVR_BO_PM_FW_PROTECT };
+   const uint32_t local_pages =
+      (uint32_t)(ALIGN_POT(scr->dev_runtime_info.min_free_list_size, 65536) / 4096);
 
-   if (d->dset != 0 && d->dset_w == w && d->dset_h == h)
-      return true;
-   /* shortcut: the previous data set and its buffers are leaked on a size change; free them
-    * (destroy ioctl + unmap) once targets change size often. */
-   d->dset = 0;
-   if (!pvr_hwrt_sizes(&scr->dev_info, w, h, 1, 1, &sz))
-      return false;
-   sizes[0] = sz.tpc_size;
-   sizes[1] = 4096; /* VHEAP table, single layer: no RTC */
-   sizes[2] = sizes[3] = 4096; /* MLIST: ~1 KiB for a 256 MiB global free list */
-   sizes[4] = sizes[5] = sz.region_header_size;
-   for (unsigned i = 0; i < 6; i++) {
-      if (!draw_general_bo(scr, sizes[i], flags[i], &d->hw_bo[i], &d->hw_addr[i], false))
+   for (unsigned i = 0; i < PVR_DRAW_HWRT_CACHE; i++) {
+      if (d->hwrt[i].dset != 0 && d->hwrt[i].w == w && d->hwrt[i].h == h)
+         e = &d->hwrt[i];
+   }
+   if (e == NULL) {
+      e = &d->hwrt[0];
+      for (unsigned i = 1; i < PVR_DRAW_HWRT_CACHE; i++) {
+         if (d->hwrt[i].dset == 0 || (e->dset != 0 && d->hwrt[i].last_use < e->last_use))
+            e = &d->hwrt[i];
+      }
+      if (e->dset != 0)
+         draw_hwrt_free(scr, e);
+      if (!pvr_hwrt_sizes(&scr->dev_info, w, h, 1, 1, &sz))
+         return false;
+      sizes[0] = sz.tpc_size;
+      sizes[1] = 4096; /* VHEAP table, single layer: no RTC */
+      sizes[2] = sizes[3] = 4096; /* MLIST: ~1 KiB for a 256 MiB global free list */
+      sizes[4] = sizes[5] = sz.region_header_size;
+      sizes[6] = (uint64_t)local_pages * 4;
+      for (unsigned i = 0; i < ARRAY_SIZE(sizes); i++) {
+         if (!draw_general_bo(scr, sizes[i], flags[i], &e->bo[i], &e->addr[i], false)) {
+            draw_hwrt_free(scr, e);
+            return false;
+         }
+      }
+      if (!pvr_free_list_create(&scr->vm, e->addr[6], local_pages, local_pages, 0, 0,
+                                &e->fl_handle)) {
+         draw_hwrt_free(scr, e);
+         return false;
+      }
+      struct pvr_hwrt_dataset_desc desc = {
+         .tpc_dev_addr = e->addr[0],
+         .tpc_size = (uint32_t)sz.tpc_size,
+         .tpc_stride = sz.tpc_stride,
+         .vheap_table_dev_addr = e->addr[1],
+         .pm_mlist_dev_addr = { e->addr[2], e->addr[3] },
+         .region_header_dev_addr = { e->addr[4], e->addr[5] },
+         .free_list_handles = { e->fl_handle, d->fl_handle[1] },
+         .width = w,
+         .height = h,
+         .samples = 1,
+         .layers = 1,
+         .region_header_size = (uint32_t)sz.region_header_size,
+      };
+      if (!pvr_hwrt_dataset_create(&scr->vm, &desc, &e->dset)) {
+         draw_hwrt_free(scr, e);
          return false;
+      }
