+draw_use(struct pvr_draw_state *d, struct pipe_resource *pres)
+{
+   struct pvr_resource *res = pvr_resource(pres);
+   struct pvr_draw_slot *s = &d->slots[d->cur_slot];
+   if (res->render_seq == d->seq)
+      return;
+   res->render_seq = d->seq;
+   if (s->nrefs == s->cap) {
+      const unsigned cap = MAX2(16, s->cap * 2);
+      struct pipe_resource **refs = realloc(s->refs, cap * sizeof(*refs));
+      if (refs == NULL)
+         return;
+      s->refs = refs;
+      s->cap = cap;
+   }
+   s->refs[s->nrefs] = NULL;
+   pipe_resource_reference(&s->refs[s->nrefs++], pres);
+}
