+/* A fence is a syncobj holding a copy of the fence of the last render submitted before it. */
+struct pipe_fence_handle {
+   struct pipe_reference reference;
+   uint32_t syncobj;
+};
+
+struct pipe_fence_handle *
+pvr_fence_create(struct pvr_screen *screen, uint32_t render_sync)
+{
+   struct pipe_fence_handle *f = CALLOC_STRUCT(pipe_fence_handle);
+   if (f == NULL)
+      return NULL;
+   pipe_reference_init(&f->reference, 1);
+   if (drmSyncobjCreate(screen->fd, render_sync ? 0 : DRM_SYNCOBJ_CREATE_SIGNALED,
+                        &f->syncobj) != 0 ||
+       (render_sync && drmSyncobjTransfer(screen->fd, f->syncobj, 0, render_sync, 0, 0) != 0)) {
+      if (f->syncobj)
+         drmSyncobjDestroy(screen->fd, f->syncobj);
+      FREE(f);
+      return NULL;
+   }
+   return f;
+}
+
 static void
-pvr_fence_reference(UNUSED struct pipe_screen *pscreen,
-                    struct pipe_fence_handle **ptr,
-                    UNUSED struct pipe_fence_handle *fence)
+pvr_fence_reference(struct pipe_screen *pscreen, struct pipe_fence_handle **ptr,
+                    struct pipe_fence_handle *fence)
+{
+   struct pipe_fence_handle *old = *ptr;
+   if (pipe_reference(old ? &old->reference : NULL, fence ? &fence->reference : NULL)) {
+      drmSyncobjDestroy(pvr_screen(pscreen)->fd, old->syncobj);
+      FREE(old);
+   }
+   *ptr = fence;
+}
+
+static bool
+pvr_fence_finish(struct pipe_screen *pscreen, UNUSED struct pipe_context *pctx,
+                 struct pipe_fence_handle *fence, uint64_t timeout)
 {
-   if (ptr)
-      *ptr = NULL;
+   const int64_t deadline = timeout == OS_TIMEOUT_INFINITE ? INT64_MAX
+                                                           : os_time_get_absolute_timeout(timeout);
+   return drmSyncobjWait(pvr_screen(pscreen)->fd, &fence->syncobj, 1, deadline, 0, NULL) == 0;
 }
 
