+/* Waits for a slot's render and drops what it held. */
+static void
+draw_slot_idle(struct pvr_screen *scr, struct pvr_draw_slot *s)
+{
+   if (s->sync != 0) {
+      if (drmSyncobjWait(scr->fd, &s->sync, 1, INT64_MAX, 0, NULL) != 0)
+         mesa_loge("pvr: draw: waiting for a render failed");
+      drmSyncobjDestroy(scr->fd, s->sync);
+      s->sync = 0;
+   }
+   for (unsigned i = 0; i < s->nrefs; i++)
+      pipe_resource_reference(&s->refs[i], NULL);
+   s->nrefs = 0;
+}
+
+static void
+draw_idle(struct pvr_context *ctx, struct pvr_draw_state *d)
+{
+   for (unsigned i = 0; i < PVR_DRAW_SLOTS; i++)
+      draw_slot_idle(draw_screen(ctx), &d->slots[i]);
+}
