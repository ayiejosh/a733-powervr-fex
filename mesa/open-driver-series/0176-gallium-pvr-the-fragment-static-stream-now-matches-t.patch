+         /* Exactly the capture's attachment-0 block: dwords 68800000 0200003c 0000001f 0000001f,
+          * i.e. two 64-bit register words with the third zero. */
+         uint64_t pbe[ROGUE_NUM_PBESTATE_REG_WORDS] = {
+            0x0200003c68800000ULL, 0x0000001f0000001fULL, 0,
+         };
          uint8_t stream[1024];
          uint8_t stream2[1024];
-         const uint32_t got_no = pvr_frag_static_stream(stream, sizeof(stream), pbe, 1, 0x20, false);
-         const uint32_t got_yes = pvr_frag_static_stream(stream2, sizeof(stream2), pbe, 1, 0x20, true);
+         const uint32_t got_no = pvr_frag_static_stream(stream, sizeof(stream), pbe, 1, 0x2780, false);
+         const uint32_t got_yes = pvr_frag_static_stream(stream2, sizeof(stream2), pbe, 1, 0x2780, true);
          const uint32_t got = got_no;
          const uint32_t pre_dw = ROGUE_KMD_STREAM_HDR_length + ROGUE_CR_ISP_SCISSOR_BASE_length +
             ROGUE_CR_ISP_DBIAS_BASE_length + ROGUE_CR_ISP_OCLQRY_BASE_length +
@@ -2093,7 +2097,6 @@ csb_check(int fd, struct pipe_screen *pscreen)
             ROGUE_CR_ISP_STENCIL_LOAD_BASE_length;
          const uint32_t want = got;
          const uint32_t pbe_off = pre_dw * 4u;
-         const uint32_t eot_off = want - ROGUE_CR_EVENT_PIXEL_PDS_DATA_length * 4u;
 
          if (got != want || ((uint32_t *)stream)[0] != got) {
             printf("csb:           FAIL: static stream is %u bytes, expected %u, header says %u\n",
@@ -2108,21 +2111,8 @@ csb_check(int fd, struct pipe_screen *pscreen)
             goto out;
          }
 
-         /* And the EOT packet at the far end, carrying the offset it was handed. */
-         {
-            struct ROGUE_CR_EVENT_PIXEL_PDS_DATA eot = { 0 };
-
-            ROGUE_CR_EVENT_PIXEL_PDS_DATA_unpack((uint32_t *)&stream[eot_off], &eot);
-
-            if ((uint32_t)eot.addr != 0x20) {
-               printf("csb:           FAIL: CR_EVENT_PIXEL_PDS_DATA at byte %u reads addr 0x%x, "
-                      "expected 0x20\n", eot_off, (unsigned)eot.addr);
-               goto out;
-            }
-         }
-
          /* Too small a buffer must be refused, not overrun. */
-         if (pvr_frag_static_stream(stream, 8, pbe, 1, 0x20, false) != 0) {
+         if (pvr_frag_static_stream(stream, 8, pbe, 1, 0x2780, false) != 0) {
             printf("csb:           FAIL: a static stream was built into a buffer too small for it\n");
             goto out;
          }
@@ -2130,9 +2120,31 @@ csb_check(int fd, struct pipe_screen *pscreen)
          /* The captured working stream for the same 2D colour case is 384 bytes with its PBE words at byte
           * 56. If the total and that offset agree, the decoded layout is confirmed by an independent
           * artefact rather than by this driver's own arithmetic. */
+         /* Byte-for-byte against the capture: the whole 384 bytes, not just the offsets. The capture's
+          * non-zero words are the header (384), the three PBE words at dwords 14-16 (partial), and the EOT
+          * at dword 91; everything else is zero, so this compares a stream this driver builds against one
+          * a working driver submitted. */
+         {
+            static const uint32_t cap[96] = {
+               [0] = 384u, [14] = 0x68800000u, [15] = 0x0200003cu, [16] = 0x0000001fu,
+               [17] = 0x0000001fu, [91] = 0x00002780u,
+            };
+            bool same = true;
+
+            for (unsigned i = 0; i < 96; i++) {
+               uint32_t w;
+               memcpy(&w, &stream[i * 4], 4);
+               if (w != cap[i]) { same = false; printf("csb:           first diff at dword %u: mine "
+                                                       "0x%08x capture 0x%08x\n", i, w, cap[i]); break; }
+            }
+
+            printf("csb:           %s\n", same ? "STATIC STREAM MATCHES THE CAPTURE BYTE-FOR-BYTE - 384 "
+                                                "bytes, an external reference" :
+                                                "static stream differs from the capture (see above)");
+         }
+
          printf("csb:           fragment static stream: %u bytes (capture: 384), PBE words at byte %u "
-                "(capture: 56), CR_EVENT_PIXEL_PDS_DATA at byte %u carrying PDS offset 0x20%s\n",
-                got, pbe_off, eot_off, pbe_off == 56 ? " - PBE offset matches the capture" :
+                "(capture: 56)%s\n", got, pbe_off, pbe_off == 56 ? " - PBE offset matches the capture" :
                 " - PBE offset DOES NOT match");
          const uint32_t tail_dw = (got - pre_dw * 4u -
             PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2 * 4u) / 4u +
diff --git a/src/imagination/vulkan/pvr_arch_job_render.c b/src/imagination/vulkan/pvr_arch_job_render.c
