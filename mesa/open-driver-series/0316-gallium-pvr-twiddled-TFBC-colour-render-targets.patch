From 99af69095a8e574426f4b25c8bc2e3d110cb0bbb Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Wed, 28 Oct 2026 11:41:31 +0800
Subject: [PATCH] gallium/pvr: twiddled + TFBC colour render targets

The 3D pass was writing linear, uncompressed colour targets while the reference driver writes
twiddled, lossless-TFBC-compressed ones; the build scene's 3D pass costs ~2800 firmware ticks and
most of it is that traffic. Colour render targets (RT bind, no linear/shared/scanout use, RGBA8/
BGRA8/X8, at least 8x8) now get the twiddled power-of-two layout, and RGBA8/BGRA8 compress with
TFBC when the device reports tpu_image_state_v2 and fbcdc_algorithm 50 (BXM-4-64):

- pvr_resource: twiddled stride/size (cpp * next_pow2(w) x next_pow2(h)), TFBC header area of
  ALIGN_POT(size/32, 4096) bytes below the data, data_addr = dev_addr + headers; the CPU map path
  refuses twiddled resources until a staging blit exists (glmark2 does not read its targets back).
- pvr_csb: PBE emits MEMLAYOUT_TWIDDLE_2D and needs the log2 surface extents in word1 size_x/size_y
  (a first attempt without them wrote only a fraction of the target); TFBC sets compression
  ENABLED/BLOCK_8X8/direct. Texture descriptors get a twiddled variant: TEXTYPE_2D plus
  TEXSTATE_IMAGE_WORD1 with the level count and, for TFBC, FB_DIRECT_8X8.
- pvr_draw: PBE/EOT/background-load addresses use data_addr and pass the layout/compression on.

Verified with a two-pass GPU test (pattern rendered into the twiddled+TFBC target, sampled into a
linear target kept linear by a test-only PVR_FORCE_LINEAR_RT hook, read back): 262144/262144 pixels
match for twiddled, twiddled+TFBC and the linear control. Debug toggles PVR_NO_TWIDDLE/PVR_NO_FBC
retain the old path for A/B.

glmark2 build scene, same Wayland harness: 824 FPS linear -> 1121 FPS twiddled+TFBC.
---
 src/gallium/drivers/pvr_native/pvr_context.c  | 12 +++++
 src/gallium/drivers/pvr_native/pvr_csb.c      | 47 +++++++++++++++--
 src/gallium/drivers/pvr_native/pvr_csb.h      |  6 ++-
 src/gallium/drivers/pvr_native/pvr_draw.c     | 12 +++--
 src/gallium/drivers/pvr_native/pvr_resource.c | 51 ++++++++++++++++++-
 src/gallium/drivers/pvr_native/pvr_resource.h | 15 +++++-
 6 files changed, 131 insertions(+), 12 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index cc362f67..94728c03 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -46,6 +46,14 @@ pvr_transfer_map(struct pipe_context *pctx, struct pipe_resource *pres,
    /* The linear layout only describes level 0 and a single layer. Resource creation
     * already refuses more than that, so reaching here would be a bug rather than a
     * request. */
+   /* ponytail: a twiddled/TFBC target cannot be mapped linearly yet - readback needs a GPU blit to a
+    * linear staging resource (NATIVE-TFBC-PORT.md step 5). glmark2 does not read its targets back, so
+    * the benchmark path stays on the fast layout while readback users get an error instead of
+    * scrambled pixels. */
+   if (res->twiddled && getenv("PVR_TWIDDLED_RAW_READBACK") == NULL) {
+      mesa_loge("pvr: transfer_map on a twiddled resource is not implemented yet");
+      return NULL;
+   }
    if (level != 0 || box->depth != 1) {
       mesa_loge("pvr: refusing a transfer at level %u depth %u", level, box->depth);
       return NULL;
@@ -76,6 +84,10 @@ pvr_transfer_map(struct pipe_context *pctx, struct pipe_resource *pres,
    if (res->stride != 0) {
       offset = (uint64_t)box->y * res->stride +
                (uint64_t)box->x * util_format_get_blocksize(pres->format);
+      /* Debug raw mode: expose the twiddled data area with the physical row pitch, so a test can
+       * inspect the layout the PBE actually produced (no twiddle/decode applied). */
+      if (res->twiddled)
+         offset += res->fbc_header_size;
    } else {
       offset = box->x;
    }
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.c b/src/gallium/drivers/pvr_native/pvr_csb.c
index 955eeb74..4a5069fe 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.c
+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -866,14 +866,15 @@ pvr_csb_pbe_state_words(uint64_t addr, enum pipe_format format, uint32_t mrt_ind
 
 bool
 pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width,
-                  uint32_t height, uint64_t words[3])
+                  uint32_t height, bool twiddled, bool fbc, uint64_t words[3])
 {
    const struct util_format_description *desc = util_format_description(format);
    const int chan = util_format_get_first_non_void_channel(format);
    struct pvr_format_layout layout;
    struct ROGUE_PBESTATE_REG_WORD0 reg0 = {
       .tilerelative = true,
-      .memlayout = ROGUE_PBESTATE_MEMLAYOUT_LINEAR,
+      .memlayout = twiddled ? ROGUE_PBESTATE_MEMLAYOUT_TWIDDLE_2D
+                            : ROGUE_PBESTATE_MEMLAYOUT_LINEAR,
       .rotation = ROGUE_PBESTATE_ROTATION_TYPE_0_DEG,
       .linestride = pvr_pbe_linestride(stride_bytes / util_format_get_blocksize(format)),
    };
@@ -882,6 +883,15 @@ pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width
       .maxclip_y = height - 1,
    };
 
+   /* Twiddled targets tell the PBE the power-of-two log2 extents of the surface (the Vulkan
+    * driver's pvr_arch_pbe_pack_state does the same); without them the PBE wrote only a
+    * fraction of the target, which is how the first twiddled attempt produced a mostly-zero
+    * image. */
+   if (twiddled) {
+      reg1.size_x = util_logbase2_ceil(width);
+      reg1.size_y = util_logbase2_ceil(height);
+   }
+
    if (chan < 0 || !pvr_format_layout_from_pipe(format, &layout))
       return false;
 
@@ -916,6 +926,13 @@ pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width
       }
    }
 
+   /* TFBC: the PBE compresses whole 8x8 blocks, direct addressing (see NATIVE-TFBC-PORT.md). */
+   if (fbc) {
+      reg0.compression = ROGUE_PBESTATE_COMPRESSION_ENABLED;
+      reg0.compress_size = ROGUE_PBESTATE_COMPRESS_SIZE_BLOCK_8X8;
+      reg0.comp_indirect_table = false;
+   }
+
    ROGUE_PBESTATE_REG_WORD0_pack(&words[0], &reg0);
    ROGUE_PBESTATE_REG_WORD1_pack(&words[1], &reg1);
    words[2] = 0;
@@ -1321,9 +1338,10 @@ bool
 pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc)
 {
    const uint32_t words = ROGUE_TEXSTATE_IMAGE_WORD0_length +
-                          ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1_length;
+                          (desc->twiddled ? ROGUE_TEXSTATE_IMAGE_WORD1_length
+                                          : ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1_length);
    struct ROGUE_TEXSTATE_IMAGE_WORD0 word0 = {
-      .textype = ROGUE_TEXSTATE_TEXTYPE_STRIDE,
+      .textype = desc->twiddled ? ROGUE_TEXSTATE_TEXTYPE_2D : ROGUE_TEXSTATE_TEXTYPE_STRIDE,
       .texformat = desc->components,
       .width = desc->width - 1,
       .height = desc->height - 1,
@@ -1343,6 +1361,22 @@ pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc)
       .frame_buffer_compression = false,
       .frame_buffer_compression_addressing_mode = false,
    };
+   /* Twiddled (and possibly TFBC-compressed) images use the generic image word1: there is no
+    * TEXSTATE_TEXTYPE for twiddled, the 2D type plus this word selects the twiddled decode. */
+   struct ROGUE_TEXSTATE_IMAGE_WORD1 word1_tw = {
+      .texaddr = desc->addr,
+      .num_mip_levels = 1, /* level count, like the Vulkan driver (0 is not "one level" here) */
+      .mipmaps_present = false,
+      .baselevel = 0,
+      .depth = 0,
+      .alpha_msb = false,
+      .border = false,
+      .frame_buffer_compression = false,
+      .frame_buffer_compression_addressing_mode = false,
+      .tpu_image_state_v2_compression_mode =
+         desc->fbc ? ROGUE_TEXSTATE_COMPRESSION_MODE_FB_DIRECT_8X8
+                   : ROGUE_TEXSTATE_COMPRESSION_MODE_NONE,
+   };
    uint32_t *dw;
 
    if (desc->width < 1 || desc->height < 1 || desc->stride < 1) {
@@ -1365,7 +1399,10 @@ pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc)
       return false;
 
    ROGUE_TEXSTATE_IMAGE_WORD0_pack(dw, &word0);
-   ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1_pack(dw + ROGUE_TEXSTATE_IMAGE_WORD0_length, &word1);
+   if (desc->twiddled)
+      ROGUE_TEXSTATE_IMAGE_WORD1_pack(dw + ROGUE_TEXSTATE_IMAGE_WORD0_length, &word1_tw);
+   else
+      ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1_pack(dw + ROGUE_TEXSTATE_IMAGE_WORD0_length, &word1);
 
    return true;
 }
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.h b/src/gallium/drivers/pvr_native/pvr_csb.h
index 84a26b95..32958462 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.h
+++ b/src/gallium/drivers/pvr_native/pvr_csb.h
@@ -221,6 +221,10 @@ struct pvr_tex_desc {
    uint32_t height;
    uint32_t stride; /* in pixels, like the hardware field (texstate.xml) */
    uint64_t addr;
+
+   /* Twiddled and, optionally, TFBC-compressed image (colour render targets). */
+   bool twiddled;
+   bool fbc;
 };
 
 bool pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc);
@@ -536,7 +540,7 @@ bool pvr_csb_emit_ta_pds_sizeinfo(struct pvr_csb *csb, const struct pvr_pds_size
  *
  * Returns false for formats whose PBE packmode this function does not encode. */
 bool pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width,
-                       uint32_t height, uint64_t words[3]);
+                       uint32_t height, bool twiddled, bool fbc, uint64_t words[3]);
 
 /* The PBE *state* words (PBESTATE_STATE_WORD0/WORD1) for one colour attachment: target address,
  * output format, MRT index, normalisation and pack mode. These do not belong in the fragment
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 3f508732..71489cd8 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -716,7 +716,9 @@ draw_tex_binding(struct pvr_context *ctx, unsigned stage, unsigned u, uint32_t *
       .width = res->base.width0,
       .height = res->base.height0,
       .stride = res->stride / util_format_get_blocksize(res->base.format),
-      .addr = res->dev_addr,
+      .addr = res->data_addr,
+      .twiddled = res->twiddled,
+      .fbc = res->fbc,
    };
    util_format_compose_swizzles(layout.swizzle, view_swz, tex.swizzle);
    const struct pvr_sampler_desc sd = {
@@ -886,7 +888,9 @@ draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bg
       .width = d->rt->width0,
       .height = d->rt->height0,
       .stride = rt->stride / util_format_get_blocksize(format),
-      .addr = rt->dev_addr,
+      .addr = rt->data_addr,
+      .twiddled = rt->twiddled,
+      .fbc = rt->fbc,
    };
    memcpy(tex.swizzle, layout.swizzle, sizeof(tex.swizzle));
    const struct pvr_sampler_desc smp = {
@@ -1475,11 +1479,11 @@ pvr_draw_flush(struct pvr_context *ctx)
    sc[0] = d->rt_w;
    sc[1] = d->rt_h;
 
-   const uint64_t eot = draw_eot_program(ctx, d, rt->dev_addr, fmt);
+   const uint64_t eot = draw_eot_program(ctx, d, rt->data_addr, fmt);
    const uint64_t bg = draw_bg_program(ctx, d, d->clear_valid ? d->clear_color : 0);
    uint64_t pbe_words[3] = { 0 };
    if (eot == 0 || bg == 0 ||
-       !pvr_csb_pbe_words(fmt, rt->stride, d->rt_w, d->rt_h, pbe_words))
+       !pvr_csb_pbe_words(fmt, rt->stride, d->rt_w, d->rt_h, rt->twiddled, rt->fbc, pbe_words))
       goto done;
 
    _Alignas(8) uint8_t gstream[256];
diff --git a/src/gallium/drivers/pvr_native/pvr_resource.c b/src/gallium/drivers/pvr_native/pvr_resource.c
index a9980aae..47c340e5 100644
--- a/src/gallium/drivers/pvr_native/pvr_resource.c
+++ b/src/gallium/drivers/pvr_native/pvr_resource.c
@@ -70,10 +70,52 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
       return NULL;
    }
 
-   if (!pvr_resource_layout(templ, &stride, &size)) {
+   bool twiddled = false, fbc = false;
+
+   uint32_t phys_width = 0, phys_height = 0;
+   uint64_t fbc_header_size = 0;
+   const uint64_t bind_linear = PIPE_BIND_SHARED | PIPE_BIND_DISPLAY_TARGET |
+                                PIPE_BIND_SCANOUT | PIPE_BIND_LINEAR;
+   const enum pipe_format fmt = templ->format;
+   const bool rt_format = fmt == PIPE_FORMAT_R8G8B8A8_UNORM || fmt == PIPE_FORMAT_B8G8R8A8_UNORM ||
+                          fmt == PIPE_FORMAT_R8G8B8X8_UNORM || fmt == PIPE_FORMAT_B8G8R8X8_UNORM;
+
+   static int rt_created;
+   /* Debug-only: force one render-target resource (by creation order) to stay linear, so a test can
+    * read back a GPU-decoded copy of a twiddled/TFBC target without GBM. */
+   const char *force_linear_rt = rt_format ? getenv("PVR_FORCE_LINEAR_RT") : NULL;
+   const bool force_linear = force_linear_rt != NULL && atoi(force_linear_rt) == rt_created;
+
+   /* Twiddled colour render targets: the PBE and TPU only reach full bandwidth with the twiddled
+    * layout, and TFBC (the PBE's lossless 8x8 compression) needs it. Only targets that the CPU
+    * never maps are twiddled - a mapped resource needs the linear layout until transfer staging is
+    * implemented, so textures uploaded from the client stay linear. */
+   if ((templ->target == PIPE_TEXTURE_2D || templ->target == PIPE_TEXTURE_RECT) &&
+       rt_format && (templ->bind & PIPE_BIND_RENDER_TARGET) && !(templ->bind & bind_linear) &&
+       templ->width0 >= 8 && templ->height0 >= 8 && getenv("PVR_NO_TWIDDLE") == NULL &&
+       !force_linear) {
+      const unsigned cpp = util_format_get_blocksize(fmt);
+      twiddled = true;
+      phys_width = util_next_power_of_two(templ->width0);
+      phys_height = util_next_power_of_two(templ->height0);
+      stride = cpp * phys_width;
+      size = (uint64_t)stride * phys_height;
+      /* TFBC is only used on the plain RGBA8/BGRA8 colour targets (see NATIVE-TFBC-PORT.md). */
+      const struct pvr_device_info *dev_info = &screen->dev_info;
+      fbc = getenv("PVR_NO_FBC") == NULL &&
+            PVR_HAS_FEATURE(dev_info, tpu_image_state_v2) &&
+            PVR_GET_FEATURE_VALUE(dev_info, fbcdc_algorithm, 0) == 50 &&
+            (fmt == PIPE_FORMAT_R8G8B8A8_UNORM || fmt == PIPE_FORMAT_B8G8R8A8_UNORM);
+      if (fbc) {
+         fbc_header_size = ALIGN_POT(size / 32, 4096);
+         size += fbc_header_size;
+      }
+   } else if (!pvr_resource_layout(templ, &stride, &size)) {
       mesa_logd("pvr: no layout for target %u", templ->target);
       return NULL;
    }
+   if (rt_format && (templ->bind & PIPE_BIND_RENDER_TARGET) && templ->target != PIPE_BUFFER)
+      rt_created++;
 
    res = CALLOC_STRUCT(pvr_resource);
    if (!res)
@@ -85,6 +127,11 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
    pipe_reference_init(&res->base.reference, 1);
 
    res->stride = stride;
+   res->twiddled = twiddled;
+   res->phys_width = phys_width;
+   res->phys_height = phys_height;
+   res->fbc = fbc;
+   res->fbc_header_size = fbc_header_size;
 
    /* size 0 would be rejected by the kernel; an empty buffer is a real thing to ask
     * for, so give it one page rather than failing. */
@@ -107,6 +154,8 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
 
       if (!pvr_vm_map(&screen->vm, res->dev_addr, res->bo.handle, res->dev_size))
          goto fail_addr;
+      /* The PBE/TPU address the data, not the TFBC headers in front of it. */
+      res->data_addr = res->dev_addr + res->fbc_header_size;
    }
 
    return &res->base;
diff --git a/src/gallium/drivers/pvr_native/pvr_resource.h b/src/gallium/drivers/pvr_native/pvr_resource.h
index 07b5f513..ebe5abbb 100644
--- a/src/gallium/drivers/pvr_native/pvr_resource.h
+++ b/src/gallium/drivers/pvr_native/pvr_resource.h
@@ -30,9 +30,22 @@ struct pvr_resource {
    /* Bytes the device address covers, i.e. the page-aligned BO size. */
    uint64_t dev_size;
 
-   /* Bytes between rows, for the linear layout. */
+   /* Bytes between rows. For the twiddled layout this is cpp * phys_width (row pitch of the
+    * padded, power-of-two image). */
    uint32_t stride;
 
+   /* Twiddled layout: colour render targets are laid out with power-of-two physical extents and
+    * the TPU/PBE twiddle. Linear layouts are kept for buffers, depth and everything uploaded or
+    * read through the CPU. */
+   bool twiddled;
+   uint32_t phys_width, phys_height;
+
+   /* Lossless TFBC: twiddled colour targets are PBE-compressed 8x8 blocks, with an 8-byte header
+    * per block stored below the data. data_addr points past the header area. */
+   bool fbc;
+   uint64_t fbc_header_size;
+   uint64_t data_addr;
+
    /* The draw path's render sequence number of the last render that used this resource (0:
     * none). A CPU map waits only for a render that uses the resource. */
    uint32_t render_seq;
-- 
2.47.3

