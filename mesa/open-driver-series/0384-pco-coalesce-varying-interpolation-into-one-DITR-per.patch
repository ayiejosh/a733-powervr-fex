From fc226877ac121501c5c4f4474151ce31c969a302 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Mon, 2 Nov 2026 11:48:51 +0800
Subject: [PATCH] pco: coalesce varying interpolation into one DITR per shader

The translator emits one DITR/DITRP per load_interpolated_input, and the pre-RA
legalizer wraps every DITR in a fixed fence sequence (flush + 2 x br.next + wdf,
4 instruction groups). A fragment shader reading two smooth varyings therefore
pays two interpolation instructions and two fence sequences, where the hardware
can iterate all coefficients of one interpolation mode in a single DITR: the
vendor compiler emits one DITRP with count = 6 for glmark2's cel fragment shader
(captured USC, no fence groups around it).

Batch consecutive load_interpolated_input instructions in a block when they
share interpolation mode and iteration mode and their coefficient ranges are
adjacent (the driver allocates coefficient ranges in location order), emitting
one DITR/DITRP with count = total components and giving each original load a
pco_vec of components of the merged destination - the same vec/comp shape the
translator produces for other vectors, so RA's coalescing keeps it free. A
scalar member is assigned its component with a mov instead. Runs are split into
greedy adjacent chunks of at most 16 components (the iteration count is a 4-bit
field that wraps 16 to 0), so a 4 x vec4 shader is one instruction and a 5 x vec4
one is 16+4. Loads that cannot batch keep the single-load path: flat, 64-bit,
nonzero-offset, location-frac and VARYING_SLOT_POS loads are excluded
(16-bit I/O is widened to 32-bit before translation, so those batch like any
32-bit load), and interpolation modes are never mixed.

Measured with the offline pco harness (same compiler, no device) and on the
board against the previous pushed build (raw outputs in
open-perf/tasks/T-2026-11-02-codegen/runs/004-ditr-board/ and 005-review-fixes/):

  cel FS     GL path 62 -> 57 groups (768 -> 728 B, control 8 -> 4); offline
             63 -> 57 groups (49 main / 4 bitwise / 4 control)
  phong FS   GL path 42 -> 37 groups (488 -> 448 B, control 8 -> 4)
  gouraud/blinn FS unchanged (0-1 varying reads)
  one DITRP count=6 (cf4..27) + one fence sequence where there were two
  count=3 DITRPs + two sequences, and no added mbyp groups (temps 17 -> 19,
  RA coalesces the vec/comps, no spills)
  offline smoke test PASS (math 26, bump 34, nir-test 20, binary 280 bytes);
  a 16-component batch (4 x vec4) goes 35 -> 14 groups, two scalar varyings
  14 -> 8, and a 20-component run chunks 16+4 without spills

glmark2-es2 --off-screen, interleaved rounds, previous build -> this one:
shading phong 648/664 -> 680/680 fps (+3.6%), cel 554/565 -> 576/575 (+3.0%);
an earlier 3-round run of the same change measured +2.7% / +1.9%; loop and
conditionals are within run-to-run noise.

Correctness: native gate ALL GROUPS PASS (20/20 groups, build identity in the
gate log); loop/conditionals replay readbacks identical to the pre-change values
(18/217/167 for loop FragmentLoops 0/64, 54 for conditionals); a two-varying
test shader renders pixel-identically on both builds (centre pixel 64 64 255
255); and an assert-trap probe over the compiler (same NDEBUG ABI) shows the
scalar/16-component cases stay clean where the first version of this change
would have hit split_dest_comps()'s vector assert.
---
 src/imagination/pco/pco_trans_nir.c | 326 ++++++++++++++++++++++++++++
 1 file changed, 326 insertions(+)

diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index cb9b6211..526312cf 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -19,6 +19,7 @@
 #include <math.h>
 #include "pvr_iface.h"
 #include "util/bitset.h"
+#include "util/hash_table.h"
 #include "util/list.h"
 #include "util/macros.h"
 #include "util/ralloc.h"
@@ -39,6 +40,9 @@ typedef struct _trans_ctx {
 
    BITSET_WORD *float_types; /** NIR SSA float vars. */
    BITSET_WORD *int_types; /** NIR SSA int vars. */
+
+   /* Batched smooth/noperspective varying loads keyed by NIR instruction. */
+   struct hash_table_u64 *interp_batches;
 } trans_ctx;
 
 /* Forward declarations. */
@@ -658,6 +662,314 @@ static pco_instr *trans_load_input_fs(trans_ctx *tctx,
    }
 }
 
+/**
+ * \brief One batched varying-load run: several consecutive load_interpolated_input
+ *        instructions that one DITR/DITRP can produce.
+ *
+ * A DITR/DITRP iterates `count` coefficient sets, writing `count` consecutive
+ * destination registers. pco used to emit one instruction per NIR load, paying
+ * the 4-group DITR fence sequence per varying read; the vendor compiler emits a
+ * single DITRP for the whole fragment shader (count = all varying components),
+ * which is what this batching reproduces.
+ *
+ * This is pre-RA only: the loads themselves and the consumer refs are unchanged
+ * (each load's SSA becomes a pco_vec of comps of the merged DITRP), so RA's
+ * vec/comp coalescing keeps it free.
+ */
+#define MAX_INTERP_BATCH 8
+/* The hardware iteration count is a 4-bit field that wraps 16 to 0, so the legal
+ * values are 1..16; batches over this are split into chunks. */
+#define MAX_INTERP_COUNT 16
+
+struct interp_load_info {
+   unsigned coeffs_index; /** First coefficient register. */
+   unsigned chans; /** Destination components. */
+   enum pco_itr_mode itr_mode;
+   enum glsl_interp_mode interp_mode;
+};
+
+struct interp_batch {
+   unsigned n_loads;
+   nir_instr *loads[MAX_INTERP_BATCH];
+   struct interp_load_info info[MAX_INTERP_BATCH];
+   unsigned total_chans;
+   enum pco_itr_mode itr_mode;
+   enum glsl_interp_mode interp_mode;
+   bool emitted;
+};
+
+/**
+ * \brief Whether one NIR load can be part of an interpolation batch.
+ *
+ * Mirrors the checks trans_load_input_fs() makes before emitting DITR/DITRP;
+ * anything unusual (VARYING_SLOT_POS z/w, flat, 16-bit, non-zero offsets) is
+ * left to the normal single-load path.
+ */
+static bool
+get_interp_load_info(trans_ctx *tctx, nir_intrinsic_instr *intr,
+                     struct interp_load_info *info)
+{
+   if (intr->intrinsic != nir_intrinsic_load_interpolated_input)
+      return false;
+
+   pco_fs_data *fs_data = &tctx->shader->data.fs;
+   unsigned component = nir_intrinsic_component(intr);
+   unsigned chans = intr->def.num_components;
+
+   if (intr->def.bit_size != 32 || chans == 0 || chans > 4)
+      return false;
+
+   struct nir_io_semantics io_semantics = nir_intrinsic_io_semantics(intr);
+   gl_varying_slot location = io_semantics.location;
+
+   if (location == VARYING_SLOT_POS || location >= VARYING_SLOT_MAX)
+      return false;
+
+   if (!nir_src_is_const(intr->src[1]) || nir_src_as_uint(intr->src[1]) != 0)
+      return false;
+
+   nir_variable *var = nir_find_variable_with_location(tctx->shader->nir,
+                                                       nir_var_shader_in,
+                                                       location);
+   if (!var || var->data.location_frac)
+      return false;
+
+   assert(!(var->data.sample && var->data.centroid));
+
+   /* Same authority as trans_load_input_fs(): the interpolation mode of the
+    * barycentric load, not the variable (Vulkan/NIR may leave both NONE). */
+   nir_intrinsic_instr *bary = nir_src_as_intrinsic(intr->src[0]);
+   if (!bary || !nir_intrinsic_has_interp_mode(bary))
+      return false;
+
+   enum glsl_interp_mode interp_mode = nir_intrinsic_interp_mode(bary);
+   if (interp_mode != INTERP_MODE_SMOOTH &&
+       interp_mode != INTERP_MODE_NOPERSPECTIVE)
+      return false;
+
+   enum pco_itr_mode itr_mode = PCO_ITR_MODE_PIXEL;
+
+   switch (bary->intrinsic) {
+   case nir_intrinsic_load_barycentric_pixel:
+      itr_mode = PCO_ITR_MODE_PIXEL;
+      break;
+   case nir_intrinsic_load_barycentric_sample:
+      itr_mode = PCO_ITR_MODE_SAMPLE;
+      break;
+   case nir_intrinsic_load_barycentric_centroid:
+      itr_mode = PCO_ITR_MODE_CENTROID;
+      break;
+   default:
+      return false;
+   }
+
+   const pco_range *range = &fs_data->varyings[location];
+   if (component + ROGUE_USC_COEFFICIENT_SET_SIZE * chans > range->count)
+      return false;
+
+   info->coeffs_index =
+      range->start + ROGUE_USC_COEFFICIENT_SET_SIZE * component;
+   info->chans = chans;
+   info->itr_mode = itr_mode;
+   info->interp_mode = interp_mode;
+   return true;
+}
+
+/**
+ * \brief Emits one merged DITR/DITRP plus a pco_vec per original load.
+ *
+ * The merged instruction writes total_chans consecutive registers; each load's
+ * NIR def becomes a vector of the matching comps of that destination, which is
+ * the same vec/comp shape the translator produces for any other vector value
+ * (RA coalesces comps back to the parent register).
+ */
+static void
+trans_emit_interp_batch(trans_ctx *tctx, struct interp_batch *batch)
+{
+   pco_fs_data *fs_data = &tctx->shader->data.fs;
+
+   batch->emitted = true;
+
+   pco_ref coeffs = pco_ref_hwreg_vec(batch->info[0].coeffs_index,
+                                      PCO_REG_CLASS_COEFF,
+                                      ROGUE_USC_COEFFICIENT_SET_SIZE *
+                                         batch->total_chans);
+
+   pco_ref wcoeffs = pco_ref_null();
+   if (batch->interp_mode == INTERP_MODE_SMOOTH) {
+      /* Same authority as the single-load path: smooth interpolation reads the
+       * w coefficients the driver's coefficient program fills. */
+      assert(fs_data->uses.w);
+      unsigned wcoeffs_index = fs_data->uses.z ? ROGUE_USC_COEFFICIENT_SET_SIZE
+                                               : 0;
+      wcoeffs = pco_ref_hwreg_vec(wcoeffs_index, PCO_REG_CLASS_COEFF,
+                                  ROGUE_USC_COEFFICIENT_SET_SIZE);
+   }
+
+   bool usc_itrsmp_enhanced =
+      PVR_HAS_FEATURE(tctx->pco_ctx->dev_info, usc_itrsmp_enhanced);
+
+   pco_ref dest = pco_ref_new_ssa(tctx->func, 32, batch->total_chans);
+   pco_instr *itr = build_itr(&tctx->b, dest, PCO_DRC_0, coeffs, wcoeffs,
+                              batch->total_chans, batch->itr_mode,
+                              usc_itrsmp_enhanced);
+   split_dest_comps(tctx, itr, dest);
+
+   pco_vec_info *vec_info =
+      _mesa_hash_table_u64_search(tctx->func->vec_infos, dest.val);
+   assert(vec_info);
+
+   unsigned offset = 0;
+   for (unsigned u = 0; u < batch->n_loads; ++u) {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(batch->loads[u]);
+      pco_ref load_dest = pco_ref_nir_def_t(&intr->def, tctx);
+      unsigned chans = batch->info[u].chans;
+
+      pco_ref comps[NIR_MAX_VEC_COMPONENTS] = { 0 };
+      for (unsigned c = 0; c < chans; ++c)
+         comps[c] = vec_info->comps[offset + c]->dest[0];
+
+      if (chans == 1) {
+         /* split_dest_comps() only handles vectors; a scalar load's def is the
+          * comp itself (the move folds in RA/opt). */
+         pco_mov(&tctx->b, load_dest, comps[0]);
+      } else {
+         pco_instr *vec = pco_vec(&tctx->b, load_dest, chans, comps);
+         split_dest_comps(tctx, vec, load_dest);
+      }
+
+      offset += chans;
+   }
+}
+
+/**
+ * Whether an instruction between two varying loads does not break a batch:
+ * barycentric loads emit nothing, and the load-offset constants are pure and
+ * position-independent (NIR hoists one zero constant before each load).
+ */
+static bool is_transparent_between_loads(const nir_instr *instr)
+{
+   if (instr->type == nir_instr_type_load_const)
+      return true;
+
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+
+   switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+   case nir_intrinsic_load_barycentric_pixel:
+   case nir_intrinsic_load_barycentric_sample:
+   case nir_intrinsic_load_barycentric_centroid:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static void
+trans_finish_interp_batch(trans_ctx *tctx, nir_instr **loads,
+                          struct interp_load_info *infos, unsigned n)
+{
+   if (n < 2)
+      return;
+
+   /* Sort by coefficient register: the merged DITR iterates ascending. */
+   unsigned order[MAX_INTERP_BATCH];
+   for (unsigned u = 0; u < n; ++u)
+      order[u] = u;
+
+   for (unsigned u = 1; u < n; ++u) {
+      unsigned cur = order[u], v = u;
+      while (v > 0 && infos[order[v - 1]].coeffs_index > infos[cur].coeffs_index) {
+         order[v] = order[v - 1];
+         --v;
+      }
+      order[v] = cur;
+   }
+
+   /* One instruction can iterate at most MAX_INTERP_COUNT coefficients, and the
+    * run can contain gaps where the driver's coefficient allocation is not
+    * adjacent: emit one merged instruction per adjacent, under-the-limit chunk
+    * of at least two loads. */
+   for (unsigned u = 0; u < n;) {
+      unsigned end = u, chunk_chans = 0;
+
+      while (end < n) {
+         const struct interp_load_info *info = &infos[order[end]];
+         if (end > u) {
+            const struct interp_load_info *prev = &infos[order[end - 1]];
+            if (info->coeffs_index !=
+                prev->coeffs_index + ROGUE_USC_COEFFICIENT_SET_SIZE * prev->chans)
+               break;
+         }
+         if (chunk_chans + info->chans > MAX_INTERP_COUNT)
+            break;
+         chunk_chans += info->chans;
+         ++end;
+      }
+
+      if (end - u >= 2) {
+         struct interp_batch *batch = rzalloc_size(tctx->func, sizeof(*batch));
+         batch->n_loads = end - u;
+         batch->total_chans = chunk_chans;
+         batch->itr_mode = infos[order[u]].itr_mode;
+         batch->interp_mode = infos[order[u]].interp_mode;
+
+         for (unsigned k = 0; k < batch->n_loads; ++k) {
+            batch->loads[k] = loads[order[u + k]];
+            batch->info[k] = infos[order[u + k]];
+         }
+
+         /* Keyed by the NIR intrinsic, which is the first member of nir_instr;
+          * trans_intr() looks up &intr->instr. */
+         for (unsigned k = 0; k < batch->n_loads; ++k)
+            _mesa_hash_table_u64_insert(tctx->interp_batches,
+                                        (uintptr_t)batch->loads[k], batch);
+      }
+
+      u = end;
+   }
+}
+
+/** Finds and registers interpolation batches for one NIR block. */
+static void trans_scan_interp_batches(trans_ctx *tctx, nir_block *nblock)
+{
+   if (tctx->interp_batches != NULL)
+      _mesa_hash_table_u64_destroy(tctx->interp_batches);
+   tctx->interp_batches = _mesa_hash_table_u64_create(tctx->func);
+
+   nir_instr *loads[MAX_INTERP_BATCH];
+   struct interp_load_info infos[MAX_INTERP_BATCH];
+   unsigned n = 0;
+
+   nir_foreach_instr (instr, nblock) {
+      struct interp_load_info info;
+      bool ok = instr->type == nir_instr_type_intrinsic &&
+                get_interp_load_info(tctx, nir_instr_as_intrinsic(instr),
+                                     &info);
+
+      if (!ok && is_transparent_between_loads(instr))
+         continue;
+
+      if (!ok || (n > 0 && (infos[0].itr_mode != info.itr_mode ||
+                            infos[0].interp_mode != info.interp_mode))) {
+         trans_finish_interp_batch(tctx, loads, infos, n);
+         n = 0;
+         if (!ok)
+            continue;
+      }
+
+      loads[n] = instr;
+      infos[n] = info;
+      ++n;
+      if (n == MAX_INTERP_BATCH) {
+         trans_finish_interp_batch(tctx, loads, infos, n);
+         n = 0;
+      }
+   }
+
+   trans_finish_interp_batch(tctx, loads, infos, n);
+}
+
 static pco_instr *
 trans_load_fs_coeffs(trans_ctx *tctx, nir_intrinsic_instr *intr, pco_ref dest)
 {
@@ -2635,6 +2947,18 @@ static pco_instr *trans_is_null_desc(trans_ctx *tctx,
  */
 static pco_instr *trans_intr(trans_ctx *tctx, nir_intrinsic_instr *intr)
 {
+   if (tctx->interp_batches &&
+       intr->intrinsic == nir_intrinsic_load_interpolated_input) {
+      struct interp_batch *batch = _mesa_hash_table_u64_search(
+         tctx->interp_batches, (uintptr_t)&intr->instr);
+
+      if (batch) {
+         if (!batch->emitted)
+            trans_emit_interp_batch(tctx, batch);
+         return NULL;
+      }
+   }
+
    const nir_intrinsic_info *info = &nir_intrinsic_infos[intr->intrinsic];
 
    pco_ref dest = info->has_dest ? pco_ref_nir_def_t(&intr->def, tctx)
@@ -4740,6 +5064,8 @@ static pco_block *trans_block(trans_ctx *tctx,
 
    tctx->b = pco_builder_create(tctx->func, pco_cursor_after_block(block));
 
+   trans_scan_interp_batches(tctx, nblock);
+
    nir_foreach_instr (ninstr, nblock) {
       trans_instr(tctx, ninstr);
    }
