          data.fs.output_formats[FRAG_RESULT_DATA0 + i] = color_formats[i];
          data.fs.outputs[FRAG_RESULT_DATA0 + i] = (pco_range){ .start = output_start,
                                                               .count = dwords };
          output_start += dwords;
       }
