+      /* Blending is lowered into the shader (pco runs nir_lower_blend with these; it skips the
+       * NONE format of a GL_NONE draw buffer, so output 0 may be one). */
+      bool any_format = false;
+      for (unsigned i = 0; i < MIN2(nr_formats, PVR_MAX_COLOR_ATTACHMENTS); i++)
+         any_format |= color_formats[i] != PIPE_FORMAT_NONE;
+      if (blend != NULL && any_format) {
          data.fs.blend_opts = *blend;
          for (unsigned i = 0; i < MIN2(nr_formats, PVR_MAX_COLOR_ATTACHMENTS); i++)
             data.fs.blend_opts.rt[i].format = color_formats[i];
@@ -781,9 +786,9 @@ pvr_shader_compile_data_with(pco_ctx *ctx, struct nir_shader *nir, pco_data *dat
     * map work on DATA0..7, as the Vulkan driver's shaders do. */
    if (nir->info.stage == MESA_SHADER_FRAGMENT) {
       unsigned nr_out = 1;
-      while (nr_out < PVR_MAX_COLOR_ATTACHMENTS &&
-             data->fs.output_formats[FRAG_RESULT_DATA0 + nr_out] != PIPE_FORMAT_NONE)
-         nr_out++;
+      for (unsigned i = 1; i < PVR_MAX_COLOR_ATTACHMENTS; i++)
