diff --git a/src/gallium/drivers/pvr/pvr_probe.c b/src/gallium/drivers/pvr/pvr_probe.c
index 679381eb..8d59b1e5 100644
--- a/src/gallium/drivers/pvr/pvr_probe.c
+++ b/src/gallium/drivers/pvr/pvr_probe.c
@@ -22,6 +22,7 @@
 
 #include "pvr_bo.h"
 #include "pvr_csb.h"
+#include "pvr_static.h"
 #include "pvr_context.h"
 
 #include "util/u_inlines.h"
@@ -29,6 +30,9 @@
 #include "pvr_shader.h"
 
 #include "nir_builder.h"
+
+#include "pco/pco_data.h"
+#include "pco_uscgen_programs.h"
 #include "pvr_resource.h"
 #include "pvr_vm.h"
 #include "pvr_public.h"
@@ -112,7 +116,7 @@ out:
  * it can be exercised without the real kernel module, because the shim does not
  * implement the VM ioctls. */
 static bool
-vm_roundtrip(int fd)
+vm_roundtrip(int fd, const struct pvr_device_info *dev_info)
 {
    struct pvr_vm vm;
    struct pvr_bo a = { 0 }, b = { 0 };
@@ -304,6 +308,73 @@ vm_roundtrip(int fd)
       pvr_bo_destroy(fd, &carveout_bo);
    }
 
+   /* The firmware programs the GPU expects to already be in place. What matters is not
+    * that bytes were written but that they landed at the kernel's own addresses: a
+    * program at the wrong offset is executed as something else entirely. The strongest
+    * check available is therefore to compare the carveout contents against the source
+    * binary, which tests the placement rather than merely the write. */
+   {
+      struct pvr_static_memory sm;
+      const unsigned usc_slot = 2; /* GENERAL, PDS, USC as pvr_static_heaps orders them */
+      const pco_precomp_data *precomp =
+         (const pco_precomp_data *)pco_usclib_common[VS_NOP_COMMON];
+
+      if (!pvr_static_memory_init(&vm, dev_info, &sm)) {
+         printf("vm:            FAIL: could not place the firmware programs\n");
+         goto out;
+      }
+
+      if (sm.program_bytes == 0) {
+         printf("vm:            FAIL: no firmware program bytes were written\n");
+         pvr_static_memory_fini(&vm, &sm);
+         goto out;
+      }
+
+      if (precomp != NULL) {
+         const uint64_t usc_off = vm.offsets[DRM_PVR_HEAP_USC_CODE].vdm_sync;
+         const uint32_t bytes = precomp->size_dwords * sizeof(uint32_t);
+
+         if (usc_off == PVR_STATIC_ABSENT ||
+             memcmp((const uint8_t *)sm.map[usc_slot] + usc_off, precomp->binary,
+                    bytes) != 0) {
+            printf("vm:            FAIL: the VDM sync program is not at the USC heap's "
+                   "vdm_sync offset\n");
+            pvr_static_memory_fini(&vm, &sm);
+            goto out;
+         }
+      }
+
+      /* The PDS launcher and the pixel-event program are generated, not copied, so they
+       * are checked for having been produced at all rather than compared byte-for-byte.
+       * A generator that silently wrote nothing would otherwise look like success. */
+      {
+         const uint64_t pds_sync = vm.offsets[DRM_PVR_HEAP_PDS_CODE_DATA].vdm_sync;
+         const uint64_t pds_eot = vm.offsets[DRM_PVR_HEAP_PDS_CODE_DATA].eot;
+         const uint8_t *pds_map = sm.map[1];
+         bool launcher = false, eot = false;
+
+         for (unsigned b = 0; b < 64; b++) {
+            if (pds_map[pds_sync + b] != 0)
+               launcher = true;
+            if (pds_map[pds_eot + b] != 0)
+               eot = true;
+         }
+
+         if (!launcher || !eot) {
+            printf("vm:            FAIL: a generated PDS program is empty (launcher %s, "
+                   "eot %s)\n", launcher ? "written" : "EMPTY",
+                   eot ? "written" : "EMPTY");
+            pvr_static_memory_fini(&vm, &sm);
+            goto out;
+         }
+      }
+
+      printf("vm:            firmware programs: VDM sync verified at the kernel's USC "
+             "vdm_sync offset, PDS launcher and pixel-event programs generated "
+             "(%u bytes counted)\n", sm.program_bytes);
+      pvr_static_memory_fini(&vm, &sm);
+   }
+
    printf("vm:            mapped and unmapped 0x%" PRIx64 " (%" PRIu64 " bytes); "
           "second address 0x%" PRIx64 "\n", addr_a, size, addr_b);
    ok = true;
@@ -1043,7 +1114,7 @@ main(int argc, char **argv)
 
    /* Before destroying the screen, which closes the fd. */
    const bool bo_pass = bo_roundtrip(fd);
-   const bool vm_pass = vm_roundtrip(fd);
+   const bool vm_pass = vm_roundtrip(fd, &pvr_screen(screen)->dev_info);
    const bool csb_pass = csb_check(fd);
    const bool clear_pass = clear_check(screen);
    const bool res_pass = resource_roundtrip(screen);
diff --git a/src/gallium/drivers/pvr/pvr_static.c b/src/gallium/drivers/pvr/pvr_static.c
new file mode 100644
index 00000000..9fc25fc8
--- /dev/null
+++ b/src/gallium/drivers/pvr/pvr_static.c
@@ -0,0 +1,189 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#include "pvr_static.h"
+
+#include <inttypes.h>
+#include <string.h>
+
+#include "drm-uapi/pvr_drm.h"
+
+#include "common/pvr_device_info.h"
+#include "pco/pco_data.h"
+#include "pco_uscgen_programs.h"
+#include "pvr_pds.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+
+#include "pvr_csb.h"
+#include "pvr_vm.h"
+
+/* The three heaps that carry firmware carveouts, in the order the kernel numbers them. */
+static const uint16_t pvr_static_heaps[3] = {
+   DRM_PVR_HEAP_GENERAL,
+   DRM_PVR_HEAP_PDS_CODE_DATA,
+   DRM_PVR_HEAP_USC_CODE,
+};
+
+static unsigned
+pvr_heap_slot(uint16_t heap_id)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(pvr_static_heaps); i++) {
+      if (pvr_static_heaps[i] == heap_id)
+         return i;
+   }
+
+   return ARRAY_SIZE(pvr_static_heaps);
+}
+
+/* The VDM sync program: a precompiled USC binary, plus the PDS program that launches it.
+ * Both halves are needed - the USC code is what runs, the PDS program is what makes the
+ * PDS start it. */
+static bool
+pvr_fill_vdm_sync(struct pvr_vm *vm, struct pvr_static_memory *sm)
+{
+   const unsigned pds_slot = pvr_heap_slot(DRM_PVR_HEAP_PDS_CODE_DATA);
+   const unsigned usc_slot = pvr_heap_slot(DRM_PVR_HEAP_USC_CODE);
+   const uint64_t pds_offset = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].vdm_sync;
+   const uint64_t usc_offset = vm->offsets[DRM_PVR_HEAP_USC_CODE].vdm_sync;
+   const pco_precomp_data *precomp;
+   struct pvr_pds_kickusc_program program = { 0 };
+   uint32_t *pds_dst;
+   uint32_t size_dwords;
+   uint32_t size_bytes;
+
+   if (pds_offset == PVR_STATIC_ABSENT || usc_offset == PVR_STATIC_ABSENT) {
+      mesa_loge("pvr: no VDM sync area in the PDS or USC heap");
+      return false;
+   }
+
+   precomp = (const pco_precomp_data *)pco_usclib_common[VS_NOP_COMMON];
+   if (precomp == NULL) {
+      mesa_loge("pvr: the precompiled VDM sync program is missing");
+      return false;
+   }
+
+   size_dwords = precomp->size_dwords;
+   size_bytes = size_dwords * sizeof(uint32_t);
+
+   if (usc_offset + size_bytes > sm->bo[usc_slot].size ||
+       pds_offset + size_bytes > sm->bo[pds_slot].size) {
+      mesa_loge("pvr: the VDM sync program (%u bytes) does not fit its areas",
+                size_bytes);
+      return false;
+   }
+
+   memcpy((uint8_t *)sm->map[usc_slot] + usc_offset, precomp->binary, size_bytes);
+
+   /* The PDS side points at where the USC code was just written - an offset within the
+    * USC heap, which is what the hardware's doutu instruction takes. */
+   pvr_pds_setup_doutu(&program.usc_task_control, usc_offset, precomp->temps,
+                       ROGUE_PDSINST_DOUTU_SAMPLE_RATE_INSTANCE, false);
+
+   pds_dst = (uint32_t *)((uint8_t *)sm->map[pds_slot] + pds_offset);
+   pvr_pds_kick_usc(&program, pds_dst, 0, false, PDS_GENERATE_CODEDATA_SEGMENTS);
+
+   sm->program_bytes += size_bytes;
+
+   mesa_logd("pvr: VDM sync: %u bytes of USC at +0x%" PRIx64
+             ", PDS launcher at +0x%" PRIx64, size_bytes, usc_offset, pds_offset);
+
+   return true;
+}
+
+/* The pixel-event (end of tile) program the firmware runs when a tile completes. */
+static bool
+pvr_fill_pixel_event(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                     struct pvr_static_memory *sm)
+{
+   const unsigned pds_slot = pvr_heap_slot(DRM_PVR_HEAP_PDS_CODE_DATA);
+   const uint64_t eot_offset = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].eot;
+   struct pvr_pds_event_program program = { 0 };
+   uint32_t *dst;
+   uint32_t *end;
+   unsigned size;
+
+   if (eot_offset == PVR_STATIC_ABSENT) {
+      mesa_loge("pvr: no EOT area in the PDS heap");
+      return false;
+   }
+
+   dst = (uint32_t *)((uint8_t *)sm->map[pds_slot] + eot_offset);
+
+   /* Returns where the next constant would go, so the program's size is the distance
+    * from where it was written - there is no separate size out-parameter. */
+   end = pvr_pds_generate_pixel_event(&program, dst, PDS_GENERATE_CODE_SEGMENT,
+                                      dev_info);
+   size = (uint8_t *)end - (uint8_t *)dst;
+
+   if (size == 0) {
+      mesa_loge("pvr: could not generate the pixel-event program");
+      return false;
+   }
+
+   if (eot_offset + size > sm->bo[pds_slot].size) {
+      mesa_loge("pvr: the pixel-event program (%u bytes) does not fit the EOT area",
+                size);
+      return false;
+   }
+
+   sm->program_bytes += size;
+
+   mesa_logd("pvr: pixel-event program: %u bytes at PDS +0x%" PRIx64, size, eot_offset);
+
+   return true;
+}
+
+bool
+pvr_static_memory_init(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                       struct pvr_static_memory *sm)
+{
+   memset(sm, 0, sizeof(*sm));
+
+   /* Reserve and map each carveout first: the programs are written through the CPU
+    * mapping and read by the GPU from the same memory, so it has to be mapped before
+    * anything is placed in it. */
+   for (unsigned i = 0; i < ARRAY_SIZE(pvr_static_heaps); i++) {
+      const uint16_t heap_id = pvr_static_heaps[i];
+
+      if (!pvr_vm_alloc_carveout(vm, heap_id, &sm->bo[i], &sm->base[i]))
+         goto fail;
+
+      if (!pvr_bo_map(vm->fd, &sm->bo[i]))
+         goto fail;
+
+      sm->map[i] = sm->bo[i].map;
+      sm->present[i] = true;
+   }
+
+   if (!pvr_fill_vdm_sync(vm, sm))
+      goto fail;
+
+   if (!pvr_fill_pixel_event(vm, dev_info, sm))
+      goto fail;
+
+   mesa_logi("pvr: static memory: %u bytes of firmware programs in 3 carveouts",
+             sm->program_bytes);
+
+   return true;
+
+fail:
+   pvr_static_memory_fini(vm, sm);
+   return false;
+}
+
+void
+pvr_static_memory_fini(struct pvr_vm *vm, struct pvr_static_memory *sm)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(pvr_static_heaps); i++) {
+      if (!sm->present[i])
+         continue;
+
+      pvr_vm_unmap(vm, sm->base[i], sm->bo[i].size);
+      pvr_bo_destroy(vm->fd, &sm->bo[i]);
+      sm->present[i] = false;
+   }
+
+   sm->program_bytes = 0;
+}
diff --git a/src/gallium/drivers/pvr/pvr_static.h b/src/gallium/drivers/pvr/pvr_static.h
new file mode 100644
index 00000000..b4bd8f9e
--- /dev/null
+++ b/src/gallium/drivers/pvr/pvr_static.h
@@ -0,0 +1,42 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The firmware's static memory.
+ *
+ * The GPU expects certain programs to already be sitting at fixed addresses inside the
+ * carveouts before a context can be created: a VDM sync program (USC code plus the PDS
+ * program that launches it) and the pixel-event/EOT program. Their addresses come from
+ * the kernel's static-data table, and a program written at the wrong one is executed as
+ * something else entirely - so the offsets are taken from the table rather than chosen.
+ *
+ * The PDS program generators come from libpowervr_pds and the USC binary from the pco
+ * USC library: both are reused, neither is restated here.
+ */
+#ifndef PVR_STATIC_H
+#define PVR_STATIC_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "pvr_bo.h"
+
+struct pvr_vm;
+struct pvr_device_info;
+
+struct pvr_static_memory {
+   /* One buffer per heap that has a carveout, kept mapped: firmware programs are written
+    * through the CPU mapping and read by the GPU from the same memory. */
+   struct pvr_bo bo[3];
+   void *map[3];
+   uint64_t base[3];
+   bool present[3];
+
+   unsigned program_bytes; /* total written, for the log and the check */
+};
+
+bool pvr_static_memory_init(struct pvr_vm *vm,
+                            const struct pvr_device_info *dev_info,
+                            struct pvr_static_memory *sm);
+void pvr_static_memory_fini(struct pvr_vm *vm, struct pvr_static_memory *sm);
+
+#endif /* PVR_STATIC_H */
-- 
