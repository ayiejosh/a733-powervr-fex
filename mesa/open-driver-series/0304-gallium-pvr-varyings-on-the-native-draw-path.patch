index 78a9d98b..b9e88847 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.c
+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -480,13 +480,13 @@ pvr_csb_emit_ta_pds_sizeinfo(struct pvr_csb *csb, const struct pvr_pds_sizes *si
    const uint32_t words = ROGUE_TA_STATE_PDS_SIZEINFO1_length +
                           ROGUE_TA_STATE_PDS_SIZEINFO2_length;
    struct ROGUE_TA_STATE_PDS_SIZEINFO1 info1 = {
-      .pds_uniformsize = DIV_ROUND_UP(sizes->uniform_bytes,
+      .pds_uniformsize = DIV_ROUND_UP(sizes->uniform_dwords,
          ROGUE_TA_STATE_PDS_SIZEINFO1_PDS_UNIFORMSIZE_UNIT_SIZE),
-      .pds_texturestatesize = DIV_ROUND_UP(sizes->texturestate_bytes,
+      .pds_texturestatesize = DIV_ROUND_UP(sizes->texturestate_dwords,
          ROGUE_TA_STATE_PDS_SIZEINFO1_PDS_TEXTURESTATESIZE_UNIT_SIZE),
-      .pds_varyingsize = DIV_ROUND_UP(sizes->varying_bytes,
+      .pds_varyingsize = DIV_ROUND_UP(sizes->varying_dwords,
          ROGUE_TA_STATE_PDS_SIZEINFO1_PDS_VARYINGSIZE_UNIT_SIZE),
-      .usc_varyingsize = DIV_ROUND_UP(sizes->usc_varying_bytes,
+      .usc_varyingsize = DIV_ROUND_UP(sizes->usc_varying_dwords,
          ROGUE_TA_STATE_PDS_SIZEINFO1_USC_VARYINGSIZE_UNIT_SIZE),
       .pds_tempsize = DIV_ROUND_UP(sizes->temp_count,
          ROGUE_TA_STATE_PDS_SIZEINFO1_PDS_TEMPSIZE_UNIT_SIZE),
@@ -1054,6 +1054,7 @@ pvr_csb_emit_ta_state_header(struct pvr_csb *csb, const struct pvr_ta_presence *
       .pres_ispctl_bb = pres->ispctl_bb,
       .pres_ispctl_dbsc = pres->ispctl_dbsc,
