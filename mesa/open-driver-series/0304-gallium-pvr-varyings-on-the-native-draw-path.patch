index e72e70db..31d3aad7 100644
--- a/src/gallium/drivers/pvr_native/pvr_probe.c
+++ b/src/gallium/drivers/pvr_native/pvr_probe.c
@@ -1014,7 +1014,7 @@ real_job_done:
                         const struct ROGUE_TA_STATE_ISPDBSC dbsc = { 0 };
                         const struct pvr_pds_sizes pds_sizes = {
                            /* No uniform/coefficient/texture-state programs yet. */
-                           .usc_varying_bytes = g_fs_shader->coeffs * 4,
+                           .usc_varying_dwords = g_fs_shader->coeffs,
                            .usc_shared_count = g_fs_shader->shareds,
                         };
                         const struct pvr_viewport_words vp = {
diff --git a/src/gallium/drivers/pvr_native/pvr_screen.c b/src/gallium/drivers/pvr_native/pvr_screen.c
index 2e244a18..d61017ab 100644
--- a/src/gallium/drivers/pvr_native/pvr_screen.c
+++ b/src/gallium/drivers/pvr_native/pvr_screen.c
@@ -189,6 +189,9 @@ pvr_screen_create(int fd, const struct pipe_screen_config *config,
        * Reporting the hardware's full texture capability here would be claiming
        * features the resource code would reject. */
       caps->max_texture_2d_size = rogue_get_render_size_max(&screen->dev_info);
+      /* Varying vec4 slots between stages. ES2 needs 8; each one is one DOUTI iterator of the
+       * coefficient program (pvr_draw.c), well under PVR_MAXIMUM_ITERATIONS. */
+      caps->max_varyings = 16;
       caps->max_texture_cube_levels = 0;
       caps->max_texture_3d_levels = 0;
       caps->max_texture_array_layers = 1;
@@ -287,6 +290,8 @@ pvr_screen_create(int fd, const struct pipe_screen_config *config,
       sc->max_tex_instructions = 512;
       sc->max_tex_indirections = 8;
       sc->max_inputs = 16;
+      /* Position, point size and the varyings. */
+      sc->max_outputs = 18;
       sc->max_temps = 64;
       sc->max_const_buffer0_size = 1024;
       sc->max_const_buffers = 4;
@@ -301,6 +306,8 @@ pvr_screen_create(int fd, const struct pipe_screen_config *config,
       sc->max_tex_instructions = 512;
       sc->max_tex_indirections = 8;
       sc->max_inputs = 16;
+      /* One colour target. */
+      sc->max_outputs = 1;
       sc->max_temps = 64;
       sc->max_const_buffer0_size = 1024;
       sc->max_const_buffers = 4;
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.c b/src/gallium/drivers/pvr_native/pvr_shader.c
index bf5213b9..56284bb0 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.c
+++ b/src/gallium/drivers/pvr_native/pvr_shader.c
@@ -98,6 +98,28 @@ pvr_shader_alloc_sysval(pco_range *ranges, unsigned *counter, unsigned location,
    *counter += count;
 }
 
+/* Fragment inputs, as the Vulkan driver's pvr_alloc_fs_varyings: z/w first, then each varying slot
+ * in location order, ROGUE_USC_COEFFICIENT_SET_SIZE coefficient registers per component. */
+static void
+pvr_shader_init_fs_alloc(struct nir_shader *nir, pco_data *data)
+{
+   uint64_t vars_mask = nir->info.inputs_read & BITFIELD64_RANGE(VARYING_SLOT_VAR0, MAX_VARYING);
+   const unsigned zw_count = !!data->fs.uses.z + !!data->fs.uses.w;
+
+   pvr_shader_alloc_sysval(data->fs.varyings, &data->common.coeffs, VARYING_SLOT_POS,
+                           zw_count * ROGUE_USC_COEFFICIENT_SET_SIZE);
+   while (vars_mask) {
+      const int location = u_bit_scan64(&vars_mask);
+      unsigned slots = 0;
+      nir_foreach_variable_with_modes (var, nir, nir_var_shader_in) {
+         if (var->data.location == location)
+            slots += glsl_count_dword_slots(var->type, false);
+      }
+      pvr_shader_alloc_sysval(data->fs.varyings, &data->common.coeffs, location,
+                              slots * ROGUE_USC_COEFFICIENT_SET_SIZE);
+   }
+}
+
 /* The vertex-input and varying maps, ported from the Vulkan driver's
  * pvr_alloc_vs_sysvals/pvr_alloc_vs_attribs/pvr_alloc_vs_varyings. The ordering there is
  * load-bearing on this hardware - varyings are grouped by interpolation mode and the last slots
@@ -268,6 +290,29 @@ pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, enum pipe_format co
       shader->vtxins = data.common.vtxins;
    }
    shader->vtxouts = data.vs.vtxouts;
+   if (nir->info.stage == MESA_SHADER_VERTEX) {
+      for (unsigned l = 0; l < ARRAY_SIZE(shader->varyings); l++) {
+         shader->varyings[l].start = data.vs.varyings[l].start;
+         shader->varyings[l].count = data.vs.varyings[l].count;
+      }
+      shader->f32_smooth = data.vs.f32_smooth;
+      shader->f32_flat = data.vs.f32_flat;
+      shader->f32_npc = data.vs.f32_npc;
+   }
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      shader->varyings_read =
+         nir->info.inputs_read & BITFIELD64_RANGE(VARYING_SLOT_VAR0, MAX_VARYING);
+      for (unsigned l = 0; l < ARRAY_SIZE(shader->varyings); l++) {
+         shader->varyings[l].start = data.fs.varyings[l].start;
+         shader->varyings[l].count = data.fs.varyings[l].count;
+      }
+      nir_foreach_variable_with_modes (var, nir, nir_var_shader_in) {
+         if (var->data.location >= 0 && var->data.location < ARRAY_SIZE(shader->varyings))
+            shader->varyings[var->data.location].interp = var->data.interpolation;
+      }
+      shader->uses_z = data.fs.uses.z;
+      shader->uses_w = data.fs.uses.w;
+   }
 
    if (nir->info.stage == MESA_SHADER_FRAGMENT) {
       shader->shareds = data.common.shareds;
@@ -580,6 +625,8 @@ pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
 
    if (nir->info.stage == MESA_SHADER_VERTEX)
       pvr_shader_init_vs_alloc(nir, data);
+   if (nir->info.stage == MESA_SHADER_FRAGMENT)
+      pvr_shader_init_fs_alloc(nir, data);
 
    /* The colour output goes to output register 0, sized for the target format (Vulkan's
     * pvr_setup_fs_outputs with one output-register MRT). */
