diff --git a/src/gallium/drivers/pvr_native/pvr_csb.h b/src/gallium/drivers/pvr_native/pvr_csb.h
index d2f56c5a..41797178 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.h
+++ b/src/gallium/drivers/pvr_native/pvr_csb.h
@@ -289,6 +289,7 @@ struct pvr_ta_presence {
    bool ispctl_bb;
    bool ispctl_dbsc;
    bool pds_state_ptr0;  /* SHADERBASE, TEXUNICODEBASE, SIZEINFO1, SIZEINFO2 */
+   bool pds_state_ptr1;  /* VARYINGBASE: the coefficient (varying) program */
    bool pds_state_ptr3;  /* UNIFORMDATABASE */
    bool region_clip;
    bool viewport;
@@ -481,26 +482,24 @@ bool pvr_csb_emit_ta_output_sel(struct pvr_csb *csb,
 
 /* TA_STATE_PDS_SIZEINFO1/2: how much PDS and USC storage a program needs.
  *
- * The caller passes SIZES IN BYTES (or counts) and this function applies the units, because the
- * units are per-field and differ:
+ * The caller passes DWORD COUNTS (registers, PDS data dwords) and this function applies the units,
+ * because the units are per-field and differ:
  *
  *   pds_uniformsize       / 4      pds_texturestatesize / 4
  *   pds_varyingsize       / 4      pds_tempsize        / 4
  *   usc_varyingsize       / 16     usc_sharedsize      / 16
  *
- * The USC fields use a SIXTEEN-byte unit while the PDS fields use four - so a caller that
- * divided by one unit for all of them is wrong by a factor of four on half the fields, and the
- * hardware would read a differently-sized region with nothing reporting it. That is why the
- * division is inside this function rather than at the call site: a caller cannot get it wrong if
- * it never does it.
+ * The units count dwords, as the reference uses them (pvr_arch_cmd_buffer.c divides
+ * pds_coeff_program.data_size and fs_data->common.coeffs, both dwords, by these units). Passing
+ * bytes makes every field four times too large.
  *
  * All divisions round UP, as the reference does - a size that is not a whole number of units must
  * still allocate the last one. */
 struct pvr_pds_sizes {
-   uint32_t uniform_bytes;
-   uint32_t texturestate_bytes;
-   uint32_t varying_bytes;
-   uint32_t usc_varying_bytes;
+   uint32_t uniform_dwords;
+   uint32_t texturestate_dwords;
+   uint32_t varying_dwords;
+   uint32_t usc_varying_dwords;
    uint32_t temp_count;
    uint32_t usc_shared_count;
 };
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 08dac7f8..14331c93 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -244,6 +244,93 @@ draw_upload_fs(struct pvr_screen *scr, struct pvr_shader *fs)
    return fs->pds_offset != 0;
 }
 
+/* The coefficient (varying) program of a fragment variant against a vertex shader, as the Vulkan
+ * driver's pvr_graphics_pipeline_setup_fragment_coeff_program: one DOUTI iterator for z, w and each
+ * varying slot, reading the vertex's vtxout offset (in 16-bit units, position x/y dropped and z/w
+ * dropped when the fragment shader does not read them) into the slot's coefficient registers.
+ * Returns false when the shader reads no varyings and needs no program. */
+static bool
+draw_coeff_program(struct pvr_screen *scr, struct pvr_shader *fs, const struct pvr_shader *vs,
+                   bool flat_first)
+{
+   struct pvr_pds_coeff_loading_program prog = { .z_iterator = ~0u };
+   unsigned fpu = 0, dest = 0;
+
+   if (fs->coeff_vs == vs)
+      return fs->coeff_offset != 0;
+   fs->coeff_vs = vs;
+   fs->coeff_offset = 0;
+   if (!fs->uses_z && !fs->uses_w && !fs->varyings_read)
+      return false;
+
+   if (fs->uses_z) {
+      struct ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC src = {
+         .f32_offset = fs->uses_w ? 1 * sizeof(uint16_t) : 0,
+         .shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD,
+         .size = ROGUE_PDSINST_DOUTI_SIZE_1D,
+      };
+      src.f16_offset = src.f32_offset;
+      ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC_pack(&prog.FPU_iterators[fpu], &src);
+      prog.z_iterator = fpu;
+      prog.destination[fpu++] = dest++;
+   }
+   if (fs->uses_w) {
+      const struct ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC src = {
+         .shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD,
+         .size = ROGUE_PDSINST_DOUTI_SIZE_1D,
+      };
+      ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC_pack(&prog.FPU_iterators[fpu], &src);
+      prog.destination[fpu++] = dest++;
+   }
+   uint64_t read = fs->varyings_read;
+   while (read) {
+      const unsigned slot = u_bit_scan64(&read);
+      const unsigned count = fs->varyings[slot].count / ROGUE_USC_COEFFICIENT_SET_SIZE;
+      if (vs->varyings[slot].count != count || vs->varyings[slot].start < 4 ||
+          fpu >= PVR_MAXIMUM_ITERATIONS - 1)
+         return false;
+      unsigned vtxout = vs->varyings[slot].start - 2;
+      if (!fs->uses_z)
+         vtxout--;
+      if (!fs->uses_w)
+         vtxout--;
+      struct ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC src = {
+         .f32_offset = vtxout * sizeof(uint16_t),
+         .size = ROGUE_PDSINST_DOUTI_SIZE_1D + count - 1,
+      };
+      src.f16_offset = src.f32_offset;
+      switch (fs->varyings[slot].interp) {
+      case INTERP_MODE_FLAT:
+         /* GL's default provoking vertex is the last one. */
+         src.shademodel = flat_first ? ROGUE_PDSINST_DOUTI_SHADEMODEL_FLAT_VERTEX0
+                                     : ROGUE_PDSINST_DOUTI_SHADEMODEL_FLAT_VERTEX2;
+         break;
+      case INTERP_MODE_NOPERSPECTIVE:
+         src.shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD;
+         break;
+      default:
+         src.perspective = true;
+         src.shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD;
+         break;
+      }
+      ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC_pack(&prog.FPU_iterators[fpu], &src);
+      prog.destination[fpu++] = fs->varyings[slot].start / ROGUE_USC_COEFFICIENT_SET_SIZE;
+   }
+   prog.num_fpu_iterators = fpu;
+
+   /* Data then code in one upload: the hardware runs the code that follows the data segment. */
+   uint32_t buf[2 * PVR_MAXIMUM_ITERATIONS + 4 + PVR_MAXIMUM_ITERATIONS] = { 0 };
+   pvr_pds_coefficient_loading(&prog, NULL, PDS_GENERATE_SIZES);
+   if (prog.data_size + prog.code_size > ARRAY_SIZE(buf))
+      return false;
+   pvr_pds_coefficient_loading(&prog, buf, PDS_GENERATE_CODEDATA_SEGMENTS);
+   fs->coeff_offset =
+      (uint32_t)draw_upload_pds(scr, buf, (prog.data_size + prog.code_size) * 4);
+   fs->coeff_data_dwords = prog.data_size;
+   fs->coeff_temps = prog.temps_used;
+   return fs->coeff_offset != 0;
+}
+
 /* The background object for a clear colour: a constant-colour fragment program. */
 static uint64_t
 draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint32_t color)
@@ -345,7 +432,7 @@ draw_vertex_program(struct pvr_context *ctx, struct pvr_draw_state *d, struct pv
    uint64_t vb_addr[PIPE_MAX_ATTRIBS] = { 0 };
    uint32_t vb_stride[PIPE_MAX_ATTRIBS] = { 0 };
    const uint64_t pds_base = scr->vm.heaps[DRM_PVR_HEAP_PDS_CODE_DATA].base;
-   uint64_t code_addr, data_addr;
+   uint64_t code_addr = 0, data_addr = 0;
    uint32_t *code, *data;
    bool ok = true;
 
@@ -513,6 +600,11 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
    if (!draw_vertex_program(ctx, d, vs, &vcode, &vdata, &vtemps, &vdwords))
       return false;
 
+   /* Varyings: the coefficient program and the TA's per-vertex varying counts. */
+   const bool flat_first = ctx->rasterizer && ctx->rasterizer->flatshade_first;
+   const bool coeff = draw_coeff_program(scr, fsv, vs, flat_first);
+   if (!coeff && (fsv->uses_z || fsv->uses_w || fsv->varyings_read))
+      return false;
    /* TA state block. */
    uint64_t ta_addr;
    uint32_t *ta = arena_alloc(&d->gen, 256, 64, &ta_addr);
@@ -521,7 +613,7 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
    struct pvr_csb block;
    const struct pvr_ta_presence pres = {
       .ispctl = true, .ispctl_fa = true, .ispctl_fb = true, .ispctl_dbsc = true,
-      .pds_state_ptr0 = true, .pds_state_ptr3 = true, .region_clip = true, .viewport = true,
+      .pds_state_ptr0 = true, .pds_state_ptr1 = coeff, .pds_state_ptr3 = true, .region_clip = true, .viewport = true,
       .viewport_count = 1, .wclamp = true, .outselects = true, .varying_words = true,
       .ppp_ctrl = true, .stream_out_size = true,
    };
@@ -541,7 +633,9 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
    };
    const struct ROGUE_TA_STATE_ISPDBSC dbsc = { 0 };
    const struct pvr_pds_sizes pds_sizes = {
-      .usc_varying_bytes = fsv->coeffs * 4,
+      .varying_dwords = coeff ? fsv->coeff_data_dwords : 0,
+      .usc_varying_dwords = fsv->coeffs,
+      .temp_count = coeff ? fsv->coeff_temps : 0,
       .usc_shared_count = fsv->shareds,
    };
    const struct pipe_viewport_state *pv = &ctx->viewports[0];
@@ -550,7 +644,9 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
       .a1 = fui(pv->translate[1]), .m1 = fui(pv->scale[1]),
       .a2 = fui(pv->translate[2]), .m2 = fui(pv->scale[2]),
    };
-   const struct ROGUE_TA_STATE_VARYING0 varying0 = { 0 };
+   const struct ROGUE_TA_STATE_VARYING0 varying0 = {
+      .f32_linear = vs->f32_smooth, .f32_flat = vs->f32_flat, .f32_npc = vs->f32_npc,
+   };
    const struct ROGUE_TA_STATE_VARYING1 varying1 = { 0 };
    /* shortcut: no face culling yet (draws both faces; visible output is the same for closed
     * meshes). Map rasterizer->cull_face/front_ccw when a scene needs it. */
@@ -561,7 +657,10 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
       .flatshade_vtx = ROGUE_TA_FLATSHADE_VTX_VERTEX_0,
       .wclampen = true,
    };
-   const struct pvr_ta_output_sel outsel = { .vtxsize = vs->vtxouts, .psprite_size_pres = true };
+   const struct pvr_ta_output_sel outsel = {
+      .vtxsize = vs->vtxouts, .rhw_pres = fsv->uses_w, .tsp_unclamped_z_pres = fsv->uses_z,
+      .psprite_size_pres = true,
+   };
    struct pvr_region_clip clip;
    pvr_region_clip_from_rect(0, 0, d->rt_w, d->rt_h, 16, &clip);
    pvr_csb_init(&block, ta, 256, 0);
@@ -572,6 +671,7 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
        !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_SHADER, fsv->pds_offset) ||
        !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_TEXUNICODE, 0) ||
        !pvr_csb_emit_ta_pds_sizeinfo(&block, &pds_sizes, true, 0) ||
+       (coeff && !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_VARYING, fsv->coeff_offset)) ||
        !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_UNIFORMDATA, 0) ||
        !pvr_csb_emit_ta_region_clip(&block, &clip) || !pvr_csb_emit_ta_viewport(&block, &vp) ||
        !pvr_csb_emit_ta_wclamp(&block, PVR_TA_WCLAMP_MIN_W) ||
