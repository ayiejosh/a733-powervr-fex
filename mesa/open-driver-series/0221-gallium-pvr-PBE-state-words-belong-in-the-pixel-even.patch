 /* Builds the three 64-bit PBE register words a fragment job's firmware stream carries per colour
  * attachment, in the reference's encoding (pvr_arch_job_common.c pvr_pbe_state_words):
  *
- *   words[0] = PBESTATE_STATE_WORD0 in the low dword, STATE_WORD1 in the high one
- *   words[1] = PBESTATE_REG_WORD0   (memory layout, stride, channel swizzles)
- *   words[2] = PBESTATE_REG_WORD1   (size/clip words; zero for a linear target)
- *
- * A fragment stream built without them configures no render target at all - the PBE slots are
- * zeros - and the firmware cannot run the fragment job. Returns false for formats whose PBE
- * packmode this function does not encode rather than emitting a plausible wrong one. */
-bool pvr_csb_pbe_words(enum pipe_format format, uint64_t addr, uint32_t mrt_index,
-                       uint32_t stride_bytes, uint64_t words[3]);
+ *   words[0] = PBESTATE_REG_WORD0 - memory layout, encoded stride, channel swizzles
+ *   words[1] = PBESTATE_REG_WORD1 - clip extents (size_{x,y} stay zero for a linear target)
+ *   words[2] = zero
+ *
+ * Note what is NOT here: the target address and output format live in the pixel-event PDS program's
+ * emit words (PBESTATE_STATE_WORD0/WORD1), not in this stream. Putting the state words here makes a
+ * stream the kernel parses into a nonsense command.
+ *
+ * Returns false for formats whose PBE packmode this function does not encode. */
+bool pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width,
+                       uint32_t height, uint64_t words[3]);
 
