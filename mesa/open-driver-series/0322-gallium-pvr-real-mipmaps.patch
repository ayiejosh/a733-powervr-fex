+/* Each level a GPU render of the 2x2 box filter of the one above it. A chain that keeps level 0
+ * only (a format the PBE cannot write, see pvr_resource_create) has nothing to generate. */
 static bool
 pvr_generate_mipmap(struct pipe_context *pctx, struct pipe_resource *pres,
                     enum pipe_format format, unsigned base_level, unsigned last_level,
