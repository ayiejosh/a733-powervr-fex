+/* A copy of a whole level between colour target resources is one GPU render (instead of two
+ * staging copies through the CPU); anything else goes through the CPU maps. */
+static void
+pvr_resource_copy_region(struct pipe_context *pctx, struct pipe_resource *dst, unsigned dst_level,
+                         unsigned dstx, unsigned dsty, unsigned dstz, struct pipe_resource *src,
+                         unsigned src_level, const struct pipe_box *box)
+{
+   if (dst->target != PIPE_BUFFER && src->target != PIPE_BUFFER && dstx == 0 && dsty == 0 &&
+       dstz == 0 && box->x == 0 && box->y == 0 && box->z == 0 && box->depth == 1 &&
+       dst->format == src->format &&
+       box->width == (int)u_minify(src->width0, src_level) &&
+       box->height == (int)u_minify(src->height0, src_level) &&
+       pvr_draw_blit(pvr_context(pctx), dst, dst_level, src, src_level, false))
+      return;
+   util_resource_copy_region(pctx, dst, dst_level, dstx, dsty, dstz, src, src_level, box);
+}
