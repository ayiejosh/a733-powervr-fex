 static const char *
@@ -52,20 +54,44 @@ pvr_get_device_vendor(struct pipe_screen *pscreen)
    return "Imagination Technologies";
 }
 
-/* The state tracker calls this unconditionally while building its format tables,
- * so it has to exist. The answer is "none": there is no resource management yet
- * (explicitly out of scope for this milestone), and claiming support here would
- * have the tracker build tables for resources this driver cannot create. Lying
- * would move the failure somewhere less honest. */
+/* What this answers is narrow, and worth being precise about: can the driver back a
+ * resource of this format with memory and describe its layout? Linear memory can
+ * describe any plain (non-compressed) format, so those are accepted. It does NOT
+ * claim a working draw path - there is none yet - but without it the state tracker
+ * builds no configs at all, DRI has nothing to hand out, and EGL cannot initialise,
+ * so this is also the gate on everything downstream. Compressed and subsampled
+ * layouts are refused rather than accepted and described wrongly. */
 static bool
 pvr_is_format_supported(UNUSED struct pipe_screen *pscreen,
-                        UNUSED enum pipe_format format,
+                        enum pipe_format format,
                         UNUSED enum pipe_texture_target target,
-                        UNUSED unsigned sample_count,
-                        UNUSED unsigned storage_sample_count,
+                        unsigned sample_count,
+                        unsigned storage_sample_count,
                         UNUSED unsigned bindings)
 {
-   return false;
+   const struct util_format_description *desc;
+
+   if (sample_count > 1 || storage_sample_count > 1)
+      return false;
+
+   desc = util_format_description(format);
+   if (desc == NULL)
+      return false;
+
+   return desc->layout == UTIL_FORMAT_LAYOUT_PLAIN;
+}
+
+/* This driver never creates a fence - there is nothing to submit and so nothing to
+ * wait for - which makes the honest implementation "release whatever we were holding
+ * and clear the caller's pointer". It is reached unconditionally: st's throttle
+ * teardown calls it for every ring slot on every context destruction. */
+static void
+pvr_fence_reference(UNUSED struct pipe_screen *pscreen,
+                    struct pipe_fence_handle **ptr,
+                    UNUSED struct pipe_fence_handle *fence)
+{
+   if (ptr)
+      *ptr = NULL;
 }
 
 static void
@@ -156,6 +182,8 @@ pvr_screen_create(int fd, const struct pipe_screen_config *config,
    screen->base.get_vendor = pvr_get_vendor;
    screen->base.get_device_vendor = pvr_get_device_vendor;
    screen->base.is_format_supported = pvr_is_format_supported;
+   screen->base.fence_reference = pvr_fence_reference;
+   screen->base.context_create = pvr_context_create;
    screen->base.resource_create = pvr_resource_create;
    screen->base.resource_destroy = pvr_resource_destroy;
 
