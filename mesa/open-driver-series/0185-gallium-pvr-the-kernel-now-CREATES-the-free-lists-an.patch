+/* The device's own free-list page limits. A guessed range is refused with EINVAL, so the numbers come
+ * from the kernel rather than from a plausible-looking constant. */
+bool
+pvr_free_list_page_limits(int fd, uint32_t *min_pages_out, uint32_t *max_pages_out)
+{
+   struct drm_pvr_dev_query_runtime_info kmd = { 0 };
+   struct drm_pvr_ioctl_dev_query_args args = {
+      .type = DRM_PVR_DEV_QUERY_RUNTIME_INFO_GET,
+      .size = sizeof(kmd),
+      .pointer = (__u64)&kmd,
+   };
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) != 0) {
+      mesa_loge("pvr: runtime-info query failed: %s", strerror(errno));
+      return false;
+   }
+
+   *min_pages_out = kmd.free_list_min_pages;
+   *max_pages_out = kmd.free_list_max_pages;
+   return true;
+}
+
 void
 pvr_vm_finish(struct pvr_vm *vm)
 {
