index 68cc58da..bfcd9f2b 100644
--- a/src/imagination/vulkan/pvr_arch_job_transfer.c
+++ b/src/imagination/vulkan/pvr_arch_job_transfer.c
@@ -2931,6 +2931,7 @@ static VkResult pvr_3d_copy_blit_core(struct pvr_transfer_ctx *ctx,
       } else {
          pvr_dev_addr_t kick_usc_pds_dev_addr;
 
+         state->shader_props.single_sampled = state->msaa_multiplier <= 1U;
          result =
             pvr_transfer_frag_store_get_shader_info(device,
                                                     &ctx->frag_store,
@@ -4272,6 +4273,7 @@ static VkResult pvr_isp_ctrl_stream(const struct pvr_device_info *dev_info,
                }
             }
 
+            shader_props->single_sampled = state->msaa_multiplier <= 1U;
             result = pvr_transfer_frag_store_get_shader_info(
                transfer_cmd->cmd_buffer->device,
                &ctx->frag_store,
diff --git a/src/imagination/vulkan/pvr_transfer_frag_store.c b/src/imagination/vulkan/pvr_transfer_frag_store.c
index 89dc066d..3b4bff51 100644
--- a/src/imagination/vulkan/pvr_transfer_frag_store.c
+++ b/src/imagination/vulkan/pvr_transfer_frag_store.c
@@ -124,7 +124,7 @@ static uint32_t pvr_transfer_frag_shader_key(
    hash |= layer->sample;
 
    shift_hash(hash, 1U);
-   hash |= (uint32_t)false;
+   hash |= (uint32_t)shader_props->single_sampled;
 
    shift_hash(hash, 1U);
    hash |= (uint32_t)false;
diff --git a/src/imagination/vulkan/pvr_usc.c b/src/imagination/vulkan/pvr_usc.c
index 7c86d013..49a734c4 100644
--- a/src/imagination/vulkan/pvr_usc.c
+++ b/src/imagination/vulkan/pvr_usc.c
@@ -906,6 +906,7 @@ pco_shader *pvr_uscgen_tq(pco_ctx *ctx,
    assert(pvr_pbe_pixel_num_loads(layer_props->pbe_format) == 1);
 
    pco_data data = { 0 };
+   data.fs.known_single_sampled = shader_props->single_sampled;
 
    switch (pixel_size) {
    case 1:
diff --git a/src/imagination/vulkan/pvr_usc.h b/src/imagination/vulkan/pvr_usc.h
index 67b3ccda..5c91d0fa 100644
--- a/src/imagination/vulkan/pvr_usc.h
+++ b/src/imagination/vulkan/pvr_usc.h
@@ -66,6 +66,8 @@ struct pvr_tq_shader_properties {
 
    /* Sample specific channel of pixel. */
    bool pick_component;
+   /* The ISP runs at one sample per pixel. */
+   bool single_sampled;
 
    struct pvr_tq_layer_properties {
       /* Controls whether we need to send the sample count to the TPU. */
