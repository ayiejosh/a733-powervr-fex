From 9b9ea0df32c7fc5fd9f8633cfaec389b8f44d72c Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 10:58:14 +0800
Subject: [PATCH 062/294] pvr/pco: read pixel coordinates directly in
 single-sampled transfer shaders

Internal fragment shaders always picked the pixel or sample position at run
time from the coverage mask, which costs ten instruction groups. A transfer
whose ISP runs at one sample per pixel (msaa_multiplier 1) always takes the
pixel position, so tell the compiler: a new single_sampled shader property
(it takes a spare bit of the frag store key) sets known_single_sampled in the
shader data, and fs_known_single_sampled() honours it for internal shaders.

The copy shader drops from 16 to 6 instruction groups. BXM-4-64 (A733),
2048x2048 RGBA8, interleaved: image->buffer ~4.0 -> ~3.8 ms, image->image
~4.0 -> ~3.75 ms. 9170-case renderpass / dynamic_rendering / copy_and_blit
selection matches d253e35; gate 44/44.
---
 src/imagination/pco/pco_data.h                   | 3 +++
 src/imagination/pco/pco_trans_nir.c              | 6 ++++--
 src/imagination/vulkan/pvr_arch_job_transfer.c   | 2 ++
 src/imagination/vulkan/pvr_transfer_frag_store.c | 2 +-
 src/imagination/vulkan/pvr_usc.c                 | 1 +
 src/imagination/vulkan/pvr_usc.h                 | 2 ++
 6 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/imagination/pco/pco_data.h b/src/imagination/pco/pco_data.h
index 44f0f824..7a995274 100644
--- a/src/imagination/pco/pco_data.h
+++ b/src/imagination/pco/pco_data.h
@@ -118,6 +118,9 @@ typedef struct _pco_fs_data {
     */
    bool masked_outputs;
 
+   /* Internal shader known to run at one sample per pixel. */
+   bool known_single_sampled;
+
    pco_range tile_buffers;
 
    pco_range sample_locations;
diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index 726e1860..9f0727c2 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -472,8 +472,10 @@ static pco_ref fs_is_single_sampled(trans_ctx *tctx)
  */
 static bool fs_known_single_sampled(trans_ctx *tctx)
 {
-   return !tctx->shader->is_internal &&
-          !tctx->shader->data.fs.uses.sample_shading;
+   if (tctx->shader->is_internal)
+      return tctx->shader->data.fs.known_single_sampled;
+
+   return !tctx->shader->data.fs.uses.sample_shading;
 }
 
 /**
