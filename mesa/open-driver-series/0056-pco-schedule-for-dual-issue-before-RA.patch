From 5e23ee3d6e09728bb7f0fdf7c724c39511d11ecf Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 02:08:09 +0800
Subject: [PATCH 056/294] pco: schedule for dual issue before RA

Post-RA pairing only finds independent ops that RA did not tie together
through register reuse. Before RA, on SSA, place an independent
fadd/fmul/fmad/mbyp right after each phase 0 op: hoist a later one, or
sink an earlier one whose result is not read up to that point (within 8
register-only ALU ops of the same block). pco_group_instrs then
co-issues the pair.

FSINC (and FRED) are no longer treated as phase 0 partners: pairs with
fsinc, which first appeared with this pass, gave wrong and run-to-run
different results on BXM-4-64, like FRCP/FRSQ/FLOG/FEXP.

vkheavy fragment shader 783 -> 722 groups (temps 10 -> 12).
BXM-4-64, interleaved A/B x3 against the previous commit:
  vkheavy 2048  195.5 -> 190.2 ms/frame
  vkheavy 512   13.08 -> 12.68 ms/frame
Hoisting alone was neutral to slightly worse (more temps); with sinking
it is a net win. All output hashes and vkedge/vkrender checks unchanged.
---
 src/imagination/pco/pco_group_instrs.c | 142 ++++++++++++++++++++++++-
 src/imagination/pco/pco_internal.h     |   1 +
 src/imagination/pco/pco_ir.c           |   1 +
 3 files changed, 141 insertions(+), 3 deletions(-)

diff --git a/src/imagination/pco/pco_group_instrs.c b/src/imagination/pco/pco_group_instrs.c
index b18f1a37..539cc9e4 100644
--- a/src/imagination/pco/pco_group_instrs.c
+++ b/src/imagination/pco/pco_group_instrs.c
@@ -15,6 +15,7 @@
 #include "pco_builder.h"
 #include "pco_map.h"
 #include "util/macros.h"
+#include "util/set.h"
 
 #include <stdbool.h>
 
@@ -185,8 +186,9 @@ static bool is_p1_op(const pco_instr *instr)
    }
 }
 
-/* Phase 0 ops that a phase 1 op may be co-issued with. FRCP/FRSQ/FLOG/FEXP
- * are left out: co-issuing with them produced wrong results on BXM-4-64.
+/* Phase 0 ops that a phase 1 op may be co-issued with. The single-unit ops
+ * (FRCP/FRSQ/FLOG/FEXP/FSINC, and FRED) are left out: co-issuing with them
+ * produced wrong results on BXM-4-64.
  */
 static bool is_p0_pairable(const pco_instr *instr)
 {
@@ -195,7 +197,6 @@ static bool is_p0_pairable(const pco_instr *instr)
    case PCO_OP_FMUL:
    case PCO_OP_FMAD:
    case PCO_OP_MBYP:
-   case PCO_OP_FSINC:
    case PCO_OP_UNPCK:
    case PCO_OP_IMADD32:
    case PCO_OP_IADD32:
@@ -522,6 +523,141 @@ static bool try_fold_into_next(pco_igrp *prev, pco_igrp *igrp)
    return true;
 }
 
+
+/* Whether instr reads a value that earlier defines (SSA or hardware register). */
+static bool reads_def_of(const pco_instr *instr, const pco_instr *earlier)
+{
+   for (unsigned d = 0; d < earlier->num_dests; ++d) {
+      pco_ref dest = earlier->dest[d];
+      for (unsigned s = 0; s < instr->num_srcs; ++s) {
+         pco_ref src = instr->src[s];
+         if (pco_ref_is_ssa(dest) && pco_ref_is_ssa(src) && src.val == dest.val)
+            return true;
+         if (refs_overlap(src, dest))
+            return true;
+      }
+   }
+   return false;
+}
+
+/* Pre-RA phase 1 candidate: hardware-register sources must fit s3-s5. */
+static bool is_p1_candidate(pco_instr *instr)
+{
+   if (!is_p1_op(instr) || instr->num_dests != 1 ||
+       !pco_ref_is_ssa(instr->dest[0]) || !pco_instr_has_default_exec(instr))
+      return false;
+
+   for (unsigned s = 0; s < instr->num_srcs; ++s) {
+      pco_ref ref = instr->src[s];
+      if (pco_ref_is_hwreg(ref) && !upper_src_ok(ref, s))
+         return false;
+   }
+   return true;
+}
+
+#define DUAL_ISSUE_SCHED_WINDOW 8
+
+/* A later candidate that can move up to just after a. */
+static pco_instr *
+find_hoist(pco_block *block, pco_instr *a, struct set *paired)
+{
+   pco_instr *between[DUAL_ISSUE_SCHED_WINDOW];
+   unsigned num_between = 0;
+
+   for (struct list_head *n = a->link.next; n != &block->instrs; n = n->next) {
+      pco_instr *b = list_entry(n, pco_instr, link);
+      if (!_mesa_set_search(paired, b) && is_p1_candidate(b) &&
+          !reads_def_of(b, a)) {
+         bool ok = true;
+         for (unsigned i = 0; i < num_between && ok; ++i)
+            ok = !reads_def_of(b, between[i]);
+         if (ok)
+            return b;
+      }
+      if (!is_plain_alu_op(b) || num_between == DUAL_ISSUE_SCHED_WINDOW)
+         return NULL;
+      between[num_between++] = b;
+   }
+   return NULL;
+}
+
+/* An earlier candidate whose result nothing up to a reads, to sink after a. */
+static pco_instr *
+find_sink(pco_block *block, pco_instr *a, struct set *paired)
+{
+   unsigned seen = 0;
+
+   for (struct list_head *n = a->link.prev; n != &block->instrs; n = n->prev) {
+      pco_instr *b = list_entry(n, pco_instr, link);
+      if (!is_plain_alu_op(b) || ++seen > DUAL_ISSUE_SCHED_WINDOW)
+         return NULL;
+      if (_mesa_set_search(paired, b) || !is_p1_candidate(b))
+         continue;
+
+      bool used = false;
+      for (struct list_head *m = b->link.next;; m = m->next) {
+         pco_instr *user = list_entry(m, pco_instr, link);
+         if (reads_def_of(user, b)) {
+            used = true;
+            break;
+         }
+         if (user == a)
+            break;
+      }
+      if (!used)
+         return b;
+   }
+   return NULL;
+}
+
+/**
+ * \brief Pre-RA scheduling for dual issue: on SSA there are no false
+ *        dependencies, so place an independent phase 1-capable op right
+ *        after each phase 0 op (hoisting a later one or sinking an earlier
+ *        one); pco_group_instrs then co-issues the pair.
+ */
+bool pco_dual_issue_sched(pco_shader *shader)
+{
+   bool progress = false;
+
+   if (PCO_DEBUG(NO_DUAL_ISSUE))
+      return false;
+
+   pco_foreach_func_in_shader (func, shader) {
+      struct set *paired = _mesa_pointer_set_create(NULL);
+
+      pco_foreach_block_in_func (block, func) {
+         for (struct list_head *pos = block->instrs.next;
+              pos != &block->instrs;
+              pos = pos->next) {
+            pco_instr *a = list_entry(pos, pco_instr, link);
+            if (_mesa_set_search(paired, a) || !is_p0_pairable(a) ||
+                !pco_instr_has_default_exec(a))
+               continue;
+
+            pco_instr *b = find_hoist(block, a, paired);
+            if (!b)
+               b = find_sink(block, a, paired);
+            if (!b)
+               continue;
+
+            if (a->link.next != &b->link) {
+               list_del(&b->link);
+               list_add(&b->link, &a->link);
+               progress = true;
+            }
+            _mesa_set_add(paired, a);
+            _mesa_set_add(paired, b);
+            pos = &b->link;
+         }
+      }
+
+      _mesa_set_destroy(paired, NULL);
+   }
+
+   return progress;
+}
+
 /**
  * \brief Converts a PCO instruction to an instruction group.
  *
diff --git a/src/imagination/pco/pco_internal.h b/src/imagination/pco/pco_internal.h
index d0bb3041..87ed03c0 100644
--- a/src/imagination/pco/pco_internal.h
+++ b/src/imagination/pco/pco_internal.h
@@ -1810,6 +1810,7 @@ bool pco_post_ra_legalize(pco_shader *shader);
 bool pco_pre_ra_legalize(pco_shader *shader);
 bool pco_end(pco_shader *shader);
 bool pco_group_instrs(pco_shader *shader);
+bool pco_dual_issue_sched(pco_shader *shader);
 bool pco_index(pco_shader *shader, bool skip_ssa);
 bool pco_opt_comp_only_vecs(pco_shader *shader);
 bool pco_nir_compute_instance_check(nir_shader *shader);
diff --git a/src/imagination/pco/pco_ir.c b/src/imagination/pco/pco_ir.c
index defcd0d4..b245e606 100644
--- a/src/imagination/pco/pco_ir.c
+++ b/src/imagination/pco/pco_ir.c
@@ -52,6 +52,7 @@ void pco_process_ir(pco_ctx *ctx, pco_shader *shader)
    /* TODO: schedule after RA instead as e.g. vecs may no longer be the first
     * time a drc result is used.
     */
+   PCO_PASS(_, shader, pco_dual_issue_sched);
    PCO_PASS(_, shader, pco_schedule);
    PCO_PASS(_, shader, pco_pre_ra_legalize);
    PCO_PASS(_, shader, pco_ra);
