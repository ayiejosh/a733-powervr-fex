@@ -32,6 +32,7 @@
 #include <string.h>
 #include <vulkan/vulkan.h>
 
+#include "hwdef/pvr_hw_utils.h"
 #include "pvr_bo.h"
 #include "pvr_csb.h"
 #include "pvr_device.h"
@@ -41,6 +42,7 @@
 #include "pvr_macros.h"
