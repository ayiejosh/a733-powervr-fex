From ffdae347c07cc9a8271b5b43bf24f86420fbe6de Mon Sep 17 00:00:00 2001
From: radxa <radxa@radxa-cubie-a7a>
Date: Sun, 1 Nov 2026 16:24:53 +0800
Subject: [PATCH] pco: emit F16SOP for fp16 multiply (offline only)

Add O_F16SOP_MUL with its encode and instruction-group maps, using the
vendor-derived SOP multiply form (fixed form words 33 22 in the bit struct,
pair-0 lane descriptors src1_desc=0x44/src1_flag=0x81, argument 0 in
src0_reg, argument 1 in src2_reg), and translate a scalar fp16 fmul to
pco_f16sop_mul().

This is deliberately narrow and is not reachable from any current shader:
the GLES2 mediump path stays off, only scalar/pair-aligned fp16 emits
(vector halves are still unimplemented), and the SOP multiply form's
modifier/descriptor handling has not been validated on hardware.

Verified offline only: the new --nir-test f16mul probe emits the vendor MUL
prefix 94 33 22 a0 12 c0 22 44 00 00 fc inside a 272 B shader, while the fp32
math FS stays at 280 B / 26 groups.  No F16SOP instruction has been executed
on the GPU yet.
---
 src/imagination/pco/pco_map.py      | 32 +++++++++++++++++++++++++++++
 src/imagination/pco/pco_ops.py      |  3 +++
 src/imagination/pco/pco_trans_nir.c |  5 +++++
 3 files changed, 40 insertions(+)

diff --git a/src/imagination/pco/pco_map.py b/src/imagination/pco/pco_map.py
index 3b11c278..14a962d2 100644
--- a/src/imagination/pco/pco_map.py
+++ b/src/imagination/pco/pco_map.py
@@ -1145,6 +1145,21 @@ encode_map(O_F16SOP,
    op_ref_maps=[('0', ['w0'], ['s0', 's1', 's2'])]
 )
 
+encode_map(O_F16SOP_MUL,
+   encodings=[
+      (I_F16SOP_MUL, [
+         ('src0_reg', ('pco_ref_get_reg_index', SRC(0))),
+         ('src1_desc', 0x44),
+         ('src1_flag', 0x81),
+         ('src1_present', False),
+         ('src1_reg', 0),
+         ('src2_reg', ('pco_ref_get_reg_index', SRC(1))),
+         ('dst', ('pco_ref_get_reg_index', DEST(0))),
+      ])
+   ],
+   op_ref_maps=[('0', ['w0'], ['s0', 's1'])]
+)
+
 encode_map(O_PCK,
    encodings=[
       (I_PCK, [
@@ -2147,6 +2162,23 @@ group_map(O_F16SOP,
    dests=[]
 )
 
+group_map(O_F16SOP_MUL,
+   hdr=(I_IGRP_HDR_MAIN, [
+      ('oporg', 'p0'),
+      ('olchk', OM_OLCHK),
+      ('w1p', False),
+      ('w0p', True),
+      ('cc', OM_EXEC_CND),
+      ('end', OM_END),
+      ('atom', OM_ATOM),
+      ('rpt', OM_RPT)
+   ]),
+   enc_ops=[('0', O_F16SOP_MUL)],
+   srcs=[],
+   iss=[],
+   dests=[]
+)
+
 group_map(O_FDSX,
    hdr=(I_IGRP_HDR_MAIN, [
       ('oporg', 'p0'),
diff --git a/src/imagination/pco/pco_ops.py b/src/imagination/pco/pco_ops.py
index 7297c3d3..5ffeefd7 100644
--- a/src/imagination/pco/pco_ops.py
+++ b/src/imagination/pco/pco_ops.py
@@ -395,6 +395,9 @@ O_UNPCK = hw_op('unpck', OM_ALU + [OM_PCK_FMT, OM_ROUNDZERO, OM_SCALE], 1, 1, []
 O_F16SOP = hw_op('f16sop', OM_ALU + [OM_SOP_OP], 1, 3, [],
                  [[RM_ABS, RM_NEG], [RM_ABS, RM_NEG], [RM_ABS, RM_NEG]])
 
+O_F16SOP_MUL = hw_op('f16sop_mul', OM_ALU, 1, 2, [],
+                     [[RM_ABS, RM_NEG], [RM_ABS, RM_NEG]])
+
 O_TST = hw_direct_op('tst', [OM_TST_OP_MAIN, OM_PHASE2END, OM_TST_TYPE_MAIN], 2, 2, [], [[RM_ELEM], [RM_ELEM]])
 O_MOVC = hw_direct_op('movc', [OM_PHASE2END], 2, 5, [[RM_ELEM]])
 
diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index 623e8946..cb9b6211 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -3924,6 +3924,11 @@ static pco_instr *trans_alu(trans_ctx *tctx, nir_alu_instr *alu)
                         .sop_op = sop_op);
    }
 
+   if (alu->def.bit_size == 16 && alu->op == nir_op_fmul &&
+       pco_ref_get_chans(dest) == 1 && pco_ref_get_chans(src[0]) == 1 &&
+       pco_ref_get_chans(src[1]) == 1)
+      return pco_f16sop_mul(&tctx->b, dest, src[0], src[1]);
+
    pco_instr *instr;
    switch (alu->op) {
    case nir_op_fneg:
