+/* The render init entries the background object initializes: DONT_CARE ones
+ * (see pvr_surface_setup_render_init()) only when the force-load variant
+ * loads them.
+ */
+static uint32_t
+pvr_render_init_mask(const struct pvr_cmd_buffer *cmd_buffer,
+                     const struct pvr_renderpass_hwsetup_render *hw_render)
+{
+   const bool fbc_load = pvr_render_needs_fbc_load(cmd_buffer, hw_render);
+   uint32_t mask = 0;
+
+   for (uint32_t i = 0; i < hw_render->color_init_count; i++) {
+      if (fbc_load ||
+          hw_render->color_init[i].op != VK_ATTACHMENT_LOAD_OP_DONT_CARE)
+         mask |= BITFIELD_BIT(i);
+   }
+
+   return mask;
+}
