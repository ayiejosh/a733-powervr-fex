+/* Whether the render's load op initializes any colour attachment (render
+ * init entries can be DONT_CARE, see pvr_surface_setup_render_init()).
+ */
+static bool
+pvr_render_inits_color(const struct pvr_renderpass_hwsetup_render *hw_render)
+{
+   for (uint32_t i = 0; i < hw_render->color_init_count; i++) {
+      if (hw_render->color_init[i].op != VK_ATTACHMENT_LOAD_OP_DONT_CARE)
+         return true;
+   }
+
+   return false;
+}
