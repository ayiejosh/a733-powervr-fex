 /* pco: the PowerVR compiler from src/imagination/pco, linked rather than rewritten. */
 #include "pco/pco.h"
 
+#include "pvr_resource.h"
+
 static const char *
 pvr_get_name(struct pipe_screen *pscreen)
 {
@@ -71,6 +73,8 @@ pvr_destroy_screen(struct pipe_screen *pscreen)
 {
    struct pvr_screen *screen = pvr_screen(pscreen);
 
+   if (screen->vm_valid)
+      pvr_vm_finish(&screen->vm);
    if (screen->fd >= 0)
       close(screen->fd);
    ralloc_free(screen);
@@ -140,11 +144,20 @@ pvr_screen_create(int fd, const struct pipe_screen_config *config,
       caps->device_id = ident->device_id;
    }
 
+   /* GPU address space. Failure here is not fatal to enumeration - it only means no
+    * resource can be created, which is worth being able to see when probing a node
+    * this driver cannot actually drive. */
+   screen->vm_valid = pvr_vm_init(fd, &screen->vm);
+   if (!screen->vm_valid)
+      mesa_logi("pvr: no GPU address space; resources will not be creatable");
+
    screen->base.destroy = pvr_destroy_screen;
    screen->base.get_name = pvr_get_name;
    screen->base.get_vendor = pvr_get_vendor;
    screen->base.get_device_vendor = pvr_get_device_vendor;
    screen->base.is_format_supported = pvr_is_format_supported;
+   screen->base.resource_create = pvr_resource_create;
+   screen->base.resource_destroy = pvr_resource_destroy;
 
    return &screen->base;
 }
