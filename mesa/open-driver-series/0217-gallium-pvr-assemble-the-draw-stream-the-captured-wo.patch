+/* The two face-value words and the depth-bias/scissor index word that follow ISPCTL. ISPA holds
+ * the A-format face (object type, pass type, depth/stencil compare, write masks), ISPB the
+ * B-format one (stencil compare/ops). The reference writes front A/B and, when two-sided, back
+ * A/B too; this driver emits what the caller asks for. */
+bool pvr_csb_emit_ta_isp_a(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPA *a);
+bool pvr_csb_emit_ta_isp_b(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPB *b);
+bool pvr_csb_emit_ta_isp_dbsc(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPDBSC *dbsc);
+
+/* The viewport is SIX RAW DWORDs in the block - no packet type, no header - in the order
+ * a0, m0, a1, m1, a2, m2. The captured draw's values for a 512-wide viewport are
+ * 256.0f 256.0f 256.0f 256.0f 0.0f 1.0f as floats. Kept as raw dwords here because the
+ * scale/translate-to-a/m mapping has not been ported yet; inventing it would be a guess. */
+struct pvr_viewport_words {
+   uint32_t a0, m0, a1, m1, a2, m2;
