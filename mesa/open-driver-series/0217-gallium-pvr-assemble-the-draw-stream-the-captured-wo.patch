+{
+   uint32_t *dw = pvr_csb_emit(csb, 6);
+
+   if (dw == NULL)
+      return false;
+
+   dw[0] = vp->a0;
+   dw[1] = vp->m0;
+   dw[2] = vp->a1;
+   dw[3] = vp->m1;
+   dw[4] = vp->a2;
+   dw[5] = vp->m2;
+
+   return true;
+}
+
+bool
+pvr_csb_emit_ta_varying(struct pvr_csb *csb, const struct ROGUE_TA_STATE_VARYING0 *v0,
+                        const struct ROGUE_TA_STATE_VARYING1 *v1)
+{
+   const uint32_t words = ROGUE_TA_STATE_VARYING0_length +
+                          ROGUE_TA_STATE_VARYING1_length +
+                          ROGUE_TA_STATE_VARYING2_length;
+   struct ROGUE_TA_STATE_VARYING2 v2 = { 0 };
+   uint32_t *dw = pvr_csb_emit(csb, words);
+
+   if (dw == NULL)
+      return false;
+
+   ROGUE_TA_STATE_VARYING0_pack(dw, v0);
+   ROGUE_TA_STATE_VARYING1_pack(dw + ROGUE_TA_STATE_VARYING0_length, v1);
+   ROGUE_TA_STATE_VARYING2_pack(dw + ROGUE_TA_STATE_VARYING0_length +
+                                   ROGUE_TA_STATE_VARYING1_length,
+                                &v2);
+   return true;
+}
+
