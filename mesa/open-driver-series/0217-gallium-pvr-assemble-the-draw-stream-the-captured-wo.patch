+bool
+pvr_csb_emit_ta_isp_a(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPA *a)
+{
+   uint32_t *dw = pvr_csb_emit(csb, ROGUE_TA_STATE_ISPA_length);
+
+   if (dw == NULL)
+      return false;
+
+   ROGUE_TA_STATE_ISPA_pack(dw, a);
+   return true;
+}
+
+bool
+pvr_csb_emit_ta_isp_b(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPB *b)
