+/* VARYING0/1 carry the per-interpolation varying counts, VARYING2 is only ever written as zero
+ * (the reference writes a literal 0 there on the first draw of a render job). */
+bool pvr_csb_emit_ta_varying(struct pvr_csb *csb,
+                             const struct ROGUE_TA_STATE_VARYING0 *v0,
+                             const struct ROGUE_TA_STATE_VARYING1 *v1);
+
+/* STATE_PPP_CTRL: cull mode, clip mode, flat-shade vertex, w-clamp enable. */
+bool pvr_csb_emit_ta_ppp_ctrl(struct pvr_csb *csb,
+                              const struct ROGUE_TA_STATE_PPP_CTRL *ctrl);
+
+/* TA_STATE_STREAM_OUT0, always zero here (no stream output). */
+bool pvr_csb_emit_ta_stream_out(struct pvr_csb *csb);
