          case PVR_BUFFER_TYPE_GLOBAL_SHMEM: {
             assert(stage == PVR_STAGE_ALLOCATION_COMPUTE);
             assert(data->cs.global_shmem);
diff --git a/src/imagination/vulkan/pvr_arch_pipeline.c b/src/imagination/vulkan/pvr_arch_pipeline.c
index 60832f6..e007ea2 100644
--- a/src/imagination/vulkan/pvr_arch_pipeline.c
+++ b/src/imagination/vulkan/pvr_arch_pipeline.c
@@ -617,6 +617,23 @@ static VkResult pvr_pds_descriptor_program_create_and_upload(
       };
    }
 
+   if (data->common.literals.count > 0) {
+      result = pvr_gpu_upload(device,
+                              device->heaps.general_heap,
+                              data->common.literal_vals,
+                              PVR_DW_TO_BYTES(data->common.literals.count),
+                              16,
+                              &descriptor_state->static_consts);
+      if (result != VK_SUCCESS)
+         goto err_free_entries;
+
+      program.buffers[program.buffer_count++] = (struct pvr_pds_buffer){
+         .type = PVR_BUFFER_TYPE_COMPILE_TIME,
+         .size_in_dwords = data->common.literals.count,
+         .destination = data->common.literals.start,
+      };
+   }
+
    /* Pass the 64-bit address (as 2x32-bit regs) of the global shmem buffer. */
    if (stage == MESA_SHADER_COMPUTE && data->cs.shmem.count > 0 &&
        data->cs.global_shmem) {
@@ -2787,6 +2804,11 @@ static void pvr_postprocess_shader_data(pco_data *data,
 {
    const VkGraphicsPipelineCreateInfo *pGraphicsCreateInfo = pCreateInfo;
 
+   /* Literals go to shared registers filled by the descriptor upload program
+    * (see pvr_pds_descriptor_program_create_and_upload()).
+    */
+   data->common.literal_pool = true;
+
    switch (nir->info.stage) {
    case MESA_SHADER_VERTEX: {
       pvr_alloc_vs_sysvals(data, nir);
