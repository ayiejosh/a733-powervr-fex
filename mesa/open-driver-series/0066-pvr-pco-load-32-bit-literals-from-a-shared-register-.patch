index fdbf035..8c70399 100644
--- a/src/imagination/pco/pco_const_imms.c
+++ b/src/imagination/pco/pco_const_imms.c
@@ -18,6 +18,7 @@
 #include <stdbool.h>
 #include <stdint.h>
 #include <stdlib.h>
+#include <string.h>
 
 /** Mapping of constant register values and their indices. */
 struct const_reg_def {
@@ -163,6 +164,115 @@ inline static const struct const_reg_def *constreg_lookup(uint32_t imm)
                   constreg_cmp);
 }
 
+/**
+ * Whether a first source can not be swapped into S1: a literal that may go to
+ * the literal pool, a register S1 can't read (directly or through the mov
+ * forward propagation will fold), or a modifier the swap may not keep.
+ */
+static bool blocks_src_swap(pco_instr *const *defs, pco_ref ref)
+{
+   if (ref.abs || ref.flr)
+      return true;
+
+   if (!pco_ref_is_ssa(ref))
+      return !ref_src_map_valid(ref, PCO_IO_S1, NULL);
+
+   const pco_instr *def = defs[ref.val];
+   if (!def)
+      return false;
+
+   if (def->op == PCO_OP_MOVI32)
+      return !constreg_lookup(pco_ref_get_imm(def->src[0]));
+
+   if (def->op == PCO_OP_MOV)
+      return !ref_src_map_valid(def->src[0], PCO_IO_S1, NULL);
+
+   return false;
+}
+
+/**
+ * \brief Finds the SSA values every use of which could read a shared register
+ * directly (hardware sources S0, S2 and S3; see below for float ops). Pooling
+ * any other literal would only trade its materialization for a mov at every
+ * use.
+ *
+ * \param[in] func PCO function.
+ * \param[in] mem_ctx Allocation context.
+ * \return Array indexed by SSA value.
+ */
+static bool *shared_readable_ssa(pco_func *func, void *mem_ctx)
+{
+   pco_instr **defs = rzalloc_array_size(mem_ctx, sizeof(*defs), func->next_ssa);
+   bool *ok = ralloc_array_size(mem_ctx, sizeof(*ok), func->next_ssa);
+   memset(ok, true, sizeof(*ok) * func->next_ssa);
+
+   pco_foreach_instr_in_func (instr, func) {
+      pco_foreach_instr_dest_ssa (pdest, instr)
+         defs[pdest->val] = instr;
+   }
+
+   const pco_ref shared = pco_ref_hwreg(0, PCO_REG_CLASS_SHARED);
+   pco_foreach_instr_in_func (instr, func) {
+      const struct pco_op_info *info = &pco_op_info[instr->op];
+      pco_foreach_instr_src_ssa (psrc, instr) {
+         unsigned s = psrc - instr->src;
+
+         if (instr->op == PCO_OP_FADD || instr->op == PCO_OP_FMUL ||
+             instr->op == PCO_OP_FMAD) {
+            /* These can dual-issue on p1, which reads S3-S5: only the first
+             * source (S0/S3) takes a shared register either way. A second
+             * source does too once swapped with a temp first source.
+             */
+            if (s == 0)
+               continue;
+            if (s == 1 && !psrc->abs && !psrc->flr &&
+                !blocks_src_swap(defs, instr->src[0]))
+               continue;
+         } else if (info->type != PCO_OP_TYPE_PSEUDO &&
+                    info->src_intrn_map[s]) {
+            enum pco_io mapped = PCO_IO_S0 + info->src_intrn_map[s] - 1;
+            if (ref_src_map_valid(shared, mapped, NULL))
+               continue;
+         }
+
+         ok[psrc->val] = false;
+      }
+   }
+
+   return ok;
+}
+
+/**
+ * \brief Returns the shared register holding a literal, adding it to the
+ * shader's literal pool if needed.
+ *
+ * \param[in,out] data Shader data.
+ * \param[in] max_regs Limit on coefficient + shared registers.
+ * \param[in] imm The literal.
+ * \return The shared register index, or -1 if the pool is full.
+ */
+static int
+literal_pool_reg(pco_common_data *data, unsigned max_regs, uint32_t imm)
+{
+   for (unsigned i = 0; i < data->literals.count; i++)
+      if (data->literal_vals[i] == imm)
+         return data->literals.start + i;
+
+   if (data->literals.count == ARRAY_SIZE(data->literal_vals) ||
+       data->coeffs + data->shareds >= max_regs)
+      return -1;
+
+   /* The pool takes the shared registers after everything the driver
+    * allocated before compiling.
+    */
+   if (!data->literals.count)
+      data->literals.start = data->shareds;
+   assert(data->literals.start + data->literals.count == data->shareds);
+
+   data->literal_vals[data->literals.count++] = imm;
+   return data->shareds++;
+}
+
 /**
  * \brief Converts immediates into constant register lookups where possible.
  *
@@ -174,6 +284,40 @@ bool pco_const_imms(pco_shader *shader)
    bool progress = false;
 
    pco_foreach_func_in_shader (func, shader) {
+      /* Literal pool: an immediate costs a whole instruction group to
+       * materialize, while a shared register (filled once by the descriptor
+       * upload program) is read for free by the instructions using it.
+       */
+      if (shader->data.common.literal_pool) {
+         void *mem_ctx = ralloc_context(NULL);
+         bool *shared_ok = shared_readable_ssa(func, mem_ctx);
+
+         pco_foreach_instr_in_func_safe (instr, func) {
+            if (instr->op != PCO_OP_MOVI32 ||
+                !pco_ref_is_ssa(instr->dest[0]) ||
+                !shared_ok[instr->dest[0].val])
+               continue;
+
+            uint32_t imm = pco_ref_get_imm(instr->src[0]);
+            if (constreg_lookup(imm))
+               continue;
+
+            int reg = literal_pool_reg(&shader->data.common,
+                                       shader->ctx->dev_runtime_info->max_coeffs,
+                                       imm);
+            if (reg < 0)
+               continue;
+
+            pco_builder b =
+               pco_builder_create(func, pco_cursor_before_instr(instr));
+            pco_mov(&b, instr->dest[0], pco_ref_hwreg(reg, PCO_REG_CLASS_SHARED));
+            pco_instr_delete(instr);
+            progress = true;
+         }
+
+         ralloc_free(mem_ctx);
+      }
+
       /* Block-local hoisting: an immediate that is not in the hardware constant
        * table costs one materialization per use. Within a single block it is safe
        * to materialize it once and move from that register afterwards, because a
