 #define PRECOMP(_name, _feature_variants)    \
@@ -43,6 +44,7 @@ static const struct pdsc_precomp_info pdsc_precomp_infos[] = {
    PRECOMP(xfb_end, 0),
    PRECOMP(xfb_init, 0),
    PRECOMP(xfb_query_begin, 0),
+   PRECOMP(xfb_query_end, 0),
