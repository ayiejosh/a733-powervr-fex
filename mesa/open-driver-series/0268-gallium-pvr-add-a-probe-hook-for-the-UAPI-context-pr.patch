From fdd2d7f5f74ada932ca67592df08e00cafd7518d Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:01:23 +0800
Subject: [PATCH 268/294] gallium/pvr: add a probe hook for the UAPI context
 priority (PVR_PROBE_CTX_PRIORITY); test result: HIGH (-512/LOW and 512/HIGH)
 does not change the native TA kick outcome, which still times out - priority
 is not the DM2 stall's cause

---
 src/gallium/drivers/pvr_native/pvr_vm.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/gallium/drivers/pvr_native/pvr_vm.c b/src/gallium/drivers/pvr_native/pvr_vm.c
index 0ebb6c60..0ae5e53f 100644
--- a/src/gallium/drivers/pvr_native/pvr_vm.c
+++ b/src/gallium/drivers/pvr_native/pvr_vm.c
@@ -348,6 +348,10 @@ pvr_gpu_context_create(struct pvr_vm *vm, const struct pvr_device_info *dev_info
 
    args = (struct drm_pvr_ioctl_create_context_args) {
       .type = DRM_PVR_CTX_TYPE_RENDER,
+      /* Probe hook: try a different UAPI context priority (e.g. 512 = HIGH, -512 = LOW). */
+      .priority = getenv("PVR_PROBE_CTX_PRIORITY")
+                     ? (int32_t)strtol(getenv("PVR_PROBE_CTX_PRIORITY"), NULL, 0)
+                     : 0,
       .static_context_state = (uint64_t)(uintptr_t)static_state,
       .static_context_state_len = static_state_len,
       .vm_context_handle = vm->context_handle,
-- 
2.47.3

