+/* Waits for a syncobj to signal. The kernel's syncobj wait takes an absolute CLOCK_MONOTONIC deadline
+ * when WAIT_FOR_SUBMIT is used - the convention the reference winsys (and Mesa's Vulkan runtime) uses -
+ * and a relative timeout otherwise. Using the reference convention everywhere keeps the wait correct and
+ * lets the driver rely on the job actually being done when a submit returns. */
+static bool
+pvr_syncobj_wait(struct pvr_vm *vm, uint32_t syncobj, uint32_t timeout_ms)
+{
+   int64_t deadline = os_time_get_nano() + (int64_t)timeout_ms * 1000000LL;
+
+   return drmSyncobjWait(vm->fd, &syncobj, 1, deadline,
+                         DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL) == 0;
+}
+
+static bool
+pvr_syncobj_timeline_wait(struct pvr_vm *vm, uint32_t syncobj, uint64_t point,
+                          uint32_t timeout_ms)
+{
+   int64_t deadline = os_time_get_nano() + (int64_t)timeout_ms * 1000000LL;
+
+   return drmSyncobjTimelineWait(vm->fd, &syncobj, &point, 1, deadline,
+                                 DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL) == 0;
+}
