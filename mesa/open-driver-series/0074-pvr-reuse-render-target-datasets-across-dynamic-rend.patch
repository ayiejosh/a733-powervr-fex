From 805fddd92321474e93cc3c60137165f8b5e656b1 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sun, 11 Oct 2026 04:11:20 +0800
Subject: [PATCH 74/98] pvr: reuse render target datasets across dynamic
 renders

Dynamic rendering creates a render state, and with it a render target
dataset (free lists, RT data, macrotile arrays), for every
vkCmdBeginRendering, and destroys it when the command buffer is reset.
zink only uses dynamic rendering, so every GL frame paid for creating and
destroying one. Keep up to four freed datasets on the device and hand one
back to a render with the same creation parameters.

glmark2-es2 through zink, off-screen 800x600: about +13% overall.

CTS: robustness list (4025), 5062 list, loops/indexing/graphicsfuzz list
(6428), compute.pipeline (1235), TFBC list (9170), synchronization
(1718), dynamic_rendering sample (6745): identical to before.
---
 src/imagination/vulkan/pvr_arch_device.c     |  5 ++
 src/imagination/vulkan/pvr_arch_job_render.c |  6 ++
 src/imagination/vulkan/pvr_device.h          |  7 ++
 src/imagination/vulkan/pvr_rt_dataset.c      | 75 +++++++++++++++++++-
 src/imagination/vulkan/pvr_rt_dataset.h      |  9 +++
 5 files changed, 101 insertions(+), 1 deletion(-)

diff --git a/src/imagination/vulkan/pvr_arch_device.c b/src/imagination/vulkan/pvr_arch_device.c
index e46aabc..1e2d552 100644
--- a/src/imagination/vulkan/pvr_arch_device.c
+++ b/src/imagination/vulkan/pvr_arch_device.c
@@ -30,6 +30,7 @@
 #include "pvr_query.h"
 #include "pvr_queue.h"
 #include "pvr_robustness.h"
+#include "pvr_rt_dataset.h"
 #include "pvr_tex_state.h"
 #include "util/os_misc.h"
 
@@ -925,6 +926,7 @@ VkResult PVR_PER_ARCH(create_device)(struct pvr_physical_device *pdevice,
 
    simple_mtx_init(&device->rs_mtx, mtx_plain);
    list_inithead(&device->render_states);
+   pvr_rt_dataset_cache_init(device);
 
    *pDevice = pvr_device_to_handle(device);
 
@@ -1016,6 +1018,9 @@ void PVR_PER_ARCH(destroy_device)(struct pvr_device *device,
    simple_mtx_unlock(&device->rs_mtx);
    simple_mtx_destroy(&device->rs_mtx);
 
+   /* After the render states above, which hand their datasets to the cache. */
+   pvr_rt_dataset_cache_finish(device);
+
    pvr_arch_border_color_table_finish(device);
    pvr_robustness_buffer_finish(device);
    pvr_spm_finish_scratch_buffer_store(device);
diff --git a/src/imagination/vulkan/pvr_arch_job_render.c b/src/imagination/vulkan/pvr_arch_job_render.c
index 8a64b85..0cf5183 100644
--- a/src/imagination/vulkan/pvr_arch_job_render.c
+++ b/src/imagination/vulkan/pvr_arch_job_render.c
@@ -639,6 +639,12 @@ VkResult pvr_arch_render_target_dataset_create(
    assert(height <= rogue_get_render_size_max_y(dev_info));
    assert(layers > 0 && layers <= PVR_MAX_FRAMEBUFFER_LAYERS);
 
+   rt_dataset = pvr_rt_dataset_cache_take(device, width, height, samples, layers);
+   if (rt_dataset) {
+      *rt_dataset_out = rt_dataset;
+      return VK_SUCCESS;
+   }
+
    pvr_arch_rt_mtile_info_init(dev_info, &mtile_info, width, height, samples);
 
    rt_dataset = vk_zalloc(&device->vk.alloc,
diff --git a/src/imagination/vulkan/pvr_device.h b/src/imagination/vulkan/pvr_device.h
index 0f09e0c..cec8d67 100644
--- a/src/imagination/vulkan/pvr_device.h
+++ b/src/imagination/vulkan/pvr_device.h
@@ -182,6 +182,13 @@ struct pvr_device {
 
    simple_mtx_t rs_mtx;
    struct list_head render_states;
+
+   /* Recently freed RT datasets, most recent first, reused by renders of the
+    * same size (dynamic rendering creates and frees one per render).
+    */
+   simple_mtx_t rt_cache_mtx;
+   struct list_head rt_cache;
+   uint32_t rt_cache_count;
 };
 
 struct pvr_device_memory {
diff --git a/src/imagination/vulkan/pvr_rt_dataset.c b/src/imagination/vulkan/pvr_rt_dataset.c
index 8f110ce..b827903 100644
--- a/src/imagination/vulkan/pvr_rt_dataset.c
+++ b/src/imagination/vulkan/pvr_rt_dataset.c
@@ -60,7 +60,10 @@ void pvr_rt_vheap_rtc_data_fini(struct pvr_rt_dataset *rt_dataset)
    rt_dataset->vheap_rtc_bo = NULL;
 }
 
-void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset)
+/* Datasets kept for reuse; each holds a few BOs sized by the render area. */
+#define PVR_RT_CACHE_MAX 4
+
+static void pvr_rt_dataset_free(struct pvr_rt_dataset *rt_dataset)
 {
    struct pvr_device *device = rt_dataset->device;
 
@@ -74,3 +77,73 @@ void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset)
 
    vk_free(&device->vk.alloc, rt_dataset);
 }
+
+/* Called once the dataset's last user is done with it (its framebuffer is
+ * destroyed or its command buffer is reset or freed), so the GPU no longer
+ * uses it and the next render of the same size can take it over.
+ */
+void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset)
+{
+   struct pvr_device *device = rt_dataset->device;
+   struct pvr_rt_dataset *evict = NULL;
+
+   simple_mtx_lock(&device->rt_cache_mtx);
+   list_add(&rt_dataset->cache_link, &device->rt_cache);
+   if (++device->rt_cache_count > PVR_RT_CACHE_MAX) {
+      evict = list_last_entry(&device->rt_cache,
+                              struct pvr_rt_dataset,
+                              cache_link);
+      list_del(&evict->cache_link);
+      device->rt_cache_count--;
+   }
+   simple_mtx_unlock(&device->rt_cache_mtx);
+
+   if (evict)
+      pvr_rt_dataset_free(evict);
+}
+
+struct pvr_rt_dataset *pvr_rt_dataset_cache_take(struct pvr_device *device,
+                                                 uint32_t width,
+                                                 uint32_t height,
+                                                 uint32_t samples,
+                                                 uint32_t layers)
+{
+   struct pvr_rt_dataset *found = NULL;
+
+   simple_mtx_lock(&device->rt_cache_mtx);
+   list_for_each_entry (struct pvr_rt_dataset,
+                        rt_dataset,
+                        &device->rt_cache,
+                        cache_link) {
+      if (rt_dataset->width == width && rt_dataset->height == height &&
+          rt_dataset->samples == samples && rt_dataset->layers == layers) {
+         list_del(&rt_dataset->cache_link);
+         device->rt_cache_count--;
+         found = rt_dataset;
+         break;
+      }
+   }
+   simple_mtx_unlock(&device->rt_cache_mtx);
+
+   return found;
+}
+
+void pvr_rt_dataset_cache_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->rt_cache_mtx, mtx_plain);
+   list_inithead(&device->rt_cache);
+   device->rt_cache_count = 0;
+}
+
+void pvr_rt_dataset_cache_finish(struct pvr_device *device)
+{
+   list_for_each_entry_safe (struct pvr_rt_dataset,
+                             rt_dataset,
+                             &device->rt_cache,
+                             cache_link) {
+      list_del(&rt_dataset->cache_link);
+      pvr_rt_dataset_free(rt_dataset);
+   }
+   device->rt_cache_count = 0;
+   simple_mtx_destroy(&device->rt_cache_mtx);
+}
diff --git a/src/imagination/vulkan/pvr_rt_dataset.h b/src/imagination/vulkan/pvr_rt_dataset.h
index c0e56aa..8fd5530 100644
--- a/src/imagination/vulkan/pvr_rt_dataset.h
+++ b/src/imagination/vulkan/pvr_rt_dataset.h
@@ -11,6 +11,7 @@
 #include <stdbool.h>
 
 #include "util/bitscan.h"
+#include "util/list.h"
 
 #include "pvr_framebuffer.h"
 #include "pvr_rogue_fw.h"
@@ -23,6 +24,7 @@ struct pvr_winsys_rt_dataset;
 
 struct pvr_rt_dataset {
    struct pvr_device *device;
+   struct list_head cache_link;
 
    /* RT dataset information */
    uint32_t width;
@@ -69,6 +71,13 @@ void pvr_rt_tpc_data_fini(struct pvr_rt_dataset *rt_dataset);
 void pvr_rt_vheap_rtc_data_fini(struct pvr_rt_dataset *rt_dataset);
 
 void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset);
+struct pvr_rt_dataset *pvr_rt_dataset_cache_take(struct pvr_device *device,
+                                                 uint32_t width,
+                                                 uint32_t height,
+                                                 uint32_t samples,
+                                                 uint32_t layers);
+void pvr_rt_dataset_cache_init(struct pvr_device *device);
+void pvr_rt_dataset_cache_finish(struct pvr_device *device);
 
 static inline void
 pvr_render_targets_datasets_destroy(struct pvr_render_target *render_target)
