+/* Build and place the per-job pixel-event (end-of-tile) program: the pco-compiled USC shader that
+ * emits the pixel through the PBE, plus the PDS data segment that kicks it. This is what the
+ * fragment stream's CR_EVENT_PIXEL_PDS_DATA must name; the static EOT code at the kernel's PDS
+ * 'eot' area is only the shared code segment, not a program that knows about our render target.
+ * Returns the PDS-heap-relative offset of the data segment, or 0 on failure. */
+static uint64_t
+probe_place_eot_program(struct pvr_screen *scr, uint64_t rtaddr)
+{
+   const struct pvr_device_info *dev_info = &scr->dev_info;
+   const struct pvr_heap *usc = &scr->vm.heaps[DRM_PVR_HEAP_USC_CODE];
+   const struct pvr_heap *pds = &scr->vm.heaps[DRM_PVR_HEAP_PDS_CODE_DATA];
+   struct pvr_shader_eot eot = { 0 };
+   struct pvr_pds_event_program program = { 0 };
+   struct pvr_bo usc_bo = { 0 }, pds_bo = { 0 };
+   uint64_t usc_addr, pds_addr;
+   uint32_t state_words[2];
+   uint32_t staging[64] = { 0 };
+   uint32_t usc_offset;
+
+   pvr_csb_pbe_state_words(rtaddr, PIPE_FORMAT_R8G8B8A8_UNORM, 0, state_words);
+
+   if (!pvr_shader_eot_create(scr->pco_ctx, &eot, state_words)) {
+      printf("hwrt:          could not compile the end-of-tile program\n");
+      return 0;
+   }
+
+   /* USC code: DOUTU takes a USC-heap-relative offset. */
+   usc_addr = pvr_vm_heap_alloc(&scr->vm, DRM_PVR_HEAP_USC_CODE, eot.binary_size, 16, &usc_bo);
+   if (usc_addr == 0 || !pvr_bo_map(scr->fd, &usc_bo)) {
+      printf("hwrt:          could not place the end-of-tile USC code\n");
+      return 0;
+   }
+   memcpy(usc_bo.map, eot.binary, eot.binary_size);
+   usc_offset = usc_addr - usc->base;
+
+   /* The PDS program only kicks the USC shader (no DMA data of its own). */
+   pvr_pds_setup_doutu(&program.task_control, usc_offset, eot.temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, false);
+
+   /* Data segment size, then the segment itself. */
+   pvr_pds_generate_pixel_event(&program, NULL, PDS_GENERATE_SIZES, dev_info);
+   if (program.data_size > ARRAY_SIZE(staging)) {
+      printf("hwrt:          end-of-tile data segment too large (%u dwords)\n",
+             program.data_size);
+      return 0;
+   }
+   pvr_pds_generate_pixel_event(&program, staging, PDS_GENERATE_DATA_SEGMENT, dev_info);
+
+   pds_addr = pvr_vm_heap_alloc(&scr->vm, DRM_PVR_HEAP_PDS_CODE_DATA,
+                                (uint64_t)program.data_size * 4, 16, &pds_bo);
+   if (pds_addr == 0 || !pvr_bo_map(scr->fd, &pds_bo)) {
+      printf("hwrt:          could not place the end-of-tile PDS data\n");
+      return 0;
+   }
+   memcpy(pds_bo.map, staging, program.data_size * 4);
+
+   printf("hwrt:          end-of-tile program: USC 0x%x (%u bytes, %u temps), PDS data 0x%"
+          PRIx64 " (%u dwords)\n", usc_offset, eot.binary_size, eot.temps,
+          pds_addr - pds->base, program.data_size);
+   return pds_addr - pds->base;
+}
