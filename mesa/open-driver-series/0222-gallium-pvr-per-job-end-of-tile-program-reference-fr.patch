+void
+pvr_csb_pbe_state_words(uint64_t addr, enum pipe_format format, uint32_t mrt_index,
+                        uint32_t words[2])
+{
+   const struct util_format_description *desc = util_format_description(format);
+   const int chan = util_format_get_first_non_void_channel(format);
+   struct ROGUE_PBESTATE_STATE_WORD0 sw0 = { .address_low = addr };
+   struct ROGUE_PBESTATE_STATE_WORD1 sw1 = {
+      .address_high = addr,
+      .source_format = pvr_pbe_source_format_from_pipe(format, true),
+      .mrt_index = mrt_index,
+      .source_pos = ROGUE_PBESTATE_SOURCE_POS_START_BIT0,
+      .norm = chan >= 0 && desc->channel[chan].normalized,
+   };
+
+   /* Pack mode from the output format's first channel. */
+   if (desc->channel[chan].type == UTIL_FORMAT_TYPE_FLOAT) {
+      sw1.packmode = desc->channel[chan].size == 16
+                        ? ROGUE_PBESTATE_PACKMODE_F16F16F16F16
+                        : ROGUE_PBESTATE_PACKMODE_F32F32F32F32;
+   } else if (desc->channel[chan].size == 8) {
+      sw1.packmode = desc->channel[chan].type == UTIL_FORMAT_TYPE_SIGNED
+                        ? ROGUE_PBESTATE_PACKMODE_S8S8S8S8
+                        : ROGUE_PBESTATE_PACKMODE_U8U8U8U8;
+   } else {
+      sw1.packmode = desc->channel[chan].type == UTIL_FORMAT_TYPE_SIGNED
+                        ? ROGUE_PBESTATE_PACKMODE_S16S16S16S16
+                        : ROGUE_PBESTATE_PACKMODE_U16U16U16U16;
+   }
+
+   ROGUE_PBESTATE_STATE_WORD0_pack(&words[0], &sw0);
+   ROGUE_PBESTATE_STATE_WORD1_pack(&words[1], &sw1);
+}
