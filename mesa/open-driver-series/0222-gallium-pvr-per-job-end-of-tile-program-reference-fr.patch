index d3e86239..d8b95424 100644
--- a/src/gallium/drivers/pvr_native/pvr_shader.c
+++ b/src/gallium/drivers/pvr_native/pvr_shader.c
@@ -543,6 +543,30 @@ pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
    return true;
 }
 
+bool
+pvr_shader_eot_create(pco_ctx *ctx, struct pvr_shader_eot *eot,
+                      const uint32_t state_words[2])
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(),
+                                                  "pvr_eot");
+   nir_def *state0 = nir_imm_int(&b, state_words[0]);
+   nir_def *state1 = nir_imm_int(&b, state_words[1]);
+   nir_intrinsic_instr *last = nir_emitpix_pco(&b, state0, state1);
+   pco_data data = { .fs.uses.olchk_skip = true };
+
+   /* The reference marks the last emit as owning the pixel: `freep` releases the pixel for the
+    * next EOT in the tile. */
+   nir_intrinsic_set_freep(last, true);
+   nir_jump(&b, nir_jump_return);
+
+   if (!pvr_shader_compile_data(ctx, b.shader, &data, &eot->pco, &eot->binary,
+                                &eot->binary_size))
+      return false;
+
+   eot->temps = pco_shader_data(eot->pco)->common.temps;
+   return true;
+}
+
