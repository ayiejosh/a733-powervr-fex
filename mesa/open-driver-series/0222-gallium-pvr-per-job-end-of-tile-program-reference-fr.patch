+/* The end-of-tile (pixel-event) program: a tiny USC shader whose only job is to emit the pixel at
+ * end of tile through the pixel backend, using the PBE state words (target address, format) it is
+ * compiled with. The reference builds this per render target with pco (pvr_usc.c's pvr_usc_eot);
+ * without it the fragment job's CR_EVENT_PIXEL_PDS_DATA names a program that never writes anything. */
+struct pvr_shader_eot {
+   pco_shader *pco;
+   const void *binary;
+   unsigned binary_size;
+   unsigned temps;
+};
+
+bool pvr_shader_eot_create(pco_ctx *ctx, struct pvr_shader_eot *eot,
+                           const uint32_t state_words[2]);
+
 /* One compiled shader: the pco shader and the microcode it encoded. */
 struct pvr_shader {
    pco_shader *pco;
