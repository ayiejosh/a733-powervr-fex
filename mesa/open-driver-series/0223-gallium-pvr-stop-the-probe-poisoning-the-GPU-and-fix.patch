             uint64_t daddr = 0;
             _Alignas(8) static uint8_t dfw_buf[1024];
@@ -1110,17 +1084,6 @@ real_job_done:
                _Alignas(8) static uint8_t fstream[1024];
                const uint32_t f2 = pvr_frag_static_stream(fstream, sizeof(fstream), pbe_words, 1,
                                                          (uint32_t)eot_data_offset, false);
-               /* Which half of the combined kick is stuck? A geometry-only submission uses the
