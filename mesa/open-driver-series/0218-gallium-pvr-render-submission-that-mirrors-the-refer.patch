@@ -984,8 +1027,15 @@ real_job_done:
                   }
                }
 
-               const uint32_t glen = pvr_geom_static_stream(rctl.map, rctl.size, rctladdr,
-                                                           rbctaddr, false, 0, false, 0, 0,
+               /* The geometry firmware stream goes in its OWN buffer: it is the job's cmd_stream,
+                * and it names the control stream by address (CR_VDM_CTRL_STREAM_BASE). Building it
+                * into the control stream's BO - which is what this did before - overwrites the
+                * stream the TA is then pointed at, so the pointer and the contents disagree and
+                * nothing is drawn. completeonterminate and usc_common_size are the capture's
+                * values (TE_PSG bit 17, PDS_STATE0 = 0x20010000). */
+               _Alignas(8) static uint8_t gstream[1024];
+               const uint32_t glen = pvr_geom_static_stream(gstream, sizeof(gstream), rctladdr,
+                                                           rbctaddr, true, 0, false, 1, 0,
                                                            PVR_HAS_QUIRK(dev_info, 49927));
                /* The fragment stream has to live in its own buffer, so rebuild it there. */
                _Alignas(8) static uint8_t fstream[1024];
@@ -993,14 +1043,31 @@ real_job_done:
                                                          (const uint64_t *)rtcsb.map, 1, 0x2780,
                                                          false);
                (void)flen;
-               if (pvr_job_submit_render(&vm, gpu_ctx.handle, rctl.map, glen, fstream, f2,
+               if (pvr_job_submit_render(&vm, gpu_ctx.handle, gstream, glen, fstream, f2,
                                          dset_handle, 0)) {
                   uint32_t changed = 0;
-                  for (uint32_t i = 0; i < RTW * RTH; i++)
-                     if (rt[i] != 0x5a) { changed = 1; break; }
+                  unsigned waited_us = 0;
+
+                  /* The submit is asynchronous: reading the target once straight after it races
+                   * the GPU and reports "unchanged" whether or not the draw happened. Poll for a
+                   * bounded time instead, and report how long the first write took (or that none
+                   * arrived). One small surface, so a couple of seconds is generous, not flaky. */
+                  while (waited_us < 2000000) {
+                     for (uint32_t i = 0; i < RTW * RTH; i++) {
+                        if (rt[i] != 0x5a) {
+                           changed = 1;
+                           break;
+                        }
+                     }
+                     if (changed)
+                        break;
+                     usleep(10000);
+                     waited_us += 10000;
+                  }
                   printf("hwrt:          RENDER SUBMIT ACCEPTED (geom %u B + frag %u B) - target %s "
-                         "(first word 0x%08x, was 0x%08x)\n", glen, f2,
-                         changed ? "CHANGED BY THE GPU" : "unchanged", *(uint32_t *)rt, before);
+                         "after %u us (first word 0x%08x, was 0x%08x)\n", glen, f2,
+                         changed ? "CHANGED BY THE GPU" : "unchanged", waited_us,
+                         *(uint32_t *)rt, before);
                } else {
