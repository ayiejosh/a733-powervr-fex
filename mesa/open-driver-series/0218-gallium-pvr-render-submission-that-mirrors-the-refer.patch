+                                * this at least removes it as a variable. */
+                               !pvr_csb_emit_index_list(&ctl_csb, 0, 3, 1,
+                                                        ROGUE_VDMCTRL_INDEX_SIZE_B8,
+                                                        ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_TRI_LIST) ||
                                !pvr_csb_emit_ppp_state(&ctl_csb, taddr, 3) ||
                                !pvr_csb_emit_stream_terminate(&ctl_csb)) {
