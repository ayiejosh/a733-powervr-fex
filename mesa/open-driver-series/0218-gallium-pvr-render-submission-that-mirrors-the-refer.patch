                }
diff --git a/src/gallium/drivers/pvr_native/pvr_vm.c b/src/gallium/drivers/pvr_native/pvr_vm.c
index da3b4099..26ba17b4 100644
--- a/src/gallium/drivers/pvr_native/pvr_vm.c
+++ b/src/gallium/drivers/pvr_native/pvr_vm.c
@@ -383,44 +383,153 @@ pvr_job_submit(struct pvr_vm *vm, uint32_t context_handle, uint32_t job_type,
 
 /* A render pass is TWO jobs - geometry then fragment - in ONE submit. The kernel validates each job
  * (pvr_job.c:411: a non-zero cmd_stream AND cmd_stream_len), so both streams have to be real. */
+bool
+pvr_job_submit_geom_sync(struct pvr_vm *vm, uint32_t context_handle,
+                         const void *geom_stream, uint32_t geom_len,
+                         uint32_t hwrt_set_handle, uint32_t hwrt_data_index,
+                         uint32_t timeout_ms)
+{
+   struct drm_pvr_sync_op sync_ops[1];
+   struct drm_pvr_job job = {
+      .type = DRM_PVR_JOB_TYPE_GEOMETRY,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)geom_stream,
+      .cmd_stream_len = geom_len,
+      .flags = DRM_PVR_SUBMIT_JOB_GEOM_CMD_FIRST | DRM_PVR_SUBMIT_JOB_GEOM_CMD_LAST,
+      .sync_ops = { .stride = sizeof(sync_ops[0]), .count = 1,
+                    .array = (__u64)(uintptr_t)sync_ops },
+      .hwrt = { .set_handle = hwrt_set_handle, .data_index = hwrt_data_index },
+   };
+   struct drm_pvr_ioctl_submit_jobs_args args = {
+      .jobs = { .stride = sizeof(job), .count = 1,
+                .array = (__u64)(uintptr_t)&job },
+   };
+   uint32_t sync = 0;
+   bool completed;
+
+   if (drmSyncobjCreate(vm->fd, 0, &sync) != 0)
+      return false;
+
+   sync_ops[0] = (struct drm_pvr_sync_op){
+      .handle = sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+      .value = 0,
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+      mesa_loge("pvr: geometry-only submit failed: %s", strerror(errno));
+      drmSyncobjDestroy(vm->fd, sync);
+      return false;
+   }
+
+   completed = drmSyncobjWait(vm->fd, &sync, 1, (int64_t)timeout_ms * 1000000LL, 0,
+                              NULL) == 0;
+   drmSyncobjDestroy(vm->fd, sync);
+   return completed;
+}
+
 bool
 pvr_job_submit_render(struct pvr_vm *vm, uint32_t context_handle,
                       const void *geom_stream, uint32_t geom_len,
                       const void *frag_stream, uint32_t frag_len,
                       uint32_t hwrt_set_handle, uint32_t hwrt_data_index)
 {
-   struct drm_pvr_job jobs[2] = {
-      {
-         .type = DRM_PVR_JOB_TYPE_GEOMETRY,
-         .context_handle = context_handle,
-         .cmd_stream = (uint64_t)(uintptr_t)geom_stream,
-         .cmd_stream_len = geom_len,
-         .sync_ops = { .stride = sizeof(struct drm_pvr_sync_op), .count = 0 },
-         .hwrt = { .set_handle = hwrt_set_handle, .data_index = hwrt_data_index },
-      }, {
-         .type = DRM_PVR_JOB_TYPE_FRAGMENT,
-         .context_handle = context_handle,
-         .cmd_stream = (uint64_t)(uintptr_t)frag_stream,
-         .cmd_stream_len = frag_len,
-         .sync_ops = { .stride = sizeof(struct drm_pvr_sync_op), .count = 0 },
-         .hwrt = { .set_handle = hwrt_set_handle, .data_index = hwrt_data_index },
-      },
-   };
+   /* Geometry and fragment jobs are different job types, so the kernel does not order them against
+    * each other; the reference chains them with syncobjs and submits THREE jobs: geometry, a
+    * partial-render fragment job, then the fragment job. The geometry and PR jobs pair into one
+    * combined kick (the kernel pairs them when the fragment job waits on the geometry job's
+    * scheduled fence). Submitting fewer than that leaves the firmware with a render it never
+    * completes: accepted by the kernel, no pixels, no error. */
+   uint32_t geom_sync = 0, pr_sync = 0, done_sync = 0;
+   struct drm_pvr_sync_op geom_ops[1], pr_ops[2], frag_ops[1];
+   struct drm_pvr_job jobs[3];
    struct drm_pvr_ioctl_submit_jobs_args args = {
-      .jobs = {
-         .stride = sizeof(jobs[0]),
-         .count = ARRAY_SIZE(jobs),
-         .array = (__u64)(uintptr_t)jobs,
-      },
+      .jobs = { .stride = sizeof(jobs[0]), .count = ARRAY_SIZE(jobs),
+                .array = (__u64)(uintptr_t)jobs },
    };
+   bool submitted, completed;
 
-   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
-      mesa_loge("pvr: SUBMIT_JOBS render (geom %u B at %p, frag %u B at %p) failed: %s",
-                geom_len, geom_stream, frag_len, frag_stream, strerror(errno));
+   if (drmSyncobjCreate(vm->fd, 0, &geom_sync) != 0)
+      return false;
+   if (drmSyncobjCreate(vm->fd, 0, &pr_sync) != 0) {
+      drmSyncobjDestroy(vm->fd, geom_sync);
+      return false;
+   }
+   if (drmSyncobjCreate(vm->fd, 0, &done_sync) != 0) {
+      drmSyncobjDestroy(vm->fd, pr_sync);
+      drmSyncobjDestroy(vm->fd, geom_sync);
       return false;
    }
 
-   return true;
+   geom_ops[0] = (struct drm_pvr_sync_op){
+      .handle = geom_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   pr_ops[0] = (struct drm_pvr_sync_op){
+      .handle = geom_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_WAIT | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   pr_ops[1] = (struct drm_pvr_sync_op){
+      .handle = pr_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   frag_ops[0] = (struct drm_pvr_sync_op){
+      .handle = pr_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_WAIT | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+
+   jobs[0] = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_GEOMETRY,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)geom_stream,
+      .cmd_stream_len = geom_len,
+      .flags = DRM_PVR_SUBMIT_JOB_GEOM_CMD_FIRST | DRM_PVR_SUBMIT_JOB_GEOM_CMD_LAST,
+      .sync_ops = { .stride = sizeof(geom_ops[0]), .count = 1,
+                    .array = (__u64)(uintptr_t)geom_ops },
+      .hwrt = { .set_handle = hwrt_set_handle, .data_index = hwrt_data_index },
+   };
+   jobs[1] = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_FRAGMENT,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)frag_stream,
+      .cmd_stream_len = frag_len,
+      .flags = DRM_PVR_SUBMIT_JOB_FRAG_CMD_PARTIAL_RENDER,
+      .sync_ops = { .stride = sizeof(pr_ops[0]), .count = ARRAY_SIZE(pr_ops),
+                    .array = (__u64)(uintptr_t)pr_ops },
+      .hwrt = { .set_handle = hwrt_set_handle, .data_index = hwrt_data_index },
+   };
+   jobs[2] = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_FRAGMENT,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)frag_stream,
+      .cmd_stream_len = frag_len,
+      .sync_ops = { .stride = sizeof(frag_ops[0]), .count = 1,
+                    .array = (__u64)(uintptr_t)frag_ops },
+      .hwrt = { .set_handle = hwrt_set_handle, .data_index = hwrt_data_index },
+   };
+
+   submitted = drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) == 0;
+   if (!submitted)
+      mesa_loge("pvr: SUBMIT_JOBS render (geom %u B, frag %u B) failed: %s", geom_len,
+                frag_len, strerror(errno));
+
+   if (submitted && getenv("PVR_PROBE_TRACE_SYNC") != NULL && submitted) {
+      const bool geom_done =
+         drmSyncobjWait(vm->fd, &geom_sync, 1, 500000000LL, 0, NULL) == 0;
+
+      mesa_logi("pvr: geometry job %s", geom_done ? "COMPLETED" : "did not complete in 500 ms");
+   }
+
+   completed = submitted &&
+      drmSyncobjWait(vm->fd, &done_sync, 1, 2000000000LL, 0, NULL) == 0;
+   if (submitted && !completed)
+      mesa_loge("pvr: the render job did not signal completion within 2 s");
+
+   drmSyncobjDestroy(vm->fd, done_sync);
+   drmSyncobjDestroy(vm->fd, pr_sync);
+   drmSyncobjDestroy(vm->fd, geom_sync);
+
+   return completed;
 }
 
