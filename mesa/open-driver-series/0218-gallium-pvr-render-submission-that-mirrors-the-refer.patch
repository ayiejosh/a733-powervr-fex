 src/gallium/drivers/pvr_native/pvr_csb.h   |  12 +-
 src/gallium/drivers/pvr_native/pvr_probe.c |  85 +++++++++--
 src/gallium/drivers/pvr_native/pvr_vm.c    | 161 +++++++++++++++++----
 src/gallium/drivers/pvr_native/pvr_vm.h    |   8 +
 5 files changed, 260 insertions(+), 46 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_csb.c b/src/gallium/drivers/pvr_native/pvr_csb.c
index 1d3d1989..cb8d95a9 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.c
+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -179,23 +179,34 @@ pvr_csb_emit_ppp_state(struct pvr_csb *csb, uint64_t state_addr, uint32_t word_c
  * state emitter uses. */
 bool
 pvr_csb_emit_index_list(struct pvr_csb *csb, uint64_t index_addr, uint32_t index_count,
-                        uint32_t instance_count, enum ROGUE_VDMCTRL_INDEX_SIZE index_size)
+                        uint32_t instance_count, enum ROGUE_VDMCTRL_INDEX_SIZE index_size,
+                        enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY topology)
 {
+   /* The packets that follow the header are optional and their presence bits decide the length.
+    * index_addr == 0 means a NON-INDEXED draw (vkCmdDraw) - the hardware reads vertices
+    * sequentially, exactly what the captured working draw does; non-zero means the address and
+    * size packets are carried for an indexed draw. The instance-count packet is only worth its
+    * dword when it is not the default of one, as the capture shows. */
+   const bool have_addr = index_addr != 0;
+   const bool have_instances = instance_count > 1;
    struct ROGUE_VDMCTRL_INDEX_LIST0 list0 = {
       .block_type = ROGUE_VDMCTRL_BLOCK_TYPE_INDEX_LIST,
-      .index_addr_present = true,
+      .index_addr_present = have_addr,
       .index_count_present = true,
-      .index_instance_count_present = true,
-      .degen_cull_enable = true,
+      .index_instance_count_present = have_instances,
+      /* The capture leaves degenerate-culling and patch count at their defaults: this part has no
+       * degenerate-culling feature, and a non-patch topology uses a patch count of one (stored 0). */
+      .degen_cull_enable = false,
       .index_size = index_size,
+      .primitive_topology = topology,
    };
    struct ROGUE_VDMCTRL_INDEX_LIST1 list1 = { .index_base_addrlsb = index_addr };
    struct ROGUE_VDMCTRL_INDEX_LIST2 list2 = { .index_count = index_count };
    struct ROGUE_VDMCTRL_INDEX_LIST3 list3 = { .instance_count = instance_count };
    const uint32_t words = ROGUE_VDMCTRL_INDEX_LIST0_length +
-                          ROGUE_VDMCTRL_INDEX_LIST1_length +
+                          (have_addr ? ROGUE_VDMCTRL_INDEX_LIST1_length : 0) +
                           ROGUE_VDMCTRL_INDEX_LIST2_length +
-                          ROGUE_VDMCTRL_INDEX_LIST3_length;
+                          (have_instances ? ROGUE_VDMCTRL_INDEX_LIST3_length : 0);
    uint32_t *dw = pvr_csb_emit(csb, words);
    uint32_t at = ROGUE_VDMCTRL_INDEX_LIST0_length;
 
@@ -203,11 +214,17 @@ pvr_csb_emit_index_list(struct pvr_csb *csb, uint64_t index_addr, uint32_t index
       return false;
 
    ROGUE_VDMCTRL_INDEX_LIST0_pack(dw, &list0);
-   ROGUE_VDMCTRL_INDEX_LIST1_pack(dw + at, &list1);
-   at += ROGUE_VDMCTRL_INDEX_LIST1_length;
+
+   if (have_addr) {
+      ROGUE_VDMCTRL_INDEX_LIST1_pack(dw + at, &list1);
+      at += ROGUE_VDMCTRL_INDEX_LIST1_length;
+   }
+
    ROGUE_VDMCTRL_INDEX_LIST2_pack(dw + at, &list2);
    at += ROGUE_VDMCTRL_INDEX_LIST2_length;
-   ROGUE_VDMCTRL_INDEX_LIST3_pack(dw + at, &list3);
+
+   if (have_instances)
+      ROGUE_VDMCTRL_INDEX_LIST3_pack(dw + at, &list3);
 
    return true;
 }
@@ -1312,7 +1329,10 @@ pvr_geom_static_stream(void *stream, uint32_t stream_size,
       p += PVR_DW_TO_BYTES(PVR_CMD_DW(CR_TE_PSG));
    }
    {
-      struct ROGUE_VDMCTRL_PDS_STATE0 v = { .usc_common_size = usc_common_size };
+      struct ROGUE_VDMCTRL_PDS_STATE0 v = {
+         ROGUE_VDMCTRL_PDS_STATE0_header,
+         .usc_common_size = usc_common_size,
+      };
       ROGUE_VDMCTRL_PDS_STATE0_pack((uint32_t *)p, &v);
       p += PVR_DW_TO_BYTES(PVR_CMD_DW(VDMCTRL_PDS_STATE0));
    }
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.h b/src/gallium/drivers/pvr_native/pvr_csb.h
index 75acabbf..694919d9 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.h
+++ b/src/gallium/drivers/pvr_native/pvr_csb.h
@@ -716,8 +716,18 @@ void pvr_csb_reset(struct pvr_csb *csb);
  * fit - in which case nothing is reserved and the CSB is marked overflowed. */
 uint32_t *pvr_csb_emit(struct pvr_csb *csb, uint32_t words);
 bool pvr_csb_emit_stream_terminate(struct pvr_csb *csb);
+/* An INDEX_LIST block tells the TA where the vertex indices are, how many there are, and - the
+ * part that is easy to leave at zero - WHICH PRIMITIVE TOPOLOGY to assemble. The topology field is
+ * not optional: a zero there is POINT_LIST, and the TA then treats triangle vertex triples as
+ * points, so the draw bins the wrong primitives and nothing reaches rasterisation.
+ *
+ * A zero index_addr means a non-indexed draw (vkCmdDraw): the index address packet is omitted and
+ * vertices are read sequentially, which is what the captured working draw does. The instance
+ * count packet is omitted for the default of one, also as the capture does. */
 bool pvr_csb_emit_index_list(struct pvr_csb *csb, uint64_t index_addr, uint32_t index_count,
-                             uint32_t instance_count, enum ROGUE_VDMCTRL_INDEX_SIZE index_size);
+                             uint32_t instance_count,
+                             enum ROGUE_VDMCTRL_INDEX_SIZE index_size,
+                             enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY topology);
 
 uint32_t pvr_csb_size(const struct pvr_csb *csb);
 bool pvr_csb_overflowed(const struct pvr_csb *csb);
