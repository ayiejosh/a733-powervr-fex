From e846a194a72db26fe2abe6789c4c315be43c71c0 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Thu, 29 Oct 2026 01:26:58 +0800
Subject: [PATCH] gallium/pvr: keep a deferred level-0 clear across renders
 into other levels

Review of 0323: draw_open dropped a deferred clear of a texture whenever a
render opened on any level of it, but applied it only to level 0, so
clearing level 0 (deferred) and then rendering into level 2 lost the
level-0 clear. The flag is now consumed only by a level-0 render.

Also: draw_materialize allocates the draw state when the reading context
never drew (a shared texture cleared in another context), and
flush_resource submits a deferred clear of a window-system buffer before
it is presented (deferral already skips shared/scanout buffers; this
covers a back buffer without those binds).

gltri GLTRI_MIPRT=0 GLTRI_MIPRT2=2 (clear level 0, then level 2) matches
zink at lod 0 (yellow) and lod 2 (cyan); this test passes on the previous
build too, so it does not reach the dropped-clear path itself. All other
modes unchanged.
---
 src/gallium/drivers/pvr_native/pvr_context.c |  8 +++++++-
 src/gallium/drivers/pvr_native/pvr_draw.c    | 15 ++++++++++++---
 src/gallium/drivers/pvr_native/pvr_draw.h    |  2 ++
 3 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index f89d1216..7c28cd91 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -783,7 +783,13 @@ static void pvr_set_clip_state(UNUSED struct pipe_context *p, UNUSED const struc
 static void pvr_set_polygon_stipple(UNUSED struct pipe_context *p, UNUSED const struct pipe_poly_stipple *s) {}
 static void pvr_texture_barrier(UNUSED struct pipe_context *p, UNUSED unsigned flags) {}
 static void pvr_memory_barrier(UNUSED struct pipe_context *p, UNUSED unsigned flags) {}
-static void pvr_flush_resource(UNUSED struct pipe_context *p, UNUSED struct pipe_resource *r) {}
+/* Called on a window-system buffer before it is presented: a clear deferred on it must reach it
+ * (deferral already skips shared/scanout buffers; this covers a back buffer without those binds). */
+static void
+pvr_flush_resource(struct pipe_context *p, struct pipe_resource *r)
+{
+   pvr_draw_resource_materialize(pvr_context(p), pvr_resource(r));
+}
 static void pvr_invalidate_resource(UNUSED struct pipe_context *p, UNUSED struct pipe_resource *r) {}
 
 /* A copy of a whole level between colour target resources is one GPU render (instead of two
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 295c2573..cbf27bbb 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -1209,8 +1209,8 @@ draw_open(struct pvr_context *ctx, struct pvr_draw_state *d, struct pipe_resourc
    if (rres->clear_pending && level == 0) {
       d->clear_valid = true;
       d->clear_color = rres->clear_color;
+      rres->clear_pending = false;
    }
-   rres->clear_pending = false;
    if (d->zs && pvr_resource(d->zs)->zclear_pending) {
       d->zclear_valid = true;
       d->zclear = pvr_resource(d->zs)->zclear;
@@ -1255,9 +1255,12 @@ static void
 draw_materialize(struct pvr_context *ctx, struct pipe_resource *pres)
 {
    struct pvr_resource *res = pvr_resource(pres);
-   struct pvr_draw_state *d = ctx->draw;
-   if (d == NULL || pres == NULL || (!res->clear_pending && !res->zclear_pending))
+   if (pres == NULL || (!res->clear_pending && !res->zclear_pending))
+      return;
+   /* The clear may have been recorded by another context (a shared texture). */
+   if (ctx->draw == NULL && (ctx->draw = calloc(1, sizeof(struct pvr_draw_state))) == NULL)
       return;
+   struct pvr_draw_state *d = ctx->draw;
    pvr_draw_flush(ctx);
    struct pipe_resource *rt = pres, *zs = NULL;
    if (res->zclear_pending) {
@@ -1662,6 +1665,12 @@ pvr_draw_blit(struct pvr_context *ctx, struct pipe_resource *dst, unsigned dst_l
    return true;
 }
 
+void
+pvr_draw_resource_materialize(struct pvr_context *ctx, struct pvr_resource *res)
+{
+   draw_materialize(ctx, &res->base);
+}
+
 void
 pvr_draw_resource_sync(struct pvr_context *ctx, struct pvr_resource *res)
 {
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.h b/src/gallium/drivers/pvr_native/pvr_draw.h
index 705251f1..755d4912 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.h
+++ b/src/gallium/drivers/pvr_native/pvr_draw.h
@@ -44,6 +44,8 @@ bool pvr_draw_note_zclear(struct pvr_context *ctx, float depth);
  * last render that used it. */
 struct pvr_resource;
 void pvr_draw_resource_sync(struct pvr_context *ctx, struct pvr_resource *res);
+/* Submits a deferred clear of the resource, if it has one (see draw_materialize). */
+void pvr_draw_resource_materialize(struct pvr_context *ctx, struct pvr_resource *res);
 
 /* The syncobj of the latest submitted render (0: none in flight). */
 uint32_t pvr_draw_last_sync(struct pvr_context *ctx);
-- 
