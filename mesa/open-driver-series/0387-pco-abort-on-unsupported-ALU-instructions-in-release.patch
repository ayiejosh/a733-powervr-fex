From bfcee2c9328c517161b670258ab92dc460f6c49b Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:46:00 +0800
Subject: [PATCH] pco: abort on unsupported ALU instructions in release builds

The default case of trans_alu() printed the offending instruction and then
called UNREACHABLE().  Under -DNDEBUG the assert half of that macro compiles
out and only __builtin_unreachable() remains (undefined behaviour), so the
function did fall through with an uninitialised pco_instr and the caller
looped forever re-printing the message - one case was hit while measuring
mediump/f16 code generation offline (f16 fdot3/f2i16 reached it).  That
turned any unsupported opcode into unbounded output plus undefined behaviour.
Abort deterministically instead: an unsupported opcode is a compiler bug, not
something to paper over at runtime.
---
 src/imagination/pco/pco_trans_nir.c | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index d443e2a3..8873ac67 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -4894,10 +4894,17 @@ static pco_instr *trans_alu(trans_ctx *tctx, nir_alu_instr *alu)
    }
 
    default:
-      printf("Unsupported alu instruction: \"");
-      nir_print_instr(&alu->instr, stdout);
-      printf("\"\n");
-      UNREACHABLE("");
+      /* In a release build the assert half of UNREACHABLE() compiles out and
+       * only __builtin_unreachable() remains (undefined behaviour), so this
+       * path did fall through with an uninitialised instruction and the caller
+       * looped forever re-printing the message (hit by the offline harness
+       * while probing mediump/f16).  Abort even in release builds: an
+       * unsupported opcode is a compiler bug and must fail deterministically.
+       */
+      fprintf(stderr, "pco: unsupported ALU instruction: \"");
+      nir_print_instr(&alu->instr, stderr);
+      fprintf(stderr, "\"\n");
+      abort();
    }
 
    if (!pco_ref_is_scalar(dest))
-- 
2.47.3

