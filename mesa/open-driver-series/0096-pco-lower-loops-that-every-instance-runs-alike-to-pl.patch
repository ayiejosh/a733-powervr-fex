+/* A loop that every instance runs the same number of times (all its breaks and
+ * continues are under uniform ifs) is a plain branch loop: nothing masks
+ * instances. The prologue block stays empty; the epilogue is the back edge
+ * followed by the exit block that breaks branch to.
+ */
+static inline void lower_loop_uniform(pco_loop *loop, pco_func *func)
+{
+   assert(list_is_empty(&loop->prologue));
+   assert(list_is_empty(&loop->interlogue));
+   assert(list_is_empty(&loop->epilogue));
+
+   cf_section_create(func,
+                     &loop->cf_node,
+                     &loop->prologue,
+                     PCO_CF_NODE_FLAG_PROLOGUE);
+   pco_block *backedge = cf_section_create(func,
+                                           &loop->cf_node,
+                                           &loop->epilogue,
+                                           PCO_CF_NODE_FLAG_EPILOGUE);
+   pco_block *exit = cf_section_create(func,
+                                       &loop->cf_node,
+                                       &loop->epilogue,
+                                       PCO_CF_NODE_FLAG_EPILOGUE);
+   loop->exit = &exit->cf_node;
+
+   pco_builder b = pco_builder_create(func, pco_cursor_after_block(backedge));
+   pco_br(&b, pco_cf_node_head(&loop->body), .exec_cnd = PCO_EXEC_CND_EX_ZX);
+
+   /* Keeps the exit block, a branch target and the loop's end for the
+    * register allocator, from being empty.
+    */
+   b.cursor = pco_cursor_after_block(exit);
+   pco_nop(&b);
+}
