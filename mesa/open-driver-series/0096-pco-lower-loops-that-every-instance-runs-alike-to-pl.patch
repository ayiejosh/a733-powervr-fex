+   unsigned num_vregs;
+   BITSET_WORD *visiting; /** vregs on the current path. */
+   unsigned visits; /** Instructions seen by the current query. */
+};
+
+/* Bound on the instructions one query walks: the walk is not memoised. */
+#define UNIFORM_MAX_VISITS 4096U
