+static bool ref_is_uniform(struct uniform_ctx *ctx, pco_ref ref, unsigned depth)
+{
+   if (pco_ref_is_null(ref) || pco_ref_is_imm(ref))
+      return true;
+
+   if (pco_ref_is_vreg(ref)) {
+      if (!depth || ref.val >= ctx->num_vregs)
+         return false;
+
+      /* Already on the path: a loop counter. */
+      if (BITSET_TEST(ctx->visiting, ref.val))
+         return true;
+
+      struct util_dynarray *writers = &ctx->vreg_writes[ref.val];
+      if (!util_dynarray_num_elements(writers, pco_instr *))
+         return false;
+
+      BITSET_SET(ctx->visiting, ref.val);
+      bool uniform = true;
+      util_dynarray_foreach (writers, pco_instr *, writer) {
+         if (!instr_is_uniform(ctx, *writer, depth)) {
+            uniform = false;
+            break;
+         }
+      }
+      BITSET_CLEAR(ctx->visiting, ref.val);
+
+      return uniform;
+   }
+
+   if (pco_ref_is_hwreg(ref)) {
+      enum pco_reg_class reg_class = pco_ref_get_reg_class(ref);
+      return reg_class == PCO_REG_CLASS_SHARED ||
+             reg_class == PCO_REG_CLASS_CONST;
+   }
+
+   if (!pco_ref_is_ssa(ref) || !depth || ref.val >= ctx->num_writes ||
+       !ctx->writes[ref.val])
+      return false;
+
+   return instr_is_uniform(ctx, ctx->writes[ref.val], depth);
+}
+
+/* The loop a break or continue belongs to, and whether only uniform ifs lie
+ * between them.
+ */
+static pco_loop *break_loop(pco_block *block, bool *uniform)
+{
+   *uniform = true;
+   for (pco_cf_node *node = block->cf_node.parent; node; node = node->parent) {
+      if (node->type == PCO_CF_NODE_TYPE_LOOP)
+         return pco_cf_node_as_loop(node);
+
+      assert(node->type == PCO_CF_NODE_TYPE_IF);
+      if (!pco_cf_node_as_if(node)->uniform_cond)
+         *uniform = false;
+   }
+
+   UNREACHABLE("break or continue outside of a loop");
+}
