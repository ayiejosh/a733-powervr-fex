+/* The vertex half of the VDM state. All of it comes from a capture of a working draw
+ * (open-driver-perf/captures/vkrender_draw_stream_decoded.txt): a draw that executes its vertex
+ * program sets BOTH presence flags and then carries the code address, the output size and the
+ * allocation sizes. A stream that only names the PDS data address runs an attribute fetch and never
+ * starts a shader - which looks exactly like a correct stream until no pixel changes. */
+struct pvr_vdm_vs {
+   /* STATE2: the attribute program's DATA segment (the patched const map, not the vertex buffer). */
+   uint64_t pds_data_addr;
+   /* STATE3: the attribute program's CODE segment. Non-zero means the VS info packets are sent. */
+   uint64_t pds_code_addr;
+   /* STATE4: varying registers written per vertex (pco_data.vs.vtxouts). */
+   uint32_t output_size;
+   /* STATE5: vtxin registers * 4 (pco_data.common.vtxins << 2). */
+   uint32_t usc_unified_bytes;
+   /* STATE5: the attribute program's PDS temp count and data segment size, in dwords. */
+   uint32_t pds_temp_dwords;
+   uint32_t pds_data_dwords;
+   /* STATE5: from pvr_vdm_cam_size(). */
+   uint32_t max_instances;
+   /* STATE0: from pvr_vdm_cam_size(); this is the field value (31 for cam_size 32). */
+   uint32_t cam_size;
+};
+
 /* The VDM state update, which is a CONDITIONALLY VARIABLE-LENGTH group rather than a fixed
- * shape: VDMCTRL_VDM_STATE0 carries flags saying which of STATE1..N follow it, and the
+ * shape: VDMCTRL_VDM_STATE0 carries flags saying which of STATE1..5 follow it, and the
  * presence packs are only emitted for the flags that are set. VDM_STATE1 appears when a
- * cut index is needed, VDM_STATE2 when the vertex-shader PDS data address changes.
- *
- * This is the shape nearly all of the remaining state emission uses - one flag packet, then
- * whichever data packets the flags called for - so getting the pattern right here is worth
- * more than the two packets themselves. Emitting a fixed sequence instead would write data
- * packets the hardware is not expecting, and omitting a flagged one writes state that never
- * arrives; both are silent.
+ * cut index is needed, VDM_STATE2 when the vertex-shader PDS data address changes, and
+ * VDM_STATE3..5 when the vertex program's code location/sizes are (re)supplied.
  *
- * STATE0's remaining fields (cam_size, flatshade_control, uvs_scratch_size_select) are not
- * set yet: they belong to draw-state handling that does not exist. They are zero, which is
- * wrong-but-visible in the stream, rather than guessed at. */
+ * `vs` may be NULL (no vertex state at all) or carry only pds_data_addr (data address without the
+ * code half). The lengths and the packets are derived from the same presence flags, so the stream
+ * cannot claim packets it does not carry. */
 bool pvr_csb_emit_vdm_state(struct pvr_csb *csb, bool cut_index_enable,
-                            uint32_t cut_index, bool have_vs_data_addr,
-                            uint64_t vs_pds_data_base_addr, uint32_t *words_out);
+                            uint32_t cut_index, const struct pvr_vdm_vs *vs,
+                            uint32_t *words_out);
+
+/* cam_size and max_instances from the vertex output size. A port of the reference's
+ * pvr_arch_calculate_vertex_cam_size(); see the definition for why it is copied instead of
+ * re-derived. */
+void pvr_vdm_cam_size(const struct pvr_device_info *dev_info, uint32_t vs_output_size,
+                      bool raster_enable, uint32_t *cam_size_out,
+                      uint32_t *max_instances_out);
 
