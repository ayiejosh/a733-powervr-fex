+/* Port of the reference's pvr_arch_calculate_vertex_cam_size(). COPIED, thresholds and all: the
+ * comparisons are against device feature values (vdm_cam_size, uvs_vtx_entries) and the branches
+ * chosen for this part are not derivable from the field names - the comments in the reference say
+ * "this is a proxy for 8XE". A re-derived rule would be a guess, and a wrong cam_size changes how
+ * much vertex data the hardware keeps, i.e. it fails silently. */
+void
+pvr_vdm_cam_size(const struct pvr_device_info *dev_info, uint32_t vs_output_size,
+                 bool raster_enable, uint32_t *cam_size_out,
+                 uint32_t *max_instances_out)
+{
+   const uint32_t uvs_vertex_vector_size_in_dwords =
+      (vs_output_size + 1U + raster_enable * 4U) * 4U;
+   const uint32_t vdm_cam_size = PVR_GET_FEATURE_VALUE(dev_info, vdm_cam_size, 32U);
+
+   /* This is a proxy for 8XE. */
+   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) && vdm_cam_size < 96U) {
+      if (uvs_vertex_vector_size_in_dwords < (14U * 4U)) {
+         *cam_size_out = MIN2(31U, vdm_cam_size - 1U);
+         *max_instances_out = 16U;
+      } else if (uvs_vertex_vector_size_in_dwords < (20U * 4U)) {
+         *cam_size_out = 15U;
+         *max_instances_out = 16U;
+      } else if (uvs_vertex_vector_size_in_dwords < (28U * 4U)) {
+         *cam_size_out = 11U;
+         *max_instances_out = 12U;
+      } else if (uvs_vertex_vector_size_in_dwords < (44U * 4U)) {
+         *cam_size_out = 7U;
+         *max_instances_out = 8U;
+      } else if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2) ||
+                 uvs_vertex_vector_size_in_dwords < (64U * 4U)) {
+         *cam_size_out = 7U;
+         *max_instances_out = 4U;
+      } else {
+         *cam_size_out = 3U;
+         *max_instances_out = 2U;
+      }
+   } else {
+      if (uvs_vertex_vector_size_in_dwords <= (32U * 4U)) {
+         *cam_size_out = MIN2(95U, vdm_cam_size - 1U);
+         *max_instances_out = 0U;
+      } else if (uvs_vertex_vector_size_in_dwords <= 48U * 4U) {
+         *cam_size_out = 63U;
+         *max_instances_out =
+            PVR_GET_FEATURE_VALUE(dev_info, uvs_vtx_entries, 144U) < 288U ? 16U : 0U;
+      } else if (uvs_vertex_vector_size_in_dwords <= 64U * 4U) {
+         *cam_size_out = 31U;
+         *max_instances_out =
+            PVR_GET_FEATURE_VALUE(dev_info, uvs_vtx_entries, 144U) < 288U ? 16U : 0U;
+      } else {
+         *cam_size_out = 15U;
+         *max_instances_out = 16U;
+      }
+   }
+}
+
+/* The VDM state update: a conditionally variable-length group. VDMCTRL_VDM_STATE0's presence flags
+ * say which of STATE1..5 follow, so the length and the packets must be computed from the same
+ * flags - a mismatch is state the hardware reads wrongly and nothing reports.
+ *
+ * The shape is taken from a capture of a working Vulkan draw (see
+ * open-driver-perf/captures/vkrender_draw_stream_decoded.txt): a draw whose vertex program is
+ * executed sets vs_data_addr_present and vs_other_present, and then carries STATE2 (PDS data
+ * address), STATE3 (PDS code address), STATE4 (output size) and STATE5 (allocation sizes). A
+ * stream with only STATE2 is a fetch program that never starts a vertex shader. */
 bool
 pvr_csb_emit_vdm_state(struct pvr_csb *csb, bool cut_index_enable,
-                       uint32_t cut_index, bool have_vs_data_addr,
-                       uint64_t vs_pds_data_base_addr, uint32_t *words_out)
+                       uint32_t cut_index, const struct pvr_vdm_vs *vs,
+                       uint32_t *words_out)
 {
+   const bool have_vs_data = vs != NULL && vs->pds_data_addr != 0;
+   const bool have_vs_other = vs != NULL && vs->pds_code_addr != 0;
    struct ROGUE_VDMCTRL_VDM_STATE0 state0 = {
       ROGUE_VDMCTRL_VDM_STATE0_header,
       .cut_index_enable = cut_index_enable,
       .cut_index_present = cut_index_enable,
-      .vs_data_addr_present = have_vs_data_addr,
-
-      /* Which vertex provides flat-shaded values. VERTEX_0 is the reference's fallback -
-       * its else branch, taken whenever the provoking vertex is not explicitly the last
-       * one and the topology is not a triangle fan. Setting it explicitly is better than
-       * leaving it zero: zero is a real value here rather than "unset", so a zero would
-       * mean something specific about flat shading rather than nothing at all. These are
-       * GL's defaults, so a driver that has not been told otherwise should say so.
-       *
-       * cam_size and uvs_scratch_size_select remain unset: both depend on vertex-buffer
-       * and draw state the driver does not have, and their zero values would be
-       * indistinguishable from a deliberate choice. */
+      .vs_data_addr_present = have_vs_data,
+      .vs_other_present = have_vs_other,
+      .cam_size = vs != NULL ? vs->cam_size : 0,
+      /* 0 means "5 extra dwords", which is what rasterisation needs (the enum's names are the
+       * inverse of their values; the capture carries 0 for a rasterising draw). */
+      .uvs_scratch_size_select = ROGUE_VDMCTRL_UVS_SCRATCH_SIZE_SELECT_FIVE,
       .flatshade_control = ROGUE_VDMCTRL_FLATSHADE_CONTROL_VERTEX_0,
    };
    struct ROGUE_VDMCTRL_VDM_STATE1 state1 = { .cut_index = cut_index };
    struct ROGUE_VDMCTRL_VDM_STATE2 state2 = {
-      .vs_pds_data_base_addr = vs_pds_data_base_addr,
+      .vs_pds_data_base_addr = vs != NULL ? vs->pds_data_addr : 0,
+   };
+   struct ROGUE_VDMCTRL_VDM_STATE3 state3 = {
+      .vs_pds_code_base_addr = vs != NULL ? vs->pds_code_addr : 0,
    };
+   struct ROGUE_VDMCTRL_VDM_STATE4 state4 = {
+      .vs_output_size = vs != NULL ? vs->output_size : 0,
+   };
+   struct ROGUE_VDMCTRL_VDM_STATE5 state5 = { 0 };
+
+   if (vs != NULL) {
+      state5.vs_max_instances = vs->max_instances;
+      state5.vs_usc_common_size = 0;
+      state5.vs_usc_unified_size =
+         DIV_ROUND_UP(vs->usc_unified_bytes,
+                      ROGUE_VDMCTRL_VDM_STATE5_VS_USC_UNIFIED_SIZE_UNIT_SIZE);
+      state5.vs_pds_temp_size =
+         DIV_ROUND_UP(vs->pds_temp_dwords * 4,
+                      ROGUE_VDMCTRL_VDM_STATE5_VS_PDS_TEMP_SIZE_UNIT_SIZE);
+      state5.vs_pds_data_size =
+         DIV_ROUND_UP(vs->pds_data_dwords * 4,
+                      ROGUE_VDMCTRL_VDM_STATE5_VS_PDS_DATA_SIZE_UNIT_SIZE);
+   }
+
    const uint32_t words = ROGUE_VDMCTRL_VDM_STATE0_length +
                           (cut_index_enable ? ROGUE_VDMCTRL_VDM_STATE1_length : 0) +
-                          (have_vs_data_addr ? ROGUE_VDMCTRL_VDM_STATE2_length : 0);
+                          (have_vs_data ? ROGUE_VDMCTRL_VDM_STATE2_length : 0) +
+                          (have_vs_other ? ROGUE_VDMCTRL_VDM_STATE3_length +
+                                              ROGUE_VDMCTRL_VDM_STATE4_length +
+                                              ROGUE_VDMCTRL_VDM_STATE5_length
+                                        : 0);
    uint32_t *dw = pvr_csb_emit(csb, words);
    uint32_t at = ROGUE_VDMCTRL_VDM_STATE0_length;
 
@@ -249,17 +336,23 @@ pvr_csb_emit_vdm_state(struct pvr_csb *csb, bool cut_index_enable,
 
    ROGUE_VDMCTRL_VDM_STATE0_pack(dw, &state0);
 
-   /* Only the flagged packets, and in the order the flags imply. The length was computed
-    * from the same flags, so the stream cannot be a different size than what was written -
-    * that pairing is the whole reason this is one function rather than three emissions at
-    * the call site. */
    if (cut_index_enable) {
       ROGUE_VDMCTRL_VDM_STATE1_pack(dw + at, &state1);
       at += ROGUE_VDMCTRL_VDM_STATE1_length;
    }
 
-   if (have_vs_data_addr)
+   if (have_vs_data) {
       ROGUE_VDMCTRL_VDM_STATE2_pack(dw + at, &state2);
+      at += ROGUE_VDMCTRL_VDM_STATE2_length;
+   }
+
+   if (have_vs_other) {
+      ROGUE_VDMCTRL_VDM_STATE3_pack(dw + at, &state3);
+      at += ROGUE_VDMCTRL_VDM_STATE3_length;
+      ROGUE_VDMCTRL_VDM_STATE4_pack(dw + at, &state4);
+      at += ROGUE_VDMCTRL_VDM_STATE4_length;
+      ROGUE_VDMCTRL_VDM_STATE5_pack(dw + at, &state5);
+   }
 
    if (words_out != NULL)
       *words_out = words;
