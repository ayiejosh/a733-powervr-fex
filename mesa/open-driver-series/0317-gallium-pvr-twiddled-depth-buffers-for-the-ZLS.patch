From 0a74e5fb29b4c3b4ee32803e6a815f03d08f5f9b Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Wed, 28 Oct 2026 12:08:51 +0800
Subject: [PATCH] gallium/pvr: twiddled depth buffers for the ZLS

Depth was still linear: the ZLS loaded/stored it row by row, and the earlier profile put that store at
~40% of the 3D pass. Depth/stencil buffers that are only used as attachments (not sampled as textures,
not stencil-only, no linear/scanout use) now get the same power-of-two twiddled layout as the colour
targets, and the fragment stream's ISP_ZLSCTL sets loadtwiddled/storetwiddled with the padded surface
extents and the layer size as zls_stride (the Vulkan driver's rule: twiddled uses physical_extent and
layer_size, linear uses stride/height and the buffer size).

Depth textures keep the linear layout for now - shadow samples its depth buffer, so it stays on the
linear descriptor until the twiddled depth texture path exists.

Wayland harness, same build: full glmark2 suite 471 linear colour -> 542/541 twiddled colour -> 641
with twiddled colour+depth (+36% over the linear baseline); shadow 160 -> 201 FPS, desktop 77 -> 80,
build 1121 -> 1138.
---
 src/gallium/drivers/pvr_native/pvr_csb.c      |  4 +++-
 src/gallium/drivers/pvr_native/pvr_csb.h      |  3 ++-
 src/gallium/drivers/pvr_native/pvr_draw.c     | 12 +++++++++---
 src/gallium/drivers/pvr_native/pvr_resource.c | 14 ++++++++++++++
 4 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_csb.c b/src/gallium/drivers/pvr_native/pvr_csb.c
index 4a5069fe..a4c5434e 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.c
+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -1600,7 +1600,7 @@ bool
 pvr_frag_static_stream_set_zls(void *stream, uint32_t stream_len,
                                const struct pvr_device_info *dev_info, uint32_t zls_format,
                                uint64_t zbase, uint32_t width, uint32_t height, bool load,
-                               bool store, uint32_t bgdepth, uint32_t zls_stride)
+                               bool store, uint32_t bgdepth, uint32_t zls_stride, bool twiddled)
 {
    const uint32_t pbe_dwords = PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
    const uint32_t ctrl_off = (PVR_FRAG_PRE_PBE_DWORDS + pbe_dwords +
@@ -1635,6 +1635,8 @@ pvr_frag_static_stream_set_zls(void *stream, uint32_t stream_len,
       .zstoreen = store,
       .forcezload = load,
       .forcezstore = store,
+      .loadtwiddled = twiddled,
+      .storetwiddled = twiddled,
    };
    const struct ROGUE_CR_ISP_ZLOAD_BASE base = { .addr = zbase };
    ROGUE_CR_ISP_ZLSCTL_pack(&dw[zlsctl_off / 4], &ctl);
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.h b/src/gallium/drivers/pvr_native/pvr_csb.h
index 32958462..22f38fcb 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.h
+++ b/src/gallium/drivers/pvr_native/pvr_csb.h
@@ -522,7 +522,8 @@ struct pvr_pds_sizes {
 bool pvr_frag_static_stream_set_zls(void *stream, uint32_t stream_len,
                                     const struct pvr_device_info *dev_info, uint32_t zls_format,
                                     uint64_t zbase, uint32_t width, uint32_t height, bool load,
-                                    bool store, uint32_t bgdepth, uint32_t zls_stride);
+                                    bool store, uint32_t bgdepth, uint32_t zls_stride,
+                                    bool twiddled);
 
 bool pvr_csb_emit_ta_pds_sizeinfo(struct pvr_csb *csb, const struct pvr_pds_sizes *sizes,
                                   bool tri_merge_disable, uint32_t batchnum);
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 71489cd8..74438bc4 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -1511,10 +1511,16 @@ pvr_draw_flush(struct pvr_context *ctx)
       const uint32_t bgdepth = zf == ROGUE_CR_ZLS_FORMAT_TYPE_16BITINT ? _mesa_float_to_unorm(zc, 16)
                              : zf == ROGUE_CR_ZLS_FORMAT_TYPE_24BITINT ? _mesa_float_to_unorm(zc, 24)
                                                                        : fui(zc);
-      /* Load unless cleared this render; always store, for later renders and readers. */
+      /* Load unless cleared this render; always store, for later renders and readers. For a
+       * twiddled depth buffer the ZLS stream carries the (power-of-two) surface extents and the
+       * layer size; the linear path keeps the buffer size it has always used. */
+      const uint32_t zwidth = zr->twiddled ? zr->phys_width : d->zs->width0;
+      const uint32_t zheight = zr->twiddled ? zr->phys_height : d->zs->height0;
+      const uint32_t zstride = zr->twiddled ? (uint32_t)((uint64_t)zr->stride * zr->phys_height)
+                                            : (uint32_t)zr->dev_size;
       if (!pvr_frag_static_stream_set_zls(fstream, flen, &scr->dev_info, zf, zr->dev_addr,
-                                          d->zs->width0, d->zs->height0, !d->zclear_valid, true,
-                                          bgdepth, (uint32_t)zr->dev_size))
+                                          zwidth, zheight, !d->zclear_valid, true,
+                                          bgdepth, zstride, zr->twiddled))
          goto done;
       frag_flags |= DRM_PVR_SUBMIT_JOB_FRAG_CMD_DEPTHBUFFER;
    }
diff --git a/src/gallium/drivers/pvr_native/pvr_resource.c b/src/gallium/drivers/pvr_native/pvr_resource.c
index 47c340e5..3cce9e50 100644
--- a/src/gallium/drivers/pvr_native/pvr_resource.c
+++ b/src/gallium/drivers/pvr_native/pvr_resource.c
@@ -110,6 +110,20 @@ pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *tem
          fbc_header_size = ALIGN_POT(size / 32, 4096);
          size += fbc_header_size;
       }
+   } else if ((templ->target == PIPE_TEXTURE_2D || templ->target == PIPE_TEXTURE_RECT) &&
+              util_format_is_depth_or_stencil(fmt) && (templ->bind & PIPE_BIND_DEPTH_STENCIL) &&
+              !(templ->bind & PIPE_BIND_SAMPLER_VIEW) && !(templ->bind & bind_linear) &&
+              fmt != PIPE_FORMAT_S8_UINT && templ->width0 >= 8 && templ->height0 >= 8 &&
+              getenv("PVR_NO_TWIDDLE") == NULL && !force_linear) {
+      /* The ZLS can load/store twiddled depth buffers too, with the same power-of-two layout as the
+       * colour targets. Skip depth textures (they are sampled through the linear descriptor) and
+       * stencil-only buffers. */
+      const unsigned cpp = util_format_get_blocksize(fmt);
+      twiddled = true;
+      phys_width = util_next_power_of_two(templ->width0);
+      phys_height = util_next_power_of_two(templ->height0);
+      stride = cpp * phys_width;
+      size = (uint64_t)stride * phys_height;
    } else if (!pvr_resource_layout(templ, &stride, &size)) {
       mesa_logd("pvr: no layout for target %u", templ->target);
       return NULL;
-- 
2.47.3

