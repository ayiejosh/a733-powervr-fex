 src/gallium/drivers/pvr/meson.build |   1 +
 src/gallium/drivers/pvr/pvr_bo.c    | 113 ++++++++++++++++++++++++++++
 src/gallium/drivers/pvr/pvr_bo.h    |  28 +++++++
 src/gallium/drivers/pvr/pvr_probe.c |  98 ++++++++++++++++++++++--
 4 files changed, 234 insertions(+), 6 deletions(-)
 create mode 100644 src/gallium/drivers/pvr/pvr_bo.c
 create mode 100644 src/gallium/drivers/pvr/pvr_bo.h

