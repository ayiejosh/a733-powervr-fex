+# F16SOP op selector (SOPEXPR form, instruction byte 4). Derived from the
+# vendor captures in /home/radxa/open-perf/vendor-usc/f16sop-layout.md:
+# 0x00 = add, 0x12 = min, 0x1b = max. Sub is add with the negate modifier set
+# (byte 8 bits 0 and 2), not a separate selector.
+F_SOP_SEL = field_enum_type(
+name='sop_sel', num_bits=8,
+elems=[
+   ('add', 0x00),
+   ('min', 0x12),
+   ('max', 0x1b),
+])
+
+# F16SOP power-of-two literal code (literal-operand form, instruction byte 15):
+# 0x40 + k = 2^k for k >= 0, 0x4a - k = 2^k for k < 0, 'other' means the
+# constant is not a power of two and is materialised by the constant pool.
+F_SOP_LIT = field_enum_type(
+name='sop_lit', num_bits=8,
+elems=[
+   ('pow2_0', 0x40),
+   ('pow2_1', 0x41),
+   ('pow2_2', 0x42),
+   ('pow2_3', 0x43),
+   ('pow2_4', 0x44),
