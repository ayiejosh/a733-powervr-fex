+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -446,6 +446,9 @@ pvr_format_layout_from_pipe(enum pipe_format format, struct pvr_format_layout *l
    case PIPE_FORMAT_B8G8R8A8_UNORM:
    case PIPE_FORMAT_R8G8B8X8_UNORM: /* the description's swizzle reads alpha as 1 */
    case PIPE_FORMAT_B8G8R8X8_UNORM:
+   case PIPE_FORMAT_R8G8B8A8_SRGB:
+   case PIPE_FORMAT_B8G8R8A8_SRGB:
+   case PIPE_FORMAT_A8B8G8R8_SRGB:
       layout_out->components = ROGUE_TEXSTATE_FORMAT_U8U8U8U8;
       break;
    case PIPE_FORMAT_R8_UNORM:
@@ -836,7 +839,7 @@ pvr_pbe_memlayout_linear(void)
 
 void
 pvr_csb_pbe_state_words(uint64_t addr, enum pipe_format format, uint32_t mrt_index,
-                        bool emptytile, uint32_t words[2])
+                        uint32_t source_pos_dword, bool emptytile, uint32_t words[2])
 {
    const struct util_format_description *desc = util_format_description(format);
    const int chan = util_format_get_first_non_void_channel(format);
@@ -854,10 +857,11 @@ pvr_csb_pbe_state_words(uint64_t addr, enum pipe_format format, uint32_t mrt_ind
       .address_high = addr,
       .source_format = pvr_pbe_source_format_from_pipe(format, true),
       .mrt_index = mrt_index,
-      /* Each attachment's pixel data sits at its own output register (the reference maps output
-       * position 0..3 to START_BIT0/32/64/96), so attachment i reads dword i of the fragment
-       * output, not dword 0. */
-      .source_pos = (enum ROGUE_PBESTATE_SOURCE_POS)(mrt_index <= 3 ? mrt_index : 0),
+      /* Where this attachment's pixel data starts in the fragment output, as a dword index: the
+       * reference maps output positions 0..3 to START_BIT0/32/64/96. One-dword formats keep
+       * start == attachment index; a 16F format occupies two dwords, so the next attachment's
+       * start moves by two. */
+      .source_pos = (enum ROGUE_PBESTATE_SOURCE_POS)MIN2(source_pos_dword, 3),
       .norm = chan >= 0 && desc->channel[chan].normalized,
    };
 
@@ -943,6 +947,11 @@ pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width
       }
    }
 
+   /* sRGB target: the PBE writes the linear source values encoded to sRGB, exactly like the
+    * reference's PBESTATE_REG_WORD0 gamma bit (its pbe_pack_state sets it from the format). */
+   if (util_format_is_srgb(format))
+      reg0.gamma = true;
+
    /* TFBC: the PBE compresses whole 8x8 blocks, direct addressing (see NATIVE-TFBC-PORT.md). */
    if (fbc) {
       reg0.compression = ROGUE_PBESTATE_COMPRESSION_ENABLED;
@@ -1366,13 +1375,16 @@ pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc)
       .minlod = 0,
       .texformat_compressed = 0,
       .twocomp_gamma = 0,
+      /* sRGB images are decoded to linear by the TPU; the reference sets the same bit for sRGB
+       * formats (pvr_arch_tex_state's "Gamma" block). */
+      .gamma = desc->gamma ? ROGUE_TEXSTATE_GAMMA_ON : ROGUE_TEXSTATE_GAMMA_OFF,
    };
    struct ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1 word1 = {
       .stride = desc->stride - 1,
       .texaddr = desc->addr,
       .num_mip_levels = 0,
       .mipmaps_present = false,
-      .alpha_msb = false,
+      .alpha_msb = desc->alpha_msb,
       .tile_size = false,
       .index_lookup = false,
       .frame_buffer_compression = false,
@@ -1387,7 +1399,7 @@ pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc)
       .mipmaps_present = desc->num_levels > 1,
       .baselevel = desc->base_level,
       .depth = 0,
-      .alpha_msb = false,
+      .alpha_msb = desc->alpha_msb,
       .border = false,
       .frame_buffer_compression = false,
       .frame_buffer_compression_addressing_mode = false,
@@ -1412,6 +1424,11 @@ pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc)
       }
    }
 
+   if (getenv("PVR_TEXDBG") != NULL)
+      fprintf(stderr, "TEXDBG comp=%u swiz=%u,%u,%u,%u gamma=%d tw=%d w=%u h=%u\n",
+              (unsigned)desc->components, desc->swizzle[0], desc->swizzle[1], desc->swizzle[2],
+              desc->swizzle[3], (int)desc->gamma, desc->twiddled, desc->width, desc->height);
+
    dw = pvr_csb_emit(csb, words);
    if (dw == NULL)
       return false;
