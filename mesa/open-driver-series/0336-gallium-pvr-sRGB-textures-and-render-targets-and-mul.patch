 }
 
@@ -896,32 +906,31 @@ draw_uniform_program(struct pvr_context *ctx, struct pvr_draw_state *d,
  * with one store per output dword. */
 static uint64_t
 draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d,
-                const uint32_t *colors, unsigned nr_outputs)
+                const uint32_t *words, unsigned nwords)
 {
    struct pvr_screen *scr = draw_screen(ctx);
    nir_builder b;
    struct pvr_shader *bg;
 
    for (unsigned i = 0; i < d->nr_bg; i++) {
-      if (d->bg[i].nr_outputs == nr_outputs &&
-          !memcmp(d->bg[i].colors, colors, nr_outputs * sizeof(colors[0])))
+      if (d->bg[i].nwords == nwords &&
+          !memcmp(d->bg[i].words, words, nwords * sizeof(words[0])))
          return d->bg[i].pds_offset;
    }
    b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(), "pvr_bg");
    b.shader->info.internal = false;
-   /* One packed colour into each colour attachment's pixel output dword: the EOT emit for
-    * attachment i reads dword i. */
-   for (unsigned i = 0; i < nr_outputs; i++)
-      nir_frag_store_pco(&b, nir_imm_int(&b, (int)colors[i]), .base = i);
+   /* One packed pixel-output dword per store: the EOT emit for attachment i reads the dwords that
+    * attachment's format occupies (one for an 8-bit format, two for 16F). */
+   for (unsigned i = 0; i < nwords; i++)
+      nir_frag_store_pco(&b, nir_imm_int(&b, (int)words[i]), .base = i);
    nir_jump(&b, nir_jump_return);
    bg = pvr_shader_create(b.shader, scr->pco_ctx);
    if (bg == NULL || !draw_upload_fs(scr, bg))
       return 0;
    /* shortcut: four cached colours, round robin; the evicted programs stay allocated. */
-   const unsigned slot = d->nr_bg < ARRAY_SIZE(d->bg) ? d->nr_bg++ : (colors[0] & 3);
-   d->bg[slot] = (struct pvr_draw_bg){ .nr_outputs = nr_outputs,
-                                       .pds_offset = bg->pds_offset };
-   memcpy(d->bg[slot].colors, colors, nr_outputs * sizeof(colors[0]));
+   const unsigned slot = d->nr_bg < ARRAY_SIZE(d->bg) ? d->nr_bg++ : (words[0] & 3);
+   d->bg[slot] = (struct pvr_draw_bg){ .nwords = nwords, .pds_offset = bg->pds_offset };
+   memcpy(d->bg[slot].words, words, nwords * sizeof(words[0]));
    return bg->pds_offset;
 }
 
