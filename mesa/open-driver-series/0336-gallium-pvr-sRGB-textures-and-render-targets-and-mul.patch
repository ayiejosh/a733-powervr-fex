    *tex = (struct pvr_tex_desc){
       .components = components,
       .width = level0 ? res->base.width0 : pvr_resource_level_phys_w(res, level),
@@ -733,6 +735,14 @@ draw_level_desc(const struct pvr_resource *res, unsigned level,
       .addr = pvr_resource_level_addr(res, level),
       .twiddled = res->twiddled,
       .fbc = res->fbc,
+      .gamma = util_format_is_srgb(res->base.format),
+      /* The reference's vk_format_is_alpha_on_msb: an RGBA-order colour format has alpha in the
+       * most significant byte (the 4th channel maps to W); the TPU needs this to place the sRGB
+       * decode correctly (without it the first memory channel is treated as alpha and left
+       * un-decoded). */
+      .alpha_msb = (desc->colorspace == UTIL_FORMAT_COLORSPACE_RGB ||
+                    desc->colorspace == UTIL_FORMAT_COLORSPACE_SRGB) &&
+                   desc->swizzle[3] == PIPE_SWIZZLE_W,
