 src/gallium/drivers/zink/zink_kopper.c       | 4 ++++
 src/gallium/drivers/zink/zink_resource.c     | 5 +++++
 src/imagination/vulkan/pvr_physical_device.c | 8 ++++----
 4 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/src/gallium/drivers/zink/zink_batch.c b/src/gallium/drivers/zink/zink_batch.c
index c615d47..974e7c7 100644
--- a/src/gallium/drivers/zink/zink_batch.c
+++ b/src/gallium/drivers/zink/zink_batch.c
@@ -1,4 +1,5 @@
 #include "zink_batch.h"
+#include <time.h>
 #include "zink_context.h"
 #include "zink_descriptors.h"
 #include "zink_kopper.h"
@@ -815,7 +816,12 @@ submit_queue(void *data, void *gdata, int thread_index)
 
    simple_mtx_lock(screen->queue_lock);
    VRAM_ALLOC_LOOP(result,
-      VKSCR(QueueSubmit)(screen->queue, num_si, submit, VK_NULL_HANDLE),
+      ({ struct timespec _q0,_q1; clock_gettime(CLOCK_MONOTONIC,&_q0);
+         VkResult _r = VKSCR(QueueSubmit)(screen->queue, num_si, submit, VK_NULL_HANDLE);
+         clock_gettime(CLOCK_MONOTONIC,&_q1);
+         if (getenv("ZINK_TIMING")) { double _ms=(_q1.tv_sec-_q0.tv_sec)*1000.0+(_q1.tv_nsec-_q0.tv_nsec)/1e6;
+            if (_ms>1.0) fprintf(stderr,"[zt] queuesubmit %.2f ms\n",_ms); }
+         _r; }),
       if (result != VK_SUCCESS) {
          mesa_loge("ZINK: vkQueueSubmit failed (%s)", vk_Result_to_str(result));
          bs->is_device_lost = true;
@@ -864,6 +870,7 @@ end:
 void
 zink_end_batch(struct zink_context *ctx)
 {
+   struct timespec _e0,_e1; clock_gettime(CLOCK_MONOTONIC,&_e0);
    MESA_TRACE_FUNC();
    if (!ctx->queries_disabled)
       zink_suspend_queries(ctx);
