+      pvr_drm_sync_op_init(&geom_sync_ops[num_geom_syncs++], sync,
+                           DRM_PVR_SYNC_OP_FLAG_WAIT,
+                           submit_info->geometry.wait.wait_value);
    }
 
    if (signal_sync_geom) {
-      assert(!(signal_sync_geom->sync->flags & VK_SYNC_IS_TIMELINE));
-      geom_sync_ops[num_geom_syncs++] = (struct drm_pvr_sync_op){
-         .handle = vk_sync_as_drm_syncobj(signal_sync_geom->sync)->syncobj,
-         .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL |
-                  DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
-         .value = 0,
-      };
