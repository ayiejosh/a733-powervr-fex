+                           DRM_PVR_SYNC_OP_FLAG_SIGNAL,
+                           signal_sync_geom->signal_value);
    }
 
    /* PR syncs */
 
    if (signal_sync_geom) {
-      assert(!(signal_sync_geom->sync->flags & VK_SYNC_IS_TIMELINE));
       geom_to_pr_syncobj = vk_sync_as_drm_syncobj(signal_sync_geom->sync)->syncobj;
    } else {
       geom_to_pr_syncobj = drm_ctx->geom_to_pr_syncobj;
@@ -600,23 +591,15 @@ VkResult pvr_drm_winsys_render_submit(
       if (submit_info->fragment.wait.sync) {
          struct vk_sync *sync = submit_info->fragment.wait.sync;
 
-         assert(!(sync->flags & VK_SYNC_IS_TIMELINE));
-         frag_sync_ops[num_frag_syncs++] = (struct drm_pvr_sync_op){
-            .handle = vk_sync_as_drm_syncobj(sync)->syncobj,
-            .flags = DRM_PVR_SYNC_OP_FLAG_WAIT |
-                     DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
-            .value = 0,
-         };
+         pvr_drm_sync_op_init(&frag_sync_ops[num_frag_syncs++], sync,
+                              DRM_PVR_SYNC_OP_FLAG_WAIT,
+                              submit_info->fragment.wait.wait_value);
       }
 
       if (signal_sync_frag) {
-         assert(!(signal_sync_frag->sync->flags & VK_SYNC_IS_TIMELINE));
-         frag_sync_ops[num_frag_syncs++] = (struct drm_pvr_sync_op){
-            .handle = vk_sync_as_drm_syncobj(signal_sync_frag->sync)->syncobj,
-            .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL |
-                     DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
-            .value = 0,
-         };
+         pvr_drm_sync_op_init(&frag_sync_ops[num_frag_syncs++], signal_sync_frag->sync,
+                              DRM_PVR_SYNC_OP_FLAG_SIGNAL,
+                              signal_sync_frag->signal_value);
       }
    }
 
