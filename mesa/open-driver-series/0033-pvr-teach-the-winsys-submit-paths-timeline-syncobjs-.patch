 .../winsys/powervr/pvr_drm_job_common.h       | 27 ++++++++++++
 .../winsys/powervr/pvr_drm_job_compute.c      | 20 +++------
 .../winsys/powervr/pvr_drm_job_render.c       | 41 ++++++-------------
 .../winsys/powervr/pvr_drm_job_transfer.c     | 20 +++------
 4 files changed, 51 insertions(+), 57 deletions(-)

diff --git a/src/imagination/vulkan/winsys/powervr/pvr_drm_job_common.h b/src/imagination/vulkan/winsys/powervr/pvr_drm_job_common.h
index 932ef48..30a257c 100644
--- a/src/imagination/vulkan/winsys/powervr/pvr_drm_job_common.h
+++ b/src/imagination/vulkan/winsys/powervr/pvr_drm_job_common.h
@@ -26,6 +26,7 @@
 
 #include "drm-uapi/pvr_drm.h"
 #include "pvr_winsys.h"
+#include "vk_drm_syncobj.h"
 #include "util/macros.h"
 
 static enum drm_pvr_ctx_priority
@@ -43,4 +44,30 @@ pvr_drm_from_winsys_priority(enum pvr_winsys_ctx_priority priority)
    }
 }
 
+/**
+ * \brief Fill a DRM sync op, selecting the handle type from the sync itself.
+ *
+ * A binary syncobj is operated at value 0; a timeline syncobj at \p value. The three submit
+ * paths used to hardcode DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ and .value = 0 and assert
+ * against VK_SYNC_IS_TIMELINE, which meant a timeline syncobj was silently submitted as a binary
+ * one at point 0 and the ordering was lost.
+ */
+static void
+pvr_drm_sync_op_init(struct drm_pvr_sync_op *op,
+                     struct vk_sync *sync,
+                     uint32_t flags,
+                     uint64_t value)
+{
+   const bool is_timeline = sync->flags & VK_SYNC_IS_TIMELINE;
+
+   *op = (struct drm_pvr_sync_op){
+      .handle = vk_sync_as_drm_syncobj(sync)->syncobj,
+      .flags = flags |
+               (is_timeline
+                   ? DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_TIMELINE_SYNCOBJ
+                   : DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ),
+      .value = is_timeline ? value : 0,
+   };
+}
+
 #endif /* PVR_DRM_JOB_COMMON_H */
diff --git a/src/imagination/vulkan/winsys/powervr/pvr_drm_job_compute.c b/src/imagination/vulkan/winsys/powervr/pvr_drm_job_compute.c
index 381cc49..8970219 100644
--- a/src/imagination/vulkan/winsys/powervr/pvr_drm_job_compute.c
+++ b/src/imagination/vulkan/winsys/powervr/pvr_drm_job_compute.c
@@ -195,23 +195,15 @@ VkResult pvr_drm_winsys_compute_submit(
    if (submit_info->wait.sync) {
       struct vk_sync *sync = submit_info->wait.sync;
 
-      assert(!(sync->flags & VK_SYNC_IS_TIMELINE));
-      sync_ops[job_args.sync_ops.count++] = (struct drm_pvr_sync_op){
-         .handle = vk_sync_as_drm_syncobj(sync)->syncobj,
-         .flags = DRM_PVR_SYNC_OP_FLAG_WAIT |
-                  DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
-         .value = 0,
-      };
+      pvr_drm_sync_op_init(&sync_ops[job_args.sync_ops.count++], sync,
+                           DRM_PVR_SYNC_OP_FLAG_WAIT,
+                           submit_info->wait.wait_value);
    }
 
    if (signal_sync) {
-      assert(!(signal_sync->sync->flags & VK_SYNC_IS_TIMELINE));
-      sync_ops[job_args.sync_ops.count++] = (struct drm_pvr_sync_op){
-         .handle = vk_sync_as_drm_syncobj(signal_sync->sync)->syncobj,
-         .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL |
-                  DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
-         .value = 0,
-      };
+      pvr_drm_sync_op_init(&sync_ops[job_args.sync_ops.count++], signal_sync->sync,
+                           DRM_PVR_SYNC_OP_FLAG_SIGNAL,
+                           signal_sync->signal_value);
    }
 
    /* Returns VK_ERROR_OUT_OF_DEVICE_MEMORY to match pvrsrv. */
