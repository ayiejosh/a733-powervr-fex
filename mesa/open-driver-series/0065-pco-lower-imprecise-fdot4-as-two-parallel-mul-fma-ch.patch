From 556c634b3900e25520f67b4e3e44b5ec8a5b4b96 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 14:28:00 +0800
Subject: [PATCH 065/294] pco: lower imprecise fdot4 as two parallel mul + fma
 chains

lower_alu_width() turns fdot4 into a serial fmul + 3 ffma chain (4
instruction groups). Split it into (x*x' + y*y') + (z*z' + w*w'): the two
halves are independent and dual-issue on p0 + p1, so the dot product
takes 3 groups. The joining fadd is exact so nir_opt_algebraic does not
reassociate it back into the chain. Only applies to inexact fdot4, whose
summation order is unspecified anyway.

vkheavy (normalize() in a 32-iteration loop): FS 722 -> 691 groups,
2048x2048 189.2 -> 180.4 ms/frame. CTS glsl dot/normalize/length/
distance/reflect/refract/faceforward precision + matrix mul (838 cases):
identical to before.
---
 src/imagination/pco/pco_nir_algebraic.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/imagination/pco/pco_nir_algebraic.py b/src/imagination/pco/pco_nir_algebraic.py
index 60e0694d..8fef5b3c 100644
--- a/src/imagination/pco/pco_nir_algebraic.py
+++ b/src/imagination/pco/pco_nir_algebraic.py
@@ -59,6 +59,14 @@ lower_b2b = [
 
 lower_algebraic.extend(lower_b2b)
 
+# An imprecise vec4 dot product as two independent mul + fma chains joined by
+# an add (exact, so nir_opt_algebraic does not fold it back into the chain),
+# instead of the serial mul + 3 fma chain lower_alu_width() builds:
+# the halves dual-issue (p0 + p1), 3 instruction groups instead of 4.
+lower_algebraic.append((('~fdot4', a, b),
+                        ('!fadd', ('ffma', 'a.y', 'b.y', ('fmul', 'a.x', 'b.x')),
+                                 ('ffma', 'a.w', 'b.w', ('fmul', 'a.z', 'b.z')))))
+
 lower_scmp = [
    # Float comparisons + bool conversions.
    (('b2f32', ('flt', a, b)), ('slt', a, 'b@32'), '!options->lower_scmp'),
-- 
