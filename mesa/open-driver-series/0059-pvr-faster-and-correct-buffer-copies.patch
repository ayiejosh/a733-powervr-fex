From 28deb4c42be8f0b28629494bdf8d463ab4495d12 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 08:10:22 +0800
Subject: [PATCH 59/98] pvr: faster and correct buffer copies

pvr_cmd_copy_buffer_region() had three problems:

- The destination alignment was computed from src_offset, so a copy
  from an aligned source to a misaligned destination took the 16-byte
  texel path and failed with "ISP vertex xy value out of range"
  (VK_ERROR_DEVICE_LOST), e.g. vkCmdCopyBuffer 1 MiB, srcOffset 0,
  dstOffset 4. Use dst_offset.
- Copies used max-width (2048 texel) rows, so every tile of the
  transfer touched 32 rows spread over up to 1 MiB. Rows of one 4 KiB
  page keep each row of tiles on one contiguous block. Fills stay at
  max width (narrow rows made them slower).
- With the same misalignment on both sides the whole copy used 4- or
  1-byte texels. Copy up to the next 16-byte boundary first, then the
  rest with 16-byte texels.

BXM-4-64, 16 MiB vkCmdCopyBuffer (vendor driver: 4.49 ms):
  aligned            4.81 -> 3.56 ms
  both offsets 4/8   6.6  -> 4.4-4.6 ms
  vkCmdFillBuffer    unchanged
Byte-exact check over 14 src/dst offset combinations passes (3 failed
before); CTS buffer_to_buffer/fill_and_update_buffer/buffer_marker and
the 5062-case selection are unchanged vs d253e35.
---
 src/imagination/vulkan/rogue/pvr_blit.c | 33 +++++++++++++++++++------
 1 file changed, 26 insertions(+), 7 deletions(-)

diff --git a/src/imagination/vulkan/rogue/pvr_blit.c b/src/imagination/vulkan/rogue/pvr_blit.c
index b492972..2f465e0 100644
--- a/src/imagination/vulkan/rogue/pvr_blit.c
+++ b/src/imagination/vulkan/rogue/pvr_blit.c
@@ -1422,7 +1422,7 @@ static VkResult pvr_cmd_copy_buffer_region(struct pvr_cmd_buffer *cmd_buffer,
       const VkDeviceSize remaining_size = size - offset;
       struct pvr_transfer_cmd *transfer_cmd;
       uint32_t src_align = (src_addr.addr + offset + src_offset) & 0xF;
-      uint32_t dst_align = (dst_addr.addr + offset + src_offset) & 0xF;
+      uint32_t dst_align = (dst_addr.addr + offset + dst_offset) & 0xF;
       uint32_t texel_width;
       VkDeviceSize texels;
       VkFormat vk_format;
@@ -1446,14 +1446,33 @@ static VkResult pvr_cmd_copy_buffer_region(struct pvr_cmd_buffer *cmd_buffer,
          texel_width = 1U;
       }
 
-      texels = remaining_size / texel_width;
+      VkDeviceSize chunk = remaining_size;
 
-      /* Try to do max-width rects, fall back to a 1-height rect for the
-       * remainder.
+      /* When both sides share the same misalignment, copy up to the next
+       * 16-byte boundary first so the rest can use 16-byte texels.
        */
-      if (texels > PVR_MAX_TRANSFER_SIZE_IN_TEXELS) {
-         width = PVR_MAX_TRANSFER_SIZE_IN_TEXELS;
-         height = texels / PVR_MAX_TRANSFER_SIZE_IN_TEXELS;
+      if (!is_fill && src_align == dst_align && src_align != 0 &&
+          remaining_size > 16U) {
+         chunk = 16U - src_align;
+         if (chunk % texel_width) {
+            vk_format = VK_FORMAT_R8_UINT;
+            texel_width = 1U;
+         }
+      }
+
+      texels = chunk / texel_width;
+
+      /* Do full-width rects, falling back to a 1-height rect for the
+       * remainder. Copies use rows of one 4 KiB page: each row of tiles then
+       * covers one contiguous block, ~1.4x faster than max-width rows on
+       * BXM-4-64. Fills are faster with max-width rows.
+       */
+      const uint32_t max_width =
+         is_fill ? PVR_MAX_TRANSFER_SIZE_IN_TEXELS
+                 : MIN2(PVR_MAX_TRANSFER_SIZE_IN_TEXELS, 4096U / texel_width);
+      if (texels > max_width) {
+         width = max_width;
+         height = texels / max_width;
          height = MIN2(height, PVR_MAX_TRANSFER_SIZE_IN_TEXELS);
       } else {
          width = texels;
-- 
