    struct pvr_device *device,
    const VkAllocationCallbacks *allocator,
@@ -370,6 +394,7 @@ static VkResult pvr_render_load_op_state_create(
    const struct pvr_renderpass_hwsetup_render *hw_render,
    uint32_t hw_render_index,
    const struct pvr_per_view_attachment_first_use_info *first_use_info,
+   bool force_load,
    struct pvr_load_op_state **const load_op_state_out)
 {
    const uint32_t view_count = util_bitcount(hw_render->view_mask);
@@ -397,7 +422,8 @@ static VkResult pvr_render_load_op_state_create(
                                        hw_render,
                                        hw_render_index,
                                        view_idx,
-                                       first_use_info);
+                                       first_use_info,
+                                       force_load);
       if (result != VK_SUCCESS)
          goto err_load_op_state_destroy;
 
@@ -656,11 +682,29 @@ static inline VkResult pvr_hw_render_load_ops_setup(
                                                hw_render,
                                                hw_render_idx,
                                                first_use_info,
+                                               false,
                                                &load_op_state);
       if (result != VK_SUCCESS)
          return result;
 
       hw_render->load_op_state = load_op_state;
+
+      if (pvr_render_may_need_fbc_load(pass, hw_render)) {
+         result = pvr_render_load_op_state_create(device,
+                                                  allocator,
