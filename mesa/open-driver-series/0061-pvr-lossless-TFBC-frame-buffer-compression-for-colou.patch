+/* A TFBC attachment's PBE store writes whole compressed blocks, so with a
+ * partial render area the pixels around it must be loaded into the tile
+ * buffer whatever the attachment's loadOp (the in-area clear is then a draw,
+ * see pvr_perform_start_of_render_attachment_clear()).
+ */
+static bool
+pvr_render_needs_fbc_load(const struct pvr_cmd_buffer *cmd_buffer,
+                          const struct pvr_renderpass_hwsetup_render *hw_render)
+{
+   const struct pvr_render_pass_info *info =
+      &cmd_buffer->state.render_pass_info;
+
+   if (!hw_render->load_op_state_fbc)
+      return false;
+
+   for (uint32_t i = 0; i < hw_render->color_init_count; i++) {
+      const struct pvr_image_view *iview =
+         info->attachments[hw_render->color_init[i].index];
+
+      if (hw_render->color_init[i].op != VK_ATTACHMENT_LOAD_OP_LOAD &&
+          pvr_image_view_get_image(iview)->fbc &&
+          !pvr_is_render_area_tile_aligned(cmd_buffer, iview))
+         return true;
+   }
+
+   return false;
+}
