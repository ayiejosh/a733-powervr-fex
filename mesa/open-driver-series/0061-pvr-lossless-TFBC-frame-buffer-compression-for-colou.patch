+      pvr_render_load_op_state_destroy(device,
+                                       allocator,
+                                       hw_render->load_op_state_fbc);
       return result;
    }
 
@@ -695,6 +742,9 @@ pvr_render_pass_load_ops_cleanup(struct pvr_device *device,
       pvr_render_load_op_state_destroy(device,
                                        allocator,
                                        hw_render->load_op_state);
+      pvr_render_load_op_state_destroy(device,
