    }
 
    result = pvr_subpass_load_op_setup(device, allocator, pass, hw_render);
@@ -671,6 +715,9 @@ static inline VkResult pvr_hw_render_load_ops_setup(
       pvr_render_load_op_state_destroy(device,
                                        allocator,
