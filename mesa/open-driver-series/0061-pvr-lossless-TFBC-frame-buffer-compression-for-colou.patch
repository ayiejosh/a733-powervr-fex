+/* A TFBC destination is stored in whole 8x8 blocks and the PBE zeroes the
+ * pixels outside its clip. For a rect that doesn't cover whole blocks, widen
+ * the clip to blocks and use the clip blit, whose background loads the
+ * destination.
+ */
+static bool pvr_fbc_dst_needs_load(struct pvr_transfer_cmd *transfer_cmd)
+{
+   VkRect2D *rect = &transfer_cmd->scissor;
+   const uint32_t x0 = rect->offset.x & ~7;
+   const uint32_t y0 = rect->offset.y & ~7;
+   const uint32_t x1 = MIN2(ALIGN_POT(rect->offset.x + rect->extent.width, 8),
+                            transfer_cmd->dst.width);
+   const uint32_t y1 = MIN2(ALIGN_POT(rect->offset.y + rect->extent.height, 8),
+                            transfer_cmd->dst.height);
+
+   if (!transfer_cmd->dst.fbc || transfer_cmd->source_count != 1 ||
+       (x0 == rect->offset.x && y0 == rect->offset.y &&
+        x1 == rect->offset.x + rect->extent.width &&
+        y1 == rect->offset.y + rect->extent.height))
+      return false;
+
+   *rect = (VkRect2D){ { x0, y0 }, { x1 - x0, y1 - y0 } };
+   return true;
+}
+
 static VkResult pvr_queue_transfer(struct pvr_transfer_ctx *ctx,
                                    struct pvr_transfer_cmd *transfer_cmd,
                                    struct vk_sync_wait wait,
@@ -5977,6 +6005,7 @@ static VkResult pvr_queue_transfer(struct pvr_transfer_ctx *ctx,
     * S/U   : update / server sync update point
     */
 
+   const bool fbc_clip = pvr_fbc_dst_needs_load(transfer_cmd);
    while (!finished) {
       prev_prep_data = prep_data;
       prep_data = &submit.prep_array[submit.prep_count++];
@@ -5994,7 +6023,7 @@ static VkResult pvr_queue_transfer(struct pvr_transfer_ctx *ctx,
          prep_data->state = prev_prep_data->state;
       }
 
-      if (transfer_cmd->flags & PVR_TRANSFER_CMD_FLAGS_FAST2D) {
+      if ((transfer_cmd->flags & PVR_TRANSFER_CMD_FLAGS_FAST2D) || fbc_clip) {
          result =
             pvr_3d_clip_blit(ctx, transfer_cmd, prep_data, pass, &finished);
       } else {
