+/* Submits a deferred clear of a resource that is about to be read other than as a render's
+ * target: a colour clear as a clear-only render into it, a depth clear as one into a scratch
+ * colour target of its size with it as the depth buffer. */
+static void
+draw_materialize(struct pvr_context *ctx, struct pipe_resource *pres)
+{
+   struct pvr_resource *res = pvr_resource(pres);
+   struct pvr_draw_state *d = ctx->draw;
+   if (d == NULL || pres == NULL || (!res->clear_pending && !res->zclear_pending))
+      return;
+   pvr_draw_flush(ctx);
+   struct pipe_resource *rt = pres, *zs = NULL;
+   if (res->zclear_pending) {
+      const struct pipe_resource templ = {
+         .target = PIPE_TEXTURE_2D, .format = PIPE_FORMAT_R8G8B8A8_UNORM,
+         .width0 = pres->width0, .height0 = pres->height0, .depth0 = 1, .array_size = 1,
+         .bind = PIPE_BIND_RENDER_TARGET,
+      };
+      rt = ctx->base.screen->resource_create(ctx->base.screen, &templ);
+      zs = pres;
+   }
+   if (rt != NULL && draw_init(ctx, d) &&
+       draw_open(ctx, d, rt, 0, pres->width0, pres->height0, zs)) {
+      d->no_defer = true;
+      pvr_draw_flush(ctx);
+      d->no_defer = false;
+   }
+   res->clear_pending = res->zclear_pending = false;
+   if (rt != pres)
+      pipe_resource_reference(&rt, NULL);
+}
