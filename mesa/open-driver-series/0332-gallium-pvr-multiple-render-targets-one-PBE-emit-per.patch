+   unsigned nr_outputs;
    uint64_t pds_offset;
 };
 
@@ -71,10 +72,11 @@ struct pvr_draw_load {
    struct pvr_shader *fs;
 };
 
-/* An end-of-tile program, per target address and format. */
+/* An end-of-tile program, per set of colour targets (one entry per attachment). */
 struct pvr_draw_eot {
-   uint64_t addr;
-   enum pipe_format format;
+   uint64_t addr[PVR_MAX_COLOR_ATTACHMENTS];
+   enum pipe_format format[PVR_MAX_COLOR_ATTACHMENTS];
+   unsigned nr;
    uint64_t pds_offset;
    bool zonly;
 };
@@ -890,26 +892,31 @@ draw_uniform_program(struct pvr_context *ctx, struct pvr_draw_state *d,
 
 /* The background object for a clear colour: a constant-colour fragment program. */
 static uint64_t
-draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint32_t color)
+draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint32_t color,
+                unsigned nr_outputs)
 {
    struct pvr_screen *scr = draw_screen(ctx);
    nir_builder b;
    struct pvr_shader *bg;
 
    for (unsigned i = 0; i < d->nr_bg; i++) {
-      if (d->bg[i].color == color)
+      if (d->bg[i].color == color && d->bg[i].nr_outputs == nr_outputs)
          return d->bg[i].pds_offset;
    }
    b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(), "pvr_bg");
    b.shader->info.internal = false;
-   nir_frag_store_pco(&b, nir_imm_int(&b, (int)color), .base = 0);
+   /* One packed colour into each colour attachment's pixel output dword: the EOT emit for
+    * attachment i reads dword i. */
+   for (unsigned i = 0; i < nr_outputs; i++)
+      nir_frag_store_pco(&b, nir_imm_int(&b, (int)color), .base = i);
    nir_jump(&b, nir_jump_return);
    bg = pvr_shader_create(b.shader, scr->pco_ctx);
    if (bg == NULL || !draw_upload_fs(scr, bg))
       return 0;
    /* shortcut: four cached colours, round robin; the evicted programs stay allocated. */
    const unsigned slot = d->nr_bg < ARRAY_SIZE(d->bg) ? d->nr_bg++ : (color & 3);
-   d->bg[slot] = (struct pvr_draw_bg){ .color = color, .pds_offset = bg->pds_offset };
+   d->bg[slot] = (struct pvr_draw_bg){ .color = color, .nr_outputs = nr_outputs,
+                                       .pds_offset = bg->pds_offset };
    return bg->pds_offset;
 }
 
@@ -973,7 +980,7 @@ draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bg
       nir_store_var(&b, out, color, 0xf);
       BITSET_SET(b.shader->info.textures_used, 0);
       BITSET_SET(b.shader->info.textures_used_by_txf, 0);
-      fs = pvr_shader_create_fs(b.shader, scr->pco_ctx, format, NULL);
+      fs = pvr_shader_create_fs(b.shader, scr->pco_ctx, &format, 1, NULL);
       if (fs == NULL || !draw_upload_fs(scr, fs) || fs->tex_mask != 1 ||
           (gen && fs->uniform_dwords < 2)) {
          mesa_loge("pvr: draw: no load program (%s, gen %d)", util_format_short_name(format), gen);
@@ -1036,23 +1043,25 @@ draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bg
 /* The end-of-tile program for a target address: PBE state words baked into a USC program, kicked by
  * a PDS pixel-event data segment. */
 static uint64_t
-draw_eot_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t rt_addr,
-                 enum pipe_format format, bool zonlyrender)
+draw_eot_program(struct pvr_context *ctx, struct pvr_draw_state *d, unsigned nr_attachments,
+                 const uint64_t *rt_addrs, const enum pipe_format *formats, bool zonlyrender)
 {
    struct pvr_screen *scr = draw_screen(ctx);
    struct pvr_shader_eot eot = { 0 };
    struct pvr_pds_event_program program = { 0 };
-   uint32_t state_words[2];
+   uint32_t state_words[PVR_MAX_COLOR_ATTACHMENTS * 2];
    uint32_t staging[64] = { 0 };
    uint32_t usc_offset;
 
    for (unsigned i = 0; i < d->nr_eot; i++) {
-      if (d->eot[i].addr == rt_addr && d->eot[i].format == format &&
-          d->eot[i].zonly == zonlyrender)
+      if (d->eot[i].nr == nr_attachments && d->eot[i].zonly == zonlyrender &&
+          !memcmp(d->eot[i].addr, rt_addrs, nr_attachments * sizeof(rt_addrs[0])) &&
+          !memcmp(d->eot[i].format, formats, nr_attachments * sizeof(formats[0])))
          return d->eot[i].pds_offset;
    }
-   pvr_csb_pbe_state_words(rt_addr, format, 0, zonlyrender, state_words);
-   if (!pvr_shader_eot_create(scr->pco_ctx, &eot, state_words))
+   for (unsigned i = 0; i < nr_attachments; i++)
+      pvr_csb_pbe_state_words(rt_addrs[i], formats[i], i, zonlyrender, &state_words[2 * i]);
+   if (!pvr_shader_eot_create(scr->pco_ctx, &eot, nr_attachments, state_words))
       return 0;
    usc_offset = draw_upload_usc(scr, eot.binary, eot.binary_size);
    if (usc_offset == 0)
@@ -1066,11 +1075,14 @@ draw_eot_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t rt_
    const uint64_t pds_offset = draw_upload_pds(scr, staging, program.data_size * 4);
    if (pds_offset == 0)
       return 0;
-   /* shortcut: 32 cached targets, round robin; the evicted programs stay allocated. */
+   /* shortcut: 32 cached target sets, round robin; the evicted programs stay allocated. */
    const unsigned slot = d->nr_eot < ARRAY_SIZE(d->eot) ? d->nr_eot++
-                                                        : (unsigned)(rt_addr >> 12) % ARRAY_SIZE(d->eot);
-   d->eot[slot] = (struct pvr_draw_eot){ .addr = rt_addr, .format = format,
-                                         .pds_offset = pds_offset, .zonly = zonlyrender };
+                                                        : (unsigned)(rt_addrs[0] >> 12) % ARRAY_SIZE(d->eot);
+   struct pvr_draw_eot *e = &d->eot[slot];
+   *e = (struct pvr_draw_eot){ .nr = nr_attachments, .pds_offset = pds_offset,
+                               .zonly = zonlyrender };
+   memcpy(e->addr, rt_addrs, nr_attachments * sizeof(e->addr[0]));
+   memcpy(e->format, formats, nr_attachments * sizeof(e->format[0]));
    return pds_offset;
 }
 
@@ -1365,7 +1377,18 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
    if (d == NULL || !draw_init(ctx, d))
       return false;
 
-   /* The fragment shader variant for this target format and blend state. */
+   /* The fragment shader variant for this framebuffer's colour format(s) and blend state. MRT v1:
+    * every attachment shares the first one's format (the background program emits one value). */
+   enum pipe_format rt_formats[PVR_MAX_COLOR_ATTACHMENTS] = { rt_format };
+   unsigned nr_formats = MIN2(ctx->fb.nr_cbufs, PVR_MAX_COLOR_ATTACHMENTS);
+   for (unsigned i = 0; i < nr_formats; i++)
+      rt_formats[i] = ctx->fb.cbufs[i].format;
+   for (unsigned i = 1; i < nr_formats; i++) {
+      if (rt_formats[i] != rt_formats[0]) {
+         nr_formats = 1;
+         break;
+      }
+   }
    nir_lower_blend_options blend;
    memset(&blend, 0, sizeof(blend));
    {
@@ -1375,45 +1398,55 @@ pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
          .src_factor = PIPE_BLENDFACTOR_ONE,
          .dst_factor = PIPE_BLENDFACTOR_ZERO,
       };
-      blend.rt[0].format = rt_format;
-      blend.rt[0].rgb = replace;
-      blend.rt[0].alpha = replace;
-      blend.rt[0].colormask = 0xf;
-      if (bs != NULL) {
-         blend.rt[0].colormask = bs->rt[0].colormask;
-         if (bs->logicop_enable) {
-            blend.logicop_enable = true;
-            blend.logicop_func = bs->logicop_func;
-         } else if (bs->rt[0].blend_enable) {
-            blend.rt[0].rgb = (nir_lower_blend_channel){
-               .func = bs->rt[0].rgb_func,
-               .src_factor = bs->rt[0].rgb_src_factor,
-               .dst_factor = bs->rt[0].rgb_dst_factor,
-            };
-            blend.rt[0].alpha = (nir_lower_blend_channel){
-               .func = bs->rt[0].alpha_func,
-               .src_factor = bs->rt[0].alpha_src_factor,
-               .dst_factor = bs->rt[0].alpha_dst_factor,
-            };
+      for (unsigned i = 0; i < nr_formats; i++) {
+         /* ES2 (with EXT_draw_buffers) has a single blend state and a single glColorMask, both
+          * applied to every draw buffer, so every attachment uses render target 0's state. Mesa's
+          * state tracker zero-fills pipe_blend_state::rt[] past the entries the API configured,
+          * and nir_lower_blend deletes a colour store whose colormask is zero - which silently
+          * dropped attachment 1's write until this read rt[0] for every attachment. */
+         const struct pipe_rt_blend_state *rtb = bs ? &bs->rt[0] : NULL;
+         blend.rt[i].format = rt_formats[i];
+         blend.rt[i].rgb = replace;
+         blend.rt[i].alpha = replace;
+         blend.rt[i].colormask = 0xf;
+         if (rtb != NULL) {
+            blend.rt[i].colormask = rtb->colormask;
+            if (bs->logicop_enable) {
+               blend.logicop_enable = true;
+               blend.logicop_func = bs->logicop_func;
+            } else if (rtb->blend_enable) {
+               blend.rt[i].rgb = (nir_lower_blend_channel){
+                  .func = rtb->rgb_func,
+                  .src_factor = rtb->rgb_src_factor,
+                  .dst_factor = rtb->rgb_dst_factor,
+               };
+               blend.rt[i].alpha = (nir_lower_blend_channel){
+                  .func = rtb->alpha_func,
+                  .src_factor = rtb->alpha_src_factor,
+                  .dst_factor = rtb->alpha_dst_factor,
+               };
+            }
          }
       }
    }
    struct pvr_shader *fsv = NULL;
    for (unsigned i = 0; i < fs->nr_variants; i++) {
-      if (fs->variants[i].format == rt_format &&
+      if (fs->variants[i].nr_formats == nr_formats &&
+          !memcmp(fs->variants[i].formats, rt_formats, nr_formats * sizeof(rt_formats[0])) &&
           !memcmp(&fs->variants[i].blend, &blend, sizeof(blend)))
          fsv = fs->variants[i].sh;
    }
    if (fsv == NULL) {
-      fsv = pvr_shader_create_fs(nir_shader_clone(NULL, fs->src_nir), scr->pco_ctx, rt_format,
-                                 &blend);
+      fsv = pvr_shader_create_fs(nir_shader_clone(NULL, fs->src_nir), scr->pco_ctx, rt_formats,
+                                 nr_formats, &blend);
       if (fsv == NULL)
          return false;
       /* shortcut: round robin past PVR_SHADER_MAX_VARIANTS; the evicted variant stays allocated. */
       const unsigned slot = fs->nr_variants < PVR_SHADER_MAX_VARIANTS ? fs->nr_variants++
-                                                                     : (rt_format + blend.rt[0].colormask) %
+                                                                     : (rt_formats[0] + blend.rt[0].colormask) %
                                                                           PVR_SHADER_MAX_VARIANTS;
-      fs->variants[slot].format = rt_format;
+      fs->variants[slot].nr_formats = nr_formats;
+      memcpy(fs->variants[slot].formats, rt_formats, nr_formats * sizeof(rt_formats[0]));
       fs->variants[slot].blend = blend;
       fs->variants[slot].sh = fsv;
    }
@@ -1754,7 +1787,7 @@ pvr_draw_flush(struct pvr_context *ctx)
    {
       const unsigned shared = PIPE_BIND_SHARED | PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_SCANOUT;
       if (d->ndraws == 0 && d->load_src == NULL && !d->no_defer && d->rt_level == 0 &&
-          !(d->rt->bind & shared)) {
+          ctx->fb.nr_cbufs <= 1 && !(d->rt->bind & shared)) {
          if (d->clear_valid) {
             pvr_resource(d->rt)->clear_pending = true;
             pvr_resource(d->rt)->clear_color = d->clear_color;
@@ -1798,15 +1831,61 @@ pvr_draw_flush(struct pvr_context *ctx)
    /* Depth-only framebuffer (shadow's depth pass): the colour target is a scratch one, so the
     * PBE must drop all colour writes instead of clearing/storing a full extra target. */
    const bool zonly = ctx->fb.nr_cbufs == 0 && ctx->fb.zsbuf.texture != NULL;
-   const uint64_t eot =
-      draw_eot_program(ctx, d, pvr_resource_level_addr(rt, d->rt_level), fmt, zonly);
-   const uint64_t bg = draw_bg_program(ctx, d, d->clear_valid ? d->clear_color : 0);
-   uint64_t pbe_words[3] = { 0 };
-   if (eot == 0 || bg == 0 ||
-       !pvr_csb_pbe_words(fmt, pvr_resource_level_stride(rt, d->rt_level), d->rt_w, d->rt_h,
-                          pvr_resource_level_phys_h(rt, d->rt_level), rt->twiddled, rt->fbc,
-                          pbe_words))
+   /* MRT: every colour attachment of the framebuffer is written by its own PBE emit words in the
+    * EOT program. v1 requires them to share the first attachment's format (the background program
+    * emits a single pixel value); a mixed set falls back to attachment 0 with a warning. */
+   unsigned nr_attach = 1;
+   uint64_t eot_addrs[PVR_MAX_COLOR_ATTACHMENTS] = { 0 };
+   enum pipe_format eot_formats[PVR_MAX_COLOR_ATTACHMENTS] = { PIPE_FORMAT_NONE };
+   const unsigned nr_fb = MIN2(ctx->fb.nr_cbufs, PVR_MAX_COLOR_ATTACHMENTS);
+   /* MRT only when this render really is the framebuffer's: materialize/blit renders open the
+    * driver's own target (d->rt) while the context framebuffer state still names some other set. */
+   const bool fb_render =
+      !zonly && nr_fb > 1 && d->rt == ctx->fb.cbufs[0].texture &&
+      d->rt_level == ctx->fb.cbufs[0].level;
+   if (zonly) {
+      eot_addrs[0] = pvr_resource_level_addr(rt, d->rt_level);
+      eot_formats[0] = fmt;
+   } else {
+      eot_addrs[0] = pvr_resource_level_addr(rt, d->rt_level);
+      eot_formats[0] = fmt;
+      if (fb_render) {
+         nr_attach = nr_fb;
+         for (unsigned i = 1; i < nr_attach; i++) {
+            struct pvr_resource *ri = pvr_resource(ctx->fb.cbufs[i].texture);
+            eot_addrs[i] = pvr_resource_level_addr(ri, ctx->fb.cbufs[i].level);
+            eot_formats[i] = ctx->fb.cbufs[i].format;
+         }
+         for (unsigned i = 1; i < nr_attach; i++) {
+            if (eot_formats[i] != eot_formats[0]) {
+               static bool warned;
+               if (!warned) {
+                  warned = true;
+                  mesa_logw("pvr: mixed-format MRT is not supported yet; rendering to attachment 0");
+               }
+               nr_attach = 1;
+               break;
+            }
+         }
+      }
+   }
+   const uint64_t eot = draw_eot_program(ctx, d, nr_attach, eot_addrs, eot_formats, zonly);
+   const uint64_t bg = draw_bg_program(ctx, d, d->clear_valid ? d->clear_color : 0,
+                                       zonly ? 1 : nr_attach);
+   uint64_t pbe_words[PVR_MAX_COLOR_ATTACHMENTS * 3] = { 0 };
+   if (eot == 0 || bg == 0 || !pvr_csb_pbe_words(eot_formats[0], pvr_resource_level_stride(rt, d->rt_level),
