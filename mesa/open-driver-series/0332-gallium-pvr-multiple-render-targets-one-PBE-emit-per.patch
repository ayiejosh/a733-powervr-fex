 src/gallium/drivers/pvr_native/pvr_shader.c  |  46 +++--
 src/gallium/drivers/pvr_native/pvr_shader.h  |   9 +-
 7 files changed, 205 insertions(+), 80 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index 7c28cd91..74a29af5 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -2,6 +2,7 @@
  * SPDX-License-Identifier: MIT
  */
 #include "pvr_context.h"
+#include "common/pvr_limits.h"
 
 #include "pipe/p_context.h"
 #include "util/format/u_formats.h"
@@ -620,13 +621,23 @@ pvr_clear(struct pipe_context *pctx, unsigned buffers, uint32_t color_clear_mask
    /* A full colour clear of buffer 0 becomes the render's background object; then there is
     * nothing for the CPU to fill for it. */
    bool gpu_cleared = false;
+   bool mrt_same_fmt = true;
+   for (unsigned i = 1; i < ctx->fb.nr_cbufs; i++)
+      if (ctx->fb.cbufs[i].format != ctx->fb.cbufs[0].format)
+         mrt_same_fmt = false;
    if ((buffers & PIPE_CLEAR_COLOR0) && (color_clear_mask & 0xf) == 0xf && scissor_state == NULL &&
-       ctx->fb.nr_cbufs == 1)
+       ctx->fb.nr_cbufs >= 1 && ctx->fb.nr_cbufs <= PVR_MAX_COLOR_ATTACHMENTS && mrt_same_fmt) {
       gpu_cleared = pvr_draw_note_clear(ctx, color);
+      /* MRT: one background colour covers every attachment (v1), so submit the clear render now -
+       * deferred clears are single-resource only. */
+      if (gpu_cleared && ctx->fb.nr_cbufs > 1)
+         pvr_draw_flush(ctx);
+   }
    if (!gpu_cleared)
       pvr_draw_flush(ctx);
    for (unsigned i = 0; i < ctx->fb.nr_cbufs; i++) {
-      if ((buffers & (PIPE_CLEAR_COLOR0 << i)) == 0 || (i == 0 && gpu_cleared))
+      /* A GPU clear covers every attachment (one background colour, one emit each). */
+      if (gpu_cleared || (buffers & (PIPE_CLEAR_COLOR0 << i)) == 0)
          continue;
 
       if (ctx->fb.cbufs[i].texture == NULL)
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.c b/src/gallium/drivers/pvr_native/pvr_csb.c
index bf52c6a9..09a0417b 100644
--- a/src/gallium/drivers/pvr_native/pvr_csb.c
+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -850,7 +850,10 @@ pvr_csb_pbe_state_words(uint64_t addr, enum pipe_format format, uint32_t mrt_ind
       .address_high = addr,
       .source_format = pvr_pbe_source_format_from_pipe(format, true),
       .mrt_index = mrt_index,
-      .source_pos = ROGUE_PBESTATE_SOURCE_POS_START_BIT0,
+      /* Each attachment's pixel data sits at its own output register (the reference maps output
+       * position 0..3 to START_BIT0/32/64/96), so attachment i reads dword i of the fragment
+       * output, not dword 0. */
+      .source_pos = (enum ROGUE_PBESTATE_SOURCE_POS)(mrt_index <= 3 ? mrt_index : 0),
       .norm = chan >= 0 && desc->channel[chan].normalized,
    };
 
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index 909d87c3..958e6fd9 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -60,6 +60,7 @@ struct pvr_draw_pds_prog {
 
