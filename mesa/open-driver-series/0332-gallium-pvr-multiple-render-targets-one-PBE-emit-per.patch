 src/gallium/drivers/pvr_native/pvr_csb.c     |   5 +-
 src/gallium/drivers/pvr_native/pvr_draw.c    | 205 +++++++++++++------
 src/gallium/drivers/pvr_native/pvr_probe.c   |   2 +-
