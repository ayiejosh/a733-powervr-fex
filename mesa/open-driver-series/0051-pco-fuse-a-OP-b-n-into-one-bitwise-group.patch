From 6271e265b33c415d6c97581100bea69e8df95f48 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sat, 10 Oct 2026 01:45:41 +0800
Subject: [PATCH 51/98] pco: fuse a OP (b << n) into one bitwise group

Bitwise phase 0 can shift left (shift1 lsl, by s1) before the phase 1
logical op, as the bitfield-insert mapping already does. Add a
logical.lsl op (p0 msk_lsl + p1 logical) and use it for iand/ior/ixor
whose other operand is a single-use 32-bit ishl by a constant below 32.
Hashing and bit-packing code (x ^ (x << n), r | (g << 8)) then takes one
group instead of two.

BXM-4-64, interleaved A/B x3 against the previous commit:
  cstpi  97 -> 116 M inv/s (161 -> 129 groups)
  cstpin 99 -> 138 M inv/s
A new or/and/xor probe with shifts 0, 1, 3, 17 and 31 on either operand
(32 fused ops) gives a bit-identical output hash; other hashes and
vkedge/vkrender checks unchanged.
---
 src/imagination/pco/pco_map.py      | 26 ++++++++++++++++++++++++
 src/imagination/pco/pco_ops.py      |  1 +
 src/imagination/pco/pco_trans_nir.c | 31 ++++++++++++++++++++++++++++-
 3 files changed, 57 insertions(+), 1 deletion(-)

diff --git a/src/imagination/pco/pco_map.py b/src/imagination/pco/pco_map.py
index cca59f8..358198b 100644
--- a/src/imagination/pco/pco_map.py
+++ b/src/imagination/pco/pco_map.py
@@ -3610,6 +3610,32 @@ group_map(O_LOGICAL,
    dests=[('w[0]', ('1', DEST(0)), 'ft4')]
 )
 
+# a OP (b << n): phase 0 shifts (shift1 lsl by s1; the mask outputs are
+# unused), phase 1 combines with s3.
+group_map(O_LOGICAL_LSL,
+   hdr=(I_IGRP_HDR_BITWISE, [
+      ('opcnt', ['p0', 'p1']),
+      ('olchk', OM_OLCHK),
+      ('w1p', False),
+      ('w0p', True),
+      ('cc', OM_EXEC_CND),
+      ('end', OM_END),
+      ('atom', OM_ATOM),
+      ('rpt', OM_RPT)
+   ]),
+   enc_ops=[
+      ('0', O_MSK_LSL, ['ft0', 'ft1', 'ft2'], ['pco_zero', SRC(2), SRC(1)]),
+      ('1', O_LOGICAL, [DEST(0)], ['_', 'ft2', '_', SRC(0)], [(OM_LOGIOP, OM_LOGIOP)])
+   ],
+   srcs=[
+      ('s[0]', ('0', SRC(0)), 's0'),
+      ('s[1]', ('0', SRC(1)), 's1'),
+      ('s[2]', ('0', SRC(2)), 's2'),
+      ('s[3]', ('1', SRC(3)), 's3')
+   ],
+   dests=[('w[0]', ('1', DEST(0)), 'ft4')]
+)
+
 group_map(O_SHIFT,
    hdr=(I_IGRP_HDR_BITWISE, [
       ('opcnt', ['p0', 'p2']),
diff --git a/src/imagination/pco/pco_ops.py b/src/imagination/pco/pco_ops.py
index ca868c7..de53bdf 100644
--- a/src/imagination/pco/pco_ops.py
+++ b/src/imagination/pco/pco_ops.py
@@ -448,6 +448,7 @@ O_FTB = hw_op('ftb', OM_ALU, 1, 1)
 O_REV = hw_op('rev', OM_ALU, 1, 1)
 O_SHUFFLE = hw_op('shuffle', OM_ALU, 1, 2)
 O_LOGICAL = hw_op('logical', OM_ALU + [OM_LOGIOP], 1, 4)
+O_LOGICAL_LSL = hw_op('logical.lsl', OM_ALU + [OM_LOGIOP], 1, 3)
 O_SHIFT = hw_op('shift', OM_ALU + [OM_SHIFTOP], 1, 3)
 
 O_COPYSIGN = hw_op('copysign', OM_ALU, 1, 2)
diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index 8509e8f..3cecfda 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -4100,7 +4100,36 @@ static pco_instr *trans_alu(trans_ctx *tctx, nir_alu_instr *alu)
 
    case nir_op_iand:
    case nir_op_ior:
-   case nir_op_ixor:
+   case nir_op_ixor: {
+      /* a OP (b << n) in one group: phase 0 shifts, phase 1 combines. */
+      unsigned other = 0;
+      nir_alu_instr *shl = NULL;
+      if (alu->def.bit_size == 32 && alu->def.num_components == 1) {
+         shl = single_use_alu_src(alu, 1, nir_op_ishl);
+         if (!shl) {
+            shl = single_use_alu_src(alu, 0, nir_op_ishl);
+            other = 1;
+         }
+      }
+
+      if (shl && nir_src_is_const(shl->src[1].src) &&
+          nir_src_comp_as_uint(shl->src[1].src, shl->src[1].swizzle[0]) < 32) {
+         enum pco_logiop logiop = alu->op == nir_op_iand  ? PCO_LOGIOP_AND
+                                  : alu->op == nir_op_ior ? PCO_LOGIOP_OR
+                                                          : PCO_LOGIOP_XOR;
+         instr = pco_logical_lsl(&tctx->b,
+                                 dest,
+                                 src[other],
+                                 pco_ref_nir_alu_src_t(shl, 0, tctx),
+                                 pco_ref_nir_alu_src_t(shl, 1, tctx),
+                                 .logiop = logiop);
+         break;
+      }
+
+      instr = trans_logical(tctx, alu->op, dest, src[0], src[1]);
+      break;
+   }
+
    case nir_op_inot:
       instr = trans_logical(tctx, alu->op, dest, src[0], src[1]);
       break;
-- 
