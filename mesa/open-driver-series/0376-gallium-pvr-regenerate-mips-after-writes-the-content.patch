From 50eb114f9314991095a0f5ae6b9dcc82941ed5d6 Mon Sep 17 00:00:00 2001
From: ayiejosh <132535860+ayiejosh@users.noreply.github.com>
Date: Sun, 1 Nov 2026 11:54:37 +0800
Subject: [PATCH 376/378] gallium/pvr: regenerate mips after writes the content
 version missed

pvr_generate_mipmap() skips when the texture's write_seq matches the
chain it generated. A render bumps write_seq only when it is flushed,
and generate_mipmap does not flush, so glGenerateMipmap right after
drawing into the texture (that render still open) kept the old chain.
Close an open render that writes the texture before the check.

A clear-only render that is deferred as clear_pending did not bump
write_seq at all, nor did a draw that runs through the compute fallback;
bump it in both. Also remember the level range a generation covered: a
later call over more levels (a raised max level) or from a lower base
level was skipped.

Fixes: 73a7404c ("gallium/pvr: skip mip generation while the base contents are unchanged")
---
 src/gallium/drivers/pvr_native/pvr_context.c  | 11 +++++++++--
 src/gallium/drivers/pvr_native/pvr_draw.c     | 14 ++++++++++++++
 src/gallium/drivers/pvr_native/pvr_draw.h     |  2 ++
 src/gallium/drivers/pvr_native/pvr_resource.h |  1 +
 4 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/pvr_native/pvr_context.c b/src/gallium/drivers/pvr_native/pvr_context.c
index 1e9766cb..1e7327a1 100644
--- a/src/gallium/drivers/pvr_native/pvr_context.c
+++ b/src/gallium/drivers/pvr_native/pvr_context.c
@@ -438,6 +438,7 @@ pvr_draw_vbo(struct pipe_context *pctx, const struct pipe_draw_info *info,
 
       pvr_collect_draw_vertices(ctx, vertices);
       if (pvr_compute_render_triangle(ctx, rt, vertices)) {
+         rt->write_seq++; /* mip generation compares it */
          ctx->draws_executed++;
          return;
       }
@@ -902,11 +903,15 @@ pvr_generate_mipmap(struct pipe_context *pctx, struct pipe_resource *pres,
    if (format != pres->format)
       return false;
    struct pvr_resource *res = pvr_resource(pres);
+   const unsigned last = MIN2(last_level, pres->last_level);
+   /* An open render into the texture bumps write_seq only when it is flushed. */
+   pvr_draw_flush_writer(pvr_context(pctx), pres);
    if (getenv("PVR_NO_MIP_CACHE") == NULL && res->mips_valid &&
-       res->mips_write_seq == res->write_seq)
+       res->mips_write_seq == res->write_seq && base_level >= res->mips_base &&
+       last <= res->mips_last)
       return true;
    const unsigned faces = res->cube ? 6 : 1;
-   for (unsigned l = base_level + 1; l <= MIN2(last_level, pres->last_level); l++) {
+   for (unsigned l = base_level + 1; l <= last; l++) {
       for (unsigned f = 0; f < faces; f++) {
          if (!pvr_draw_blit(pvr_context(pctx), pres, l, f, pres, l - 1, f, true))
             return false;
@@ -914,6 +919,8 @@ pvr_generate_mipmap(struct pipe_context *pctx, struct pipe_resource *pres,
    }
    res->mips_valid = true;
    res->mips_write_seq = res->write_seq;
+   res->mips_base = base_level;
+   res->mips_last = last;
    return true;
 }
 
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
index d0ec3cdf..df921c0a 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.c
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -1998,6 +1998,19 @@ pvr_draw_resource_sync(struct pvr_context *ctx, struct pvr_resource *res)
    }
 }
 
+void
+pvr_draw_flush_writer(struct pvr_context *ctx, struct pipe_resource *pres)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (d == NULL || !d->open)
+      return;
+   bool writes = d->rt == pres || d->zs == pres;
+   for (unsigned i = 0; i < ctx->fb.nr_cbufs; i++)
+      writes |= ctx->fb.cbufs[i].texture == pres;
+   if (writes)
+      pvr_draw_flush(ctx);
+}
+
 uint32_t
 pvr_draw_last_sync(struct pvr_context *ctx)
 {
@@ -2082,6 +2095,7 @@ pvr_draw_flush(struct pvr_context *ctx)
       if (d->ndraws == 0 && d->load_src == NULL && !d->no_defer && d->rt_level == 0 &&
           ctx->fb.nr_cbufs <= 1 && !(d->rt->bind & shared)) {
          if (d->clear_valid) {
+            pvr_resource(d->rt)->write_seq++;
             pvr_resource(d->rt)->clear_pending = true;
             pvr_resource(d->rt)->clear_color = d->clear_color;
             pvr_resource(d->rt)->clear_value = d->clear_value;
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.h b/src/gallium/drivers/pvr_native/pvr_draw.h
index e33a12e7..a94c4c67 100644
--- a/src/gallium/drivers/pvr_native/pvr_draw.h
+++ b/src/gallium/drivers/pvr_native/pvr_draw.h
@@ -45,6 +45,8 @@ bool pvr_draw_note_zclear(struct pvr_context *ctx, float depth);
  * last render that used it. */
 struct pvr_resource;
 void pvr_draw_resource_sync(struct pvr_context *ctx, struct pvr_resource *res);
+/* Closes the open render if it writes the resource (no wait), so its writes count. */
+void pvr_draw_flush_writer(struct pvr_context *ctx, struct pipe_resource *pres);
 /* Submits a deferred clear of the resource, if it has one (see draw_materialize). */
 void pvr_draw_resource_materialize(struct pvr_context *ctx, struct pvr_resource *res);
 
diff --git a/src/gallium/drivers/pvr_native/pvr_resource.h b/src/gallium/drivers/pvr_native/pvr_resource.h
index 0d0f62cb..3f8798ac 100644
--- a/src/gallium/drivers/pvr_native/pvr_resource.h
+++ b/src/gallium/drivers/pvr_native/pvr_resource.h
@@ -80,6 +80,7 @@ struct pvr_resource {
    uint32_t write_seq;
    bool mips_valid;
    uint32_t mips_write_seq;
+   unsigned mips_base, mips_last; /* the level range that generation covered */
 };
 
 struct pipe_resource *pvr_resource_create(struct pipe_screen *pscreen,
-- 
