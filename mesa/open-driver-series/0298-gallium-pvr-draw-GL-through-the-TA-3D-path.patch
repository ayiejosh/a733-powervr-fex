+static void *
+pvr_create_vertex_elements_state(UNUSED struct pipe_context *pctx, unsigned count,
+                                 const struct pipe_vertex_element *elements)
+{
+   struct pvr_vertex_elements *ve = CALLOC_STRUCT(pvr_vertex_elements);
+   if (ve == NULL)
+      return NULL;
+   ve->count = MIN2(count, PIPE_MAX_ATTRIBS);
+   memcpy(ve->elements, elements, ve->count * sizeof(*elements));
+   return ve;
+}
+
+static void
+pvr_delete_vertex_elements_state(UNUSED struct pipe_context *pctx, void *state)
+{
+   FREE(state);
+}
+
+static void *
+pvr_create_sampler_state(UNUSED struct pipe_context *pctx, const struct pipe_sampler_state *state)
+{
+   return pvr_state_copy(state, sizeof(*state));
+}
+
+static struct pipe_sampler_view *
+pvr_create_sampler_view(struct pipe_context *pctx, struct pipe_resource *texture,
+                        const struct pipe_sampler_view *templ)
+{
+   struct pipe_sampler_view *view = CALLOC_STRUCT(pipe_sampler_view);
+   if (view == NULL)
+      return NULL;
+   *view = *templ;
+   view->texture = NULL;
+   pipe_resource_reference(&view->texture, texture);
+   view->context = pctx;
+   pipe_reference_init(&view->reference, 1);
+   return view;
+}
+
+/* State the draw path does not consume yet: accepted so the state tracker can set it. */
+static void pvr_set_scissor_states(UNUSED struct pipe_context *p, UNUSED unsigned s, UNUSED unsigned n,
+                                   UNUSED const struct pipe_scissor_state *st) {}
+static void pvr_set_blend_color(UNUSED struct pipe_context *p, UNUSED const struct pipe_blend_color *c) {}
+static void pvr_set_clip_state(UNUSED struct pipe_context *p, UNUSED const struct pipe_clip_state *c) {}
+static void pvr_set_polygon_stipple(UNUSED struct pipe_context *p, UNUSED const struct pipe_poly_stipple *s) {}
+static void pvr_texture_barrier(UNUSED struct pipe_context *p, UNUSED unsigned flags) {}
+static void pvr_memory_barrier(UNUSED struct pipe_context *p, UNUSED unsigned flags) {}
+static void pvr_flush_resource(UNUSED struct pipe_context *p, UNUSED struct pipe_resource *r) {}
+static void pvr_invalidate_resource(UNUSED struct pipe_context *p, UNUSED struct pipe_resource *r) {}
+
+/* shortcut: no GPU blit yet. Same-format, unscaled copies go through the CPU; anything else is
+ * reported and skipped. */
+static void
+pvr_blit(struct pipe_context *pctx, const struct pipe_blit_info *info)
+{
+   if (info->src.format == info->dst.format && info->src.box.width == info->dst.box.width &&
+       info->src.box.height == info->dst.box.height && info->mask == PIPE_MASK_RGBA &&
+       !info->scissor_enable) {
+      util_resource_copy_region(pctx, info->dst.resource, info->dst.level, info->dst.box.x,
+                                info->dst.box.y, info->dst.box.z, info->src.resource,
+                                info->src.level, &info->src.box);
+      return;
+   }
+   static bool warned;
+   if (!warned) {
+      warned = true;
+      mesa_logw("pvr: blit with conversion or scaling is not supported yet; skipped");
+   }
+}
+
+static void
+pvr_clear_render_target(struct pipe_context *pctx, struct pipe_surface *dst,
+                        const union pipe_color_union *color, unsigned x, unsigned y,
+                        unsigned w, unsigned h, UNUSED bool render_condition_enabled)
+{
+   pvr_draw_flush(pvr_context(pctx));
+   util_clear_render_target(pctx, dst, color, x, y, w, h);
+}
+
+static void
+pvr_clear_depth_stencil(struct pipe_context *pctx, struct pipe_surface *dst, unsigned flags,
+                        double depth, unsigned stencil, unsigned x, unsigned y, unsigned w,
+                        unsigned h, UNUSED bool render_condition_enabled)
+{
+   pvr_draw_flush(pvr_context(pctx));
+   util_clear_depth_stencil(pctx, dst, flags, depth, stencil, x, y, w, h);
+}
 
