+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The fixed-function draw path: GL draws go through the TA (geometry) and ISP/3D (fragment) stages.
+ * Draws accumulate into one control stream per render target; the render is submitted at flush,
+ * readback or target change. Unsupported state returns false so the caller can fall back.
+ */
+#ifndef PVR_DRAW_H
+#define PVR_DRAW_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct pvr_context;
+struct pipe_draw_info;
+struct pipe_draw_start_count_bias;
+union pipe_color_union;
+
+bool pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
+                 const struct pipe_draw_start_count_bias *draws, unsigned num_draws);
+/* Submit the open render, if any. */
+void pvr_draw_flush(struct pvr_context *ctx);
+/* A colour clear of cbuf 0: the next render's background object writes this colour. */
+void pvr_draw_note_clear(struct pvr_context *ctx, const union pipe_color_union *color);
+void pvr_draw_destroy(struct pvr_context *ctx);
+
+#endif /* PVR_DRAW_H */
