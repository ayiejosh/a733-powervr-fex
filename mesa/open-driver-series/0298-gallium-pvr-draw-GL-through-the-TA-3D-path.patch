       if ((buffers & (PIPE_CLEAR_COLOR0 << i)) == 0)
          continue;
@@ -509,7 +522,8 @@ pvr_clear(struct pipe_context *pctx, unsigned buffers, uint32_t color_clear_mask
       if (ctx->fb.cbufs[i].texture == NULL)
          continue;
 
-      if (color_clear_mask != 0xf) {
+      /* four channel bits per colour buffer */
