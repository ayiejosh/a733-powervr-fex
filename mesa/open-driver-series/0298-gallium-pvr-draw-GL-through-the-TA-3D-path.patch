    pvr_compute_state_finish(ctx->compute);
    util_unreference_framebuffer_state(&ctx->fb);
    FREE(ctx);
@@ -657,6 +766,25 @@ pvr_context_create(struct pipe_screen *pscreen, UNUSED void *priv,
