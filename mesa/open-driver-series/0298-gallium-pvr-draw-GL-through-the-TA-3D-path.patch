+   ctx->base.buffer_subdata = u_default_buffer_subdata;
+   ctx->base.texture_subdata = u_default_texture_subdata;
+   ctx->base.set_scissor_states = pvr_set_scissor_states;
+   ctx->base.set_blend_color = pvr_set_blend_color;
+   ctx->base.set_clip_state = pvr_set_clip_state;
+   ctx->base.set_polygon_stipple = pvr_set_polygon_stipple;
+   ctx->base.texture_barrier = pvr_texture_barrier;
+   ctx->base.memory_barrier = pvr_memory_barrier;
+   ctx->base.flush_resource = pvr_flush_resource;
+   ctx->base.invalidate_resource = pvr_invalidate_resource;
+   ctx->base.resource_copy_region = util_resource_copy_region;
+   ctx->base.blit = pvr_blit;
+   ctx->base.clear_render_target = pvr_clear_render_target;
+   ctx->base.clear_depth_stencil = pvr_clear_depth_stencil;
    ctx->base.draw_vbo = pvr_draw_vbo;
    ctx->base.set_stencil_ref = pvr_set_stencil_ref;
    ctx->base.set_sample_mask = pvr_set_sample_mask;
