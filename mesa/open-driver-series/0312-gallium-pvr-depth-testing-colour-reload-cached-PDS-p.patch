+/* The load background object: a fragment shader that fetches the target's own texel at its pixel
+ * (texture unit 0 = the target, set 0 binding 0) and writes it back, with the PDS program that
+ * DMAs that texture's descriptor into shared registers, as the reference's load op. Fills the
+ * PDS_BGRND words; false if the target cannot be read as a texture. */
+static bool
+draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bgnd[3])
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   const struct pvr_resource *rt = pvr_resource(d->rt);
+   const enum pipe_format format = d->rt->format;
+   struct pvr_shader *fs = NULL;
+   struct pvr_format_layout layout;
+
+   if (!pvr_format_layout_from_pipe(format, &layout))
+      return false;
+   for (unsigned i = 0; i < d->nr_load; i++) {
+      if (d->load[i].format == format)
+         fs = d->load[i].fs;
+   }
+   if (fs == NULL) {
+      nir_builder b =
+         nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(), "pvr_load");
+      nir_variable *out = nir_variable_create(b.shader, nir_var_shader_out, glsl_vec4_type(),
+                                              "color");
+      out->data.location = FRAG_RESULT_DATA0;
