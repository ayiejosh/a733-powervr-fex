+/* Values a PDS data segment is patched with. */
+struct pvr_draw_pds_vals {
+   const uint64_t *vb_addr;
+   const uint32_t *vb_stride;
+   uint32_t usc_offset;
+   uint64_t buffer_addr; /* PVR_BUFFER_TYPE_PUSH_CONSTS */
+};
+
+/* Fill a data segment from a generator's const map. Offsets are in dwords. */
+static bool
+draw_pds_patch(const void *entries, uint32_t size, uint32_t *data,
+               const struct pvr_draw_pds_vals *v)
+{
+   const uint8_t *entry = entries;
+   const uint8_t *end = entry + size;
+   while (entry + sizeof(struct pvr_const_map_entry) <= end) {
+      const struct pvr_const_map_entry *hdr = (const void *)entry;
+      switch (hdr->type) {
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_DOUTU_ADDRESS: {
+         const struct pvr_const_map_entry_doutu_address *e = (const void *)entry;
+         uint64_t x = 0;
+         pvr_set_usc_execution_address64(&x, v->usc_offset);
+         x |= e->doutu_control;
+         memcpy(&data[e->const_offset], &x, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_VERTEX_ATTRIBUTE_ADDRESS: {
+         const struct pvr_const_map_entry_vertex_attribute_address *e = (const void *)entry;
+         const uint64_t x = v->vb_addr[e->binding_index] + e->offset;
+         memcpy(&data[e->const_offset], &x, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_VERTEX_ATTRIBUTE_STRIDE: {
+         const struct pvr_const_map_entry_vertex_attribute_stride *e = (const void *)entry;
+         data[e->const_offset] = v->vb_stride[e->binding_index];
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_SPECIAL_BUFFER: {
+         const struct pvr_const_map_entry_special_buffer *e = (const void *)entry;
+         if (e->buffer_type != PVR_BUFFER_TYPE_PUSH_CONSTS)
+            return false;
+         memcpy(&data[e->const_offset], &v->buffer_addr, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL32: {
+         const struct pvr_const_map_entry_literal32 *e = (const void *)entry;
+         data[e->const_offset] = e->literal_value;
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL64: {
+         const struct pvr_const_map_entry_literal64 *e = (const void *)entry;
+         memcpy(&data[e->const_offset], &e->literal_value, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      default:
+         mesa_loge("pvr: draw: no patch rule for PDS const-map entry type %u", hdr->type);
+         return false;
+      }
+   }
+   return true;
+}
+
+/* Generator callback: fills info (sizes, const map) and, with code != NULL, the code. */
+typedef void (*pvr_draw_pds_gen)(const void *input, uint32_t *code, struct pvr_pds_info *info,
+                                 const struct pvr_device_info *dev_info);
+
+/* A PDS program for this key: from the cache, or generated (and cached when the code arena has
+ * room), then its data segment patched into the transient PDS arena. Offsets out are PDS-heap
+ * offsets. */
+static bool
+draw_pds_program(struct pvr_context *ctx, struct pvr_draw_state *d, const void *key,
+                 uint32_t key_size, pvr_draw_pds_gen gen, const void *input,
+                 const struct pvr_draw_pds_vals *vals, uint32_t *code_off, uint32_t *data_off,
+                 uint32_t *data_dwords, uint32_t *temps)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   const uint64_t pds_base = scr->vm.heaps[DRM_PVR_HEAP_PDS_CODE_DATA].base;
+   struct pvr_draw_pds_prog *p = NULL, tmp = { 0 };
+   uint64_t addr = 0;
+
+   for (unsigned i = 0; i < d->nprogs; i++) {
+      if (d->progs[i].key_size == key_size && !memcmp(d->progs[i].key, key, key_size)) {
+         p = &d->progs[i];
+         break;
+      }
+   }
+   if (p == NULL) {
+      struct pvr_pds_info info = { .entries_size_in_bytes = 2048 };
+      info.entries = calloc(1, info.entries_size_in_bytes);
+      if (info.entries == NULL)
+         return false;
+      gen(input, NULL, &info, &scr->dev_info);
+      const bool cacheable = key_size <= PVR_DRAW_PDS_KEY && d->nprogs < PVR_DRAW_PDS_CACHE &&
+                             d->pdscode.used + info.code_size_in_dwords * 4 + 64 <= ARENA_PDS_SIZE;
+      uint32_t *code = arena_alloc(cacheable ? &d->pdscode : &d->pds,
+                                   MAX2(info.code_size_in_dwords, 1) * 4, 64, &addr);
+      if (code == NULL) {
+         free(info.entries);
+         return false;
+      }
+      gen(input, code, &info, &scr->dev_info);
+      p = cacheable ? &d->progs[d->nprogs++] : &tmp;
+      p->key_size = MIN2(key_size, PVR_DRAW_PDS_KEY);
+      memcpy(p->key, key, p->key_size);
+      p->code_off = addr - pds_base;
+      p->data_dwords = info.data_size_in_dwords;
+      p->temps = info.temps_required;
+      p->entries_size = MIN2(info.entries_written_size_in_bytes, info.entries_size_in_bytes);
+      p->entries = info.entries;
+   }
+   uint32_t *data = arena_alloc(&d->pds, MAX2(p->data_dwords, 1) * 4, 64, &addr);
+   bool ok = data != NULL;
+   if (ok) {
+      memset(data, 0, p->data_dwords * 4);
+      ok = draw_pds_patch(p->entries, p->entries_size, data, vals);
+   }
+   *code_off = p->code_off;
+   *data_off = addr - pds_base;
+   *data_dwords = p->data_dwords;
+   *temps = p->temps;
+   if (p == &tmp)
+      free(tmp.entries);
+   return ok;
+}
+
+static void
+draw_gen_vertex(const void *input, uint32_t *code, struct pvr_pds_info *info,
+                const struct pvr_device_info *dev_info)
+{
