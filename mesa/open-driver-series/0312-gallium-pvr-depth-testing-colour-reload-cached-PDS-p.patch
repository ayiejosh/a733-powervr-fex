+static void
+draw_gen_descriptor(const void *input, uint32_t *code, struct pvr_pds_info *info,
+                    UNUSED const struct pvr_device_info *dev_info)
+{
+   pvr_pds_generate_descriptor_upload_program((struct pvr_pds_descriptor_program_input *)input,
+                                              code, info);
+}
