+bool
+pvr_frag_static_stream_set_zls(void *stream, uint32_t stream_len,
+                               const struct pvr_device_info *dev_info, uint32_t zls_format,
+                               uint64_t zbase, uint32_t width, uint32_t height, bool load,
+                               bool store, uint32_t bgdepth, uint32_t zls_stride)
+{
+   const uint32_t pbe_dwords = PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
+   const uint32_t ctrl_off = (PVR_FRAG_PRE_PBE_DWORDS + pbe_dwords +
+                              PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_PDM) +
+                              2 * ROGUE_NUM_CR_PDS_BGRND_WORDS * 2 +
+                              ROGUE_KMD_STREAM_USC_CLEAR_REGISTER_COUNT *
+                                 PVR_CMD_DW(CR_USC_CLEAR_REGISTER)) * 4;
+   /* Header, scissor, dbias and occlusion bases come first (the kernel's frag stream order). */
+   const uint32_t zlsctl_off = (PVR_CMD_DW(KMD_STREAM_HDR) + PVR_CMD_DW(CR_ISP_SCISSOR_BASE) +
+                                PVR_CMD_DW(CR_ISP_DBIAS_BASE) + PVR_CMD_DW(CR_ISP_OCLQRY_BASE)) * 4;
+   const uint32_t zload_off = zlsctl_off + PVR_CMD_DW(CR_ISP_ZLSCTL) * 4;
+   /* zls_stride, sls_stride and execute_count close the stream (the capture's last 12 bytes). */
+   const uint32_t zls_stride_off = stream_len - 12;
+   uint32_t *dw = stream;
+   uint32_t tiles_x, tiles_y;
+
+   if (stream_len < ctrl_off + 8 || zls_stride_off <= ctrl_off)
+      return false;
+   /* rogue_get_isp_num_tiles_xy() for one sample (its header clashes with this csbgen). */
+   tiles_x = DIV_ROUND_UP(ALIGN_POT(width, 32), PVR_GET_FEATURE_VALUE(dev_info, tile_size_x, 16));
+   tiles_y = DIV_ROUND_UP(ALIGN_POT(height, 32), PVR_GET_FEATURE_VALUE(dev_info, tile_size_y, 16));
+   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format)) {
+      tiles_x = ALIGN_POT(tiles_x, 2);
+      tiles_y = ALIGN_POT(tiles_y, 2);
+   }
+   const struct ROGUE_CR_ISP_ZLSCTL ctl = {
+      .zlsextent_x_z = tiles_x - 1,
+      .zlsextent_y_z = tiles_y - 1,
+      .zloadformat = zls_format,
+      .zstoreformat = zls_format,
+      .zloaden = load,
+      .zstoreen = store,
+      .forcezload = load,
+      .forcezstore = store,
+   };
+   const struct ROGUE_CR_ISP_ZLOAD_BASE base = { .addr = zbase };
+   ROGUE_CR_ISP_ZLSCTL_pack(&dw[zlsctl_off / 4], &ctl);
+   ROGUE_CR_ISP_ZLOAD_BASE_pack(&dw[zload_off / 4], &base);
+   dw[ctrl_off / 4 + 1] = bgdepth;
+   dw[zls_stride_off / 4] = zls_stride;
+   return true;
+}
