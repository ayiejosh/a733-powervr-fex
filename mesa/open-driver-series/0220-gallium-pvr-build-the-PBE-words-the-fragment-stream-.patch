+bool
+pvr_csb_pbe_words(enum pipe_format format, uint64_t addr, uint32_t mrt_index,
+                  uint32_t stride_bytes, uint64_t words[3])
+{
+   const struct util_format_description *desc = util_format_description(format);
+   const int chan = util_format_get_first_non_void_channel(format);
+   struct pvr_format_layout layout;
+   struct ROGUE_PBESTATE_STATE_WORD0 sw0 = { .address_low = addr };
+   struct ROGUE_PBESTATE_STATE_WORD1 sw1 = {
+      .address_high = addr,
+      .source_format = pvr_pbe_source_format_from_pipe(
+         format, true /* with_packed_usc_channel */),
+      .mrt_index = mrt_index,
+      .source_pos = ROGUE_PBESTATE_SOURCE_POS_START_BIT0,
+      .norm = chan >= 0 && desc->channel[chan].normalized,
+   };
+   struct ROGUE_PBESTATE_REG_WORD0 reg0 = {
+      .tilerelative = true,
+      .memlayout = ROGUE_PBESTATE_MEMLAYOUT_LINEAR,
+      .rotation = ROGUE_PBESTATE_ROTATION_TYPE_0_DEG,
+      .linestride = pvr_pbe_linestride(stride_bytes),
+   };
+   struct ROGUE_PBESTATE_REG_WORD1 reg1 = { 0 };
+   uint32_t cs[2];
+
+   if (chan < 0 || !pvr_format_layout_from_pipe(format, &layout))
+      return false;
+
+   /* The reference derives the pack mode from the output format's channel layout. Only the
+    * layouts this driver can describe are encoded; anything else is refused. */
+   if (desc->channel[chan].type == UTIL_FORMAT_TYPE_FLOAT) {
+      sw1.packmode = desc->channel[chan].size == 16
+                        ? ROGUE_PBESTATE_PACKMODE_F16F16F16F16
+                        : ROGUE_PBESTATE_PACKMODE_F32F32F32F32;
+   } else if (desc->channel[chan].size == 8) {
+      sw1.packmode = desc->channel[chan].type == UTIL_FORMAT_TYPE_SIGNED
+                        ? ROGUE_PBESTATE_PACKMODE_S8S8S8S8
+                        : ROGUE_PBESTATE_PACKMODE_U8U8U8U8;
+   } else if (desc->channel[chan].size == 16) {
+      sw1.packmode = desc->channel[chan].type == UTIL_FORMAT_TYPE_SIGNED
+                        ? ROGUE_PBESTATE_PACKMODE_S16S16S16S16
+                        : ROGUE_PBESTATE_PACKMODE_U16U16U16U16;
+   } else {
+      return false;
+   }
+
+   /* Channel swizzles: output channel n reads the source channel named by swizzle[n]. */
+   for (unsigned i = 0; i < 4; i++) {
+      enum ROGUE_PBESTATE_SWIZ swiz;
+      uint8_t pipe = layout.swizzle[i];
+
+      if (pipe == PIPE_SWIZZLE_0 || pipe == PIPE_SWIZZLE_NONE) {
+         swiz = ROGUE_PBESTATE_SWIZ_ZERO;
+      } else if (pipe == PIPE_SWIZZLE_1) {
+         swiz = ROGUE_PBESTATE_SWIZ_ONE;
+      } else if (!pvr_pbe_swizzle_from_pipe(pipe, &swiz)) {
+         return false;
+      }
+
+      switch (i) {
+      case 0: reg0.swiz_chan0 = swiz; break;
+      case 1: reg0.swiz_chan1 = swiz; break;
+      case 2: reg0.swiz_chan2 = swiz; break;
+      case 3: reg0.swiz_chan3 = swiz; break;
+      }
+   }
+
+   ROGUE_PBESTATE_STATE_WORD0_pack(&cs[0], &sw0);
+   ROGUE_PBESTATE_STATE_WORD1_pack(&cs[1], &sw1);
+   words[0] = (uint64_t)cs[0] | ((uint64_t)cs[1] << 32);
+   ROGUE_PBESTATE_REG_WORD0_pack(&words[1], &reg0);
+   ROGUE_PBESTATE_REG_WORD1_pack(&words[2], &reg1);
+
+   return true;
+}
+
