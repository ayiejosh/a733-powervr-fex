+
+/* Whether a format is four 8-bit linear UNORM channels packed in channel
+ * order, so a constant channel's packed bits are known at compile time.
+ */
+static bool unorm8_format_packs_bytes(enum pipe_format format)
+{
+   const struct util_format_description *desc = util_format_description(format);
+
+   if (!util_format_is_unorm(format) || util_format_is_srgb(format) ||
+       desc->block.bits != 32 || desc->nr_channels != 4)
+      return false;
+
+   for (unsigned c = 0; c < desc->nr_channels; c++) {
+      if (desc->channel[c].size != 8 || desc->channel[c].shift != 8 * c)
+         return false;
+   }
+
+   return true;
+}
+
+/* Resolves a scalar to a constant, also through a bcsel selecting between
+ * two equal constants (alpha-to-one leaves bcsel(enabled, 1.0, alpha)).
+ */
+static bool scalar_const_bits(nir_scalar s, uint32_t *bits)
+{
+   s = nir_scalar_chase_movs(s);
+   if (nir_scalar_is_const(s)) {
+      *bits = nir_scalar_as_uint(s);
+      return true;
+   }
+
+   uint32_t a, b;
+   if (nir_scalar_is_alu(s) && nir_scalar_alu_op(s) == nir_op_bcsel &&
+       scalar_const_bits(nir_scalar_chase_alu_src(s, 1), &a) &&
+       scalar_const_bits(nir_scalar_chase_alu_src(s, 2), &b) && a == b) {
+      *bits = a;
+      return true;
+   }
+
+   return false;
+}
+
+static bool fold_pack_consts(nir_builder *b,
+                             nir_intrinsic_instr *intr,
+                             UNUSED void *cb_data)
+{
+   if (intr->intrinsic != nir_intrinsic_pack_pco)
+      return false;
+
+   enum pipe_format format = nir_intrinsic_format(intr);
+   if (!unorm8_format_packs_bytes(format))
+      return false;
+
+   nir_def *src = intr->src[0].ssa;
+   unsigned dyn_chans = src->num_components;
+   uint32_t const_bits = 0;
+   while (dyn_chans > 0) {
+      uint32_t bits;
+      if (!scalar_const_bits(nir_get_scalar(src, dyn_chans - 1), &bits) ||
+          isnan(uif(bits)))
+         break;
+
+      const_bits |= (uint32_t)_mesa_float_to_unorm(uif(bits), 8)
+                    << (8 * (dyn_chans - 1));
+      --dyn_chans;
+   }
+
+   if (dyn_chans == src->num_components)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *packed = nir_imm_int(b, const_bits);
+   if (dyn_chans) {
+      /* A pck of fewer than four channels leaves the remaining bytes
+       * undefined, so insert its low bytes rather than ORing it.
+       */
+      /* Build the leading channels from their own sources rather than as
+       * channels of the original vector.
+       */
+      nir_scalar chans[4];
+      for (unsigned c = 0; c < dyn_chans; c++)
+         chans[c] = nir_scalar_chase_movs(nir_get_scalar(src, c));
+
+      packed = nir_bitfield_insert_imm(
+         b,
+         packed,
+         nir_pack_pco(b, nir_vec_scalars(b, chans, dyn_chans), .format = format),
+         0,
+         8 * dyn_chans);
+   }
+
+   nir_def_replace(&intr->def, packed);
+   return true;
+}
+
+/**
+ * \brief Packs only the non-constant leading channels of 8-bit UNORM pixel
+ * outputs and inserts them into the packed bits of the constant trailing ones
+ * (e.g. alpha = 1.0): every packed channel is one issue of the pck
+ * instruction, the insert is a single instruction group.
+ *
+ * \param[in,out] shader NIR shader.
+ * \return True if the pass made progress.
+ */
+bool pco_nir_fold_pack_consts(nir_shader *shader)
+{
+   return nir_shader_intrinsics_pass(shader,
+                                     fold_pack_consts,
+                                     nir_metadata_control_flow,
+                                     NULL);
+}
