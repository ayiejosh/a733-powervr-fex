@@ -185,6 +185,10 @@ typedef struct _pco_binding_data {
 
    /** Whether the descriptor binding is an inline uniform block. */
    bool is_inline_ubo;
+   /** Whether the descriptor binding is a dynamic buffer; the offset word of
+    * other buffer descriptors is always 0.
+    */
+   bool is_dynamic;
 } pco_binding_data;
 
 /** PCO descriptor set data. */
diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index 9f0727c2..98b441b2 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -1284,6 +1284,27 @@ static pco_instr *trans_atomic_shared(trans_ctx *tctx,
    return instr;
 }
 
+/**
+ * \brief Whether a buffer binding is dynamic. Other buffer descriptors have a
+ * zero offset word (see write_buffer()), so adding it can be skipped.
+ */
+static bool binding_is_dynamic(const pco_common_data *common,
+                               uint32_t packed_desc)
+{
+   unsigned desc_set;
+   unsigned binding;
+   pco_unpack_desc(packed_desc, &desc_set, &binding);
+
+   if (desc_set >= ARRAY_SIZE(common->desc_sets))
+      return true;
+
+   const pco_descriptor_set_data *desc_set_data = &common->desc_sets[desc_set];
+   if (!desc_set_data->bindings || binding >= desc_set_data->binding_count)
+      return true;
+
+   return desc_set_data->bindings[binding].is_dynamic;
+}
+
 static pco_instr *trans_load_buffer(trans_ctx *tctx,
                                     nir_intrinsic_instr *intr,
                                     pco_ref dest,
@@ -1376,30 +1397,35 @@ static pco_instr *trans_load_buffer(trans_ctx *tctx,
    pco_ref addr_comps_dyn_off[2];
    pco_ref_new_ssa_addr_comps(tctx->func, addr_comps_dyn_off);
 
-   pco_ref dyn_off_reg = pco_ref_hwreg(sh_index, PCO_REG_CLASS_SHARED);
-   dyn_off_reg = pco_ref_offset(dyn_off_reg, 3);
+   if (binding_is_dynamic(common, packed_desc)) {
+      pco_ref dyn_off_reg = pco_ref_hwreg(sh_index, PCO_REG_CLASS_SHARED);
+      dyn_off_reg = pco_ref_offset(dyn_off_reg, 3);
 
-   if (is_dynidx) {
-      pco_ref dynidx_dyn_off_reg = pco_ref_new_ssa32(tctx->func);
-      pco_dynidx(&tctx->b,
-                 dynidx_dyn_off_reg,
-                 pco_ref_null(),
-                 dyn_off_reg,
-                 pco_ref_null(),
-                 dynidx_elem,
-                 dynidx_stride);
+      if (is_dynidx) {
+         pco_ref dynidx_dyn_off_reg = pco_ref_new_ssa32(tctx->func);
+         pco_dynidx(&tctx->b,
+                    dynidx_dyn_off_reg,
+                    pco_ref_null(),
+                    dyn_off_reg,
+                    pco_ref_null(),
+                    dynidx_elem,
+                    dynidx_stride);
 
-      dyn_off_reg = dynidx_dyn_off_reg;
-   }
+         dyn_off_reg = dynidx_dyn_off_reg;
+      }
 
-   pco_add64_32(&tctx->b,
-                addr_comps_dyn_off[0],
-                addr_comps_dyn_off[1],
-                addr_comps[0],
-                addr_comps[1],
-                dyn_off_reg,
-                pco_ref_null(),
-                .s = true);
+      pco_add64_32(&tctx->b,
+                   addr_comps_dyn_off[0],
+                   addr_comps_dyn_off[1],
+                   addr_comps[0],
+                   addr_comps[1],
+                   dyn_off_reg,
+                   pco_ref_null(),
+                   .s = true);
+   } else {
+      addr_comps_dyn_off[0] = addr_comps[0];
+      addr_comps_dyn_off[1] = addr_comps[1];
+   }
 
    pco_ref addr = pco_ref_new_ssa_addr(tctx->func);
    pco_vec(&tctx->b, addr, ARRAY_SIZE(addr_comps_dyn_off), addr_comps_dyn_off);
@@ -1606,30 +1632,35 @@ static pco_instr *trans_store_buffer(trans_ctx *tctx,
    };
    pco_ref_new_ssa_addr_comps(tctx->func, addr_data_comps_dyn_off);
 
-   pco_ref dyn_off_reg = pco_ref_hwreg(sh_index, PCO_REG_CLASS_SHARED);
-   dyn_off_reg = pco_ref_offset(dyn_off_reg, 3);
+   if (binding_is_dynamic(common, packed_desc)) {
+      pco_ref dyn_off_reg = pco_ref_hwreg(sh_index, PCO_REG_CLASS_SHARED);
+      dyn_off_reg = pco_ref_offset(dyn_off_reg, 3);
 
-   if (is_dynidx) {
-      pco_ref dynidx_dyn_off_reg = pco_ref_new_ssa32(tctx->func);
-      pco_dynidx(&tctx->b,
-                 dynidx_dyn_off_reg,
-                 pco_ref_null(),
-                 dyn_off_reg,
-                 pco_ref_null(),
-                 dynidx_elem,
-                 dynidx_stride);
+      if (is_dynidx) {
+         pco_ref dynidx_dyn_off_reg = pco_ref_new_ssa32(tctx->func);
+         pco_dynidx(&tctx->b,
+                    dynidx_dyn_off_reg,
+                    pco_ref_null(),
+                    dyn_off_reg,
+                    pco_ref_null(),
+                    dynidx_elem,
+                    dynidx_stride);
 
-      dyn_off_reg = dynidx_dyn_off_reg;
-   }
+         dyn_off_reg = dynidx_dyn_off_reg;
+      }
 
-   pco_add64_32(&tctx->b,
-                addr_data_comps_dyn_off[0],
-                addr_data_comps_dyn_off[1],
-                addr_comps[0],
-                addr_comps[1],
-                dyn_off_reg,
-                pco_ref_null(),
-                .s = true);
+      pco_add64_32(&tctx->b,
+                   addr_data_comps_dyn_off[0],
+                   addr_data_comps_dyn_off[1],
+                   addr_comps[0],
+                   addr_comps[1],
+                   dyn_off_reg,
+                   pco_ref_null(),
+                   .s = true);
+   } else {
+      addr_data_comps_dyn_off[0] = addr_comps[0];
+      addr_data_comps_dyn_off[1] = addr_comps[1];
+   }
 
    pco_ref addr_data = pco_ref_new_ssa_addr_data(tctx->func, chans);
    pco_vec(&tctx->b,
@@ -1740,30 +1771,35 @@ static pco_instr *trans_atomic_buffer(trans_ctx *tctx,
    };
    pco_ref_new_ssa_addr_comps(tctx->func, addr_data_comps_dyn_off);
 
-   pco_ref dyn_off_reg = pco_ref_hwreg(sh_index, PCO_REG_CLASS_SHARED);
-   dyn_off_reg = pco_ref_offset(dyn_off_reg, 3);
+   if (binding_is_dynamic(common, packed_desc)) {
+      pco_ref dyn_off_reg = pco_ref_hwreg(sh_index, PCO_REG_CLASS_SHARED);
+      dyn_off_reg = pco_ref_offset(dyn_off_reg, 3);
 
-   if (is_dynidx) {
-      pco_ref dynidx_dyn_off_reg = pco_ref_new_ssa32(tctx->func);
-      pco_dynidx(&tctx->b,
-                 dynidx_dyn_off_reg,
-                 pco_ref_null(),
-                 dyn_off_reg,
-                 pco_ref_null(),
-                 dynidx_elem,
-                 dynidx_stride);
+      if (is_dynidx) {
+         pco_ref dynidx_dyn_off_reg = pco_ref_new_ssa32(tctx->func);
+         pco_dynidx(&tctx->b,
+                    dynidx_dyn_off_reg,
+                    pco_ref_null(),
+                    dyn_off_reg,
+                    pco_ref_null(),
+                    dynidx_elem,
+                    dynidx_stride);
 
-      dyn_off_reg = dynidx_dyn_off_reg;
-   }
+         dyn_off_reg = dynidx_dyn_off_reg;
+      }
 
-   pco_add64_32(&tctx->b,
-                addr_data_comps_dyn_off[0],
-                addr_data_comps_dyn_off[1],
-                addr_comps[0],
-                addr_comps[1],
-                dyn_off_reg,
-                pco_ref_null(),
-                .s = true);
+      pco_add64_32(&tctx->b,
