 src/imagination/pco/pco_trans_nir.c        | 162 +++++++++++++--------
 src/imagination/vulkan/pvr_arch_pipeline.c |   1 +
 3 files changed, 104 insertions(+), 63 deletions(-)

diff --git a/src/imagination/pco/pco_data.h b/src/imagination/pco/pco_data.h
