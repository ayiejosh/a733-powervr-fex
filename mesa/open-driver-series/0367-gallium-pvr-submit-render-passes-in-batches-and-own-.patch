+/* Is the render with this sequence number still in flight (its slot not yet waited)? */
+static bool
+draw_render_pending(struct pvr_draw_state *d, uint32_t seq)
+{
+   for (unsigned i = 0; seq != 0 && i < PVR_DRAW_SLOTS; i++) {
+      if (d->slots[i].sync != 0 && d->slots[i].seq == seq)
+         return true;
+   }
+   return false;
+}
+
+/* Maximum HWRT data sets kept for one target size. Each data set is double buffered internally (the
+ * two RTA data indices), so two data sets give a four-render pipeline; keeping at least two per size
+ * is what lets the CPU run ahead instead of waiting for the previous render's data set. */
+#define PVR_DRAW_HWRT_SETS_PER_SIZE 2
+
