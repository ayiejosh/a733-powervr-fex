@@ -1368,14 +1419,14 @@ draw_open(struct pvr_context *ctx, struct pvr_draw_state *d, struct pipe_resourc
       const uint32_t prev = e->data_seq[e->rt_data_idx];
       for (unsigned i = 0; prev != 0 && i < PVR_DRAW_SLOTS; i++) {
          if (d->slots[i].sync != 0 && d->slots[i].seq == prev)
-            draw_slot_idle(draw_screen(ctx), &d->slots[i]);
