-      case PVR_BUFFER_TYPE_UBO_PRELOAD: {
+      case PVR_BUFFER_TYPE_UBO_PRELOAD:
+      case PVR_BUFFER_TYPE_DESC_CHECKS: {
          struct pvr_const_map_entry_special_buffer *special_buffer_entry;
 
          special_buffer_entry =
diff --git a/src/imagination/vulkan/pvr_arch_cmd_buffer.c b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
index 3c399aa..d431f4f 100644
--- a/src/imagination/vulkan/pvr_arch_cmd_buffer.c
+++ b/src/imagination/vulkan/pvr_arch_cmd_buffer.c
@@ -5760,6 +5760,67 @@ pvr_setup_vertex_buffers(struct pvr_cmd_buffer *cmd_buffer,
 static VkResult pvr_cmd_upload_push_consts(struct pvr_cmd_buffer *cmd_buffer,
                                            enum pvr_stage_allocation stage);
 
+static const struct pvr_buffer_descriptor *
+pvr_bound_buffer_descriptor(const struct pvr_descriptor_set *set,
+                            unsigned binding_idx,
+                            unsigned elem)
+{
+   const struct pvr_descriptor_set_layout_binding *binding =
+      &set->layout->bindings[binding_idx];
+
+   if (binding->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC)
+      return &set->dynamic_buffers[binding->dynamic_buffer_idx + elem];
+
+   return (const struct pvr_buffer_descriptor *)((const uint8_t *)set->mapping +
+                                                 binding->offset +
+                                                 elem * binding->stride);
+}
+
+/* Makes the descriptor checks of a shader (see pco_desc_check) for the
+ * descriptors bound now: returns whether any fails, so that the shader takes
+ * its checked path.
+ */
+static bool pvr_desc_checks_fail(const struct pvr_descriptor_state *desc_state,
+                                 const pco_common_data *common)
+{
+   for (unsigned u = 0; u < common->num_desc_checks; u++) {
+      const pco_desc_check *check = &common->desc_checks[u];
+      const struct pvr_descriptor_set *set = desc_state->sets[check->desc_set];
+      if (!set)
+         return true;
+
+      if (check->ubo) {
+         const struct pvr_buffer_descriptor *desc =
+            pvr_bound_buffer_descriptor(set, check->binding, check->elem);
+         if (desc->size < check->ubo_end)
+            return true;
+
+         continue;
+      }
+
+      /* As the shader's is_null_descriptor: all dwords zero. */
+      const pco_binding_data *binding_data =
+         &common->desc_sets[check->desc_set].bindings[check->binding];
+      const unsigned dwords = binding_data->is_img_smp
+                                 ? ROGUE_NUM_TEXSTATE_DWORDS
+                                 : binding_data->range.stride;
+      const struct pvr_descriptor_set_layout_binding *binding =
+         &set->layout->bindings[check->binding];
+      const uint32_t *words =
+         (const uint32_t *)((const uint8_t *)set->mapping + binding->offset +
+                            check->elem * binding->stride);
+
+      bool null = true;
+      for (unsigned i = 0; i < dwords; i++)
+         null &= !words[i];
+
+      if (null)
+         return true;
+   }
+
+   return false;
+}
+
 /* Where the descriptor upload program copies a uniform buffer range from
  * (see pco_ubo_preload): the buffer, or zeros if the descriptor is null or
  * too small for the range, in which case a bounds checked shader takes the
@@ -5776,17 +5837,8 @@ pvr_ubo_preload_addr(const struct pvr_cmd_buffer *cmd_buffer,
    if (!set)
       return zeros;
 
-   const struct pvr_descriptor_set_layout_binding *binding =
-      &set->layout->bindings[preload->binding];
-   const struct pvr_buffer_descriptor *desc;
-   if (binding->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC) {
-      desc = &set->dynamic_buffers[binding->dynamic_buffer_idx + preload->elem];
-   } else {
-      desc = (const struct pvr_buffer_descriptor *)((const uint8_t *)set->mapping +
-                                                    binding->offset +
-                                                    preload->elem *
-                                                       binding->stride);
-   }
+   const struct pvr_buffer_descriptor *desc =
+      pvr_bound_buffer_descriptor(set, preload->binding, preload->elem);
 
    const uint64_t end =
       (uint64_t)(preload->offset + preload->count) * sizeof(uint32_t);
@@ -5898,6 +5950,24 @@ static VkResult pvr_setup_descriptor_mappings(
             (struct pvr_const_map_entry_special_buffer *)entries;
 
          switch (special_buff_entry->buffer_type) {
+         case PVR_BUFFER_TYPE_DESC_CHECKS: {
+            const uint32_t fail = pvr_desc_checks_fail(desc_state, &data->common);
+            struct pvr_suballoc_bo *fail_bo;
+
+            result = pvr_arch_cmd_buffer_upload_general(cmd_buffer,
+                                                        &fail,
+                                                        sizeof(fail),
+                                                        &fail_bo);
+            if (result != VK_SUCCESS)
+               return result;
+
+            PVR_WRITE(qword_buffer,
+                      fail_bo->dev_addr.addr,
+                      special_buff_entry->const_offset,
+                      pds_info->data_size_in_dwords);
+            break;
+         }
+
          case PVR_BUFFER_TYPE_UBO_PRELOAD: {
             const pco_ubo_preload *preload =
                &data->common.ubo_preloads[special_buff_entry->buffer_index];
diff --git a/src/imagination/vulkan/pvr_arch_pipeline.c b/src/imagination/vulkan/pvr_arch_pipeline.c
index 283cb27..613988f 100644
--- a/src/imagination/vulkan/pvr_arch_pipeline.c
+++ b/src/imagination/vulkan/pvr_arch_pipeline.c
@@ -584,6 +584,14 @@ static VkResult pvr_pds_descriptor_program_create_and_upload(
       };
    }
 
+   if (data->common.num_desc_checks) {
+      program.buffers[program.buffer_count++] = (struct pvr_pds_buffer){
+         .type = PVR_BUFFER_TYPE_DESC_CHECKS,
+         .size_in_dwords = 1,
+         .destination = data->common.desc_checks_reg,
+      };
+   }
+
    for (unsigned u = 0; u < data->common.num_ubo_preloads; u++) {
       program.buffers[program.buffer_count++] = (struct pvr_pds_buffer){
          .type = PVR_BUFFER_TYPE_UBO_PRELOAD,
@@ -2932,6 +2940,9 @@ static void pvr_postprocess_shader_data(pco_data *data,
       data->common.shareds += data->common.ubo_preloads[u].count;
    }
 
+   if (data->common.num_desc_checks)
+      data->common.desc_checks_reg = data->common.shareds++;
+
    /* TODO: common things, like large constants being put into shareds. */
 }
 
