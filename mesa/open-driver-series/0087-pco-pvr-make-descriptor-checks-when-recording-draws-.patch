diff --git a/src/imagination/pco/pco_data.h b/src/imagination/pco/pco_data.h
index 8b9d43a..31e0b14 100644
--- a/src/imagination/pco/pco_data.h
+++ b/src/imagination/pco/pco_data.h
@@ -234,6 +234,18 @@ typedef struct _pco_ubo_preload {
 
 #define PCO_MAX_UBO_PRELOADS 4
 
+/** A descriptor check the driver makes when it records a draw, instead of
+ * the shader at every invocation (see pco_nir_version_descriptor_checks()).
+ */
+typedef struct _pco_desc_check {
+   uint16_t desc_set;
+   uint16_t binding;
+   uint16_t elem;
+   bool ubo; /** UBO size check; otherwise a null descriptor check. */
+   uint32_t ubo_end; /** Fails if the UBO is smaller than this (bytes). */
+} pco_desc_check;
+
+#define PCO_MAX_DESC_CHECKS 8
 typedef struct _pco_common_data {
    /** System value mappings. */
    pco_range sys_vals[SYSTEM_VALUE_MAX];
@@ -270,6 +282,11 @@ typedef struct _pco_common_data {
    pco_ubo_preload ubo_preloads[PCO_MAX_UBO_PRELOADS];
    unsigned num_ubo_preloads;
 
+   pco_desc_check desc_checks[PCO_MAX_DESC_CHECKS];
+   unsigned num_desc_checks;
+   /** Shared register the driver sets to whether any desc_checks failed. */
+   unsigned desc_checks_reg;
+
    unsigned entry_offset; /** Offset of the shader entrypoint. */
 
    struct {
diff --git a/src/imagination/pco/pco_internal.h b/src/imagination/pco/pco_internal.h
