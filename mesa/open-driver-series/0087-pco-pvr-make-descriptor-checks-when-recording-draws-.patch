 #define PVR_BUFFER_TYPE_SAMPLE_LOCATIONS (14)
 #define PVR_BUFFER_TYPE_GLOBAL_SHMEM (15)
 #define PVR_BUFFER_TYPE_UBO_PRELOAD (16)
+#define PVR_BUFFER_TYPE_DESC_CHECKS (17)
 #define PVR_BUFFER_TYPE_INVALID (~0)
 
 struct pvr_pds_buffer {
diff --git a/src/imagination/vulkan/pds/pvr_pipeline_pds.c b/src/imagination/vulkan/pds/pvr_pipeline_pds.c
index 3027d89..a426901 100644
--- a/src/imagination/vulkan/pds/pvr_pipeline_pds.c
+++ b/src/imagination/vulkan/pds/pvr_pipeline_pds.c
