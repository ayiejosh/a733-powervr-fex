+            pvr_image_view_from_handle(ds[i].src->resolveImageView)->vk.image;
+      }
+   }
+
+   if (state->pending_clear_count) {
+      bool consumed[PVR_MAX_PENDING_CLEARS] = { false };
+      uint32_t match[PVR_MAX_PENDING_CLEARS];
+      bool conflict = false;
+
+      for (uint32_t e = 0; e < state->pending_clear_count && !conflict; e++) {
+         const struct pvr_pending_clear *pc = &state->pending_clears[e];
+         bool image_used = false;
+
+         for (uint32_t r = 0; r < num_resolve; r++)
+            conflict |= resolve_images[r] == pc->iview->vk.image;
+
+         for (uint32_t a = 0; a < num_atts; a++) {
+            if (atts[a].iview->vk.image != pc->iview->vk.image)
+               continue;
+
+            image_used = true;
+            if (simple_pass &&
+                pvr_attachment_layout_is_plain(atts[a].info->imageLayout) &&
+                pvr_attachment_ops_allow_fold(atts[a].info) &&
+                pvr_pending_clear_same_target(pc, atts[a].iview, atts[a].aspect) &&
+                pvr_rect_equal(&pc->area, &info->renderArea) &&
+                pvr_view_area_is_whole(atts[a].iview, &info->renderArea)) {
+               consumed[e] = true;
+               match[e] = a;
+            }
+         }
+
+         conflict |= image_used && !consumed[e];
+      }
+
+      if (conflict) {
+         pvr_clear_fold_flush(cmd_buffer);
+         return info;
+      }
+
+      uint32_t kept = 0;
+      for (uint32_t e = 0; e < state->pending_clear_count; e++) {
+         if (!consumed[e]) {
+            state->pending_clears[kept++] = state->pending_clears[e];
+            continue;
+         }
+
+         state->consumed_clears[state->consumed_clear_count] =
+            state->pending_clears[e];
+         state->consumed_clears[state->consumed_clear_count++].read = false;
+
+         VkRenderingAttachmentInfo *att = atts[match[e]].info;
+         if (att->loadOp == VK_ATTACHMENT_LOAD_OP_LOAD) {
+            att->loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            att->clearValue = state->pending_clears[e].clear_value;
+            rewritten = true;
+         }
+      }
+      state->pending_clear_count = kept;
+
+      /* Draws of these passes cannot be scanned: secondary command buffers,
+       * multiview, suspend/resume.
+       */
+      if (!simple_pass)
+         pvr_clear_fold_flush(cmd_buffer);
+   }
+
+   /* Can this pass be held back if it turns out to draw nothing? */
+   bool candidate = simple_pass && num_atts > 0 && !num_resolve &&
+                    num_atts <= PVR_MAX_PENDING_CLEARS;
+   for (uint32_t a = 0; candidate && a < num_atts; a++) {
+      candidate &= atts[a].info->loadOp == VK_ATTACHMENT_LOAD_OP_CLEAR &&
+                   atts[a].info->storeOp == VK_ATTACHMENT_STORE_OP_STORE &&
+                   pvr_view_area_is_whole(atts[a].iview, &info->renderArea);
+   }
+   if (candidate) {
+      for (uint32_t a = 0; a < num_atts; a++) {
+         state->candidate_clears[a] = (struct pvr_pending_clear){
+            .iview = atts[a].iview,
+            .aspect = atts[a].aspect,
+            .layout = atts[a].info->imageLayout,
+            .clear_value = atts[a].info->clearValue,
+            .area = info->renderArea,
+         };
+      }
+      state->candidate_clear_count = num_atts;
+   }
+
+   return rewritten ? local_info : info;
+}
