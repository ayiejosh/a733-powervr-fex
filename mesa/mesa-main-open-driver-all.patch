+bool
+pvr_csb_emit_sampler_desc(struct pvr_csb *csb, const struct pvr_sampler_desc *desc)
+{
+   const uint32_t words = ROGUE_TEXSTATE_SAMPLER_WORD0_length +
+                          ROGUE_TEXSTATE_SAMPLER_WORD1_length;
+   struct ROGUE_TEXSTATE_SAMPLER_WORD0 word0 = {
+      /* Never assigned by the reference, so 0 is what every sampler it creates carries. */
+      .cmp_mode = ROGUE_TEXSTATE_CMP_MODE_NEVER,
+      .mipfilter = desc->mip_filter,
+      /* Zero adjustment: DADJUST_ZERO_UINT is the encoding of 0.0, not an absent value. */
+      .dadjust = ROGUE_TEXSTATE_DADJUST_ZERO_UINT,
+      .anisoctl = desc->anisoctl,
+      .bordercolor_index = desc->bordercolor_index,
+      .non_normalized_coords = false,
+      .lumakey = false,
+      .lumakey_alphamult = false,
+   };
+   struct ROGUE_TEXSTATE_SAMPLER_WORD1 word1 = { 0 };
+   uint32_t *dw;
+
+   if (!pvr_addrmode_from_pipe(desc->wrap_s, &word0.addrmode_u) ||
+       !pvr_addrmode_from_pipe(desc->wrap_t, &word0.addrmode_v) ||
+       !pvr_addrmode_from_pipe(desc->wrap_r, &word0.addrmode_w) ||
+       !pvr_filter_from_pipe(desc->min_filter, &word0.minfilter) ||
+       !pvr_filter_from_pipe(desc->mag_filter, &word0.magfilter)) {
+      mesa_loge("pvr: sampler state has no hardware equivalent");
+      return false;
+   }
+
+   /* Clamped then encoded, in that order, as the reference does - the encoding of an
+    * out-of-range float would wrap rather than saturate. */
+   /* CLAMP_MAX is the field maximum in fixed point, so the clamp in LOD units divides it by the
+    * fraction, as the reference does. Clamping to the raw maximum let GL's default max LOD
+    * (1000) overflow the 10-bit field into the anisotropy and filter bits. */
+   const float lod_clamp_max =
+      (float)ROGUE_TEXSTATE_CLAMP_MAX / (1 << ROGUE_TEXSTATE_CLAMP_FRACTIONAL_BITS);
+   word0.minlod = util_unsigned_fixed(CLAMP(desc->min_lod, 0.0f, lod_clamp_max),
+                                      ROGUE_TEXSTATE_CLAMP_FRACTIONAL_BITS);
+   word0.maxlod = util_unsigned_fixed(CLAMP(desc->max_lod, 0.0f, lod_clamp_max),
+                                      ROGUE_TEXSTATE_CLAMP_FRACTIONAL_BITS);
+
+   dw = pvr_csb_emit(csb, words);
+   if (dw == NULL)
+      return false;
+
+   ROGUE_TEXSTATE_SAMPLER_WORD0_pack(dw, &word0);
+   ROGUE_TEXSTATE_SAMPLER_WORD1_pack(dw + ROGUE_TEXSTATE_SAMPLER_WORD0_length, &word1);
+
+   return true;
+}
+
+bool
+pvr_cmp_mode_from_pipe(enum pipe_compare_func func, enum ROGUE_TEXSTATE_CMP_MODE *out)
+{
+   switch (func) {
+   case PIPE_FUNC_NEVER:    *out = ROGUE_TEXSTATE_CMP_MODE_NEVER; return true;
+   case PIPE_FUNC_LESS:     *out = ROGUE_TEXSTATE_CMP_MODE_LESS; return true;
+   case PIPE_FUNC_EQUAL:    *out = ROGUE_TEXSTATE_CMP_MODE_EQUAL; return true;
+   case PIPE_FUNC_LEQUAL:   *out = ROGUE_TEXSTATE_CMP_MODE_LESSEQUAL; return true;
+   case PIPE_FUNC_GREATER:  *out = ROGUE_TEXSTATE_CMP_MODE_GREATER; return true;
+   case PIPE_FUNC_GEQUAL:   *out = ROGUE_TEXSTATE_CMP_MODE_GREATEREQUAL; return true;
+   case PIPE_FUNC_NOTEQUAL: *out = ROGUE_TEXSTATE_CMP_MODE_NOTEQUAL; return true;
+   case PIPE_FUNC_ALWAYS:   *out = ROGUE_TEXSTATE_CMP_MODE_ALWAYS; return true;
+   default:
+      return false;
+   }
+}
+
+bool
+pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc)
+{
+   const uint32_t words = ROGUE_TEXSTATE_IMAGE_WORD0_length +
+                          (desc->twiddled ? ROGUE_TEXSTATE_IMAGE_WORD1_length
+                                          : ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1_length);
+   struct ROGUE_TEXSTATE_IMAGE_WORD0 word0 = {
+      .textype = desc->cube ? ROGUE_TEXSTATE_TEXTYPE_CUBE
+                : desc->twiddled ? ROGUE_TEXSTATE_TEXTYPE_2D
+                                 : ROGUE_TEXSTATE_TEXTYPE_STRIDE,
+      .texformat = desc->components,
+      .width = desc->width - 1,
+      .height = desc->height - 1,
+      .smpcnt = 0,
+      .minlod = 0,
+      .texformat_compressed = 0,
+      .twocomp_gamma = 0,
+      /* sRGB images are decoded to linear by the TPU; the reference sets the same bit for sRGB
+       * formats (pvr_arch_tex_state's "Gamma" block). */
+      .gamma = desc->gamma ? ROGUE_TEXSTATE_GAMMA_ON : ROGUE_TEXSTATE_GAMMA_OFF,
+   };
+   struct ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1 word1 = {
+      .stride = desc->stride - 1,
+      .texaddr = desc->addr,
+      .num_mip_levels = 0,
+      .mipmaps_present = false,
+      .alpha_msb = desc->alpha_msb,
+      .tile_size = false,
+      .index_lookup = false,
+      .frame_buffer_compression = false,
+      .frame_buffer_compression_addressing_mode = false,
+   };
+   /* Twiddled (and possibly TFBC-compressed) images use the generic image word1: there is no
+    * TEXSTATE_TEXTYPE for twiddled, the 2D type plus this word selects the twiddled decode. */
+   struct ROGUE_TEXSTATE_IMAGE_WORD1 word1_tw = {
+      .texaddr = desc->addr,
+      /* Level count, like the Vulkan driver (0 is not "one level" here). */
+      .num_mip_levels = MAX2(desc->num_levels, 1),
+      .mipmaps_present = desc->num_levels > 1,
+      .baselevel = desc->base_level,
+      /* Cube: the face count goes in the array-layer field (faces - 1, the reference's rule). */
+      .depth = desc->layers > 0 ? desc->layers - 1 : 0,
+      .alpha_msb = desc->alpha_msb,
+      .border = false,
+      .frame_buffer_compression = false,
+      .frame_buffer_compression_addressing_mode = false,
+      .tpu_image_state_v2_compression_mode =
+         desc->fbc ? ROGUE_TEXSTATE_COMPRESSION_MODE_FB_DIRECT_8X8
+                   : ROGUE_TEXSTATE_COMPRESSION_MODE_NONE,
+   };
+   uint32_t *dw;
+
+   if (desc->width < 1 || desc->height < 1 || desc->stride < 1) {
+      mesa_loge("pvr: texture descriptor with a zero extent (w %u h %u stride %u) - the "
+                "hardware stores value-minus-one", desc->width, desc->height, desc->stride);
+      return false;
+   }
+
+   for (unsigned c = 0; c < 4; c++) {
+      if (!pvr_swizzle_from_pipe(desc->swizzle[c],
+                                 c == 0 ? &word0.swiz0 : c == 1 ? &word0.swiz1 :
+                                 c == 2 ? &word0.swiz2 : &word0.swiz3)) {
+         mesa_loge("pvr: channel %u has no hardware swizzle (%u)", c, desc->swizzle[c]);
+         return false;
+      }
+   }
+
+   if (getenv("PVR_TEXDBG") != NULL)
+      fprintf(stderr, "TEXDBG comp=%u swiz=%u,%u,%u,%u gamma=%d tw=%d w=%u h=%u\n",
+              (unsigned)desc->components, desc->swizzle[0], desc->swizzle[1], desc->swizzle[2],
+              desc->swizzle[3], (int)desc->gamma, desc->twiddled, desc->width, desc->height);
+
+   dw = pvr_csb_emit(csb, words);
+   if (dw == NULL)
+      return false;
+
+   ROGUE_TEXSTATE_IMAGE_WORD0_pack(dw, &word0);
+   if (desc->twiddled)
+      ROGUE_TEXSTATE_IMAGE_WORD1_pack(dw + ROGUE_TEXSTATE_IMAGE_WORD0_length, &word1_tw);
+   else
+      ROGUE_TEXSTATE_STRIDE_IMAGE_WORD1_pack(dw + ROGUE_TEXSTATE_IMAGE_WORD0_length, &word1);
+
+   return true;
+}
