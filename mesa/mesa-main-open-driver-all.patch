+static void
+pvr_set_constant_buffer(struct pipe_context *pctx, mesa_shader_stage shader, uint index,
+                        const struct pipe_constant_buffer *buf)
+{
+   struct pvr_context *ctx = pvr_context(pctx);
+   struct pipe_constant_buffer *cb;
+
+   if (index != 0 || (shader != MESA_SHADER_VERTEX && shader != MESA_SHADER_FRAGMENT))
+      return;
+   cb = &ctx->cb0[shader == MESA_SHADER_FRAGMENT];
+   if (buf == NULL) {
+      pipe_resource_reference(&cb->buffer, NULL);
+      memset(cb, 0, sizeof(*cb));
+      return;
+   }
+   pipe_resource_reference(&cb->buffer, buf->buffer);
+   cb->buffer_offset = buf->buffer_offset;
+   cb->buffer_size = buf->buffer_size;
+   cb->user_buffer = buf->user_buffer;
+}
+
+static void
+pvr_set_vertex_buffers(struct pipe_context *pctx, unsigned count,
+                       const struct pipe_vertex_buffer *buffers)
+{
+   struct pvr_context *ctx = pvr_context(pctx);
+
+   assert(count <= ARRAY_SIZE(ctx->vertex_buffers));
+
+   for (unsigned i = 0; i < count; i++) {
+      const bool old_is_user = ctx->vertex_buffers[i].is_user_buffer;
+      const bool new_is_user = buffers[i].is_user_buffer;
+      struct pipe_resource **slot = &ctx->vertex_buffers[i].buffer.resource;
+
+      /* All four transitions are distinct, and getting one wrong is silent:
+       *   resource -> resource  must take the new reference AND release the old
+       *   resource -> user      must release the old, or it leaks per bind
+       *   user -> resource      must take the new, or the buffer is freed while named
+       *   user -> user          is a plain copy, and referencing would read a client pointer
+       *   as a resource
+       *
+       * pipe_resource_reference both takes the new and releases whatever dst currently holds,
+       * so dst must still hold the OLD pointer when it is called. The first version of this
+       * assigned the whole struct first, which put the NEW pointer in dst and made the helper
+       * release the reference it had just been asked to take - the count fell to zero while the
+       * state still named the buffer. That corrupted the heap, and the corruption surfaced
+       * several checks later in an unrelated malloc. */
+      if (!old_is_user && !new_is_user) {
+         ctx->vertex_buffers[i].is_user_buffer = false;
+         ctx->vertex_buffers[i].buffer_offset = buffers[i].buffer_offset;
+         pipe_resource_reference(slot, buffers[i].buffer.resource);
+      } else if (!old_is_user && new_is_user) {
+         pipe_resource_reference(slot, NULL);
+         ctx->vertex_buffers[i] = buffers[i];
+      } else if (old_is_user && !new_is_user) {
+         /* Discard the client pointer BEFORE the helper runs, or it would be dereferenced as a
+          * resource. Setting the union to NULL gives the helper nothing to release and the new
+          * reference to take, which is exactly this transition. */
+         ctx->vertex_buffers[i].buffer.resource = NULL;
+         ctx->vertex_buffers[i].is_user_buffer = false;
+         ctx->vertex_buffers[i].buffer_offset = buffers[i].buffer_offset;
+         pipe_resource_reference(slot, buffers[i].buffer.resource);
+      } else {
+         ctx->vertex_buffers[i] = buffers[i];
+      }
+   }
+
+   /* Slots above the new count are released and cleared, not left holding a stale pointer that
+    * anything walking the array would read as live. */
+   for (unsigned i = count; i < ctx->nr_vertex_buffers; i++) {
+      if (!ctx->vertex_buffers[i].is_user_buffer)
+         pipe_resource_reference(&ctx->vertex_buffers[i].buffer.resource, NULL);
+
+      ctx->vertex_buffers[i] = (struct pipe_vertex_buffer){ 0 };
+   }
+
+   ctx->nr_vertex_buffers = count;
+}
+
+/* The draw path. Records, does not execute - see the note in the header.
+ *
+ * The first one logs loudly and once per context, because a driver that silently accepts draws it
+ * cannot perform is the worst of the available behaviours: an application would see no error and no
+ * picture, and would have nothing to report against. */
+/* Collects the three clip-space vertices for the compute fallback: from the bound vertex buffer when
+ * there is one, otherwise a triangle that fills the middle of the target the way the fallback's first
+ * version did. w is filled as 1: the fallback's vertex stage writes gl_Position = vec4(pos, 1). */
+static void
+pvr_collect_draw_vertices(struct pvr_context *ctx, float v[12])
+{
+   static const float fallback[12] = {
+      -0.75f, 0.75f, 0.0f, 1.0f,
+      0.75f,  0.75f, 0.0f, 1.0f,
+      0.0f,  -0.75f, 0.0f, 1.0f,
+   };
+
+   memcpy(v, fallback, sizeof(fallback));
+   if (ctx->nr_vertex_buffers > 0 && ctx->vertex_buffers[0].buffer.resource != NULL) {
+      struct pvr_resource *vb = pvr_resource(ctx->vertex_buffers[0].buffer.resource);
+      struct pvr_screen *screen = pvr_screen(ctx->base.screen);
+      /* The fallback's vertex stage consumes vec3 positions: this Mesa's pipe_vertex_buffer has no
+       * stride field, so the fallback fixes it at one vec3. */
+      unsigned stride = 3 * sizeof(float);
+      uint64_t base = ctx->vertex_buffers[0].buffer_offset;
+
+      if (vb->bo.map == NULL)
+         pvr_bo_map(screen->fd, &vb->bo);
+      if (vb->bo.map != NULL && base + 2 * stride + 3 * sizeof(float) <= vb->bo.size) {
+         for (unsigned i = 0; i < 3; i++) {
+            const float *p = (const float *)((const uint8_t *)vb->bo.map + base + i * stride);
+
+            v[i * 4 + 0] = p[0];
+            v[i * 4 + 1] = p[1];
+            v[i * 4 + 2] = p[2];
+            v[i * 4 + 3] = 1.0f;
+         }
+      }
+   }
+}
+
+static void
+pvr_draw_vbo(struct pipe_context *pctx, const struct pipe_draw_info *info,
+             UNUSED unsigned drawid_offset, const struct pipe_draw_indirect_info *indirect,
+             const struct pipe_draw_start_count_bias *draws, unsigned num_draws)
+{
+   struct pvr_context *ctx = pvr_context(pctx);
+
+   ctx->draws_received++;
+   ctx->last_draw.mode = (unsigned)info->mode;
+   ctx->last_draw.count = num_draws > 0 ? draws[0].count : 0;
+   ctx->last_draw.start = num_draws > 0 ? draws[0].start : 0;
+   ctx->last_draw.index_size = info->index_size;
+   ctx->last_draw.instance_count = info->instance_count;
+   ctx->last_draw.num_draws = num_draws;
+
+   /* The TA/3D path for the state it supports; the compute fallback for the rest. */
+   if (indirect == NULL && pvr_draw_3d(ctx, info, draws, num_draws)) {
+      ctx->draws_executed++;
+      return;
+   }
+   /* Execute the draw through the compute fallback: rasterise the vertex stage's triangle into the bound
+    * colour buffer. */
+   if (ctx->fb.nr_cbufs > 0 && ctx->fb.cbufs[0].texture != NULL) {
+      struct pvr_resource *rt = pvr_resource(ctx->fb.cbufs[0].texture);
+      float vertices[12];
+
+      pvr_collect_draw_vertices(ctx, vertices);
+      if (pvr_compute_render_triangle(ctx, rt, vertices)) {
+         ctx->draws_executed++;
+         return;
+      }
+   }
+
+   if (!ctx->warned_draws_not_executed) {
+      ctx->warned_draws_not_executed = true;
+      mesa_logw("pvr: draw received (mode %u, %u vertices, %u instance(s)) but this driver has no "
+                "working draw path for the bound state yet - NOTHING WILL BE DRAWN. Further draws "
+                "are recorded silently.",
+                (unsigned)info->mode, ctx->last_draw.count, info->instance_count);
+   }
+
+   /* Indirect draws would need the arguments read back from a buffer, which needs a submission path
+    * this driver does not have. Recorded so the gap is visible in the count rather than assumed
+    * absent. */
+   if (indirect != NULL && !ctx->last_draw.num_draws)
+      ctx->last_draw.num_draws = 0;
+}
