+      .slcmode = PDSC_SLC_MODE_LD_CACHED,
+      .ccpri = 0,
+      .ccslc = PDSC_CCSLC_LD_NORMAL,
+      .ccmcu = PDSC_CCMCU_LD_NORMAL,
+      .dest = pdsc_load_ref(*draw_program,
