+                           .wclampen = true,
+                        };
+                        const struct pvr_ta_output_sel outsel = {
+                           .vtxsize = g_vs_vtxouts,
+                           .psprite_size_pres = true,
+                        };
+                        struct pvr_region_clip clip;
+                        /* Round-22: override the fragment PDS program pointer in the TA block, to
+                         * test whether the TA kick is validating/using it. */
+                        const uint64_t ta_shader_base =
+                           getenv("PVR_PROBE_TA_SHADER") ? strtoull(getenv("PVR_PROBE_TA_SHADER"),
+                                                                   NULL, 0)
+                                                         : g_fs_pds_base_offset;
+                        const uint64_t pds_tex_base =
+                           getenv("PVR_PROBE_PDS_TEX") ? strtoull(getenv("PVR_PROBE_PDS_TEX"),
+                                                                 NULL, 0)
+                                                       : 0;
+                        const uint64_t pds_uni_base =
+                           getenv("PVR_PROBE_PDS_UNI") ? strtoull(getenv("PVR_PROBE_PDS_UNI"),
+                                                                 NULL, 0)
+                                                       : 0;
+                        bool built;
+
+                        pvr_region_clip_from_rect(0, 0, RTW, RTH, 16, &clip);
+
+                        if (getenv("PVR_DUMP_TA")) {
+                           /* The TA state block is written into pbo after building; dump at the
+                            * end of this block (see below). */
+                        }
+
+                        ta_map = (uint8_t *)pbo.map +
+                                 (getenv("PVR_PROBE_FIXED_ADDRS")
+                                     ? (paddr & (vm->general.page_size - 1))
+                                     : 0);
+                        pvr_csb_init(&block, ta_map, pbo.size, 0);
+                        built = pvr_csb_emit_ta_state_header(&block, &pres) &&
+                                pvr_csb_emit_ta_ispctl(&block, NULL, true, &ispctl) &&
+                                pvr_csb_emit_ta_isp_a(&block, &ispa) &&
+                                pvr_csb_emit_ta_isp_b(&block, &ispb) &&
+                                pvr_csb_emit_ta_isp_dbsc(&block, &dbsc) &&
+                                pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_SHADER,
+                                                         ta_shader_base) &&
+                                /* The reference points these at real programs (texunicode/
+                                 * uniform descriptor state, or its nop program). Env-selectable so
+                                 * candidates can be tried without a rebuild. */
+                                pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_TEXUNICODE,
+                                                         pds_tex_base) &&
+                                pvr_csb_emit_ta_pds_sizeinfo(&block, &pds_sizes, true, 0) &&
+                                pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_UNIFORMDATA,
+                                                         pds_uni_base) &&
+                                pvr_csb_emit_ta_region_clip(&block, &clip) &&
+                                pvr_csb_emit_ta_viewport(&block, &vp) &&
+                                pvr_csb_emit_ta_wclamp(&block, PVR_TA_WCLAMP_MIN_W) &&
+                                pvr_csb_emit_ta_output_sel(&block, &outsel) &&
+                                pvr_csb_emit_ta_varying(&block, &varying0, &varying1) &&
+                                pvr_csb_emit_ta_ppp_ctrl(&block, &ppp_ctrl) &&
+                                pvr_csb_emit_ta_stream_out(&block);
