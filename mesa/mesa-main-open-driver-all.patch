+   case nir_instr_type_load_const:
+      nir_builder_instr_insert(b, clone);
+      return &nir_instr_as_load_const(clone)->def;
+
+   case nir_instr_type_alu: {
+      nir_alu_instr *alu = nir_instr_as_alu(instr);
+      nir_alu_instr *alu_clone = nir_instr_as_alu(clone);
+      for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++)
+         alu_clone->src[i].src = nir_src_for_ssa(remat_def(b, alu->src[i].src.ssa));
+      nir_builder_instr_insert(b, clone);
+      return &alu_clone->def;
+   }
+
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      nir_intrinsic_instr *intr_clone = nir_instr_as_intrinsic(clone);
+      for (unsigned i = 0; i < nir_intrinsic_infos[intr->intrinsic].num_srcs;
+           i++)
+         intr_clone->src[i] = nir_src_for_ssa(remat_def(b, intr->src[i].ssa));
+      nir_builder_instr_insert(b, clone);
+      return &intr_clone->def;
+   }
+
+   default:
+      UNREACHABLE("not rematerializable");
+   }
+}
+
+static bool is_output_store(nir_instr *instr)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   if (intr->intrinsic == nir_intrinsic_store_output)
+      return true;
+
+   return intr->intrinsic == nir_intrinsic_store_deref &&
+          nir_deref_mode_is(nir_src_as_deref(intr->src[0]), nir_var_shader_out);
+}
+
+/* Output stores directly in a list (not nested), in program order. */
+static void collect_stores(struct exec_list *list, struct util_dynarray *stores)
+{
+   foreach_list_typed (nir_cf_node, node, node, list) {
+      if (node->type != nir_cf_node_block)
+         continue;
+      nir_foreach_instr (instr, nir_cf_node_as_block(node)) {
+         if (is_output_store(instr))
+            util_dynarray_append_typed(stores, nir_intrinsic_instr *,
+                                       nir_instr_as_intrinsic(instr));
+      }
+   }
+}
+
+/* UBO read only below `end` bytes past its descriptor's offset (or past 0). */
+struct ubo_extent {
+   nir_def *desc;
+   bool has_base;
+   uint32_t end;
+};
+
+/*
+ * Matches a UBO load whose index is the first two components of a
+ * rebuildable descriptor and whose offset is a constant, optionally plus the
+ * descriptor's offset (its third component, which pco_nir_lower_vk makes 0).
+ * Returns the end of the bytes read.
+ */
+static bool ubo_load_extent(nir_intrinsic_instr *intr, struct ubo_extent *ext)
+{
+   nir_scalar x = nir_scalar_resolved(intr->src[0].ssa, 0);
+   nir_scalar y = nir_scalar_resolved(intr->src[0].ssa, 1);
+   if (x.def != y.def || x.comp != 0 || y.comp != 1 ||
+       x.def->num_components != 3 || !def_is_remat(x.def, 0))
+      return false;
+
+   uint64_t off = 0;
+   nir_scalar s = nir_scalar_resolved(intr->src[1].ssa, 0);
+   for (unsigned i = 0; i < 4 && nir_scalar_is_alu(s) &&
+                        nir_scalar_alu_op(s) == nir_op_iadd;
+        i++) {
+      nir_scalar a = nir_scalar_chase_movs(nir_scalar_chase_alu_src(s, 0));
+      nir_scalar c = nir_scalar_chase_movs(nir_scalar_chase_alu_src(s, 1));
+      if (nir_scalar_is_const(a)) {
+         off += nir_scalar_as_uint(a);
+         s = c;
+      } else if (nir_scalar_is_const(c)) {
+         off += nir_scalar_as_uint(c);
+         s = a;
+      } else {
+         return false;
+      }
+   }
+
+   bool has_base = false;
+   if (nir_scalar_is_const(s))
+      off += nir_scalar_as_uint(s);
+   else if (s.def == x.def && s.comp == 2)
+      has_base = true;
+   else
+      return false;
+
+   off += intr->num_components * intr->def.bit_size / 8;
+   if (off > UINT32_MAX)
+      return false;
+
+   *ext = (struct ubo_extent){ x.def, has_base, off };
+   return true;
+}
+
+/* The binding data of a descriptor the driver can read when it records a
+ * draw, or NULL.
+ */
+static const pco_binding_data *
+draw_readable_binding(const pco_common_data *common,
+                      unsigned desc_set,
+                      unsigned binding)
+{
+   if (desc_set >= ARRAY_SIZE(common->desc_sets))
+      return NULL;
+
+   const pco_descriptor_set_data *set_data = &common->desc_sets[desc_set];
+   if (!set_data->bindings || binding >= set_data->binding_count ||
+       set_data->bindings[binding].no_preload)
+      return NULL;
+
+   return &set_data->bindings[binding];
+}
+
+/*
+ * Records the checks below for the driver to make when it records a draw
+ * (the descriptors are known then), so that the shader only reads one shared
+ * register instead of testing every descriptor at every invocation.
+ */
+static bool record_desc_checks(pco_common_data *common,
+                               nir_deref_instr *const *descs,
+                               unsigned num_descs,
+                               const struct ubo_extent *ubos,
+                               unsigned num_ubos)
+{
+   pco_desc_check checks[PCO_MAX_DESC_CHECKS];
+   unsigned num_checks = 0;
+
+   if (num_descs + num_ubos > PCO_MAX_DESC_CHECKS)
+      return false;
+
+   /* With a single null descriptor test in the shader, the checked copy folds
+    * down to returning zeros (the access's null test is known inside it), so
+    * the test stays in the shader. With two or more, or a test the shader
+    * can't see through, both full copies stay, and a draw time test does not
+    * add temps to the checked one.
+    */
+   if (num_descs && (!common->texture_desc_checks ||
+                     (num_descs == 1 && !num_ubos)))
+      return false;
+
+   for (unsigned i = 0; i < num_descs; i++) {
+      nir_deref_instr *deref = descs[i];
+      unsigned elem = 0;
+
+      if (deref->deref_type == nir_deref_type_array) {
+         elem = nir_src_as_uint(deref->arr.index);
+         deref = nir_deref_instr_parent(deref);
+      }
+
+      if (deref->deref_type != nir_deref_type_var)
+         return false;
+
+      const nir_variable *var = deref->var;
+      if (!draw_readable_binding(common,
+                                 var->data.descriptor_set,
+                                 var->data.binding))
+         return false;
+
+      checks[num_checks++] = (pco_desc_check){
+         .desc_set = var->data.descriptor_set,
+         .binding = var->data.binding,
+         .elem = elem,
+      };
+   }
+
+   for (unsigned u = 0; u < num_ubos; u++) {
+      nir_instr *instr = nir_def_instr(ubos[u].desc);
+      if (instr->type != nir_instr_type_intrinsic)
+         return false;
+
+      nir_intrinsic_instr *load_desc = nir_instr_as_intrinsic(instr);
+      if (load_desc->intrinsic != nir_intrinsic_load_vulkan_descriptor)
+         return false;
+
+      nir_intrinsic_instr *res_idx = nir_src_as_intrinsic(load_desc->src[0]);
+      if (!res_idx || res_idx->intrinsic != nir_intrinsic_vulkan_resource_index ||
+          !nir_src_is_const(res_idx->src[0]))
+         return false;
+
+      const unsigned desc_set = nir_intrinsic_desc_set(res_idx);
+      const unsigned binding = nir_intrinsic_binding(res_idx);
+      if (!draw_readable_binding(common, desc_set, binding))
+         return false;
+
+      /* The descriptor offset (has_base) is 0 once pco_nir_lower_vk() runs. */
+      checks[num_checks++] = (pco_desc_check){
+         .desc_set = desc_set,
+         .binding = binding,
+         .elem = nir_src_as_uint(res_idx->src[0]),
+         .ubo = true,
+         .ubo_end = ubos[u].end,
+      };
+   }
+
+   memcpy(common->desc_checks, checks, sizeof(checks[0]) * num_checks);
+   common->num_desc_checks = num_checks;
+   return true;
+}
+
+/*
+ * Instead of guarding every texture/image access (a branch around each
+ * sample) and bounds-checking every UBO load, test once at the start whether
+ * any texture/image descriptor the shader uses is null and whether any UBO is
+ * smaller than the constant offsets read from it (a null UBO has size 0).
+ * When neither, a copy of the shader runs in which those accesses need no
+ * checks; otherwise the original, fully checked, copy runs.
+ *
+ * Done only when every descriptor reference can be rebuilt at the start of
+ * the shader and all outputs are stored at the top level. On success, the
+ * accesses of the unchecked copy that need neither null descriptor nor
+ * robust access checks are added to skip; the checks are lowered afterwards
+ * by the usual passes, which leave those out.
+ */
+bool pco_nir_version_descriptor_checks(
+   nir_shader *shader,
+   pco_nir_lower_null_descriptor_options null_opts,
+   bool (*robust_filter)(const nir_intrinsic_instr *, const void *),
+   pco_common_data *common,
+   struct set *skip)
+{
+   const void *robust_data = common;
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+   nir_deref_instr *descs[VERSION_MAX_DESCS];
+   struct ubo_extent ubos[VERSION_MAX_UBOS];
+   struct util_dynarray covered;
+   unsigned num_descs = 0;
+   unsigned num_ubos = 0;
+   unsigned num_checks = 0;
+   unsigned num_instrs = 0;
+   bool ok = true;
+
+   util_dynarray_init(&covered, NULL);
+
+   nir_foreach_block (block, impl) {
+      nir_foreach_instr (instr, block) {
+         num_instrs++;
+
+         if (is_output_store(instr)) {
+            nir_intrinsic_instr *store = nir_instr_as_intrinsic(instr);
+            if (block->cf_node.parent != &impl->cf_node ||
+                (store->intrinsic == nir_intrinsic_store_output
+                    ? !nir_src_is_const(store->src[1])
+                    : !deref_is_static(nir_src_as_deref(store->src[0])))) {
+               ok = false;
+               goto done_scan;
+            }
+         }
+
+         if ((robust_filter || (null_opts & pco_nir_lower_null_descriptor_ubo)) &&
+             instr->type == nir_instr_type_intrinsic) {
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            struct ubo_extent ext;
+            if (intr->intrinsic == nir_intrinsic_load_ubo &&
+                (!robust_filter || robust_filter(intr, robust_data)) &&
+                ubo_load_extent(intr, &ext)) {
+               unsigned u;
+               for (u = 0; u < num_ubos; u++) {
+                  if (ubos[u].desc == ext.desc &&
+                      ubos[u].has_base == ext.has_base)
+                     break;
+               }
+               if (u == num_ubos) {
+                  if (num_ubos == VERSION_MAX_UBOS)
+                     continue;
+                  ubos[num_ubos++] = ext;
+               }
+               ubos[u].end = MAX2(ubos[u].end, ext.end);
+               util_dynarray_append_typed(&covered, nir_instr *, instr);
+               num_checks++;
+               continue;
+            }
+         }
+
+         nir_deref_instr *deref = checked_deref(instr, null_opts);
+         if (!deref)
+            continue;
+         if (!deref_is_static(deref)) {
+            ok = false;
+            goto done_scan;
+         }
+
+         num_checks++;
+         util_dynarray_append_typed(&covered, nir_instr *, instr);
+
+         bool seen = false;
+         for (unsigned i = 0; i < num_descs; i++)
+            seen |= derefs_match(descs[i], deref);
+         if (seen)
+            continue;
+         if (num_descs == VERSION_MAX_DESCS) {
+            ok = false;
+            goto done_scan;
+         }
+         descs[num_descs++] = deref;
+      }
+   }
+
+done_scan:
+   if (!ok || num_checks < 2 || num_instrs > VERSION_MAX_INSTRS) {
+      util_dynarray_fini(&covered);
+      return false;
+   }
+
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *slow = nir_imm_false(&b);
+   if (record_desc_checks(common, descs, num_descs, ubos, num_ubos)) {
+      slow = nir_ine_imm(&b, nir_load_desc_checks_pco(&b), 0);
+      num_descs = 0;
+      num_ubos = 0;
+   }
+   for (unsigned i = 0; i < num_descs; i++) {
+      nir_deref_instr *deref = remat_deref(&b, descs[i]);
+      slow = nir_ior(&b, slow, nir_is_null_descriptor(&b, &deref->def));
+   }
+   for (unsigned u = 0; u < num_ubos; u++) {
+      nir_def *desc = remat_def(&b, ubos[u].desc);
+      nir_def *size = nir_get_ubo_size(&b, 32, nir_trim_vector(&b, desc, 2));
+      nir_def *end = nir_imm_int(&b, ubos[u].end);
+      if (ubos[u].has_base)
+         end = nir_iadd(&b, nir_channel(&b, desc, 2), end);
+      slow = nir_ior(&b, slow, nir_ult(&b, size, end));
+   }
+
+   nir_if *nif = nir_push_if(&b, slow);
+   nir_cf_list_clone_and_reinsert(&body, &nif->cf_node, b.cursor, NULL);
+   nir_push_else(&b, nif);
+   nir_cf_reinsert(&body, b.cursor);
+   nir_pop_if(&b, nif);
+
+   /* The original instructions now form the unchecked copy. */
+   util_dynarray_foreach (&covered, nir_instr *, instr)
+      _mesa_set_add(skip, *instr);
+   util_dynarray_fini(&covered);
+
+   /* Later passes sink every output store to the end of the shader, so store
+    * each output once after the if, from a phi of the two copies' values.
+    */
+   struct util_dynarray then_stores, else_stores;
+   util_dynarray_init(&then_stores, NULL);
+   util_dynarray_init(&else_stores, NULL);
+   collect_stores(&nif->then_list, &then_stores);
+   collect_stores(&nif->else_list, &else_stores);
+   assert(then_stores.size == else_stores.size);
+
+   unsigned num_stores =
+      util_dynarray_num_elements(&else_stores, nir_intrinsic_instr *);
+   nir_def **phis = ralloc_array(NULL, nir_def *, MAX2(num_stores, 1));
+   for (unsigned i = 0; i < num_stores; i++) {
+      nir_intrinsic_instr *copy =
+         *util_dynarray_element(&then_stores, nir_intrinsic_instr *, i);
+      nir_intrinsic_instr *orig =
+         *util_dynarray_element(&else_stores, nir_intrinsic_instr *, i);
+      unsigned data = orig->intrinsic == nir_intrinsic_store_output ? 0 : 1;
+      phis[i] = nir_if_phi(&b, copy->src[data].ssa, orig->src[data].ssa);
+   }
+   for (unsigned i = 0; i < num_stores; i++) {
+      nir_intrinsic_instr *copy =
+         *util_dynarray_element(&then_stores, nir_intrinsic_instr *, i);
+      nir_intrinsic_instr *orig =
+         *util_dynarray_element(&else_stores, nir_intrinsic_instr *, i);
+      if (orig->intrinsic == nir_intrinsic_store_output) {
+         nir_def *offset = nir_imm_int(&b, nir_src_as_uint(orig->src[1]));
+         nir_instr_remove(&orig->instr);
+         nir_builder_instr_insert(&b, &orig->instr);
+         nir_src_rewrite(&orig->src[0], phis[i]);
+         nir_src_rewrite(&orig->src[1], offset);
+      } else {
+         nir_deref_instr *deref =
+            remat_deref(&b, nir_src_as_deref(orig->src[0]));
+         nir_instr_remove(&orig->instr);
+         nir_builder_instr_insert(&b, &orig->instr);
+         nir_src_rewrite(&orig->src[0], &deref->def);
+         nir_src_rewrite(&orig->src[1], phis[i]);
+      }
+      nir_instr_remove(&copy->instr);
+   }
+   ralloc_free(phis);
+   util_dynarray_fini(&then_stores);
+   util_dynarray_fini(&else_stores);
+
+   nir_progress(true, impl, nir_metadata_none);
+   return true;
+}
+
+struct lower_state {
+   pco_nir_lower_null_descriptor_options options;
+   struct set *skip;
+};
+
+static bool lower_unskipped(nir_builder *b, nir_instr *instr, void *data)
+{
+   struct lower_state *state = data;
+   if (state->skip && _mesa_set_search(state->skip, instr))
+      return false;
+   return lower(b, instr, &state->options);
+}
+
 bool pco_nir_lower_null_descriptors(
    nir_shader *shader,
-   pco_nir_lower_null_descriptor_options options)
+   pco_nir_lower_null_descriptor_options options,
+   struct set *skip)
 {
-   return nir_shader_instructions_pass(shader,
-                                       lower,
-                                       nir_metadata_none,
-                                       &options);
+   struct lower_state state = { .options = options, .skip = skip };
+
+   /* Instructions are collected first: lowering adds control flow. */
+   struct util_dynarray instrs;
+   util_dynarray_init(&instrs, NULL);
+   nir_foreach_function_impl (impl, shader) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block)
+            util_dynarray_append_typed(&instrs, nir_instr *, instr);
+      }
+   }
+
+   bool progress = false;
+   util_dynarray_foreach (&instrs, nir_instr *, instr) {
+      nir_function_impl *impl =
+         nir_cf_node_get_function(&(*instr)->block->cf_node);
+      nir_builder b = nir_builder_create(impl);
+      progress |= lower_unskipped(&b, *instr, &state);
+   }
+   util_dynarray_fini(&instrs);
+
+   nir_foreach_function_impl (impl, shader)
+      nir_progress(progress, impl, nir_metadata_none);
+
+   return progress;
 }
