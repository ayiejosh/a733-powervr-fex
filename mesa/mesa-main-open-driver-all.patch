+/* Exercises the driver's own draw path through the pipe_context API with the compute fallback: create a
+ * context, bind a 512x512 RGBA8 render target, issue a draw, and read the pixels back. This is the
+ * end-to-end driver path - no captured reference data and no direct job submission from the probe. */
+static bool
+compute_draw_check(struct pipe_screen *screen)
+{
+   struct pvr_screen *scr = pvr_screen(screen);
+   struct pipe_context *pctx;
+   bool ok = true;
+
+   if (!scr->vm_valid) {
+      printf("draw:          SKIP (no GPU VM; shim run)\n");
+      return true;
+   }
+
+   pctx = screen->context_create(screen, NULL, 0);
+   if (pctx == NULL) {
+      printf("draw:          FAIL: pipe_context creation\n");
+      return false;
+   }
+
+   /* Case 1: 512x512 target, no vertex buffer bound - the fallback's default triangle. The expected
+    * coverage is the same as the reference capture: 73728 inside pixels. */
+   {
+      struct pipe_resource templ = { 0 };
+      struct pipe_resource *res;
+      struct pvr_resource *rt;
+      struct pipe_framebuffer_state fb = { 0 };
+      struct pipe_draw_info info = { 0 };
+      struct pipe_draw_start_count_bias draw = { 0 };
+      uint32_t *px;
+      unsigned waited_us = 0;
+      uint32_t inside = 0;
+
+      templ.target = PIPE_TEXTURE_2D;
+      templ.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+      templ.width0 = 512;
+      templ.height0 = 512;
+      templ.depth0 = 1;
+      templ.array_size = 1;
+      templ.bind = PIPE_BIND_RENDER_TARGET;
+      res = screen->resource_create(screen, &templ);
+      rt = res ? pvr_resource(res) : NULL;
+      if (rt == NULL || rt->dev_addr == 0 || !pvr_bo_map(scr->fd, &rt->bo)) {
+         printf("draw:          FAIL: 512x512 render-target creation\n");
+         pctx->destroy(pctx);
+         return false;
+      }
+      memset(rt->bo.map, 0, rt->bo.size);
+      fb.width = 512;
+      fb.height = 512;
+      fb.nr_cbufs = 1;
+      fb.cbufs[0].texture = res;
+      pctx->set_framebuffer_state(pctx, &fb);
+      info.mode = MESA_PRIM_TRIANGLES;
+      info.instance_count = 1;
+      draw.count = 3;
+      pctx->draw_vbo(pctx, &info, 0, NULL, &draw, 1);
+
+      px = rt->bo.map;
+      while (waited_us < 3000000) {
+         uint32_t i;
+
+         inside = 0;
+         for (i = 0; i < 512 * 512; i++)
+            if (px[i] == 0xFF0000FFu)
+               inside++;
+         if (inside == 73728)
+            break;
+         usleep(1000);
+         waited_us += 1000;
+      }
+      printf("draw:          512x512 default triangle: inside=%u (waited %u us) center=0x%08x\n",
+             inside, waited_us, px[200 * 512 + 256]);
+      ok = inside == 73728;
+      if (!ok)
+         printf("draw:          FAIL: expected 73728 inside pixels\n");
+      else if (pvr_context(pctx)->draws_executed == 0) {
+         printf("draw:          FAIL: the draw did not reach the driver's execution path\n");
+         ok = false;
+      }
+      pctx->set_framebuffer_state(pctx, &(struct pipe_framebuffer_state){ 0 });
+      screen->resource_destroy(screen, res);
+   }
+
+   /* Case 2: a target size that is not a multiple of the 8x8 local size, with a bound vertex buffer - the
+    * draw must rasterise the vertices the vertex stage is given, not a built-in triangle, and the guard
+    * must keep the out-of-range invocations from touching memory. A full-screen triangle covers every
+    * pixel. */
+   if (ok) {
+      struct pipe_resource templ = { 0 };
+      struct pipe_resource *res, *vbres;
+      struct pvr_resource *rt, *vb;
+      struct pipe_framebuffer_state fb = { 0 };
+      struct pipe_draw_info info = { 0 };
+      struct pipe_draw_start_count_bias draw = { 0 };
+      struct pipe_vertex_buffer vbuf = { 0 };
+      float *vp;
+      uint32_t *px;
+      unsigned waited_us = 0;
+      uint32_t inside = 0;
+
+      templ.target = PIPE_BUFFER;
+      templ.format = PIPE_FORMAT_R8G8B8A8_UNORM;
+      templ.width0 = 3 * 3 * sizeof(float);
+      templ.height0 = 1;
+      templ.depth0 = 1;
+      templ.array_size = 1;
+      templ.last_level = 0;
+      templ.bind = PIPE_BIND_VERTEX_BUFFER;
+      vbres = screen->resource_create(screen, &templ);
+      vb = vbres ? pvr_resource(vbres) : NULL;
+      if (vb == NULL || !pvr_bo_map(scr->fd, &vb->bo)) {
+         printf("draw:          FAIL: vertex buffer creation\n");
+         ok = false;
+      } else {
+         vp = vb->bo.map;
+         vp[0] = -1.0f; vp[1] = -1.0f; vp[2] = 0.0f;
+         vp[3] = 3.0f;  vp[4] = -1.0f; vp[5] = 0.0f;
+         vp[6] = -1.0f; vp[7] = 3.0f;  vp[8] = 0.0f;
+         vbuf.buffer.resource = vbres;
+         vbuf.buffer_offset = 0;
+         pctx->set_vertex_buffers(pctx, 1, &vbuf);
+
+         templ.target = PIPE_TEXTURE_2D;
+         templ.width0 = 1366;
+         templ.height0 = 768;
+         templ.depth0 = 1;
+         templ.array_size = 1;
+         templ.bind = PIPE_BIND_RENDER_TARGET;
+         res = screen->resource_create(screen, &templ);
+         rt = res ? pvr_resource(res) : NULL;
+         if (rt == NULL || rt->dev_addr == 0 || !pvr_bo_map(scr->fd, &rt->bo)) {
+            printf("draw:          FAIL: 1366x768 render-target creation\n");
+            ok = false;
+         } else {
+            memset(rt->bo.map, 0, rt->bo.size);
+            fb.width = 1366;
+            fb.height = 768;
+            fb.nr_cbufs = 1;
+            fb.cbufs[0].texture = res;
+            pctx->set_framebuffer_state(pctx, &fb);
+            info.mode = MESA_PRIM_TRIANGLES;
+            info.instance_count = 1;
+            draw.count = 3;
+            pctx->draw_vbo(pctx, &info, 0, NULL, &draw, 1);
+            px = rt->bo.map;
+            while (waited_us < 3000000) {
+               uint32_t i;
+
+               inside = 0;
+               for (i = 0; i < 1366u * 768u; i++)
+                  if (px[i] == 0xFF0000FFu)
+                     inside++;
+               if (inside == 1366u * 768u)
+                  break;
+               usleep(1000);
+               waited_us += 1000;
+            }
+            printf("draw:          1366x768 vertex-buffer triangle: inside=%u/%u (waited %u us)\n",
+                   inside, 1366u * 768u, waited_us);
+            if (inside != 1366u * 768u) {
+               printf("draw:          FAIL: full-screen triangle did not cover the target\n");
+               ok = false;
+            }
+            pctx->set_framebuffer_state(pctx, &(struct pipe_framebuffer_state){ 0 });
+            screen->resource_destroy(screen, res);
+         }
+         pctx->set_vertex_buffers(pctx, 0, NULL);
+         screen->resource_destroy(screen, vbres);
+      }
+   }
+
+   printf("draw:          %s (driver draw path via compute fallback, %u draws executed)\n",
+          ok ? "PASS" : "FAIL", pvr_context(pctx)->draws_executed);
+   pctx->destroy(pctx);
+   return ok;
+}
