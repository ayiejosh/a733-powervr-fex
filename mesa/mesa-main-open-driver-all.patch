+                                    okc = false;
+                                 }
+                              }
+                           }
+                        }
+
+                        if (okc) {
+                           struct pvr_vdm_vs vdm_vs = {
+                              .pds_data_addr = g_vertex_prog_data_offset,
+                              .pds_code_addr = g_vertex_prog_code_offset,
+                              .output_size = g_vs_vtxouts,
+                              .usc_unified_bytes = g_vs_vtxins * 4,
+                              .pds_temp_dwords = g_vertex_prog_info.temp_dwords,
+                              .pds_data_dwords = g_vertex_prog_info.data_dwords,
+                           };
+                           pvr_vdm_cam_size(dev_info, g_vs_vtxouts, true, &vdm_vs.cam_size,
+                                            &vdm_vs.max_instances);
+
+                           pvr_csb_init(&ctl_csb, rctl.map, rctl.size, PVR_CSB_LINK_DWORDS);
+                           if (!pvr_csb_emit_ppp_state(&ctl_csb, paddr,
+                                                       pvr_csb_size(&block) / 4) ||
+                               /* Round-21: a geometry job with no vertex program at all, to test
+                                * whether the TA kick itself completes (the hardware would then have
+                                * nothing to fetch and would finish immediately). */
+                               !pvr_csb_emit_vdm_state(&ctl_csb, false, 0,
+                                                       getenv("PVR_PROBE_NO_VS") ? NULL : &vdm_vs,
+                                                       &vdm_words) ||
+                               /* Non-indexed, like the captured working draw: the index buffer
+                                * exists but the draw does not name it. An indexed draw relies on the
+                                * index list's address encoding, which is not capture-verified yet;
+                                * this at least removes it as a variable. */
+                               !pvr_csb_emit_index_list(&ctl_csb, 0, 3, 1,
+                                                        ROGUE_VDMCTRL_INDEX_SIZE_B8,
+                                                        ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_TRI_LIST) ||
+                               !pvr_csb_emit_ppp_state(&ctl_csb, taddr, 3) ||
+                               !pvr_csb_emit_stream_terminate(&ctl_csb)) {
+                              printf("hwrt:          could not emit the draw stream\n");
+                           } else {
+                              const uint32_t *cw = (const uint32_t *)rctl.map;
+
+                              /* Round-20 experiment: the reference's SIZEINFO words (captured)
+                               * are non-zero where ours are zero because our shader uses no
+                               * varyings; test whether the TA kick requires them. */
+                              if (getenv("PVR_PROBE_TA_SIZEINFO")) {
+                                 uint32_t *aw = (uint32_t *)ta_map;
