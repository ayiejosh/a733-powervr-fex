+                                              (uint32_t)eot_data_offset, false);
+                  printf("hwrt:          dummy fragment stream (%u bytes) instead of the draw's\n",
+                         f2);
+               }
+               if (dump_streams) {
+                  printf("OURPBE: %016" PRIx64 " %016" PRIx64 " %016" PRIx64 "\n",
+                         pbe_words[0], pbe_words[1], pbe_words[2]);
+                  printf("OURFW: geom len=%u:", glen);
+                  for (unsigned i = 0; i < glen / 4; i++)
+                     printf(" %08x", ((const uint32_t *)gstream)[i]);
+                  printf("\nOURFW: frag len=%u:", f2);
+                  for (unsigned i = 0; i < f2 / 4; i++)
+                     printf(" %08x", ((const uint32_t *)fstream)[i]);
+                  printf("\n");
+               }
+
+               /* Round-10 bisect: a geometry job whose control stream is only STREAM_TERMINATE.
+                * If even this times out, the TA fails before it reads any of our draw state. */
+               if (getenv("PVR_PROBE_MINIMAL_GEOM")) {
+                  uint32_t *ctl_words = rctl.map;
+                  bool gdone;
+
+                  ctl_words[0] = 0xc0000000u; /* STREAM_TERMINATE */
+                  gdone = pvr_job_submit_geom_sync(vm, gpu_ctx.handle, gstream, glen,
+                                                   dset_handle, 0, 2000);
+                  printf("hwrt:          minimal geometry job (terminate-only control) %s\n",
+                         gdone ? "COMPLETED" : "did not complete in 2 s");
+               } else if (getenv("PVR_PROBE_FRAG_ONLY") || getenv("PVR_PROBE_FRAG_THEN_GEOM")) {
