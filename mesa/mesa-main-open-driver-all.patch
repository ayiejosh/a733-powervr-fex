+                        if (!built || block.overflowed) {
+                           printf("hwrt:          could not build the TA state block\n");
+                           okc = false;
+                        } else {
+                           const uint32_t block_words = pvr_csb_size(&block) / 4;
+
+                           printf("hwrt:          TA state block: %u words at 0x%" PRIx64 "\n",
+                                  block_words, paddr);
+
+                           /* Conformance against the captured working draw: every word whose
+                            * value is determined by STATE (not by a program address or size) must
+                            * equal the capture's. Five words are skipped - SHADERBASE, TEXUNICODE,
+                            * both SIZEINFOs and UNIFORMDATABASE - because this pipeline has its own
+                            * program addresses and sizes. Everything else (header presence, ISP
+                            * face values, clip, viewport, wclamp, output select, varying counts,
+                            * PPP ctrl) is fixed by the draw being a full-target opaque triangle and
+                            * must match byte for byte. */
+                           {
+                              static const uint32_t captured[25] = {
+                                 0x007f0e67, 0x00050000, 0x002e0f00, 0x0e000000, 0x00000000,
+                                 0x00002900, 0x00002780, 0x01000000, 0x00804000, 0x000028c0,
+                                 0x8000001f, 0x0000001f, 0x43800000, 0x43800000, 0x43800000,
+                                 0x43800000, 0x00000000, 0x3f800000, 0x29e12e13, 0x05040000,
+                                 0x00000000, 0x00000000, 0x00000000, 0x000006a0, 0x00000000,
+                              };
+                              static const unsigned program_words[] = { 5, 6, 7, 8, 9 };
+                              const uint32_t *got = (const uint32_t *)ta_map;
+
+                              if (block_words == ARRAY_SIZE(captured)) {
+                                 for (unsigned i = 0; i < ARRAY_SIZE(captured); i++) {
+                                    bool is_program_word = false;
+
+                                    for (unsigned j = 0; j < ARRAY_SIZE(program_words); j++)
+                                       is_program_word |= i == program_words[j];
+                                    if (is_program_word || got[i] == captured[i])
+                                       continue;
+
+                                    printf("hwrt:          FAIL: TA state word %u is 0x%08x, "
+                                           "captured draw has 0x%08x\n", i, got[i],
+                                           captured[i]);
+                                    okc = false;
+                                    break;
+                                 }
+                                 if (okc)
+                                    printf("hwrt:          TA state matches the captured draw at "
+                                           "every state-determined word (%u of %u; the rest are "
+                                           "this pipeline's PDS addresses/sizes)\n",
+                                           (unsigned)ARRAY_SIZE(captured) -
+                                              (unsigned)ARRAY_SIZE(program_words),
+                                           (unsigned)ARRAY_SIZE(captured));
+                              }
+                           }
+
+                           /* --- The terminate block: header(pres_terminate) + clip --- */
+                           {
+                              struct pvr_csb tb;
+                              struct pvr_ta_presence tpres = { .terminate = true };
+                              struct pvr_region_clip tclip;
+                              struct ROGUE_TA_STATE_TERMINATE0 t0;
+                              struct ROGUE_TA_STATE_TERMINATE1 t1;
+
+                              pvr_region_clip_from_rect(0, 0, RTW, RTH, 32, &tclip);
+                              t0 = (struct ROGUE_TA_STATE_TERMINATE0){
+                                 .clip_right = tclip.right,
+                                 .clip_top = tclip.top,
+                                 .clip_bottom = tclip.bottom,
+                              };
+                              t1 = (struct ROGUE_TA_STATE_TERMINATE1){
+                                 .clip_left = tclip.left,
+                                 .render_target = 0,
+                              };
