+/* True if the barrier only orders attachment access against attachment access.
+ * Nothing but a render pass can see the pending clears through it, and a render
+ * pass that attaches the image consumes or flushes them itself.
+ */
+static bool pvr_barrier_dst_is_attachment_only(VkPipelineStageFlags2 stages,
+                                               VkAccessFlags2 access)
+{
+   return stages &&
+          !(stages & ~(VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                       VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                       VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT)) &&
+          !(access & ~(VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+                       VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+                       VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+                       VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT));
+}
+
+/* True if the barrier only orders attachment writes against fragment work.
+ * Fragment jobs run in order on this hardware, so a clear submitted just
+ * before the next render pass is still ordered against the shader reads.
+ */
+static bool pvr_barrier_dst_is_fragment_only(VkPipelineStageFlags2 stages)
+{
+   return stages &&
+          !(stages & ~(VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+                       VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                       VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                       VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT));
+}
+
+/* Buffer barriers and memory aliased by other resources are not considered.
+ *
+ * Returns true if the pending clears must be submitted before this barrier.
+ * A fragment-only barrier only marks them exposed: vkCmdBeginRendering consumes
+ * an exposed clear or submits it before the pass that could read it.
+ */
+static bool
+pvr_dependency_exposes_pending_clear(struct pvr_cmd_buffer *cmd_buffer,
+                                     const VkDependencyInfo *dep)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *b = &dep->pMemoryBarriers[i];
+
+      if ((b->srcStageMask & PVR_CLEAR_WRITE_STAGES) &&
+          (b->srcAccessMask & PVR_CLEAR_WRITE_ACCESS) &&
+          !pvr_barrier_dst_is_attachment_only(b->dstStageMask,
+                                              b->dstAccessMask)) {
+         /* Fragment reads are tracked per draw, see
+          * pvr_clear_fold_note_reads().
+          */
+         if (!pvr_barrier_dst_is_fragment_only(b->dstStageMask))
+            return true;
+      }
+   }
+
+   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
+      const VkImageMemoryBarrier2 *b = &dep->pImageMemoryBarriers[i];
+      VK_FROM_HANDLE(pvr_image, image, b->image);
+
+      if (b->oldLayout == b->newLayout &&
+          pvr_barrier_dst_is_attachment_only(b->dstStageMask,
+                                             b->dstAccessMask))
+         continue;
+
+      for (uint32_t e = 0; e < state->pending_clear_count; e++) {
+         if (state->pending_clears[e].iview->vk.image == &image->vk)
+            return true;
+      }
+   }
+
+   return false;
+}
