diff --git a/src/gallium/drivers/pvr_native/meson.build b/src/gallium/drivers/pvr_native/meson.build
new file mode 100644
index 00000000..5c32796e
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/meson.build
@@ -0,0 +1,57 @@
+# Copyright 2026 The Mesa authors
+# SPDX-License-Identifier: MIT
+#
+# SKELETON: milestone 1 is that this builds in-tree, registers a pipe_screen and
+# enumerates the device. The pieces below are linked and reused, not rewritten.
+
+files_pvr = files(
+  'pvr_bo.c',
+  'pvr_context.c',
+  'pvr_draw.c',
+  'pvr_csb.c',
+  'pvr_resource.c',
+  'pvr_shader.c',
+  'pvr_static.c',
+  'pvr_compute.c',
+  'pvr_vm.c',
+  'pvr_hwrt.c',
+  'pvr_screen.c',
+)
+
+libpvr = static_library(
+  'pvr',
+  files_pvr,
+  include_directories : [inc_gallium_aux, inc_gallium, inc_include, inc_src, inc_imagination,
+                         libpowervr_pds_includes],
+  gnu_symbol_visibility : 'hidden',
+  # libpowervr_common: src/imagination/common - the .pdsc-generated device tables.
+  # libpowervr_compiler: pco - the NIR-based PowerVR compiler, ~25k lines, the
+  # same one the Vulkan driver uses. Linked here rather than rewritten.
+  dependencies : [idep_mesautil, idep_nir_headers, dep_libdrm, dep_csbgen, idep_pco_pygen, idep_pco_usclib,
+                  idep_pco_uscgen_programs_headers, idep_vtn],
+  # libpowervr_pds is the PDS program generator. It lives under src/imagination/vulkan/
+  # but has no Vulkan dependency at all - 5379 lines, zero Vk references, and its own
+  # include list carries no Vulkan headers. Linking it here is additive and modifies no
+  # Vulkan source, which is what makes the static context state reachable at all.
+  link_with : [libpowervr_common, libpowervr_compiler, libpowervr_uscgen, libpowervr_pds],
+)
+
+driver_pvr = declare_dependency(
+  compile_args : '-DGALLIUM_PVR',
+  link_with : [libpvr],
+)
+
+# Runnable check for the enumeration path; needs no GPU (pairs with the drm-shim).
+# Not installed. libgallium is linked here rather than into libpvr because the driver's
+# objects normally live inside the megadriver, which already links it - the driver needs
+# gallium aux symbols (u_init_pipe_screen_caps) but must not carry its own copy of them.
+executable(
+  'pvr-probe',
+  'pvr_probe.c',
+  include_directories : [inc_gallium_aux, inc_gallium, inc_include, inc_src, inc_imagination,
+                         libpowervr_pds_includes],
+  link_with : [libpvr, libgallium],
+  dependencies : [idep_mesautil, idep_nir_headers, dep_libdrm, idep_pco_usclib,
+                  idep_pco_uscgen_programs_headers, idep_vtn],
+  install : false,
+)
diff --git a/src/gallium/drivers/pvr_native/pvr_bo.c b/src/gallium/drivers/pvr_native/pvr_bo.c
new file mode 100644
index 00000000..99e69b73
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_bo.c
@@ -0,0 +1,126 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * Buffer objects via DRM_IOCTL_PVR_CREATE_BO / _GET_BO_MMAP_OFFSET / GEM_CLOSE.
+ * The sequences follow the Vulkan driver's winsys (src/imagination/vulkan/winsys/
+ * powervr/pvr_drm_bo.c), which is the working reference for this UAPI.
+ */
+#include "pvr_bo.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <string.h>
+#include <sys/mman.h>
+
+#include <xf86drm.h>
+
+#include "drm-uapi/pvr_drm.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/os_misc.h"
+
+bool
+pvr_bo_create_flags(int fd, uint64_t size, uint64_t alignment, uint64_t flags,
+                     struct pvr_bo *bo)
+{
+   uint64_t page_size = 4096;
+   if (!os_get_page_size(&page_size) || page_size == 0)
+      page_size = 4096; /* an mmap-able default beats refusing to allocate */
+
+   /* The kernel rejects a size that is not a whole number of device pages
+    * (pvr_drv.c: `args->size & (PVR_DEVICE_PAGE_SIZE - 1)` -> -EINVAL). It does NOT
+    * round up, whatever the prose in pvr_gem.c suggests, so round here.
+    *
+    * Flags: ALLOW_CPU_USERSPACE_ACCESS is what makes mmap() legal later; without it
+    * CREATE_BO still succeeds and only the mmap fails. DRM_PVR_BO_CPU_CACHED is
+    * deliberately NOT passed: Mesa's synced header defines bit 3, but the deployed
+    * powervr module masks flags to bits 0..2 and returns -EINVAL for it - which reads
+    * exactly like a size error and would send you hunting the wrong bug. The default
+    * write-combined mapping is the coherent one here anyway: WC reads are uncached, so
+    * the CPU sees GPU writes, and this tree has no userspace cache-maintenance path. */
+   const uint64_t aligned_size = ALIGN_POT(size, MAX2(alignment, page_size));
+
+   struct drm_pvr_ioctl_create_bo_args args = {
+      .size = aligned_size,
+      .flags = flags,
+   };
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_CREATE_BO, &args) != 0) {
+      mesa_loge("pvr: CREATE_BO size=%" PRIu64 " failed: %s", aligned_size,
+                strerror(errno));
+      return false;
+   }
+
+   bo->handle = args.handle;
+   bo->size = aligned_size;
+   bo->map = NULL;
+
+   return true;
+}
+
+bool
+pvr_bo_map(int fd, struct pvr_bo *bo)
+{
+   assert(bo->map == NULL);
+
+   struct drm_pvr_ioctl_get_bo_mmap_offset_args args = {
+      .handle = bo->handle,
+   };
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_GET_BO_MMAP_OFFSET, &args) != 0) {
+      mesa_loge("pvr: GET_BO_MMAP_OFFSET handle=%u failed: %s", bo->handle,
+                strerror(errno));
+      return false;
+   }
+
+   /* args.offset is a drm_vma_node fake offset, NOT a GPU address - the GPU address
+    * comes from VM_MAP and is a different number entirely. MAP_SHARED is required. */
+   void *map = mmap(NULL, bo->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd,
+                    args.offset);
+   if (map == MAP_FAILED) {
+      mesa_loge("pvr: mmap of %" PRIu64 " bytes failed: %s", bo->size,
+                strerror(errno));
+      return false;
+   }
+
+   bo->map = map;
+
+   return true;
+}
+
+void
+pvr_bo_unmap(struct pvr_bo *bo)
+{
+   if (bo->map == NULL)
+      return;
+
+   /* The exact mapped length, not the user's requested size. */
+   munmap(bo->map, bo->size);
+   bo->map = NULL;
+}
+
+void
+pvr_bo_destroy(int fd, struct pvr_bo *bo)
+{
+   pvr_bo_unmap(bo);
+
+   /* There is no PVR_DESTROY_BO; GEM_CLOSE is the teardown. */
+   if (bo->handle != 0)
+      drmCloseBufferHandle(fd, bo->handle);
+
+   bo->handle = 0;
+   bo->size = 0;
+}
+
+bool
+pvr_bo_create(int fd, uint64_t size, uint64_t alignment, struct pvr_bo *bo)
+{
+   /* Everything this driver creates is written by the CPU and read by the GPU (command streams,
+    * firmware programs, vertex data, TA state blocks). Bypassing the device cache makes those writes
+    * visible to the firmware without relying on a flush the driver does not issue yet; a cached
+    * buffer can hand the firmware stale contents. */
+   return pvr_bo_create_flags(fd, size, alignment,
+                              DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS |
+                                 DRM_PVR_BO_BYPASS_DEVICE_CACHE, bo);
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_bo.h b/src/gallium/drivers/pvr_native/pvr_bo.h
new file mode 100644
index 00000000..2067feca
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_bo.h
@@ -0,0 +1,31 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * Buffer objects, via the same kernel UAPI the Vulkan driver uses.
+ *
+ * Deliberately minimal: create, CPU map, unmap, destroy. This is what a gallium
+ * pipe_resource needs first. GPU address-space mapping (DRM_IOCTL_PVR_VM_MAP) needs
+ * the heap query and a VM context, and is a separate step - none of the four
+ * functions here require it.
+ */
+#ifndef PVR_BO_H
+#define PVR_BO_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct pvr_bo {
+   uint32_t handle; /* GEM handle */
+   uint64_t size;   /* page-aligned size, as created and as mapped */
+   void *map;       /* CPU mapping, NULL while unmapped */
+};
+
+bool pvr_bo_create(int fd, uint64_t size, uint64_t alignment, struct pvr_bo *bo);
+/* Free-list buffers must be created with DEVICE_PM_FW_PROTECT and WITHOUT userspace access. */
+bool pvr_bo_create_flags(int fd, uint64_t size, uint64_t alignment, uint64_t flags,
+                         struct pvr_bo *bo);
+bool pvr_bo_map(int fd, struct pvr_bo *bo);
+void pvr_bo_unmap(struct pvr_bo *bo);
+void pvr_bo_destroy(int fd, struct pvr_bo *bo);
+
+#endif /* PVR_BO_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_compute.c b/src/gallium/drivers/pvr_native/pvr_compute.c
new file mode 100644
index 00000000..0c8401dd
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_compute.c
@@ -0,0 +1,582 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The compute fallback render path: a compute job that rasterises the vertex stage's triangle into the
+ * bound colour buffer. Everything is generated by the driver: the shader is compiled by pco from SPIR-V,
+ * the PDS programs come from libpowervr_pds, the CDM control stream and the compute fw stream are built
+ * from the csbgen packet definitions, and the job is submitted through pvr_vm. The fixed-function 3D path
+ * (TA) is not usable yet; this path is what makes a draw reach the GPU with the pipeline's geometry.
+ */
+#include "pvr_compute.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/u_math.h"
+#include "util/u_memory.h"
+
+#include "compiler/spirv/nir_spirv.h"
+#include "nir.h"
+
+#include "pco/pco.h"
+#include "pco/pco_data.h"
+#include "pco_uscgen_programs.h"
+
+#include "pds/pvr_pds.h"
+
+#include "pvr_bo.h"
+#include "pvr_context.h"
+#include "pvr_resource.h"
+#include "pvr_screen.h"
+#include "pvr_shader.h"
+#include "pvr_vm.h"
+
+/* csbgen packet definitions - kept before any header that could change their address types. */
+#include "pvr_csb.h"
+#include "csbgen/rogue/cdm.h"
+
+#include "drm-uapi/pvr_drm.h"
+
+#include "pvr_compute_triangle_spv.h"
+
+/* The shader's local size is 8x8 and each invocation rasterises a 2x2 pixel block, so a dispatch
+ * covers ceil(size/(8*BLOCK)) workgroups in each dimension. */
+#define PVR_COMPUTE_LOCAL_X 8u
+#define PVR_COMPUTE_LOCAL_Y 8u
+#define PVR_COMPUTE_BLOCK_X 4u
+#define PVR_COMPUTE_BLOCK_Y 2u
+
+#define PVR_COMPUTE_MAX_INSTANCES (ROGUE_CDMCTRL_KERNEL8_MAX_INSTANCES_MAX_SIZE + 1u)
+
+/* Layout inside the PDS page. The streams name these through the PDS heap base. */
+#define PDS_FENCE_DATA_OFF 0x000u
+#define PDS_FENCE_CODE_OFF 0x040u
+#define PDS_DESC_CODE_OFF 0x080u
+#define PDS_KERN_DATA_OFF 0x100u
+#define PDS_KERN_CODE_OFF 0x140u
+#define PDS_DESC_DATA_OFF 0x300u
+#define PDS_PAGE_SIZE 0x2000u
+
+/* Descriptor set and compile-time literal pool sub-allocations in the descriptor page. */
+#define DESC_SET_OFF 0x80u
+#define DESC_LITERALS_OFF 0x40u
+
+static bool
+pvr_compute_emit_kernel(struct pvr_csb *csb, uint32_t usc_common_size, uint32_t usc_unified_size,
+                        uint32_t pds_temp_size, uint32_t pds_data_size, bool usc_target_any,
+                        bool fence, uint64_t pds_data_addr, uint64_t pds_code_addr,
+                        uint32_t sd_type, bool usc_common_shared,
+                        const uint32_t global_size[3], const uint32_t local_size[3],
+                        uint32_t max_instances)
+{
+   struct ROGUE_CDMCTRL_KERNEL0 k0 = {
+      .block_type = ROGUE_CDMCTRL_BLOCK_TYPE_COMPUTE_KERNEL,
+      .usc_common_size = usc_common_size,
+      .usc_unified_size = usc_unified_size,
+      .pds_temp_size = pds_temp_size,
+      .pds_data_size = pds_data_size,
+      .usc_target = usc_target_any ? ROGUE_CDMCTRL_USC_TARGET_ANY : ROGUE_CDMCTRL_USC_TARGET_ALL,
+      .fence = fence,
+   };
+   struct ROGUE_CDMCTRL_KERNEL1 k1 = {
+      .data_addr = pds_data_addr,
+      .sd_type = sd_type,
+      .usc_common_shared = usc_common_shared,
+   };
+   struct ROGUE_CDMCTRL_KERNEL2 k2 = { .code_addr = pds_code_addr };
+   struct ROGUE_CDMCTRL_KERNEL3 k3 = { .workgroup_x = global_size[0] - 1 };
+   struct ROGUE_CDMCTRL_KERNEL4 k4 = { .workgroup_y = global_size[1] - 1 };
+   struct ROGUE_CDMCTRL_KERNEL5 k5 = { .workgroup_z = global_size[2] - 1 };
+   struct ROGUE_CDMCTRL_KERNEL8 k8 = {
+      .max_instances = max_instances,
+      .workgroup_size_x = local_size[0] - 1,
+      .workgroup_size_y = local_size[1] - 1,
+      .workgroup_size_z = local_size[2] - 1,
+   };
+   uint32_t *dw;
+
+#define EMIT(_type, _values)                                          \
+   do {                                                               \
+      dw = pvr_csb_emit(csb, ROGUE_CDMCTRL_##_type##_length);         \
+      if (dw == NULL)                                                 \
+         return false;                                                \
+      ROGUE_CDMCTRL_##_type##_pack(dw, &(_values));                   \
+   } while (0)
+
+   EMIT(KERNEL0, k0);
+   EMIT(KERNEL1, k1);
+   EMIT(KERNEL2, k2);
+   EMIT(KERNEL3, k3);
+   EMIT(KERNEL4, k4);
+   EMIT(KERNEL5, k5);
+   EMIT(KERNEL8, k8);
+#undef EMIT
+   return true;
+}
+
+static uint64_t
+pvr_compute_alloc(struct pvr_screen *screen, uint16_t heap_id, uint64_t size, struct pvr_bo *bo)
+{
+   uint64_t addr = pvr_vm_heap_alloc(&screen->vm, heap_id, size, 4096, bo);
+
+   if (addr == 0 || !pvr_bo_map(screen->fd, bo))
+      return 0;
+   memset(bo->map, 0, size);
+   return addr;
+}
+
+/* Builds the CDM control stream for the current workgroup counts. */
+static bool
+pvr_compute_build_ctrl_stream(struct pvr_compute_state *st)
+{
+   struct pvr_csb csb;
+   static const uint32_t wg1[3] = { 1, 1, 1 }, l1[3] = { 1, 1, 1 };
+   uint32_t wg[3] = { st->wg_x, st->wg_y, 1 };
+   uint32_t work_items = st->usc_unified_units ? 0 : 0; /* set below from the pco data */
+   uint32_t l[3] = { 1, 1, 1 };
+   bool emitted;
+
+   /* pco flattens the shader's 8x8x1 local size into a 64x1x1 PDS task. */
+   work_items = PVR_COMPUTE_LOCAL_X * PVR_COMPUTE_LOCAL_Y;
+   if (work_items > PVR_COMPUTE_MAX_INSTANCES)
+      work_items = ALIGN_POT(work_items, PVR_COMPUTE_MAX_INSTANCES);
+   l[0] = work_items;
+
+   memset(st->ctrl_bo.map, 0, 4096);
+   pvr_csb_init(&csb, st->ctrl_bo.map, 4096, 0);
+   emitted = pvr_compute_emit_kernel(
+      &csb, st->usc_common_units, 0, 0, DIV_ROUND_UP(st->desc_data_dw * 4, 16), false, false,
+      st->pds_base_addr + PDS_DESC_DATA_OFF, st->pds_base_addr + PDS_DESC_CODE_OFF,
+      ROGUE_CDMCTRL_SD_TYPE_NONE, true, wg1, l1, 8);
+   if (emitted)
+      emitted = pvr_compute_emit_kernel(
+         &csb, st->usc_common_units, st->usc_unified_units, st->pds_temp_units,
+         DIV_ROUND_UP(st->kern_data_dw * 4, 16), true, false,
+         st->pds_base_addr + PDS_KERN_DATA_OFF, st->pds_base_addr + st->kern_code_off,
+         ROGUE_CDMCTRL_SD_TYPE_USC, false, wg, l, 0);
+   if (emitted)
+      emitted = pvr_compute_emit_kernel(
+         &csb, 0, 0, 0, DIV_ROUND_UP(st->fence_data_dw * 4, 16), true, true,
+         st->pds_base_addr + PDS_FENCE_DATA_OFF, st->pds_base_addr + st->fence_code_off,
+         ROGUE_CDMCTRL_SD_TYPE_PDS, true, wg1, l1, 8);
+   if (emitted) {
+      struct ROGUE_CDMCTRL_STREAM_TERMINATE t = {
+         .block_type = ROGUE_CDMCTRL_BLOCK_TYPE_STREAM_TERMINATE,
+      };
+      uint32_t *dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_STREAM_TERMINATE_length);
+
+      if (dw != NULL)
+         ROGUE_CDMCTRL_STREAM_TERMINATE_pack(dw, &t);
+      else
+         emitted = false;
+   }
+   st->ctrl_valid = emitted;
+   return emitted;
+}
+
+static bool
+pvr_compute_build(struct pvr_compute_state *st, struct pvr_context *ctx)
+{
+   struct pvr_screen *screen = pvr_screen(ctx->base.screen);
+   struct pvr_vm *vm = &screen->vm;
+   const struct pvr_heap *pds_heap = &vm->heaps[DRM_PVR_HEAP_PDS_CODE_DATA];
+   pco_data data = { 0 };
+   pco_shader *shader = NULL;
+   const void *binary = NULL;
+   unsigned binary_size = 0;
+   nir_shader *nir;
+   const pco_data *sd;
+   struct pvr_pds_compute_shader_program kern_prog, fence_prog;
+   struct pvr_pds_descriptor_program_input din = { 0 };
+   struct pvr_pds_info dinfo = { 0 };
+   uint32_t *desc_entries = NULL, *desc_code = NULL;
+   uint32_t *kern_stage = NULL, *fence_stage = NULL;
+   uint64_t pds_addr, usc_addr;
+   uint32_t pds_base_off;
+   bool ok = false;
+
+   st->screen = screen;
+
+   nir = spirv_to_nir(pvr_compute_triangle_spv, ARRAY_SIZE(pvr_compute_triangle_spv), NULL,
+                      MESA_SHADER_COMPUTE, "main", pco_spirv_options(), pco_nir_options());
+   if (nir == NULL || !pvr_shader_compile_compute(screen->pco_ctx, nir, &data, &shader,
+                                                  &binary, &binary_size)) {
+      mesa_loge("pvr: compute fallback: shader compile failed");
+      return false;
+   }
+   sd = pco_shader_data(shader);
+
+   /* PDS programs from the shader's pco data. */
+   pvr_pds_compute_shader_program_init(&kern_prog);
+   kern_prog.flattened_work_groups = true;
+   kern_prog.kick_usc = true;
+   if (sd->common.sys_vals[SYSTEM_VALUE_LOCAL_INVOCATION_INDEX].count > 0)
+      kern_prog.local_input_regs[0] =
+         sd->common.sys_vals[SYSTEM_VALUE_LOCAL_INVOCATION_INDEX].start;
+   for (unsigned u = 0; u < 3; u++) {
+      if (sd->common.sys_vals[SYSTEM_VALUE_WORKGROUP_ID].count > u &&
+          (sd->cs.workgroup_id_mask & BITFIELD_BIT(u)))
+         kern_prog.work_group_input_regs[u] =
+            sd->common.sys_vals[SYSTEM_VALUE_WORKGROUP_ID].start + u;
+      if (sd->common.sys_vals[SYSTEM_VALUE_NUM_WORKGROUPS].count > u)
+         kern_prog.num_work_groups_regs[u] =
+            sd->common.sys_vals[SYSTEM_VALUE_NUM_WORKGROUPS].start + u;
+   }
+
+   pvr_pds_compute_shader_program_init(&fence_prog);
+   fence_prog.fence = true;
+   fence_prog.clear_pds_barrier = true;
+
+   /* Descriptor upload program + its dispatch-time data segment. */
+   din.descriptor_set_count = 1;
+   din.descriptor_sets[0] = (struct pvr_pds_descriptor_set){
+      .descriptor_set = 0,
+      .size_in_dwords = sd->common.desc_sets[0].range.count,
+      .destination = sd->common.desc_sets[0].range.start,
+   };
+   din.buffer_count = 1;
+   din.buffers[0] = (struct pvr_pds_buffer){
+      .type = PVR_BUFFER_TYPE_COMPILE_TIME,
+      .size_in_dwords = sd->common.literals.count,
+      .destination = sd->common.literals.start,
+   };
+   desc_entries = calloc(1, 4096);
+   if (desc_entries == NULL)
+      goto out;
+   dinfo.entries = (struct pvr_const_map_entry *)desc_entries;
+   dinfo.entries_size_in_bytes = 4096;
+   pvr_pds_generate_descriptor_upload_program(&din, NULL, &dinfo);
+   desc_code = calloc(dinfo.code_size_in_dwords ? dinfo.code_size_in_dwords : 1, 4);
+   if (desc_code == NULL)
+      goto out;
+   pvr_pds_generate_descriptor_upload_program(&din, desc_code, &dinfo);
+
+   /* The shader has two storage buffers: binding 0 is the render target, binding 1 the draw parameters.
+    * Record where pco's lowering put each binding in the descriptor set. */
+   if (sd->common.desc_sets[0].binding_count < 2 ||
+       !sd->common.desc_sets[0].bindings[0].used || !sd->common.desc_sets[0].bindings[1].used) {
+      mesa_loge("pvr: compute fallback: shader does not expose the two expected bindings");
+      goto out;
+   }
+   st->desc_set_dw = sd->common.desc_sets[0].range.count;
+   st->desc_off_target_dw = sd->common.desc_sets[0].bindings[0].range.start -
+                            sd->common.desc_sets[0].range.start;
+   st->desc_off_params_dw = sd->common.desc_sets[0].bindings[1].range.start -
+                            sd->common.desc_sets[0].range.start;
+
+   /* Allocate the pages the job references. */
+   st->desc_page_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->desc_bo);
+   st->params_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->params_bo);
+   st->ctrl_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->ctrl_bo);
+   st->state_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->state_bo);
+   st->border_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_GENERAL, 4096, &st->border_bo);
+   pds_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_PDS_CODE_DATA, PDS_PAGE_SIZE, &st->pds_bo);
+   usc_addr = pvr_compute_alloc(screen, DRM_PVR_HEAP_USC_CODE, 0x1000, &st->usc_bo);
+   if (!st->desc_page_addr || !st->params_addr || !st->ctrl_addr || !st->state_addr ||
+       !st->border_addr || !pds_addr || !usc_addr) {
+      mesa_loge("pvr: compute fallback: heap allocation failed");
+      goto out;
+   }
+   pds_base_off = (uint32_t)(pds_addr - pds_heap->base);
+   if (pds_base_off > 0x1000) {
+      mesa_loge("pvr: compute fallback: PDS page at unexpected heap offset 0x%x", pds_base_off);
+      goto out;
+   }
+   st->pds_base_addr = pds_heap->base + pds_base_off;
+   st->pds_base_off = pds_base_off;
+
+   /* Generate the kernel and fence programs with the USC program address. */
+   pvr_pds_setup_doutu(&kern_prog.usc_task_control, usc_addr, sd->common.temps,
+                       ROGUE_PDSINST_DOUTU_SAMPLE_RATE_INSTANCE, false);
+   pvr_pds_compute_shader(&kern_prog, NULL, PDS_GENERATE_SIZES, &screen->dev_info);
+   pvr_pds_compute_shader(&fence_prog, NULL, PDS_GENERATE_SIZES, &screen->dev_info);
+   kern_stage = calloc(kern_prog.data_size + kern_prog.code_size / 4 + 8, 4);
+   fence_stage = calloc(fence_prog.data_size + fence_prog.code_size / 4 + 8, 4);
+   if (kern_stage == NULL || fence_stage == NULL)
+      goto out;
+   pvr_pds_compute_shader(&kern_prog, &kern_stage[0], PDS_GENERATE_DATA_SEGMENT, &screen->dev_info);
+   pvr_pds_compute_shader(&kern_prog, &kern_stage[kern_prog.data_size], PDS_GENERATE_CODE_SEGMENT,
+                          &screen->dev_info);
+   pvr_pds_compute_shader(&fence_prog, &fence_stage[0], PDS_GENERATE_DATA_SEGMENT, &screen->dev_info);
+   pvr_pds_compute_shader(&fence_prog, &fence_stage[fence_prog.data_size], PDS_GENERATE_CODE_SEGMENT,
+                          &screen->dev_info);
+
+   st->kern_data_dw = kern_prog.data_size;
+   st->kern_code_dw = kern_prog.code_size / 4;
+   st->fence_data_dw = fence_prog.data_size;
+   st->fence_code_dw = fence_prog.code_size / 4;
+   st->desc_data_dw = dinfo.data_size_in_dwords;
+   st->desc_code_dw = dinfo.code_size_in_dwords;
+   st->usc_common_units = DIV_ROUND_UP((sd->common.coeffs + sd->common.shareds) * 4, 64);
+   st->usc_unified_units = DIV_ROUND_UP(sd->common.vtxins * 4, 16);
+   st->pds_temp_units = DIV_ROUND_UP(MAX2(kern_prog.temps_used, 1) * 4, 16);
+   st->kern_code_off = ALIGN_POT(PDS_KERN_DATA_OFF + kern_prog.data_size * 4, 16);
+   st->fence_code_off = ALIGN_POT(PDS_FENCE_DATA_OFF + fence_prog.data_size * 4, 16);
+
+   /* Place the programs in the PDS page. */
+   {
+      uint8_t *pds = st->pds_bo.map;
+
+#define PUT(_off, _src, _bytes)                                            \
+      do {                                                                 \
+         if ((_off) + (_bytes) > PDS_PAGE_SIZE)                            \
+            goto out;                                                      \
+         memcpy(pds + (_off), (_src), (_bytes));                            \
+      } while (0)
+
+      PUT(PDS_FENCE_DATA_OFF, fence_stage, fence_prog.data_size * 4);
+      PUT(st->fence_code_off, (uint8_t *)fence_stage + fence_prog.data_size * 4,
+          (uint32_t)(fence_prog.code_size / 4) * 4);
+      PUT(PDS_DESC_CODE_OFF, desc_code, dinfo.code_size_in_dwords * 4);
+      PUT(PDS_KERN_DATA_OFF, kern_stage, kern_prog.data_size * 4);
+      PUT(st->kern_code_off, (uint8_t *)kern_stage + kern_prog.data_size * 4,
+          (uint32_t)(kern_prog.code_size / 4) * 4);
+#undef PUT
+   }
+
+   /* Dispatch-time descriptor data segment: descriptor set and literal pool addresses from the
+    * generated const-map entries. */
+   {
+      const uint8_t *e = (const uint8_t *)dinfo.entries;
+      const uint8_t *end = e + dinfo.entries_written_size_in_bytes;
+      uint32_t *seg = (uint32_t *)st->pds_bo.map + PDS_DESC_DATA_OFF / 4;
+      unsigned written = 0;
+
+      if (dinfo.data_size_in_dwords > 0x100)
+         goto out;
+      memset(seg, 0, dinfo.data_size_in_dwords * 4);
+      while (e < end) {
+         const struct pvr_const_map_entry *hdr = (const struct pvr_const_map_entry *)e;
+
+         if (hdr->type == PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL32) {
+            const struct pvr_const_map_entry_literal32 *lit =
+               (const struct pvr_const_map_entry_literal32 *)e;
+
+            if (lit->const_offset < dinfo.data_size_in_dwords)
+               seg[lit->const_offset] = lit->literal_value;
+            e += sizeof(*lit);
+         } else if (hdr->type == PVR_PDS_CONST_MAP_ENTRY_TYPE_DESCRIPTOR_SET) {
+            const struct pvr_const_map_entry_descriptor_set *d =
+               (const struct pvr_const_map_entry_descriptor_set *)e;
+
+            if (d->const_offset / 2 < dinfo.data_size_in_dwords / 2)
+               ((uint64_t *)seg)[d->const_offset / 2] = st->desc_page_addr + DESC_SET_OFF;
+            e += sizeof(*d);
+         } else if (hdr->type == PVR_PDS_CONST_MAP_ENTRY_TYPE_SPECIAL_BUFFER) {
+            const struct pvr_const_map_entry_special_buffer *sp =
+               (const struct pvr_const_map_entry_special_buffer *)e;
+
+            if (sp->const_offset / 2 < dinfo.data_size_in_dwords / 2)
+               ((uint64_t *)seg)[sp->const_offset / 2] = st->desc_page_addr + DESC_LITERALS_OFF;
+            e += sizeof(*sp);
+         } else {
+            break;
+         }
+         written++;
+      }
+      if (written == 0)
+         goto out;
+   }
+
+   /* USC program and the compile-time literal pool. */
+   memcpy(st->usc_bo.map, binary, binary_size);
+   {
+      uint32_t i;
+      uint8_t *dst = (uint8_t *)st->desc_bo.map + DESC_LITERALS_OFF;
+
+      if (sd->common.literals.count > (DESC_SET_OFF - DESC_LITERALS_OFF) / 4)
+         goto out;
+      for (i = 0; i < sd->common.literals.count; i++)
+         memcpy(dst + 4 * i, &sd->common.literal_vals[i], 4);
+   }
+
+   /* Compute fw stream. */
+   {
+      uint32_t *fw = st->fw_stream;
+      struct ROGUE_KMD_STREAM_HDR hdr = { .length = 0 };
+      struct ROGUE_CR_TPU_BORDER_COLOUR_TABLE_CDM border = {
+         .border_colour_table_address = st->border_addr,
+      };
+      struct ROGUE_CR_CDM_CTRL_STREAM_BASE ctrl = { .addr = st->ctrl_addr };
+      struct ROGUE_CR_CDM_CONTEXT_STATE_BASE state = { .addr = st->state_addr };
+      struct ROGUE_CR_CDM_CONTEXT_PDS1 pds1 = {
+         .unified_size = 4,
+         .common_shared = true,
+         .common_size = 1,
+         .data_size = 4,
+      };
+      uint32_t *p = fw + ROGUE_KMD_STREAM_HDR_length;
+
+      ROGUE_CR_TPU_BORDER_COLOUR_TABLE_CDM_pack(p, &border);
+      p += ROGUE_CR_TPU_BORDER_COLOUR_TABLE_CDM_length;
+      ROGUE_CR_CDM_CTRL_STREAM_BASE_pack(p, &ctrl);
+      p += ROGUE_CR_CDM_CTRL_STREAM_BASE_length;
+      ROGUE_CR_CDM_CONTEXT_STATE_BASE_pack(p, &state);
+      p += ROGUE_CR_CDM_CONTEXT_STATE_BASE_length;
+      ROGUE_CR_CDM_CONTEXT_PDS1_pack(p, &pds1);
+      p += ROGUE_CR_CDM_CONTEXT_PDS1_length;
+      *p++ = 0; /* feature-gated fields (cdm_item / compute_cluster) unused on this device */
+      *p++ = 0;
+      hdr.length = (uint32_t)(p - fw) * 4;
+      ROGUE_KMD_STREAM_HDR_pack(fw, &hdr);
+      st->fw_stream_len = hdr.length;
+   }
+
+   /* Compute context: the dispatch does not use the reference's context-switch programs. */
+   {
+      struct drm_pvr_ioctl_create_context_args cargs = {
+         .type = DRM_PVR_CTX_TYPE_COMPUTE,
+         .vm_context_handle = vm->context_handle,
+      };
+      uint64_t ctx_state[8] = { 0 };
+      int ret;
+
+      ctx_state[0] = sizeof(ctx_state);
+      cargs.static_context_state = (uint64_t)(uintptr_t)ctx_state;
+      cargs.static_context_state_len = sizeof(ctx_state);
+      ret = drmIoctl(screen->fd, DRM_IOCTL_PVR_CREATE_CONTEXT, &cargs);
+      if (ret != 0) {
+         mesa_loge("pvr: compute fallback: compute context creation failed: %s", strerror(errno));
+         goto out;
+      }
+      st->ctx_handle = cargs.handle;
+   }
+
+   st->ctrl_valid = false;
+   ok = true;
+out:
+   free(desc_entries);
+   free(desc_code);
+   free(kern_stage);
+   free(fence_stage);
+   ralloc_free(shader);
+   return ok;
+}
+
+bool
+pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target,
+                            const float vertices_ndc[12])
+{
+   struct pvr_screen *screen = pvr_screen(ctx->base.screen);
+   unsigned w = target->base.width0, h = target->base.height0;
+   uint32_t wg_x, wg_y;
+   uint32_t params[14];
+
+   if (target->dev_addr == 0 || target->base.target != PIPE_TEXTURE_2D ||
+       target->base.format != PIPE_FORMAT_R8G8B8A8_UNORM || w == 0 || h == 0) {
+      mesa_loge("pvr: compute fallback: target must be a non-empty RGBA8 2D texture");
+      return false;
+   }
+   if (!screen->vm_valid)
+      return false;
+
+   if (ctx->compute == NULL) {
+      ctx->compute = CALLOC_STRUCT(pvr_compute_state);
+      if (ctx->compute == NULL)
+         return false;
+      ctx->compute->async = getenv("PVR_COMPUTE_ASYNC") != NULL;
+      if (!pvr_compute_build(ctx->compute, ctx))
+         return false;
+   }
+
+   /* Per-draw parameters: three clip-space vertices followed by the target size (the shader's
+    * parameter buffer layout; large members first keeps pco's layout lowering happy). */
+   memcpy(&params[0], vertices_ndc, 12 * sizeof(float));
+   params[12] = w;
+   params[13] = h;
+   memcpy(ctx->compute->params_bo.map, params, sizeof(params));
+
+   /* Descriptor set contents: { buffer address, size, offset } per binding. */
+   {
+      struct pvr_buffer_desc {
+         uint64_t addr;
+         uint32_t size;
+         uint32_t offset;
+      } __attribute__((packed)) bdesc;
+      uint8_t *set = (uint8_t *)ctx->compute->desc_bo.map + DESC_SET_OFF;
+
+      bdesc.addr = target->dev_addr;
+      bdesc.size = (uint32_t)target->dev_size;
+      bdesc.offset = 0;
+      memcpy(set + 4 * ctx->compute->desc_off_target_dw, &bdesc, sizeof(bdesc));
+      bdesc.addr = ctx->compute->params_addr;
+      bdesc.size = 4096;
+      bdesc.offset = 0;
+      memcpy(set + 4 * ctx->compute->desc_off_params_dw, &bdesc, sizeof(bdesc));
+   }
+
+   /* Rebuild the control stream when the dispatch shape changed. */
+   wg_x = DIV_ROUND_UP(w, PVR_COMPUTE_LOCAL_X * PVR_COMPUTE_BLOCK_X);
+   wg_y = DIV_ROUND_UP(h, PVR_COMPUTE_LOCAL_Y * PVR_COMPUTE_BLOCK_Y);
+   if (!ctx->compute->ctrl_valid || ctx->compute->wg_x != wg_x || ctx->compute->wg_y != wg_y) {
+      ctx->compute->wg_x = wg_x;
+      ctx->compute->wg_y = wg_y;
+      if (!pvr_compute_build_ctrl_stream(ctx->compute))
+         return false;
+   }
+
+   if (ctx->compute->async) {
+      uint32_t sync = 0;
+
+      if (ctx->compute->nr_pending == ARRAY_SIZE(ctx->compute->pending) &&
+          !pvr_compute_flush(ctx->compute))
+         return false;
+      if (!pvr_job_submit_compute_async(&screen->vm, ctx->compute->ctx_handle,
+                                        ctx->compute->fw_stream, ctx->compute->fw_stream_len,
+                                        &sync))
+         return false;
+      ctx->compute->pending[ctx->compute->nr_pending++] = sync;
+      return true;
+   }
+
+   pvr_job_submit_compute_sync(&screen->vm, ctx->compute->ctx_handle, ctx->compute->fw_stream,
+                               ctx->compute->fw_stream_len, 2000);
+   return true;
+}
+
+bool
+pvr_compute_flush(struct pvr_compute_state *state)
+{
+   struct pvr_vm *vm;
+   bool ok = true;
+   unsigned i;
+
+   if (state == NULL || state->nr_pending == 0)
+      return true;
+   vm = &state->screen->vm;
+   for (i = 0; i < state->nr_pending; i++)
+      ok &= pvr_compute_sync_wait(vm, state->pending[i], 2000);
+   state->nr_pending = 0;
+   return ok;
+}
+
+void
+pvr_compute_state_finish(struct pvr_compute_state *state)
+{
+   struct pvr_screen *screen;
+   int fd;
+
+   if (state == NULL)
+      return;
+   screen = state->screen;
+   fd = screen->fd;
+   pvr_compute_flush(state);
+   if (state->ctx_handle) {
+      uint32_t handle = state->ctx_handle;
+
+      drmIoctl(fd, DRM_IOCTL_PVR_DESTROY_CONTEXT, &handle);
+   }
+   pvr_bo_destroy(fd, &state->desc_bo);
+   pvr_bo_destroy(fd, &state->params_bo);
+   pvr_bo_destroy(fd, &state->ctrl_bo);
+   pvr_bo_destroy(fd, &state->state_bo);
+   pvr_bo_destroy(fd, &state->border_bo);
+   pvr_bo_destroy(fd, &state->pds_bo);
+   pvr_bo_destroy(fd, &state->usc_bo);
+   FREE(state);
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_compute.h b/src/gallium/drivers/pvr_native/pvr_compute.h
new file mode 100644
index 00000000..d12edf9a
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_compute.h
@@ -0,0 +1,81 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The compute fallback render path.
+ *
+ * The fixed-function 3D path (TA/TPC rasterisation) is not usable yet, so a draw is executed by a compute
+ * shader that rasterises into the bound colour buffer. This is a real GPU draw: the driver compiles the
+ * shader with pco, generates the PDS programs and CDM streams itself, submits a compute job through its
+ * own VM, and the pixels land in the render target memory. The triangle covers the same area a 3D draw of
+ * the shader's geometry would; replacing it with the fixed-function path later is a matter of changing
+ * what draw_vbo submits, not of inventing a submission path.
+ */
+#ifndef PVR_COMPUTE_H
+#define PVR_COMPUTE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "pvr_bo.h"
+
+struct pvr_context;
+struct pvr_resource;
+struct pvr_screen;
+
+struct pvr_compute_state {
+   struct pvr_screen *screen;
+   uint32_t ctx_handle;
+   bool ready;
+
+   struct pvr_bo desc_bo;    /* descriptor set + compile-time literal pool page */
+   struct pvr_bo params_bo;  /* per-draw parameters: target size and the three clip-space vertices */
+   struct pvr_bo ctrl_bo;    /* CDM control stream */
+   struct pvr_bo state_bo;   /* compute context state (zeroes: no context switch needed) */
+   struct pvr_bo border_bo;  /* border colour table base (unused by this shader) */
+   struct pvr_bo pds_bo;     /* PDS programs: fence, descriptor program, compute kernel, descriptor data */
+   struct pvr_bo usc_bo;     /* the shader's USC program */
+
+   uint64_t desc_page_addr;
+   uint64_t params_addr;
+   uint64_t ctrl_addr;
+   uint64_t state_addr;
+   uint64_t border_addr;
+
+   uint32_t fw_stream[16];
+   uint32_t fw_stream_len;
+
+   /* What the control stream was built for: the dispatch's workgroup counts. Rebuilt when a draw uses a
+    * different target size. */
+   uint32_t wg_x, wg_y;
+   bool ctrl_valid;
+
+   /* PDS program geometry recorded at build time, so the control stream can be regenerated. */
+   uint64_t pds_base_addr;
+   uint32_t pds_base_off;
+   uint32_t kern_code_off, fence_code_off;
+   uint32_t kern_data_dw, kern_code_dw, fence_data_dw, fence_code_dw, desc_data_dw, desc_code_dw;
+   uint32_t usc_common_units, usc_unified_units, pds_temp_units;
+
+   /* Where binding 0 (render target) and binding 1 (draw parameters) sit in the descriptor set. */
+   uint32_t desc_off_target_dw, desc_off_params_dw;
+   uint32_t desc_set_dw;
+
+   /* Asynchronous submit (env PVR_COMPUTE_ASYNC): draws are submitted without waiting and the
+    * completion syncobjs are collected here, so an application can overlap CPU work with the GPU. */
+   bool async;
+   uint32_t pending[8];
+   unsigned nr_pending;
+};
+
+/* Lazily build the compute state (shader, programs, streams, compute context) and render the triangle.
+ * `vertices_ndc` is three clip-space (x, y, z, w) vertices from the vertex stage; `target` is the bound
+ * RGBA8 2D render target. Returns true when the job was submitted. */
+bool pvr_compute_render_triangle(struct pvr_context *ctx, struct pvr_resource *target,
+                                 const float vertices_ndc[12]);
+
+/* Wait for every outstanding asynchronous draw and release their syncobjs. */
+bool pvr_compute_flush(struct pvr_compute_state *state);
+
+void pvr_compute_state_finish(struct pvr_compute_state *state);
+
+#endif /* PVR_COMPUTE_H */
