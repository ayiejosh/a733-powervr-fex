+         /* In a loop the bodies can run in successive iterations. */
+         for (pco_cf_node *up = na->parent->parent; up; up = up->parent) {
+            if (up->type == PCO_CF_NODE_TYPE_LOOP)
+               return false;
+         }
+
+         return true;
+      }
+   }
+
+   return false;
