+/* Called before a draw: marks the pending clears that a bound descriptor set
+ * may read (a set tracks the images written into it).
+ */
+static void pvr_clear_fold_note_reads(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+
+   if (!state->pending_clear_count && !state->consumed_clear_count)
+      return;
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(state->gfx_desc_state.sets); i++) {
+      const struct pvr_descriptor_set *set = state->gfx_desc_state.sets[i];
+
+      if (!set)
+         continue;
+
+      for (uint32_t e = 0; e < state->pending_clear_count; e++) {
+         if (pvr_set_may_read_image(set, state->pending_clears[e].iview->vk.image))
+            state->pending_clears[e].read = true;
+      }
+
+      for (uint32_t e = 0; e < state->consumed_clear_count; e++) {
+         if (pvr_set_may_read_image(set, state->consumed_clears[e].iview->vk.image))
+            state->consumed_clears[e].read = true;
+      }
+   }
+}
+
+/* Called after a pass ended: the clears its draws may have read must run before
+ * it, so submit them and move the pass behind them.
+ */
+static void pvr_clear_fold_flush_reads(struct pvr_cmd_buffer *cmd_buffer,
+                                       struct list_head *pass_prev)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+   struct pvr_pending_clear held[PVR_MAX_PENDING_CLEARS];
+   struct pvr_pending_clear reads[PVR_MAX_PENDING_CLEARS];
+   uint32_t num_held = 0;
+   uint32_t num_reads = 0;
+
+   /* A pass that read the clear it took over needs it in memory first. */
+   for (uint32_t e = 0; e < state->consumed_clear_count; e++) {
+      if (!state->consumed_clears[e].read)
+         continue;
+
+      if (state->pending_clear_count == PVR_MAX_PENDING_CLEARS)
+         pvr_clear_fold_flush(cmd_buffer);
+
+      state->pending_clears[state->pending_clear_count++] =
+         state->consumed_clears[e];
+   }
+   state->consumed_clear_count = 0;
+
+   for (uint32_t e = 0; e < state->pending_clear_count; e++) {
+      if (state->pending_clears[e].read)
+         reads[num_reads++] = state->pending_clears[e];
+      else
+         held[num_held++] = state->pending_clears[e];
+   }
+
+   if (!num_reads)
+      return;
+
+   struct list_head *pass_tail = cmd_buffer->sub_cmds.prev;
+
+   memcpy(state->pending_clears, reads, num_reads * sizeof(reads[0]));
+   state->pending_clear_count = num_reads;
+   pvr_clear_fold_flush(cmd_buffer);
+
+   memcpy(state->pending_clears, held, num_held * sizeof(held[0]));
+   state->pending_clear_count = num_held;
+
+   /* Everything the pass added (event, query, copy-back and resolve
+    * sub-commands too) stays in order behind the clear sub-commands that the
+    * flush appended after it.
+    */
+   struct list_head *after = pass_prev;
+   struct list_head *node = pass_tail->next;
+   while (node != &cmd_buffer->sub_cmds) {
+      struct list_head *next = node->next;
+
+      list_del(node);
+      list_add(node, after);
+      after = node;
+      node = next;
+   }
+}
+
+/* Called by vkCmdEndRendering once the pass was cancelled. */
+static void pvr_clear_fold_push(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_cmd_buffer_state *const state = &cmd_buffer->state;
+
+   if (state->pending_clear_count + state->candidate_clear_count >
+       PVR_MAX_PENDING_CLEARS)
+      pvr_clear_fold_flush(cmd_buffer);
+
+   const uint32_t pass_id = state->pending_clear_next_pass++;
+   for (uint32_t i = 0; i < state->candidate_clear_count; i++) {
+      state->pending_clears[state->pending_clear_count] =
+         state->candidate_clears[i];
+      state->pending_clears[state->pending_clear_count++].pass_id = pass_id;
+   }
+}
