+struct pvr_transfer {
+   struct pipe_transfer base;
+   /* A twiddled/TFBC target is mapped through a linear copy the GPU makes (and writes back). */
+   struct pipe_resource *staging;
+};
+
+/* Shared by the buffer and texture entry points: this Mesa version split the old
+ * transfer_map into buffer_map and texture_map, and the two differ only in how the
+ * caller expresses the offset. */
+static void *
+pvr_transfer_map(struct pipe_context *pctx, struct pipe_resource *pres,
+                 unsigned level, unsigned usage, const struct pipe_box *box,
+                 struct pipe_transfer **out_transfer)
+{
+   struct pvr_screen *screen = pvr_screen(pctx->screen);
+   struct pvr_resource *res = pvr_resource(pres);
+   /* Submit the open render only if it uses this resource (renders are waited for when
+    * submitted, so nothing older is in flight). */
+   if (!(usage & PIPE_MAP_UNSYNCHRONIZED))
+      pvr_draw_resource_sync(pvr_context(pctx), res);
+   struct pvr_transfer *trans;
+   uint64_t offset;
+
+   /* A twiddled/TFBC colour target (or a level of a twiddled mip chain) is read and written
+    * through a linear copy of the level: the GPU decodes it into the staging resource (unless the
+    * content is discarded) and, after a write, encodes it back on unmap. Twiddled depth is only
+    * written by the ZLS. */
+   if (res->twiddled) {
+      struct pvr_context *ctx = pvr_context(pctx);
+      /* A cube map is mapped one face at a time: the box's z selects the face. */
+      const unsigned layer = res->cube ? (unsigned)box->z : 0;
+      if (util_format_is_depth_or_stencil(pres->format) || level > pres->last_level ||
+          box->depth != 1 || (res->cube && box->z >= 6)) {
+         mesa_loge("pvr: transfer_map on twiddled depth or level %u of %u is not supported", level,
+                   pres->last_level);
+         return NULL;
+      }
+      struct pipe_resource templ = *pres;
+      templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_LINEAR;
+      templ.target = PIPE_TEXTURE_2D;
+      templ.array_size = 1;
+      templ.width0 = u_minify(pres->width0, level);
+      templ.height0 = u_minify(pres->height0, level);
+      templ.last_level = 0;
+      templ.next = NULL;
+      struct pipe_resource *staging = pctx->screen->resource_create(pctx->screen, &templ);
+      if (staging == NULL)
+         return NULL;
+      /* A write that replaces the whole level needs no read back. */
+      const bool whole = (usage & PIPE_MAP_DISCARD_WHOLE_RESOURCE) ||
+                         ((usage & PIPE_MAP_DISCARD_RANGE) && box->x == 0 && box->y == 0 &&
+                          box->width == (int)templ.width0 && box->height == (int)templ.height0);
+      if (!whole && !pvr_draw_blit(ctx, staging, 0, 0, pres, level, layer, false)) {
+         pipe_resource_reference(&staging, NULL);
+         return NULL;
+      }
+      struct pipe_box sbox = *box;
+      sbox.z = 0;
+      sbox.depth = 1;
+      void *map = pvr_transfer_map(pctx, staging, 0, usage & ~PIPE_MAP_UNSYNCHRONIZED, &sbox,
+                                   out_transfer);
+      if (map == NULL) {
+         pipe_resource_reference(&staging, NULL);
+         return NULL;
+      }
+      struct pvr_transfer *t = (struct pvr_transfer *)*out_transfer;
+      pipe_resource_reference(&t->base.resource, pres);
+      t->base.level = level;
+      t->base.box = *box;
+      t->staging = staging;
+      return map;
+   }
+   if (level != 0 || box->depth != 1) {
+      mesa_loge("pvr: refusing a transfer at level %u depth %u", level, box->depth);
+      return NULL;
+   }
+
+   /* Mapped on demand and left mapped. The mapping is write-combined, so CPU writes
+    * are visible to the device without an explicit flush and there is nothing to
+    * bracket - which is also why transfer_flush_region is a no-op below. */
+   if (res->bo.map == NULL && !pvr_bo_map(screen->fd, &res->bo))
+      return NULL;
+
+   trans = CALLOC_STRUCT(pvr_transfer);
+   if (!trans)
+      return NULL;
+
+   pipe_resource_reference(&trans->base.resource, pres);
+   trans->base.level = level;
+   trans->base.usage = usage;
+   trans->base.box = *box;
+   trans->base.stride = res->stride;
+   trans->base.layer_stride =
+      res->stride ? (uint64_t)res->stride * pres->height0 : 0;
+
+   /* A buffer resource has no stride; there the box's x is already the byte offset.
+    * For a texture the block size converts a pixel column into a byte column - which
+    * matters for the 16-bit formats, where assuming 4 bytes per pixel would read and
+    * write the wrong memory. */
+   if (res->stride != 0) {
+      offset = (uint64_t)box->y * res->stride +
+               (uint64_t)box->x * util_format_get_blocksize(pres->format);
+   } else {
+      offset = box->x;
+   }
+
+   *out_transfer = &trans->base;
+
+   return (uint8_t *)res->bo.map + offset;
+}
+
+static void
+pvr_transfer_unmap(struct pipe_context *pctx, struct pipe_transfer *transfer)
+{
+   struct pvr_transfer *trans = (struct pvr_transfer *)transfer;
+   if (trans->staging != NULL) {
+      if (trans->base.usage & PIPE_MAP_WRITE) {
+         const struct pvr_resource *res = pvr_resource(trans->base.resource);
+         const unsigned layer = res->cube ? (unsigned)trans->base.box.z : 0;
+         pvr_draw_blit(pvr_context(pctx), trans->base.resource, trans->base.level, layer,
+                       trans->staging, 0, 0, false);
+      }
+      pipe_resource_reference(&trans->staging, NULL);
+   }
+   pipe_resource_reference(&trans->base.resource, NULL);
+   FREE(trans);
+}
+
+static void
+pvr_transfer_flush_region(UNUSED struct pipe_context *pctx,
+                          UNUSED struct pipe_transfer *transfer,
+                          UNUSED const struct pipe_box *box)
+{
+   /* Nothing to do. The only mapping available here is write-combined, whose reads are
+    * uncached, so a CPU write is already visible to the device. A cacheable mapping
+    * would need real maintenance - and this kernel has no userspace path for it, which
+    * is the other reason not to use one. */
+}
+
+/* Not a stub for its own sake: the state tracker calls flush on every context unbind,
+ * so its absence is a crash on the way out of any GL context that was successfully
+ * created. There is no command stream to submit yet, so there is genuinely nothing to
+ * do, and no fence is produced - which is the correct answer for "nothing pending". */
+static void
+pvr_flush(struct pipe_context *pctx, struct pipe_fence_handle **fence, UNUSED unsigned flags)
+{
+   struct pvr_context *ctx = pvr_context(pctx);
+   pvr_draw_flush(ctx);
+   if (fence != NULL) {
+      struct pipe_fence_handle *f =
+         pvr_fence_create(pvr_screen(pctx->screen), pvr_draw_last_sync(ctx));
+      pctx->screen->fence_reference(pctx->screen, fence, NULL);
+      *fence = f;
+   }
+   /* Completes any asynchronous compute-fallback draws (PVR_COMPUTE_ASYNC). */
+   pvr_compute_flush(ctx->compute);
+}
+
+/* The state tracker calls sampler_view_release unconditionally while tearing a
+ * context down (st_context.c), whether or not the driver ever handed it a view. This
+ * driver creates none yet, so there is nothing to release or destroy - but a NULL
+ * hook here is a crash on the way out of every GL context, exactly like flush. */
+static void
+pvr_sampler_view_destroy(UNUSED struct pipe_context *pctx, struct pipe_sampler_view *view)
+{
+   pipe_resource_reference(&view->texture, NULL);
+   FREE(view);
+}
+
+/* Drops one reference; the view goes with the last one. */
+static void
+pvr_sampler_view_release(struct pipe_context *pctx, struct pipe_sampler_view *view)
+{
+   if (pipe_reference(&view->reference, NULL))
+      pvr_sampler_view_destroy(pctx, view);
+}
+
+static inline int
+pvr_stage_index(mesa_shader_stage shader)
+{
+   return shader == MESA_SHADER_VERTEX ? 0 : shader == MESA_SHADER_FRAGMENT ? 1 : -1;
+}
+
+/* The gallium context contract. cso_unbind_context() calls this entire set on every
+ * context teardown, whether or not anything was ever bound, so a NULL hook anywhere in
+ * it is a crash on the way out of any GL context. There is no command stream and no
+ * state yet, so "bind nothing" and "set nothing" are the truthful implementations
+ * rather than placeholders.
+ *
+ * ponytail: stateless on purpose. When the draw path lands these must record what was
+ * bound - ignoring state at that point would mean drawing with whatever the hardware
+ * last happened to hold. The ceiling is named here so it is not mistaken for finished. */
+#define PVR_DEFINE_BIND_NOOP(name)                                            \
+   static void name(UNUSED struct pipe_context *pctx, UNUSED void *state)      \
+   {                                                                          \
+   }
+
+PVR_DEFINE_BIND_NOOP(pvr_bind_state_noop)
+
+static void
+pvr_bind_sampler_states(struct pipe_context *pctx, mesa_shader_stage shader,
+                        unsigned start_slot, unsigned num_samplers, void **samplers)
+{
+   struct pvr_context *ctx = pvr_context(pctx);
+   const int s = pvr_stage_index(shader);
+
+   if (s < 0)
+      return;
+   for (unsigned i = 0; i < num_samplers && start_slot + i < PVR_MAX_TEXTURE_UNITS; i++)
+      ctx->samplers[s][start_slot + i] = samplers ? samplers[i] : NULL;
+}
+
+static void
+pvr_set_sampler_views(struct pipe_context *pctx, mesa_shader_stage shader,
+                      unsigned start_slot, unsigned num_views,
+                      unsigned unbind_num_trailing_slots, struct pipe_sampler_view **views)
+{
+   struct pvr_context *ctx = pvr_context(pctx);
+   const int s = pvr_stage_index(shader);
+
+   if (s < 0)
+      return;
+   for (unsigned i = 0; i < num_views + unbind_num_trailing_slots; i++) {
+      const unsigned slot = start_slot + i;
+      struct pipe_sampler_view *view = i < num_views && views ? views[i] : NULL;
+      if (slot >= PVR_MAX_TEXTURE_UNITS)
+         break;
+      if (view)
+         pipe_reference(NULL, &view->reference);
+      if (ctx->views[s][slot])
+         pvr_sampler_view_release(pctx, ctx->views[s][slot]);
+      ctx->views[s][slot] = view;
+   }
+}
