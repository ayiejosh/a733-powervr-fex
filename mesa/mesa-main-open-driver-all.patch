+      .context_switch = false,
+      /* A COUNT field: the capture carries 0 for one viewport. */
+      .view_port_count = pres->viewport_count ? pres->viewport_count - 1 : 0,
+   };
+   uint32_t *dw = pvr_csb_emit(csb, ROGUE_TA_STATE_HEADER_length);
