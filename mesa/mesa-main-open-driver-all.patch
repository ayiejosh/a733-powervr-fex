+/* A copy of a whole level between colour target resources is one GPU render (instead of two
+ * staging copies through the CPU); anything else goes through the CPU maps. */
+static void
+pvr_resource_copy_region(struct pipe_context *pctx, struct pipe_resource *dst, unsigned dst_level,
+                         unsigned dstx, unsigned dsty, unsigned dstz, struct pipe_resource *src,
+                         unsigned src_level, const struct pipe_box *box)
+{
+   const bool dst_cube = dst->target == PIPE_TEXTURE_CUBE;
+   const bool src_cube = src->target == PIPE_TEXTURE_CUBE;
+   if (dst->target != PIPE_BUFFER && src->target != PIPE_BUFFER && dstx == 0 && dsty == 0 &&
+       (!dst_cube ? dstz == 0 : dstz < 6) && box->x == 0 && box->y == 0 &&
+       (!src_cube ? box->z == 0 : box->z < 6) && box->depth == 1 &&
+       dst->format == src->format &&
+       box->width == (int)u_minify(src->width0, src_level) &&
+       box->height == (int)u_minify(src->height0, src_level) &&
+       pvr_draw_blit(pvr_context(pctx), dst, dst_level, dst_cube ? dstz : 0, src, src_level,
+                     src_cube ? (unsigned)box->z : 0, false))
+      return;
+   util_resource_copy_region(pctx, dst, dst_level, dstx, dsty, dstz, src, src_level, box);
+}
+
+/* shortcut: no GPU blit yet. Same-format, unscaled copies go through the CPU; anything else is
+ * reported and skipped. */
+static void
+pvr_blit(struct pipe_context *pctx, const struct pipe_blit_info *info)
+{
+   if (info->src.format == info->dst.format && info->src.box.width == info->dst.box.width &&
+       info->src.box.height == info->dst.box.height && info->mask == PIPE_MASK_RGBA &&
+       !info->scissor_enable) {
+      pctx->resource_copy_region(pctx, info->dst.resource, info->dst.level, info->dst.box.x,
+                                info->dst.box.y, info->dst.box.z, info->src.resource,
+                                info->src.level, &info->src.box);
+      return;
+   }
+   static bool warned;
+   if (!warned) {
+      warned = true;
+      mesa_logw("pvr: blit with conversion or scaling is not supported yet; skipped");
+   }
+}
+
+static void
+pvr_clear_render_target(struct pipe_context *pctx, struct pipe_surface *dst,
+                        const union pipe_color_union *color, unsigned x, unsigned y,
+                        unsigned w, unsigned h, UNUSED bool render_condition_enabled)
+{
+   pvr_draw_flush(pvr_context(pctx));
+   util_clear_render_target(pctx, dst, color, x, y, w, h);
+}
+
+static void
+pvr_clear_depth_stencil(struct pipe_context *pctx, struct pipe_surface *dst, unsigned flags,
+                        double depth, unsigned stencil, unsigned x, unsigned y, unsigned w,
+                        unsigned h, UNUSED bool render_condition_enabled)
+{
+   pvr_draw_flush(pvr_context(pctx));
+   util_clear_depth_stencil(pctx, dst, flags, depth, stencil, x, y, w, h);
+}
+
+static void
+pvr_context_destroy(struct pipe_context *pctx)
+{
+   struct pvr_context *ctx = pvr_context(pctx);
+   pvr_draw_destroy(ctx);
+   pvr_compute_state_finish(ctx->compute);
+   util_unreference_framebuffer_state(&ctx->fb);
+   if (ctx->base.stream_uploader)
+      u_upload_destroy(ctx->base.stream_uploader);
+   for (unsigned st = 0; st < 2; st++) {
+      for (unsigned u = 0; u < PVR_MAX_TEXTURE_UNITS; u++) {
+         if (ctx->views[st][u])
+            pvr_sampler_view_release(pctx, ctx->views[st][u]);
+      }
+   }
+   pipe_resource_reference(&ctx->cb0[0].buffer, NULL);
+   pipe_resource_reference(&ctx->cb0[1].buffer, NULL);
+   FREE(ctx);
+}
+
+/* Each level a GPU render of the 2x2 box filter of the one above it. A chain that keeps level 0
+ * only (a format the PBE cannot write, see pvr_resource_create) has nothing to generate. */
+static bool
+pvr_generate_mipmap(struct pipe_context *pctx, struct pipe_resource *pres,
+                    enum pipe_format format, unsigned base_level, unsigned last_level,
+                    UNUSED unsigned first_layer, UNUSED unsigned last_layer)
+{
+   if (format != pres->format)
+      return false;
+   const struct pvr_resource *res = pvr_resource(pres);
+   const unsigned faces = res->cube ? 6 : 1;
+   for (unsigned l = base_level + 1; l <= MIN2(last_level, pres->last_level); l++) {
+      for (unsigned f = 0; f < faces; f++) {
+         if (!pvr_draw_blit(pvr_context(pctx), pres, l, f, pres, l - 1, f, true))
+            return false;
+      }
+   }
+   return true;
+}
+
+struct pipe_context *
+pvr_context_create(struct pipe_screen *pscreen, UNUSED void *priv,
+                   UNUSED unsigned flags)
+{
+   struct pvr_context *ctx = CALLOC_STRUCT(pvr_context);
+
+   if (!ctx)
+      return NULL;
+
+   ctx->base.screen = pscreen;
+   ctx->base.destroy = pvr_context_destroy;
+   ctx->base.clear = pvr_clear;
+   ctx->base.flush = pvr_flush;
+   ctx->base.sampler_view_destroy = pvr_sampler_view_destroy;
+   ctx->base.sampler_view_release = pvr_sampler_view_release;
+
+   ctx->base.buffer_map = pvr_transfer_map;
+   ctx->base.generate_mipmap = pvr_generate_mipmap;
+   ctx->base.buffer_unmap = pvr_transfer_unmap;
+   ctx->base.texture_map = pvr_transfer_map;
+   ctx->base.texture_unmap = pvr_transfer_unmap;
+   ctx->base.transfer_flush_region = pvr_transfer_flush_region;
+
+   ctx->base.create_blend_state = pvr_create_blend_state;
+   ctx->base.bind_blend_state = pvr_bind_blend_state;
+   ctx->base.delete_blend_state = pvr_delete_state;
+   ctx->base.create_depth_stencil_alpha_state = pvr_create_depth_stencil_alpha_state;
+   ctx->base.bind_depth_stencil_alpha_state = pvr_bind_depth_stencil_alpha_state;
+   ctx->base.delete_depth_stencil_alpha_state = pvr_delete_state;
+   ctx->base.create_rasterizer_state = pvr_create_rasterizer_state;
+   ctx->base.bind_rasterizer_state = pvr_bind_rasterizer_state;
+   ctx->base.delete_rasterizer_state = pvr_delete_state;
+   ctx->base.set_viewport_states = pvr_set_viewport_states;
+   ctx->base.bind_vs_state = pvr_bind_vs_state;
+   ctx->base.bind_fs_state = pvr_bind_fs_state;
+   ctx->base.create_vs_state = pvr_create_vs_state;
+   ctx->base.create_fs_state = pvr_create_fs_state;
+   ctx->base.delete_vs_state = pvr_delete_vs_state;
+   ctx->base.delete_fs_state = pvr_delete_fs_state;
+   ctx->base.bind_gs_state = pvr_bind_state_noop;
+   ctx->base.bind_tcs_state = pvr_bind_state_noop;
+   ctx->base.bind_tes_state = pvr_bind_state_noop;
+   ctx->base.bind_ms_state = pvr_bind_state_noop;
+   ctx->base.bind_ts_state = pvr_bind_state_noop;
+   ctx->base.bind_compute_state = pvr_bind_state_noop;
+   ctx->base.bind_vertex_elements_state = pvr_bind_state_noop;
+   ctx->base.bind_sampler_states = pvr_bind_sampler_states;
+   ctx->base.set_sampler_views = pvr_set_sampler_views;
+   ctx->base.set_framebuffer_state = pvr_set_framebuffer_state;
+   ctx->base.set_constant_buffer = pvr_set_constant_buffer;
+   ctx->base.resource_release = pvr_resource_release;
+   ctx->base.set_vertex_buffers = pvr_set_vertex_buffers;
+   ctx->base.bind_vertex_elements_state = pvr_bind_vertex_elements_state;
+   ctx->base.create_vertex_elements_state = pvr_create_vertex_elements_state;
+   ctx->base.delete_vertex_elements_state = pvr_delete_vertex_elements_state;
+   ctx->base.create_sampler_state = pvr_create_sampler_state;
+   ctx->base.delete_sampler_state = pvr_delete_state;
+   ctx->base.create_sampler_view = pvr_create_sampler_view;
+   ctx->base.buffer_subdata = u_default_buffer_subdata;
+   ctx->base.texture_subdata = u_default_texture_subdata;
+   ctx->base.set_scissor_states = pvr_set_scissor_states;
+   ctx->base.set_blend_color = pvr_set_blend_color;
+   ctx->base.set_clip_state = pvr_set_clip_state;
+   ctx->base.set_polygon_stipple = pvr_set_polygon_stipple;
+   ctx->base.texture_barrier = pvr_texture_barrier;
+   ctx->base.memory_barrier = pvr_memory_barrier;
+   ctx->base.flush_resource = pvr_flush_resource;
+   ctx->base.invalidate_resource = pvr_invalidate_resource;
+   ctx->base.resource_copy_region = pvr_resource_copy_region;
+   ctx->base.blit = pvr_blit;
+   ctx->base.clear_render_target = pvr_clear_render_target;
+   ctx->base.clear_depth_stencil = pvr_clear_depth_stencil;
+   ctx->base.draw_vbo = pvr_draw_vbo;
+   ctx->base.set_stencil_ref = pvr_set_stencil_ref;
+   ctx->base.set_sample_mask = pvr_set_sample_mask;
+   ctx->base.set_min_samples = pvr_set_min_samples;
+   ctx->base.set_sample_coverage = pvr_set_sample_coverage;
+   ctx->base.set_shader_buffers = pvr_set_shader_buffers;
+   ctx->base.set_shader_images = pvr_set_shader_images;
+   ctx->base.set_stream_output_targets = pvr_set_stream_output_targets;
+
+   /* Client-side vertex arrays and other transient data (u_vbuf, the state tracker) go through
+    * the stream uploader. */
+   ctx->base.stream_uploader = u_upload_create_default(&ctx->base);
+   if (ctx->base.stream_uploader == NULL) {
+      pvr_context_destroy(&ctx->base);
+      return NULL;
+   }
+   ctx->base.const_uploader = ctx->base.stream_uploader;
+   return &ctx->base;
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_context.h b/src/gallium/drivers/pvr_native/pvr_context.h
new file mode 100644
index 00000000..df847132
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_context.h
@@ -0,0 +1,111 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * pipe_context. Resources are CPU mapped write-combined, so a transfer is arithmetic on that mapping.
+ * Draws are executed by the compute fallback (pvr_compute.c): a compute job rasterises the pipeline's
+ * triangle into the bound colour buffer and is submitted through pvr_vm. The fixed-function 3D path
+ * (geometry/TA + fragment/ISP) is not usable yet, so this is the path that makes a draw reach the GPU.
+ */
+#ifndef PVR_CONTEXT_H
+#define PVR_CONTEXT_H
+
+#include "pipe/p_context.h"
+#include "util/u_framebuffer.h"
+
+struct pvr_shader;
+struct pvr_compute_state;
+struct pvr_draw_state;
+
+/* The driver's vertex-elements object: a copy of the elements the state tracker created. */
+struct pvr_vertex_elements {
+   unsigned count;
+   struct pipe_vertex_element elements[PIPE_MAX_ATTRIBS];
+};
+#define PVR_MAX_TEXTURE_UNITS 16
+
+struct pvr_context {
+   struct pipe_context base;
+
+   /* What the CSO cache last bound. Nothing consumes these yet - no draw path - but
+    * the point of the gauge is that state is recorded when it is set rather than
+    * ignored, so the draw path has something to read. */
+   struct pvr_shader *vs;
+   struct pvr_shader *fs;
+
+   /* The current render targets. Copies the surfaces (which reference their textures),
+    * so this keeps the resources alive for as long as they are bound - a framebuffer
+    * whose texture was freed underneath it is a use-after-free the GPU would perform,
+    * not the CPU.
+    *
+    * The device addresses are deliberately NOT duplicated here: each cbuf's texture is
+    * a pvr_resource, so pvr_resource(fb.cbufs[i].texture)->dev_addr is the address the
+    * draw path wants. Storing a second copy would be a second thing to keep in sync. */
+   struct pipe_framebuffer_state fb;
+
+   /* Pipeline state, recorded rather than discarded. The create_* hooks allocate a
+    * copy of the pipe state struct, because the state the caller passes in may be a
+    * temporary and the object handed back to bind_* must outlive it. Nothing derives
+    * from these yet, so a copy of the struct is all that is needed - wrapping them in
+    * driver-specific types can wait until the CSB generator wants precomputed fields. */
+   const struct pipe_blend_state *blend;
+   struct pipe_blend_color blend_color;
+   const struct pipe_depth_stencil_alpha_state *dsa;
+   const struct pipe_rasterizer_state *rasterizer;
+
+   /* Constant buffer 0 of the vertex and fragment stages: the uniforms (pvr_draw.c). */
+   struct pipe_constant_buffer cb0[2];
+
+   /* Bound samplers (state-tracker CSOs) and sampler views (referenced here), per stage
+    * (0 vertex, 1 fragment) and texture unit. */
+   const struct pipe_sampler_state *samplers[2][PVR_MAX_TEXTURE_UNITS];
+   struct pipe_sampler_view *views[2][PVR_MAX_TEXTURE_UNITS];
+
+   /* The compute fallback's GPU resources and compute context, built on the first draw. */
+   struct pvr_compute_state *compute;
+   /* The TA/3D draw path (pvr_draw.c), built on the first draw it can take. */
+   struct pvr_draw_state *draw;
+   /* Draws that reached the GPU through the compute fallback. */
+   unsigned draws_executed;
+
+   unsigned nr_viewports;
+   struct pipe_viewport_state viewports[PIPE_MAX_VIEWPORTS];
+
+   unsigned nr_vertex_buffers;
+   struct pipe_vertex_buffer vertex_buffers[PIPE_MAX_ATTRIBS];
+
+   /* Opaque, and deliberately not dereferenced: a vertex-elements object is the DRIVER's private
+    * type once create_vertex_elements_state exists, and this driver does not create one yet (the
+    * frontend's default is registered). Recording the pointer makes the bind visible and gives a
+    * future create hook somewhere to put the parsed elements; inventing a struct to cast it to
+    * would be inventing a layout nothing produces. */
+   void *velements_state;
+
+   /* Draws that REACHED the driver. They are recorded and counted, and NOT executed: there is no
+    * job assembly, no render-target state and no submission of real content, so a draw here changes
+    * nothing on the GPU. Before this hook existed a draw call vanished without the driver even
+    * knowing it had been asked - which is worse than not drawing, because nothing could report it.
+    *
+    * Recorded as plain integers rather than pipe enums so the record survives changes to those types;
+    * the values are only for reporting and for the check that the hook is wired. */
+   unsigned draws_received;
+   bool     warned_draws_not_executed;
+   struct {
+      unsigned mode;
+      unsigned count;
+      unsigned start;
+      unsigned index_size;
+      unsigned instance_count;
+      unsigned num_draws;
+   } last_draw;
+};
+
+struct pipe_context *pvr_context_create(struct pipe_screen *pscreen, void *priv,
+                                        unsigned flags);
+
+static inline struct pvr_context *
+pvr_context(struct pipe_context *pctx)
+{
+   return (struct pvr_context *)pctx;
+}
+
+#endif /* PVR_CONTEXT_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.c b/src/gallium/drivers/pvr_native/pvr_csb.c
new file mode 100644
index 00000000..09a2ddbd
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_csb.c
@@ -0,0 +1,1880 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#include <inttypes.h>
+
+#include "pvr_csb.h"
+
+#define PVR_DW_TO_BYTES(x) ((uint32_t)(x) * 4u)
+
+#include "pipe/p_defines.h"
+#include "util/format/u_format.h"
+#include "common/pvr_device_info.h"
+#include "hwdef/rogue_hw_defs.h"
+#include "util/log.h"
+#include "util/u_math.h"
+
+void
+pvr_csb_init(struct pvr_csb *csb, void *map, uint32_t size_bytes,
+             uint32_t guard_dwords)
+{
+   const uint32_t total = size_bytes / sizeof(uint32_t);
+
+   csb->start = map;
+   csb->cur = map;
+   /* Ordinary emission stops before the guard, so the link dwords are always still
+    * there when the buffer is full. */
+   csb->end = csb->start + (total > guard_dwords ? total - guard_dwords : 0);
+   csb->guard_end = csb->start + total;
+   csb->overflowed = false;
+}
+
+/* Emission that may use the guard. Only the stream link goes through here, which is what
+ * the guard exists for. */
+static uint32_t *
+pvr_csb_emit_guarded(struct pvr_csb *csb, uint32_t words)
+{
+   if (csb->cur + words > csb->guard_end) {
+      csb->overflowed = true;
+      return NULL;
+   }
+
+   uint32_t *dst = csb->cur;
+
+   csb->cur += words;
+
+   return dst;
+}
+
+void
+pvr_csb_reset(struct pvr_csb *csb)
+{
+   csb->cur = csb->start;
+   csb->overflowed = false;
+}
+
+uint32_t *
+pvr_csb_emit(struct pvr_csb *csb, uint32_t words)
+{
+   uint32_t *dst;
+
+   if (words == 0)
+      return csb->cur;
+
+   /* The GPU executes this stream. Overrunning it would corrupt whatever follows the
+    * control stream in the buffer - and it would do so silently, at draw time, on the
+    * hardware, which is the worst place to discover it. So the reservation fails
+    * loudly in userspace instead, and the caller must treat NULL as "this draw did not
+    * fit" rather than writing anyway. */
+   if (csb->cur + words > csb->end) {
+      csb->overflowed = true;
+      return NULL;
+   }
+
+   dst = csb->cur;
+   csb->cur += words;
+
+   return dst;
+}
+
+uint32_t
+pvr_csb_size(const struct pvr_csb *csb)
+{
+   return (csb->cur - csb->start) * sizeof(uint32_t);
+}
+
+bool
+pvr_csb_overflowed(const struct pvr_csb *csb)
+{
+   return csb->overflowed;
+}
+
+/* A STREAM_TERMINATE block ends a control stream. It carries no payload, so the TA sees "the
+ * geometry for this job ends here" - the minimum a control stream can say that is still a valid
+ * stream. */
+bool
+pvr_csb_emit_stream_terminate(struct pvr_csb *csb)
+{
+   struct ROGUE_VDMCTRL_STREAM_TERMINATE t = {
+      .block_type = ROGUE_VDMCTRL_BLOCK_TYPE_STREAM_TERMINATE,
+   };
+   uint32_t *dw = pvr_csb_emit(csb, ROGUE_VDMCTRL_STREAM_TERMINATE_length);
+
+   if (dw == NULL)
+      return false;
+
+   ROGUE_VDMCTRL_STREAM_TERMINATE_pack(dw, &t);
+   return true;
+}
+
+bool
+pvr_csb_emit_pds_state_update(struct pvr_csb *csb, uint64_t program_addr,
+                              uint32_t data_dwords, uint32_t temps, bool for_fragment)
+{
+   const uint32_t words = ROGUE_VDMCTRL_PDS_STATE0_length +
+                          ROGUE_VDMCTRL_PDS_STATE1_length +
+                          ROGUE_VDMCTRL_PDS_STATE2_length;
+   const uint32_t data_bytes = data_dwords * sizeof(uint32_t);
+   const uint32_t unit = ROGUE_VDMCTRL_PDS_STATE0_PDS_DATA_SIZE_UNIT_SIZE;
+   struct ROGUE_VDMCTRL_PDS_STATE0 state0 = {
+      .block_type = ROGUE_VDMCTRL_BLOCK_TYPE_PDS_STATE_UPDATE,
+      /* The geometry job's control stream sets up BOTH stages: the vertex program targets the VDM
+       * and the fragment program targets the DDM. The captured fragment static stream is zeros in
+       * every pds_bgnd word, which is what rules out binding the fragment program there. */
+      .dm_target = for_fragment ? ROGUE_VDMCTRL_DM_TARGET_DDM : ROGUE_VDMCTRL_DM_TARGET_VDM,
+      .usc_target = ROGUE_VDMCTRL_USC_TARGET_ALL,
+      .usc_common_size = 0,
+      .usc_unified_size = 0,
+      .pds_temp_size = temps,
+      .pds_data_size = (data_bytes + unit - 1) / unit,
+   };
+   struct ROGUE_VDMCTRL_PDS_STATE1 state1 = {
+      .pds_data_addr = program_addr,
+      .sd_type = ROGUE_VDMCTRL_SD_TYPE_PDS,
+      .sd_next_type = ROGUE_VDMCTRL_SD_TYPE_USC,
+   };
+   struct ROGUE_VDMCTRL_PDS_STATE2 state2 = {
+      .pds_code_addr = program_addr + data_bytes,
+   };
+   uint32_t *dw = pvr_csb_emit(csb, words);
+
+   if (dw == NULL)
+      return false;
+
+   ROGUE_VDMCTRL_PDS_STATE0_pack(dw, &state0);
+   ROGUE_VDMCTRL_PDS_STATE1_pack(dw + ROGUE_VDMCTRL_PDS_STATE0_length, &state1);
+   ROGUE_VDMCTRL_PDS_STATE2_pack(dw + ROGUE_VDMCTRL_PDS_STATE0_length +
+                                    ROGUE_VDMCTRL_PDS_STATE1_length,
+                                &state2);
+
+   return true;
+}
+
+bool
+pvr_csb_emit_ppp_state(struct pvr_csb *csb, uint64_t state_addr, uint32_t word_count)
+{
+   const uint32_t words = ROGUE_VDMCTRL_PPP_STATE0_length +
+                          ROGUE_VDMCTRL_PPP_STATE1_length;
+   struct ROGUE_VDMCTRL_PPP_STATE0 state0 = {
+      .addrmsb = state_addr,
+      .word_count = word_count,
+   };
+   struct ROGUE_VDMCTRL_PPP_STATE1 state1 = {
+      .addrlsb = state_addr,
+   };
+   uint32_t *dw = pvr_csb_emit(csb, words);
+
+   if (dw == NULL)
+      return false;
+
+   ROGUE_VDMCTRL_PPP_STATE0_pack(dw, &state0);
+   ROGUE_VDMCTRL_PPP_STATE1_pack(dw + ROGUE_VDMCTRL_PPP_STATE0_length, &state1);
+
+   return true;
+}
+
+/* An INDEX_LIST block tells the TA where the vertex indices are and how many there are. The flags in
+ * INDEX_LIST0 say which of the following packets are present; the length is computed from the same
+ * flags, so the stream cannot be a different size than what is written - the same pairing the VDM
+ * state emitter uses. */
+bool
+pvr_csb_emit_index_list(struct pvr_csb *csb, uint64_t index_addr, uint32_t index_count,
+                        uint32_t instance_count, enum ROGUE_VDMCTRL_INDEX_SIZE index_size,
+                        enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY topology)
+{
+   /* The packets that follow the header are optional and their presence bits decide the length.
+    * index_addr == 0 means a NON-INDEXED draw (vkCmdDraw) - the hardware reads vertices
+    * sequentially, exactly what the captured working draw does; non-zero means the address and
+    * size packets are carried for an indexed draw. The instance-count packet is only worth its
+    * dword when it is not the default of one, as the capture shows. */
+   const bool have_addr = index_addr != 0;
+   const bool have_instances = instance_count > 1;
+   struct ROGUE_VDMCTRL_INDEX_LIST0 list0 = {
+      .block_type = ROGUE_VDMCTRL_BLOCK_TYPE_INDEX_LIST,
+      .index_addr_present = have_addr,
+      /* bits 39:32 of the index buffer address (csbgen shifts by 32); the LSB word carries the rest */
+      .index_base_addrmsb = index_addr,
+      .index_count_present = true,
+      .index_instance_count_present = have_instances,
+      /* The capture leaves degenerate-culling and patch count at their defaults: this part has no
+       * degenerate-culling feature, and a non-patch topology uses a patch count of one (stored 0). */
+      .degen_cull_enable = false,
+      .index_size = index_size,
+      .primitive_topology = topology,
+   };
+   struct ROGUE_VDMCTRL_INDEX_LIST1 list1 = { .index_base_addrlsb = index_addr };
+   struct ROGUE_VDMCTRL_INDEX_LIST2 list2 = { .index_count = index_count };
+   /* The hardware encoding is count-minus-one: the reference writes `instance_count - 1`, and a raw
+    * count makes it draw one instance too many (an out-of-range instance reads zeroes from the
+    * per-instance buffers - seen as a transparent-black triangle at the base offset in the middle
+    * of an instanced draw). */
+   struct ROGUE_VDMCTRL_INDEX_LIST3 list3 = { .instance_count = instance_count - 1 };
+   const uint32_t words = ROGUE_VDMCTRL_INDEX_LIST0_length +
+                          (have_addr ? ROGUE_VDMCTRL_INDEX_LIST1_length : 0) +
+                          ROGUE_VDMCTRL_INDEX_LIST2_length +
+                          (have_instances ? ROGUE_VDMCTRL_INDEX_LIST3_length : 0);
+   uint32_t *dw = pvr_csb_emit(csb, words);
+   uint32_t at = ROGUE_VDMCTRL_INDEX_LIST0_length;
+
+   if (dw == NULL)
+      return false;
+
+   ROGUE_VDMCTRL_INDEX_LIST0_pack(dw, &list0);
+
+   if (have_addr) {
+      ROGUE_VDMCTRL_INDEX_LIST1_pack(dw + at, &list1);
+      at += ROGUE_VDMCTRL_INDEX_LIST1_length;
+   }
+
+   ROGUE_VDMCTRL_INDEX_LIST2_pack(dw + at, &list2);
+   at += ROGUE_VDMCTRL_INDEX_LIST2_length;
+
+   if (have_instances)
+      ROGUE_VDMCTRL_INDEX_LIST3_pack(dw + at, &list3);
+
+   return true;
+}
+
+/* Port of the reference's pvr_arch_calculate_vertex_cam_size(). COPIED, thresholds and all: the
+ * comparisons are against device feature values (vdm_cam_size, uvs_vtx_entries) and the branches
+ * chosen for this part are not derivable from the field names - the comments in the reference say
+ * "this is a proxy for 8XE". A re-derived rule would be a guess, and a wrong cam_size changes how
+ * much vertex data the hardware keeps, i.e. it fails silently. */
+/* Port of the reference's pvr_arch_setup_tiles_in_flight(): how many tiles the ISP may have in
+ * flight (ISP_CTL.pipe_enable) and the USC pixel-output control word's width/partition mask. The
+ * arithmetic is device-feature driven and not re-derivable from the field names, so it is copied
+ * rather than approximated - a wrong value here under- or over-subscribes the tile pipeline, which
+ * shows up only as GPU throughput, never as a wrong pixel. */
+void
+pvr_setup_tiles_in_flight(const struct pvr_device_info *dev_info,
+                          const struct pvr_device_runtime_info *runtime,
+                          uint32_t pixel_width, bool paired_tiles,
+                          uint32_t max_tiles_in_flight, uint32_t *isp_ctl,
+                          uint32_t *pixel_ctl)
+{
+   uint32_t total_tiles_in_flight = 0;
+   uint32_t usable_partition_size;
+   uint32_t partitions_available;
+   uint32_t usc_min_output_regs;
+   uint32_t max_partitions;
+   uint32_t partition_size;
+   uint32_t max_phantoms;
+   uint32_t tile_size_x, tile_size_y;
+   uint32_t isp_samples;
+
+   usc_min_output_regs = PVR_GET_FEATURE_VALUE(dev_info, usc_min_output_registers_per_pix, 0);
+   pixel_width = MAX2(pixel_width, usc_min_output_regs);
+   pixel_width = util_next_power_of_two(pixel_width);
+
+   partition_size = pixel_width;
+   isp_samples = PVR_GET_FEATURE_VALUE(dev_info, isp_samples_per_pixel, 1);
+   /* No MSAA is rendered by this driver, so the sample-size multipliers of the reference's MSAA
+    * path are all the AA_NONE case (1x). */
+
+   tile_size_x = PVR_GET_FEATURE_VALUE(dev_info, tile_size_x, 0);
+   tile_size_y = PVR_GET_FEATURE_VALUE(dev_info, tile_size_y, 0);
+   assert(tile_size_x == tile_size_y);
+
+   if (tile_size_x == 16U)
+      partition_size *= tile_size_x * tile_size_y;
+   else
+      partition_size *= (tile_size_x * tile_size_y / 4U);
+
+   max_partitions = PVR_GET_FEATURE_VALUE(dev_info, max_partitions, 0);
+   usable_partition_size = MIN2(runtime->total_reserved_partition_size,
+                                partition_size * max_partitions);
+
+   if (PVR_GET_FEATURE_VALUE(dev_info, common_store_size_in_dwords, 0) < (1024 * 4 * 4) &&
+       tile_size_x != 16)
+      usable_partition_size = MIN2((tile_size_x * tile_size_y / 4U) * 8U, usable_partition_size);
+
+   partitions_available = MIN2(max_partitions, usable_partition_size / partition_size);
+
+   if (PVR_HAS_FEATURE(dev_info, xt_top_infrastructure))
+      max_phantoms = runtime->num_phantoms;
+   else if (PVR_HAS_FEATURE(dev_info, roguexe))
+      max_phantoms = PVR_GET_FEATURE_VALUE(dev_info, num_raster_pipes, 0);
+   else
+      max_phantoms = 1;
+   if (max_phantoms == 0)
+      max_phantoms = 1;
+
+   for (uint32_t i = 0; i < max_phantoms; i++) {
+      uint32_t usc_tiles_in_flight = partitions_available;
+      uint32_t isp_tiles_in_flight;
+
+      if (tile_size_x != 16) {
+         uint32_t num_clusters = PVR_GET_FEATURE_VALUE(dev_info, num_clusters, 0);
+         usc_tiles_in_flight = (usc_tiles_in_flight * MIN2(4U, num_clusters - (4U * i))) / 4U;
+      }
+      if (usc_tiles_in_flight == 0)
+         usc_tiles_in_flight = 1;
+
+      isp_tiles_in_flight = PVR_GET_FEATURE_VALUE(dev_info, isp_max_tiles_in_flight, 0);
+      if (!PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) ||
+          PVR_GET_FEATURE_VALUE(dev_info, simple_parameter_format_version, 0) != 2)
+         isp_tiles_in_flight /= runtime->num_phantoms ? runtime->num_phantoms : 1;
+      isp_tiles_in_flight = MIN2(usc_tiles_in_flight, isp_tiles_in_flight);
+      if (isp_tiles_in_flight == 0)
+         isp_tiles_in_flight = 1;
+
+      if (max_tiles_in_flight > 0U) {
+         isp_tiles_in_flight = MIN2(usc_tiles_in_flight, max_tiles_in_flight);
+         if (PVR_HAS_FEATURE(dev_info, roguexe)) {
+            if (tile_size_x == 16)
+               partitions_available = isp_tiles_in_flight;
+            else
+               partitions_available = isp_tiles_in_flight * 4U;
+         }
+      }
+
+      if (total_tiles_in_flight > (isp_tiles_in_flight + 1U))
+         total_tiles_in_flight = isp_tiles_in_flight + 1U;
+      total_tiles_in_flight += isp_tiles_in_flight;
+   }
+
+   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) &&
+       PVR_GET_FEATURE_VALUE(dev_info, simple_parameter_format_version, 0) == 2)
+      total_tiles_in_flight = MIN2(total_tiles_in_flight, partitions_available);
+
+   if (PVR_HAS_FEATURE(dev_info, paired_tiles) && paired_tiles)
+      total_tiles_in_flight = MIN2(total_tiles_in_flight, partitions_available / 2);
+
+   if (total_tiles_in_flight == 0)
+      total_tiles_in_flight = 1;
+
+   struct ROGUE_CR_USC_PIXEL_OUTPUT_CTRL pixel = { 0 };
+   if (pixel_width == 1 && usc_min_output_regs == 1)
+      pixel.width = ROGUE_CR_PIXEL_WIDTH_1REGISTER;
+   else if (pixel_width == 2)
+      pixel.width = ROGUE_CR_PIXEL_WIDTH_2REGISTERS;
+   else if (pixel_width == 4)
+      pixel.width = ROGUE_CR_PIXEL_WIDTH_4REGISTERS;
+   else if (pixel_width == 8 && PVR_HAS_FEATURE(dev_info, eight_output_registers))
+      pixel.width = ROGUE_CR_PIXEL_WIDTH_8REGISTERS;
+   else if (usc_min_output_regs == 1)
+      pixel.width = ROGUE_CR_PIXEL_WIDTH_1REGISTER;
+   else
+      pixel.width = ROGUE_CR_PIXEL_WIDTH_2REGISTERS;
+
+   if (PVR_HAS_FEATURE(dev_info, usc_pixel_partition_mask))
+      pixel.partition_mask = (1 << max_partitions) - 1;
+   else {
+      pixel.enable_4th_partition = true;
+      pixel.partition_mask = (1U << partitions_available) - 1U;
+   }
+   ROGUE_CR_USC_PIXEL_OUTPUT_CTRL_pack(pixel_ctl, &pixel);
+
+   struct ROGUE_CR_ISP_CTL ctl = { 0 };
+   if (PVR_HAS_FEATURE(dev_info, xt_top_infrastructure))
+      ctl.pipe_enable = (2 * total_tiles_in_flight) - 1;
+   else
+      ctl.pipe_enable = total_tiles_in_flight - 1;
+
+   /* The rest of ISP_CTL, as the reference's fragment stream sets it (pvr_arch_job_render.c):
+    * sample positioning on; empty tiles processed through the background object (this driver always
+    * has a background program: clears and reloads go through it); skip_init_hdrs where the
+    * multicore/simple-parameter combination allows it. The verified capture carries exactly these
+    * three bits. */
+   ctl.sample_pos = true;
+   ctl.process_empty_tiles = true;
+   if (PVR_HAS_FEATURE(dev_info, gpu_multicore_support) &&
+       PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format))
+      ctl.skip_init_hdrs = true;
+   ROGUE_CR_ISP_CTL_pack(isp_ctl, &ctl);
+}
+
+void
+pvr_vdm_cam_size(const struct pvr_device_info *dev_info, uint32_t vs_output_size,
+                 bool raster_enable, uint32_t *cam_size_out,
+                 uint32_t *max_instances_out)
+{
+   const uint32_t uvs_vertex_vector_size_in_dwords =
+      (vs_output_size + 1U + raster_enable * 4U) * 4U;
+   const uint32_t vdm_cam_size = PVR_GET_FEATURE_VALUE(dev_info, vdm_cam_size, 32U);
+
+   /* This is a proxy for 8XE. */
+   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format) && vdm_cam_size < 96U) {
+      if (uvs_vertex_vector_size_in_dwords < (14U * 4U)) {
+         *cam_size_out = MIN2(31U, vdm_cam_size - 1U);
+         *max_instances_out = 16U;
+      } else if (uvs_vertex_vector_size_in_dwords < (20U * 4U)) {
+         *cam_size_out = 15U;
+         *max_instances_out = 16U;
+      } else if (uvs_vertex_vector_size_in_dwords < (28U * 4U)) {
+         *cam_size_out = 11U;
+         *max_instances_out = 12U;
+      } else if (uvs_vertex_vector_size_in_dwords < (44U * 4U)) {
+         *cam_size_out = 7U;
+         *max_instances_out = 8U;
+      } else if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format_v2) ||
+                 uvs_vertex_vector_size_in_dwords < (64U * 4U)) {
+         *cam_size_out = 7U;
+         *max_instances_out = 4U;
+      } else {
+         *cam_size_out = 3U;
+         *max_instances_out = 2U;
+      }
+   } else {
+      if (uvs_vertex_vector_size_in_dwords <= (32U * 4U)) {
+         *cam_size_out = MIN2(95U, vdm_cam_size - 1U);
+         *max_instances_out = 0U;
+      } else if (uvs_vertex_vector_size_in_dwords <= 48U * 4U) {
+         *cam_size_out = 63U;
+         *max_instances_out =
+            PVR_GET_FEATURE_VALUE(dev_info, uvs_vtx_entries, 144U) < 288U ? 16U : 0U;
+      } else if (uvs_vertex_vector_size_in_dwords <= 64U * 4U) {
+         *cam_size_out = 31U;
+         *max_instances_out =
+            PVR_GET_FEATURE_VALUE(dev_info, uvs_vtx_entries, 144U) < 288U ? 16U : 0U;
+      } else {
+         *cam_size_out = 15U;
+         *max_instances_out = 16U;
+      }
+   }
+}
+
+/* The VDM state update: a conditionally variable-length group. VDMCTRL_VDM_STATE0's presence flags
+ * say which of STATE1..5 follow, so the length and the packets must be computed from the same
+ * flags - a mismatch is state the hardware reads wrongly and nothing reports.
+ *
+ * The shape is taken from a capture of a working Vulkan draw (see
+ * open-driver-perf/captures/vkrender_draw_stream_decoded.txt): a draw whose vertex program is
+ * executed sets vs_data_addr_present and vs_other_present, and then carries STATE2 (PDS data
+ * address), STATE3 (PDS code address), STATE4 (output size) and STATE5 (allocation sizes). A
+ * stream with only STATE2 is a fetch program that never starts a vertex shader. */
+bool
+pvr_csb_emit_vdm_pds_state(struct pvr_csb *csb, uint32_t usc_shared_dwords,
+                           uint64_t pds_data_addr, uint32_t pds_data_dwords,
+                           uint64_t pds_code_addr)
+{
+   const struct ROGUE_VDMCTRL_PDS_STATE0 state0 = {
+      ROGUE_VDMCTRL_PDS_STATE0_header,
+      .usc_target = ROGUE_VDMCTRL_USC_TARGET_ALL,
+      .usc_common_size = DIV_ROUND_UP(usc_shared_dwords * 4,
+                                      ROGUE_VDMCTRL_PDS_STATE0_USC_COMMON_SIZE_UNIT_SIZE),
+      .pds_data_size = DIV_ROUND_UP(pds_data_dwords * 4,
+                                    ROGUE_VDMCTRL_PDS_STATE0_PDS_DATA_SIZE_UNIT_SIZE),
+   };
+   const struct ROGUE_VDMCTRL_PDS_STATE1 state1 = {
+      .pds_data_addr = pds_data_addr,
+      .sd_type = ROGUE_VDMCTRL_SD_TYPE_NONE,
+   };
+   const struct ROGUE_VDMCTRL_PDS_STATE2 state2 = { .pds_code_addr = pds_code_addr };
+   uint32_t *dw = pvr_csb_emit(csb, ROGUE_VDMCTRL_PDS_STATE0_length +
+                                       ROGUE_VDMCTRL_PDS_STATE1_length +
+                                       ROGUE_VDMCTRL_PDS_STATE2_length);
+   if (dw == NULL)
+      return false;
+   ROGUE_VDMCTRL_PDS_STATE0_pack(dw, &state0);
+   dw += ROGUE_VDMCTRL_PDS_STATE0_length;
+   ROGUE_VDMCTRL_PDS_STATE1_pack(dw, &state1);
+   dw += ROGUE_VDMCTRL_PDS_STATE1_length;
+   ROGUE_VDMCTRL_PDS_STATE2_pack(dw, &state2);
+   return true;
+}
+
+bool
+pvr_csb_emit_vdm_state(struct pvr_csb *csb, bool cut_index_enable,
+                       uint32_t cut_index, const struct pvr_vdm_vs *vs,
+                       uint32_t *words_out)
+{
+   const bool have_vs_data = vs != NULL && vs->pds_data_addr != 0;
+   const bool have_vs_other = vs != NULL && vs->pds_code_addr != 0;
+   struct ROGUE_VDMCTRL_VDM_STATE0 state0 = {
+      ROGUE_VDMCTRL_VDM_STATE0_header,
+      .cut_index_enable = cut_index_enable,
+      .cut_index_present = cut_index_enable,
+      .vs_data_addr_present = have_vs_data,
+      .vs_other_present = have_vs_other,
+      .cam_size = vs != NULL ? vs->cam_size : 0,
+      /* 0 means "5 extra dwords", which is what rasterisation needs (the enum's names are the
+       * inverse of their values; the capture carries 0 for a rasterising draw). */
+      .uvs_scratch_size_select = ROGUE_VDMCTRL_UVS_SCRATCH_SIZE_SELECT_FIVE,
+      .flatshade_control = ROGUE_VDMCTRL_FLATSHADE_CONTROL_VERTEX_0,
+   };
+   struct ROGUE_VDMCTRL_VDM_STATE1 state1 = { .cut_index = cut_index };
+   struct ROGUE_VDMCTRL_VDM_STATE2 state2 = {
+      .vs_pds_data_base_addr = vs != NULL ? vs->pds_data_addr : 0,
+   };
+   struct ROGUE_VDMCTRL_VDM_STATE3 state3 = {
+      .vs_pds_code_base_addr = vs != NULL ? vs->pds_code_addr : 0,
+   };
+   struct ROGUE_VDMCTRL_VDM_STATE4 state4 = {
+      .vs_output_size = vs != NULL ? vs->output_size : 0,
+   };
+   struct ROGUE_VDMCTRL_VDM_STATE5 state5 = { 0 };
+
+   if (vs != NULL) {
+      state5.vs_max_instances = vs->max_instances;
+      state5.vs_usc_common_size = 0;
+      state5.vs_usc_unified_size =
+         DIV_ROUND_UP(vs->usc_unified_bytes,
+                      ROGUE_VDMCTRL_VDM_STATE5_VS_USC_UNIFIED_SIZE_UNIT_SIZE);
+      state5.vs_pds_temp_size =
+         DIV_ROUND_UP(vs->pds_temp_dwords * 4,
+                      ROGUE_VDMCTRL_VDM_STATE5_VS_PDS_TEMP_SIZE_UNIT_SIZE);
+      state5.vs_pds_data_size =
+         DIV_ROUND_UP(vs->pds_data_dwords * 4,
+                      ROGUE_VDMCTRL_VDM_STATE5_VS_PDS_DATA_SIZE_UNIT_SIZE);
+   }
+
+   const uint32_t words = ROGUE_VDMCTRL_VDM_STATE0_length +
+                          (cut_index_enable ? ROGUE_VDMCTRL_VDM_STATE1_length : 0) +
+                          (have_vs_data ? ROGUE_VDMCTRL_VDM_STATE2_length : 0) +
+                          (have_vs_other ? ROGUE_VDMCTRL_VDM_STATE3_length +
+                                              ROGUE_VDMCTRL_VDM_STATE4_length +
+                                              ROGUE_VDMCTRL_VDM_STATE5_length
+                                        : 0);
+   uint32_t *dw = pvr_csb_emit(csb, words);
+   uint32_t at = ROGUE_VDMCTRL_VDM_STATE0_length;
+
+   if (dw == NULL)
+      return false;
+
+   ROGUE_VDMCTRL_VDM_STATE0_pack(dw, &state0);
+
+   if (cut_index_enable) {
+      ROGUE_VDMCTRL_VDM_STATE1_pack(dw + at, &state1);
+      at += ROGUE_VDMCTRL_VDM_STATE1_length;
+   }
+
+   if (have_vs_data) {
+      ROGUE_VDMCTRL_VDM_STATE2_pack(dw + at, &state2);
+      at += ROGUE_VDMCTRL_VDM_STATE2_length;
+   }
+
+   if (have_vs_other) {
+      ROGUE_VDMCTRL_VDM_STATE3_pack(dw + at, &state3);
+      at += ROGUE_VDMCTRL_VDM_STATE3_length;
+      ROGUE_VDMCTRL_VDM_STATE4_pack(dw + at, &state4);
+      at += ROGUE_VDMCTRL_VDM_STATE4_length;
+      ROGUE_VDMCTRL_VDM_STATE5_pack(dw + at, &state5);
+   }
+
+   if (words_out != NULL)
+      *words_out = words;
+
+   return true;
+}
+
+bool
+pvr_swizzle_from_pipe(uint8_t pipe_swizzle, enum ROGUE_TEXSTATE_SWIZ *out)
+{
+   switch (pipe_swizzle) {
+   case PIPE_SWIZZLE_X: *out = ROGUE_TEXSTATE_SWIZ_SRCCHAN_0; return true;
+   case PIPE_SWIZZLE_Y: *out = ROGUE_TEXSTATE_SWIZ_SRCCHAN_1; return true;
+   case PIPE_SWIZZLE_Z: *out = ROGUE_TEXSTATE_SWIZ_SRCCHAN_2; return true;
+   case PIPE_SWIZZLE_W: *out = ROGUE_TEXSTATE_SWIZ_SRCCHAN_3; return true;
+   case PIPE_SWIZZLE_0: *out = ROGUE_TEXSTATE_SWIZ_SRC_ZERO; return true;
+   case PIPE_SWIZZLE_1: *out = ROGUE_TEXSTATE_SWIZ_SRC_ONE; return true;
+   default:
+      /* PIPE_SWIZZLE_NONE, and anything else. Refused rather than approximated. */
+      return false;
+   }
+}
+
+bool
+pvr_format_layout_from_pipe(enum pipe_format format, struct pvr_format_layout *layout_out)
+{
+   const struct util_format_description *desc = util_format_description(format);
+
+   if (desc == NULL)
+      return false;
+
+   /* Only formats whose component layout is unambiguous from the gallium format itself.
+    * PIPE_FORMAT_R8G8B8A8_UNORM and PIPE_FORMAT_B8G8R8A8_UNORM both land on U8U8U8U8 and
+    * differ only in the swizzle below, which is exactly why the two are separate fields. */
+   switch (format) {
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+   case PIPE_FORMAT_R8G8B8X8_UNORM: /* the description's swizzle reads alpha as 1 */
+   case PIPE_FORMAT_B8G8R8X8_UNORM:
+   case PIPE_FORMAT_R8G8B8A8_SRGB:
+   case PIPE_FORMAT_B8G8R8A8_SRGB:
+   case PIPE_FORMAT_A8B8G8R8_SRGB:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_U8U8U8U8;
+      break;
+   case PIPE_FORMAT_R8_UNORM:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_U8;
+      break;
+   /* Depth, as the depth buffers the ZLS stores (untwiddled, rows of whole tiles). */
+   case PIPE_FORMAT_Z16_UNORM:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_U16;
+      break;
+   case PIPE_FORMAT_Z24X8_UNORM:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_X8U24;
+      break;
+   case PIPE_FORMAT_Z24_UNORM_S8_UINT:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_ST8U24;
+      break;
+   case PIPE_FORMAT_Z32_FLOAT:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_F32;
+      break;
+   case PIPE_FORMAT_R8G8_UNORM:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_U8U8;
+      break;
+   case PIPE_FORMAT_R16_UNORM:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_U16;
+      break;
+   case PIPE_FORMAT_R16_FLOAT:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_F16;
+      break;
+   case PIPE_FORMAT_R16G16_FLOAT:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_F16F16;
+      break;
+   case PIPE_FORMAT_R16G16B16A16_FLOAT:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_F16F16F16F16;
+      break;
+   case PIPE_FORMAT_B5G6R5_UNORM:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_R5G6B5;
+      break;
+   /* 10-bit packed colour, the layout the reference maps to A2R10B10G10 (the description's
+    * swizzle selects the channel order). */
+   case PIPE_FORMAT_R10G10B10A2_UNORM:
+   case PIPE_FORMAT_B10G10R10A2_UNORM:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_A2R10B10G10;
+      break;
+   /* 32-bit float textures (OES_texture_float). */
+   case PIPE_FORMAT_R32G32B32A32_FLOAT:
+      layout_out->components = ROGUE_TEXSTATE_FORMAT_F32F32F32F32;
+      break;
+   default:
+      return false;
+   }
+
+   /* Depth and stencil are read from one channel whatever their storage layout, so the
+    * swizzle is not the description's - this is the reference's rule, not a choice.
+    *
+    * Currently unreachable: no depth format is in the component switch above, because
+    * choosing between the hardware's ST8U24 and X8U24 for Z24S8 means knowing which the
+    * layout uses. The rule is right; the component mapping it needs is missing. */
+   if (util_format_has_depth(desc) || util_format_has_stencil(desc)) {
+      layout_out->swizzle[0] = PIPE_SWIZZLE_X;
+      layout_out->swizzle[1] = PIPE_SWIZZLE_0;
+      layout_out->swizzle[2] = PIPE_SWIZZLE_0;
+      layout_out->swizzle[3] = PIPE_SWIZZLE_1;
+   } else {
+      memcpy(layout_out->swizzle, desc->swizzle, sizeof(layout_out->swizzle));
+   }
+
+   return true;
+}
+
+bool
+pvr_addrmode_from_pipe(enum pipe_tex_wrap mode, enum ROGUE_TEXSTATE_ADDRMODE *out)
+{
+   switch (mode) {
+   case PIPE_TEX_WRAP_REPEAT:            *out = ROGUE_TEXSTATE_ADDRMODE_REPEAT; return true;
+   case PIPE_TEX_WRAP_MIRROR_REPEAT:     *out = ROGUE_TEXSTATE_ADDRMODE_FLIP; return true;
+   case PIPE_TEX_WRAP_CLAMP_TO_EDGE:     *out = ROGUE_TEXSTATE_ADDRMODE_CLAMP_TO_EDGE; return true;
+   case PIPE_TEX_WRAP_CLAMP_TO_BORDER:   *out = ROGUE_TEXSTATE_ADDRMODE_CLAMP_TO_BORDER; return true;
+   case PIPE_TEX_WRAP_MIRROR_CLAMP_TO_EDGE:
+      *out = ROGUE_TEXSTATE_ADDRMODE_FLIP_ONCE_THEN_CLAMP; return true;
+   case PIPE_TEX_WRAP_CLAMP:             *out = ROGUE_TEXSTATE_ADDRMODE_OGL_CLAMP; return true;
+   default:
+      return false;
+   }
+}
+
+bool
+pvr_filter_from_pipe(enum pipe_tex_filter filter, enum ROGUE_TEXSTATE_FILTER *out)
+{
+   switch (filter) {
+   case PIPE_TEX_FILTER_NEAREST: *out = ROGUE_TEXSTATE_FILTER_POINT; return true;
+   case PIPE_TEX_FILTER_LINEAR:  *out = ROGUE_TEXSTATE_FILTER_LINEAR; return true;
+   default:
+      /* No hardware equivalent, and no close one worth substituting. */
+      return false;
+   }
+}
