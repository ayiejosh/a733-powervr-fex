+static bool instrs_exclusive(pco_instr *a, pco_instr *b)
+{
+   for (pco_cf_node *na = &a->parent_block->cf_node; na->parent;
+        na = na->parent) {
+      if (na->parent->type != PCO_CF_NODE_TYPE_IF ||
+          na->flag != PCO_CF_NODE_FLAG_IF_THEN) {
+         continue;
