+static const struct pvr_buffer_descriptor *
+pvr_bound_buffer_descriptor(const struct pvr_descriptor_set *set,
+                            unsigned binding_idx,
+                            unsigned elem)
+{
+   const struct pvr_descriptor_set_layout_binding *binding =
+      &set->layout->bindings[binding_idx];
+
+   if (binding->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC)
+      return &set->dynamic_buffers[binding->dynamic_buffer_idx + elem];
+
+   return (const struct pvr_buffer_descriptor *)((const uint8_t *)set->mapping +
+                                                 binding->offset +
+                                                 elem * binding->stride);
+}
