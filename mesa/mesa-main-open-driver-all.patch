+/* TQ fill replay (round 82): replay the captured working Vulkan TQ fill job from the native driver.
+ * Destination buffer is mapped at the same device address the reference used, the two PDS programs the
+ * job names are installed at the same PDS heap offsets, and the 176-byte captured stream is submitted
+ * verbatim on a native transfer context. A CPU readback then checks the buffer for the fill pattern. */
+#define TQ_FILL_DST_ADDR 0x80000b1000ULL
+#define TQ_FILL_DST_SIZE (64u * 64u * 4u)
+#define TQ_FILL_PATTERN 0xdeadbeefu
+
+
+/* Reads a capture file from the directory named by PVR_PROBE_CDM_DIR. */
+
+/* Compiles a compute SPIR-V module through spirv_to_nir + pco with the native driver's compiler and
+ * writes the USC binary out, so it can be compared byte-for-byte with the shader the reference driver
+ * uploads for the same module. */
+static void
+cdm_compile_check(struct pipe_screen *pscreen)
+{
+   struct pvr_screen *scr = pvr_screen(pscreen);
+   const char *path = getenv("PVR_PROBE_CDM_COMPILE");
+   const char *out_path = getenv("PVR_PROBE_CDM_COMPILE_OUT");
+   struct stat st;
+   uint32_t *words;
+   nir_shader *nir;
+   pco_data data = { 0 };
+   pco_shader *shader = NULL;
+   const void *binary = NULL;
+   unsigned size = 0;
+   FILE *f;
+   int fd;
+
+   if (out_path == NULL)
+      out_path = "/home/radxa/native-compute.bin";
+   if (stat(path, &st) != 0 || st.st_size < 20) {
+      printf("cdmc:          FAIL: cannot read %s\n", path);
+      return;
+   }
+   words = malloc(st.st_size);
+   fd = open(path, O_RDONLY);
+   if (words == NULL || fd < 0 || read(fd, words, st.st_size) != st.st_size) {
+      printf("cdmc:          FAIL: cannot load %s\n", path);
+      if (words)
+         free(words);
+      if (fd >= 0)
+         close(fd);
+      return;
+   }
+   close(fd);
+
+   nir = spirv_to_nir(words, st.st_size / 4, NULL, MESA_SHADER_COMPUTE, "main",
+                      pco_spirv_options(), pco_nir_options());
+   free(words);
+   if (nir == NULL) {
+      printf("cdmc:          FAIL: spirv_to_nir produced no NIR\n");
+      return;
+   }
+   if (!pvr_shader_compile_compute(scr->pco_ctx, nir, &data, &shader, &binary, &size)) {
+      printf("cdmc:          FAIL: pco compile failed\n");
+      return;
+   }
+   printf("cdmc:          compiled %u bytes USC; temps=%u shareds=%u wg=(%u,%u,%u) "
+          "literals=%u desc_sets=%u\n", size, data.common.temps, data.common.shareds,
+          data.cs.workgroup_size[0], data.cs.workgroup_size[1], data.cs.workgroup_size[2],
+          data.common.literals.count, (unsigned)data.common.desc_sets[0].binding_count);
+
+   /* Generate the PDS compute kernel program the compute submission would install: compare it with
+    * the reference capture (data at PDS+0x2640, code at PDS+0x2650 in captures/cdm-draw/pds.txt). */
+   {
+      const pco_data *sd = pco_shader_data(shader);
+      const struct pvr_device_info *dev_info = &pvr_screen(pscreen)->dev_info;
+
+      printf("cdmc:          final pco data: temps=%u shareds=%u vtxins=%u coeffs=%u "
+             "literals=%u wg_id_mask=0x%x\n", sd->common.temps, sd->common.shareds,
+             sd->common.vtxins, sd->common.coeffs, sd->common.literals.count,
+             sd->cs.workgroup_id_mask);
+      struct pvr_pds_compute_shader_program prog;
+      const uint64_t usc_dev_addr = 0xe000007200ULL;
+      uint32_t *stage_buf;
+      uint32_t data_dw, code_dw;
+      uint32_t *code;
+
+      pvr_pds_compute_shader_program_init(&prog);
+      prog.flattened_work_groups = true;
+      prog.kick_usc = true;
+      pvr_pds_setup_doutu(&prog.usc_task_control, usc_dev_addr, sd->common.temps,
+                          ROGUE_PDSINST_DOUTU_SAMPLE_RATE_INSTANCE, false);
+      if (sd->common.sys_vals[SYSTEM_VALUE_LOCAL_INVOCATION_INDEX].count > 0)
+         prog.local_input_regs[0] =
+            sd->common.sys_vals[SYSTEM_VALUE_LOCAL_INVOCATION_INDEX].start;
+      for (unsigned u = 0; u < 3; u++) {
+         if (sd->common.sys_vals[SYSTEM_VALUE_WORKGROUP_ID].count > u &&
+             (sd->cs.workgroup_id_mask & BITFIELD_BIT(u)))
+            prog.work_group_input_regs[u] =
+               sd->common.sys_vals[SYSTEM_VALUE_WORKGROUP_ID].start + u;
+         if (sd->common.sys_vals[SYSTEM_VALUE_NUM_WORKGROUPS].count > u)
+            prog.num_work_groups_regs[u] =
+               sd->common.sys_vals[SYSTEM_VALUE_NUM_WORKGROUPS].start + u;
+      }
+
+      pvr_pds_compute_shader(&prog, NULL, PDS_GENERATE_SIZES, dev_info);
+      data_dw = prog.data_size;
+      code_dw = prog.code_size;
+      stage_buf = calloc(data_dw + code_dw, sizeof(uint32_t));
+      code = pvr_pds_compute_shader(&prog, stage_buf, PDS_GENERATE_DATA_SEGMENT, dev_info);
+      pvr_pds_compute_shader(&prog, code, PDS_GENERATE_CODE_SEGMENT, dev_info);
+      printf("cdmc:          PDS data dw=%u:", data_dw);
+      for (unsigned i = 0; i < data_dw; i++)
+         printf(" %08x", stage_buf[i]);
+      printf("\ncdmc:          PDS code dw=%u:", code_dw);
+      for (unsigned i = 0; i < code_dw; i++)
+         printf(" %08x", code[i]);
+      printf("\n");
+      free(stage_buf);
+
+      /* Descriptor upload PDS program + data segment, exactly as a compute submission would build it:
+       * the descriptor-set range and the compile-time literal pool are copied into the shader's shared
+       * registers by the descriptor kernel. Compare with the reference capture
+       * (desc_code @PDS+0x2600: f0040000 f4050100; desc data @PDS+0x26c0: 6 dwords). */
+      {
+         struct pvr_pds_descriptor_program_input din = { 0 };
+         struct pvr_pds_info dinfo = { 0 };
+         uint32_t *code_buf;
+         uint32_t *entries;
+         uint32_t *seg;
+         unsigned i;
+
+         din.descriptor_set_count = 1;
+         din.descriptor_sets[0] = (struct pvr_pds_descriptor_set){
+            .descriptor_set = 0,
+            .size_in_dwords = sd->common.desc_sets[0].range.count,
+            .destination = sd->common.desc_sets[0].range.start,
+         };
+         din.buffer_count = 1;
+         din.buffers[0] = (struct pvr_pds_buffer){
+            .type = PVR_BUFFER_TYPE_COMPILE_TIME,
+            .size_in_dwords = sd->common.literals.count,
+            .destination = sd->common.literals.start,
+         };
+         entries = calloc(1, 4096); /* PVR_PDS_MAX_DESC_UPLOAD_BYTES is < 1 KiB */
+         dinfo.entries = (struct pvr_const_map_entry *)entries;
+         dinfo.entries_size_in_bytes = 4096;
+         pvr_pds_generate_descriptor_upload_program(&din, NULL, &dinfo);
+         code_buf = calloc(dinfo.code_size_in_dwords ? dinfo.code_size_in_dwords : 1, 4);
+         pvr_pds_generate_descriptor_upload_program(&din, code_buf, &dinfo);
+         printf("cdmc:          desc program code dw=%u:", dinfo.code_size_in_dwords);
+         for (i = 0; i < dinfo.code_size_in_dwords; i++)
+            printf(" %08x", code_buf[i]);
+         printf("\ncdmc:          desc entries=%u bytes=%u data_dw=%u\n", dinfo.entry_count,
+                (unsigned)dinfo.entries_written_size_in_bytes, dinfo.data_size_in_dwords);
+
+         seg = calloc(dinfo.data_size_in_dwords ? dinfo.data_size_in_dwords : 1, 4);
+         {
+            const uint8_t *e = (const uint8_t *)dinfo.entries;
+            const uint8_t *end = e + dinfo.entries_written_size_in_bytes;
+            const uint64_t desc_set_addr = 0x800004b080ULL;
+            const uint64_t literal_addr = 0x800004b040ULL;
+
+            while (e < end) {
+               const struct pvr_const_map_entry *hdr = (const struct pvr_const_map_entry *)e;
+
+               switch (hdr->type) {
+               case PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL32: {
+                  const struct pvr_const_map_entry_literal32 *lit =
+                     (const struct pvr_const_map_entry_literal32 *)e;
+
+                  if (lit->const_offset < dinfo.data_size_in_dwords)
+                     seg[lit->const_offset] = lit->literal_value;
+                  e += sizeof(*lit);
+                  break;
+               }
+               case PVR_PDS_CONST_MAP_ENTRY_TYPE_DESCRIPTOR_SET: {
+                  const struct pvr_const_map_entry_descriptor_set *d =
+                     (const struct pvr_const_map_entry_descriptor_set *)e;
+
+                  if (d->const_offset / 2 + 1 <= dinfo.data_size_in_dwords)
+                     ((uint64_t *)seg)[d->const_offset / 2] = desc_set_addr;
+                  e += sizeof(*d);
+                  break;
+               }
+               case PVR_PDS_CONST_MAP_ENTRY_TYPE_SPECIAL_BUFFER: {
+                  const struct pvr_const_map_entry_special_buffer *sp =
+                     (const struct pvr_const_map_entry_special_buffer *)e;
+
+                  if (sp->const_offset / 2 + 1 <= dinfo.data_size_in_dwords)
+                     ((uint64_t *)seg)[sp->const_offset / 2] = literal_addr;
+                  e += sizeof(*sp);
+                  break;
+               }
+               default:
+                  e = end;
+                  break;
+               }
+            }
+         }
+         printf("cdmc:          desc data dw=%u:", dinfo.data_size_in_dwords);
+         for (i = 0; i < dinfo.data_size_in_dwords; i++)
+            printf(" %08x", seg[i]);
+         printf("\n");
+         free(seg);
+         free(code_buf);
+         free(entries);
+
+         /* Build the CDM control stream for this dispatch (shared-update kernel, main kernel,
+          * fence kernel, terminate) and print it for comparison with the reference capture. The
+          * parameters here are the values the reference's dispatch logic derives: shared-update
+          * uses the descriptor program and 1 workgroup, the main kernel launches the flattened
+          * workgroup size, the fence kernel deallocates the shared registers. */
+         {
+            struct pvr_csb csb;
+            uint32_t stream[64];
+            bool emitted = true;
+
+            memset(stream, 0, sizeof(stream));
+            pvr_csb_init(&csb, stream, sizeof(stream), 0);
+
+#define CDM_EMIT_KERNEL(_common, _unified, _temp, _data, _target, _fence, _data_addr,                               _code_addr, _sd, _shared, _wg, _local, _maxinst)                               do {                                                                                          struct ROGUE_CDMCTRL_KERNEL0 k0 = { .block_type = ROGUE_CDMCTRL_BLOCK_TYPE_COMPUTE_KERNEL, \
+                  .indirect_present = false, .global_offsets_present = false,                                .event_object_present = false, .usc_common_size = (_common),                               .usc_unified_size = (_unified), .pds_temp_size = (_temp),                                  .pds_data_size = (_data), .usc_target = (_target), .fence = (_fence) };                 struct ROGUE_CDMCTRL_KERNEL1 k1 = { .data_addr = (_data_addr),                                .sd_type = (_sd), .usc_common_shared = (_shared) };                                     struct ROGUE_CDMCTRL_KERNEL2 k2 = { .code_addr = (_code_addr) };                           struct ROGUE_CDMCTRL_KERNEL3 k3 = { .workgroup_x = (_wg)[0] - 1 };                         struct ROGUE_CDMCTRL_KERNEL4 k4 = { .workgroup_y = (_wg)[1] - 1 };                         struct ROGUE_CDMCTRL_KERNEL5 k5 = { .workgroup_z = (_wg)[2] - 1 };                         struct ROGUE_CDMCTRL_KERNEL8 k8 = { .max_instances = (_maxinst),                              .workgroup_size_x = (_local)[0] - 1, .workgroup_size_y = (_local)[1] - 1,\
+                  .workgroup_size_z = (_local)[2] - 1 };                                                 uint32_t *dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_KERNEL0_length);                           if (dw == NULL) { emitted = false; break; }                                               ROGUE_CDMCTRL_KERNEL0_pack(dw, &k0);                                                      dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_KERNEL1_length);                                    if (dw == NULL) { emitted = false; break; }                                               ROGUE_CDMCTRL_KERNEL1_pack(dw, &k1);                                                      dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_KERNEL2_length);                                    if (dw == NULL) { emitted = false; break; }                                               ROGUE_CDMCTRL_KERNEL2_pack(dw, &k2);                                                      dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_KERNEL3_length);                                    if (dw == NULL) { emitted = false; break; }                                               ROGUE_CDMCTRL_KERNEL3_pack(dw, &k3);                                                      dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_KERNEL4_length);                                    if (dw == NULL) { emitted = false; break; }                                               ROGUE_CDMCTRL_KERNEL4_pack(dw, &k4);                                                      dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_KERNEL5_length);                                    if (dw == NULL) { emitted = false; break; }                                               ROGUE_CDMCTRL_KERNEL5_pack(dw, &k5);                                                      dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_KERNEL8_length);                                    if (dw == NULL) { emitted = false; break; }                                               ROGUE_CDMCTRL_KERNEL8_pack(dw, &k8);                                                   } while (0)
+
+            {
+               static const uint32_t wg1[3] = { 1, 1, 1 };
+               static const uint32_t wg64[3] = { 64, 64, 1 };
+               static const uint32_t l1[3] = { 1, 1, 1 };
+               static const uint32_t l64[3] = { 64, 1, 1 };
+
+               /* shared-update kernel: descriptor program, 1 workgroup */
+               CDM_EMIT_KERNEL(1, 0, 0, 2, ROGUE_CDMCTRL_USC_TARGET_ALL, false,
+                               0x2700, 0x2600, ROGUE_CDMCTRL_SD_TYPE_NONE, true,
+                               wg1, l1, 8);
+               if (emitted)
+                  CDM_EMIT_KERNEL(1, 1, 1, 2, ROGUE_CDMCTRL_USC_TARGET_ANY, false,
+                                  0x2640, 0x2660, ROGUE_CDMCTRL_SD_TYPE_USC, false,
+                                  wg64, l64, 0);
+               if (emitted)
+                  CDM_EMIT_KERNEL(0, 0, 0, 1, ROGUE_CDMCTRL_USC_TARGET_ANY, true,
+                                  0x1040, 0x1050, ROGUE_CDMCTRL_SD_TYPE_PDS, true,
+                                  wg1, l1, 8);
+               if (emitted) {
+                  struct ROGUE_CDMCTRL_STREAM_TERMINATE t = {
+                     .block_type = ROGUE_CDMCTRL_BLOCK_TYPE_STREAM_TERMINATE,
+                  };
+                  uint32_t *dw = pvr_csb_emit(&csb, ROGUE_CDMCTRL_STREAM_TERMINATE_length);
+
+                  if (dw != NULL)
+                     ROGUE_CDMCTRL_STREAM_TERMINATE_pack(dw, &t);
+                  else
+                     emitted = false;
+               }
+            }
+#undef CDM_EMIT_KERNEL
+            printf("cdmc:          ctrl stream dw=%u%s:", (unsigned)(csb.cur - csb.start),
+                   emitted ? "" : " (OVERFLOW)");
+            for (uint32_t *p = csb.start; p < csb.cur; p++)
+               printf(" %08x", *p);
+            printf("\n");
+         }
+      }
+   }
+   f = fopen(out_path, "wb");
+   if (f) {
+      fwrite(binary, 1, size, f);
+      fclose(f);
+      printf("cdmc:          wrote %s\n", out_path);
+   }
+   ralloc_free(shader);
+}
