+                              if (!pvr_bo_create(pvm_fd_for_probe, 4096, 1, &tbo) ||
+                                  (taddr = pvr_vm_alloc(vm, tbo.size, vm->general.page_size)) == 0 ||
+                                  !pvr_vm_map(vm, taddr, tbo.handle, tbo.size) ||
+                                  !pvr_bo_map(pvm_fd_for_probe, &tbo)) {
+                                 printf("hwrt:          could not set up the terminate block\n");
+                                 okc = false;
+                              } else {
+                                 pvr_csb_init(&tb, tbo.map, tbo.size, 0);
+                                 built = pvr_csb_emit_ta_state_header(&tb, &tpres) &&
