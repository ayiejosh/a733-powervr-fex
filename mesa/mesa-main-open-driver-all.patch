+bool
+pvr_csb_emit_link(struct pvr_csb *csb, uint64_t dev_addr, bool with_return)
+{
+   /* Both dwords are reserved together. A stream holding half a link would send the GPU
+    * to an address assembled from one new dword and one stale one. */
+   const uint32_t words = ROGUE_VDMCTRL_STREAM_LINK0_length +
+                          ROGUE_VDMCTRL_STREAM_LINK1_length;
+   struct ROGUE_VDMCTRL_STREAM_LINK0 link0 = {
+      .link_addrmsb = dev_addr,
+      .with_return = with_return,
+   };
+   struct ROGUE_VDMCTRL_STREAM_LINK1 link1 = {
+      .link_addrlsb = dev_addr,
+   };
+   /* Through the guard, not around it: a full stream still has to be able to say where
+    * it continues, which is the entire reason the guard is reserved. Ordinary emission
+    * cannot reach these dwords, so a stream can never be filled past the point where
+    * linking is still possible. */
+   uint32_t *dw = pvr_csb_emit_guarded(csb, words);
+
+   if (dw == NULL)
+      return false;
+
+   /* The address goes to both packets whole: the generated pack takes the low half for
+    * LINK1 and bits 32..39 for LINK0, which is what the reference does too. */
+   ROGUE_VDMCTRL_STREAM_LINK0_pack(dw, &link0);
+   ROGUE_VDMCTRL_STREAM_LINK1_pack(dw + ROGUE_VDMCTRL_STREAM_LINK0_length, &link1);
+
+   return true;
+}
+
+/* The geometry (VDM) static stream, mirroring the working Vulkan driver's
+ * pvr_geom_state_stream_init(): these six packets in this order, with the stream header written last
+ * carrying the total length. Unlike the fragment stream this one is NOT padded - the reference sets
+ * fw_stream_len from the pointer delta after the last packet and emits no padding, so neither does
+ * this. Each field's meaning is taken from the reference, not inferred:
+ *   CR_VDM_CTRL_STREAM_BASE         .addr = the geometry control stream's device address
+ *   CR_TPU_BORDER_COLOUR_TABLE_VDM  the border colour table's device address
+ *   CR_PPP_CTRL                     wclampen = 1, fixed_point_format = 1
+ *   CR_TE_PSG                       completeonterminate, region_stride (already in units), forcenewstate
+ *   VDMCTRL_PDS_STATE0              usc_common_size, already in its UNIT_SIZE units
+ *   KMD_STREAM_VIEW_IDX             the view index
+ *
+ * Returns the stream length in bytes, or 0 if it does not fit. */
+uint32_t
+pvr_geom_static_stream(void *stream, uint32_t stream_size,
+                       uint64_t ctrl_stream_addr, uint64_t border_colour_addr,
+                       bool geometry_terminate, uint32_t region_stride,
+                       bool forcenewstate, uint32_t usc_common_size, uint32_t view_idx,
+                       bool brn49927)
+{
+   const uint32_t used_dwords =
+      PVR_CMD_DW(KMD_STREAM_HDR) +
+      PVR_CMD_DW(CR_VDM_CTRL_STREAM_BASE) +
+      PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_VDM) +
+      PVR_CMD_DW(CR_PPP_CTRL) +
+      PVR_CMD_DW(CR_TE_PSG) +
+      PVR_CMD_DW(VDMCTRL_PDS_STATE0) +
+      PVR_CMD_DW(KMD_STREAM_VIEW_IDX);
+   /* Quirk 49927 requires an ext stream: a u32 ext header (type 0, data BIT(0)) followed by
+    * rogue_fwif_cmd_geom.regs.tpu. Without it the kernel's parser rejects the stream outright -
+    * it checks the device's "must have" quirk mask after the main stream. main_stream_len stays at
+    * the main stream's own length; the ext stream follows it. */
+   const uint32_t main_bytes = PVR_DW_TO_BYTES(used_dwords);
+   const uint32_t total_bytes = main_bytes + (brn49927 ? 8u : 0u);
+   uint8_t *p = (uint8_t *)stream + PVR_DW_TO_BYTES(PVR_CMD_DW(KMD_STREAM_HDR));
+   struct ROGUE_KMD_STREAM_HDR hdr = { .length = main_bytes };
+
+   if (total_bytes > stream_size)
+      return 0;
+
+   memset(stream, 0, total_bytes);
+
+   {
+      struct ROGUE_CR_VDM_CTRL_STREAM_BASE v = { .addr = ctrl_stream_addr };
+      ROGUE_CR_VDM_CTRL_STREAM_BASE_pack((uint32_t *)p, &v);
+      p += PVR_DW_TO_BYTES(PVR_CMD_DW(CR_VDM_CTRL_STREAM_BASE));
+   }
+   {
+      struct ROGUE_CR_TPU_BORDER_COLOUR_TABLE_VDM v = {
+         .border_colour_table_address = border_colour_addr,
+      };
+      ROGUE_CR_TPU_BORDER_COLOUR_TABLE_VDM_pack((uint32_t *)p, &v);
+      p += PVR_DW_TO_BYTES(PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_VDM));
+   }
+   {
+      struct ROGUE_CR_PPP_CTRL v = { .wclampen = true, .fixed_point_format = 1 };
+      ROGUE_CR_PPP_CTRL_pack((uint32_t *)p, &v);
+      p += PVR_DW_TO_BYTES(PVR_CMD_DW(CR_PPP_CTRL));
+   }
+   {
+      struct ROGUE_CR_TE_PSG v = {
+         .completeonterminate = geometry_terminate,
+         .forcenewstate = forcenewstate,
+         .region_stride = region_stride,
+      };
+      ROGUE_CR_TE_PSG_pack((uint32_t *)p, &v);
+      p += PVR_DW_TO_BYTES(PVR_CMD_DW(CR_TE_PSG));
+   }
+   {
+      struct ROGUE_VDMCTRL_PDS_STATE0 v = {
+         ROGUE_VDMCTRL_PDS_STATE0_header,
+         .usc_common_size = usc_common_size,
+      };
+      ROGUE_VDMCTRL_PDS_STATE0_pack((uint32_t *)p, &v);
+      p += PVR_DW_TO_BYTES(PVR_CMD_DW(VDMCTRL_PDS_STATE0));
+   }
+   {
+      struct ROGUE_KMD_STREAM_VIEW_IDX v = { .idx = view_idx };
+      ROGUE_KMD_STREAM_VIEW_IDX_pack((uint32_t *)p, &v);
+      p += PVR_DW_TO_BYTES(PVR_CMD_DW(KMD_STREAM_VIEW_IDX));
+   }
+
+   /* The packet sizes must account for exactly the length the header advertises - the same class of
+    * off-by-one that cost this driver two rounds on the fragment stream. */
+   assert((uint32_t)(p - (uint8_t *)stream) == main_bytes);
+
+   if (brn49927) {
+      uint32_t ext_header = 1u; /* type 0 << 29 | PVR_STREAM_EXTHDR_GEOM0_BRN49927 */
+      uint32_t tpu = 0;
+      memcpy(p, &ext_header, 4); p += 4;
+      memcpy(p, &tpu, 4); p += 4;
+   }
+
+   ROGUE_KMD_STREAM_HDR_pack((uint32_t *)stream, &hdr);
+
+   return total_bytes;
+}
+
+void
+pvr_csb_pds_bgnd_words(uint32_t shader_off, uint32_t texunicode_off,
+                       uint32_t texturedata_off, uint32_t temps_dwords,
+                       uint32_t shared_dwords, uint32_t texturestate_dwords,
+                       uint64_t words[3])
+{
+   struct ROGUE_CR_PDS_BGRND0_BASE bgnd0 = {
+      .shader_addr = shader_off,
+      .texunicode_addr = texunicode_off,
+   };
+   struct ROGUE_CR_PDS_BGRND1_BASE bgnd1 = {
+      .texturedata_addr = texturedata_off,
+   };
+   struct ROGUE_CR_PDS_BGRND3_SIZEINFO sizeinfo = {
+      .usc_sharedsize = DIV_ROUND_UP(shared_dwords,
+                                     ROGUE_CR_PDS_BGRND3_SIZEINFO_USC_SHAREDSIZE_UNIT_SIZE),
+      .pds_texturestatesize = DIV_ROUND_UP(texturestate_dwords,
+                                           ROGUE_CR_PDS_BGRND3_SIZEINFO_PDS_TEXTURESTATESIZE_UNIT_SIZE),
+      .pds_tempsize = DIV_ROUND_UP(temps_dwords,
+                                   ROGUE_CR_PDS_BGRND3_SIZEINFO_PDS_TEMPSIZE_UNIT_SIZE),
+   };
+
+   ROGUE_CR_PDS_BGRND0_BASE_pack(&words[0], &bgnd0);
+   ROGUE_CR_PDS_BGRND1_BASE_pack(&words[1], &bgnd1);
+   ROGUE_CR_PDS_BGRND3_SIZEINFO_pack(&words[2], &sizeinfo);
+}
+
+void
+pvr_frag_static_stream_fill_bgnd(void *stream, uint32_t stream_size,
+                                 uint64_t tpu_border_table_addr,
+                                 const uint64_t bgnd[3], const uint64_t pr_bgnd[3])
+{
+   const uint32_t pbe_dwords = PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
+   const uint32_t tpu_off = (PVR_FRAG_PRE_PBE_DWORDS + pbe_dwords) * 4;
+   const uint32_t bgnd_off = tpu_off + PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_PDM) * 4;
+   const uint32_t pr_bgnd_off = bgnd_off + ROGUE_NUM_CR_PDS_BGRND_WORDS * 8;
+   uint32_t *dw = (uint32_t *)stream;
+   struct ROGUE_CR_TPU_BORDER_COLOUR_TABLE_PDM tpu = {
+      .border_colour_table_address = tpu_border_table_addr,
+   };
+
+   if (pr_bgnd_off + ROGUE_NUM_CR_PDS_BGRND_WORDS * 8 > stream_size)
+      return;
+
+   ROGUE_CR_TPU_BORDER_COLOUR_TABLE_PDM_pack(&dw[tpu_off / 4], &tpu);
+   memcpy((uint8_t *)stream + bgnd_off, bgnd, ROGUE_NUM_CR_PDS_BGRND_WORDS * 8);
+   memcpy((uint8_t *)stream + pr_bgnd_off, pr_bgnd, ROGUE_NUM_CR_PDS_BGRND_WORDS * 8);
+}
+
+bool
+pvr_frag_static_stream_set_zls(void *stream, uint32_t stream_len,
+                               const struct pvr_device_info *dev_info, uint32_t zls_format,
+                               uint64_t zbase, uint32_t width, uint32_t height, bool load,
+                               bool store, uint32_t bgdepth, uint32_t zls_stride, bool twiddled,
+                               bool zonlyrender)
+{
+   const uint32_t pbe_dwords = PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
+   const uint32_t ctrl_off = (PVR_FRAG_PRE_PBE_DWORDS + pbe_dwords +
+                              PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_PDM) +
+                              2 * ROGUE_NUM_CR_PDS_BGRND_WORDS * 2 +
+                              ROGUE_KMD_STREAM_USC_CLEAR_REGISTER_COUNT *
+                                 PVR_CMD_DW(CR_USC_CLEAR_REGISTER)) * 4;
+   /* Header, scissor, dbias and occlusion bases come first (the kernel's frag stream order). */
+   const uint32_t zlsctl_off = (PVR_CMD_DW(KMD_STREAM_HDR) + PVR_CMD_DW(CR_ISP_SCISSOR_BASE) +
+                                PVR_CMD_DW(CR_ISP_DBIAS_BASE) + PVR_CMD_DW(CR_ISP_OCLQRY_BASE)) * 4;
+   const uint32_t zload_off = zlsctl_off + PVR_CMD_DW(CR_ISP_ZLSCTL) * 4;
+   /* zls_stride, sls_stride and execute_count close the stream (the capture's last 12 bytes). */
+   const uint32_t zls_stride_off = stream_len - 12;
+   uint32_t *dw = stream;
+   uint32_t tiles_x, tiles_y;
+
+   if (stream_len < ctrl_off + 8 || zls_stride_off <= ctrl_off)
+      return false;
+   /* rogue_get_isp_num_tiles_xy() for one sample (its header clashes with this csbgen). */
+   tiles_x = DIV_ROUND_UP(ALIGN_POT(width, 32), PVR_GET_FEATURE_VALUE(dev_info, tile_size_x, 16));
+   tiles_y = DIV_ROUND_UP(ALIGN_POT(height, 32), PVR_GET_FEATURE_VALUE(dev_info, tile_size_y, 16));
+   if (PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format)) {
+      tiles_x = ALIGN_POT(tiles_x, 2);
+      tiles_y = ALIGN_POT(tiles_y, 2);
+   }
+   const struct ROGUE_CR_ISP_ZLSCTL ctl = {
+      .zlsextent_x_z = tiles_x - 1,
+      .zlsextent_y_z = tiles_y - 1,
+      .zloadformat = zls_format,
+      .zstoreformat = zls_format,
+      .zloaden = load,
+      .zstoreen = store,
+      .forcezload = load,
+      .forcezstore = store,
+      .loadtwiddled = twiddled,
+      .storetwiddled = twiddled,
+      .zonlyrender = zonlyrender,
+   };
+   const struct ROGUE_CR_ISP_ZLOAD_BASE base = { .addr = zbase };
+   ROGUE_CR_ISP_ZLSCTL_pack(&dw[zlsctl_off / 4], &ctl);
+   ROGUE_CR_ISP_ZLOAD_BASE_pack(&dw[zload_off / 4], &base);
+   dw[ctrl_off / 4 + 1] = bgdepth;
+   dw[zls_stride_off / 4] = zls_stride;
+   return true;
+}
+
+void
+pvr_frag_static_stream_set_isp(void *stream, uint32_t stream_size,
+                               uint32_t usc_pixel_output_ctrl, uint32_t isp_ctl,
+                               uint32_t event_pixel_pds_info)
+{
+   const uint32_t pbe_dwords = PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
+   const uint32_t usc_clear_off = (PVR_FRAG_PRE_PBE_DWORDS + pbe_dwords +
+                                   PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_PDM) +
+                                   2 * ROGUE_NUM_CR_PDS_BGRND_WORDS * 2) * 4;
+   const uint32_t ctrl_off = usc_clear_off +
+                             ROGUE_KMD_STREAM_USC_CLEAR_REGISTER_COUNT *
+                                PVR_CMD_DW(CR_USC_CLEAR_REGISTER) * 4;
+   uint32_t *dw = (uint32_t *)stream;
+
+   if (ctrl_off + 7 * 4 > stream_size)
+      return;
+
+   /* These words are written raw: their packings are not decoded yet, and the values the reference
+    * writes for a 512x512 single-colour single-sample draw are what the firmware consumes. */
+   dw[ctrl_off / 4 + 0] = usc_pixel_output_ctrl;
+   dw[ctrl_off / 4 + 1] = 0x3f800000u;          /* isp_bgobjdepth = 1.0f */
+   dw[ctrl_off / 4 + 2] = 0x3ffu;               /* isp_bgobjvals */
+   dw[ctrl_off / 4 + 3] = 0;                    /* isp_aa (no MSAA) */
+   dw[ctrl_off / 4 + 4] = isp_ctl;
+   dw[ctrl_off / 4 + 5] = event_pixel_pds_info;
+   dw[ctrl_off / 4 + 6] = 0;                    /* view_idx */
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_csb.h b/src/gallium/drivers/pvr_native/pvr_csb.h
new file mode 100644
index 00000000..47695cc7
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_csb.h
@@ -0,0 +1,861 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The control stream builder (CSB).
+ *
+ * This is the hardware's command stream: the GPU executes what is written here, so a
+ * writer that overruns its buffer corrupts whatever follows it in memory rather than
+ * raising an error anyone will see. That is why emit() refuses rather than truncating.
+ *
+ * The packet layouts are NOT defined here - they come from csbgen, the same generator
+ * the Vulkan driver uses (the csbgen XML files -> the headers below, which provide a field
+ * struct plus pack/unpack per packet). Only the stream plumbing is ours.
+ */
+#ifndef PVR_CSB_H
+#define PVR_CSB_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* The generated pack helpers express addresses through these, and this driver's device
+ * addresses are plain 64-bit values (see pvr_vm.h), so they pass through unchanged.
+ * They must be defined before the generated headers are included. */
+#define __pvr_address_type uint64_t
+#define __pvr_get_address(addr) (addr)
+#define __pvr_make_address(addr) (addr)
+
+#include "pipe/p_defines.h"
+#include "pipe/p_state.h"
+#include "util/format/u_formats.h"
+
+#include "csbgen/rogue/cr.h"
+#include "csbgen/rogue/kmd_stream.h"
+#include "csbgen/rogue/lls.h"
+
+#include "common/pvr_limits.h"
+#include "csbgen/rogue/ipf.h"
+#include "csbgen/rogue/kmd_stream.h"
+
+#include "common/pvr_limits.h"
+#include "csbgen/rogue/pbestate.h"
+#include "csbgen/rogue/pds.h"
+#include "csbgen/rogue/ppp.h"
+#include "csbgen/rogue/texstate.h"
+#include "csbgen/rogue/vdm.h"
+
+struct pvr_device_info;
+
+struct pvr_csb {
+   uint32_t *start;
+   uint32_t *cur;
+   uint32_t *end;       /* last dword ordinary emission may use */
+   uint32_t *guard_end; /* absolute end, reachable only by the stream link */
+   bool overflowed;
+};
+
+/* The stream is written directly into the mapped buffer object, so the caller owns the
+ * memory and must keep it mapped for as long as the CSB is used.
+ *
+ * guard_dwords are held back at the end and are NOT available to ordinary emission. A
+ * control stream that fills its buffer has to continue somewhere, and the only way to
+ * say so is the stream link - so the link's dwords must still fit in the current buffer
+ * at the moment it is full. The reference reserves exactly this and says why
+ * (pvr_arch_csb.c: "a few bytes including guard padding size are reserved at the end,
+ * every time a buffer is created"). Passing 0 means a buffer that cannot be linked and
+ * therefore must not overflow.
+ *
+ * The guard is deliberately not callable by mistake: pvr_csb_emit() will not hand out
+ * guarded dwords even when they are physically free, so a stream cannot be filled past
+ * the point where linking is still possible. */
+void pvr_csb_init(struct pvr_csb *csb, void *map, uint32_t size_bytes,
+                  uint32_t guard_dwords);
+
+/* Continue the stream in another buffer, after a link to it has been emitted.
+ *
+ * Chaining is only half-expressed without this: emitting a link says where the GPU will
+ * go, but unless the builder follows it, everything written afterwards lands in the OLD
+ * buffer past the guard - i.e. the stream says one thing and contains another. Callers
+ * emit the link and then switch, in that order.
+ *
+ * The size of the buffer just finished is returned so the caller can accumulate the
+ * job's total stream length across the chain. */
+uint32_t pvr_csb_switch_buffer(struct pvr_csb *csb, void *map, uint32_t size_bytes,
+                              uint32_t guard_dwords);
+
+/* Load a PDS program: the three VDMCTRL_PDS_STATE packets that tell the hardware where the
+ * program's data and code are, how many temporaries it needs, and that the next thing to
+ * fetch is USC code.
+ *
+ * `program_addr` is the device address of the program's DATA segment; the code segment
+ * follows it immediately, which is why STATE2 is derived rather than passed - a caller
+ * able to disagree with itself about where the code starts is a caller able to produce a
+ * program that is half old and half new.
+ *
+ * pds_data_size is in units of ROGUE_VDMCTRL_PDS_STATE0_PDS_DATA_SIZE_UNIT_SIZE, not
+ * bytes: the field is a count of units, and passing bytes would silently under-report on
+ * any program whose data segment is not one unit. */
+bool pvr_csb_emit_pds_state_update(struct pvr_csb *csb, uint64_t program_addr,
+                                   uint32_t data_dwords, uint32_t temps, bool for_fragment);
+
+/* Point the hardware at a state block: the two VDMCTRL_PPP_STATE packets that carry an
+ * address and the block's length in words.
+ *
+ * The address is split across the packets exactly as the stream link's is - STATE0 takes
+ * the high part and STATE1 the low - so both are given the whole address and the generated
+ * pack extracts its half. The word count is in 32-bit WORDS, not bytes.
+ *
+ * The block itself is written by the caller elsewhere in a buffer the GPU can reach; this
+ * only says where it is. Passing an address the GPU cannot read is not detectable here and
+ * is the caller's responsibility. */
+bool pvr_csb_emit_ppp_state(struct pvr_csb *csb, uint64_t state_addr,
+                            uint32_t word_count);
+
+/* The vertex half of the VDM state. All of it comes from a capture of a working draw
+ * (open-driver-perf/captures/vkrender_draw_stream_decoded.txt): a draw that executes its vertex
+ * program sets BOTH presence flags and then carries the code address, the output size and the
+ * allocation sizes. A stream that only names the PDS data address runs an attribute fetch and never
+ * starts a shader - which looks exactly like a correct stream until no pixel changes. */
+struct pvr_vdm_vs {
+   /* STATE2: the attribute program's DATA segment (the patched const map, not the vertex buffer). */
+   uint64_t pds_data_addr;
+   /* STATE3: the attribute program's CODE segment. Non-zero means the VS info packets are sent. */
+   uint64_t pds_code_addr;
+   /* STATE4: varying registers written per vertex (pco_data.vs.vtxouts). */
+   uint32_t output_size;
+   /* STATE5: vtxin registers * 4 (pco_data.common.vtxins << 2). */
+   uint32_t usc_unified_bytes;
+   /* STATE5: the attribute program's PDS temp count and data segment size, in dwords. */
+   uint32_t pds_temp_dwords;
+   uint32_t pds_data_dwords;
+   /* STATE5: from pvr_vdm_cam_size(). */
+   uint32_t max_instances;
+   /* STATE0: from pvr_vdm_cam_size(); this is the field value (31 for cam_size 32). */
+   uint32_t cam_size;
+};
+
+/* The VDM state update, which is a CONDITIONALLY VARIABLE-LENGTH group rather than a fixed
+ * shape: VDMCTRL_VDM_STATE0 carries flags saying which of STATE1..5 follow it, and the
+ * presence packs are only emitted for the flags that are set. VDM_STATE1 appears when a
+ * cut index is needed, VDM_STATE2 when the vertex-shader PDS data address changes, and
+ * VDM_STATE3..5 when the vertex program's code location/sizes are (re)supplied.
+ *
+ * `vs` may be NULL (no vertex state at all) or carry only pds_data_addr (data address without the
+ * code half). The lengths and the packets are derived from the same presence flags, so the stream
+ * cannot claim packets it does not carry. */
+/* VDMCTRL_PDS_STATE0..2: the vertex stage's descriptor (uniform) program, run before the vertex
+ * shader to fill its shared registers, as the reference's pvr_emit_dirty_pds_state. The data and
+ * code addresses are PDS-heap offsets; usc_shared_dwords is the vertex shader's shared count. */
+bool pvr_csb_emit_vdm_pds_state(struct pvr_csb *csb, uint32_t usc_shared_dwords,
+                                uint64_t pds_data_addr, uint32_t pds_data_dwords,
+                                uint64_t pds_code_addr);
+
+bool pvr_csb_emit_vdm_state(struct pvr_csb *csb, bool cut_index_enable,
+                            uint32_t cut_index, const struct pvr_vdm_vs *vs,
+                            uint32_t *words_out);
+
+/* ISP/VDM tiles-in-flight setup: the ISP pipe enable count and the USC pixel-output control word
+ * (width and partition mask). A port of the reference's pvr_arch_setup_tiles_in_flight(); the
+ * constants come from the device features and the kernel's runtime info, exactly as there. */
+void pvr_setup_tiles_in_flight(const struct pvr_device_info *dev_info,
+                               const struct pvr_device_runtime_info *runtime,
+                               uint32_t pixel_width, bool paired_tiles,
+                               uint32_t max_tiles_in_flight, uint32_t *isp_ctl,
+                               uint32_t *pixel_ctl);
+
+/* cam_size and max_instances from the vertex output size. A port of the reference's
+ * pvr_arch_calculate_vertex_cam_size(); see the definition for why it is copied instead of
+ * re-derived. */
+void pvr_vdm_cam_size(const struct pvr_device_info *dev_info, uint32_t vs_output_size,
+                      bool raster_enable, uint32_t *cam_size_out,
+                      uint32_t *max_instances_out);
+
+/* What the hardware needs to read a texture, in the two parts it actually takes.
+ *
+ * enum ROGUE_TEXSTATE_FORMAT names COMPONENT layouts, not channel orders: it has U8U8U8U8 but
+ * nothing saying which component is red. Channel order is a separate swizzle, so both halves
+ * are needed and neither is a descriptor on its own.
+ *
+ * The swizzle turned out not to need a table at all. The reference's
+ * pvr_get_format_swizzle_for_tpu() returns desc->swizzle for colour formats - the gallium
+ * format description's own swizzle - and {X, NONE, NONE, NONE} for depth/stencil, because
+ * depth and stencil are read from one channel regardless of how they are stored. So the piece
+ * that looked like 44 KB of table is fifteen lines of logic, and the 44 KB is elsewhere.
+ *
+ * Returns false for formats whose component layout is not one of the cases handled here.
+ * Guessing a component layout is as wrong as guessing a channel order. */
+struct pvr_format_layout {
+   enum ROGUE_TEXSTATE_FORMAT components;
+
+   /* PIPE_SWIZZLE_* per channel, in the order the hardware reads them. */
+   uint8_t swizzle[4];
+};
+
+bool pvr_format_layout_from_pipe(enum pipe_format format,
+                                 struct pvr_format_layout *layout_out);
+
+/* Translate one gallium channel selector into the hardware's swizzle value.
+ *
+ * The correspondence is one-to-one and needs no table: SRCCHAN_0..3 are PIPE_SWIZZLE_X/Y/Z/W
+ * and SRC_ONE/SRC_ZERO are PIPE_SWIZZLE_1/0. PIPE_SWIZZLE_NONE has NO hardware equivalent and
+ * is refused rather than mapped to something close - it means "no channel here", which is a
+ * statement about the format rather than a selector, and silently turning it into a zero
+ * would change what is sampled.
+ *
+ * Returns false for anything it cannot represent exactly. */
+bool pvr_swizzle_from_pipe(uint8_t pipe_swizzle, enum ROGUE_TEXSTATE_SWIZ *out);
+
+/* A texture descriptor for what this driver can actually describe: a colour format, 2D,
+ * linear memory.
+ *
+ * Every field follows round 35's closed spec. Three points are load-bearing and each was a
+ * trap when read off the field names rather than the reference's usage:
+ *
+ *  - textype is STRIDE, which IS the linear layout - and STRIDE permits only 2D views, so
+ *    this function has no 1D/cube/3D case to give. Linear was chosen in round 1; the packet
+ *    follows from it.
+ *  - width, height and stride are all MINUS ONE. Fields of this shape come in families here.
+ *  - smpcnt is log2 of the sample count, so one sample is 0. Multi-sampling is not supported,
+ *    so it is 0 and there is nothing to compute.
+ *
+ * The STRIDE_IMAGE_WORD1 variant carries `stride` and has no depth/baselevel/border; those
+ * belong to the twiddled variant and to geometry this driver does not describe.
+ *
+ * width, height and stride must be at least 1 - the hardware stores value-minus-one, so a 0
+ * would underflow into a very large extent rather than fail. Refused rather than masked. */
+struct pvr_tex_desc {
+   enum ROGUE_TEXSTATE_FORMAT components;
+   uint8_t swizzle[4];
+
+   uint32_t width;
+   uint32_t height;
+   uint32_t stride; /* in pixels, like the hardware field (texstate.xml) */
+   uint64_t addr;
+
+   /* Twiddled and, optionally, TFBC-compressed image (colour render targets). */
+   bool twiddled;
+   bool fbc;
+
+   /* sRGB texture: the TPU decodes the stored bytes to linear values. */
+   bool gamma;
+
+   /* Alpha sits in the most significant channel byte (the reference's vk_format_is_alpha_on_msb):
+    * the TPU needs this to know the stored channel order when it decodes sRGB. */
+   bool alpha_msb;
+
+   /* Cube map: TEXTYPE_CUBE with the face count in IMAGE_WORD1.depth (faces - 1), sampled with the
+    * hardware's direction-to-face selection. */
+   bool cube;
+   uint32_t layers;
+
+   /* A twiddled mip chain: levels sampled (0 or 1: none) and the first one. width/height are
+    * level 0's then. */
+   uint32_t num_levels;
+   uint32_t base_level;
+};
+
+bool pvr_csb_emit_tex_desc(struct pvr_csb *csb, const struct pvr_tex_desc *desc);
+
+/* Wrap mode and filter, translated for the sampler descriptor.
+ *
+ * These two are the whole of the sampler's unambiguous part: PIPE_TEX_WRAP_* maps cleanly onto
+ * ROGUE_TEXSTATE_ADDRMODE_* and PIPE_TEX_FILTER_* onto ROGUE_TEXSTATE_FILTER_*, with no
+ * arithmetic and no units in between. Anything not representable exactly is refused.
+ *
+ * NOT here, deliberately: the sampler's other fields. Two of them are unresolved rather than
+ * merely unimplemented - minlod/maxlod are typed enum ROGUE_TEXSTATE_CLAMP whose values are
+ * MIN/MAX/INTEGER_BITS/FRACTIONAL_BITS, i.e. the lod range is FIXED-POINT with a bit split the
+ * enum describes, and cmp_mode/bordercolor_index/anisoctl/dadjust have encodings that have not
+ * been read. A sampler emitted with those left at zero would be a descriptor that looks
+ * complete and states things nobody decided - which is the failure this file keeps refusing. */
+bool pvr_addrmode_from_pipe(enum pipe_tex_wrap mode, enum ROGUE_TEXSTATE_ADDRMODE *out);
+bool pvr_filter_from_pipe(enum pipe_tex_filter filter, enum ROGUE_TEXSTATE_FILTER *out);
+
+/* Comparison function, for a sampler used with a depth texture. Eight gallium functions onto
+ * eight hardware values, one-to-one, no arithmetic.
+ *
+ * Note what is NOT here: the hardware enum has no "no comparison" member, so the disabled case
+ * has no dedicated encoding. ALWAYS would be the sensible reading - a comparison that always
+ * passes is a comparison that does not filter - but that is an INFERENCE about the reference's
+ * intent and is deliberately not asserted in code. The sampler's disabled case needs the
+ * reference's usage read, exactly as the lod encoding does. */
+bool pvr_cmp_mode_from_pipe(enum pipe_compare_func func, enum ROGUE_TEXSTATE_CMP_MODE *out);
+
+/* A sampler descriptor, for what this driver supports: no mips, no anisotropic filtering, no
+ * border colour, no depth comparison, normalized coordinates.
+ *
+ * Some fields are set to a constant because the REFERENCE never assigns them, which is a fact
+ * about the working driver rather than an inference about the hardware:
+ *   cmp_mode is never assigned by pvr_arch_sampler.c, so every sampler the Vulkan driver creates
+ *   carries 0 (CMP_MODE_NEVER). Round 38 reasoned that ALWAYS would be "sensible" for a disabled
+ *   comparison - the reference does not agree, and 0 is what demonstrably works.
+ *
+ * lod is FIXED-POINT: util_unsigned_fixed(value, ROGUE_TEXSTATE_CLAMP_FRACTIONAL_BITS), and that
+ * constant's value is 6 - the members of that enum ARE bit counts (INTEGER_BITS is 4), which is
+ * why they read like names. Fourth member of the units family. */
+struct pvr_sampler_desc {
+   /* Border colour table index: 0 is the hardware's built-in transparent black; custom colours
+    * live from index 5 up (the hardware decodes 0..4 as the Vulkan built-in border colours, which
+    * is also what the reference relies on), so samplers that clamp to border point at their entry. */
+   uint32_t bordercolor_index;
+   /* ROGUE_TEXSTATE_ANISOCTL: 0 disabled, 1 x2, 2 x4, 3 x8, 4 x16. */
+   uint32_t anisoctl;
+   enum pipe_tex_wrap wrap_s;
+   enum pipe_tex_wrap wrap_t;
+   enum pipe_tex_wrap wrap_r;
+   enum pipe_tex_filter min_filter;
+   enum pipe_tex_filter mag_filter;
+   bool mip_filter; /* linear between levels */
+   float min_lod;
+   float max_lod;
+};
+
+bool pvr_csb_emit_sampler_desc(struct pvr_csb *csb,
+                               const struct pvr_sampler_desc *desc);
+
+/* What a TA (triangle-accumulation) state block will contain.
+ *
+ * TA_STATE_HEADER is a PRESENCE BITMAP: it announces which state packets follow it, so the
+ * sequence is variable-length in exactly the way round 26's VDM group is - one flag word, then
+ * whichever packets the flags called for. Emitting the packets without the matching bits writes
+ * state the hardware does not read; emitting the bits without the packets makes it read
+ * whatever follows as state.
+ *
+ * Only the presence bits this driver can currently justify are represented. The header has
+ * roughly two dozen (region clip, wclamp, varying words 0-2, outselects, PDS state pointers 0-3,
+ * stream out, PPP control, terminate, ...); a bit set for a packet this driver cannot yet emit is
+ * worse than absent, because it makes the hardware read the next packet as that state. */
+struct pvr_ta_presence {
+   bool ispctl;
+   bool ispctl_fa;
+   bool ispctl_fb;
+   bool ispctl_ba;
+   bool ispctl_bb;
+   bool ispctl_dbsc;
+   bool pds_state_ptr0;  /* SHADERBASE, TEXUNICODEBASE, SIZEINFO1, SIZEINFO2 */
+   bool pds_state_ptr1;  /* VARYINGBASE: the coefficient (varying) program */
+   bool pds_state_ptr3;  /* UNIFORMDATABASE */
+   bool region_clip;
+   bool viewport;
+   bool wclamp;
+   bool outselects;
+   bool varying_words;   /* VARYING0..2 */
+   bool ppp_ctrl;
+   bool stream_out_size;
+   bool terminate;       /* a terminate block: header + TERMINATE0/1, nothing else */
+   uint8_t viewport_count;
+};
+
+/* Emits only the header. The packets it announces are the caller's to emit, in the order the
+ * hardware expects, and a caller that sets a bit without emitting the packet is describing a
+ * block that does not exist. The header is the first word of a PPP state block (a plain memory
+ * block, not a stream), so the caller composes the block by calling this and then one writer per
+ * set bit, in the reference's order:
+ *
+ *   header, ISPCTL, ISPA(front), ISPB(front), [ISPA(back), ISPB(back)], ISPDBSC,
+ *   PDS bases..., REGION_CLIP, VIEWPORT, WCLAMP, OUTPUT_SEL, VARYING0..2, PPP_CTRL, STREAM_OUT0
+ *
+ * viewport_count is a count; the header stores count-1 (the capture carries 0 for one viewport). */
+bool pvr_csb_emit_ta_state_header(struct pvr_csb *csb,
+                                  const struct pvr_ta_presence *pres);
+
+/* The two face-value words and the depth-bias/scissor index word that follow ISPCTL. ISPA holds
+ * the A-format face (object type, pass type, depth/stencil compare, write masks), ISPB the
+ * B-format one (stencil compare/ops). The reference writes front A/B and, when two-sided, back
+ * A/B too; this driver emits what the caller asks for. */
+bool pvr_csb_emit_ta_isp_a(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPA *a);
+bool pvr_csb_emit_ta_isp_b(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPB *b);
+bool pvr_csb_emit_ta_isp_dbsc(struct pvr_csb *csb, const struct ROGUE_TA_STATE_ISPDBSC *dbsc);
+
+/* The viewport is SIX RAW DWORDs in the block - no packet type, no header - in the order
+ * a0, m0, a1, m1, a2, m2. The captured draw's values for a 512-wide viewport are
+ * 256.0f 256.0f 256.0f 256.0f 0.0f 1.0f as floats. Kept as raw dwords here because the
+ * scale/translate-to-a/m mapping has not been ported yet; inventing it would be a guess. */
+struct pvr_viewport_words {
+   uint32_t a0, m0, a1, m1, a2, m2;
+};
+bool pvr_csb_emit_ta_viewport(struct pvr_csb *csb,
+                              const struct pvr_viewport_words *vp);
+
+/* VARYING0/1 carry the per-interpolation varying counts, VARYING2 is only ever written as zero
+ * (the reference writes a literal 0 there on the first draw of a render job). */
+bool pvr_csb_emit_ta_varying(struct pvr_csb *csb,
+                             const struct ROGUE_TA_STATE_VARYING0 *v0,
+                             const struct ROGUE_TA_STATE_VARYING1 *v1);
+
+/* STATE_PPP_CTRL: cull mode, clip mode, flat-shade vertex, w-clamp enable. */
+bool pvr_csb_emit_ta_ppp_ctrl(struct pvr_csb *csb,
+                              const struct ROGUE_TA_STATE_PPP_CTRL *ctrl);
+
+/* TA_STATE_STREAM_OUT0, always zero here (no stream output). */
+bool pvr_csb_emit_ta_stream_out(struct pvr_csb *csb);
+
+/* TA_STATE_TERMINATE0/1, the last two words of a terminate block. The block is a header with only
+ * pres_terminate set, then these two words. Clip values are in the same device-alignment units as
+ * region clip. */
+bool pvr_csb_emit_ta_terminate(struct pvr_csb *csb,
+                               const struct ROGUE_TA_STATE_TERMINATE0 *t0,
+                               const struct ROGUE_TA_STATE_TERMINATE1 *t1);
+
+/* TA_STATE_ISPCTL, the packet the header's pres_ispctl bit announces.
+ *
+ * Three of its fields are DERIVED from state this driver records, and each mapping is checked
+ * against the field's own documentation rather than guessed:
+ *
+ *   dbenable   "If set, depth bias is enabled."  The reference gates it on its depth_bias.enable
+ *              and the object being a triangle; gallium's equivalent is offset_tri. Note this is
+ *              depth BIAS, not depth test - reading the name as "depth test enabled" is the
+ *              obvious mistake and the generated header's comment is what rules it out.
+ *   scenable   "If set, scissor coordinates are enabled."  Off when rasterization is discarded.
+ *   tagwritedisable  no writes when rasterization is discarded or there is no fragment shader.
+ *
+ * The rest (visibility, user pass, two-sided) come from the caller: they belong to state this
+ * driver does not compute yet, and defaulting them would be asserting things nobody decided. */
+struct pvr_ta_ispctl {
+   uint32_t validid;
+   uint32_t upass;
+   bool two_sided;
+   bool bpres;
+   bool vistest;
+   bool visbool;
+   uint32_t visreg;
+};
+
+bool pvr_csb_emit_ta_ispctl(struct pvr_csb *csb,
+                            const struct pipe_rasterizer_state *rast,
+                            bool have_fragment_shader,
+                            const struct pvr_ta_ispctl *in);
+
+/* The TA clip region - how the header's pres_viewport bit and view_port_count are cashed in.
+ *
+ * There is no separate viewport packet: the viewport IS the clip rectangle, expressed in units of
+ * a device-derived alignment. Two things about the conversion are easy to get wrong and silent:
+ *
+ *   - coordinates are DIVIDED by the alignment, so the region is not in pixels;
+ *   - right and bottom are ROUND-UP-MINUS-ONE of the far edge, not the far edge itself. A region
+ *     one unit short on each side clips a row or column of pixels that should have been drawn,
+ *     which looks like a rasterisation bug rather than a state bug.
+ *
+ * The alignment is 16 on devices with 16x16 tiles and 32 otherwise, so it is computed in the
+ * screen where the device info lives - the CSB writer takes the number, not the device. */
+struct pvr_region_clip {
+   uint32_t left;
+   uint32_t right;
+   uint32_t top;
+   uint32_t bottom;
+};
+
+void pvr_region_clip_from_rect(uint32_t x, uint32_t y, uint32_t width,
+                               uint32_t height, uint32_t align,
+                               struct pvr_region_clip *out);
+
+bool pvr_csb_emit_ta_region_clip(struct pvr_csb *csb,
+                                 const struct pvr_region_clip *clip);
+
+/* TA_WCLAMP's minimum w.
+ *
+ * COPIED from the reference, not derived: pvr_arch_cmd_buffer.c emits
+ *   wclamp.val = fui(1.0e-13f);
+ * and the field's type gives no clue that it holds a FLOAT BIT PATTERN rather than the small
+ * integer it looks like. A value invented here - 0, or a depth - would be a plausible number in
+ * the same slot doing something else entirely, which is the failure this programme keeps
+ * recording. The reference's value is the only evidence available for what belongs there. */
+#define PVR_TA_WCLAMP_MIN_W 1.0e-13f
+
+bool pvr_csb_emit_ta_wclamp(struct pvr_csb *csb, float min_w);
+
+/* The four PDS base pointers: where the TA finds a program's shader, varying, texture-data and
+ * uniform-data regions.
+ *
+ * ALL FOUR have the same window - bits **[4:31]**, a 28-bit field carrying address bits 4 to 31 -
+ * checked in the generated headers rather than assumed from the first one. This device has a
+ * 40-bit address space, so a full device address does not fit and the generated pack keeps 28
+ * bits and drops the rest WITHOUT COMPLAINT.
+ *
+ * The reference never trips over this because it passes PVR_DEV_ADDR(offset) - an offset that
+ * happens to fit. A driver passing a real device address walks straight into it, which is what
+ * happened when SHADERBASE was written (round 47), found only because the check asserted the FULL
+ * address round-tripped rather than one half.
+ *
+ * So there is one function rather than four: the window check is the same check, and four copies
+ * of it would be four places for it to drift. Out-of-window addresses are refused rather than
+ * truncated - a truncated address fetches from somewhere else entirely and nothing reports it.
+ *
+ * The address must also be one the GPU can read. Nothing validates that here, and the kernel does
+ * not either: it checks the command stream's own range, not what the stream later dereferences. */
+enum pvr_pds_base {
+   PVR_PDS_BASE_SHADER,
+   PVR_PDS_BASE_VARYING,
+   PVR_PDS_BASE_TEXTUREDATA,
+   PVR_PDS_BASE_UNIFORMDATA,
+   PVR_PDS_BASE_TEXUNICODE,
+};
+
+bool pvr_csb_emit_ta_pds_base(struct pvr_csb *csb, enum pvr_pds_base which, uint64_t addr);
+
+/* TA_OUTPUT_SEL: what the TA passes on to the pixel stage.
+ *
+ * Two of its flags are NOT derived here, and the reason is written down rather than left as a gap:
+ *
+ *   rhw_pres                 = the fragment shader uses w
+ *   tsp_unclamped_z_pres     = the fragment shader uses z
+ *
+ * The reference reads both from a per-shader usage record (`fs_data->fs.uses.w` / `.z`) produced by
+ * its own shader analysis. This driver has no equivalent: the pco pipeline runs on NIR and the
+ * information is in NIR's system-value usage, but deriving it needs an analysis pass that does not
+ * exist yet. Setting them from a guess - "the FS probably uses z" - would be the plausible-inference
+ * mistake this programme has recorded five times, so they are caller-supplied and the caller is the
+ * place that has to know.
+ *
+ * The clip-plane arrays are per-plane enables; a caller with no user clip planes leaves them false,
+ * which is a statement ("no planes") rather than an omission. */
+struct pvr_ta_output_sel {
+   uint32_t vtxsize;
+   bool rhw_pres;                    /* caller: FS uses w */
+   bool tsp_unclamped_z_pres;        /* caller: FS uses z */
+   bool render_tgt_pres;
+   bool vpt_tgt_pres;
+   bool psprite_size_pres;
+   bool isp_position_depth_clamp_z;
+   bool plane[8];
+   bool cullplane[8];
+};
+
+bool pvr_csb_emit_ta_output_sel(struct pvr_csb *csb,
+                                const struct pvr_ta_output_sel *sel);
+
+/* TA_STATE_PDS_SIZEINFO1/2: how much PDS and USC storage a program needs.
+ *
+ * The caller passes DWORD COUNTS (registers, PDS data dwords) and this function applies the units,
+ * because the units are per-field and differ:
+ *
+ *   pds_uniformsize       / 4      pds_texturestatesize / 4
+ *   pds_varyingsize       / 4      pds_tempsize        / 4
+ *   usc_varyingsize       / 16     usc_sharedsize      / 16
+ *
+ * The units count dwords, as the reference uses them (pvr_arch_cmd_buffer.c divides
+ * pds_coeff_program.data_size and fs_data->common.coeffs, both dwords, by these units). Passing
+ * bytes makes every field four times too large.
+ *
+ * All divisions round UP, as the reference does - a size that is not a whole number of units must
+ * still allocate the last one. */
+struct pvr_pds_sizes {
+   uint32_t uniform_dwords;
+   uint32_t texturestate_dwords;
+   uint32_t varying_dwords;
+   uint32_t usc_varying_dwords;
+   uint32_t temp_count;
+   uint32_t usc_shared_count;
+};
+
+/* Depth load/store for a fragment stream built by pvr_frag_static_stream(): ISP_ZLSCTL and
+ * ISP_ZLOAD_BASE, the background depth and zls_stride, as the reference's job setup writes them.
+ * zls_format is a ROGUE_CR_ZLS_FORMAT_TYPE; the buffer is untwiddled, width x height padded to
+ * whole ISP tiles. Returns false for a stream of an unexpected size. */
+bool pvr_frag_static_stream_set_zls(void *stream, uint32_t stream_len,
+                                    const struct pvr_device_info *dev_info, uint32_t zls_format,
+                                    uint64_t zbase, uint32_t width, uint32_t height, bool load,
+                                    bool store, uint32_t bgdepth, uint32_t zls_stride,
+                                    bool twiddled, bool zonlyrender);
+
+bool pvr_csb_emit_ta_pds_sizeinfo(struct pvr_csb *csb, const struct pvr_pds_sizes *sizes,
+                                  bool tri_merge_disable, uint32_t batchnum);
+
+/* Builds the three 64-bit PBE register words a fragment job's firmware stream carries per colour
+ * attachment, in the reference's encoding (pvr_arch_job_common.c pvr_pbe_state_words):
+ *
+ *   words[0] = PBESTATE_REG_WORD0 - memory layout, encoded stride, channel swizzles
+ *   words[1] = PBESTATE_REG_WORD1 - clip extents (size_{x,y} stay zero for a linear target)
+ *   words[2] = zero
+ *
+ * Note what is NOT here: the target address and output format live in the pixel-event PDS program's
+ * emit words (PBESTATE_STATE_WORD0/WORD1), not in this stream. Putting the state words here makes a
+ * stream the kernel parses into a nonsense command.
+ *
+ * Returns false for formats whose PBE packmode this function does not encode. */
+bool pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width,
+                       uint32_t height, uint32_t phys_height, bool twiddled, bool fbc,
+                       uint64_t words[3]);
+
+/* The PBE *state* words (PBESTATE_STATE_WORD0/WORD1) for one colour attachment: target address,
+ * output format, MRT index, normalisation and pack mode. These do not belong in the fragment
+ * firmware stream - they are the emit words of the pixel-event program, which is what points the
+ * PBE at the render target at end of tile. `words[0]` is STATE_WORD0, `words[1]` STATE_WORD1, the
+ * same layout the reference's pvr_pbe_state_words() produces. */
+void pvr_csb_pbe_state_words(uint64_t addr, enum pipe_format format, uint32_t mrt_index,
+                             uint32_t source_pos_dword,
+                             bool emptytile, uint32_t words[2]);
+
+/* The PBE (pixel backend) render-target address: PBESTATE_STATE_WORD0 + STATE_WORD1.
+ *
+ * The generated pack places the two halves like this:
+ *
+ *    dw[0] = __pvr_address(values->address_high, 34, 0, 5)   <- SHIFT 34, six bits
+ *            (address_low contributes at shift 0, bits [0:31])
+ *
+ * so the encoded address is bits [0:31] plus bits [34:39]: a 40-bit window in which bits 32 and 33
+ * are NOT represented and must be zero. In other words PBE targets are **16 GiB aligned**
+ * (2^34), and the window reaches 1 TiB.
+ *
+ * This device's general heap base is 0x8000000000 (2^39), which FITS - the field's high part takes
+ * the value 32 there. An earlier version of this function refused it, having read the field's
+ * declared range (bits [0:5]) and assumed it sat at bit 32 rather than reading the packer's shift.
+ * The declaration says how wide a field is; only the pack says WHERE it goes, and the two are not
+ * the same piece of information.
+ *
+ * Enforced here rather than left to the packer: an address with bits 32 or 33 set cannot be
+ * represented, and would otherwise be silently re-encoded to a different address. */
+struct pvr_pbe_target {
+   uint64_t addr;
+   enum ROGUE_PBESTATE_SOURCE_FORMAT source_format;
+   uint32_t mrt_index;
+
+   /* The four channel selectors, translated from the format's swizzle (round 64). */
+   enum ROGUE_PBESTATE_SWIZ swizzle[4];
+};
+
+/* Fill a target description from a gallium format and a device address.
+ *
+ * This is the entry point a recorded framebuffer would use: it joins the three pieces landed
+ * separately - the source-format selector (round 63), the channel swizzles (round 64) and the address
+ * - so a caller with a pipe_resource and a device does not have to know which of them came from which
+ * function, or in what order. It does NOT read dev_info: `with_packed_usc_channel` is passed in,
+ * because it is a device feature combined with the format's signedness and the caller is the thing
+ * that has both.
+ *
+ * Refuses any format whose layout or swizzle it cannot express - including depth, whose single-channel
+ * rule produces a selector the PBE does not take. */
+bool pvr_pbe_target_from_format(enum pipe_format format, uint64_t addr, uint32_t mrt_index,
+                                bool with_packed_usc_channel, struct pvr_pbe_target *out);
+
+bool pvr_csb_emit_pbe_target(struct pvr_csb *csb, const struct pvr_pbe_target *target);
+
+/* PBE register encodings that are not plain values.
+ *
+ * linestride is MINUS ONE divided by a unit:
+ *   reg.linestride = (stride - 1) / ROGUE_PBESTATE_REG_WORD0_LINESTRIDE_UNIT_SIZE
+ * - the fourth "minus one" field in this driver after width, height and stride, and the unit is the
+ * generated header's constant rather than a number transcribed from the reference.
+ *
+ * memlayout maps directly: this driver's resources are linear (round 1's choice, recorded as a
+ * ceiling), so targets are LINEAR and the twiddled modes are deliberately not offered - a target
+ * described as twiddled while its memory is linear would be read with the wrong addressing, and
+ * that is the kind of wrong that produces a picture rather than an error. */
+uint32_t pvr_pbe_linestride(uint32_t stride_px);
+
+/* The PBE's size fields are the LOG2 of the pixel dimension, not the dimension:
+ *   reg.size_x = util_logbase2_ceil(surface_params->width);
+ * and rounding is UP, so a 100-pixel target is described as 128. That is the sixth member of the
+ * units family in this driver (after pds_data_size in units, PPP counts in words, smpcnt as log2,
+ * lod as fixed-point, and PDS/USC units) - and the second time a field's value turned out to be the
+ * log2 of the quantity its name suggests.
+ *
+ * The largest size the enum names is 16384 pixels; anything larger has no encoding and is refused
+ * rather than mapped to the largest, which would describe a target as smaller than it is. */
+enum ROGUE_PBESTATE_SIZE pvr_pbe_size_from_pixels(uint32_t pixels);
+
+/* The PBE's clip bounds.
+ *
+ * INCLUSIVE pixel coordinates, not aligned units - unlike the TA clip region (round 45), which
+ * divides by 16. Two different clip rectangles on the same hardware with two different encodings,
+ * which is exactly the kind of pair that gets conflated.
+ *
+ * The far edge is the offset plus the extent MINUS ONE, clamped to the surface, and the reference
+ * uses a guarded decrement (PVR_DEC_IF_NOT_ZERO) rather than a plain -1 because offset+extent can
+ * legitimately be 0, where a plain subtraction would wrap to 0xFFFFFFFF.
+ *
+ * The reference also 8-aligns the bounds when framebuffer compression is on. This driver sets
+ * frame_buffer_compression false wherever it describes a target, so that path is deliberately not
+ * implemented here rather than implemented and unused: an alignment that only applies to a feature
+ * this driver never enables is a thing to add if the feature arrives, not before. */
+struct pvr_pbe_clip {
+   uint32_t min_x;
+   uint32_t min_y;
+   uint32_t max_x;
+   uint32_t max_y;
+};
+
+/* The PBE's per-channel swizzle, the same correspondence the texture side uses: the hardware enum
+ * names SOURCE_CHAN0..3 / ZERO / ONE, which are PIPE_SWIZZLE_X/Y/Z/W/0/1.
+ *
+ * This TRANSLATES; it does not decide. Which channel order a given render-target format needs is a
+ * per-format question - the reference answers it with a long conditional chain per source_format -
+ * and this driver has not mapped any target format to a PBESTATE source format yet, so the caller
+ * supplies the swizzle. Translating and deciding are different jobs and only the first is done.
+ *
+ * PIPE_SWIZZLE_NONE is refused for the same reason as on the texture side: it states the format has
+ * no channel there, which is not a selector, and mapping it to a zero would change what is written. */
+bool pvr_pbe_swizzle_from_pipe(uint8_t pipe_swizzle, enum ROGUE_PBESTATE_SWIZ *out);
+
+/* The PBE's per-channel width selector for a target format.
+ *
+ * Mirrors the reference's pvr_arch_pbe_get_src_format_and_gamma, which - like round 32's swizzle
+ * helper - works from a util_format_description, so this needs no Vulkan table.
+ *
+ * `with_packed_usc_channel` is NOT a guess and not a format property: the reference derives it as
+ *
+ *   if (PVR_HAS_FEATURE(dev_info, usc_f16sop_u8))
+ *      with_packed_usc_channel = format is unorm or snorm;
+ *   else
+ *      with_packed_usc_channel = false;
+ *
+ * i.e. a DEVICE FEATURE combined with the format's signedness. It is a parameter here rather than
+ * read from dev_info because the CSB writer takes numbers, not devices (the same arrangement as the
+ * region header and clip alignment). Callers pass the two facts they have; the branch is then
+ * explicit and testable both ways instead of depending on one device's answer.
+ *
+ * The two answers mean different things and both are real: 8-bit channels take F16_PER_CHANNEL when
+ * the parameter is false, which is the counter-intuitive case that made round 62 stop - it is not a
+ * mistake in the reference, it is what the hardware does without usc_f16sop_u8. */
+enum ROGUE_PBESTATE_SOURCE_FORMAT
+pvr_pbe_source_format_from_pipe(enum pipe_format format, bool with_packed_usc_channel);
+
+/* The four PBE channel swizzles for a target format.
+ *
+ * Round 61 listed "the per-format channel order" as an unmade decision. It is NOT one: the reference
+ * fills it from pvr_get_format_swizzle(), which is literally
+ *
+ *    return vk_format_description(vk_format)->swizzle;
+ *
+ * - the same description swizzle round 32's texture-side helper returns. So this joins two pieces
+ * that already exist: pvr_format_layout_from_pipe() for the swizzle, and pvr_pbe_swizzle_from_pipe()
+ * for the translation. No table, no per-format chain, no decision.
+ *
+ * Formats whose swizzle contains PIPE_SWIZZLE_NONE are refused: that is the depth/stencil rule
+ * ("read one channel, no others"), NONE is not a selector the PBE can be given, and this driver has
+ * no depth-target support for it to matter to yet. Refused rather than mapped to a zero, which would
+ * write a channel the format does not have. */
+bool pvr_pbe_swizzles_from_pipe_format(enum pipe_format format,
+                                       enum ROGUE_PBESTATE_SWIZ out[4]);
+
+void pvr_pbe_clip_from_area(uint32_t off_x, uint32_t off_y, uint32_t width, uint32_t height,
+                            uint32_t surface_width, uint32_t surface_height,
+                            struct pvr_pbe_clip *out);
+enum ROGUE_PBESTATE_MEMLAYOUT pvr_pbe_memlayout_linear(void);
+
+/* How many region headers a render target needs.
+ *
+ * Region headers are written by the HARDWARE (TA/PM writes, ISP reads back) - the driver only
+ * reserves space - so this is an allocation size, not stream content. That distinction cost a round
+ * to establish (rounds 18 and 55).
+ *
+ * Everything is a parameter, including the macrotile counts, so this is testable without a device
+ * and the device constants are read once in the screen. For the version-2 format this device uses:
+ *
+ *    num_tiles_x = DIV_ROUND_UP(width,  tile_size_x)
+ *    mtile_x1    = DIV_ROUND_UP(num_tiles_x, 8) * 2
+ *    count       = mtile_x1 * samples_in_x * mtile_y1 * samples_in_y
+ *                  * mtiles_x * mtiles_y / 4
+ *
+ * The /4 is the version-2 rule ("one region header per 2x2 tile group").
+ *
+ * `samples_in` is 1 for a single-sampled target. This driver refuses MSAA at resource creation, so
+ * the multisampled branch is deliberately not implemented: it changes the mtile arithmetic itself,
+ * not just this factor, and an unimplemented branch that cannot run is better than one that can run
+ * wrongly. */
+uint32_t pvr_region_header_count(uint32_t width, uint32_t height, uint32_t tile_size_x,
+                                 uint32_t tile_size_y, uint32_t samples_in_x,
+                                 uint32_t samples_in_y, uint32_t mtiles_x, uint32_t mtiles_y);
+
+/* The fragment job's STATIC stream, built to the layout decoded in round 74 from a captured stream of
+ * a working driver rather than derived:
+ *
+ *   KMD_STREAM_HDR, CR_ISP_SCISSOR_BASE, CR_ISP_DBIAS_BASE, CR_ISP_OCLQRY_BASE, CR_ISP_ZLSCTL,
+ *   CR_ISP_ZLOAD_BASE, CR_ISP_STENCIL_LOAD_BASE  [, CR_FB_CDC_ZLS]
+ *   <PBE register words: ROGUE_NUM_PBESTATE_REG_WORDS per attachment, i.e. REG_WORD0/1/2>
+ *   CR_TPU_BORDER_COLOUR_TABLE_PDM, ROGUE_NUM_CR_PDS_BGRND_WORDS * 2 dwords
+ *   CR_EVENT_PIXEL_PDS_DATA
+ *
+ * The driver before this had nothing to compare a stream against; the capture changed that, and the offsets
+ * come from the same helper arithmetic the working driver uses (each packet's own generated length).
+ *
+ * The header's first word is the stream's length in bytes - that is what the capture shows (`00000180` for a
+ * 384-byte stream), and the same convention the driver's own static context state uses.
+ *
+ * Only the packets this driver has content for are filled; the rest are emitted as the zeroed packets the
+ * capture shows for the same case, which is what "no scissor, no depth bias, no occlusion query" looks like.
+ *
+ * Returns the stream length in bytes, or 0 if it does not fit. */
+uint32_t pvr_geom_static_stream(void *stream, uint32_t stream_size,
+                                uint64_t ctrl_stream_addr, uint64_t border_colour_addr,
+                                bool geometry_terminate, uint32_t region_stride,
+                                bool forcenewstate, uint32_t usc_common_size,
+                                uint32_t view_idx, bool brn49927);
+
+uint32_t pvr_frag_static_stream(void *stream, uint32_t stream_size,
+                                const uint64_t *pbe_words, unsigned nr_attachments,
+                                uint32_t eot_pds_offset, bool cluster_grouping);
+
+/* Fill the parts of a built fragment stream that the reference always sets but this driver had left
+ * zero: the TPU border-colour table address and the PDS background programs (the pixel shader the
+ * 3D stage runs for tiles with no fragments, and its partial-render variant). A zero there is not
+ * "unused" - it is PDS heap base + 0, whatever program lives at the bottom of the PDS heap, which
+ * the hardware then tries to execute. */
+void pvr_frag_static_stream_fill_bgnd(void *stream, uint32_t stream_size,
+                                      uint64_t tpu_border_table_addr,
+                                      const uint64_t bgnd[3], const uint64_t pr_bgnd[3]);
+
+/* Fill the fragment stream's ISP/background scalar fields, which the reference always sets and this
+ * driver left zero: USC pixel output control, background depth/value, AA and ISPCtl, plus the
+ * pixel-event PDS info word. The firmware derives its tiles-in-flight/partition setup from these;
+ * all-zero there makes the 3D kick compute a zero partition mask and page-fault (firmware trace:
+ * reference "Updating Tiles In Flight (Dusts=1, PartitionMask=0x5, ISPCtl=0x80035000)", ours
+ * "PartitionMask=0x0, ISPCtl=0x0"). `isp_ctl` also needs the pixel-output width of the fragment
+ * shader, so callers pass it rather than relying on a constant. */
+void pvr_frag_static_stream_set_isp(void *stream, uint32_t stream_size,
+                                    uint32_t usc_pixel_output_ctrl, uint32_t isp_ctl,
+                                    uint32_t event_pixel_pds_info);
+
+/* Pack the three CR_PDS_BGRND words for a background program. */
+void pvr_csb_pds_bgnd_words(uint32_t shader_off, uint32_t texunicode_off,
+                            uint32_t texturedata_off, uint32_t temps_dwords,
+                            uint32_t shared_dwords, uint32_t texturestate_dwords,
+                            uint64_t words[3]);
+
+/* Dwords a stream link occupies - what the guard must be at minimum. */
+#define PVR_CSB_LINK_DWORDS (ROGUE_VDMCTRL_STREAM_LINK0_length + \
+                             ROGUE_VDMCTRL_STREAM_LINK1_length)
+void pvr_csb_reset(struct pvr_csb *csb);
+
+/* Reserves `words` 32-bit words and returns where to write them, or NULL if they do not
+ * fit - in which case nothing is reserved and the CSB is marked overflowed. */
+uint32_t *pvr_csb_emit(struct pvr_csb *csb, uint32_t words);
+bool pvr_csb_emit_stream_terminate(struct pvr_csb *csb);
+/* An INDEX_LIST block tells the TA where the vertex indices are, how many there are, and - the
+ * part that is easy to leave at zero - WHICH PRIMITIVE TOPOLOGY to assemble. The topology field is
+ * not optional: a zero there is POINT_LIST, and the TA then treats triangle vertex triples as
+ * points, so the draw bins the wrong primitives and nothing reaches rasterisation.
+ *
+ * A zero index_addr means a non-indexed draw (vkCmdDraw): the index address packet is omitted and
+ * vertices are read sequentially, which is what the captured working draw does. The instance
+ * count packet is omitted for the default of one, also as the capture does. */
+bool pvr_csb_emit_index_list(struct pvr_csb *csb, uint64_t index_addr, uint32_t index_count,
+                             uint32_t instance_count,
+                             enum ROGUE_VDMCTRL_INDEX_SIZE index_size,
+                             enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY topology);
+
+uint32_t pvr_csb_size(const struct pvr_csb *csb);
+bool pvr_csb_overflowed(const struct pvr_csb *csb);
+
+/* Emit the two dwords that link this stream to another buffer.
+ *
+ * This is how a control stream is longer than one buffer: the GPU follows the link and
+ * continues there, rather than the driver needing one contiguous allocation. It is also
+ * the first real content this driver puts in a stream, so it is the natural place for
+ * the emission pattern to be exercised against the generated pack/unpack.
+ *
+ * Both dwords are reserved together: a stream containing half a link would send the GPU
+ * to an address assembled from one new dword and one stale one. The address is passed
+ * whole to both packets - the generated pack extracts the low half for LINK1 and bits
+ * 32..39 for LINK0, which is what the reference does too. */
+bool pvr_csb_emit_link(struct pvr_csb *csb, uint64_t dev_addr, bool with_return);
+
+/* Emit one packet and pack its fields in a single step. A packet that does not fit is
+ * skipped rather than partly written, so the stream never contains half a packet. */
+#define pvr_csb_emit_pack(csb, packet, values)                                 \
+   do {                                                                        \
+      uint32_t *dw_ = pvr_csb_emit((csb), packet##_length);                    \
+      if (dw_ != NULL)                                                         \
+         packet##_pack(dw_, (values));                                         \
+   } while (0)
+
+#endif /* PVR_CSB_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.c b/src/gallium/drivers/pvr_native/pvr_draw.c
new file mode 100644
index 00000000..deb4984d
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_draw.c
@@ -0,0 +1,2173 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The TA/3D draw path, ported from the probe's verified render (pvr_probe.c) and the Vulkan
+ * driver's render setup. See pvr_draw.h.
+ */
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xf86drm.h>
+
+#include "pvr_draw.h"
+#include "pvr_bo.h"
+#include "pvr_context.h"
+#include "pvr_csb.h"
+#include "pvr_hwrt.h"
+#include "pvr_resource.h"
+#include "pvr_screen.h"
+#include "pvr_shader.h"
+#include "pvr_static.h"
+#include "pvr_vm.h"
+
+#include "nir_builder.h"
+#include "pco/pco_data.h"
+#include "pds/pvr_pds.h"
+#include "pipe/p_state.h"
+#include "util/format/u_format.h"
+#include "util/format/format_utils.h"
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/u_math.h"
+#include "util/u_inlines.h"
+#include "util/u_prim.h"
+
+#define ARENA_GENERAL_SIZE (1u << 20)
+#define ARENA_PDS_SIZE (256u << 10)
+#define CTRL_SIZE (64u << 10)
+
+struct pvr_draw_arena {
+   struct pvr_bo bo;
+   uint64_t addr;
+   uint32_t used;
+};
+
+/* A generated PDS program kept for reuse: its code is uploaded once into the persistent code
+ * arena, and each draw patches a fresh data segment from the saved const map. Keyed by the bytes
+ * the generator's output depends on. */
+#define PVR_DRAW_PDS_CACHE 32
+#define PVR_DRAW_PDS_KEY 200
+struct pvr_draw_pds_prog {
+   uint32_t key_size;
+   uint8_t key[PVR_DRAW_PDS_KEY];
+   uint32_t code_off;
+   uint32_t data_dwords;
+   uint32_t temps;
+   uint32_t entries_size;
+   void *entries;
+};
+
+struct pvr_draw_bg {
+   /* One 32-bit pixel-output dword per entry: a 16F colour format occupies two of them. */
+   uint32_t words[PVR_MAX_COLOR_ATTACHMENTS * 2];
+   unsigned nwords;
+   uint64_t pds_offset;
+};
+
+/* The background object that reloads a target's previous contents, per target format; or, for a
+ * mip generation render (gen), that averages 2x2 texels of the level above. */
+struct pvr_draw_load {
+   enum pipe_format format;
+   bool gen;
+   struct pvr_shader *fs;
+};
+
+/* An end-of-tile program, per set of colour targets (one entry per attachment). */
+struct pvr_draw_eot {
+   uint64_t addr[PVR_MAX_COLOR_ATTACHMENTS];
+   enum pipe_format format[PVR_MAX_COLOR_ATTACHMENTS];
+   unsigned nr;
+   uint64_t pds_offset;
+   bool zonly;
+};
+
+/* Mip generation renders every level size of a chain (refract: about a dozen per frame), and a
+ * data set created on an eviction costs a wait and a firmware round trip. */
+#define PVR_DRAW_HWRT_CACHE 16
+#define PVR_DRAW_SLOTS 4
+
+struct pvr_draw_state {
+   bool ready, failed;
+   /* Cube faces: the render target and the load source may be one face of a cube map (a transfer
+    * blit), addressed at face * layer_size past the level. */
+   unsigned rt_layer;
+   unsigned load_src_layer;
+   /* The heap carveouts with the firmware's static programs (VDM sync, pixel event, fence): the
+    * TA reads them at every kick. */
+   struct pvr_static_memory sm;
+   struct pvr_gpu_context gctx;
+   struct pvr_bo fl_bo[2];
+   uint64_t fl_addr[2];
+   uint32_t fl_handle[2];
+
+   /* HWRT data sets by target size, least recently used evicted and freed: a scene that renders
+    * to targets of several sizes used to leak one per size change until the firmware had no room
+    * for another. Each has its own local free list, as the reference's rt datasets do, and
+    * buffers tpc, vheap, mlist0, mlist1, rgn0, rgn1, local free list. */
+   struct pvr_draw_hwrt {
+      uint32_t dset, w, h, last_use;
+      /* Which of the two render-target datas the next render uses: the reference moves to the
+       * other one after every fragment submit. */
+      uint32_t rt_data_idx;
+      /* The render that last used each RT data (0: none): a data set takes at most two renders in
+       * flight, one per RT data, however many slots there are. */
+      uint32_t data_seq[2];
+      uint32_t fl_handle;
+      struct pvr_bo bo[7];
+      uint64_t addr[7];
+   } hwrt[PVR_DRAW_HWRT_CACHE], *cur_hwrt;
+   uint32_t hwrt_clock;
+
+   struct pvr_draw_arena gen; /* general heap: TA blocks, scissor, indices */
+   struct pvr_draw_arena pds; /* PDS heap: per-draw vertex programs */
+   struct pvr_bo ctrl_bo;
+   uint64_t ctrl_addr;
+   /* Renders are submitted without waiting. Each of PVR_DRAW_SLOTS slots holds the transient
+    * memory above for one render, the syncobj that render signals and references to the
+    * resources it uses; a slot is waited for only when it is reused (gen/pds/ctrl_bo above are
+    * the open render's slot). Same-context renders complete in submission order. */
+   struct pvr_draw_slot {
+      struct pvr_draw_arena gen, pds;
+      struct pvr_bo ctrl_bo;
+      uint64_t ctrl_addr;
+      uint32_t sync, seq;
+      struct pipe_resource **refs;
+      unsigned nrefs, cap;
+   } slots[PVR_DRAW_SLOTS];
+   unsigned cur_slot;
+   struct pvr_csb ctrl;
+   struct pvr_bo bct_bo;
+   uint64_t bct_addr;
+
+   struct pvr_draw_arena pdscode;
+   struct pvr_draw_pds_prog progs[PVR_DRAW_PDS_CACHE];
+   unsigned nprogs;
+   /* The open render, and its sequence number (resources it uses carry it). */
+   bool open;
+   uint32_t seq;
+   unsigned ndraws;
+   struct pipe_resource *rt;
+   unsigned rt_level;
+   uint32_t rt_w, rt_h;
+
+   bool clear_valid;
+   uint32_t clear_color;
+   union pipe_color_union clear_value;
+   /* The render's depth buffer (NULL: none) and its recorded clear. */
+   struct pipe_resource *zs;
+   bool zclear_valid;
+   float zclear;
+
+   /* Caches. */
+   /* End-of-tile programs, per target set (addresses and formats). Each entry is a compiled USC
+    * program: a miss costs pco compilation plus a USC and a PDS upload, which was 200 us per render
+    * on the terrain scene. A mip-chain-heavy scene renders dozens of distinct level sizes per frame
+    * (terrain: ~27 target sets, 83% miss rate with 32 entries); 512 entries hold every set of such a
+    * scene for ~50 KB and turns the steady state into cache hits. Entries are never freed: the
+    * programs stay allocated on the PDS heap either way. */
+   struct pvr_draw_eot eot[512];
+   unsigned nr_eot;
+   struct pvr_draw_bg bg[4];
+   struct pvr_draw_load load[8];
+   unsigned nr_load;
+   /* Custom border colours: a cache of (colour -> border colour table entry). The table has 64
+    * entries; 0..4 are the hardware's built-in colours, so custom entries live from 5 up and are
+    * written once (never rewritten, so queued renders cannot observe a table change). */
+#define PVR_DRAW_BCT_TABLE_ENTRIES 21 /* 5 built-in + 16 custom */
+   struct {
+      union pipe_color_union color;
+   } bct[PVR_DRAW_BCT_TABLE_ENTRIES - 5];
+   unsigned nr_bct;
+   bool bct_full_logged;
+   /* The colour target of a depth-only framebuffer, and the texture an unbound unit reads. */
+   struct pipe_resource *scratch_rt;
+   /* A blit render: the background loads this resource (level load_src_level) instead of the
+    * target; load_gen: a mip generation render, each pixel the 2x2 average of the source. */
+   struct pipe_resource *load_src;
+   unsigned load_src_level;
+   /* Submit a clear-only render instead of deferring it (draw_materialize). */
+   bool no_defer;
+   bool load_gen;
+   struct pipe_resource *black;
+   unsigned nr_bg;
+};
+
+static struct pvr_screen *
+draw_screen(struct pvr_context *ctx)
+{
+   return pvr_screen(ctx->base.screen);
+}
+
+/* A buffer mapped into the general heap through the VA allocator. */
+static bool
+draw_general_bo(struct pvr_screen *scr, uint64_t size, uint64_t flags, struct pvr_bo *bo,
+                uint64_t *addr, bool cpu)
+{
+   size = ALIGN_POT(MAX2(size, 4096), 4096);
+   if (!pvr_bo_create_flags(scr->fd, size, 1, flags, bo))
+      return false;
+   *addr = pvr_vm_alloc(&scr->vm, bo->size, scr->vm.general.page_size);
+   if (*addr == 0 || !pvr_vm_map(&scr->vm, *addr, bo->handle, bo->size))
+      return false;
+   return !cpu || pvr_bo_map(scr->fd, bo);
+}
+
+static void *
+arena_alloc(struct pvr_draw_arena *a, uint32_t size, uint32_t align, uint64_t *addr)
+{
+   uint32_t at = ALIGN_POT(a->used, align);
+   if (at + size > a->bo.size)
+      return NULL;
+   a->used = at + size;
+   *addr = a->addr + at;
+   return (uint8_t *)a->bo.map + at;
+}
+
+/* Waits for a slot's render and drops what it held. */
+static void
+draw_slot_idle(struct pvr_screen *scr, struct pvr_draw_slot *s)
+{
+   if (s->sync != 0) {
+      if (drmSyncobjWait(scr->fd, &s->sync, 1, INT64_MAX, 0, NULL) != 0)
+         mesa_loge("pvr: draw: waiting for a render failed");
+      drmSyncobjDestroy(scr->fd, s->sync);
+      s->sync = 0;
+   }
+   for (unsigned i = 0; i < s->nrefs; i++)
+      pipe_resource_reference(&s->refs[i], NULL);
+   s->nrefs = 0;
+}
+
+static void
+draw_idle(struct pvr_context *ctx, struct pvr_draw_state *d)
+{
+   for (unsigned i = 0; i < PVR_DRAW_SLOTS; i++)
+      draw_slot_idle(draw_screen(ctx), &d->slots[i]);
+}
+
+/* The open render uses this resource: it keeps it alive and a CPU access waits for it. */
+static void
+draw_use(struct pvr_draw_state *d, struct pipe_resource *pres)
+{
+   struct pvr_resource *res = pvr_resource(pres);
+   struct pvr_draw_slot *s = &d->slots[d->cur_slot];
+   if (res->render_seq == d->seq)
+      return;
+   res->render_seq = d->seq;
+   if (s->nrefs == s->cap) {
+      const unsigned cap = MAX2(16, s->cap * 2);
+      struct pipe_resource **refs = realloc(s->refs, cap * sizeof(*refs));
+      if (refs == NULL)
+         return;
+      s->refs = refs;
+      s->cap = cap;
+   }
+   s->refs[s->nrefs] = NULL;
+   pipe_resource_reference(&s->refs[s->nrefs++], pres);
+}
+
+static bool
+draw_init(struct pvr_context *ctx, struct pvr_draw_state *d)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   const uint32_t local_pages =
+      (uint32_t)(ALIGN_POT(scr->dev_runtime_info.min_free_list_size, 65536) / 4096);
+
+   if (d->ready || d->failed)
+      return d->ready;
+   d->failed = true;
+   if (!scr->vm_valid || !pvr_static_memory_init(&scr->vm, &scr->dev_info, &d->sm) ||
+       !pvr_gpu_context_create(&scr->vm, &scr->dev_info, &d->gctx))
+      return false;
+   /* Free lists: PM-owned, no CPU access (same sizes the probe and Vulkan use). */
+   if (!draw_general_bo(scr, (uint64_t)local_pages * 4, DRM_PVR_BO_PM_FW_PROTECT, &d->fl_bo[0],
+                        &d->fl_addr[0], false) ||
+       !draw_general_bo(scr, 65536 * 4, DRM_PVR_BO_PM_FW_PROTECT, &d->fl_bo[1], &d->fl_addr[1],
+                        false) ||
+       !pvr_free_list_create(&scr->vm, d->fl_addr[0], local_pages, local_pages, 0, 0,
+                             &d->fl_handle[0]) ||
+       !pvr_free_list_create(&scr->vm, d->fl_addr[1], 512, 65536, 256, 13, &d->fl_handle[1]))
+      return false;
+   if (!draw_general_bo(scr, ARENA_GENERAL_SIZE, DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS,
+                        &d->gen.bo, &d->gen.addr, true) ||
+       !draw_general_bo(scr, CTRL_SIZE, DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS, &d->ctrl_bo,
+                        &d->ctrl_addr, true) ||
+       !draw_general_bo(scr, (uint64_t)PVR_DRAW_BCT_TABLE_ENTRIES * 4096,
+                        DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS, &d->bct_bo, &d->bct_addr, true))
+      return false;
+   d->pds.addr = pvr_vm_heap_alloc(&scr->vm, DRM_PVR_HEAP_PDS_CODE_DATA, ARENA_PDS_SIZE, 4096,
+                                   &d->pds.bo);
+   if (d->pds.addr == 0 || !pvr_bo_map(scr->fd, &d->pds.bo))
+      return false;
+   d->pdscode.addr = pvr_vm_heap_alloc(&scr->vm, DRM_PVR_HEAP_PDS_CODE_DATA, ARENA_PDS_SIZE, 4096,
+                                       &d->pdscode.bo);
+   if (d->pdscode.addr == 0 || !pvr_bo_map(scr->fd, &d->pdscode.bo))
+      return false;
+   d->slots[0] = (struct pvr_draw_slot){ .gen = d->gen, .pds = d->pds, .ctrl_bo = d->ctrl_bo,
+                                          .ctrl_addr = d->ctrl_addr };
+   for (unsigned i = 1; i < PVR_DRAW_SLOTS; i++) {
+      struct pvr_draw_slot *sl = &d->slots[i];
+      if (!draw_general_bo(scr, ARENA_GENERAL_SIZE, DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS,
+                           &sl->gen.bo, &sl->gen.addr, true) ||
+          !draw_general_bo(scr, CTRL_SIZE, DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS, &sl->ctrl_bo,
+                           &sl->ctrl_addr, true))
+         return false;
+      sl->pds.addr = pvr_vm_heap_alloc(&scr->vm, DRM_PVR_HEAP_PDS_CODE_DATA, ARENA_PDS_SIZE, 4096,
+                                       &sl->pds.bo);
+      if (sl->pds.addr == 0 || !pvr_bo_map(scr->fd, &sl->pds.bo))
+         return false;
+   }
+   d->cur_slot = 0;
+   d->failed = false;
+   d->ready = true;
+   return true;
+}
+
+static void
+draw_general_bo_free(struct pvr_screen *scr, struct pvr_bo *bo, uint64_t *addr)
+{
+   pvr_bo_unmap(bo);
+   if (*addr != 0) {
+      pvr_vm_unmap(&scr->vm, *addr, bo->size);
+      pvr_vm_free(&scr->vm, *addr, bo->size);
+      *addr = 0;
+   }
+   if (bo->handle != 0)
+      pvr_bo_destroy(scr->fd, bo);
+   memset(bo, 0, sizeof(*bo));
+}
+
+static void
+draw_hwrt_free(struct pvr_screen *scr, struct pvr_draw_hwrt *e)
+{
+   /* The data set first (it references the free list), then the free list, then the buffers. */
+   pvr_hwrt_dataset_destroy(&scr->vm, e->dset);
+   pvr_free_list_destroy(&scr->vm, e->fl_handle);
+   for (unsigned i = 0; i < ARRAY_SIZE(e->bo); i++)
+      draw_general_bo_free(scr, &e->bo[i], &e->addr[i]);
+   memset(e, 0, sizeof(*e));
+}
+
+/* The HWRT data set for a target size, sized from pvr_hwrt_sizes(). Renders are waited for before
+ * the next one is built, so an evicted data set is idle. */
+static bool
+draw_hwrt(struct pvr_context *ctx, struct pvr_draw_state *d, uint32_t w, uint32_t h)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   struct pvr_draw_hwrt *e = NULL;
+   struct pvr_hwrt_sizes sz;
+   uint64_t sizes[7];
+   static const uint64_t flags[7] = { 0, 0, DRM_PVR_BO_PM_FW_PROTECT, DRM_PVR_BO_PM_FW_PROTECT,
+                                      0, 0, DRM_PVR_BO_PM_FW_PROTECT };
+   const uint32_t local_pages =
+      (uint32_t)(ALIGN_POT(scr->dev_runtime_info.min_free_list_size, 65536) / 4096);
+
+   for (unsigned i = 0; i < PVR_DRAW_HWRT_CACHE; i++) {
+      if (d->hwrt[i].dset != 0 && d->hwrt[i].w == w && d->hwrt[i].h == h)
+         e = &d->hwrt[i];
+   }
+   if (e == NULL) {
+      e = &d->hwrt[0];
+      for (unsigned i = 1; i < PVR_DRAW_HWRT_CACHE; i++) {
+         if (d->hwrt[i].dset == 0 || (e->dset != 0 && d->hwrt[i].last_use < e->last_use))
+            e = &d->hwrt[i];
+      }
+      if (e->dset != 0) {
+         draw_idle(ctx, d);
+         draw_hwrt_free(scr, e);
+      }
+      if (!pvr_hwrt_sizes(&scr->dev_info, w, h, 1, 1, &sz))
+         return false;
+      sizes[0] = sz.tpc_size;
+      sizes[1] = 4096; /* VHEAP table, single layer: no RTC */
+      sizes[2] = sizes[3] = 4096; /* MLIST: ~1 KiB for a 256 MiB global free list */
+      sizes[4] = sizes[5] = sz.region_headers_bytes;
+      sizes[6] = (uint64_t)local_pages * 4;
+      for (unsigned i = 0; i < ARRAY_SIZE(sizes); i++) {
+         if (!draw_general_bo(scr, sizes[i], flags[i], &e->bo[i], &e->addr[i], false)) {
+            draw_hwrt_free(scr, e);
+            return false;
+         }
+      }
+      if (!pvr_free_list_create(&scr->vm, e->addr[6], local_pages, local_pages, 0, 0,
+                                &e->fl_handle)) {
+         draw_hwrt_free(scr, e);
+         return false;
+      }
+      struct pvr_hwrt_dataset_desc desc = {
+         .tpc_dev_addr = e->addr[0],
+         .tpc_size = (uint32_t)sz.tpc_size,
+         .tpc_stride = sz.tpc_stride,
+         .vheap_table_dev_addr = e->addr[1],
+         .pm_mlist_dev_addr = { e->addr[2], e->addr[3] },
+         .region_header_dev_addr = { e->addr[4], e->addr[5] },
+         .free_list_handles = { e->fl_handle, d->fl_handle[1] },
+         .width = w,
+         .height = h,
+         .samples = 1,
+         .layers = 1,
+         .region_header_size = (uint32_t)sz.region_header_size,
+      };
+      if (!pvr_hwrt_dataset_create(&scr->vm, &desc, &e->dset)) {
+         draw_hwrt_free(scr, e);
+         return false;
+      }
+      e->w = w;
+      e->h = h;
+   }
+   e->last_use = ++d->hwrt_clock;
+   d->cur_hwrt = e;
+   return true;
+}
+
+/* Bump-allocated program bytes in a per-heap chunk; returns the heap-relative offset or 0. */
+static uint64_t
+draw_prog_upload(struct pvr_screen *scr, struct pvr_prog_arena *a, uint16_t heap_id,
+                 const void *bytes, unsigned size)
+{
+   size = ALIGN_POT(size, 16);
+   if (scr->vm.heaps[heap_id].size == 0 || size == 0)
+      return 0;
+   if (a->bo.map == NULL || (uint64_t)a->used + size > a->size) {
+      const uint32_t want = MAX2(ALIGN_POT(size, 4096),
+                                 a->size ? MIN2(a->size * 2, 8u << 20) : (256u << 10));
+      struct pvr_bo bo = { 0 };
+      uint64_t addr = pvr_vm_heap_alloc(&scr->vm, heap_id, want, 4096, &bo);
+      if (addr == 0) {
+         /* The heap is smaller than the chunk: fall back to the exact-size allocation. */
+         addr = pvr_vm_heap_alloc(&scr->vm, heap_id, size, 16, &bo);
+         if (addr == 0 || !pvr_bo_map(scr->fd, &bo))
+            return 0;
+         memcpy(bo.map, bytes, size);
+         return addr - scr->vm.heaps[heap_id].base;
+      }
+      if (!pvr_bo_map(scr->fd, &bo))
+         return 0;
+      /* ponytail: the previous chunk's handle is dropped, not freed, so the offsets already
+       * handed out stay valid (the kernel keeps the mapping until the process exits); chunks
+       * double, so a session drops only a handful. */
+      a->bo = bo;
+      a->addr = addr;
+      a->base = scr->vm.heaps[heap_id].base;
+      a->size = want;
+      a->used = 0;
+   }
+   const uint64_t at = a->addr + a->used;
+   memcpy((uint8_t *)a->bo.map + a->used, bytes, size);
+   a->used += size;
+   return at - a->base;
+}
+
+/* USC code into the USC heap; returns the heap-relative offset or 0. */
+static uint32_t
+draw_upload_usc(struct pvr_screen *scr, const void *code, unsigned size)
+{
+   return (uint32_t)draw_prog_upload(scr, &scr->usc_arena, DRM_PVR_HEAP_USC_CODE, code, size);
+}
+
+/* Persistent PDS bytes into the PDS heap; returns the heap-relative offset or 0. */
+static uint64_t
+draw_upload_pds(struct pvr_screen *scr, const void *bytes, unsigned size)
+{
+   return draw_prog_upload(scr, &scr->pds_arena, DRM_PVR_HEAP_PDS_CODE_DATA, bytes, size);
+}
+
+/* A fragment program: USC code plus its PDS kick program (data + code contiguous). */
+static bool
+draw_upload_fs(struct pvr_screen *scr, struct pvr_shader *fs)
+{
+   struct pvr_shader_pds_launcher_info info;
+   uint8_t prog[1024] = { 0 };
+   uint32_t len;
+
+   if (fs->pds_offset != 0)
+      return true;
+   fs->usc_offset = draw_upload_usc(scr, fs->binary, fs->binary_size);
+   if (fs->usc_offset == 0)
+      return false;
+   len = pvr_shader_pds_launcher(fs, fs->usc_offset, prog, sizeof(prog), &info);
+   if (len == 0)
+      return false;
+   fs->pds_offset = (uint32_t)draw_upload_pds(scr, prog, len);
+   fs->pds_data_dwords = info.data_dwords;
+   return fs->pds_offset != 0;
+}
+
+/* The coefficient (varying) program of a fragment variant against a vertex shader, as the Vulkan
+ * driver's pvr_graphics_pipeline_setup_fragment_coeff_program: one DOUTI iterator for z, w and each
+ * varying slot, reading the vertex's vtxout offset (in 16-bit units, position x/y dropped and z/w
+ * dropped when the fragment shader does not read them) into the slot's coefficient registers.
+ * Returns false when the shader reads no varyings and needs no program. */
+static bool
+draw_coeff_program(struct pvr_screen *scr, struct pvr_shader *fs, const struct pvr_shader *vs,
+                   bool flat_first)
+{
+   struct pvr_pds_coeff_loading_program prog = { .z_iterator = ~0u };
+   unsigned fpu = 0, dest = 0;
+
+   if (fs->coeff_vs == vs)
+      return fs->coeff_offset != 0;
+   fs->coeff_vs = vs;
+   fs->coeff_offset = 0;
+   if (!fs->uses_z && !fs->uses_w && !fs->varyings_read)
+      return false;
+
+   if (fs->uses_z) {
+      struct ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC src = {
+         .f32_offset = fs->uses_w ? 1 * sizeof(uint16_t) : 0,
+         .shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD,
+         .size = ROGUE_PDSINST_DOUTI_SIZE_1D,
+      };
+      src.f16_offset = src.f32_offset;
+      ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC_pack(&prog.FPU_iterators[fpu], &src);
+      prog.z_iterator = fpu;
+      prog.destination[fpu++] = dest++;
+   }
+   if (fs->uses_w) {
+      const struct ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC src = {
+         .shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD,
+         .size = ROGUE_PDSINST_DOUTI_SIZE_1D,
+      };
+      ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC_pack(&prog.FPU_iterators[fpu], &src);
+      prog.destination[fpu++] = dest++;
+   }
+   uint64_t read = fs->varyings_read;
+   while (read) {
+      const unsigned slot = u_bit_scan64(&read);
+      const unsigned count = fs->varyings[slot].count / ROGUE_USC_COEFFICIENT_SET_SIZE;
+      /* The stages are compiled apart, so the fragment shader may read fewer components of a
+       * slot than the vertex shader writes; it iterates only those. */
+      if (count == 0 || vs->varyings[slot].count < count || vs->varyings[slot].start < 4 ||
+          fpu >= PVR_MAXIMUM_ITERATIONS - 1)
+         return false;
+      unsigned vtxout = vs->varyings[slot].start - 2;
+      if (!fs->uses_z)
+         vtxout--;
+      if (!fs->uses_w)
+         vtxout--;
+      struct ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC src = {
+         .f32_offset = vtxout * sizeof(uint16_t),
+         .size = ROGUE_PDSINST_DOUTI_SIZE_1D + count - 1,
+      };
+      src.f16_offset = src.f32_offset;
+      switch (fs->varyings[slot].interp) {
+      case INTERP_MODE_FLAT:
+         /* GL's default provoking vertex is the last one. */
+         src.shademodel = flat_first ? ROGUE_PDSINST_DOUTI_SHADEMODEL_FLAT_VERTEX0
+                                     : ROGUE_PDSINST_DOUTI_SHADEMODEL_FLAT_VERTEX2;
+         break;
+      case INTERP_MODE_NOPERSPECTIVE:
+         src.shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD;
+         break;
+      default:
+         src.perspective = true;
+         src.shademodel = ROGUE_PDSINST_DOUTI_SHADEMODEL_GOURUAD;
+         break;
+      }
+      ROGUE_PDSINST_DOUT_FIELDS_DOUTI_SRC_pack(&prog.FPU_iterators[fpu], &src);
+      prog.destination[fpu++] = fs->varyings[slot].start / ROGUE_USC_COEFFICIENT_SET_SIZE;
+   }
+   prog.num_fpu_iterators = fpu;
+
+   /* Data then code in one upload: the hardware runs the code that follows the data segment. */
+   uint32_t buf[2 * PVR_MAXIMUM_ITERATIONS + 4 + PVR_MAXIMUM_ITERATIONS] = { 0 };
+   pvr_pds_coefficient_loading(&prog, NULL, PDS_GENERATE_SIZES);
+   if (prog.data_size + prog.code_size > ARRAY_SIZE(buf))
+      return false;
+   pvr_pds_coefficient_loading(&prog, buf, PDS_GENERATE_CODEDATA_SEGMENTS);
+   fs->coeff_offset =
+      (uint32_t)draw_upload_pds(scr, buf, (prog.data_size + prog.code_size) * 4);
+   fs->coeff_data_dwords = prog.data_size;
+   fs->coeff_temps = prog.temps_used;
+   return fs->coeff_offset != 0;
+}
+
+/* Values a PDS data segment is patched with. */
+struct pvr_draw_pds_vals {
+   const uint64_t *vb_addr;
+   const uint32_t *vb_stride;
+   uint32_t usc_offset;
+   uint64_t buffer_addr; /* PVR_BUFFER_TYPE_PUSH_CONSTS */
+};
+
+/* Fill a data segment from a generator's const map. Offsets are in dwords. */
+static bool
+draw_pds_patch(const void *entries, uint32_t size, uint32_t *data,
+               const struct pvr_draw_pds_vals *v)
+{
+   const uint8_t *entry = entries;
+   const uint8_t *end = entry + size;
+   while (entry + sizeof(struct pvr_const_map_entry) <= end) {
+      const struct pvr_const_map_entry *hdr = (const void *)entry;
+      switch (hdr->type) {
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_DOUTU_ADDRESS: {
+         const struct pvr_const_map_entry_doutu_address *e = (const void *)entry;
+         uint64_t x = 0;
+         pvr_set_usc_execution_address64(&x, v->usc_offset);
+         x |= e->doutu_control;
+         memcpy(&data[e->const_offset], &x, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_VERTEX_ATTRIBUTE_ADDRESS: {
+         const struct pvr_const_map_entry_vertex_attribute_address *e = (const void *)entry;
+         const uint64_t x = v->vb_addr[e->binding_index] + e->offset;
+         memcpy(&data[e->const_offset], &x, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_VERTEX_ATTRIBUTE_STRIDE: {
+         const struct pvr_const_map_entry_vertex_attribute_stride *e = (const void *)entry;
+         data[e->const_offset] = v->vb_stride[e->binding_index];
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_SPECIAL_BUFFER: {
+         const struct pvr_const_map_entry_special_buffer *e = (const void *)entry;
+         if (e->buffer_type != PVR_BUFFER_TYPE_PUSH_CONSTS)
+            return false;
+         memcpy(&data[e->const_offset], &v->buffer_addr, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL32: {
+         const struct pvr_const_map_entry_literal32 *e = (const void *)entry;
+         data[e->const_offset] = e->literal_value;
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL64: {
+         const struct pvr_const_map_entry_literal64 *e = (const void *)entry;
+         memcpy(&data[e->const_offset], &e->literal_value, 8);
+         entry += sizeof(*e);
+         break;
+      }
+      default:
+         mesa_loge("pvr: draw: no patch rule for PDS const-map entry type %u", hdr->type);
+         return false;
+      }
+   }
+   return true;
+}
+
+/* Generator callback: fills info (sizes, const map) and, with code != NULL, the code. */
+typedef void (*pvr_draw_pds_gen)(const void *input, uint32_t *code, struct pvr_pds_info *info,
+                                 const struct pvr_device_info *dev_info);
+
+/* A PDS program for this key: from the cache, or generated (and cached when the code arena has
+ * room), then its data segment patched into the transient PDS arena. Offsets out are PDS-heap
+ * offsets. */
+static bool
+draw_pds_program(struct pvr_context *ctx, struct pvr_draw_state *d, const void *key,
+                 uint32_t key_size, pvr_draw_pds_gen gen, const void *input,
+                 const struct pvr_draw_pds_vals *vals, uint32_t *code_off, uint32_t *data_off,
+                 uint32_t *data_dwords, uint32_t *temps)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   const uint64_t pds_base = scr->vm.heaps[DRM_PVR_HEAP_PDS_CODE_DATA].base;
+   struct pvr_draw_pds_prog *p = NULL, tmp = { 0 };
+   uint64_t addr = 0;
+
+   for (unsigned i = 0; i < d->nprogs; i++) {
+      if (d->progs[i].key_size == key_size && !memcmp(d->progs[i].key, key, key_size)) {
+         p = &d->progs[i];
+         break;
+      }
+   }
+   if (p == NULL) {
+      struct pvr_pds_info info = { .entries_size_in_bytes = 2048 };
+      info.entries = calloc(1, info.entries_size_in_bytes);
+      if (info.entries == NULL)
+         return false;
+      gen(input, NULL, &info, &scr->dev_info);
+      const bool cacheable = key_size <= PVR_DRAW_PDS_KEY && d->nprogs < PVR_DRAW_PDS_CACHE &&
+                             d->pdscode.used + info.code_size_in_dwords * 4 + 64 <= ARENA_PDS_SIZE;
+      uint32_t *code = arena_alloc(cacheable ? &d->pdscode : &d->pds,
+                                   MAX2(info.code_size_in_dwords, 1) * 4, 64, &addr);
+      if (code == NULL) {
+         free(info.entries);
+         return false;
+      }
+      gen(input, code, &info, &scr->dev_info);
+      p = cacheable ? &d->progs[d->nprogs++] : &tmp;
+      p->key_size = MIN2(key_size, PVR_DRAW_PDS_KEY);
+      memcpy(p->key, key, p->key_size);
+      p->code_off = addr - pds_base;
+      p->data_dwords = info.data_size_in_dwords;
+      p->temps = info.temps_required;
+      p->entries_size = MIN2(info.entries_written_size_in_bytes, info.entries_size_in_bytes);
+      p->entries = info.entries;
+   }
+   uint32_t *data = arena_alloc(&d->pds, MAX2(p->data_dwords, 1) * 4, 64, &addr);
+   bool ok = data != NULL;
+   if (ok) {
+      memset(data, 0, p->data_dwords * 4);
+      ok = draw_pds_patch(p->entries, p->entries_size, data, vals);
+   }
+   *code_off = p->code_off;
+   *data_off = addr - pds_base;
+   *data_dwords = p->data_dwords;
+   *temps = p->temps;
+   if (p == &tmp)
+      free(tmp.entries);
+   return ok;
+}
+
+static void
+draw_gen_vertex(const void *input, uint32_t *code, struct pvr_pds_info *info,
+                const struct pvr_device_info *dev_info)
+{
+   pvr_pds_generate_vertex_primary_program((struct pvr_pds_vertex_primary_program_input *)input,
+                                           code, info, false, dev_info);
+}
+
+static void
+draw_gen_descriptor(const void *input, uint32_t *code, struct pvr_pds_info *info,
+                    UNUSED const struct pvr_device_info *dev_info)
+{
+   pvr_pds_generate_descriptor_upload_program((struct pvr_pds_descriptor_program_input *)input,
+                                              code, info);
+}
+
+bool
+pvr_draw_texture_format_supported(enum pipe_format format)
+{
+   struct pvr_format_layout layout;
+   return pvr_format_layout_from_pipe(format, &layout);
+}
+
+/* The texture descriptor of one level of a resource, as an image of its own: a twiddled level is
+ * the power-of-two image the PBE writes, so it is described with its allocated extents (only
+ * the logical part of it is ever addressed). */
+static void
+draw_level_desc(const struct pvr_resource *res, unsigned level,
+                enum ROGUE_TEXSTATE_FORMAT components, struct pvr_tex_desc *tex)
+{
+   const bool level0 = level == 0;
+   const struct util_format_description *desc = util_format_description(res->base.format);
+   *tex = (struct pvr_tex_desc){
+      .components = components,
+      .width = level0 ? res->base.width0 : pvr_resource_level_phys_w(res, level),
+      .height = level0 ? res->base.height0 : pvr_resource_level_phys_h(res, level),
+      .stride = pvr_resource_level_stride(res, level) / util_format_get_blocksize(res->base.format),
+      .addr = pvr_resource_level_addr(res, level),
+      .twiddled = res->twiddled,
+      .fbc = res->fbc,
+      .gamma = util_format_is_srgb(res->base.format),
+      /* The reference's vk_format_is_alpha_on_msb: an RGBA-order colour format has alpha in the
+       * most significant byte (the 4th channel maps to W); the TPU needs this to place the sRGB
+       * decode correctly (without it the first memory channel is treated as alpha and left
+       * un-decoded). */
+      .alpha_msb = (desc->colorspace == UTIL_FORMAT_COLORSPACE_RGB ||
+                    desc->colorspace == UTIL_FORMAT_COLORSPACE_SRGB) &&
+                   desc->swizzle[3] == PIPE_SWIZZLE_W,
+   };
+}
+
+/* The border colour table entry for this sampler, or 0 (built-in transparent black). Reference
+ * layout (pvr_arch_border.c): one 4096-byte entry per index, the first 128 16-byte values indexed by
+ * the ROGUE_TEXSTATE_FORMAT the texture uses, then 128 compressed values (unused: no compressed
+ * formats here). The colour is packed in the layout the hardware will read for that format. */
+static uint32_t
+draw_bct_index(struct pvr_context *ctx, const struct pipe_sampler_state *smp)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (d == NULL || (smp->wrap_s != PIPE_TEX_WRAP_CLAMP_TO_BORDER &&
+                     smp->wrap_t != PIPE_TEX_WRAP_CLAMP_TO_BORDER &&
+                     smp->wrap_r != PIPE_TEX_WRAP_CLAMP_TO_BORDER))
+      return 0;
+   for (unsigned i = 0; i < d->nr_bct; i++) {
+      if (!memcmp(&d->bct[i].color, &smp->border_color, sizeof(union pipe_color_union)))
+         return 5 + i;
+   }
+   if (d->nr_bct == ARRAY_SIZE(d->bct)) {
+      if (!d->bct_full_logged)
+         mesa_loge("pvr: more than %u distinct border colours; further ones fall back to black",
+                   (unsigned)ARRAY_SIZE(d->bct));
+      d->bct_full_logged = true;
+      return 0;
+   }
+   static const struct {
+      uint32_t fmt;
+      enum pipe_format pipe;
+   } slots[] = {
+      { ROGUE_TEXSTATE_FORMAT_U8U8U8U8, PIPE_FORMAT_R8G8B8A8_UNORM },
+      { ROGUE_TEXSTATE_FORMAT_U8, PIPE_FORMAT_R8_UNORM },
+      { ROGUE_TEXSTATE_FORMAT_U8U8, PIPE_FORMAT_R8G8_UNORM },
+      { ROGUE_TEXSTATE_FORMAT_U16, PIPE_FORMAT_R16_UNORM },
+      { ROGUE_TEXSTATE_FORMAT_F16F16F16F16, PIPE_FORMAT_R16G16B16A16_FLOAT },
+      { ROGUE_TEXSTATE_FORMAT_R5G6B5, PIPE_FORMAT_B5G6R5_UNORM },
+      { ROGUE_TEXSTATE_FORMAT_A2R10B10G10, PIPE_FORMAT_R10G10B10A2_UNORM },
+      { ROGUE_TEXSTATE_FORMAT_F32F32F32F32, PIPE_FORMAT_R32G32B32A32_FLOAT },
+   };
+   uint8_t *base = (uint8_t *)d->bct_bo.map + (uint64_t)(5 + d->nr_bct) * 4096;
+   memset(base, 0, 4096);
+   for (unsigned i = 0; i < ARRAY_SIZE(slots); i++)
+      util_format_pack_rgba(slots[i].pipe, base + (uint64_t)slots[i].fmt * 16,
+                            &smp->border_color, 1);
+   d->bct[d->nr_bct].color = smp->border_color;
+   d->nr_bct++;
+   return 5 + (d->nr_bct - 1);
+}
+
+/* One combined image sampler for texture unit u of a stage: image words, image meta (zero: 2D,
+ * one layer, no packing), sampler words, sampler meta (compare op NEVER, 0). */
+static bool
+draw_tex_binding(struct pvr_context *ctx, unsigned stage, unsigned u, uint32_t *out)
+{
+   const struct pipe_sampler_view *view = ctx->views[stage][u];
+   const struct pipe_sampler_state *smp = ctx->samplers[stage][u];
+   struct pvr_format_layout layout;
+   struct pvr_csb csb;
+
+   memset(out, 0, PVR_TEX_BINDING_DWORDS * 4);
+   /* An unbound unit reads an incomplete texture, black with alpha 1 in GL. */
+   static const struct pipe_sampler_state nearest = {
+      .wrap_s = PIPE_TEX_WRAP_CLAMP_TO_EDGE, .wrap_t = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      .wrap_r = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+   };
+   struct pipe_sampler_view black_view;
+   if ((view == NULL || view->texture == NULL) && ctx->draw != NULL) {
+      struct pvr_draw_state *dd = ctx->draw;
+      if (dd->black == NULL) {
+         const struct pipe_resource templ = {
+            .target = PIPE_TEXTURE_2D, .format = PIPE_FORMAT_R8G8B8A8_UNORM, .width0 = 1,
+            .height0 = 1, .depth0 = 1, .array_size = 1, .bind = PIPE_BIND_SAMPLER_VIEW,
+         };
+         dd->black = ctx->base.screen->resource_create(ctx->base.screen, &templ);
+         struct pvr_resource *br = dd->black ? pvr_resource(dd->black) : NULL;
+         if (br == NULL || (br->bo.map == NULL && !pvr_bo_map(draw_screen(ctx)->fd, &br->bo)))
+            return false;
+         *(uint32_t *)br->bo.map = 0xff000000u;
+      }
+      black_view = (struct pipe_sampler_view){
+         .format = PIPE_FORMAT_R8G8B8A8_UNORM, .target = PIPE_TEXTURE_2D, .texture = dd->black,
+         .swizzle_r = PIPE_SWIZZLE_X, .swizzle_g = PIPE_SWIZZLE_Y, .swizzle_b = PIPE_SWIZZLE_Z,
+         .swizzle_a = PIPE_SWIZZLE_W,
+      };
+      view = &black_view;
+   }
+   if (smp == NULL)
+      smp = &nearest;
+   const bool cube_view = view != NULL && view->target == PIPE_TEXTURE_CUBE;
+   if (view == NULL || view->texture == NULL ||
+       (!cube_view && view->target != PIPE_TEXTURE_2D && view->target != PIPE_TEXTURE_RECT) ||
+       !pvr_format_layout_from_pipe(view->format, &layout))
+      return false;
+   struct pvr_resource *res = pvr_resource(view->texture);
+   if (ctx->draw != NULL)
+      draw_use(ctx->draw, view->texture);
+   const unsigned char view_swz[4] = { view->swizzle_r, view->swizzle_g, view->swizzle_b,
+                                       view->swizzle_a };
+   /* A mip filter samples the view's levels of the chain; without one (or with one level) the
+    * view's first level is described as an image of its own. */
+   const unsigned first = MIN2(view->u.tex.first_level, res->base.last_level);
+   const unsigned last = MIN2(view->u.tex.last_level, res->base.last_level);
+   const bool chain = smp->min_mip_filter != PIPE_TEX_MIPFILTER_NONE && last > first;
+   struct pvr_tex_desc tex;
+   draw_level_desc(res, chain ? 0 : first, layout.components, &tex);
+   if (chain) {
+      tex.num_levels = last - first + 1;
+      tex.base_level = first;
+   }
+   if (cube_view) {
+      /* The whole cube: six faces from base_array_layer, the hardware selects by direction. */
+      tex.cube = true;
+      tex.layers = 6;
+      tex.addr = pvr_resource_level_addr_layer(res, chain ? 0 : first,
+                                               MIN2(view->u.tex.first_layer, 5));
+   }
+   util_format_compose_swizzles(layout.swizzle, view_swz, tex.swizzle);
+   struct pvr_sampler_desc sd = {
+      .bordercolor_index = draw_bct_index(ctx, smp),
+      .wrap_s = smp->wrap_s,
+      .wrap_t = smp->wrap_t,
+      .wrap_r = smp->wrap_r,
+      .min_filter = smp->min_img_filter,
+      .mag_filter = smp->mag_img_filter,
+      .mip_filter = chain && smp->min_mip_filter == PIPE_TEX_MIPFILTER_LINEAR,
+      .min_lod = smp->min_lod,
+      .max_lod = smp->max_lod,
+      /* GL applies anisotropic filtering to minification with a linear min filter; the TPU takes
+       * the ratio as an enum (x2..x16). */
+      .anisoctl = smp->min_img_filter == PIPE_TEX_FILTER_LINEAR && smp->max_anisotropy >= 16 ? 4
+                  : smp->min_img_filter == PIPE_TEX_FILTER_LINEAR && smp->max_anisotropy >= 8 ? 3
+                  : smp->min_img_filter == PIPE_TEX_FILTER_LINEAR && smp->max_anisotropy >= 4 ? 2
+                  : smp->min_img_filter == PIPE_TEX_FILTER_LINEAR && smp->max_anisotropy >= 2 ? 1
+                                                                                            : 0,
+   };
+   if (chain) {
+      /* As the Vulkan sampler: the hardware picks min or mag filter from the clamped LOD, so a
+       * clamp that rules one out uses the other; and with quirk 51025 nearest-mip rounding adds
+       * its 0.5 before the clamp, so the bounds carry it too. */
+      if (sd.min_lod > 0.0f)
+         sd.mag_filter = sd.min_filter;
+      if (sd.max_lod <= 0.0f)
+         sd.min_filter = sd.mag_filter;
+      if (!sd.mip_filter && PVR_HAS_QUIRK(&draw_screen(ctx)->dev_info, 51025)) {
+         sd.min_lod += 0.5f;
+         sd.max_lod += 0.5f;
+      }
+   }
+   pvr_csb_init(&csb, out, ROGUE_NUM_TEXSTATE_DWORDS * 4, 0);
+   if (!pvr_csb_emit_tex_desc(&csb, &tex) || csb.overflowed)
+      return false;
+   if (cube_view) {
+      /* Image metadata follows the image state words: layer size (the face stride) is meta word 0
+       * (PCO_IMAGE_META_LAYER_SIZE). */
+      out[ROGUE_NUM_TEXSTATE_DWORDS + PCO_IMAGE_META_LAYER_SIZE] = res->layer_size;
+   }
+   pvr_csb_init(&csb, out + 2 * ROGUE_NUM_TEXSTATE_DWORDS, ROGUE_NUM_TEXSTATE_DWORDS * 4, 0);
+   return pvr_csb_emit_sampler_desc(&csb, &sd) && !csb.overflowed;
+}
+
+/* A stage's uniform program for this draw: constant buffer 0 copied into the general arena and a
+ * PDS descriptor program that DMAs its first uniform_dwords dwords into the shader's shared
+ * registers (the reference's push-constant buffer, PVR_BUFFER_TYPE_PUSH_CONSTS). Offsets out are
+ * PDS-heap offsets. A shader without uniforms gets none and returns true with *data_dwords 0. */
+static bool
+draw_uniform_program(struct pvr_context *ctx, struct pvr_draw_state *d,
+                     const struct pvr_shader *sh, unsigned stage, uint32_t *code_off,
+                     uint32_t *data_off, uint32_t *data_dwords, uint32_t *temps)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   const struct pipe_constant_buffer *cb = &ctx->cb0[stage];
+   struct pvr_pds_descriptor_program_input din = { 0 };
+   uint64_t uaddr;
+   const uint8_t *src = NULL;
+
+   *data_dwords = 0;
+   *temps = 0;
+   if (sh->shared_dma_dwords == 0)
+      return true;
+
+   /* The uniform values. */
+   unsigned avail = 0;
+   if (cb->user_buffer != NULL) {
+      src = cb->user_buffer;
+      avail = cb->buffer_size;
+   } else if (cb->buffer != NULL) {
+      struct pvr_resource *res = pvr_resource(cb->buffer);
+      if (res->bo.map == NULL && !pvr_bo_map(scr->fd, &res->bo))
+         return false;
+      src = (const uint8_t *)res->bo.map + cb->buffer_offset;
+      avail = cb->buffer_size;
+   }
+   /* The shared block: uniforms, then the texture descriptors. */
+   const unsigned bytes = sh->shared_dma_dwords * 4;
+   uint8_t *u = arena_alloc(&d->gen, bytes, 16, &uaddr);
+   if (u == NULL)
+      return false;
+   memset(u, 0, bytes);
+   if (src != NULL && sh->uniform_dwords)
+      memcpy(u + (sh->uniform_dst - sh->shared_dma_start) * 4, src,
+             MIN2(sh->uniform_dwords * 4, avail));
+   if (sh->blend_mask) {
+      uint32_t *bc = (uint32_t *)(u + (sh->blend_dst - sh->shared_dma_start) * 4);
+      u_foreach_bit (c, sh->blend_mask)
+         *bc++ = fui(ctx->blend_color.color[c]);
+   }
+   u_foreach_bit (t, sh->tex_mask) {
+      if (!draw_tex_binding(ctx, stage, t,
+                            (uint32_t *)(u + (sh->tex_dst[t] - sh->shared_dma_start) * 4)))
+         return false;
+   }
+
+   /* The descriptor program and its data segment. */
+   din.buffer_count = 1;
+   din.buffers[0] = (struct pvr_pds_buffer){
+      .type = PVR_BUFFER_TYPE_PUSH_CONSTS,
+      .size_in_dwords = sh->shared_dma_dwords,
+      .destination = sh->shared_dma_start,
+   };
+   const uint32_t key[2] = { sh->shared_dma_dwords, sh->shared_dma_start };
+   const struct pvr_draw_pds_vals vals = { .buffer_addr = uaddr };
+   return draw_pds_program(ctx, d, key, sizeof(key), draw_gen_descriptor, &din, &vals, code_off,
+                           data_off, data_dwords, temps);
+}
+
+/* The background object for a clear colour: a constant-colour fragment program. Each attachment
+ * gets the clear colour packed for its own format, so a mixed-format MRT clear needs one program
+ * with one store per output dword. */
+static uint64_t
+draw_bg_program(struct pvr_context *ctx, struct pvr_draw_state *d,
+                const uint32_t *words, unsigned nwords)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   nir_builder b;
+   struct pvr_shader *bg;
+
+   for (unsigned i = 0; i < d->nr_bg; i++) {
+      if (d->bg[i].nwords == nwords &&
+          !memcmp(d->bg[i].words, words, nwords * sizeof(words[0])))
+         return d->bg[i].pds_offset;
+   }
+   b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(), "pvr_bg");
+   b.shader->info.internal = false;
+   /* One packed pixel-output dword per store: the EOT emit for attachment i reads the dwords that
+    * attachment's format occupies (one for an 8-bit format, two for 16F). */
+   for (unsigned i = 0; i < nwords; i++)
+      nir_frag_store_pco(&b, nir_imm_int(&b, (int)words[i]), .base = i);
+   nir_jump(&b, nir_jump_return);
+   bg = pvr_shader_create(b.shader, scr->pco_ctx);
+   if (bg == NULL || !draw_upload_fs(scr, bg))
+      return 0;
+   /* shortcut: four cached colours, round robin; the evicted programs stay allocated. */
+   const unsigned slot = d->nr_bg < ARRAY_SIZE(d->bg) ? d->nr_bg++ : (words[0] & 3);
+   d->bg[slot] = (struct pvr_draw_bg){ .nwords = nwords, .pds_offset = bg->pds_offset };
+   memcpy(d->bg[slot].words, words, nwords * sizeof(words[0]));
+   return bg->pds_offset;
+}
+
+/* The load background object: a fragment shader that fetches the target's own texel at its pixel
+ * (texture unit 0 = the target, set 0 binding 0) and writes it back, with the PDS program that
+ * DMAs that texture's descriptor into shared registers, as the reference's load op. Fills the
+ * PDS_BGRND words; false if the target cannot be read as a texture. */
+static bool
+draw_load_program(struct pvr_context *ctx, struct pvr_draw_state *d, uint64_t bgnd[3])
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   /* The texture read: the target itself, or a blit's source (same size and format). */
+   struct pipe_resource *src = d->load_src ? d->load_src : d->rt;
+   const unsigned src_level = d->load_src ? d->load_src_level : d->rt_level;
+   const struct pvr_resource *rt = pvr_resource(src);
+   const enum pipe_format format = d->rt->format;
+   const bool gen = d->load_gen;
+   struct pvr_shader *fs = NULL;
+   struct pvr_format_layout layout;
+
+   if (!pvr_format_layout_from_pipe(format, &layout))
+      return false;
+   for (unsigned i = 0; i < d->nr_load; i++) {
+      if (d->load[i].format == format && d->load[i].gen == gen)
+         fs = d->load[i].fs;
+   }
+   if (fs == NULL) {
+      nir_builder b =
+         nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(), "pvr_load");
+      nir_variable *out = nir_variable_create(b.shader, nir_var_shader_out, glsl_vec4_type(),
+                                              "color");
+      out->data.location = FRAG_RESULT_DATA0;
+      nir_def *xy = nir_f2i32(&b, nir_trim_vector(&b, nir_load_frag_coord(&b), 2));
+      nir_def *color = NULL;
+      /* Load: the texel at the pixel. Generation: the box filter of the 2x2 texels under it, the
+       * odd last row/column clamped onto the edge (the source level's last texel, a uniform). */
+      nir_def *last = gen ? nir_load_uniform(&b, 2, 32, nir_imm_int(&b, 0), .base = 0, .range = 1,
+                                             .dest_type = nir_type_int32)
+                          : NULL;
+      for (unsigned i = 0; i < (gen ? 4u : 1u); i++) {
+         nir_def *c = xy;
+         if (gen) {
+            c = nir_iadd(&b, nir_ishl_imm(&b, xy, 1), nir_imm_ivec2(&b, i & 1, i >> 1));
+            c = nir_imin(&b, c, last);
+         }
+         nir_tex_instr *tex = nir_tex_instr_create(b.shader, 2);
+         tex->op = nir_texop_txf;
+         tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+         tex->dest_type = nir_type_float32;
+         tex->coord_components = 2;
+         tex->texture_index = 0;
+         tex->sampler_index = 0;
+         tex->src[0] = nir_tex_src_for_ssa(nir_tex_src_coord, c);
+         tex->src[1] = nir_tex_src_for_ssa(nir_tex_src_lod, nir_imm_int(&b, 0));
+         nir_def_init(&tex->instr, &tex->def, 4, 32);
+         nir_builder_instr_insert(&b, &tex->instr);
+         color = color ? nir_fadd(&b, color, &tex->def) : &tex->def;
+      }
+      if (gen)
+         color = nir_fmul_imm(&b, color, 0.25);
+      nir_store_var(&b, out, color, 0xf);
+      BITSET_SET(b.shader->info.textures_used, 0);
+      BITSET_SET(b.shader->info.textures_used_by_txf, 0);
+      fs = pvr_shader_create_fs(b.shader, scr->pco_ctx, &format, 1, NULL);
+      if (fs == NULL || !draw_upload_fs(scr, fs) || fs->tex_mask != 1 ||
+          (gen && fs->uniform_dwords < 2)) {
+         mesa_loge("pvr: draw: no load program (%s, gen %d)", util_format_short_name(format), gen);
+         return false;
+      }
+      /* shortcut: eight cached variants, round robin; the evicted shader stays allocated. */
+      const unsigned slot = d->nr_load < ARRAY_SIZE(d->load)
+                               ? d->nr_load++
+                               : (format * 2 + gen) % ARRAY_SIZE(d->load);
+      d->load[slot] = (struct pvr_draw_load){ .format = format, .gen = gen, .fs = fs };
+   }
+
+   /* The shared block: the target as a texture, read with NEAREST. */
+   uint64_t uaddr;
+   uint32_t *u = arena_alloc(&d->gen, fs->shared_dma_dwords * 4, 16, &uaddr);
+   if (u == NULL)
+      return false;
+   memset(u, 0, fs->shared_dma_dwords * 4);
+   uint32_t *binding = u + (fs->tex_dst[0] - fs->shared_dma_start);
+   if (gen) {
+      int32_t *last = (int32_t *)(u + (fs->uniform_dst - fs->shared_dma_start));
+      last[0] = (int32_t)u_minify(src->width0, src_level) - 1;
+      last[1] = (int32_t)u_minify(src->height0, src_level) - 1;
+   }
+   struct pvr_tex_desc tex;
+   draw_level_desc(rt, src_level, layout.components, &tex);
+   memcpy(tex.swizzle, layout.swizzle, sizeof(tex.swizzle));
+   /* A cube face is read as a 2D image of its own: address at the face, no cube textype, no
+    * layer stride (the level sizes inside a face are the same chain the 2D case uses). */
+   if (d->load_src_layer != 0) {
+      tex.addr = pvr_resource_level_addr_layer(rt, src_level, d->load_src_layer);
+      tex.cube = false;
+      tex.layers = 0;
+      tex.num_levels = 0;
+      tex.base_level = 0;
+   }
+   const struct pvr_sampler_desc smp = {
+      .wrap_s = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      .wrap_t = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      .wrap_r = PIPE_TEX_WRAP_CLAMP_TO_EDGE,
+      .min_filter = PIPE_TEX_FILTER_NEAREST,
+      .mag_filter = PIPE_TEX_FILTER_NEAREST,
+   };
+   struct pvr_csb csb;
+   pvr_csb_init(&csb, binding, ROGUE_NUM_TEXSTATE_DWORDS * 4, 0);
+   if (!pvr_csb_emit_tex_desc(&csb, &tex) || csb.overflowed)
+      return false;
+   pvr_csb_init(&csb, binding + 2 * ROGUE_NUM_TEXSTATE_DWORDS, ROGUE_NUM_TEXSTATE_DWORDS * 4, 0);
+   if (!pvr_csb_emit_sampler_desc(&csb, &smp) || csb.overflowed)
+      return false;
+
+   struct pvr_pds_descriptor_program_input din = { .buffer_count = 1 };
+   din.buffers[0] = (struct pvr_pds_buffer){
+      .type = PVR_BUFFER_TYPE_PUSH_CONSTS,
+      .size_in_dwords = fs->shared_dma_dwords,
+      .destination = fs->shared_dma_start,
+   };
+   const uint32_t key[2] = { fs->shared_dma_dwords, fs->shared_dma_start };
+   const struct pvr_draw_pds_vals vals = { .buffer_addr = uaddr };
+   uint32_t code_off, data_off, data_dwords, temps;
+   if (!draw_pds_program(ctx, d, key, sizeof(key), draw_gen_descriptor, &din, &vals, &code_off,
+                         &data_off, &data_dwords, &temps))
+      return false;
+   pvr_csb_pds_bgnd_words(fs->pds_offset, code_off, data_off, temps, fs->shareds, data_dwords,
+                          bgnd);
+   return true;
+}
+
+/* The end-of-tile program for a target address: PBE state words baked into a USC program, kicked by
+ * a PDS pixel-event data segment. */
+static uint64_t
+draw_eot_program(struct pvr_context *ctx, struct pvr_draw_state *d, unsigned nr_attachments,
+                 const uint64_t *rt_addrs, const enum pipe_format *formats,
+                 const uint32_t *start_dwords, bool zonlyrender)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   struct pvr_shader_eot eot = { 0 };
+   struct pvr_pds_event_program program = { 0 };
+   uint32_t state_words[PVR_MAX_COLOR_ATTACHMENTS * 2];
+   uint32_t staging[64] = { 0 };
+   uint32_t usc_offset;
+
+   for (unsigned i = 0; i < d->nr_eot; i++) {
+      if (d->eot[i].nr == nr_attachments && d->eot[i].zonly == zonlyrender &&
+          !memcmp(d->eot[i].addr, rt_addrs, nr_attachments * sizeof(rt_addrs[0])) &&
+          !memcmp(d->eot[i].format, formats, nr_attachments * sizeof(formats[0])))
+         return d->eot[i].pds_offset;
+   }
+   for (unsigned i = 0; i < nr_attachments; i++)
+      pvr_csb_pbe_state_words(rt_addrs[i], formats[i], i, start_dwords[i], zonlyrender,
+                              &state_words[2 * i]);
+   if (!pvr_shader_eot_create(scr->pco_ctx, &eot, nr_attachments, state_words))
+      return 0;
+   usc_offset = draw_upload_usc(scr, eot.binary, eot.binary_size);
+   if (usc_offset == 0)
+      return 0;
+   pvr_pds_setup_doutu(&program.task_control, usc_offset, eot.temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, false);
+   pvr_pds_generate_pixel_event(&program, NULL, PDS_GENERATE_SIZES, &scr->dev_info);
+   if (program.data_size > ARRAY_SIZE(staging))
+      return 0;
+   pvr_pds_generate_pixel_event(&program, staging, PDS_GENERATE_DATA_SEGMENT, &scr->dev_info);
+   const uint64_t pds_offset = draw_upload_pds(scr, staging, program.data_size * 4);
+   if (pds_offset == 0)
+      return 0;
+   /* shortcut: 32 cached target sets, round robin; the evicted programs stay allocated. */
+   const unsigned slot = d->nr_eot < ARRAY_SIZE(d->eot) ? d->nr_eot++
+                                                        : (unsigned)(rt_addrs[0] >> 12) % ARRAY_SIZE(d->eot);
+   struct pvr_draw_eot *e = &d->eot[slot];
+   *e = (struct pvr_draw_eot){ .nr = nr_attachments, .pds_offset = pds_offset,
+                               .zonly = zonlyrender };
+   memcpy(e->addr, rt_addrs, nr_attachments * sizeof(e->addr[0]));
+   memcpy(e->format, formats, nr_attachments * sizeof(e->format[0]));
+   return pds_offset;
+}
+
+static bool
+draw_topology(enum mesa_prim mode, enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY *out)
+{
+   switch (mode) {
+   case MESA_PRIM_POINTS: *out = ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_POINT_LIST; return true;
+   case MESA_PRIM_LINES: *out = ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_LINE_LIST; return true;
+   case MESA_PRIM_LINE_STRIP: *out = ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_LINE_STRIP; return true;
+   case MESA_PRIM_TRIANGLES: *out = ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_TRI_LIST; return true;
+   case MESA_PRIM_TRIANGLE_STRIP: *out = ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_TRI_STRIP; return true;
+   case MESA_PRIM_TRIANGLE_FAN: *out = ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY_TRI_FAN; return true;
+   default: return false;
+   }
+}
+
+/* The format the PBE's source data must be packed in: logical channel order, because the PBE applies
+ * the target format's channel swizzle itself. pco does the same for shader outputs (to_pbe_format
+ * maps B8G8R8A8 to R8G8B8A8 before packing), so the background clear colour must follow it too -
+ * packing it in the target's memory order swapped red and blue on a BGRA8 target. */
+static enum pipe_format
+draw_pbe_pack_format(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_B5G6R5_UNORM:
+      return PIPE_FORMAT_R8G8B8_UNORM;
+   case PIPE_FORMAT_A4R4G4B4_UNORM:
+   case PIPE_FORMAT_B5G5R5A1_UNORM:
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+      return PIPE_FORMAT_R8G8B8A8_UNORM;
+   /* sRGB targets: the PBE's source format is F16 per channel (linear) and its gamma bit encodes on
+    * write, so the clear colour has to be packed as linear half floats in RGBA order. */
+   case PIPE_FORMAT_A8B8G8R8_SRGB:
+   case PIPE_FORMAT_B8G8R8A8_SRGB:
+   case PIPE_FORMAT_R8G8B8A8_SRGB:
+      return PIPE_FORMAT_R16G16B16A16_FLOAT;
+   default:
+      return format;
+   }
+}
+
+/* Pack a clear colour for an 8-bit-per-channel target. */
+static uint32_t
+draw_pack_color(enum pipe_format format, const union pipe_color_union *c)
+{
+   uint32_t packed = 0;
+   util_format_pack_rgba(format, &packed, c->f, 1);
+   return packed;
+}
+
+static bool
+draw_format_ok(enum pipe_format f)
+{
+   /* Every 8-bit colour target the PBE can write with the generic U8x4 packmode: the 8888 set
+    * plus the single/double-channel formats, which ES2 needs as render targets only so that
+    * EXT_texture_rg is advertised (Mesa gates it on R8/RG8 being renderable, table
+    * st_extension_format_mapping); rendering them works the same through the twiddled path. */
+   return f == PIPE_FORMAT_R8G8B8A8_UNORM || f == PIPE_FORMAT_B8G8R8A8_UNORM ||
+          f == PIPE_FORMAT_R8G8B8X8_UNORM || f == PIPE_FORMAT_B8G8R8X8_UNORM ||
+          f == PIPE_FORMAT_R8_UNORM || f == PIPE_FORMAT_R8G8_UNORM ||
+          f == PIPE_FORMAT_R8G8B8A8_SRGB || f == PIPE_FORMAT_B8G8R8A8_SRGB ||
+          f == PIPE_FORMAT_A8B8G8R8_SRGB || f == PIPE_FORMAT_R16G16B16A16_FLOAT;
+}
+
+/* The vertex attribute fetch program and its data segment for the bound vertex elements. */
+static bool
+draw_vertex_program(struct pvr_context *ctx, struct pvr_draw_state *d, struct pvr_shader *vs,
+                    uint64_t *code_off, uint64_t *data_off, uint32_t *temps,
+                    uint32_t *data_dwords)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   const struct pvr_vertex_elements *ve = ctx->velements_state;
+   struct pvr_pds_vertex_dma dmas[16];
+   struct pvr_pds_vertex_primary_program_input input = { .dma_list = dmas };
+   struct pvr_pds_info info = { 0 };
+   uint64_t vb_addr[PIPE_MAX_ATTRIBS] = { 0 };
+   uint32_t vb_stride[PIPE_MAX_ATTRIBS] = { 0 };
+   const uint64_t pds_base = scr->vm.heaps[DRM_PVR_HEAP_PDS_CODE_DATA].base;
+   uint64_t code_addr = 0, data_addr = 0;
+   uint32_t *code, *data;
+   bool ok = true;
+
+   if (ve == NULL)
+      return false;
+   for (unsigned i = 0; i < vs->nr_inputs; i++) {
+      const struct pipe_vertex_element *el;
+      const struct pipe_vertex_buffer *vb;
+      if (vs->inputs[i].element >= ve->count)
+         return false;
+      el = &ve->elements[vs->inputs[i].element];
+      if (el->vertex_buffer_index >= ctx->nr_vertex_buffers)
+         return false;
+      vb = &ctx->vertex_buffers[el->vertex_buffer_index];
+      /* shortcut: float32 attributes only (the DMA copies dwords; pco reads them as float). */
+      if (vb->is_user_buffer || vb->buffer.resource == NULL ||
+          util_format_description(el->src_format)->channel[0].type != UTIL_FORMAT_TYPE_FLOAT ||
+          util_format_get_blocksize(el->src_format) % 4 != 0)
+         return false;
+      vb_addr[el->vertex_buffer_index] =
+         pvr_resource(vb->buffer.resource)->dev_addr + vb->buffer_offset;
+      draw_use(d, vb->buffer.resource);
+      vb_stride[el->vertex_buffer_index] = el->src_stride;
+      dmas[i] = (struct pvr_pds_vertex_dma){
+         .offset = el->src_offset,
+         .stride = el->src_stride,
+         .size_in_dwords = util_format_get_blocksize(el->src_format) / 4,
+         .attrib_size_in_bytes = util_format_get_blocksize(el->src_format),
+         .destination = vs->inputs[i].vtxin,
+         .binding_index = el->vertex_buffer_index,
+         /* Per-instance data: the PDS vertex program advances this attribute once per `divisor`
+          * instances instead of once per vertex (the reference sets the same flag/divisor). */
+         .flags = el->instance_divisor != 0 ? PVR_PDS_VERTEX_DMA_FLAGS_INSTANCE_RATE : 0,
+         .divisor = el->instance_divisor,
+      };
+   }
+   input.dma_count = vs->nr_inputs;
+   pvr_pds_setup_doutu(&input.usc_task_control, 0, vs->temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, false);
+   /* The code depends on the DMA list and the shader's temp count (in the DOUTU control word). */
+   struct {
+      uint32_t temps, count;
+      struct pvr_pds_vertex_dma dmas[16];
+   } key = { .temps = vs->temps, .count = vs->nr_inputs };
+   memcpy(key.dmas, dmas, vs->nr_inputs * sizeof(dmas[0]));
+   const struct pvr_draw_pds_vals vals = {
+      .vb_addr = vb_addr, .vb_stride = vb_stride, .usc_offset = vs->usc_offset,
+   };
+   uint32_t c, dd;
+   if (!draw_pds_program(ctx, d, &key, offsetof(__typeof__(key), dmas) +
+                                          vs->nr_inputs * sizeof(dmas[0]),
+                         draw_gen_vertex, &input, &vals, &c, &dd, data_dwords, temps))
+      return false;
+   *code_off = c;
+   *data_off = dd;
+   return true;
+}
+
+/* The ZLS format type for a depth format, or -1 if the draw path does not depth-test it. */
+static int
+draw_zls_format(enum pipe_format f)
+{
+   switch (f) {
+   case PIPE_FORMAT_Z16_UNORM: return ROGUE_CR_ZLS_FORMAT_TYPE_16BITINT;
+   case PIPE_FORMAT_Z24X8_UNORM:
+   case PIPE_FORMAT_Z24_UNORM_S8_UINT: return ROGUE_CR_ZLS_FORMAT_TYPE_24BITINT;
+   case PIPE_FORMAT_Z32_FLOAT: return ROGUE_CR_ZLS_FORMAT_TYPE_F32Z;
+   default: return -1;
+   }
+}
+
+static bool
+draw_open(struct pvr_context *ctx, struct pvr_draw_state *d, struct pipe_resource *rt,
+          unsigned level, uint32_t w, uint32_t h, struct pipe_resource *zs)
+{
+   if (zs && draw_zls_format(zs->format) < 0)
+      zs = NULL;
+   /* A small colour-only render (mip levels, small targets) uses the data set of its size class:
+    * a power of two from 32 to 256 per side. The region clip, terminate clip and PBE clip keep it
+    * to its own extent; without that a mip chain (terrain: 19 level sizes per frame) evicted and
+    * recreated data sets on every render. With depth the ZLS stores whole tiles of the data set,
+    * so those keep their exact size. */
+   uint32_t dw = w, dh = h;
+   if (zs == NULL && w <= 256 && h <= 256) {
+      dw = MAX2(util_next_power_of_two(w), 32);
+      dh = MAX2(util_next_power_of_two(h), 32);
+   }
+   if (!draw_hwrt(ctx, d, dw, dh))
+      return false;
+   {
+      struct pvr_draw_hwrt *e = d->cur_hwrt;
+      const uint32_t prev = e->data_seq[e->rt_data_idx];
+      for (unsigned i = 0; prev != 0 && i < PVR_DRAW_SLOTS; i++) {
+         if (d->slots[i].sync != 0 && d->slots[i].seq == prev)
+            draw_slot_idle(draw_screen(ctx), &d->slots[i]);
+      }
+   }
+   /* The next slot: its previous render must be done before its memory is rewritten. */
+   {
+      const unsigned next = (d->cur_slot + 1) % PVR_DRAW_SLOTS;
+      struct pvr_draw_slot *sl = &d->slots[next];
+      draw_slot_idle(draw_screen(ctx), sl);
+      d->cur_slot = next;
+      d->gen = sl->gen;
+      d->pds = sl->pds;
+      d->ctrl_bo = sl->ctrl_bo;
+      d->ctrl_addr = sl->ctrl_addr;
+   }
+   d->gen.used = 0;
+   d->pds.used = 0;
+   d->rt_layer = 0;
+   d->load_src_layer = 0;
+   pvr_csb_init(&d->ctrl, d->ctrl_bo.map, d->ctrl_bo.size, PVR_CSB_LINK_DWORDS);
+   pipe_resource_reference(&d->rt, rt);
+   d->rt_level = level;
+   d->seq++;
+   draw_use(d, rt);
+   pipe_resource_reference(&d->zs, zs);
+   if (d->zs)
+      draw_use(d, d->zs);
+   d->zclear_valid = false;
+   /* A deferred clear of the target or depth buffer is where this render starts. */
+   struct pvr_resource *rres = pvr_resource(rt);
+   if (rres->clear_pending && level == 0) {
+      d->clear_valid = true;
+      d->clear_color = rres->clear_color;
+      d->clear_value = rres->clear_value;
+      rres->clear_pending = false;
+   }
+   if (d->zs && pvr_resource(d->zs)->zclear_pending) {
+      d->zclear_valid = true;
+      d->zclear = pvr_resource(d->zs)->zclear;
+      pvr_resource(d->zs)->zclear_pending = false;
+   }
+   d->rt_w = w;
+   d->rt_h = h;
+   d->ndraws = 0;
+   d->open = true;
+   return true;
+}
+
+/* The colour target the framebuffer renders into: colour buffer 0, or for a depth-only framebuffer
+ * a scratch colour target of its size. */
+static struct pipe_resource *
+draw_fb_target(struct pvr_context *ctx)
+{
+   struct pipe_resource *rt = ctx->fb.nr_cbufs ? ctx->fb.cbufs[0].texture : NULL;
+   if (rt == NULL && ctx->fb.zsbuf.texture != NULL && ctx->draw != NULL) {
+      struct pvr_draw_state *dd = ctx->draw;
+      if (dd->scratch_rt == NULL || dd->scratch_rt->width0 != ctx->fb.width ||
+          dd->scratch_rt->height0 != ctx->fb.height) {
+         const struct pipe_resource templ = {
+            .target = PIPE_TEXTURE_2D, .format = PIPE_FORMAT_R8G8B8A8_UNORM,
+            .width0 = ctx->fb.width, .height0 = ctx->fb.height, .depth0 = 1, .array_size = 1,
+            .bind = PIPE_BIND_RENDER_TARGET,
+         };
+         if (dd->open && dd->rt == dd->scratch_rt)
+            pvr_draw_flush(ctx);
+         pipe_resource_reference(&dd->scratch_rt, NULL);
+         dd->scratch_rt = ctx->base.screen->resource_create(ctx->base.screen, &templ);
+      }
+      rt = dd->scratch_rt;
+   }
+   return rt;
+}
+
+/* Submits a deferred clear of a resource that is about to be read other than as a render's
+ * target: a colour clear as a clear-only render into it, a depth clear as one into a scratch
+ * colour target of its size with it as the depth buffer. */
+static void
+draw_materialize(struct pvr_context *ctx, struct pipe_resource *pres)
+{
+   struct pvr_resource *res = pvr_resource(pres);
+   if (pres == NULL || (!res->clear_pending && !res->zclear_pending))
+      return;
+   /* The clear may have been recorded by another context (a shared texture). */
+   if (ctx->draw == NULL && (ctx->draw = calloc(1, sizeof(struct pvr_draw_state))) == NULL)
+      return;
+   struct pvr_draw_state *d = ctx->draw;
+   pvr_draw_flush(ctx);
+   struct pipe_resource *rt = pres, *zs = NULL;
+   if (res->zclear_pending) {
+      const struct pipe_resource templ = {
+         .target = PIPE_TEXTURE_2D, .format = PIPE_FORMAT_R8G8B8A8_UNORM,
+         .width0 = pres->width0, .height0 = pres->height0, .depth0 = 1, .array_size = 1,
+         .bind = PIPE_BIND_RENDER_TARGET,
+      };
+      rt = ctx->base.screen->resource_create(ctx->base.screen, &templ);
+      zs = pres;
+   }
+   if (rt != NULL && draw_init(ctx, d) &&
+       draw_open(ctx, d, rt, 0, pres->width0, pres->height0, zs)) {
+      d->no_defer = true;
+      pvr_draw_flush(ctx);
+      d->no_defer = false;
+   }
+   res->clear_pending = res->zclear_pending = false;
+   if (rt != pres)
+      pipe_resource_reference(&rt, NULL);
+}
+
+/* The mip level of the framebuffer's colour target (0 for the depth-only scratch target). */
+static unsigned
+draw_fb_level(struct pvr_context *ctx)
+{
+   return ctx->fb.nr_cbufs && ctx->fb.cbufs[0].texture ? ctx->fb.cbufs[0].level : 0;
+}
+
+/* The open render is the framebuffer's (target rt): same target, level, size and depth buffer. */
+static bool
+draw_open_is_fb(struct pvr_context *ctx, struct pvr_draw_state *d, struct pipe_resource *rt)
+{
+   struct pipe_resource *zs = ctx->fb.zsbuf.texture;
+   if (zs && draw_zls_format(zs->format) < 0)
+      zs = NULL;
+   return d->open && d->rt == rt && d->rt_level == draw_fb_level(ctx) &&
+          d->rt_w == ctx->fb.width && d->rt_h == ctx->fb.height && d->zs == zs;
+}
+
+bool
+pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
+            const struct pipe_draw_start_count_bias *draws, unsigned num_draws)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   struct pvr_draw_state *d;
+   struct pipe_resource *rt = draw_fb_target(ctx);
+   const enum pipe_format rt_format = rt ? rt->format : PIPE_FORMAT_NONE;
+   struct pvr_shader *vs = ctx->vs, *fs = ctx->fs;
+   enum ROGUE_VDMCTRL_PRIMITIVE_TOPOLOGY topo;
+
+   if (num_draws != 1 || rt == NULL || vs == NULL ||
+       fs == NULL || fs->src_nir == NULL || !draw_format_ok(rt_format) ||
+       !draw_topology(info->mode, &topo) || draws[0].count == 0)
+      return false;
+   /* Gallium's instance_count is 0 for a non-instanced draw; the hardware takes 1. */
+   const uint32_t instance_count = MAX2(info->instance_count, 1);
+   if (info->index_size && draws[0].index_bias != 0)
+      return false;
+   /* Both faces culled: no triangle survives (points and lines are not culled). */
+   if (ctx->rasterizer != NULL && ctx->rasterizer->cull_face == PIPE_FACE_FRONT_AND_BACK &&
+       u_reduced_prim(info->mode) == MESA_PRIM_TRIANGLES)
+      return true;
+
+   if (ctx->draw == NULL)
+      ctx->draw = calloc(1, sizeof(struct pvr_draw_state));
+   d = ctx->draw;
+   if (d == NULL || !draw_init(ctx, d))
+      return false;
+
+   /* The fragment shader variant for this framebuffer's colour format(s) and blend state. MRT v1:
+    * every attachment shares the first one's format (the background program emits one value). */
+   enum pipe_format rt_formats[PVR_MAX_COLOR_ATTACHMENTS] = { rt_format };
+   unsigned nr_formats = MIN2(ctx->fb.nr_cbufs, PVR_MAX_COLOR_ATTACHMENTS);
+   for (unsigned i = 0; i < nr_formats; i++)
+      rt_formats[i] = ctx->fb.cbufs[i].format;
+   nir_lower_blend_options blend;
+   memset(&blend, 0, sizeof(blend));
+   {
+      const struct pipe_blend_state *bs = ctx->blend;
+      const nir_lower_blend_channel replace = {
+         .func = PIPE_BLEND_ADD,
+         .src_factor = PIPE_BLENDFACTOR_ONE,
+         .dst_factor = PIPE_BLENDFACTOR_ZERO,
+      };
+      for (unsigned i = 0; i < nr_formats; i++) {
+         /* ES2 (with EXT_draw_buffers) has a single blend state and a single glColorMask, both
+          * applied to every draw buffer, so every attachment uses render target 0's state. Mesa's
+          * state tracker zero-fills pipe_blend_state::rt[] past the entries the API configured,
+          * and nir_lower_blend deletes a colour store whose colormask is zero - which silently
+          * dropped attachment 1's write until this read rt[0] for every attachment. */
+         const struct pipe_rt_blend_state *rtb = bs ? &bs->rt[0] : NULL;
+         blend.rt[i].format = rt_formats[i];
+         blend.rt[i].rgb = replace;
+         blend.rt[i].alpha = replace;
+         blend.rt[i].colormask = 0xf;
+         if (rtb != NULL) {
+            blend.rt[i].colormask = rtb->colormask;
+            if (bs->logicop_enable) {
+               blend.logicop_enable = true;
+               blend.logicop_func = bs->logicop_func;
+            } else if (rtb->blend_enable) {
+               blend.rt[i].rgb = (nir_lower_blend_channel){
+                  .func = rtb->rgb_func,
+                  .src_factor = rtb->rgb_src_factor,
+                  .dst_factor = rtb->rgb_dst_factor,
+               };
+               blend.rt[i].alpha = (nir_lower_blend_channel){
+                  .func = rtb->alpha_func,
+                  .src_factor = rtb->alpha_src_factor,
+                  .dst_factor = rtb->alpha_dst_factor,
+               };
+            }
+         }
+      }
+   }
+   struct pvr_shader *fsv = NULL;
+   for (unsigned i = 0; i < fs->nr_variants; i++) {
+      if (fs->variants[i].nr_formats == nr_formats &&
+          !memcmp(fs->variants[i].formats, rt_formats, nr_formats * sizeof(rt_formats[0])) &&
+          !memcmp(&fs->variants[i].blend, &blend, sizeof(blend)))
+         fsv = fs->variants[i].sh;
+   }
+   if (fsv == NULL) {
+      fsv = pvr_shader_create_fs(nir_shader_clone(NULL, fs->src_nir), scr->pco_ctx, rt_formats,
+                                 nr_formats, &blend);
+      if (fsv == NULL)
+         return false;
+      /* shortcut: round robin past PVR_SHADER_MAX_VARIANTS; the evicted variant stays allocated. */
+      const unsigned slot = fs->nr_variants < PVR_SHADER_MAX_VARIANTS ? fs->nr_variants++
+                                                                     : (rt_formats[0] + blend.rt[0].colormask) %
+                                                                          PVR_SHADER_MAX_VARIANTS;
+      fs->variants[slot].nr_formats = nr_formats;
+      memcpy(fs->variants[slot].formats, rt_formats, nr_formats * sizeof(rt_formats[0]));
+      fs->variants[slot].blend = blend;
+      fs->variants[slot].sh = fsv;
+   }
+   if (!draw_upload_fs(scr, fsv))
+      return false;
+   /* Textures with a deferred clear get it before this render can read them. */
+   for (unsigned st = 0; st < 2; st++) {
+      for (unsigned u = 0; u < PVR_MAX_TEXTURE_UNITS; u++) {
+         struct pipe_sampler_view *v = ctx->views[st][u];
+         if (v && v->texture && (pvr_resource(v->texture)->clear_pending ||
+                                 pvr_resource(v->texture)->zclear_pending))
+            draw_materialize(ctx, v->texture);
+      }
+   }
+   if (vs->usc_offset == 0 && (vs->usc_offset = draw_upload_usc(scr, vs->binary, vs->binary_size)) == 0)
+      return false;
+
+   const unsigned level = draw_fb_level(ctx);
+   if (d->open && !draw_open_is_fb(ctx, d, rt))
+      pvr_draw_flush(ctx);
+   if (!d->open && !draw_open(ctx, d, rt, level, ctx->fb.width, ctx->fb.height,
+                                    ctx->fb.zsbuf.texture))
+      return false;
+
+   /* Vertex fetch program. */
+   uint64_t vcode, vdata;
+   uint32_t vtemps, vdwords;
+   if (!draw_vertex_program(ctx, d, vs, &vcode, &vdata, &vtemps, &vdwords))
+      return false;
+
+   /* Varyings: the coefficient program and the TA's per-vertex varying counts. */
+   const bool flat_first = ctx->rasterizer && ctx->rasterizer->flatshade_first;
+   const bool coeff = draw_coeff_program(scr, fsv, vs, flat_first);
+   if (!coeff && (fsv->uses_z || fsv->uses_w || fsv->varyings_read))
+      return false;
+   /* Uniforms of both stages. */
+   uint32_t vu_code = 0, vu_data = 0, vu_dwords = 0, vu_temps = 0;
+   uint32_t fu_code = 0, fu_data = 0, fu_dwords = 0, fu_temps = 0;
+   if (!draw_uniform_program(ctx, d, vs, 0, &vu_code, &vu_data, &vu_dwords, &vu_temps) ||
+       !draw_uniform_program(ctx, d, fsv, 1, &fu_code, &fu_data, &fu_dwords, &fu_temps))
+      return false;
+   /* TA state block. */
+   uint64_t ta_addr;
+   uint32_t *ta = arena_alloc(&d->gen, 256, 64, &ta_addr);
+   if (ta == NULL)
+      return false;
+   struct pvr_csb block;
+   const struct pvr_ta_presence pres = {
+      .ispctl = true, .ispctl_fa = true, .ispctl_fb = true, .ispctl_dbsc = true,
+      .pds_state_ptr0 = true, .pds_state_ptr1 = coeff, .pds_state_ptr3 = true, .region_clip = true, .viewport = true,
+      .viewport_count = 1, .wclamp = true, .outselects = true, .varying_words = true,
+      .ppp_ctrl = true, .stream_out_size = true,
+   };
+   const struct pvr_ta_ispctl ispctl = { .bpres = true };
+   /* Depth test and write from the depth/stencil state; the PIPE_FUNC_* order is the TA's. */
+   const struct pipe_depth_stencil_alpha_state *dsa = ctx->dsa;
+   const bool depth = d->zs != NULL && dsa != NULL && dsa->depth_enabled;
+   const struct ROGUE_TA_STATE_ISPA ispa = {
+      .objtype = ROGUE_TA_OBJTYPE_TRIANGLE,
+      /* As the reference picks it: discard is punch-through, a shader that reads the target
+       * (blending) or leaves it unwritten is translucent. */
+      .passtype = fsv->discard                   ? ROGUE_TA_PASSTYPE_PUNCH_THROUGH
+                  : fsv->fbfetch || fsv->masked ? ROGUE_TA_PASSTYPE_TRANSLUCENT
+                                                : ROGUE_TA_PASSTYPE_OPAQUE,
+      .dwritedisable = !depth || !dsa->depth_writemask,
+      .dcmpmode = depth ? (enum ROGUE_TA_CMPMODE)dsa->depth_func : ROGUE_TA_CMPMODE_ALWAYS,
+      .pointlinewidth = 15,
+   };
+   const struct ROGUE_TA_STATE_ISPB ispb = {
+      .scmpmode = ROGUE_TA_CMPMODE_ALWAYS,
+      .sop1 = ROGUE_TA_ISPB_STENCILOP_KEEP,
+      .sop2 = ROGUE_TA_ISPB_STENCILOP_KEEP,
+      .sop3 = ROGUE_TA_ISPB_STENCILOP_KEEP,
+   };
+   const struct ROGUE_TA_STATE_ISPDBSC dbsc = { 0 };
+   const struct pvr_pds_sizes pds_sizes = {
+      .varying_dwords = coeff ? fsv->coeff_data_dwords : 0,
+      .usc_varying_dwords = fsv->coeffs,
+      .uniform_dwords = fu_dwords,
+      .temp_count = MAX2(coeff ? fsv->coeff_temps : 0, fu_temps),
+      .usc_shared_count = fsv->shareds,
+   };
+   const struct pipe_viewport_state *pv = &ctx->viewports[0];
+   const struct pvr_viewport_words vp = {
+      .a0 = fui(pv->translate[0]), .m0 = fui(pv->scale[0]),
+      .a1 = fui(pv->translate[1]), .m1 = fui(pv->scale[1]),
+      /* z arrives in [0, 1] (nir_lower_clip_halfz): depth = near + z * (far - near). */
+      .a2 = fui(pv->translate[2] - pv->scale[2]), .m2 = fui(2.0f * pv->scale[2]),
+   };
+   const struct ROGUE_TA_STATE_VARYING0 varying0 = {
+      .f32_linear = vs->f32_smooth, .f32_flat = vs->f32_flat, .f32_npc = vs->f32_npc,
+   };
+   const struct ROGUE_TA_STATE_VARYING1 varying1 = { 0 };
+   /* Face culling, as the reference maps it: the culled winding follows from which face is front
+    * and which face is culled. */
+   const struct pipe_rasterizer_state *rs = ctx->rasterizer;
+   enum ROGUE_TA_CULLMODE cullmode = ROGUE_TA_CULLMODE_NO_CULLING;
+   if (rs != NULL && (rs->cull_face == PIPE_FACE_FRONT || rs->cull_face == PIPE_FACE_BACK))
+      cullmode = (rs->front_ccw ^ (rs->cull_face == PIPE_FACE_FRONT)) ? ROGUE_TA_CULLMODE_CULL_CW
+                                                                      : ROGUE_TA_CULLMODE_CULL_CCW;
+   /* glPolygonOffset, constant term: shift the window depth by units * r (r = the smallest
+    * resolvable depth difference for the depth format). The hardware depth-bias int mode is still
+    * unresolved (it hangs the render), so the constant term is applied through the viewport depth
+    * transform instead; the slope-factor term is not applied (documented limitation). */
+   struct pvr_viewport_words vp_off = vp;
+   if (d->zs != NULL && rs != NULL && rs->offset_tri) {
+      /* glPolygonOffset, constant term. The hardware's depth-bias mode is still unresolved (its
+       * integer bias equation hangs this firmware), so the constant term - units * r, r being the
+       * smallest resolvable depth difference for the depth format - is applied through the viewport
+       * depth transform, which the TA applies after projection: an exact constant window-depth shift.
+       * The slope-factor term (factor * max depth slope) is not applied; documented limitation. */
+      const int zf = draw_zls_format(d->zs->format);
+      const float r = zf == ROGUE_CR_ZLS_FORMAT_TYPE_24BITINT ? 1.0f / 16777215.0f
+                                                              : 1.0f / 65535.0f;
+      float bias = rs->offset_units * r;
+      if (rs->offset_clamp > 0.0f)
+         bias = CLAMP(bias, -rs->offset_clamp, rs->offset_clamp);
+      vp_off.a2 = fui(uif(vp.a2) + bias);
+   }
+   const struct ROGUE_TA_STATE_PPP_CTRL ppp_ctrl = {
+      .cullmode = cullmode,
+      .clip_mode = ROGUE_TA_CLIP_MODE_FRONT_REAR,
+      .drawclippededges = true,
+      .flatshade_vtx = ROGUE_TA_FLATSHADE_VTX_VERTEX_0,
+      .wclampen = true,
+   };
+   const struct pvr_ta_output_sel outsel = {
+      .vtxsize = vs->vtxouts, .rhw_pres = fsv->uses_w, .tsp_unclamped_z_pres = fsv->uses_z,
+      .psprite_size_pres = true,
+   };
+   struct pvr_region_clip clip;
+   pvr_region_clip_from_rect(0, 0, d->rt_w, d->rt_h, 16, &clip);
+   pvr_csb_init(&block, ta, 256, 0);
+   if (!pvr_csb_emit_ta_state_header(&block, &pres) ||
+       !pvr_csb_emit_ta_ispctl(&block, NULL, true, &ispctl) ||
+       !pvr_csb_emit_ta_isp_a(&block, &ispa) || !pvr_csb_emit_ta_isp_b(&block, &ispb) ||
+       !pvr_csb_emit_ta_isp_dbsc(&block, &dbsc) ||
+       !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_SHADER, fsv->pds_offset) ||
+       !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_TEXUNICODE, fu_dwords ? fu_code : 0) ||
+       /* Triangle merging off where the reference turns it off: no depth test and no write. */
+       !pvr_csb_emit_ta_pds_sizeinfo(&block, &pds_sizes,
+                                     ispa.dwritedisable && ispa.dcmpmode == ROGUE_TA_CMPMODE_ALWAYS,
+                                     0) ||
+       (coeff && !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_VARYING, fsv->coeff_offset)) ||
+       !pvr_csb_emit_ta_pds_base(&block, PVR_PDS_BASE_UNIFORMDATA, fu_dwords ? fu_data : 0) ||
+       !pvr_csb_emit_ta_region_clip(&block, &clip) || !pvr_csb_emit_ta_viewport(&block, &vp_off) ||
+       !pvr_csb_emit_ta_wclamp(&block, PVR_TA_WCLAMP_MIN_W) ||
+       !pvr_csb_emit_ta_output_sel(&block, &outsel) ||
+       !pvr_csb_emit_ta_varying(&block, &varying0, &varying1) ||
+       !pvr_csb_emit_ta_ppp_ctrl(&block, &ppp_ctrl) || !pvr_csb_emit_ta_stream_out(&block) ||
+       block.overflowed)
+      return false;
+
+   /* Indices: the draw's own, or a generated 0..count-1 list offset by start. */
+   uint64_t idx_addr;
+   enum ROGUE_VDMCTRL_INDEX_SIZE isize;
+   if (info->index_size) {
+      if (info->has_user_indices) {
+         void *p = arena_alloc(&d->gen, draws[0].count * info->index_size, 16, &idx_addr);
+         if (p == NULL)
+            return false;
+         memcpy(p, (const uint8_t *)info->index.user + draws[0].start * info->index_size,
+                draws[0].count * info->index_size);
+      } else {
+         draw_use(d, info->index.resource);
+         idx_addr = pvr_resource(info->index.resource)->dev_addr +
+                    (uint64_t)draws[0].start * info->index_size;
+      }
+      isize = info->index_size == 1 ? ROGUE_VDMCTRL_INDEX_SIZE_B8
+            : info->index_size == 2 ? ROGUE_VDMCTRL_INDEX_SIZE_B16
+                                    : ROGUE_VDMCTRL_INDEX_SIZE_B32;
+   } else if (draws[0].start == 0) {
+      /* No index buffer: the VDM generates 0..count-1 itself, as the reference draws. */
+      idx_addr = 0;
+      isize = ROGUE_VDMCTRL_INDEX_SIZE_B32;
+   } else {
+      uint32_t *p = arena_alloc(&d->gen, draws[0].count * 4, 16, &idx_addr);
+      if (p == NULL)
+         return false;
+      for (unsigned i = 0; i < draws[0].count; i++)
+         p[i] = draws[0].start + i;
+      isize = ROGUE_VDMCTRL_INDEX_SIZE_B32;
+   }
+
+   struct pvr_vdm_vs vdm_vs = {
+      .pds_data_addr = vdata,
+      .pds_code_addr = vcode,
+      .output_size = vs->vtxouts,
+      .usc_unified_bytes = vs->vtxins * 4,
+      .pds_temp_dwords = vtemps,
+      .pds_data_dwords = vdwords,
+   };
+   uint32_t vdm_words = 0;
+   pvr_vdm_cam_size(&scr->dev_info, vs->vtxouts, true, &vdm_vs.cam_size, &vdm_vs.max_instances);
+   if (!pvr_csb_emit_ppp_state(&d->ctrl, ta_addr, pvr_csb_size(&block) / 4) ||
+       (vu_dwords && !pvr_csb_emit_vdm_pds_state(&d->ctrl, vs->shareds, vu_data, vu_dwords,
+                                                  vu_code)) ||
+       !pvr_csb_emit_vdm_state(&d->ctrl, false, 0, &vdm_vs, &vdm_words) ||
+       !pvr_csb_emit_index_list(&d->ctrl, idx_addr, draws[0].count, instance_count, isize,
+                                topo) ||
+       pvr_csb_overflowed(&d->ctrl))
+      return false;
+   d->ndraws++;
+   return true;
+}
+
+bool
+pvr_draw_note_clear(struct pvr_context *ctx, const union pipe_color_union *color)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (ctx->fb.nr_cbufs == 0 || ctx->fb.cbufs[0].texture == NULL ||
+       !draw_format_ok(ctx->fb.cbufs[0].format))
+      return false;
+   if (d == NULL) {
+      ctx->draw = d = calloc(1, sizeof(struct pvr_draw_state));
+      if (d == NULL)
+         return false;
+   }
+   /* A clear after draws (or of another target) starts a new render. */
+   if (d->open && (d->ndraws || !draw_open_is_fb(ctx, d, ctx->fb.cbufs[0].texture)))
+      pvr_draw_flush(ctx);
+   if (!d->open && (!draw_init(ctx, d) ||
+                    !draw_open(ctx, d, ctx->fb.cbufs[0].texture, draw_fb_level(ctx),
+                               ctx->fb.width, ctx->fb.height, ctx->fb.zsbuf.texture)))
+      return false;
+   d->clear_valid = true;
+   d->clear_value = *color;
+   d->clear_color = draw_pack_color(ctx->fb.cbufs[0].format, color);
+   return true;
+}
+
+/* Records a depth clear for the open render (one a colour clear just opened). */
+bool
+pvr_draw_note_zclear(struct pvr_context *ctx, float depth)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (d == NULL || !d->open || d->ndraws != 0 || d->zs == NULL ||
+       d->zs != ctx->fb.zsbuf.texture)
+      return false;
+   d->zclear_valid = true;
+   d->zclear = depth;
+   return true;
+}
+
+/* Opens a render on the framebuffer for a clear, keeping one already open without draws. */
+static bool
+draw_open_fb(struct pvr_context *ctx)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (d == NULL) {
+      ctx->draw = d = calloc(1, sizeof(struct pvr_draw_state));
+      if (d == NULL)
+         return false;
+   }
+   struct pipe_resource *rt = draw_fb_target(ctx);
+   if (rt == NULL || !draw_format_ok(rt->format))
+      return false;
+   const unsigned level = draw_fb_level(ctx);
+   if (d->open && (d->ndraws != 0 || !draw_open_is_fb(ctx, d, rt)))
+      pvr_draw_flush(ctx);
+   return d->open ||
+          (draw_init(ctx, d) && draw_open(ctx, d, rt, level, ctx->fb.width, ctx->fb.height,
+                                    ctx->fb.zsbuf.texture));
+}
+
+bool
+pvr_draw_clear_depth(struct pvr_context *ctx, float depth)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (ctx->fb.zsbuf.texture == NULL || draw_zls_format(ctx->fb.zsbuf.texture->format) < 0 ||
+       !draw_open_fb(ctx))
+      return false;
+   d = ctx->draw;
+   if (d->zs != ctx->fb.zsbuf.texture)
+      return false;
+   d->zclear_valid = true;
+   d->zclear = depth;
+   return true;
+}
+
+bool
+pvr_draw_blit(struct pvr_context *ctx, struct pipe_resource *dst, unsigned dst_level,
+              unsigned dst_layer, struct pipe_resource *src, unsigned src_level,
+              unsigned src_layer, bool gen)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   const uint32_t w = u_minify(dst->width0, dst_level), h = u_minify(dst->height0, dst_level);
+   if ((!gen && (w != u_minify(src->width0, src_level) || h != u_minify(src->height0, src_level))) ||
+       dst->format != src->format || !draw_format_ok(dst->format))
+      return false;
+   pvr_draw_flush(ctx);
+   if (d == NULL) {
+      ctx->draw = d = calloc(1, sizeof(struct pvr_draw_state));
+      if (d == NULL)
+         return false;
+   }
+   draw_materialize(ctx, src);
+   if (!draw_init(ctx, d) || !draw_open(ctx, d, dst, dst_level, w, h, NULL))
+      return false;
+   d->clear_valid = false; /* a deferred clear of dst is overwritten */
+   d->rt_layer = dst_layer;
+   d->load_src_layer = src_layer;
+   draw_use(d, src);
+   pipe_resource_reference(&d->load_src, src);
+   d->load_src_level = src_level;
+   d->load_gen = gen;
+   pvr_draw_flush(ctx);
+   return true;
+}
+
+void
+pvr_draw_resource_materialize(struct pvr_context *ctx, struct pvr_resource *res)
+{
+   draw_materialize(ctx, &res->base);
+}
+
+void
+pvr_draw_resource_sync(struct pvr_context *ctx, struct pvr_resource *res)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   if (res->clear_pending || res->zclear_pending)
+      draw_materialize(ctx, &res->base);
+   if (d == NULL || res->render_seq == 0)
+      return;
+   if (d->open && res->render_seq == d->seq)
+      pvr_draw_flush(ctx);
+   for (unsigned i = 0; i < PVR_DRAW_SLOTS; i++) {
+      if (d->slots[i].sync != 0 && d->slots[i].seq == res->render_seq)
+         draw_slot_idle(draw_screen(ctx), &d->slots[i]);
+   }
+}
+
+uint32_t
+pvr_draw_last_sync(struct pvr_context *ctx)
+{
+   struct pvr_draw_state *d = ctx->draw;
+   uint32_t best = 0, seq = 0;
+   for (unsigned i = 0; d != NULL && i < PVR_DRAW_SLOTS; i++) {
+      if (d->slots[i].sync != 0 && d->slots[i].seq >= seq) {
+         best = d->slots[i].sync;
+         seq = d->slots[i].seq;
+      }
+   }
+   return best;
+}
+
+void
+pvr_draw_flush(struct pvr_context *ctx)
+{
+   struct pvr_screen *scr = draw_screen(ctx);
+   struct pvr_draw_state *d = ctx->draw;
+   if (d == NULL || !d->open)
+      return;
+   d->open = false;
+   /* A recorded clear is a render even without draws: it is the only place the clear happens. */
+   if (d->ndraws == 0 && !d->clear_valid && d->load_src == NULL && !d->zclear_valid)
+      goto done;
+   /* A render that only clears is not submitted: the clear waits on the resources for the next
+    * render into them (or for a reader, draw_materialize). Apps clear the window, render an
+    * offscreen pass, then come back: that was a full clear render plus a full load render.
+    * Not for buffers other processes read. */
+   {
+      const unsigned shared = PIPE_BIND_SHARED | PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_SCANOUT;
+      if (d->ndraws == 0 && d->load_src == NULL && !d->no_defer && d->rt_level == 0 &&
+          ctx->fb.nr_cbufs <= 1 && !(d->rt->bind & shared)) {
+         if (d->clear_valid) {
+            pvr_resource(d->rt)->clear_pending = true;
+            pvr_resource(d->rt)->clear_color = d->clear_color;
+            pvr_resource(d->rt)->clear_value = d->clear_value;
+         }
+         if (d->zclear_valid && d->zs) {
+            pvr_resource(d->zs)->zclear_pending = true;
+            pvr_resource(d->zs)->zclear = d->zclear;
+         }
+         goto done;
+      }
+   }
+
+   struct pvr_resource *rt = pvr_resource(d->rt);
+   const enum pipe_format fmt = d->rt->format;
+   uint64_t term_addr = 0, sc_addr = 0;
+   uint32_t *term = arena_alloc(&d->gen, 64, 64, &term_addr);
+   uint32_t *sc = arena_alloc(&d->gen, 16, 16, &sc_addr);
+   if (term == NULL || sc == NULL)
+      goto done;
+
+   /* Terminate block and stream end. */
+   {
+      struct pvr_csb tb;
+      const struct pvr_ta_presence tpres = { .terminate = true };
+      struct pvr_region_clip tclip;
+      pvr_region_clip_from_rect(0, 0, d->rt_w, d->rt_h, 32, &tclip);
+      const struct ROGUE_TA_STATE_TERMINATE0 t0 = {
+         .clip_right = tclip.right, .clip_top = tclip.top, .clip_bottom = tclip.bottom,
+      };
+      const struct ROGUE_TA_STATE_TERMINATE1 t1 = { .clip_left = tclip.left, .render_target = 0 };
+      pvr_csb_init(&tb, term, 64, 0);
+      if (!pvr_csb_emit_ta_state_header(&tb, &tpres) || !pvr_csb_emit_ta_terminate(&tb, &t0, &t1) ||
+          !pvr_csb_emit_ppp_state(&d->ctrl, term_addr, pvr_csb_size(&tb) / 4) ||
+          !pvr_csb_emit_stream_terminate(&d->ctrl) || pvr_csb_overflowed(&d->ctrl))
+         goto done;
+   }
+   /* One full-target scissor rectangle (IPF SCISSOR_WORD_0/1). */
+   sc[0] = d->rt_w;
+   sc[1] = d->rt_h;
+
+   /* Depth-only framebuffer (shadow's depth pass): the colour target is a scratch one, so the
+    * PBE must drop all colour writes instead of clearing/storing a full extra target. */
+   const bool zonly = ctx->fb.nr_cbufs == 0 && ctx->fb.zsbuf.texture != NULL;
+   /* MRT: every colour attachment of the framebuffer is written by its own PBE emit words in the
+    * EOT program. v1 requires them to share the first attachment's format (the background program
+    * emits a single pixel value); a mixed set falls back to attachment 0 with a warning. */
+   unsigned nr_attach = 1;
+   uint64_t eot_addrs[PVR_MAX_COLOR_ATTACHMENTS] = { 0 };
+   enum pipe_format eot_formats[PVR_MAX_COLOR_ATTACHMENTS] = { PIPE_FORMAT_NONE };
+   const unsigned nr_fb = MIN2(ctx->fb.nr_cbufs, PVR_MAX_COLOR_ATTACHMENTS);
+   /* MRT only when this render really is the framebuffer's: materialize/blit renders open the
+    * driver's own target (d->rt) while the context framebuffer state still names some other set. */
+   const bool fb_render =
+      !zonly && nr_fb > 1 && d->rt == ctx->fb.cbufs[0].texture &&
+      d->rt_level == ctx->fb.cbufs[0].level;
+   const uint64_t rt_addr = pvr_resource_level_addr_layer(rt, d->rt_level, d->rt_layer);
+   if (zonly) {
+      eot_addrs[0] = rt_addr;
+      eot_formats[0] = fmt;
+   } else {
+      eot_addrs[0] = rt_addr;
+      eot_formats[0] = fmt;
+      if (fb_render) {
+         nr_attach = nr_fb;
+         for (unsigned i = 1; i < nr_attach; i++) {
+            struct pvr_resource *ri = pvr_resource(ctx->fb.cbufs[i].texture);
+            eot_addrs[i] = pvr_resource_level_addr(ri, ctx->fb.cbufs[i].level);
+            eot_formats[i] = ctx->fb.cbufs[i].format;
+         }
+      }
+   }
+   /* Pixel-output dword layout: each attachment starts where the previous one's format ends (one
+    * dword for an 8-bit format, two for a 16F one). The fragment variant and the EOT's PBE
+    * source_pos are both built from this same layout. */
+   uint32_t start_dwords[PVR_MAX_COLOR_ATTACHMENTS] = { 0 };
+   uint32_t attach_dwords[PVR_MAX_COLOR_ATTACHMENTS] = { 0 };
+   unsigned total_dwords = 0;
+   for (unsigned i = 0; i < nr_attach; i++) {
+      attach_dwords[i] = pvr_pbe_output_dwords(eot_formats[i]);
+      start_dwords[i] = total_dwords;
+      total_dwords += attach_dwords[i];
+   }
+   const uint64_t eot = draw_eot_program(ctx, d, nr_attach, eot_addrs, eot_formats, start_dwords,
+                                         zonly);
+   /* The background clear writes the clear colour into every colour dword, packed with the PBE's
+    * source format for that attachment (linear half floats for an sRGB target, whose gamma bit then
+    * encodes them; logical channel order otherwise). */
+   uint32_t bg_words[PVR_MAX_COLOR_ATTACHMENTS * 2] = { 0 };
+   const unsigned bg_nwords = zonly ? 1 : total_dwords;
+   for (unsigned i = 0; !zonly && i < nr_attach; i++) {
+      if (!d->clear_valid)
+         continue;
+      const enum pipe_format pack_format = draw_pbe_pack_format(eot_formats[i]);
+      util_format_pack_rgba(pack_format, &bg_words[start_dwords[i]], d->clear_value.f, 1);
+   }
+   const uint64_t bg = draw_bg_program(ctx, d, bg_words, bg_nwords);
+   uint64_t pbe_words[PVR_MAX_COLOR_ATTACHMENTS * 3] = { 0 };
+   if (eot == 0 || bg == 0 || !pvr_csb_pbe_words(eot_formats[0], pvr_resource_level_stride(rt, d->rt_level),
+                                                 d->rt_w, d->rt_h,
+                                                 pvr_resource_level_phys_h(rt, d->rt_level),
+                                                 rt->twiddled, rt->fbc, pbe_words))
+      goto done;
+   for (unsigned i = 1; i < nr_attach; i++) {
+      struct pvr_resource *ri = pvr_resource(ctx->fb.cbufs[i].texture);
+      if (!pvr_csb_pbe_words(eot_formats[i], pvr_resource_level_stride(ri, ctx->fb.cbufs[i].level),
+                             d->rt_w, d->rt_h,
+                             pvr_resource_level_phys_h(ri, ctx->fb.cbufs[i].level),
+                             ri->twiddled, ri->fbc, &pbe_words[i * 3]))
+         goto done;
+   }
+   if (zonly)
+      memset(pbe_words, 0, sizeof(pbe_words)); /* reference z-only: zero PBE reg words */
+
+   _Alignas(8) uint8_t gstream[256];
+   _Alignas(8) uint8_t fstream[1024];
+   const uint32_t glen =
+      pvr_geom_static_stream(gstream, sizeof(gstream), d->ctrl_addr, d->bct_addr, true, 0, false,
+                             1, 0, PVR_HAS_QUIRK(&scr->dev_info, 49927));
+   const uint32_t flen =
+      pvr_frag_static_stream(fstream, sizeof(fstream), pbe_words, nr_attach, (uint32_t)eot, false);
+   if (glen == 0 || flen == 0)
+      goto done;
+   if (getenv("PVR_FRAG_LOG") != NULL) {
+      fprintf(stderr, "FRAG nr=%u eot=%" PRIu64 " bg=%" PRIu64 " flen=%u pbe=", nr_attach, eot, bg,
+              flen);
+      for (unsigned i = 0; i < nr_attach * 3; i++)
+         fprintf(stderr, "%016" PRIx64 ",", pbe_words[i]);
+      fprintf(stderr, " region:");
+      for (unsigned i = 14; i < 26; i++)
+         fprintf(stderr, " %08x", ((const uint32_t *)fstream)[i]);
+      fprintf(stderr, "\n");
+   }
+   uint64_t bgnd[3], pr_bgnd[3];
+   /* Without a clear, the background reloads what the target held. A depth-only render drops the
+    * colour writes anyway, so it uses the (cheap) clear background instead of a full-target load. */
+   if (d->clear_valid || zonly || !draw_load_program(ctx, d, bgnd))
+      pvr_csb_pds_bgnd_words((uint32_t)bg, (uint32_t)bg, (uint32_t)bg, 0, 0, 0, bgnd);
+   memcpy(pr_bgnd, bgnd, sizeof(bgnd));
+   pvr_frag_static_stream_fill_bgnd(fstream, sizeof(fstream), d->bct_addr, bgnd, pr_bgnd);
+   /* USC pixel-output width: the total colour dwords per pixel, rounded up to a power of two and
+    * clamped to the core minimum of two registers (the reference derives it the same way from
+    * hw_render->output_regs_count). The value sits in bits [0:1] of USC_PIXEL_OUTPUT_CTRL:
+    * 2REGISTERS = 0, 4REGISTERS = 1, 8REGISTERS = 2. */
+   /* The ISP/VDM tile pipeline configuration, from the device features and the kernel's runtime
+    * info (the reference's pvr_arch_setup_tiles_in_flight). The pixel-output width inside it is
+    * derived from the colour dwords this render writes. */
+   uint32_t usc_pixel_output_ctrl, isp_ctl;
+   pvr_setup_tiles_in_flight(&scr->dev_info, &scr->dev_runtime_info, total_dwords, false, 0,
+                             &isp_ctl, &usc_pixel_output_ctrl);
+   if (getenv("PVR_ISP_LOG") != NULL)
+      fprintf(stderr, "ISPCTL pixel=%08x isp=%08x total_dwords=%u\n", usc_pixel_output_ctrl,
+              isp_ctl, total_dwords);
+   pvr_frag_static_stream_set_isp(fstream, sizeof(fstream), usc_pixel_output_ctrl, isp_ctl,
+                                  0x00000201u);
+   uint32_t frag_flags = 0;
+   if (d->zs != NULL) {
+      const struct pvr_resource *zr = pvr_resource(d->zs);
+      const int zf = draw_zls_format(d->zs->format);
+      const float zc = d->zclear_valid ? d->zclear : 1.0f;
+      const uint32_t bgdepth = zf == ROGUE_CR_ZLS_FORMAT_TYPE_16BITINT ? _mesa_float_to_unorm(zc, 16)
+                             : zf == ROGUE_CR_ZLS_FORMAT_TYPE_24BITINT ? _mesa_float_to_unorm(zc, 24)
+                                                                       : fui(zc);
+      /* Load unless cleared this render; always store, for later renders and readers. For a
+       * twiddled depth buffer the ZLS stream carries the (power-of-two) surface extents and the
+       * layer size; the linear path keeps the buffer size it has always used. */
+      const uint32_t zwidth = zr->twiddled ? zr->phys_width : d->zs->width0;
+      const uint32_t zheight = zr->twiddled ? zr->phys_height : d->zs->height0;
+      const uint32_t zstride = zr->twiddled ? (uint32_t)((uint64_t)zr->stride * zr->phys_height)
+                                            : (uint32_t)zr->dev_size;
+      if (!pvr_frag_static_stream_set_zls(fstream, flen, &scr->dev_info, zf, zr->dev_addr,
+                                          zwidth, zheight, !d->zclear_valid, true,
+                                          bgdepth, zstride, zr->twiddled, zonly))
+         goto done;
+      frag_flags |= DRM_PVR_SUBMIT_JOB_FRAG_CMD_DEPTHBUFFER;
+   }
+   ((uint32_t *)fstream)[2] = (uint32_t)sc_addr; /* isp_scissor_base after the 2-dword header */
+   ((uint32_t *)fstream)[3] = (uint32_t)(sc_addr >> 32);
+
+   const bool submit_ok =
+      pvr_job_submit_render(&scr->vm, d->gctx.handle, gstream, glen, fstream, flen, d->cur_hwrt->dset, d->cur_hwrt->rt_data_idx, frag_flags,
+                              &d->slots[d->cur_slot].sync);
+   if (!submit_ok)
+      mesa_loge("pvr: draw: the render was not submitted (%u draws)", d->ndraws);
+   d->slots[d->cur_slot].seq = d->seq;
+   d->cur_hwrt->data_seq[d->cur_hwrt->rt_data_idx] = d->seq;
+   d->cur_hwrt->rt_data_idx ^= 1;
+
+done:
+   d->clear_valid = false;
+   d->zclear_valid = false;
+   pipe_resource_reference(&d->zs, NULL);
+   pipe_resource_reference(&d->load_src, NULL);
+   d->load_gen = false;
+   d->ndraws = 0;
+   pipe_resource_reference(&d->rt, NULL);
+}
+
+void
+pvr_draw_destroy(struct pvr_context *ctx)
+{
+   if (ctx->draw == NULL)
+      return;
+   pvr_draw_flush(ctx);
+   draw_idle(ctx, ctx->draw);
+   for (unsigned i = 0; i < PVR_DRAW_HWRT_CACHE; i++) {
+      if (ctx->draw->hwrt[i].dset != 0)
+         draw_hwrt_free(draw_screen(ctx), &ctx->draw->hwrt[i]);
+   }
+   draw_idle(ctx, ctx->draw);
+   for (unsigned i = 0; i < PVR_DRAW_SLOTS; i++)
+      free(ctx->draw->slots[i].refs);
+   pipe_resource_reference(&ctx->draw->scratch_rt, NULL);
+   pipe_resource_reference(&ctx->draw->black, NULL);
+   /* shortcut: the other GPU objects of the draw path are released with the VM at screen
+    * destruction. */
+   free(ctx->draw);
+   ctx->draw = NULL;
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_draw.h b/src/gallium/drivers/pvr_native/pvr_draw.h
new file mode 100644
index 00000000..e33a12e7
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_draw.h
@@ -0,0 +1,57 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The fixed-function draw path: GL draws go through the TA (geometry) and ISP/3D (fragment) stages.
+ * Draws accumulate into one control stream per render target; the render is submitted at flush,
+ * readback or target change. Unsupported state returns false so the caller can fall back.
+ */
+#ifndef PVR_DRAW_H
+#define PVR_DRAW_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "util/format/u_formats.h"
+
+struct pipe_resource;
+
+struct pvr_context;
+struct pipe_draw_info;
+struct pipe_draw_start_count_bias;
+union pipe_color_union;
+
+bool pvr_draw_3d(struct pvr_context *ctx, const struct pipe_draw_info *info,
+                 const struct pipe_draw_start_count_bias *draws, unsigned num_draws);
+/* Submit the open render, if any. */
+void pvr_draw_flush(struct pvr_context *ctx);
+/* A colour clear of cbuf 0: the next render's background object writes this colour. */
+bool pvr_draw_note_clear(struct pvr_context *ctx, const union pipe_color_union *color);
+void pvr_draw_destroy(struct pvr_context *ctx);
+
+/* A full depth clear of the framebuffer's depth buffer as the render's background depth, opening a
+ * render (that reloads the colour target) if none without draws is open. */
+bool pvr_draw_clear_depth(struct pvr_context *ctx, float depth);
+
+/* GPU copy of level src_level of src into level dst_level of dst (same format, colour target
+ * formats; same extent, or with gen the next smaller mip level, each pixel the 2x2 average): one
+ * render whose background reads src. Asynchronous; a CPU map of dst waits for it. */
+bool pvr_draw_blit(struct pvr_context *ctx, struct pipe_resource *dst, unsigned dst_level,
+                   unsigned dst_layer, struct pipe_resource *src, unsigned src_level,
+                   unsigned src_layer, bool gen);
+
+/* Records a full depth clear for the render a colour clear just opened; false if not possible. */
+bool pvr_draw_note_zclear(struct pvr_context *ctx, float depth);
+
+/* Before a CPU access: submits the open render if it uses the resource, then waits for the
+ * last render that used it. */
+struct pvr_resource;
+void pvr_draw_resource_sync(struct pvr_context *ctx, struct pvr_resource *res);
+/* Submits a deferred clear of the resource, if it has one (see draw_materialize). */
+void pvr_draw_resource_materialize(struct pvr_context *ctx, struct pvr_resource *res);
+
+/* The syncobj of the latest submitted render (0: none in flight). */
+uint32_t pvr_draw_last_sync(struct pvr_context *ctx);
+
+/* Whether a sampler view of this format has a texture state layout. */
+bool pvr_draw_texture_format_supported(enum pipe_format format);
+
+#endif /* PVR_DRAW_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_hwrt.c b/src/gallium/drivers/pvr_native/pvr_hwrt.c
new file mode 100644
index 00000000..51cf476f
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_hwrt.c
@@ -0,0 +1,91 @@
+/* Render-target sizing for a HWRT data set.
+ *
+ * This lives in its own translation unit on purpose: the hwdef helpers and the generated csbgen
+ * headers cannot both be included in one file - hwdef makes __pvr_address_type a struct and the
+ * generated packet code then fails to compile against it. pvr_vm.c reaches csbgen through pvr_static.h,
+ * so the device-description arithmetic has to sit where csbgen is absent.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "util/macros.h"
+#include "util/u_math.h"
+
+#include "common/pvr_device_info.h"
+#include "hwdef/rogue_hw_defs.h"
+#include "hwdef/rogue_hw_utils.h"
+
+#include "pvr_hwrt.h"
+
+/* The same formulas the working Vulkan driver uses: pvr_arch_rt_mtile_info_init,
+ * pvr_rt_get_tail_ptr_stride_size and pvr_rt_get_isp_region_size. Reused arithmetically rather than
+ * re-derived, because these numbers are what the hardware's tiling expects. */
+bool
+pvr_hwrt_sizes(const struct pvr_device_info *dev_info, uint32_t width, uint32_t height,
+               uint32_t samples, uint32_t layers, struct pvr_hwrt_sizes *out)
+{
+   const uint32_t tile_x = PVR_GET_FEATURE_VALUE(dev_info, tile_size_x, 1);
+   const uint32_t tile_y = PVR_GET_FEATURE_VALUE(dev_info, tile_size_y, 1);
+   const bool simple = PVR_HAS_FEATURE(dev_info, simple_internal_parameter_format);
+   const uint32_t spf_ver = PVR_GET_FEATURE_VALUE(dev_info, simple_parameter_format_version, 0);
+   uint32_t mtx = 0, mty = 0, mtile_x1, mtile_y1;
+   uint64_t rgn, tpc, max_mt;
+
+   (void)samples;
+
+   if (tile_x == 0 || tile_y == 0)
+      return false;
+
+   out->tile_size_x = tile_x;
+   out->tile_size_y = tile_y;
+   out->num_tiles_x = DIV_ROUND_UP(width, tile_x);
+   out->num_tiles_y = DIV_ROUND_UP(height, tile_y);
+
+   rogue_get_num_macrotiles_xy(dev_info, &mtx, &mty);
+   out->mtiles_x = mtx;
+   out->mtiles_y = mty;
+
+   if (simple) {
+      mtile_x1 = DIV_ROUND_UP(out->num_tiles_x, 8) * 2;
+      mtile_y1 = DIV_ROUND_UP(out->num_tiles_y, 8) * 2;
+   } else {
+      mtile_x1 = ALIGN_POT(DIV_ROUND_UP(out->num_tiles_x, 4), 4);
+      mtile_y1 = ALIGN_POT(DIV_ROUND_UP(out->num_tiles_y, 4), 4);
+   }
+   out->tiles_per_mtile_x = mtile_x1;
+   out->tiles_per_mtile_y = mtile_y1;
+
+   rgn = (uint64_t)mtile_x1 * mtile_y1;
+   if (simple) {
+      rgn *= (uint64_t)mtx * mty;
+      if (spf_ver == 2)
+         rgn /= 4;
+   } else {
+      rgn = DIV_ROUND_UP(rgn * rogue_get_region_header_size(dev_info), 4);
+   }
+   out->region_header_size = rgn;
+   /* The TA writes a region header of rogue_get_region_header_size() dwords per tile group (one
+    * group per 2x2 tiles with the version-2 simple format) over the whole macrotile grid. Sizing
+    * the buffer with the region count alone (or the reference's count times the dword count, as
+    * bytes) only fits while the page rounding absorbs it: renders of 32x32 tiles and more (e.g.
+    * 1024x1024) lost every tile. */
+   {
+      const uint32_t group = simple && spf_ver == 2 ? 2 : 1;
+      const uint64_t groups = (uint64_t)(mtx * mtile_x1 / group) * (mty * mtile_y1 / group);
+      out->region_headers_bytes = ALIGN_POT(groups * rogue_get_region_header_size(dev_info) * 4, 64);
+   }
+
+   max_mt = MAX2(util_next_power_of_two64((uint64_t)mtx * mtile_x1),
+                 util_next_power_of_two64((uint64_t)mty * mtile_y1));
+   tpc = max_mt * max_mt * ROGUE_TAIL_POINTER_SIZE;
+   if (simple && spf_ver == 2)
+      tpc /= 4;
+   /* No minimum clamp: the reference's 512x512 tail-pointer cache is 2048 bytes on this device,
+    * and inflating it changes a size the kernel and firmware both derive from the device. */
+   tpc = ALIGN_POT(tpc, ROGUE_TE_TPC_CACHE_LINE_SIZE);
+   out->tpc_size = tpc;
+   out->tpc_stride = (layers > 1) ? (uint32_t)(tpc / ROGUE_BIF_PM_PHYSICAL_PAGE_SIZE) : 0;
+   out->simple_parameter_format = simple;
+   out->simple_parameter_format_version = spf_ver;
+   return true;
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_hwrt.h b/src/gallium/drivers/pvr_native/pvr_hwrt.h
new file mode 100644
index 00000000..7c2fb328
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_hwrt.h
@@ -0,0 +1,26 @@
+#ifndef PVR_HWRT_H
+#define PVR_HWRT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct pvr_device_info;
+
+/* Render-target sizes for a HWRT data set, computed from the device description. */
+struct pvr_hwrt_sizes {
+   uint32_t tile_size_x, tile_size_y;
+   uint32_t num_tiles_x, num_tiles_y;
+   uint32_t mtiles_x, mtiles_y;
+   uint32_t tiles_per_mtile_x, tiles_per_mtile_y;
+   uint64_t tpc_size;
+   uint32_t tpc_stride;
+   uint64_t region_header_size; /* the ISP region size the data set is created with */
+   uint64_t region_headers_bytes; /* the region header buffer of one RT data */
+   bool simple_parameter_format;
+   uint32_t simple_parameter_format_version;
+};
+
+bool pvr_hwrt_sizes(const struct pvr_device_info *dev_info, uint32_t width, uint32_t height,
+                    uint32_t samples, uint32_t layers, struct pvr_hwrt_sizes *out);
+
+#endif /* PVR_HWRT_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_probe.c b/src/gallium/drivers/pvr_native/pvr_probe.c
new file mode 100644
index 00000000..0d1e98e6
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_probe.c
@@ -0,0 +1,6399 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The runnable checks for the driver: enumerate the device, then prove the buffer
+ * object path actually works (create, map, write, read back, tear down).
+ *
+ * Enumeration needs no GPU - run it against the DRM shim:
+ *
+ *   PVR_SHIM_DEVICE_BVNC=36.56.104.183 \
+ *   LD_PRELOAD=build/src/imagination/drm-shim/libpowervr_noop_drm_shim.so \
+ *   build/src/gallium/drivers/pvr/pvr-probe
+ *
+ * The BO check needs the real open kernel module bound, because the shim does not
+ * implement CREATE_BO/GET_BO_MMAP_OFFSET. There it just runs against
+ * /dev/dri/renderD128 in an X-free window.
+ */
+#include <xf86drm.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "pvr_bo.h"
+#include "pvr_csb.h"
+#include "csbgen/rogue/cdm.h"
+#include "pvr_static.h"
+#include "pvr_context.h"
+
+#include "util/u_inlines.h"
+#include "pvr_screen.h"
+#include "pvr_shader.h"
+
+#include "compiler/spirv/nir_spirv.h"
+#include "nir_builder.h"
+#include "pds/pvr_pds.h"
+
+#include "pco/pco_data.h"
+#include "pco_uscgen_programs.h"
+#include "pvr_resource.h"
+#include "pvr_vm.h"
+#include "pvr_hwrt.h"
+#include "pvr_public.h"
+
+#include "pds/pvr_pds.h"
+#include "pipe/p_screen.h"
+#include "util/format/u_formats.h"
+
+/* Requests a deliberately unaligned size for one of the two so the round-up rule is
+ * exercised: the kernel rejects a size that is not a whole number of device pages
+ * rather than rounding it, so the driver has to do it. */
+#define BO_A_REQUESTED 1000
+#define BO_B_REQUESTED (64 * 1024)
+
+static bool
+bo_roundtrip(int fd)
+{
+   struct pvr_bo a = { 0 }, b = { 0 };
+   bool ok = false;
+
+   if (!pvr_bo_create(fd, BO_A_REQUESTED, 4096, &a) ||
+       !pvr_bo_create(fd, BO_B_REQUESTED, 4096, &b)) {
+      printf("bo:            FAIL: CREATE_BO failed\n");
+      goto out;
+   }
+
+   printf("bo:            created handles %u (%" PRIu64 " bytes, asked %d) and "
+          "%u (%" PRIu64 " bytes)\n",
+          a.handle, a.size, BO_A_REQUESTED, b.handle, b.size);
+
+   if (a.size % 4096 != 0 || a.size < BO_A_REQUESTED) {
+      printf("bo:            FAIL: size not rounded to a device page\n");
+      goto out;
+   }
+
+   if (!pvr_bo_map(fd, &a) || !pvr_bo_map(fd, &b)) {
+      printf("bo:            FAIL: could not map\n");
+      goto out;
+   }
+
+   /* A new object arrives zeroed (the kernel zeroes it on creation), which doubles as
+    * proof that the mapping really is this buffer and not some other window. */
+   for (uint64_t i = 0; i < a.size; i++) {
+      if (((uint8_t *)a.map)[i] != 0) {
+         printf("bo:            FAIL: object not zeroed at byte %" PRIu64 "\n", i);
+         goto out;
+      }
+   }
+
+   memset(a.map, 0xAA, a.size);
+   memset(b.map, 0x55, b.size);
+
+   /* Each mapping is verified over its OWN length - indexing one buffer with the
+    * other's size reads past the end of a smaller mapping, which is a bug in the test
+    * rather than in the driver. Verifying both after both writes still catches aliasing:
+    * if the mmap offsets were confused, b's 0x55 fill would have overwritten a's 0xAA. */
+   for (uint64_t i = 0; i < a.size; i++) {
+      if (((uint8_t *)a.map)[i] != 0xAA) {
+         printf("bo:            FAIL: buffer a wrong at byte %" PRIu64 " (aliased?)\n", i);
+         goto out;
+      }
+   }
+   for (uint64_t i = 0; i < b.size; i++) {
+      if (((uint8_t *)b.map)[i] != 0x55) {
+         printf("bo:            FAIL: buffer b wrong at byte %" PRIu64 " (aliased?)\n", i);
+         goto out;
+      }
+   }
+
+   ok = true;
+
+out:
+   pvr_bo_destroy(fd, &a);
+   pvr_bo_destroy(fd, &b);
+
+   printf("bo:            %s (create, map, read back, unmap, close)\n",
+          ok ? "PASS" : "FAIL");
+   return ok;
+}
+
+/* Allocate device addresses out of the general heap and map a buffer into the GPU's
+ * address space. This is the step that makes a buffer reachable by the GPU; none of
+ * it can be exercised without the real kernel module, because the shim does not
+ * implement the VM ioctls. */
+/* The compiled shaders, kept for the draw test: the fragment stage's PDS program and the TA state
+ * need the fragment shader's sizes and temps. */
+static struct pvr_shader *g_fs_shader;
+static struct pvr_shader *g_vs_shader;
+/* Warm the GPU up with a short synchronous compute draw so the following geometry kick is submitted
+ * while the GPU is powered/active (the reference client's first TA kick is preceded by device-activity
+ * KCCB traffic). Used only by the PVR_PROBE_GEOM_WARM diagnostic. */
+static void probe_gpu_warmup(struct pipe_screen *screen);
+
+/* Where each program was placed. USC offsets are relative to the USC heap base and are what DOUTU
+ * takes; PDS offsets are relative to the PDS heap base and are what the VDM/TA state takes - both
+ * heaps are addressed by offset, not by an arbitrary device address. */
+static uint32_t g_vs_usc_offset;
+static uint32_t g_fs_usc_offset;
+/* Round-42: create the extra context types the reference client has, optionally before the render
+ * context (the reference creates transfer/compute contexts first, its render context last). */
+static void
+probe_create_extra_contexts(int fd, uint32_t vm_context_handle, bool with_compute)
+{
+   struct drm_pvr_ioctl_create_context_args cargs = {
+      .type = DRM_PVR_CTX_TYPE_TRANSFER_FRAG,
+      .vm_context_handle = vm_context_handle,
+   };
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_CREATE_CONTEXT, &cargs) == 0)
+      printf("vm:            extra transfer context %u created\n", cargs.handle);
+   else
+      printf("vm:            extra transfer context FAILED: %s\n", strerror(errno));
+
+   if (with_compute) {
+      static uint64_t cstate[8] = { 64 };
+      struct drm_pvr_ioctl_create_context_args ccargs = {
+         .type = DRM_PVR_CTX_TYPE_COMPUTE,
+         .static_context_state = (uint64_t)(uintptr_t)cstate,
+         .static_context_state_len = sizeof(cstate),
+         .vm_context_handle = vm_context_handle,
+      };
+
+      if (drmIoctl(fd, DRM_IOCTL_PVR_CREATE_CONTEXT, &ccargs) == 0)
+         printf("vm:            extra compute context %u created\n", ccargs.handle);
+      else
+         printf("vm:            extra compute context FAILED: %s\n", strerror(errno));
+   }
+}
+
+static uint64_t g_vertex_prog_code_offset;
+static uint64_t g_vertex_prog_data_offset;
+static uint64_t g_fs_pds_base_offset;
+/* PDS-heap offset of the background-object program (PVR_PROBE_BG_COLOR), 0 = use the FS program. */
+static uint64_t g_bg_pds_base_offset;
+/* The vertex buffer's device address (three positions, 3 floats each). */
+static uint64_t g_vertex_data_addr;
+/* What the compiled vertex shader needs from the PDS vertex program: its temp count goes into the
+ * program's DOUTU control word, and the attribute DMA writes the vtxin registers the shader reads. */
+static unsigned g_vs_temps;
+static unsigned g_vs_vtxins;
+/* The varying registers the VS writes per vertex, and the attribute program's PDS sizes: the VDM
+ * state's STATE4/STATE5 and the TA's output-select vtxsize all take these. */
+static unsigned g_vs_vtxouts;
+static struct pvr_shader_vertex_program_info g_vertex_prog_info;
+static struct pvr_shader_pds_launcher_info g_fs_prog_info;
+
+/* Defined with the other placement helpers below, used by the draw test above them. */
+static uint64_t probe_place_eot_program(struct pvr_screen *scr, uint64_t rtaddr);
+
+static bool
+
+vm_roundtrip(int fd, struct pipe_screen *pscreen)
+{
+   struct pvr_screen *scr = pvr_screen(pscreen);
+   const struct pvr_device_info *dev_info = &scr->dev_info;
+   /* Everything this test allocates is referenced by jobs submitted below, and the firmware programs
+    * (PDS/USC) are named by heap offsets. They were placed in the SCREEN's VM context while the jobs
+    * ran in a freshly created one: the same device addresses, but mapped only in the other context,
+    * so the firmware reading its programs through the job's context found nothing. One VM context
+    * for the whole test - the same one the driver places its programs in. */
+   struct pvr_vm *vm = &scr->vm;
+   /* Jobs that exist only to interrogate the submission path (synthetic streams, liveness
+    * renders) are off by default: on the real driver an invalid one hangs the TA, the GPU locks
+    * up and every later submission in this process is discarded. The draw test must come first. */
+   const bool diag = getenv("PVR_PROBE_DIAGNOSTIC") != NULL;
+   const int pvm_fd_for_probe = fd;
+   struct pvr_bo a = { 0 }, b = { 0 };
+   uint64_t addr_a = 0, addr_b = 0, size = 0;
+   bool ok = false;
+
+   if (getenv("PVR_DUMP_HEAPS")) {
+      static const char *names[6] = { "general", "pds", "usc", "rgnhdr", "vis", "transfer" };
+      for (unsigned h = 0; h < 6; h++)
+         printf("HEAPS: %u %s base 0x%" PRIx64 " size 0x%" PRIx64 " usable_base 0x%"
+                PRIx64 " usable 0x%" PRIx64 " page %u\n", h, names[h],
+                vm->heaps[h].base, vm->heaps[h].size, vm->heaps[h].usable_base,
+                vm->heaps[h].usable_size, vm->heaps[h].page_size);
+   }
+   printf("vm:            general heap 0x%" PRIx64 "+%" PRIu64 " bytes, "
+          "carveout %" PRIu64 ", usable 0x%" PRIx64 "+%" PRIu64 ", page %u\n",
+          vm->general.base, vm->general.size, vm->general.base - vm->general.base +
+             (vm->general.size - vm->general.usable_size),
+          vm->general.usable_base, vm->general.usable_size, vm->general.page_size);
+
+   if (!pvr_bo_create(fd, 64 * 1024, 4096, &a))
+      goto out;
+   size = a.size;
+
+   addr_a = pvr_vm_alloc(vm, size, 4096);
+   addr_b = pvr_vm_alloc(vm, size, 4096);
+
+   if (addr_a == 0 || addr_b == 0) {
+      printf("vm:            FAIL: could not allocate a device address\n");
+      goto out;
+   }
+   if (addr_a == addr_b) {
+      printf("vm:            FAIL: the allocator handed out the same address twice\n");
+      goto out;
+   }
+
+   /* The address must lie inside the usable range and be page aligned - a heap base
+    * that was not added, or a carveout that was not subtracted, shows up right here. */
+   const uint64_t usable_end = vm->general.usable_base + vm->general.usable_size;
+   if (addr_a < vm->general.usable_base || addr_a + size > usable_end ||
+       addr_a % vm->general.page_size != 0) {
+      printf("vm:            FAIL: address 0x%" PRIx64 " outside usable range\n", addr_a);
+      goto out;
+   }
+
+   if (!pvr_vm_map(vm, addr_a, a.handle, size)) {
+      printf("vm:            FAIL: VM_MAP rejected the mapping\n");
+      goto out;
+   }
+
+   /* Round-trip the unmap before freeing, so a failure is attributable. */
+   if (!pvr_vm_unmap(vm, addr_a, size)) {
+      printf("vm:            FAIL: VM_UNMAP failed\n");
+      goto out;
+   }
+
+   /* The firmware areas, now kept rather than only summed. This cross-checks the parse:
+    * the carveout subtracted from the usable range and the sum of the general heap's
+    * areas reach the code by different routes, so if the areas are being read wrongly
+    * the two stop agreeing. The per-area sizes are what the kernel's table states. */
+   {
+      const struct drm_pvr_static_data_area *fence =
+         pvr_vm_static_area(vm, DRM_PVR_STATIC_DATA_AREA_FENCE, DRM_PVR_HEAP_GENERAL);
+      const struct drm_pvr_static_data_area *yuv =
+         pvr_vm_static_area(vm, DRM_PVR_STATIC_DATA_AREA_YUV_CSC, DRM_PVR_HEAP_GENERAL);
+      uint64_t area_total = 0;
+      const uint64_t carveout = vm->general.size - vm->general.usable_size;
+
+      for (unsigned i = 0; i < vm->nr_areas; i++) {
+         if (vm->areas[i].location_heap_id == DRM_PVR_HEAP_GENERAL)
+            area_total += vm->areas[i].size;
+      }
+
+      if (area_total != carveout || fence == NULL || yuv == NULL ||
+          fence->size != 128 || yuv->size != 1024) {
+         printf("vm:            FAIL: %u areas total %" PRIu64 " but carveout is %" PRIu64
+                " (fence %s, yuv %s)\n", vm->nr_areas, area_total, carveout,
+                fence ? "found" : "missing", yuv ? "found" : "missing");
+         goto out;
+      }
+
+      printf("vm:            %u firmware areas; fence %u bytes at +0x%" PRIx64
+             ", yuv csc %u bytes at +0x%" PRIx64 ", total %" PRIu64 " == carveout\n",
+             vm->nr_areas, fence->size, (uint64_t)fence->offset, yuv->size,
+             (uint64_t)yuv->offset, area_total);
+   }
+
+   /* The firmware carveouts, one per heap that has one. The general heap's holds the
+    * fence area and YUV CSC coefficients; the PDS and USC heaps' hold the sync and
+    * pixel-event programs, which is why the carveout mechanism cannot be general-heap
+    * only. Each is a single mapping: the areas are packed within a page and VM_MAP is
+    * page-granular, so per-area mappings overlap and the kernel rejects them. */
+   for (uint16_t heap_id = 0; heap_id < DRM_PVR_HEAP_COUNT; heap_id++) {
+      static const uint16_t usages[] = {
+         DRM_PVR_STATIC_DATA_AREA_EOT,
+         DRM_PVR_STATIC_DATA_AREA_FENCE,
+         DRM_PVR_STATIC_DATA_AREA_VDM_SYNC,
+         DRM_PVR_STATIC_DATA_AREA_YUV_CSC,
+      };
+      const struct pvr_heap *heap = &vm->heaps[heap_id];
+      struct pvr_bo carveout_bo = { 0 };
+      uint64_t carveout_base = 0;
+      unsigned nr_areas = 0;
+
+      if (heap->size == 0 || heap->size == heap->usable_size)
+         continue;
+
+      if (!pvr_vm_alloc_carveout(vm, heap_id, &carveout_bo, &carveout_base)) {
+         printf("vm:            FAIL: could not reserve the carveout of heap %u\n",
+                heap_id);
+         goto out;
+      }
+
+      if (carveout_base != heap->base) {
+         printf("vm:            FAIL: heap %u carveout at 0x%" PRIx64 ", base is "
+                "0x%" PRIx64 "\n", heap_id, carveout_base, heap->base);
+         pvr_vm_unmap(vm, carveout_base, carveout_bo.size);
+         pvr_bo_destroy(fd, &carveout_bo);
+         goto out;
+      }
+
+      for (unsigned u = 0; u < ARRAY_SIZE(usages); u++) {
+         const struct drm_pvr_static_data_area *area =
+            pvr_vm_static_area(vm, usages[u], heap_id);
+         uint64_t area_addr;
+
+         if (area == NULL)
+            continue;
+
+         area_addr = carveout_base + area->offset;
+
+         /* A structure the firmware will read must be inside the carveout the driver
+          * reserved, and must not reach past where ordinary allocations may begin. */
+         if (area_addr < carveout_base ||
+             area_addr + area->size > heap->usable_base) {
+            printf("vm:            FAIL: heap %u area %u at 0x%" PRIx64
+                   " is outside its carveout\n", heap_id, usages[u], area_addr);
+            pvr_vm_unmap(vm, carveout_base, carveout_bo.size);
+            pvr_bo_destroy(fd, &carveout_bo);
+            goto out;
+         }
+
+         nr_areas++;
+      }
+
+      /* The offsets the static context state will name, and a structural check on them:
+       * the areas must tile the carveout exactly. If they do not, either an area was
+       * missed or one was placed outside the region the driver reserved - and a
+       * firmware structure at the wrong address is read as something else, silently. */
+      {
+         const uint64_t carveout_size = heap->size - heap->usable_size;
+         uint64_t highest_end = 0;
+
+         for (unsigned u = 0; u < vm->nr_areas; u++) {
+            const struct drm_pvr_static_data_area *area = &vm->areas[u];
+
+            if (area->location_heap_id != heap_id)
+               continue;
+
+            highest_end = MAX2(highest_end, (uint64_t)area->offset + area->size);
+         }
+
+         if (highest_end != carveout_size) {
+            printf("vm:            FAIL: heap %u areas end at %" PRIu64
+                   ", carveout is %" PRIu64 "\n", heap_id, highest_end,
+                   carveout_size);
+            pvr_vm_unmap(vm, carveout_base, carveout_bo.size);
+            pvr_bo_destroy(fd, &carveout_bo);
+            goto out;
+         }
+
+         printf("vm:            heap %u carveout: %" PRIu64 " bytes, %u area(s) tiling "
+                "it exactly (eot %s, fence %s, vdm_sync %s, yuv_csc %s)\n",
+                heap_id, carveout_size, nr_areas,
+                vm->offsets[heap_id].eot == PVR_STATIC_ABSENT ? "absent" : "present",
+                vm->offsets[heap_id].fence == PVR_STATIC_ABSENT ? "absent" : "present",
+                vm->offsets[heap_id].vdm_sync == PVR_STATIC_ABSENT ? "absent" : "present",
+                vm->offsets[heap_id].yuv_csc == PVR_STATIC_ABSENT ? "absent" : "present");
+      }
+
+      /* The ordinary allocator must never hand out a carveout address, or an ordinary
+       * buffer would land on top of firmware state. */
+      if (heap_id == DRM_PVR_HEAP_GENERAL && addr_a < vm->general.usable_base) {
+         printf("vm:            FAIL: the ordinary allocator returned a carveout "
+                "address 0x%" PRIx64 "\n", addr_a);
+         pvr_vm_unmap(vm, carveout_base, carveout_bo.size);
+         pvr_bo_destroy(fd, &carveout_bo);
+         goto out;
+      }
+
+      pvr_vm_unmap(vm, carveout_base, carveout_bo.size);
+      pvr_bo_destroy(fd, &carveout_bo);
+   }
+
+   /* The firmware programs the GPU expects to already be in place. What matters is not
+    * that bytes were written but that they landed at the kernel's own addresses: a
+    * program at the wrong offset is executed as something else entirely. The strongest
+    * check available is therefore to compare the carveout contents against the source
+    * binary, which tests the placement rather than merely the write. */
+   {
+      /* The static firmware programs must live for as long as jobs do: the firmware runs the VDM
+       * sync program (PDS heap offset 0) and the pixel-event program from these carveouts on every
+       * job. Freeing them after the placement checks - which this did - leaves the firmware
+       * executing from unmapped memory: the BIF0 fault address is exactly the PDS heap base. Keep
+       * them mapped for the rest of the process (a real driver would place them at screen creation
+       * and never free them, which is what this stands in for). */
+      static struct pvr_static_memory sm;
+      const unsigned usc_slot = 2; /* GENERAL, PDS, USC as pvr_static_heaps orders them */
+      const pco_precomp_data *precomp =
+         (const pco_precomp_data *)pco_usclib_common[VS_NOP_COMMON];
+
+      if (!pvr_static_memory_init(vm, dev_info, &sm)) {
+         printf("vm:            FAIL: could not place the firmware programs\n");
+         goto out;
+      }
+
+      if (sm.program_bytes == 0) {
+         printf("vm:            FAIL: no firmware program bytes were written\n");
+         goto out;
+      }
+
+      if (precomp != NULL) {
+         const uint64_t usc_off = vm->offsets[DRM_PVR_HEAP_USC_CODE].vdm_sync;
+         const uint32_t bytes = precomp->size_dwords * sizeof(uint32_t);
+
+         if (usc_off == PVR_STATIC_ABSENT ||
+             memcmp((const uint8_t *)sm.map[usc_slot] + usc_off, precomp->binary,
+                    bytes) != 0) {
+            printf("vm:            FAIL: the VDM sync program is not at the USC heap's "
+                   "vdm_sync offset\n");
+            pvr_static_memory_fini(vm, &sm);
+            goto out;
+         }
+      }
+
+      /* The PDS launcher and the pixel-event program are generated, not copied, so they
+       * are checked for having been produced at all rather than compared byte-for-byte.
+       * A generator that silently wrote nothing would otherwise look like success. */
+      {
+         const uint64_t pds_sync = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].vdm_sync;
+         const uint64_t pds_eot = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].eot;
+         const uint8_t *pds_map = sm.map[1];
+         bool launcher = false, eot = false;
+
+         for (unsigned b = 0; b < 64; b++) {
+            if (pds_map[pds_sync + b] != 0)
+               launcher = true;
+            if (pds_map[pds_eot + b] != 0)
+               eot = true;
+         }
+
+         if (!launcher || !eot) {
+            printf("vm:            FAIL: a generated PDS program is empty (launcher %s, "
+                   "eot %s)\n", launcher ? "written" : "EMPTY",
+                   eot ? "written" : "EMPTY");
+            pvr_static_memory_fini(vm, &sm);
+            goto out;
+         }
+      }
+
+      if (getenv("PVR_DUMP_STATIC")) {
+         const uint64_t pds_sync = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].vdm_sync;
+         const uint64_t pds_eot = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].eot;
+         const uint64_t usc_sync = vm->offsets[DRM_PVR_HEAP_USC_CODE].vdm_sync;
+
+         printf("OURSTATIC: pds_vdm_sync at 0x%" PRIx64 ":", pds_sync);
+         for (unsigned i = 0; i < 128; i++)
+            printf(" %02x", ((const uint8_t *)sm.map[1])[pds_sync + i]);
+         printf("\nOURSTATIC: usc_vdm_sync at 0x%" PRIx64 ":", usc_sync);
+         for (unsigned i = 0; i < 128; i++)
+            printf(" %02x", ((const uint8_t *)sm.map[2])[usc_sync + i]);
+         printf("\nOURSTATIC: pds_eot at 0x%" PRIx64 ":", pds_eot);
+         for (unsigned i = 0; i < 128; i++)
+            printf(" %02x", ((const uint8_t *)sm.map[1])[pds_eot + i]);
+         printf("\n");
+      }
+      printf("vm:            firmware programs: VDM sync verified at the kernel's USC "
+             "vdm_sync offset, PDS launcher and pixel-event programs generated "
+             "(%u bytes counted)\n", sm.program_bytes);
+   }
+
+   /* A kernel GPU context - the handle every job is submitted against. This is the first
+    * component on the GPU path that asks the kernel to do something rather than preparing
+    * to: if CREATE_CONTEXT succeeds, the driver has a context the firmware and the kernel
+    * both accept, and the whole prerequisite chain is validated end to end. */
+   {
+      struct pvr_gpu_context gpu_ctx;
+
+      if (getenv("PVR_PROBE_EXTRA_CTXS_FIRST"))
+         probe_create_extra_contexts(pvm_fd_for_probe, vm->context_handle, true);
+
+      if (!pvr_gpu_context_create(vm, dev_info, &gpu_ctx)) {
+         printf("vm:            FAIL: CREATE_CONTEXT did not succeed\n");
+         goto out;
+      }
+
+      /* What is asserted is what the DRIVER is responsible for: the ioctl succeeded and
+       * the callstack is a real allocation. The handle's value is the kernel's to assign
+       * - and the DRM shim returns 0 for every kernel handle it hands out, so asserting
+       * on it here would fail against a shim while saying nothing about the driver. The
+       * real kernel's value is checked by observation in the verification run. */
+      if (gpu_ctx.callstack_addr == 0) {
+         printf("vm:            FAIL: no callstack address for the GPU context\n");
+   
+      pvr_gpu_context_destroy(vm, &gpu_ctx);
+         goto out;
+      }
+
+      /* The callstack is an ordinary allocation, so it must be inside the ordinary
+       * range and not in the carveout the firmware owns. */
+      if (gpu_ctx.callstack_addr < vm->general.usable_base) {
+         printf("vm:            FAIL: the VDM callstack landed in the firmware "
+                "carveout (0x%" PRIx64 ")\n", gpu_ctx.callstack_addr);
+         pvr_gpu_context_destroy(vm, &gpu_ctx);
+         goto out;
+      }
+
+      /* Context-switch support: the static context state must name the context-state buffers and
+       * carry real store/resume task programs. A context created without them is accepted by the
+       * kernel and its jobs never run; the state stream is where that is visible. */
+      {
+         uint8_t stream[192];
+         uint64_t *words = (uint64_t *)stream;
+         const uint32_t len =
+            pvr_static_context_state(stream, sizeof(stream), &gpu_ctx.cswitch);
+         struct ROGUE_CR_VDM_CONTEXT_STATE_BASE vdm_read = { 0 };
+         struct ROGUE_CR_TA_CONTEXT_STATE_BASE geom_read = { 0 };
+         bool ok_ctx = len == sizeof(stream) && words[0] == len;
+
+         if (ok_ctx) {
+            ROGUE_CR_VDM_CONTEXT_STATE_BASE_unpack(&words[1], &vdm_read);
+            ROGUE_CR_TA_CONTEXT_STATE_BASE_unpack(&words[3], &geom_read);
+            ok_ctx = vdm_read.addr == gpu_ctx.cswitch.vdm_state_addr &&
+                     geom_read.addr == gpu_ctx.cswitch.geom_state_addr;
+         }
+
+         /* The store/resume task words are the PDS programs; a group whose tasks are all zero is a
+          * context switch that saves nothing. Compare against the programs that were built rather
+          * than merely requiring non-zero. */
+         for (unsigned i = 0; ok_ctx && i < 2; i++) {
+            const struct pvr_ctx_switch_programs *p = &gpu_ctx.cswitch.programs[i];
+            struct ROGUE_CR_VDM_CONTEXT_STORE_TASK0 store0 = { 0 };
+            struct ROGUE_CR_VDM_CONTEXT_RESUME_TASK0 resume0 = { 0 };
+
+            ROGUE_CR_VDM_CONTEXT_STORE_TASK0_unpack(&words[4 + i * 10], &store0);
+            ROGUE_CR_VDM_CONTEXT_RESUME_TASK0_unpack(&words[9 + i * 10], &resume0);
+            ok_ctx = store0.pds_state0 != 0 && store0.pds_state1 != 0 &&
+                     resume0.pds_state0 != 0 && resume0.pds_state1 != 0 &&
+                     p->sr_store.data_dwords != 0 && p->sr_load.code_dwords != 0 &&
+                     p->pt_store.data_dwords != 0 && p->pt_resume.code_dwords != 0;
+         }
+
+         if (getenv("PVR_DUMP_CTX")) {
+            printf("OURCTX64: len=%u\n", len);
+            for (unsigned i = 0; i < len / 8; i++)
+               printf("OURCTX64: %2u: 0x%016" PRIx64 "\n", i, words[i]);
+         }
+
+         if (!ok_ctx) {
+            printf("vm:            FAIL: context-switch state is incomplete (len %u, VDM 0x%"
+                   PRIx64 ", GEOM 0x%" PRIx64 ")\n", len,
+                   (uint64_t)vdm_read.addr, (uint64_t)geom_read.addr);
+            pvr_gpu_context_destroy(vm, &gpu_ctx);
+            goto out;
+         }
+
+         printf("vm:            context switch: VDM/GEOM state buffers named, SR store/load and "
+                "PT store/resume PDS programs built, %u-byte static state\n", len);
+      }
+
+      if (getenv("PVR_PROBE_DELAY_MS")) {
+         const unsigned ms = (unsigned)strtoul(getenv("PVR_PROBE_DELAY_MS"), NULL, 0);
+
+         usleep(ms * 1000);
+         printf("vm:            waited %u ms after context creation before submitting\n", ms);
+      }
+
+      printf("vm:            sizes: drm_pvr_job=%zu obj_array=%zu hwrt_ref=%zu\n",
+             sizeof(struct drm_pvr_job), sizeof(struct drm_pvr_obj_array),
+             sizeof(struct drm_pvr_hwrt_data_ref));
+      if (getenv("PVR_PROBE_EXTRA_CTXS") && !getenv("PVR_PROBE_EXTRA_CTXS_FIRST"))
+         probe_create_extra_contexts(pvm_fd_for_probe, vm->context_handle, true);
+
+      printf("vm:            GPU context %u created: render type, callstack at 0x%"
+             PRIx64 "\n", gpu_ctx.handle, gpu_ctx.callstack_addr);
+
+      /* The submission path, exercised with a ZERO-LENGTH control stream.
+       *
+       * Deliberate: the GPU executes this stream, and a malformed one can hang the
+       * hardware rather than fail cleanly - on a board whose GPU has rebooted it before,
+       * that is not a risk worth taking to make a check look more thorough. A
+       * zero-length stream executes nothing, so what is being tested is exactly the part
+       * this round wrote: the job description and the ioctl. Whether the kernel accepts
+       * it, and what it says if not, is the result.
+       *
+       * A real submission needs the CSB content, which is the 5700-line piece this path
+       * is still building toward. */
+      /* Round-25: skipped by default. The reference clients never submit a zero-HWRT,
+       * zero-length job before real work, and this probe is meant to reproduce the reference
+       * submission as closely as possible. Set PVR_PROBE_EMPTY_SUBMIT to exercise it. */
+      if (!getenv("PVR_PROBE_EMPTY_SUBMIT")) {
+         printf("vm:            zero-length submission skipped (not what the reference does)\n");
+      } else {
+         struct pvr_bo csb_bo = { 0 };
+         uint64_t csb_addr = 0;
+
+         if (pvr_bo_create(pvm_fd_for_probe, 4096, 1, &csb_bo)) {
+            csb_addr = pvr_vm_alloc(vm, csb_bo.size, vm->general.page_size);
+
+            if (csb_addr != 0 &&
+                pvr_vm_map(vm, csb_addr, csb_bo.handle, csb_bo.size)) {
+               if (pvr_job_submit(vm, gpu_ctx.handle, DRM_PVR_JOB_TYPE_GEOMETRY,
+                                    NULL, 0, 0, 0)) {
+                  printf("vm:            SUBMIT_JOBS accepted a zero-length geometry "
+                         "job at 0x%" PRIx64 " - the submission path works\n",
+                         csb_addr);
+               } else {
+                  printf("vm:            SUBMIT_JOBS refused a zero-length job (see the "
+                         "error above for the kernel's reason)\n");
+               }
+               pvr_vm_unmap(vm, csb_addr, csb_bo.size);
+               pvr_vm_free(vm, csb_addr, csb_bo.size);
+            }
+            pvr_bo_destroy(pvm_fd_for_probe, &csb_bo);
+         }
+      }
+
+      uint32_t dset_handle = 0;
+
+      /* Sizes for the HWRT data set the kernel requires before it will accept a render job.
+       * Computed from the device description with the same formulas the working Vulkan driver uses. */
+      {
+         struct pvr_hwrt_sizes sz;
+         if (pvr_hwrt_sizes(dev_info, 512, 512, 1, 1, &sz)) {
+            printf("hwrt:          512x512: tiles %ux%u, mtiles %ux%u, tiles/mtile %ux%u, "
+                   "tpc %" PRIu64 " B stride %u, region headers %" PRIu64 " B, simple=%d v%u\n",
+                   sz.num_tiles_x, sz.num_tiles_y, sz.mtiles_x, sz.mtiles_y,
+                   sz.tiles_per_mtile_x, sz.tiles_per_mtile_y, sz.tpc_size, sz.tpc_stride,
+                   sz.region_header_size, sz.simple_parameter_format,
+                   sz.simple_parameter_format_version);
+         } else {
+            printf("vm:            FAIL: could not compute HWRT sizes\n");
+         }
+      }
+
+      /* Create the two free lists and the HWRT data set the kernel demands before it will accept a
+       * render job. Sizes follow the working driver's formulas for a single-sample, single-layer
+       * 512x512 target: vheap 384 entries x 4 B, no RTC (layers == 1), mlist one 4 KiB page. */
+      {
+         struct pvr_bo flbo[2] = { {0}, {0} }, tpcbo = {0}, vhbo = {0}, mlibo = {0}, mtabo = {0}, rgnbo = {0};
+         struct pvr_bo mli2 = {0}, mta2 = {0}, rgn2 = {0}, rtcbo = {0};
+         uint64_t fladdr[2] = {0}, tpcaddr = 0, vhaddr = 0, mliaddr = 0, mtaaddr = 0, rgnaddr = 0;
+         uint64_t mli2addr = 0, mta2addr = 0, rgn2addr = 0, rtcaddr = 0;
+         uint32_t flhandle[2] = {0};
+         bool okb = true;
+         /* Sizes from the device formulas and a capture of the reference's dataset for 512x512:
+          * tpc 2048 (probe rounds to a page), vheap 384 entries x 4 B, one region-header stride
+          * (1536 B) per render-target data set, no RTC and no macrotile array for one layer.
+          * The global free list needs room for its maximum page count (4 bytes per PM page): the
+          * reference grows it 2 MiB -> 256 MiB, so 65536 pages means a 256 KiB table. */
+         /* Kernel slot 0 is the LOCAL free list, slot 1 the GLOBAL one (firmware trace: "Load
+          * Freelist ... type: 0 (0:local,1:global)"). The local list only needs entries for its 32
+          * pages; the global list needs entries for its 65536-page maximum. */
+         const uint64_t sz[11] = { 4096, 65536 * 4, 4096, 1536, 4096, 4096, 4096, 4096, 4096, 4096, 256 };
+         /* Free-list size alignment, from the reference: entries must respect the SLC cache line,
+          * i.e. sizes are multiples of (max(base align, cache line)/4) * PM page size = 64 KiB. */
+         struct pvr_bo *bos[11] = { &flbo[0], &flbo[1], &tpcbo, &vhbo, &mlibo, &mtabo, &rgnbo, &mli2, &mta2, &rgn2, &rtcbo };
+         uint64_t *ads[11] = { &fladdr[0], &fladdr[1], &tpcaddr, &vhaddr, &mliaddr, &mtaaddr, &rgnaddr, &mli2addr, &mta2addr, &rgn2addr, &rtcaddr };
+
+         /* Device-only HWRT memory, with the same flags the reference gives it: the free lists and
+          * the PM mlist are PM_FW_PROTECT (the PM writes them; userspace must not), and the TPC,
+          * vheap, macrotile-array and region-header buffers need no CPU access at all
+          * (PVR_RT_DATA_BO_FLAGS is 0 in the reference). */
+         static const uint64_t hwrt_flags[11] = {
+            DRM_PVR_BO_PM_FW_PROTECT, DRM_PVR_BO_PM_FW_PROTECT, /* free lists */
+            0, 0,                                               /* tpc, vheap */
+            DRM_PVR_BO_PM_FW_PROTECT,                           /* pm mlist */
+            0, 0,                                               /* macrotile array, rgn headers */
+            DRM_PVR_BO_PM_FW_PROTECT,                           /* pm mlist 2 */
+            0, 0,                                               /* macrotile array 2, rgn headers 2 */
+            0,                                                  /* rtc */
+         };
+
+         for (unsigned i = 0; i < 11; i++) {
+            const uint64_t flags = hwrt_flags[i];
+            if (!pvr_bo_create_flags(pvm_fd_for_probe, sz[i], 1, flags, bos[i])) { okb = false; break; }
+            *ads[i] = pvr_vm_alloc(vm, bos[i]->size, vm->general.page_size);
+            if (!*ads[i] || !pvr_vm_map(vm, *ads[i], bos[i]->handle, bos[i]->size)) { okb = false; break; }
+         }
+
+         if (okb) {
+            uint32_t flmin = 0, flmax = 0;
+            /* The reference's free lists, for the same single-device case: a global table that
+             * starts at 2 MiB and grows 1 MiB at a time to 256 MiB (13% threshold), and a local
+             * table fixed at the runtime minimum. Ours were both 1024 pages with no growth, which
+             * the kernel accepts but is not a configuration the firmware is known to handle. */
+            const uint32_t global_initial_pages = 512;    /* 2 MiB */
+            const uint32_t global_max_pages = 65536;      /* 256 MiB */
+            const uint32_t global_grow_pages = 256;       /* 1 MiB */
+            /* The runtime minimum is 25 pages of 4 KiB, but free-list sizes are aligned to
+             * (cache_line/4) * PM page = 64 KiB, i.e. 32 pages, and the UAPI requires page counts
+             * to be multiples of 4. Using the raw 25 fails CREATE_FREE_LIST with EINVAL, which in
+             * turn makes every submit fail. */
+            const uint32_t local_pages =
+               (uint32_t)(ALIGN_POT(scr->dev_runtime_info.min_free_list_size, 65536) / 4096);
+
+            if (pvr_free_list_page_limits(pvm_fd_for_probe, &flmin, &flmax))
+               printf("hwrt:          device free-list limits: %u..%u pages, using global "
+                      "%u..%u grow %u, local %u\n", flmin, flmax, global_initial_pages,
+                      global_max_pages, global_grow_pages, local_pages);
+            /* UAPI: with grow_num_pages == 0 the initial count must equal the maximum (local). */
+            /* Round-44: the reference creates its device-wide (global) free list at device init,
+             * before the per-render-target (local) one; try that creation order too. */
+            if (getenv("PVR_PROBE_FL_GLOBAL_FIRST")) {
+               okb = flmin && local_pages >= flmin &&
+                     pvr_free_list_create(vm, fladdr[1], global_initial_pages, global_max_pages,
+                                          global_grow_pages, 13, &flhandle[1]) &&
+                     pvr_free_list_create(vm, fladdr[0], local_pages, local_pages, 0, 0,
+                                          &flhandle[0]);
+            } else {
+               okb = flmin && local_pages >= flmin &&
+                     pvr_free_list_create(vm, fladdr[0], local_pages, local_pages, 0, 0,
+                                          &flhandle[0]) &&
+                     pvr_free_list_create(vm, fladdr[1], global_initial_pages, global_max_pages,
+                                          global_grow_pages, 13, &flhandle[1]);
+            }
+            if (okb) {
+               struct pvr_hwrt_dataset_desc d = {
+                  .tpc_dev_addr = tpcaddr, .tpc_size = 2048, .tpc_stride = 0,
+                  /* Value for value what the reference's create_info carries for 512x512 on this
+                   * device: no RTC (one layer), no macrotile array, and ISP-merge registers left at
+                   * zero because the merge enhancement is absent. */
+                  .vheap_table_dev_addr = vhaddr, .rtc_dev_addr = 0,
+                  .pm_mlist_dev_addr = { mliaddr, mli2addr },
+                  .macrotile_array_dev_addr = { 0, 0 },
+                  .region_header_dev_addr = { rgnaddr, rgn2addr },
+                  .free_list_handles = { flhandle[0], flhandle[1] },
+                  .width = 512, .height = 512, .samples = 1, .layers = 1,
+                  .isp_merge_lower_x = 0, .isp_merge_lower_y = 0,
+                  .isp_merge_scale_x = 0, .isp_merge_scale_y = 0,
+                  .isp_merge_upper_x = 0, .isp_merge_upper_y = 0,
+                  .region_header_size = 256,
+               };
+               okb = pvr_hwrt_dataset_create(vm, &d, &dset_handle);
+               if (okb)
+                  printf("hwrt:          free lists %u/%u and HWRT data set %u CREATED for 512x512 - the "
+                         "kernel accepted the descriptions\n", flhandle[0], flhandle[1], dset_handle);
+            }
+         }
+         if (!okb)
+            printf("vm:            HWRT setup failed (the error above is the kernel's reason)\n");
+      }
+
+      /* A REAL geometry job. Three small BOs: the command stream itself, the ctrl stream the VDM
+       * writes into, and the border colour table the stream points at. Geometry only - no fragment
+       * job - so nothing references a render target yet. This asks the kernel whether the 40-byte
+       * stream is a valid job description; it is NOT a claim that the GPU can execute it, and the
+       * probe keeps those two answers separate. */
+      if (diag) {
+         struct pvr_bo rcsb = { 0 }, ctl = { 0 }, bct = { 0 };
+         uint64_t rcsb_addr = 0, ctl_addr = 0, bct_addr = 0;
+
+         if (!pvr_bo_create(pvm_fd_for_probe, 4096, 1, &rcsb)) {
+            printf("vm:            real job: could not create the command-stream BO\n");
+            goto real_job_done;
+         }
+         if (!pvr_bo_create(pvm_fd_for_probe, 4096, 1, &ctl)) {
+            printf("vm:            real job: could not create the ctrl-stream BO\n");
+            goto real_job_done;
+         }
+         if (!pvr_bo_create(pvm_fd_for_probe, 4096, 1, &bct)) {
+            printf("vm:            real job: could not create the border-colour-table BO\n");
+            goto real_job_done;
+         }
+         {
+            rcsb_addr = pvr_vm_alloc(vm, rcsb.size, vm->general.page_size);
+            ctl_addr = pvr_vm_alloc(vm, ctl.size, vm->general.page_size);
+            bct_addr = pvr_vm_alloc(vm, bct.size, vm->general.page_size);
+            if (!rcsb_addr || !ctl_addr || !bct_addr) {
+               printf("vm:            real job: address allocation failed (0x%" PRIx64 ", 0x%" PRIx64
+                      ", 0x%" PRIx64 ")\n", rcsb_addr, ctl_addr, bct_addr);
+            } else if (!pvr_vm_map(vm, rcsb_addr, rcsb.handle, rcsb.size) ||
+                       !pvr_vm_map(vm, ctl_addr, ctl.handle, ctl.size) ||
+                       !pvr_vm_map(vm, bct_addr, bct.handle, bct.size)) {
+               printf("vm:            real job: VM mapping failed\n");
+            } else if (!pvr_bo_map(pvm_fd_for_probe, &rcsb) ||
+                       !pvr_bo_map(pvm_fd_for_probe, &ctl)) {
+               printf("vm:            real job: CPU mapping of the command stream failed\n");
+            } else {
+               /* A geometry job's control stream must contain at least a STREAM_TERMINATE. A zeroed
+                * control stream makes the TA walk off the end and page-fault, which locks the GPU
+                * up and makes every later submission in this process be discarded - so a probe that
+                * submits one poisons all of its own subsequent tests. */
+               struct pvr_csb ctrl_csb;
+
+               pvr_csb_init(&ctrl_csb, ctl.map, ctl.size, PVR_CSB_LINK_DWORDS);
+               pvr_csb_emit_stream_terminate(&ctrl_csb);
+
+               /* geometry_terminate must be set: it is TE_PSG's completeonterminate bit, and
+                * without it a TA whose control stream ends in STREAM_TERMINATE waits for more work
+                * instead of completing. The firmware trace of the previous run shows exactly that -
+                * the TA kick times out with zero USC slots used, then the GPU locks up and every
+                * later submission is discarded. usc_common_size=1 is the capture's PDS_STATE0 value
+                * (0x20010000). */
+               const uint32_t gl = pvr_geom_static_stream(rcsb.map, rcsb.size, ctl_addr, bct_addr,
+                                                          true, 0, false, 1, 0,
+                                                          PVR_HAS_QUIRK(dev_info, 49927));
+               /* Only the length the stream declares is submitted. Sending longer lengths makes the
+                * kernel parse dwords beyond it as further commands, and a stream the firmware cannot
+                * execute page-faults the TA and locks the GPU up - every later submission in this
+                * process would then be discarded, so the probe must never submit speculative
+                * lengths before its real tests. */
+               /* (The captured 40-byte stream is NOT submitted: its CR_VDM_CTRL_STREAM_BASE is
+                * the reference driver's device address, unmapped in this VM context. Submitting it
+                * makes the TA page-fault and locks the GPU up, which is exactly what the captured
+                * stream's acceptance test used to do to every test after it.) */
+            }
+            if (bct_addr) { pvr_vm_unmap(vm, bct_addr, bct.size); pvr_vm_free(vm, bct_addr, bct.size); }
+            if (ctl_addr) { pvr_vm_unmap(vm, ctl_addr, ctl.size); pvr_vm_free(vm, ctl_addr, ctl.size); }
+            if (rcsb_addr) { pvr_vm_unmap(vm, rcsb_addr, rcsb.size); pvr_vm_free(vm, rcsb_addr, rcsb.size); }
+         }
+         pvr_bo_destroy(pvm_fd_for_probe, &bct);
+         pvr_bo_destroy(pvm_fd_for_probe, &ctl);
+         pvr_bo_destroy(pvm_fd_for_probe, &rcsb);
+      }
+real_job_done:
+      /* A full render submission: a real 512x512 RGBA8 render target, a PBE description for it, the
+       * fragment static stream carrying those PBE words, and both jobs (geometry + fragment) in ONE
+       * submit. Then read the target back. Any change at all means the GPU executed the stream; a
+       * clear in the right colour means the PBE description was right too. */
+      {
+         const uint32_t RTW = 512, RTH = 512;
+         struct pvr_bo rtbo = { 0 }, rtcsb = { 0 }, rctl = { 0 }, rbct = { 0 };
+         uint64_t rtaddr = 0, rctladdr = 0, rbctaddr = 0;
+         uint64_t eot_data_offset = 0;
+         const uint32_t isp_output_ctrl =
+            getenv("PVR_PROBE_ISP_OUTCTRL") ? strtoul(getenv("PVR_PROBE_ISP_OUTCTRL"), NULL, 0)
+                                            : 0x00007ff8u;
+         const uint32_t isp_ctl =
+            getenv("PVR_PROBE_ISP_CTL") ? strtoul(getenv("PVR_PROBE_ISP_CTL"), NULL, 0)
+                                        : 0x80035000u;
+         const uint32_t isp_event_info = 0x00000201u;
+         bool ok2 = true;
+
+         if (!pvr_bo_create(pvm_fd_for_probe, (uint64_t)RTW * RTH * 4, 1, &rtbo)) {
+            printf("hwrt:          RT BO create failed\n"); ok2 = false;
+         } else if (!pvr_bo_create(pvm_fd_for_probe, 4096, 1, &rtcsb) ||
+                    !pvr_bo_create(pvm_fd_for_probe, 4096, 1, &rctl) ||
+                    !pvr_bo_create(pvm_fd_for_probe, 4096, 1, &rbct)) {
+            printf("hwrt:          stream BO create failed\n"); ok2 = false;
+         }
+
+         if (ok2) {
+            /* The PBE encodes the target address in bits [0:31] and [34:39]: bits 32 and 33 have no
+             * field, so a target whose address sets either cannot be described at all. A 16 GiB
+             * alignment guarantees both are clear. */
+            rtaddr = pvr_vm_alloc(vm, rtbo.size,
+                                  getenv("PVR_PROBE_LOW_VA") ? vm->general.page_size
+                                                             : (1ULL << 34));
+            rctladdr = getenv("PVR_PROBE_FIXED_ADDRS")
+                          ? pvr_vm_alloc_at(vm, 0x80000c4000, rctl.size)
+                          : pvr_vm_alloc(vm, rctl.size, vm->general.page_size);
+            rbctaddr = pvr_vm_alloc(vm, rbct.size, vm->general.page_size);
+            printf("hwrt:          heap usable base 0x%" PRIx64 " size 0x%" PRIx64 "; RT 0x%" PRIx64
+                   " ctrl 0x%" PRIx64 " bct 0x%" PRIx64 "\n", vm->general.usable_base,
+                   vm->general.usable_size, rtaddr, rctladdr, rbctaddr);
+            if (!rtaddr || !rctladdr || !rbctaddr)
+               printf("hwrt:          VM alloc failed (0x%" PRIx64 ", 0x%" PRIx64 ", 0x%" PRIx64 ")\n",
+                      rtaddr, rctladdr, rbctaddr);
+            ok2 = rtaddr && rctladdr && rbctaddr &&
+                  pvr_vm_map(vm, rtaddr, rtbo.handle, rtbo.size) &&
+                  pvr_vm_map(vm, rctladdr, rctl.handle, rctl.size) &&
+                  pvr_vm_map(vm, rbctaddr, rbct.handle, rbct.size) &&
+                  pvr_bo_map(pvm_fd_for_probe, &rtbo) &&
+                  pvr_bo_map(pvm_fd_for_probe, &rtcsb) &&
+                  pvr_bo_map(pvm_fd_for_probe, &rctl);
+            if (!ok2)
+               printf("hwrt:          VM map or CPU map failed (rt 0x%" PRIx64 ")\n", rtaddr);
+         }
+
+         /* The per-job end-of-tile program. The fragment stream names it by PDS-heap offset; a
+          * hardcoded offset names whatever else happens to be there, and the fragment job then has
+          * no program that writes the render target at end of tile. */
+         if (ok2) {
+            eot_data_offset = probe_place_eot_program(scr, rtaddr);
+            if (eot_data_offset == 0) {
+               printf("hwrt:          FAIL: no end-of-tile program for the draw\n");
+               ok2 = false;
+            }
+         }
+
+         /* Firmware liveness check: a render whose control stream is only a STREAM_TERMINATE. It
+          * must complete before anything else can be trusted; keep it behind the diagnostic switch
+          * because it runs AFTER the draw (a terminating-only TA job is a guess at a minimal job,
+          * not something the reference is ever known to submit). */
+         if (ok2 && diag) {
+            struct pvr_bo dbo = { 0 }, dfw = { 0 };
+            uint64_t daddr = 0;
+            _Alignas(8) static uint8_t dfw_buf[1024];
+
+            (void)dfw;
+            if (pvr_bo_create(pvm_fd_for_probe, 4096, 1, &dbo) &&
+                (daddr = pvr_vm_alloc(vm, dbo.size, vm->general.page_size)) != 0 &&
+                pvr_vm_map(vm, daddr, dbo.handle, dbo.size) &&
+                pvr_bo_map(pvm_fd_for_probe, &dbo)) {
+               struct pvr_csb tcsb;
+               const uint32_t dlen =
+                  pvr_geom_static_stream(dfw_buf, sizeof(dfw_buf), daddr, rbctaddr, true, 0,
+                                         false, 1, 0, PVR_HAS_QUIRK(dev_info, 49927));
+               _Alignas(8) static uint8_t dfrag[1024];
+               static const uint64_t dpbe[3] = { 0x0200003c68800000ull, 0x0000001f0000001full, 0 };
+               const uint32_t dfrag_len = pvr_frag_static_stream(dfrag, sizeof(dfrag), dpbe, 1,
+                                                                 (uint32_t)eot_data_offset, false);
+               bool done;
+
+               pvr_csb_init(&tcsb, dbo.map, dbo.size, PVR_CSB_LINK_DWORDS);
+               pvr_csb_emit_stream_terminate(&tcsb);
+               done = dlen > 0 && dfrag_len > 0 &&
+                      pvr_job_submit_render(vm, gpu_ctx.handle, dfw_buf, dlen, dfrag,
+                                            dfrag_len, dset_handle, 0, 0, NULL);
+               printf("hwrt:          empty-control-stream render %s\n",
+                      done ? "COMPLETED" : "DID NOT complete in 2 s - the firmware is stalling "
+                                          "submissions, not the draw state");
+            } else {
+               printf("hwrt:          could not set up the liveness check\n");
+            }
+         }
+
+         if (ok2) {
+            uint64_t pbe_words[3] = { 0 };
+            uint8_t *rt = rtbo.map;
+            const uint32_t before = *(uint32_t *)rt;
+
+            /* Fill the target with a known pattern so any GPU write is visible. */
+            memset(rt, 0x5a, RTW * RTH * 4);
+
+            /* The three PBE register words per attachment the fragment stream must carry (layout,
+             * stride, swizzles, clip extents - the address and format live in the pixel-event
+             * program). They have to be built BEFORE the stream, and into their own buffer: building
+             * the stream over its own PBE source replaces the words with the stream header. */
+            if (!pvr_csb_pbe_words(PIPE_FORMAT_R8G8B8A8_UNORM, RTW * 4, RTW, RTH, RTH, false, false, pbe_words)) {
+               printf("hwrt:          could not encode the PBE words\n");
+               ok2 = false;
+            }
+
+            if (ok2) {
+               /* Assemble the draw stream with the shape the captured working draw has:
+                * PPP state block pointer -> VDM state -> index list -> terminate block -> STREAM
+                * TERMINATE. The TA state lives in a memory block, not in stream packets. */
+               {
+                  struct pvr_csb ctl_csb;
+                  struct pvr_bo ibo = { 0 }, pbo = { 0 }, tbo = { 0 };
+                  uint8_t *ta_map;
+                  uint64_t iaddr = 0, paddr = 0, taddr = 0;
+                  const uint16_t idx[3] = { 0, 1, 2 };
+                  uint32_t vdm_words = 0;
+                  bool okc = pvr_bo_create(pvm_fd_for_probe, 4096, 1, &ibo) &&
+                             (iaddr = pvr_vm_alloc(vm, ibo.size, vm->general.page_size)) != 0 &&
+                             pvr_vm_map(vm, iaddr, ibo.handle, ibo.size) &&
+                             pvr_bo_map(pvm_fd_for_probe, &ibo);
+
+                  if (!okc) {
+                     printf("hwrt:          could not set up the index buffer\n");
+                  } else {
+                     memcpy(ibo.map, idx, sizeof(idx));
+
+                     /* --- The TA state block (general heap; the PPP packet names it) --- */
+                     if (!pvr_bo_create(pvm_fd_for_probe, 4096, 1, &pbo) ||
+                         (paddr = getenv("PVR_PROBE_FIXED_ADDRS")
