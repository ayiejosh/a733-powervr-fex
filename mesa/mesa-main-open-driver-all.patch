+      .pres_ispctl = pres->ispctl,
+      .pres_ispctl_fa = pres->ispctl_fa,
+      .pres_ispctl_fb = pres->ispctl_fb,
+      .pres_ispctl_ba = pres->ispctl_ba,
+      .pres_ispctl_bb = pres->ispctl_bb,
+      .pres_ispctl_dbsc = pres->ispctl_dbsc,
+      .pres_pds_state_ptr0 = pres->pds_state_ptr0,
+      .pres_pds_state_ptr1 = pres->pds_state_ptr1,
+      .pres_pds_state_ptr3 = pres->pds_state_ptr3,
+      .pres_region_clip = pres->region_clip,
+      .pres_viewport = pres->viewport,
+      .pres_wclamp = pres->wclamp,
+      .pres_outselects = pres->outselects,
+      .pres_varying_word0 = pres->varying_words,
+      .pres_varying_word1 = pres->varying_words,
+      .pres_varying_word2 = pres->varying_words,
