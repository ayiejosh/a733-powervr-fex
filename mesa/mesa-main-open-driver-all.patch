+   if (stream0 != ppp_state->stream_out.so0 ||
+       stream1 != ppp_state->stream_out.so1 ||
+       stream2 != ppp_state->stream_out.so2) {
+      ppp_state->stream_out.so0 = stream0;
+      ppp_state->stream_out.so1 = stream1;
+      ppp_state->stream_out.so2 = stream2;
