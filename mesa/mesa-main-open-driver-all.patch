index 00000000..7cc49500
--- /dev/null
+++ b/src/imagination/pdsc/programs/pdsc_xfb_init.h
@@ -0,0 +1,173 @@
+/*
+ * Copyright © 2026 Imagination Technologies Ltd.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "common/pvr_iface.h"
+#include "pdsc/pdsc.h"
+#include "pdsc/pdsc_internal.h"
+#include "pvr_limits.h"
+#include "util/macros.h"
+
+#include <stdint.h>
+#include <stdio.h>
+
+static inline pdsc_program *pdsc_xfb_init_gen(void *mem_ctx,
+                                              enum pdsc_feature features)
+{
+   pdsc_program *p = pdsc_program_create(mem_ctx, features, "xfb_init");
+
+   pdsc_ref so_ptemps64[PVR_XFB_MAX_PTEMPS_SETS];
+   char buf[64];
+
+   ALLOC_CONST64(p, ptemps, PVR_XFB_INIT_PATCH_ID_PTEMP_LD_COUNT);
+
+   /* Allocate the ptemp buffers */
+   for (uint32_t i = 0; i < ARRAY_SIZE(so_ptemps64); i++) {
+      snprintf(buf, sizeof(buf), "so_ptemps64_%u", i * 2);
+      so_ptemps64[i] = pdsc_decl_ptemp64(p, buf, i * 2, true);
+   }
+
+   ALLOC_TEMP64(p, izero);
+   pdsc_limm(p, pdsc_ref_lo32(izero), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(izero), pdsc_ref_imm(0));
+
+   ALLOC_TEMP64(p, tzero);
+   pdsc_limm(p, pdsc_ref_lo32(tzero), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(tzero), pdsc_ref_imm(0));
+
+   ALLOC_TEMP64(p, temp_result);
+
+   ALLOC_TEMP32(p, cb_dword0);
+   ALLOC_CONST64(p,
+                 alignment_sel,
+                 PVR_XFB_INIT_PATCH_ID_COUNTER_BUFFER_DWORD_SELECT);
+   ALLOC_TEMP64(p, align_sel);
+
+   ALLOC_CONST64(p,
+                 counter_buffers_count,
+                 PVR_XFB_INIT_PATCH_ID_COUNTER_BUFFER_COUNT);
+
+   ALLOC_VAL_CONST64(p, const_one, 1);
+
+   ALLOC_TEMP64_ARRAY(p, counter_buffer, PVR_XFB_MAX_BUFFERS);
+   pdsc_ref counter_buffer_array[] = {
+      pdsc_ref_lo32(pdsc_ref_elem64(counter_buffer, 0)),
+      pdsc_ref_hi32(pdsc_ref_elem64(counter_buffer, 0)),
+      pdsc_ref_lo32(pdsc_ref_elem64(counter_buffer, 1)),
+      pdsc_ref_hi32(pdsc_ref_elem64(counter_buffer, 1)),
+      pdsc_ref_lo32(pdsc_ref_elem64(counter_buffer, 2)),
+      pdsc_ref_hi32(pdsc_ref_elem64(counter_buffer, 2)),
+      pdsc_ref_lo32(pdsc_ref_elem64(counter_buffer, 3)),
+      pdsc_ref_hi32(pdsc_ref_elem64(counter_buffer, 3)),
+   };
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(counter_buffer_array); i++)
+      pdsc_limm(p, counter_buffer_array[i], pdsc_ref_imm(0));
+
+   ALLOC_TEMP32_ARRAY(p, st_buffer, PVR_XFB_MAX_BUFFERS);
+   pdsc_ref st_buffer_array[] = {
+      pdsc_ref_elem32(st_buffer, 0),
+      pdsc_ref_elem32(st_buffer, 1),
+      pdsc_ref_elem32(st_buffer, 2),
+      pdsc_ref_elem32(st_buffer, 3),
+   };
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(st_buffer_array); i++)
+      pdsc_limm(p, pdsc_ref_elem32(st_buffer, i), pdsc_ref_imm(0));
+
+   /* Load ptemps per buffer */
+   for (uint32_t i = 0;
+        i < ARRAY_SIZE(so_ptemps64) / PVR_XFB_PTEMP_ENTRIES_PER_VARYING;
+        i++) {
+      pdsc_cmp(p, izero, ptemps, .cop = PDSC_COP_LT);
+      pdsc_setc(p, PDSC_PRED_P0);
+      pdsc_ld(p,
+              so_ptemps64[i * PVR_XFB_PTEMP_ENTRIES_PER_VARYING],
+              PVR_XFB_INIT_REF_ID_PTEMPS_LD_DEST_0 + i,
+              PVR_XFB_INIT_PATCH_ID_PTEMP_LD_SRC0_0 + i,
+              false,
+              .mods.cc = true);
+
+      pdsc_add64(p, izero, izero, const_one, .cc = true);
+   }
+   pdsc_wdf(p);
+
+   pdsc_instr_t cmp = pdsc_cmp(p, tzero, pdsc_ref_null(), .cop = PDSC_COP_NE);
+
+   pdsc_setc(p, PDSC_PRED_P0);
+   pdsc_instr_t ld = pdsc_ld(p,
+                             counter_buffer,
+                             PVR_XFB_INIT_REF_ID_COUNTER_BUFFER_LD_DEST,
+                             PVR_XFB_INIT_PATCH_ID_COUNTER_BUFFER_LD_SRC0,
+                             false,
+                             .mods.cc = true);
+   pdsc_src_set(p, cmp, 1, pdsc_src_get(p, ld, 0));
+   pdsc_wdf(p);
+
+   /* Apply counter buffer offsets to the SRC0 ptemp of each buffer group.
+    * With fixed stride-3 allocation, group i's SRC0 is always at
+    * ptemp64[i * PVR_XFB_PTEMP_ENTRIES_PER_VARYING].
+    *
+    * The counter buffer value is added to the buffer's SRC0 ptemp (address),
+    * advancing the write pointer by the number of bytes already written.
+    */
+   pdsc_mov64(p, align_sel, alignment_sel);
+   pdsc_stmc(p, PDSC_SOMASK_GLOBAL);
+
+   pdsc_limm(p, pdsc_ref_lo32(izero), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(izero), pdsc_ref_imm(0));
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(st_buffer_array); i++) {
+      /* Group i's SRC0 is at ptemp64[i * PVR_XFB_PTEMP_ENTRIES_PER_VARYING]
+       * (fixed stride-3 layout).
+       */
+      pdsc_ref ptemp64 = so_ptemps64[i * PVR_XFB_PTEMP_ENTRIES_PER_VARYING];
+
+      pdsc_cmp(p, align_sel, pdsc_ref_imm(0), .cop = PDSC_COP_EQ);
+      pdsc_setc(p, PDSC_PRED_P0);
+      pdsc_mov32(p, cb_dword0, counter_buffer_array[i]);
+
+      pdsc_cmp(p, align_sel, pdsc_ref_imm(1), .cop = PDSC_COP_EQ);
+      pdsc_setc(p, PDSC_PRED_P0);
+      pdsc_mov32(p, cb_dword0, counter_buffer_array[i + 1], .cc = true);
+
+      pdsc_cmp(p, align_sel, pdsc_ref_imm(2), .cop = PDSC_COP_EQ);
+      pdsc_setc(p, PDSC_PRED_P0);
+      pdsc_mov32(p, cb_dword0, counter_buffer_array[i + 2], .cc = true);
+
+      pdsc_cmp(p, align_sel, pdsc_ref_imm(3), .cop = PDSC_COP_EQ);
+      pdsc_setc(p, PDSC_PRED_P0);
+      pdsc_mov32(p, cb_dword0, counter_buffer_array[i + 3], .cc = true);
+
+      pdsc_cmp(p, izero, counter_buffers_count, .cop = PDSC_COP_LT);
+      pdsc_setc(p, PDSC_PRED_P0);
+
+      pdsc_mov32(p, st_buffer_array[i], cb_dword0, .cc = true);
+
+      pdsc_mov32(p, pdsc_ref_lo32(temp_result), cb_dword0, .cc = true);
+      pdsc_mov32(p, pdsc_ref_hi32(temp_result), pdsc_ref_imm(0), .cc = true);
+
+      pdsc_add64(p, temp_result, temp_result, ptemp64, .cc = true);
+      pdsc_mov64(p, ptemp64, temp_result, .cc = true);
+
+      pdsc_add64(p, izero, izero, const_one, .cc = true);
+   }
+
+   cmp = pdsc_cmp(p, tzero, pdsc_ref_null(), .cop = PDSC_COP_NE);
+
+   pdsc_setc(p, PDSC_PRED_P0);
+   pdsc_instr_t st = pdsc_st(p,
+                             st_buffer_array[0],
+                             PVR_XFB_INIT_REF_ID_COUNTER_BUFFER_ST_SRC0,
+                             PVR_XFB_INIT_PATCH_ID_COUNTER_BUFFER_ST_SRC0,
+                             false,
+                             .mods.cc = true);
+   pdsc_src_set(p, cmp, 1, pdsc_src_get(p, st, 0));
+   pdsc_wdf(p);
+
+   pdsc_halt(p);
+
+   return p;
+}
diff --git a/src/imagination/pdsc/programs/pdsc_xfb_main.h b/src/imagination/pdsc/programs/pdsc_xfb_main.h
new file mode 100644
index 00000000..33dff5e3
--- /dev/null
+++ b/src/imagination/pdsc/programs/pdsc_xfb_main.h
@@ -0,0 +1,135 @@
+/*
+ * Copyright © 2026 Imagination Technologies Ltd.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PDSC_XFB_MAIN_H
+#define PDSC_XFB_MAIN_H
+
+#include "common/pvr_iface.h"
+#include "pdsc/pdsc.h"
+#include "pdsc/pdsc_internal.h"
+#include "pdsc/pdsc_isa_pack.h"
+#include "pvr_limits.h"
+#include "util/macros.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdint.h>
+
+#define PVR_XFB_SRC3_EOP_BIT_HI32 BITFIELD_BIT(11)
+
+static inline pdsc_program *
+pdsc_xfb_main_runtime_gen(void *mem_ctx,
+                          enum pdsc_feature features,
+                          uint32_t group_count,
+                          const uint32_t *group_varying_counts)
+{
+   pdsc_program *p = pdsc_program_create(mem_ctx, features, "xfb_main");
+   char buf[64];
+
+   uint32_t total_varyings = 0;
+   for (uint32_t g = 0; g < group_count; g++)
+      total_varyings += group_varying_counts[g];
+
+   /* Ptemp declarations (stride-3 per group) */
+   pdsc_ref
+      stm_ptemps64[PVR_XFB_MAX_BUFFERS * PVR_XFB_PTEMP_ENTRIES_PER_VARYING];
+   const uint32_t total_ptemps = group_count * PVR_XFB_PTEMP_ENTRIES_PER_VARYING;
+   for (uint32_t i = 0; i < total_ptemps; i++) {
+      snprintf(buf, sizeof(buf), "stm_ptemps64__%u", i * 2);
+      stm_ptemps64[i] = pdsc_decl_ptemp64(p, buf, i * 2, true);
+   }
+
+   /* EOP mask: bit 43 of 64-bit SRC3 = bit 11 of hi32 */
+   ALLOC_TEMP64(p, eop_mask);
+   pdsc_limm(p, pdsc_ref_lo32(eop_mask), pdsc_ref_imm(0));
+   pdsc_limm(p,
+             pdsc_ref_hi32(eop_mask),
+             pdsc_ref_imm(PVR_XFB_SRC3_EOP_BIT_HI32));
+
+   /* Allocate SRC2 constants — flat sequential layout, one per varying */
+   assert(total_varyings <= PVR_XFB_MAX_TOTAL_VARYINGS);
+   pdsc_ref stm_consts[PVR_XFB_MAX_TOTAL_VARYINGS];
+   for (uint32_t i = 0; i < total_varyings; i++) {
+      snprintf(buf, sizeof(buf), "stm_src2_%u", i);
+      stm_consts[i] =
+         pdsc_alloc_const32(p,
+                            buf,
+                            PDSC_TYPE_IMM,
+                            PVR_XFB_MAIN_PATCH_ID_STM_SRC2_CONST_0 + i);
+   }
+
+   /* Emit STMs for each group */
+   uint32_t varying_idx = 0;
+   for (uint32_t g = 0; g < group_count; g++) {
+      uint32_t gvc = group_varying_counts[g];
+      if (gvc == 0)
+         continue;
+
+      uint32_t src0_idx = g * PVR_XFB_PTEMP_ENTRIES_PER_VARYING;
+      uint32_t src1_idx = g * PVR_XFB_PTEMP_ENTRIES_PER_VARYING + 1;
+      uint32_t src3_idx = g * PVR_XFB_PTEMP_ENTRIES_PER_VARYING + 2;
+
+      /* Non-EOP STMs: varyings 0..(gvc-2) */
+      for (uint32_t v = 0; v + 1 < gvc; v++) {
+         pdsc_stm(p,
+                  stm_ptemps64[src0_idx],
+                  stm_ptemps64[src1_idx],
+                  stm_consts[varying_idx],
+                  stm_ptemps64[src3_idx]);
+         varying_idx++;
+      }
+
+      /* Last varying: XOR to set EOP, STM, XOR to clear EOP */
+      pdsc_sftlp64(p,
+                   stm_ptemps64[src3_idx],
+                   stm_ptemps64[src3_idx],
+                   eop_mask,
+                   pdsc_ref_null(),
+                   .lop = PDSC_LOP_XOR);
+      pdsc_stm(p,
+               stm_ptemps64[src0_idx],
+               stm_ptemps64[src1_idx],
+               stm_consts[varying_idx],
+               stm_ptemps64[src3_idx]);
+      pdsc_sftlp64(p,
+                   stm_ptemps64[src3_idx],
+                   stm_ptemps64[src3_idx],
+                   eop_mask,
+                   pdsc_ref_null(),
+                   .lop = PDSC_LOP_XOR);
+      varying_idx++;
+   }
+
+   pdsc_halt(p);
+
+   pdsc_finalize_program(p);
+   pdsc_validate_program(p);
+   pdsc_encode_program(p);
+
+   return p;
+}
+
+static inline void pdsc_patch_xfb_main(pdsc_program *p,
+                                       uint32_t *data,
+                                       uint32_t varying_count,
+                                       const struct pdsc_stm_src2 *src2_values)
+{
+   pdsc_patch patches[PVR_XFB_MAX_TOTAL_VARYINGS];
+   assert(varying_count <= ARRAY_SIZE(patches));
+
+   for (uint32_t i = 0; i < varying_count; i++) {
+      patches[i] = (pdsc_patch){
+         .patch_id = PVR_XFB_MAIN_PATCH_ID_STM_SRC2_CONST_0 + i,
+         .value = pdsc_stm_src2_pack(p, &src2_values[i]),
+      };
+   }
+
+   pdsc_patch_program(p, varying_count, patches, data);
+}
+
+#undef PVR_XFB_SRC3_EOP_BIT_HI32
+
+#endif /* PDSC_XFB_MAIN_H */
diff --git a/src/imagination/pdsc/programs/pdsc_xfb_query_begin.h b/src/imagination/pdsc/programs/pdsc_xfb_query_begin.h
new file mode 100644
index 00000000..3dfbaa6d
--- /dev/null
+++ b/src/imagination/pdsc/programs/pdsc_xfb_query_begin.h
@@ -0,0 +1,82 @@
+/*
+ * Copyright © 2026 Imagination Technologies Ltd.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "common/pvr_iface.h"
+#include "pdsc/pdsc.h"
+#include "pdsc/pdsc_internal.h"
+#include "util/macros.h"
+
+#include <stdio.h>
+#include <stdint.h>
+
+static inline pdsc_program *pdsc_xfb_query_begin_gen(void *mem_ctx,
+                                                     enum pdsc_feature features)
+{
+   pdsc_program *p = pdsc_program_create(mem_ctx, features, "xfb_query_begin");
+
+   ALLOC_TEMP64(p, tzero);
+   pdsc_limm(p, pdsc_ref_lo32(tzero), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(tzero), pdsc_ref_imm(0));
+
+   ALLOC_CONST32(p,
+                 open_segment_scale,
+                 PVR_XFB_QUERY_BEGIN_PATCH_ID_OPEN_SEGMENT_SCALE);
+
+   ALLOC_TEMP32_ARRAY(p, result, 2);
+   ALLOC_TEMP64(p, scaled);
+
+   ALLOC_TEMP32(p, availability);
+   pdsc_limm(p, availability, pdsc_ref_imm(0));
+
+   char buf[64];
+   pdsc_ref stm_ptemps64[PVR_XFB_MAX_PTEMPS_SETS];
+   for (uint32_t i = 0; i < ARRAY_SIZE(stm_ptemps64); i++) {
+      snprintf(buf, sizeof(buf), "stm_ptemps64__%u", i * 2);
+      stm_ptemps64[i] = pdsc_decl_ptemp64(p, buf, i * 2, true);
+   }
+
+   /* Each transform feedback segment within the query is added to the result
+    * slot when it ends. If the query begins inside a segment, start from minus
+    * the counts already written in it, so that adding the whole segment leaves
+    * only what was written inside the query. The scale is -1 when a segment is
+    * open and 0 otherwise, so the result otherwise starts from zero.
+    */
+   const pdsc_ref seg_words[] = {
+      pdsc_ref_lo32(stm_ptemps64[1]),
+      pdsc_ref_hi32(stm_ptemps64[1]),
+   };
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(seg_words); i++) {
+      pdsc_mad(p, scaled, seg_words[i], open_segment_scale, tzero);
+      pdsc_mov32(p, pdsc_ref_elem32(result, i), pdsc_ref_lo32(scaled));
+   }
+
+   pdsc_instr_t cmp = pdsc_cmp(p, tzero, pdsc_ref_null(), .cop = PDSC_COP_NE);
+   pdsc_setc(p, PDSC_PRED_P0);
+   pdsc_instr_t st = pdsc_st(p,
+                             pdsc_ref_elem32(result, 0),
+                             PVR_XFB_QUERY_BEGIN_REF_ID_RESULT_ST_SRC0,
+                             PVR_XFB_QUERY_BEGIN_PATCH_ID_RESULT_ST_SRC0,
+                             false,
+                             .mods.cc = true);
+   pdsc_src_set(p, cmp, 1, pdsc_src_get(p, st, 0));
+   pdsc_wdf(p);
+
+   cmp = pdsc_cmp(p, tzero, pdsc_ref_null(), .cop = PDSC_COP_NE);
+   pdsc_setc(p, PDSC_PRED_P0);
+   st = pdsc_st(p,
+                availability,
+                PVR_XFB_QUERY_BEGIN_REF_ID_AVAILABILITY_ST_SRC0,
+                PVR_XFB_QUERY_BEGIN_PATCH_ID_AVAILABILITY_ST_SRC0,
+                false,
+                .mods.cc = true);
+   pdsc_src_set(p, cmp, 1, pdsc_src_get(p, st, 0));
+   pdsc_wdf(p);
+
+   pdsc_halt(p);
+
+   return p;
+}
diff --git a/src/imagination/pdsc/programs/pdsc_xfb_query_end.h b/src/imagination/pdsc/programs/pdsc_xfb_query_end.h
new file mode 100644
index 00000000..e44050d5
--- /dev/null
+++ b/src/imagination/pdsc/programs/pdsc_xfb_query_end.h
@@ -0,0 +1,103 @@
+/*
+ * Copyright © 2026 Imagination Technologies Ltd.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "common/pvr_iface.h"
+#include "pdsc/pdsc.h"
+#include "pdsc/pdsc_internal.h"
+#include "util/macros.h"
+
+#include <stdio.h>
+#include <stdint.h>
+
+static inline pdsc_program *pdsc_xfb_query_end_gen(void *mem_ctx,
+                                                   enum pdsc_feature features)
+{
+   pdsc_program *p = pdsc_program_create(mem_ctx, features, "xfb_query_end");
+
+   ALLOC_TEMP64(p, tzero);
+   pdsc_limm(p, pdsc_ref_lo32(tzero), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(tzero), pdsc_ref_imm(0));
+
+   ALLOC_TEMP32_ARRAY(p, result, 2);
+   pdsc_limm(p, pdsc_ref_elem32(result, 0), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_elem32(result, 1), pdsc_ref_imm(0));
+
+   ALLOC_TEMP32(p, availability);
+   pdsc_limm(p, availability, pdsc_ref_imm(1));
+
+   char buf[64];
+   pdsc_ref stm_ptemps64[PVR_XFB_MAX_PTEMPS_SETS];
+   for (uint32_t i = 0; i < ARRAY_SIZE(stm_ptemps64); i++) {
+      snprintf(buf, sizeof(buf), "stm_ptemps64__%u", i * 2);
+      stm_ptemps64[i] = pdsc_decl_ptemp64(p, buf, i * 2, true);
+   }
+
+   ALLOC_TEMP64(p, prev);
+   pdsc_limm(p, pdsc_ref_lo32(prev), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(prev), pdsc_ref_imm(0));
+
+   ALLOC_TEMP64(p, acc);
+   ALLOC_TEMP64(p, seg);
+
+   /* Load the counts accumulated so far; skipped when the patch is zero. */
+   pdsc_instr_t cmp = pdsc_cmp(p, tzero, pdsc_ref_null(), .cop = PDSC_COP_NE);
+   pdsc_setc(p, PDSC_PRED_P0);
+   pdsc_instr_t ld = pdsc_ld(p,
+                             prev,
+                             PVR_XFB_QUERY_END_REF_ID_QUERY_COUNT_LD_DEST,
+                             PVR_XFB_QUERY_END_PATCH_ID_QUERY_COUNT_LD_SRC0,
+                             false,
+                             .mods.cc = true);
+   pdsc_src_set(p, cmp, 1, pdsc_src_get(p, ld, 0));
+   pdsc_wdf(p);
+
+   /* Add this segment's counts. The two words are added separately so a carry
+    * from one cannot leak into the other.
+    */
+   const pdsc_ref prev_words[] = { pdsc_ref_lo32(prev), pdsc_ref_hi32(prev) };
+   const pdsc_ref seg_words[] = {
+      pdsc_ref_lo32(stm_ptemps64[1]),
+      pdsc_ref_hi32(stm_ptemps64[1]),
+   };
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(prev_words); i++) {
+      pdsc_mov32(p, pdsc_ref_lo32(acc), prev_words[i]);
+      pdsc_limm(p, pdsc_ref_hi32(acc), pdsc_ref_imm(0));
+      pdsc_mov32(p, pdsc_ref_lo32(seg), seg_words[i]);
+      pdsc_limm(p, pdsc_ref_hi32(seg), pdsc_ref_imm(0));
+
+      pdsc_add64(p, acc, acc, seg);
+      pdsc_mov32(p, pdsc_ref_elem32(result, i), pdsc_ref_lo32(acc));
+   }
+
+   /* Store both results to memory; skipped when the patch is zero. */
+   cmp = pdsc_cmp(p, tzero, pdsc_ref_null(), .cop = PDSC_COP_NE);
+   pdsc_setc(p, PDSC_PRED_P0);
+   pdsc_instr_t st = pdsc_st(p,
+                             pdsc_ref_elem32(result, 0),
+                             PVR_XFB_QUERY_END_REF_ID_RESULT_WRITTEN_ST_SRC0,
+                             PVR_XFB_QUERY_END_PATCH_ID_RESULT_WRITTEN_ST_SRC0,
+                             false,
+                             .mods.cc = true);
+   pdsc_src_set(p, cmp, 1, pdsc_src_get(p, st, 0));
+   pdsc_wdf(p);
+
+   /* Update availability */
+   cmp = pdsc_cmp(p, tzero, pdsc_ref_null(), .cop = PDSC_COP_NE);
+   pdsc_setc(p, PDSC_PRED_P0);
+   st = pdsc_st(p,
+                availability,
+                PVR_XFB_QUERY_END_REF_ID_AVAILABILITY_ST_SRC0,
+                PVR_XFB_QUERY_END_PATCH_ID_AVAILABILITY_ST_SRC0,
+                false,
+                .mods.cc = true);
+   pdsc_src_set(p, cmp, 1, pdsc_src_get(p, st, 0));
+   pdsc_wdf(p);
+
+   pdsc_halt(p);
+
+   return p;
+}
diff --git a/src/imagination/pdsc/programs/pdsc_xfb_vertex_count.h b/src/imagination/pdsc/programs/pdsc_xfb_vertex_count.h
new file mode 100644
index 00000000..010a22a3
--- /dev/null
+++ b/src/imagination/pdsc/programs/pdsc_xfb_vertex_count.h
@@ -0,0 +1,86 @@
+/*
+ * Copyright © 2026 Imagination Technologies Ltd.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "common/pvr_iface.h"
+#include "pdsc/pdsc.h"
+#include "pdsc/pdsc_internal.h"
+
+static inline pdsc_program *
+pdsc_xfb_vertex_count_gen(void *mem_ctx, enum pdsc_feature features)
+{
+   pdsc_program *p = pdsc_program_create(mem_ctx, features, "xfb_vertex_count");
+
+   ALLOC_CONST64(p,
+                 counter_offset,
+                 PVR_XFB_VERTEX_COUNT_PATCH_ID_NEGATIVE_COUNTER_OFFSET);
+   /* Reciprocal of vertex_stride patched as ceil(2^32 / stride) by the CPU.
+    * Used in the MAD-based multiply-high division below.
+    */
+   ALLOC_CONST32(p,
+                 vertex_stride_recip,
+                 PVR_XFB_VERTEX_COUNT_PATCH_ID_VERTEX_STRIDE_RECIP);
+   ALLOC_CONST32(p,
+                 instance_count,
+                 PVR_XFB_VERTEX_COUNT_PATCH_ID_INSTANCE_COUNT);
+   ALLOC_CONST32(p,
+                 first_instance,
+                 PVR_XFB_VERTEX_COUNT_PATCH_ID_FIRST_INSTANCE);
+
+   ALLOC_TEMP64(p, tzero);
+   pdsc_limm(p, pdsc_ref_lo32(tzero), pdsc_ref_imm(0));
+   pdsc_limm(p, pdsc_ref_hi32(tzero), pdsc_ref_imm(0));
+
+   ALLOC_TEMP64_ARRAY(p, counter_buffer_value, 1);
+   ALLOC_TEMP32_ARRAY(p, draw_params, 4);
+   ALLOC_TEMP64(p, working_temp);
+
+   pdsc_ld(p,
+           counter_buffer_value,
+           PVR_XFB_VERTEX_COUNT_REF_ID_COUNTER_BUFFER_LD_DEST,
+           PVR_XFB_VERTEX_COUNT_PATCH_ID_COUNTER_BUFFER_LD_SRC0,
+           false);
+   pdsc_wdf(p);
+
+   pdsc_cmp(p, tzero, counter_offset, .cop = PDSC_COP_NE);
+   pdsc_setc(p, PDSC_PRED_P0);
+   pdsc_add64(p,
+              counter_buffer_value,
+              counter_buffer_value,
+              counter_offset,
+              .cc = true,
+              .sna = true);
+
+   pdsc_mov32(p,
+              pdsc_ref_elem32(draw_params, 0),
+              pdsc_ref_lo32(counter_buffer_value));
+
+   /* Divide draw_params[0] (byte count) by vertex_stride using magic-number
+    * multiply: floor(n / stride) = hi32(n * ceil(2^32 / stride)).
+    * pdsc_idiv is not a real HW instruction; use MAD + hi32 instead.
+    * (same pattern as pdsc_xfb_end.h counter-stride multiplication)
+    */
+   pdsc_mad(p,
+            working_temp,
+            pdsc_ref_elem32(draw_params, 0),
+            vertex_stride_recip,
+            tzero);
+   pdsc_mov32(p, pdsc_ref_elem32(draw_params, 0), pdsc_ref_hi32(working_temp));
+
+   pdsc_mov32(p, pdsc_ref_elem32(draw_params, 1), instance_count);
+   pdsc_limm(p, pdsc_ref_elem32(draw_params, 2), pdsc_ref_imm(0));
+   pdsc_mov32(p, pdsc_ref_elem32(draw_params, 3), first_instance);
+
+   pdsc_st(p,
+           pdsc_ref_elem32(draw_params, 0),
+           PVR_XFB_VERTEX_COUNT_REF_ID_OUTPUT_COUNT_BUFFER_ST_SRC0,
+           PVR_XFB_VERTEX_COUNT_PATCH_ID_OUTPUT_COUNT_BUFFER_ST_SRC0,
+           false);
+   pdsc_wdf(p);
+
+   pdsc_halt(p);
+
+   return p;
+}
