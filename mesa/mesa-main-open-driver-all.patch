+bool
+pvr_csb_emit_ta_output_sel(struct pvr_csb *csb, const struct pvr_ta_output_sel *sel)
+{
+   struct ROGUE_TA_OUTPUT_SEL o = {
+      .vtxsize = sel->vtxsize,
+      .rhw_pres = sel->rhw_pres,
+      .tsp_unclamped_z_pres = sel->tsp_unclamped_z_pres,
+      .render_tgt_pres = sel->render_tgt_pres,
+      .vpt_tgt_pres = sel->vpt_tgt_pres,
+      .psprite_size_pres = sel->psprite_size_pres,
+      .isp_position_depth_clamp_z = sel->isp_position_depth_clamp_z,
+   };
+   uint32_t *dw;
+
+   for (unsigned i = 0; i < 8; i++) {
+      switch (i) {
+      case 0: o.plane0 = sel->plane[0]; o.cullplane0 = sel->cullplane[0]; break;
+      case 1: o.plane1 = sel->plane[1]; o.cullplane1 = sel->cullplane[1]; break;
+      case 2: o.plane2 = sel->plane[2]; o.cullplane2 = sel->cullplane[2]; break;
+      case 3: o.plane3 = sel->plane[3]; o.cullplane3 = sel->cullplane[3]; break;
+      case 4: o.plane4 = sel->plane[4]; o.cullplane4 = sel->cullplane[4]; break;
+      case 5: o.plane5 = sel->plane[5]; o.cullplane5 = sel->cullplane[5]; break;
+      case 6: o.plane6 = sel->plane[6]; o.cullplane6 = sel->cullplane[6]; break;
+      case 7: o.plane7 = sel->plane[7]; o.cullplane7 = sel->cullplane[7]; break;
+      }
+   }
+
+   dw = pvr_csb_emit(csb, ROGUE_TA_OUTPUT_SEL_length);
+   if (dw == NULL)
+      return false;
+
+   ROGUE_TA_OUTPUT_SEL_pack(dw, &o);
+
+   return true;
+}
+
+uint32_t
+pvr_pbe_linestride(uint32_t stride_px)
+{
+   /* The field counts pixels in units of two (pbestate.xml), like the Vulkan driver's
+    * pvr_stride_from_pitch() input; a byte stride spaces the rows bpp times too far apart. */
+   /* A zero stride would underflow into a huge value rather than fail - the same shape as the
+    * texture descriptor's zero-extent case. */
+   if (stride_px == 0) {
+      mesa_loge("pvr: PBE linestride from a zero stride");
+      return 0;
+   }
+
+   return (stride_px - 1) / ROGUE_PBESTATE_REG_WORD0_LINESTRIDE_UNIT_SIZE;
+}
+
+#define PVR_CMD_DW(x) ROGUE_##x##_length
+
+/* Header packets before the PBE block. requires_fb_cdc_zls is not consulted: this driver's device has not
+ * been asked for it, and emitting a packet the device does not want is worse than omitting one it does. */
+#define PVR_FRAG_PRE_PBE_DWORDS \
+   (PVR_CMD_DW(KMD_STREAM_HDR) + PVR_CMD_DW(CR_ISP_SCISSOR_BASE) + \
+    PVR_CMD_DW(CR_ISP_DBIAS_BASE) + PVR_CMD_DW(CR_ISP_OCLQRY_BASE) + \
+    PVR_CMD_DW(CR_ISP_ZLSCTL) + PVR_CMD_DW(CR_ISP_ZLOAD_BASE) + \
+    PVR_CMD_DW(CR_ISP_STENCIL_LOAD_BASE))
+
+/* Everything between the PBE block and CR_EVENT_PIXEL_PDS_DATA, in the reference's order. The first
+ * attempt had four packets here; the helper has thirteen - I read four lines of it and assumed that was
+ * the end. cluster_grouping is a parameter because this device's answer decides whether
+ * KMD_STREAM_PIXEL_PHANTOM is present, and the capture decides whether the guess is right. */
+#define PVR_FRAG_TAIL_DWORDS(cluster) \
+   (PVR_CMD_DW(CR_TPU_BORDER_COLOUR_TABLE_PDM) + ROGUE_NUM_CR_PDS_BGRND_WORDS * 2 + \
+    ROGUE_NUM_CR_PDS_BGRND_WORDS * 2 + \
+    ROGUE_KMD_STREAM_USC_CLEAR_REGISTER_COUNT * PVR_CMD_DW(CR_USC_CLEAR_REGISTER) + \
+    PVR_CMD_DW(CR_USC_PIXEL_OUTPUT_CTRL) + PVR_CMD_DW(CR_ISP_BGOBJDEPTH) + \
+    PVR_CMD_DW(CR_ISP_BGOBJVALS) + PVR_CMD_DW(CR_ISP_AA) + PVR_CMD_DW(CR_ISP_CTL) + \
+    PVR_CMD_DW(CR_EVENT_PIXEL_PDS_INFO) + \
+    ((cluster) ? PVR_CMD_DW(KMD_STREAM_PIXEL_PHANTOM) : 0u) + PVR_CMD_DW(KMD_STREAM_VIEW_IDX))
+
+uint32_t
+pvr_frag_static_stream(void *stream, uint32_t stream_size, const uint64_t *pbe_words,
+                       unsigned nr_attachments, uint32_t eot_pds_offset, bool cluster_grouping)
+{
+   /* Sized for the DEVICE MAXIMUM, as the reference does (`PVR_MAX_COLOR_ATTACHMENTS * ...`), not for the
+    * number of attachments in use - the stream length is therefore fixed per device rather than per target. The
+    * capture confirms it: its PBE words sit at byte 56, which is the pre-PBE packet sum, not a used-count-derived
+    * offset. `nr_attachments` only decides how many of those words the caller fills. */
+   const uint32_t pbe_dwords = PVR_MAX_COLOR_ATTACHMENTS * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
+   const uint32_t filled_dwords = nr_attachments * ROGUE_NUM_PBESTATE_REG_WORDS * 2;
+   const uint32_t tail_dwords = PVR_FRAG_TAIL_DWORDS(cluster_grouping);
+   /* PVR_FRAG_TAIL_DWORDS stops at KMD_STREAM_VIEW_IDX - the offset helper returns the point where the
+    * EOT packet is PACKED, not the end of the stream - so the EOT packet's own length has to be added
+    * for the total. Omitting it made the builder return one dword less than its own macros summed to,
+    * which is what round 78 mistook for a two-number disagreement. */
+   const uint32_t used_dwords = PVR_FRAG_PRE_PBE_DWORDS + pbe_dwords + tail_dwords +
+                                PVR_CMD_DW(CR_EVENT_PIXEL_PDS_DATA);
+   /* ponytail: pad the stream to a 32-byte boundary. The captured working stream is 384 bytes where the
+    * packets account for 368, i.e. four zero dwords of padding - so the emitted stream is aligned, not
+    * exactly the packet sum. INFERRED FROM ONE CAPTURE: one data point cannot distinguish "align to 32"
+    * from "align to 16 then add a fixed 16". A second capture with a different attachment count would
+    * settle it; until then this matches the only reference there is, and the check asserts the padding is
+    * zero rather than assuming it. */
+   const uint32_t total_dwords = ALIGN_POT(used_dwords, 8);
+   const uint32_t total_bytes = PVR_DW_TO_BYTES(total_dwords);
+   const uint32_t pbe_byte_off = PVR_DW_TO_BYTES(PVR_FRAG_PRE_PBE_DWORDS);
+   /* tail_dwords stops AT the EOT packet's slot (the offset helper returns where it is packed), so the
+    * packet goes immediately after the tail - subtracting the EOT length here, as the first version did,
+    * put it one packet early. */
+   const uint32_t eot_byte_off = pbe_byte_off + PVR_DW_TO_BYTES(pbe_dwords) +
+                                 PVR_DW_TO_BYTES(tail_dwords);
+   struct ROGUE_CR_EVENT_PIXEL_PDS_DATA eot = { .addr = eot_pds_offset };
+   uint32_t *dw = stream;
+
+   if (total_bytes > stream_size)
+      return 0;
+
+   memset(stream, 0, total_bytes);
+
+   /* First word: the stream's own length in bytes, as the capture shows. */
+   dw[0] = total_bytes;
+
+   if (filled_dwords > pbe_dwords)
+      return 0;
+
+   memcpy((uint8_t *)stream + pbe_byte_off, pbe_words, PVR_DW_TO_BYTES(filled_dwords));
+
+   ROGUE_CR_EVENT_PIXEL_PDS_DATA_pack((uint32_t *)((uint8_t *)stream + eot_byte_off), &eot);
+
+   return total_bytes;
+}
+
+uint32_t
+pvr_region_header_count(uint32_t width, uint32_t height, uint32_t tile_size_x,
+                        uint32_t tile_size_y, uint32_t samples_in_x,
+                        uint32_t samples_in_y, uint32_t mtiles_x, uint32_t mtiles_y)
+{
+   uint32_t num_tiles_x, num_tiles_y, mtile_x1, mtile_y1;
+
+   /* A zero tile size would divide by zero rather than fail; the caller gets its constants from
+    * device features, which default to 1 rather than 0, so this is a guard against a caller error
+    * rather than a hardware case. */
+   if (tile_size_x == 0 || tile_size_y == 0)
+      return 0;
+
+   num_tiles_x = DIV_ROUND_UP(width, tile_size_x);
+   num_tiles_y = DIV_ROUND_UP(height, tile_size_y);
+
+   /* Version-2 branch - the one this device takes, established in round 19 by the 6-dword region
+    * header size. */
+   mtile_x1 = DIV_ROUND_UP(num_tiles_x, 8) * 2;
+   mtile_y1 = DIV_ROUND_UP(num_tiles_y, 8) * 2;
+
+   return mtile_x1 * samples_in_x * mtile_y1 * samples_in_y * mtiles_x * mtiles_y / 4;
+}
+
+bool
+pvr_pbe_swizzles_from_pipe_format(enum pipe_format format,
+                                  enum ROGUE_PBESTATE_SWIZ out[4])
+{
+   struct pvr_format_layout layout;
+
+   if (!pvr_format_layout_from_pipe(format, &layout))
+      return false;
+
+   for (unsigned i = 0; i < 4; i++) {
+      if (!pvr_pbe_swizzle_from_pipe(layout.swizzle[i], &out[i])) {
+         mesa_loge("pvr: PBE swizzle for %s channel %u is not a selector the PBE takes",
+                   util_format_name(format), i);
+         return false;
+      }
+   }
+
+   return true;
+}
+
+bool
+pvr_pbe_target_from_format(enum pipe_format format, uint64_t addr, uint32_t mrt_index,
+                           bool with_packed_usc_channel, struct pvr_pbe_target *out)
+{
+   if (!pvr_pbe_swizzles_from_pipe_format(format, out->swizzle))
+      return false;
+
+   out->addr = addr;
+   out->mrt_index = mrt_index;
+   out->source_format = pvr_pbe_source_format_from_pipe(format, with_packed_usc_channel);
+
+   return true;
+}
+
+enum ROGUE_PBESTATE_SOURCE_FORMAT
+pvr_pbe_source_format_from_pipe(enum pipe_format format, bool with_packed_usc_channel)
+{
+   const struct util_format_description *desc = util_format_description(format);
+   const uint32_t chan_0_width = desc->channel[0].size;
+   bool has_32bit_channel = false;
+
+   for (unsigned i = 0; i < 4; i++) {
+      if (desc->channel[i].size == 32)
+         has_32bit_channel = true;
+   }
+
+   if (has_32bit_channel || util_format_is_pure_integer(format))
+      return ROGUE_PBESTATE_SOURCE_FORMAT_8_PER_CHANNEL;
+
+   if (util_format_is_float(format))
+      return ROGUE_PBESTATE_SOURCE_FORMAT_F16_PER_CHANNEL;
+
+   if (desc->colorspace == UTIL_FORMAT_COLORSPACE_SRGB)
+      return ROGUE_PBESTATE_SOURCE_FORMAT_F16_PER_CHANNEL;
+
+   if (util_format_has_depth(desc) || util_format_has_stencil(desc))
+      return ROGUE_PBESTATE_SOURCE_FORMAT_8_PER_CHANNEL;
+
+   if (chan_0_width > 16)
+      return ROGUE_PBESTATE_SOURCE_FORMAT_8_PER_CHANNEL;
+
+   if (chan_0_width > 8)
+      return ROGUE_PBESTATE_SOURCE_FORMAT_F16_PER_CHANNEL;
+
+   /* The branch the parameter decides: an 8-bit format is F16-packed only when the driver has no
+    * packed USC channel to put it in. */
+   if (!with_packed_usc_channel)
+      return ROGUE_PBESTATE_SOURCE_FORMAT_F16_PER_CHANNEL;
+
+   return ROGUE_PBESTATE_SOURCE_FORMAT_8_PER_CHANNEL;
+}
+
+bool
+pvr_pbe_swizzle_from_pipe(uint8_t pipe_swizzle, enum ROGUE_PBESTATE_SWIZ *out)
+{
+   switch (pipe_swizzle) {
+   case PIPE_SWIZZLE_X: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN0; return true;
+   case PIPE_SWIZZLE_Y: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN1; return true;
+   case PIPE_SWIZZLE_Z: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN2; return true;
+   case PIPE_SWIZZLE_W: *out = ROGUE_PBESTATE_SWIZ_SOURCE_CHAN3; return true;
+   case PIPE_SWIZZLE_0: *out = ROGUE_PBESTATE_SWIZ_ZERO; return true;
+   case PIPE_SWIZZLE_1: *out = ROGUE_PBESTATE_SWIZ_ONE; return true;
+   default:
+      return false;
+   }
+}
+
+void
+pvr_pbe_clip_from_area(uint32_t off_x, uint32_t off_y, uint32_t width, uint32_t height,
+                       uint32_t surface_width, uint32_t surface_height,
+                       struct pvr_pbe_clip *out)
+{
+   /* Guarded decrement, as the reference uses: offset + extent can be zero, where a plain -1
+    * would wrap to 0xFFFFFFFF and describe a clip region larger than any surface. */
+   const uint32_t far_x = off_x + width  > 0 ? off_x + width  - 1 : 0;
+   const uint32_t far_y = off_y + height > 0 ? off_y + height - 1 : 0;
+
+   out->min_x = off_x;
+   out->min_y = off_y;
+   out->max_x = MIN2(surface_width  > 0 ? surface_width  - 1 : 0, far_x);
+   out->max_y = MIN2(surface_height > 0 ? surface_height - 1 : 0, far_y);
+}
+
+enum ROGUE_PBESTATE_SIZE
+pvr_pbe_size_from_pixels(uint32_t pixels)
+{
+   /* 16384 is the largest the enum names. Beyond that there is no encoding, and saturating would
+    * claim a smaller target than exists - the hardware would then process fewer tiles than the
+    * surface has, and the remainder would simply never be drawn. */
+   if (pixels == 0 || pixels > 16384) {
+      mesa_loge("pvr: PBE size from %u pixels, outside the encodable 1..16384", pixels);
+      return ROGUE_PBESTATE_SIZE_16K_PIXEL;
+   }
+
+   return (enum ROGUE_PBESTATE_SIZE)util_logbase2_ceil(pixels);
+}
+
+enum ROGUE_PBESTATE_MEMLAYOUT
+pvr_pbe_memlayout_linear(void)
+{
+   return ROGUE_PBESTATE_MEMLAYOUT_LINEAR;
+}
+
+void
+pvr_csb_pbe_state_words(uint64_t addr, enum pipe_format format, uint32_t mrt_index,
+                        uint32_t source_pos_dword, bool emptytile, uint32_t words[2])
+{
+   const struct util_format_description *desc = util_format_description(format);
+   const int chan = util_format_get_first_non_void_channel(format);
+   if (emptytile) {
+      /* Depth-only render (reference "z only render"): the pixel events must not write colour.
+       * Zero address/format words and set emptytile so the PBE drops every fragment. */
+      struct ROGUE_PBESTATE_STATE_WORD0 z0 = { 0 };
+      struct ROGUE_PBESTATE_STATE_WORD1 z1 = { .emptytile = true };
+      ROGUE_PBESTATE_STATE_WORD0_pack(&words[0], &z0);
+      ROGUE_PBESTATE_STATE_WORD1_pack(&words[1], &z1);
+      return;
+   }
+   struct ROGUE_PBESTATE_STATE_WORD0 sw0 = { .address_low = addr };
+   struct ROGUE_PBESTATE_STATE_WORD1 sw1 = {
+      .address_high = addr,
+      .source_format = pvr_pbe_source_format_from_pipe(format, true),
+      .mrt_index = mrt_index,
+      /* Where this attachment's pixel data starts in the fragment output, as a dword index: the
+       * reference maps output positions 0..3 to START_BIT0/32/64/96. One-dword formats keep
+       * start == attachment index; a 16F format occupies two dwords, so the next attachment's
+       * start moves by two. */
+      .source_pos = (enum ROGUE_PBESTATE_SOURCE_POS)MIN2(source_pos_dword, 3),
+      .norm = chan >= 0 && desc->channel[chan].normalized,
+   };
+
+   /* Pack mode from the output format's first channel. */
+   const uint32_t nr_chan = util_format_get_nr_components(format);
+   if (desc->channel[chan].type == UTIL_FORMAT_TYPE_FLOAT) {
+      sw1.packmode = desc->channel[chan].size == 16
+                        ? (nr_chan <= 1 ? ROGUE_PBESTATE_PACKMODE_F16
+                           : nr_chan == 2 ? ROGUE_PBESTATE_PACKMODE_F16F16
+                                          : ROGUE_PBESTATE_PACKMODE_F16F16F16F16)
+                        : ROGUE_PBESTATE_PACKMODE_F32F32F32F32;
+   } else if (desc->channel[chan].size == 8) {
+      sw1.packmode = desc->channel[chan].type == UTIL_FORMAT_TYPE_SIGNED
+                        ? ROGUE_PBESTATE_PACKMODE_S8S8S8S8
+                        : ROGUE_PBESTATE_PACKMODE_U8U8U8U8;
+   } else {
+      sw1.packmode = desc->channel[chan].type == UTIL_FORMAT_TYPE_SIGNED
+                        ? ROGUE_PBESTATE_PACKMODE_S16S16S16S16
+                        : ROGUE_PBESTATE_PACKMODE_U16U16U16U16;
+   }
+
+   ROGUE_PBESTATE_STATE_WORD0_pack(&words[0], &sw0);
+   ROGUE_PBESTATE_STATE_WORD1_pack(&words[1], &sw1);
+}
+
+bool
+pvr_csb_pbe_words(enum pipe_format format, uint32_t stride_bytes, uint32_t width,
+                  uint32_t height, uint32_t phys_height, bool twiddled, bool fbc, uint64_t words[3])
+{
+   const struct util_format_description *desc = util_format_description(format);
+   const int chan = util_format_get_first_non_void_channel(format);
+   struct pvr_format_layout layout;
+   struct ROGUE_PBESTATE_REG_WORD0 reg0 = {
+      .tilerelative = true,
+      .memlayout = twiddled ? ROGUE_PBESTATE_MEMLAYOUT_TWIDDLE_2D
+                            : ROGUE_PBESTATE_MEMLAYOUT_LINEAR,
+      .rotation = ROGUE_PBESTATE_ROTATION_TYPE_0_DEG,
+      .linestride = pvr_pbe_linestride(stride_bytes / util_format_get_blocksize(format)),
+   };
+   struct ROGUE_PBESTATE_REG_WORD1 reg1 = {
+      .maxclip_x = width - 1,
+      .maxclip_y = height - 1,
+   };
+
+   /* Twiddled targets tell the PBE the power-of-two log2 extents of the surface (the Vulkan
+    * driver's pvr_arch_pbe_pack_state does the same); without them the PBE wrote only a
+    * fraction of the target, which is how the first twiddled attempt produced a mostly-zero
+    * image. They are the allocated extents (the row pitch and phys_height): for a mip level of a
+    * non-power-of-two image those exceed the level's own size rounded up. */
+   if (twiddled) {
+      reg1.size_x = util_logbase2_ceil(stride_bytes / util_format_get_blocksize(format));
+      reg1.size_y = util_logbase2_ceil(phys_height);
+   }
+
+   if (chan < 0 || !pvr_format_layout_from_pipe(format, &layout))
+      return false;
+
+   /* The pack mode would be encoded here if it belonged to this word; the format lives in the
+    * pixel-event program instead. It is still checked so an unsupported format is refused rather
+    * than silently rendered as something else. */
+   if (desc->channel[chan].type == UTIL_FORMAT_TYPE_FLOAT) {
+      if (desc->channel[chan].size != 16 && desc->channel[chan].size != 32)
+         return false;
+   } else if (desc->channel[chan].size != 8 && desc->channel[chan].size != 16) {
+      return false;
+   }
+
+   /* Channel swizzles: output channel n reads the source channel named by swizzle[n]. */
+   for (unsigned i = 0; i < 4; i++) {
+      enum ROGUE_PBESTATE_SWIZ swiz;
+      uint8_t pipe = layout.swizzle[i];
+
+      if (pipe == PIPE_SWIZZLE_0 || pipe == PIPE_SWIZZLE_NONE) {
+         swiz = ROGUE_PBESTATE_SWIZ_ZERO;
+      } else if (pipe == PIPE_SWIZZLE_1) {
+         swiz = ROGUE_PBESTATE_SWIZ_ONE;
+      } else if (!pvr_pbe_swizzle_from_pipe(pipe, &swiz)) {
+         return false;
+      }
+
+      switch (i) {
+      case 0: reg0.swiz_chan0 = swiz; break;
+      case 1: reg0.swiz_chan1 = swiz; break;
+      case 2: reg0.swiz_chan2 = swiz; break;
+      case 3: reg0.swiz_chan3 = swiz; break;
+      }
+   }
+
+   /* sRGB target: the PBE writes the linear source values encoded to sRGB, exactly like the
+    * reference's PBESTATE_REG_WORD0 gamma bit (its pbe_pack_state sets it from the format). */
+   if (util_format_is_srgb(format))
+      reg0.gamma = true;
+
+   /* TFBC: the PBE compresses whole 8x8 blocks, direct addressing (see NATIVE-TFBC-PORT.md). */
+   if (fbc) {
+      reg0.compression = ROGUE_PBESTATE_COMPRESSION_ENABLED;
+      reg0.compress_size = ROGUE_PBESTATE_COMPRESS_SIZE_BLOCK_8X8;
+      reg0.comp_indirect_table = false;
+   }
+
+   ROGUE_PBESTATE_REG_WORD0_pack(&words[0], &reg0);
+   ROGUE_PBESTATE_REG_WORD1_pack(&words[1], &reg1);
+   words[2] = 0;
+
+   return true;
+}
+
+bool
+pvr_csb_emit_pbe_target(struct pvr_csb *csb, const struct pvr_pbe_target *target)
+{
+   const uint32_t words = ROGUE_PBESTATE_STATE_WORD0_length +
+                          ROGUE_PBESTATE_STATE_WORD1_length;
+   struct ROGUE_PBESTATE_STATE_WORD0 word0 = { .address_low = target->addr };
+   struct ROGUE_PBESTATE_STATE_WORD1 word1 = {
+      .address_high = target->addr,
+      .source_format = target->source_format,
+      .mrt_index = target->mrt_index,
+   };
+   uint32_t *dw;
+
+   /* Bits [0:31] and [34:39] - see the header. Bits 32 and 33 have no field, so an address that
+    * sets either cannot be encoded; refuse rather than let the packer re-encode it elsewhere. */
+   /* address_low packs bits [33:2] (shift 2) and address_high bits [39:34]: any dword-aligned
+    * address below 1 TiB is encodable. */
+   if (target->addr >= (1ULL << 40) || (target->addr & 3) != 0) {
+      mesa_loge("pvr: PBE target 0x%" PRIx64 " is not a dword-aligned address below 1TB",
+                target->addr);
+      return false;
+   }
+
+   dw = pvr_csb_emit(csb, words);
+   if (dw == NULL)
+      return false;
+
+   ROGUE_PBESTATE_STATE_WORD0_pack(dw, &word0);
+   ROGUE_PBESTATE_STATE_WORD1_pack(dw + ROGUE_PBESTATE_STATE_WORD0_length, &word1);
+
+   return true;
+}
+
+bool
+pvr_csb_emit_ta_pds_base(struct pvr_csb *csb, enum pvr_pds_base which, uint64_t addr)
+{
+   /* One window for all four - see the header. */
+   if (addr > 0xffffffffULL || (addr & 0xf) != 0) {
+      mesa_loge("pvr: PDS base 0x%" PRIx64 " does not fit bits [4:31] (16-byte aligned, below "
+                "4GB)", addr);
+      return false;
+   }
+
+   switch (which) {
+   case PVR_PDS_BASE_SHADER: {
+      struct ROGUE_TA_STATE_PDS_SHADERBASE v = { .addr = addr };
+      uint32_t *dw = pvr_csb_emit(csb, ROGUE_TA_STATE_PDS_SHADERBASE_length);
+      if (dw == NULL) return false;
+      ROGUE_TA_STATE_PDS_SHADERBASE_pack(dw, &v);
+      return true;
+   }
+   case PVR_PDS_BASE_VARYING: {
+      struct ROGUE_TA_STATE_PDS_VARYINGBASE v = { .addr = addr };
+      uint32_t *dw = pvr_csb_emit(csb, ROGUE_TA_STATE_PDS_VARYINGBASE_length);
+      if (dw == NULL) return false;
+      ROGUE_TA_STATE_PDS_VARYINGBASE_pack(dw, &v);
+      return true;
+   }
+   case PVR_PDS_BASE_TEXTUREDATA: {
+      struct ROGUE_TA_STATE_PDS_TEXTUREDATABASE v = { .addr = addr };
+      uint32_t *dw = pvr_csb_emit(csb, ROGUE_TA_STATE_PDS_TEXTUREDATABASE_length);
+      if (dw == NULL) return false;
+      ROGUE_TA_STATE_PDS_TEXTUREDATABASE_pack(dw, &v);
+      return true;
+   }
+   case PVR_PDS_BASE_UNIFORMDATA: {
+      struct ROGUE_TA_STATE_PDS_UNIFORMDATABASE v = { .addr = addr };
+      uint32_t *dw = pvr_csb_emit(csb, ROGUE_TA_STATE_PDS_UNIFORMDATABASE_length);
+      if (dw == NULL) return false;
+      ROGUE_TA_STATE_PDS_UNIFORMDATABASE_pack(dw, &v);
+      return true;
+   }
+   case PVR_PDS_BASE_TEXUNICODE: {
+      struct ROGUE_TA_STATE_PDS_TEXUNICODEBASE v = { .addr = addr };
+      uint32_t *dw = pvr_csb_emit(csb, ROGUE_TA_STATE_PDS_TEXUNICODEBASE_length);
+      if (dw == NULL) return false;
+      ROGUE_TA_STATE_PDS_TEXUNICODEBASE_pack(dw, &v);
+      return true;
+   }
+   }
+
+   return false;
+}
