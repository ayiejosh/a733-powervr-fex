+                  printf("hwrt:          fragment-only (dummy state) %s\n",
+                         fdone ? "COMPLETED" : "did not complete in 2 s");
+                  if (getenv("PVR_PROBE_FRAG_THEN_GEOM")) {
+                     const bool gdone = pvr_job_submit_geom_sync(vm, gpu_ctx.handle, gstream,
+                                                                 glen, dset_handle, 0, 2000);
+
+                     printf("hwrt:          geometry after a fragment job %s\n",
+                            gdone ? "COMPLETED" : "did not complete in 2 s");
+                  }
+               }
+               /* Fill the fragment stream's PDS background programs and TPU border table. The
+                * reference always sets these; left at zero they are "PDS heap base + 0", so the 3D
+                * stage executes whatever program sits at the bottom of the PDS heap. Reuse the
+                * fragment PDS program as the background program for now - this is about making the
+                * kick valid, not about the background colour. */
+               {
+                  uint64_t bgnd[3], pr_bgnd[3];
+
+                  pvr_csb_pds_bgnd_words((g_bg_pds_base_offset ? g_bg_pds_base_offset : g_fs_pds_base_offset), (g_bg_pds_base_offset ? g_bg_pds_base_offset : g_fs_pds_base_offset),
+                                         (g_bg_pds_base_offset ? g_bg_pds_base_offset : g_fs_pds_base_offset), 0, 0, 0, bgnd);
+                  pvr_csb_pds_bgnd_words((g_bg_pds_base_offset ? g_bg_pds_base_offset : g_fs_pds_base_offset), (g_bg_pds_base_offset ? g_bg_pds_base_offset : g_fs_pds_base_offset),
+                                         (g_bg_pds_base_offset ? g_bg_pds_base_offset : g_fs_pds_base_offset), 0, 0, 0, pr_bgnd);
