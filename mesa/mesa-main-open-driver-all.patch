diff --git a/src/gallium/drivers/pvr_native/pvr_resource.c b/src/gallium/drivers/pvr_native/pvr_resource.c
new file mode 100644
index 00000000..bb79c92c
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_resource.c
@@ -0,0 +1,364 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#include <inttypes.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <xf86drm.h>
+#include "drm-uapi/drm_fourcc.h"
+#include "frontend/winsys_handle.h"
+
+#include "pvr_resource.h"
+
+#include "pipe/p_screen.h"
+#include "util/format/u_formats.h"
+#include "util/log.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+
+#include "pvr_screen.h"
+
+/* What the linear layout can honestly describe. Anything else is refused rather than
+ * accepted and laid out wrongly - a mipmapped or arrayed resource quietly treated as
+ * level 0 is the kind of thing that renders wrong long after it is created. */
+static bool
+pvr_resource_layout(const struct pipe_resource *templ, uint32_t *stride,
+                    uint64_t *size)
+{
+   switch (templ->target) {
+   case PIPE_BUFFER:
+      *stride = 0;
+      *size = templ->width0;
+      return true;
+
+   case PIPE_TEXTURE_2D:
+   case PIPE_TEXTURE_RECT: /* renderbuffers, when the state tracker picks RECT */
+      if (util_format_is_depth_or_stencil(templ->format)) {
+         /* The ZLS loads and stores whole 32x32 ISP tiles. */
+         *stride = util_format_get_stride(templ->format, ALIGN_POT(templ->width0, 32));
+         *size = (uint64_t)*stride * ALIGN_POT(templ->height0, 32);
+         return true;
+      }
+      *stride = util_format_get_stride(templ->format, templ->width0);
+      *size = (uint64_t)*stride * templ->height0;
+      return true;
+
+   default:
+      return false;
+   }
+}
+
+struct pipe_resource *
+pvr_resource_create(struct pipe_screen *pscreen, const struct pipe_resource *templ)
+{
+   struct pvr_screen *screen = pvr_screen(pscreen);
+   struct pvr_resource *res;
+   uint32_t stride = 0;
+   uint64_t size = 0;
+
+   const bool cube = templ->target == PIPE_TEXTURE_CUBE;
+   if ((!cube && templ->array_size != 1) || (cube && templ->array_size != 6) ||
+       templ->nr_samples > 1) {
+      mesa_logd("pvr: refusing an arrayed/multisampled resource");
+      return NULL;
+   }
+
+   if (!cube && templ->target != PIPE_BUFFER && templ->depth0 != 1) {
+      mesa_logd("pvr: refusing a 2D resource with depth");
+      return NULL;
+   }
+
+   bool twiddled = false, fbc = false;
+   uint32_t layer_size = 0;
+
+   uint32_t phys_width = 0, phys_height = 0;
+   uint64_t fbc_header_size = 0;
+   const uint64_t bind_linear = PIPE_BIND_SHARED | PIPE_BIND_DISPLAY_TARGET |
+                                PIPE_BIND_SCANOUT | PIPE_BIND_LINEAR;
+   const enum pipe_format fmt = templ->format;
+   const bool rt_format = fmt == PIPE_FORMAT_R8G8B8A8_UNORM || fmt == PIPE_FORMAT_B8G8R8A8_UNORM ||
+                          fmt == PIPE_FORMAT_R8G8B8X8_UNORM || fmt == PIPE_FORMAT_B8G8R8X8_UNORM;
+
+
+   /* Twiddled colour render targets: the PBE and TPU only reach full bandwidth with the twiddled
+    * layout, and TFBC (the PBE's lossless 8x8 compression) needs it. Only targets that the CPU
+    * never maps are twiddled - a mapped resource needs the linear layout until transfer staging is
+    * implemented, so textures uploaded from the client stay linear. */
+   const bool mips = templ->target == PIPE_TEXTURE_2D && templ->last_level > 0;
+   unsigned last_level = 0;
+   uint32_t level_offset[PIPE_MAX_TEXTURE_LEVELS] = { 0 };
+   if (cube) {
+      /* A cube map is six 2D twiddled faces, face-major: each face carries its own mip chain (down
+       * to 1x1, as the hardware expects the whole chain when mipmapped) and the faces are strided
+       * by the page-aligned layer size, which the texture descriptor passes as the image meta's
+       * layer size. The reference's pvr_image_plane_setup_mip_levels lays an array out this way. */
+      if (!rt_format || (templ->bind & bind_linear) || screen->no_twiddle) {
+         mesa_logd("pvr: refusing a cube map in a format/layout the hardware cannot use");
+         return NULL;
+      }
+      const unsigned cpp = util_format_get_blocksize(fmt);
+      twiddled = true;
+      last_level = templ->last_level;
+      phys_width = util_next_power_of_two(templ->width0);
+      phys_height = util_next_power_of_two(templ->height0);
+      stride = cpp * phys_width;
+      if (last_level > 0) {
+         for (unsigned l = 0;; l++) {
+            if (l < PIPE_MAX_TEXTURE_LEVELS)
+               level_offset[l] = (uint32_t)size;
+            size += (uint64_t)cpp * u_minify(phys_width, l) * u_minify(phys_height, l);
+            if (u_minify(phys_width, l) == 1 && u_minify(phys_height, l) == 1)
+               break;
+         }
+      } else {
+         level_offset[0] = 0;
+         size = (uint64_t)stride * phys_height;
+      }
+      layer_size = ALIGN_POT((uint32_t)size, 4096);
+      size = (uint64_t)layer_size * 6;
+   } else if (mips && rt_format && !(templ->bind & bind_linear) && !screen->no_twiddle) {
+      /* A mip chain is twiddled whatever the bind flags (the GPU uploads and generates its
+       * levels), laid out as the Vulkan driver's pvr_image_plane_setup_mip_levels: power-of-two
+       * levels back to back, and the hardware expects room for the full chain down to 1x1.
+       * No TFBC, as in Vulkan (it compresses single-level images only). */
+      const unsigned cpp = util_format_get_blocksize(fmt);
+      twiddled = true;
+      last_level = templ->last_level;
+      phys_width = util_next_power_of_two(templ->width0);
+      phys_height = util_next_power_of_two(templ->height0);
+      stride = cpp * phys_width;
+      for (unsigned l = 0;; l++) {
+         if (l < PIPE_MAX_TEXTURE_LEVELS)
+            level_offset[l] = (uint32_t)size;
+         const uint32_t lw = u_minify(phys_width, l), lh = u_minify(phys_height, l);
+         size += (uint64_t)cpp * lw * lh;
+         if (lw == 1 && lh == 1)
+            break;
+      }
+   } else if ((templ->target == PIPE_TEXTURE_2D || templ->target == PIPE_TEXTURE_RECT) &&
+       rt_format && (templ->bind & PIPE_BIND_RENDER_TARGET) && !(templ->bind & bind_linear) &&
+       templ->width0 >= 8 && templ->height0 >= 8 && !screen->no_twiddle) {
+      const unsigned cpp = util_format_get_blocksize(fmt);
+      twiddled = true;
+      phys_width = util_next_power_of_two(templ->width0);
+      phys_height = util_next_power_of_two(templ->height0);
+      stride = cpp * phys_width;
+      size = (uint64_t)stride * phys_height;
+      /* TFBC is only used on the plain RGBA8/BGRA8 colour targets (see NATIVE-TFBC-PORT.md). */
+      const struct pvr_device_info *dev_info = &screen->dev_info;
+      fbc = !screen->no_fbc &&
+            PVR_HAS_FEATURE(dev_info, tpu_image_state_v2) &&
+            PVR_GET_FEATURE_VALUE(dev_info, fbcdc_algorithm, 0) == 50 &&
+            (fmt == PIPE_FORMAT_R8G8B8A8_UNORM || fmt == PIPE_FORMAT_B8G8R8A8_UNORM);
+      if (fbc) {
+         fbc_header_size = ALIGN_POT(size / 32, 4096);
+         size += fbc_header_size;
+      }
+   } else if ((templ->target == PIPE_TEXTURE_2D || templ->target == PIPE_TEXTURE_RECT) &&
+              util_format_is_depth_or_stencil(fmt) && (templ->bind & PIPE_BIND_DEPTH_STENCIL) &&
+              !(templ->bind & bind_linear) &&
+              fmt != PIPE_FORMAT_S8_UINT && templ->width0 >= 8 && templ->height0 >= 8 &&
+              !screen->no_twiddle) {
+      /* The ZLS can load/store twiddled depth buffers too, with the same power-of-two layout as the
+       * colour targets (depth textures are sampled through the twiddled descriptor as well). Skip
+       * stencil-only buffers. */
+      const unsigned cpp = util_format_get_blocksize(fmt);
+      twiddled = true;
+      phys_width = util_next_power_of_two(templ->width0);
+      phys_height = util_next_power_of_two(templ->height0);
+      stride = cpp * phys_width;
+      size = (uint64_t)stride * phys_height;
+   } else if (!pvr_resource_layout(templ, &stride, &size)) {
+      mesa_logd("pvr: no layout for target %u", templ->target);
+      return NULL;
+   }
+
+   res = CALLOC_STRUCT(pvr_resource);
+   if (!res)
+      return NULL;
+
+   res->base = *templ;
+   /* shortcut: a mip chain in a format the PBE cannot write (no GPU upload or generation for its
+    * levels) keeps level 0 only and is sampled at level 0; add CPU level transfers if one shows up. */
+   if (mips && last_level == 0) {
+      static bool warned;
+      if (!warned) {
+         warned = true;
+         mesa_logw("pvr: mipmapped %s stores level 0 only", util_format_short_name(fmt));
+      }
+   }
+   res->base.last_level = last_level;
+   memcpy(res->level_offset, level_offset, sizeof(level_offset));
+   res->base.screen = pscreen;
+   pipe_reference_init(&res->base.reference, 1);
+
+   res->stride = stride;
+   res->twiddled = twiddled;
+   res->phys_width = phys_width;
+   res->phys_height = phys_height;
+   res->cube = cube;
+   res->layer_size = layer_size;
+   res->fbc = fbc;
+   res->fbc_header_size = fbc_header_size;
+
+   /* size 0 would be rejected by the kernel; an empty buffer is a real thing to ask
+    * for, so give it one page rather than failing. */
+   if (size == 0)
+      size = 4096;
+
+   /* A cached buffer of the same size: already mapped for the CPU and the GPU. */
+   if (templ->target == PIPE_BUFFER && screen->vm_valid) {
+      simple_mtx_lock(&screen->bo_cache_lock);
+      for (unsigned i = 0; i < screen->nr_bo_cache; i++) {
+         struct pvr_bo_cache_entry *e = &screen->bo_cache[i];
+         if (e->bo.size == ALIGN_POT(size, 4096)) {
+            res->bo = e->bo;
+            res->dev_addr = res->data_addr = e->dev_addr;
+            res->dev_size = e->dev_size;
+            *e = screen->bo_cache[--screen->nr_bo_cache];
+            break;
+         }
+      }
+      simple_mtx_unlock(&screen->bo_cache_lock);
+      if (res->dev_addr != 0)
+         return &res->base;
+   }
+
+   if (!pvr_bo_create(screen->fd, size, 1, &res->bo))
+      goto fail;
+
+   if (screen->vm_valid) {
+      res->dev_size = res->bo.size;
+      res->dev_addr =
+         pvr_vm_alloc(&screen->vm, res->dev_size, screen->vm.general.page_size);
+
+      if (res->dev_addr == 0) {
+         mesa_loge("pvr: out of device address space for %" PRIu64 " bytes",
+                   res->dev_size);
+         goto fail_bo;
+      }
+
+      if (!pvr_vm_map(&screen->vm, res->dev_addr, res->bo.handle, res->dev_size))
+         goto fail_addr;
+      /* The PBE/TPU address the data, not the TFBC headers in front of it. */
+      res->data_addr = res->dev_addr + res->fbc_header_size;
+   }
+
+   return &res->base;
+
+fail_addr:
+   pvr_vm_free(&screen->vm, res->dev_addr, res->dev_size);
+   res->dev_addr = 0;
+fail_bo:
+   pvr_bo_destroy(screen->fd, &res->bo);
+fail:
+   FREE(res);
+   return NULL;
+}
+
+/* Window-system buffers. Every resource is linear, so a handle is the BO plus the row stride and
+ * the LINEAR modifier. */
+bool
+pvr_resource_get_handle(struct pipe_screen *pscreen, UNUSED struct pipe_context *pctx,
+                        struct pipe_resource *prsc, struct winsys_handle *whandle,
+                        UNUSED unsigned usage)
+{
+   struct pvr_screen *screen = pvr_screen(pscreen);
+   struct pvr_resource *res = pvr_resource(prsc);
+
+   whandle->stride = res->stride;
+   whandle->offset = 0;
+   whandle->modifier = DRM_FORMAT_MOD_LINEAR;
+   switch (whandle->type) {
+   case WINSYS_HANDLE_TYPE_KMS:
+      whandle->handle = res->bo.handle;
+      return true;
+   case WINSYS_HANDLE_TYPE_FD: {
+      int fd = -1;
+      if (drmPrimeHandleToFD(screen->fd, res->bo.handle, DRM_CLOEXEC | DRM_RDWR, &fd) != 0)
+         return false;
+      whandle->handle = fd;
+      return true;
+   }
+   default:
+      return false;
+   }
+}
+
+struct pipe_resource *
+pvr_resource_from_handle(struct pipe_screen *pscreen, const struct pipe_resource *templ,
+                         struct winsys_handle *whandle, UNUSED unsigned usage)
+{
+   struct pvr_screen *screen = pvr_screen(pscreen);
+   struct pvr_resource *res;
+   uint32_t handle;
+
+   if (whandle->type != WINSYS_HANDLE_TYPE_FD || (templ->target != PIPE_TEXTURE_2D && templ->target != PIPE_TEXTURE_RECT) ||
+       whandle->offset != 0 ||
+       (whandle->modifier != DRM_FORMAT_MOD_INVALID &&
+        whandle->modifier != DRM_FORMAT_MOD_LINEAR) ||
+       !screen->vm_valid)
+      return NULL;
+   const off_t size = lseek(whandle->handle, 0, SEEK_END);
+   if (size <= 0 || (uint64_t)whandle->stride * templ->height0 > (uint64_t)size)
+      return NULL;
+   if (drmPrimeFDToHandle(screen->fd, whandle->handle, &handle) != 0)
+      return NULL;
+   res = CALLOC_STRUCT(pvr_resource);
+   if (!res)
+      return NULL;
+   res->base = *templ;
+   res->base.screen = pscreen;
+   pipe_reference_init(&res->base.reference, 1);
+   res->stride = whandle->stride;
+   res->bo.handle = handle;
+   res->bo.size = size;
+   res->dev_size = size;
+   res->dev_addr = pvr_vm_alloc(&screen->vm, res->dev_size, screen->vm.general.page_size);
+   if (res->dev_addr == 0)
+      goto fail_bo;
+   if (!pvr_vm_map(&screen->vm, res->dev_addr, res->bo.handle, res->dev_size))
+      goto fail_addr;
+   res->data_addr = res->dev_addr;
+   return &res->base;
+fail_addr:
+   pvr_vm_free(&screen->vm, res->dev_addr, res->dev_size);
+   res->dev_addr = 0;
+fail_bo:
+   pvr_bo_destroy(screen->fd, &res->bo);
+   FREE(res);
+   return NULL;
+}
+
+void
+pvr_resource_destroy(struct pipe_screen *pscreen, struct pipe_resource *prsc)
+{
+   struct pvr_screen *screen = pvr_screen(pscreen);
+   struct pvr_resource *res = pvr_resource(prsc);
+
+   if (prsc->target == PIPE_BUFFER && res->dev_addr != 0 && res->bo.size <= (4u << 20)) {
+      simple_mtx_lock(&screen->bo_cache_lock);
+      if (screen->nr_bo_cache < ARRAY_SIZE(screen->bo_cache)) {
+         screen->bo_cache[screen->nr_bo_cache++] = (struct pvr_bo_cache_entry){
+            .bo = res->bo, .dev_addr = res->dev_addr, .dev_size = res->dev_size,
+         };
+         res->dev_addr = 0;
+      }
+      simple_mtx_unlock(&screen->bo_cache_lock);
+      if (res->dev_addr == 0) {
+         FREE(res);
+         return;
+      }
+   }
+
+   /* The GPU mapping goes first, then the address, then the object - the same order
+    * the Vulkan winsys tears down in. */
+   if (res->dev_addr != 0) {
+      pvr_vm_unmap(&screen->vm, res->dev_addr, res->dev_size);
+      pvr_vm_free(&screen->vm, res->dev_addr, res->dev_size);
+      res->dev_addr = 0;
+   }
+
+   pvr_bo_destroy(screen->fd, &res->bo);
+   FREE(res);
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_resource.h b/src/gallium/drivers/pvr_native/pvr_resource.h
new file mode 100644
index 00000000..5e2c2279
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_resource.h
@@ -0,0 +1,133 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * pipe_resource backed by a buffer object with a device address.
+ *
+ * ponytail: v1 lays every resource out linearly and supports only what that can
+ * honestly describe - buffers and non-mipmapped, non-arrayed 2D textures. The layout
+ * the GPU actually needs for texturing (tiling, and the stride/padding rules that go
+ * with it) is stage 3 work; until then a resource is real memory the GPU can reach,
+ * not yet something a sampler can read. Mipmaps, arrays and 3D are refused rather
+ * than accepted and laid out wrongly.
+ */
+#ifndef PVR_RESOURCE_H
+#define PVR_RESOURCE_H
+
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#include "util/format/u_format.h"
+#include "util/u_math.h"
+
+#include "pvr_bo.h"
+
+struct pvr_resource {
+   struct pipe_resource base;
+
+   struct pvr_bo bo;
+
+   /* Where the GPU sees it. 0 while unmapped from the GPU address space. */
+   uint64_t dev_addr;
+
+   /* Bytes the device address covers, i.e. the page-aligned BO size. */
+   uint64_t dev_size;
+
+   /* Bytes between rows. For the twiddled layout this is cpp * phys_width (row pitch of the
+    * padded, power-of-two image). */
+   uint32_t stride;
+
+   /* Twiddled layout: colour render targets are laid out with power-of-two physical extents and
+    * the TPU/PBE twiddle. Linear layouts are kept for buffers, depth and everything uploaded or
+    * read through the CPU. */
+   bool twiddled;
+   uint32_t phys_width, phys_height;
+
+   /* Cube map: six faces, face-major, each face carrying its own mip chain. layer_size is the
+    * page-aligned stride between faces (the hardware's PCO_IMAGE_META_LAYER_SIZE). */
+   bool cube;
+   uint32_t layer_size;
+
+   /* Lossless TFBC: twiddled colour targets are PBE-compressed 8x8 blocks, with an 8-byte header
+    * per block stored below the data. data_addr points past the header area. */
+   bool fbc;
+   uint64_t fbc_header_size;
+   uint64_t data_addr;
+
+   /* Mip levels (base.last_level > 0): a twiddled chain laid out as the Vulkan driver's
+    * pvr_image, level l a power-of-two image of max(1, phys >> l) at level_offset[l] bytes past
+    * data_addr. Level 0 is at offset 0 for every resource. */
+   uint32_t level_offset[PIPE_MAX_TEXTURE_LEVELS];
+
+   /* A full clear recorded by a render that had nothing else to do: it was not submitted, and the
+    * next render into level 0 (or the depth buffer) starts with it instead of loading. Anything
+    * else that reads the resource submits it first (pvr_draw_materialize). */
+   bool clear_pending, zclear_pending;
+   uint32_t clear_color;
+   /* The float clear colour the deferred clear was recorded with: the packed dword is only right for
+    * one format, while the deferred render may need it per attachment (sRGB packs 16F source data,
+    * for instance). */
+   union pipe_color_union clear_value;
+   float zclear;
+
+   /* The draw path's render sequence number of the last render that used this resource (0:
+    * none). A CPU map waits only for a render that uses the resource. */
+   uint32_t render_seq;
+};
+
+struct pipe_resource *pvr_resource_create(struct pipe_screen *pscreen,
+                                          const struct pipe_resource *templ);
+
+void pvr_resource_destroy(struct pipe_screen *pscreen, struct pipe_resource *prsc);
+
+struct winsys_handle;
+bool pvr_resource_get_handle(struct pipe_screen *pscreen, struct pipe_context *pctx,
+                             struct pipe_resource *prsc, struct winsys_handle *whandle,
+                             unsigned usage);
+struct pipe_resource *pvr_resource_from_handle(struct pipe_screen *pscreen,
+                                               const struct pipe_resource *templ,
+                                               struct winsys_handle *whandle, unsigned usage);
+
+static inline struct pvr_resource *
+pvr_resource(struct pipe_resource *prsc)
+{
+   return (struct pvr_resource *)prsc;
+}
+
+/* Physical (allocated) extent of a level: the power-of-two extent minified for a twiddled
+ * resource, the logical one otherwise (only level 0 exists then). */
+static inline uint32_t
+pvr_resource_level_phys_w(const struct pvr_resource *res, unsigned level)
+{
+   return res->twiddled ? u_minify(res->phys_width, level) : res->base.width0;
+}
+
+static inline uint32_t
+pvr_resource_level_phys_h(const struct pvr_resource *res, unsigned level)
+{
+   return res->twiddled ? u_minify(res->phys_height, level) : res->base.height0;
+}
+
+/* Row pitch of a level in bytes. */
+static inline uint32_t
+pvr_resource_level_stride(const struct pvr_resource *res, unsigned level)
+{
+   return level == 0 ? res->stride
+                      : util_format_get_stride(res->base.format,
+                                               pvr_resource_level_phys_w(res, level));
+}
+
+static inline uint64_t
+pvr_resource_level_addr(const struct pvr_resource *res, unsigned level)
+{
+   return res->data_addr + res->level_offset[level];
+}
+
+/* Address of one face of a cube map (layer 0 for 2D resources, where layer_size is 0). */
+static inline uint64_t
+pvr_resource_level_addr_layer(const struct pvr_resource *res, unsigned level, unsigned layer)
+{
+   return pvr_resource_level_addr(res, level) + (uint64_t)layer * res->layer_size;
+}
+
+#endif /* PVR_RESOURCE_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_screen.c b/src/gallium/drivers/pvr_native/pvr_screen.c
new file mode 100644
index 00000000..592d5959
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_screen.c
@@ -0,0 +1,483 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * SKELETON. Registers a pipe_screen and enumerates the device.
+ * No draw path, no rasterisation, no resource management - none is claimed.
+ */
+#include "pvr_screen.h"
+#include "pvr_draw.h"
+#include "pvr_public.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+#include <xf86drm.h>
+
+/* The kernel UAPI, from Mesa's synced copy - the same header the Vulkan driver's
+ * winsys includes. It differs from a stock kernel only by this project's local
+ * DRM_PVR_BO_CPU_CACHED addition; the dev-query structs are byte-identical to the
+ * running kernel's (sizeof(drm_pvr_dev_query_gpu_info) is 16 on both sides, and the
+ * kernel's minimum accepted size for it is 12, so passing sizeof is correct).
+ * Note the file next to the Vulkan winsys is that winsys's own struct header, not a
+ * second copy of the UAPI. */
+#include "drm-uapi/pvr_drm.h"
+
+#include "util/u_memory.h"
+#include "util/u_inlines.h"
+#include "util/os_time.h"
+#include "util/os_file.h"
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/format/u_formats.h"
+#include "util/u_screen.h"
+
+/* pco: the PowerVR compiler from src/imagination/pco, linked rather than rewritten. */
+#include "pco/pco.h"
+#include "pco/pco_data.h"
+#include "hwdef/rogue_hw_utils.h"
+#include "pco_uscgen_programs.h"
+
+#include "pvr_context.h"
+#include "pvr_resource.h"
+
+static const char *
+pvr_get_name(struct pipe_screen *pscreen)
+{
+   return pvr_screen(pscreen)->name;
+}
+
+static const char *
+pvr_get_vendor(struct pipe_screen *pscreen)
+{
+   return "Imagination Technologies";
+}
+
+static const char *
+pvr_get_device_vendor(struct pipe_screen *pscreen)
+{
+   return "Imagination Technologies";
+}
+
+/* What this answers, and what it does NOT.
+ *
+ * It claims: the driver can back a resource of this format with memory and describe its
+ * layout linearly, because resource_create has no size limit and the layout is linear.
+ *
+ * It does NOT claim the driver can build a hardware descriptor for the format. It cannot:
+ * there is no pipe_format -> hardware format mapping yet (round 28 - the encodings live in
+ * struct pvr_format.tex_format on the Vulkan side, keyed by VkFormat), so nothing can tell
+ * the hardware how to read such a resource. The gap is stated here rather than left implied
+ * because this function being permissive is what lets EGL build configs and DRI hand them
+ * out; the difference between "GL initialises" and "GL can be given a texture" is exactly
+ * the missing mapping, and a reader who took this return value as descriptor readiness
+ * would be wrong.
+ *
+ * Compressed and subsampled layouts are refused rather than accepted and described wrongly. */
+static bool
+pvr_is_format_supported(UNUSED struct pipe_screen *pscreen,
+                        enum pipe_format format,
+                        enum pipe_texture_target target,
+                        unsigned sample_count,
+                        unsigned storage_sample_count,
+                        unsigned bindings)
+{
+   const struct util_format_description *desc;
+
+   /* Cube maps are six twiddled faces in a plain 8-bit format; other targets are refused (the state
+    * tracker converts where it can, or the allocation fails honestly). */
+   if (target == PIPE_TEXTURE_CUBE &&
+       format != PIPE_FORMAT_R8G8B8A8_UNORM && format != PIPE_FORMAT_B8G8R8A8_UNORM &&
+       format != PIPE_FORMAT_R8G8B8X8_UNORM && format != PIPE_FORMAT_B8G8R8X8_UNORM)
+      return false;
+
+   if (sample_count > 1 || storage_sample_count > 1)
+      return false;
+
+   desc = util_format_description(format);
+   if (desc == NULL || desc->layout != UTIL_FORMAT_LAYOUT_PLAIN)
+      return false;
+
+   /* Only what the draw path can use, so the state tracker converts the rest (RGB8 textures to
+    * RGBX8, integer vertex attributes to float) instead of handing over formats it then rejects.
+    * B5G6R5 is refused explicitly on top of that: the TPU decode of 16-bit packed colour reads
+    * back black on this hardware, so the state tracker converts RGB565 textures to RGBX8/RGBA8
+    * instead (which also gives them working mip chains, since the converted target formats are
+    * twiddled with GPU-generated levels). R8/RG8 are left accepted but their TPU decode is
+    * unverified - a known limitation. */
+   if ((bindings & PIPE_BIND_SAMPLER_VIEW) &&
+       (format == PIPE_FORMAT_B5G6R5_UNORM ||
+        (!util_format_is_depth_or_stencil(format) && !pvr_draw_texture_format_supported(format))))
+      return false;
+   if ((bindings & (PIPE_BIND_RENDER_TARGET | PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_SCANOUT |
+                    PIPE_BIND_SHARED)) &&
+       format != PIPE_FORMAT_R8G8B8A8_UNORM && format != PIPE_FORMAT_B8G8R8A8_UNORM &&
+       format != PIPE_FORMAT_R8G8B8X8_UNORM && format != PIPE_FORMAT_B8G8R8X8_UNORM &&
+       format != PIPE_FORMAT_R8_UNORM && format != PIPE_FORMAT_R8G8_UNORM &&
+       format != PIPE_FORMAT_R8G8B8A8_SRGB && format != PIPE_FORMAT_B8G8R8A8_SRGB &&
+       format != PIPE_FORMAT_A8B8G8R8_SRGB &&
+       format != PIPE_FORMAT_R16_FLOAT && format != PIPE_FORMAT_R16G16_FLOAT &&
+       format != PIPE_FORMAT_R16G16B16A16_FLOAT)
+      return false;
+   if ((bindings & PIPE_BIND_DEPTH_STENCIL) &&
+       format != PIPE_FORMAT_Z16_UNORM && format != PIPE_FORMAT_Z24X8_UNORM &&
+       format != PIPE_FORMAT_Z24_UNORM_S8_UINT && format != PIPE_FORMAT_Z32_FLOAT &&
+       format != PIPE_FORMAT_S8_UINT)
+      return false;
+   /* The vertex fetch copies dwords that the shader reads as float. */
+   if ((bindings & PIPE_BIND_VERTEX_BUFFER) &&
+       (desc->channel[0].type != UTIL_FORMAT_TYPE_FLOAT || desc->channel[0].size != 32))
+      return false;
+   return true;
+}
+
+/* This driver never creates a fence - there is nothing to submit and so nothing to
+ * wait for - which makes the honest implementation "release whatever we were holding
+ * and clear the caller's pointer". It is reached unconditionally: st's throttle
+ * teardown calls it for every ring slot on every context destruction. */
+/* A fence is a syncobj holding a copy of the fence of the last render submitted before it. */
+struct pipe_fence_handle {
+   struct pipe_reference reference;
+   uint32_t syncobj;
+};
+
+struct pipe_fence_handle *
+pvr_fence_create(struct pvr_screen *screen, uint32_t render_sync)
+{
+   struct pipe_fence_handle *f = CALLOC_STRUCT(pipe_fence_handle);
+   if (f == NULL)
+      return NULL;
+   pipe_reference_init(&f->reference, 1);
+   if (drmSyncobjCreate(screen->fd, render_sync ? 0 : DRM_SYNCOBJ_CREATE_SIGNALED,
+                        &f->syncobj) != 0 ||
+       (render_sync && drmSyncobjTransfer(screen->fd, f->syncobj, 0, render_sync, 0, 0) != 0)) {
+      if (f->syncobj)
+         drmSyncobjDestroy(screen->fd, f->syncobj);
+      FREE(f);
+      return NULL;
+   }
+   return f;
+}
+
+static void
+pvr_fence_reference(struct pipe_screen *pscreen, struct pipe_fence_handle **ptr,
+                    struct pipe_fence_handle *fence)
+{
+   struct pipe_fence_handle *old = *ptr;
+   if (pipe_reference(old ? &old->reference : NULL, fence ? &fence->reference : NULL)) {
+      drmSyncobjDestroy(pvr_screen(pscreen)->fd, old->syncobj);
+      FREE(old);
+   }
+   *ptr = fence;
+}
+
+static bool
+pvr_fence_finish(struct pipe_screen *pscreen, UNUSED struct pipe_context *pctx,
+                 struct pipe_fence_handle *fence, uint64_t timeout)
+{
+   const int64_t deadline = timeout == OS_TIMEOUT_INFINITE ? INT64_MAX
+                                                           : os_time_get_absolute_timeout(timeout);
+   return drmSyncobjWait(pvr_screen(pscreen)->fd, &fence->syncobj, 1, deadline, 0, NULL) == 0;
+}
+
+static void
+pvr_destroy_screen(struct pipe_screen *pscreen)
+{
+   struct pvr_screen *screen = pvr_screen(pscreen);
+
+   if (screen->pco_ctx != NULL)
+      ralloc_free(screen->pco_ctx);
+   for (unsigned i = 0; i < screen->nr_bo_cache; i++) {
+      struct pvr_bo_cache_entry *e = &screen->bo_cache[i];
+      pvr_bo_unmap(&e->bo);
+      pvr_vm_unmap(&screen->vm, e->dev_addr, e->dev_size);
+      pvr_vm_free(&screen->vm, e->dev_addr, e->dev_size);
+      pvr_bo_destroy(screen->fd, &e->bo);
+   }
+   simple_mtx_destroy(&screen->bo_cache_lock);
+   if (screen->vm_valid)
+      pvr_vm_finish(&screen->vm);
+   if (screen->fd >= 0)
+      close(screen->fd);
+   ralloc_free(screen);
+}
+
+struct pipe_screen *
+pvr_screen_create(int fd, const struct pipe_screen_config *config,
+                  struct renderonly *ro)
+{
+   /* Refuse to bind to the vendor driver: pvrsrvkm NULL-dereferences when a normal client opens
+    * it (four hard resets on 2026-10-30 came from exactly that). The native driver only speaks the
+    * open powervr kernel UAPI. */
+   {
+      drmVersionPtr ver = drmGetVersion(fd);
+      const bool ok = ver != NULL && ver->name != NULL &&
+                      strcmp(ver->name, "powervr") == 0;
+
+      if (!ok) {
+         mesa_loge("pvr: refusing to initialise on '%s' - the native driver needs the open 'powervr'"
+                   " kernel driver, not the vendor 'pvrsrvkm' (which crashes on client open)",
+                   ver != NULL && ver->name != NULL ? ver->name : "unknown");
+         if (ver)
+            drmFreeVersion(ver);
+         return NULL;
+      }
+      drmFreeVersion(ver);
+   }
+
+   struct pvr_screen *screen = rzalloc(NULL, struct pvr_screen);
+   if (!screen)
+      return NULL;
+
+   screen->fd = fd;
+   screen->gpu_id = 0;
+
+   /* Enumerate the device through the same DRM interface the Vulkan driver uses.
+    * drm_pvr_dev_query_gpu_info.gpu_id packs BVNC as four 16-bit fields: B|V|N|C. */
+   {
+      struct drm_pvr_dev_query_gpu_info query = { 0 };
+      struct drm_pvr_ioctl_dev_query_args args = {
+         .type = DRM_PVR_DEV_QUERY_GPU_INFO_GET,
+         .size = sizeof(query),
+         .pointer = (__u64)&query,
+      };
+
+      if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) == 0 &&
+          pvr_device_info_init(&screen->dev_info, query.gpu_id) == 0) {
+         const struct pvr_device_ident *ident = &screen->dev_info.ident;
+
+         screen->gpu_id = query.gpu_id;
+         screen->num_phantoms = query.num_phantoms;
+         snprintf(screen->name, sizeof(screen->name), "PowerVR %s %s (%u.%u.%u.%u)",
+                  ident->series_name, ident->public_name,
+                  ident->b, ident->v, ident->n, ident->c);
+         mesa_logi("pvr: %s, device_id 0x%08x, gpu_id 0x%llx", screen->name,
+                   ident->device_id, (unsigned long long)query.gpu_id);
+      } else {
+         /* Not fatal for a skeleton: say we could not identify it rather than pretend. */
+         snprintf(screen->name, sizeof(screen->name), "PowerVR Rogue (query failed)");
+         mesa_logi("pvr: DRM_IOCTL_PVR_DEV_QUERY / device lookup failed on fd=%d", fd);
+      }
+   }
+   mesa_logi("pvr: pvr_screen_create fd=%d -> %s (draw path: compute fallback until the 3D path is usable)", fd, screen->name);
+
+   /* Where pco plugs into gallium: the compiler's NIR options, handed to the state
+    * tracker. This is the one place the linked compiler is reached from the screen;
+    * shader compilation itself needs the context path, which does not exist yet. */
+   for (unsigned i = 0; i < ARRAY_SIZE(screen->base.nir_options); i++)
+      screen->base.nir_options[i] = pco_nir_options();
+
+   /* Caps. u_init_pipe_screen_caps() supplies the defaults every driver relies on;
+    * 'caps' is const in struct pipe_screen, so it is filled through a cast, which is
+    * what the other drivers do (see vc4_screen.c). Only what can be sourced honestly
+    * is set here: identity from the .pdsc table, and the two facts that are simply
+    * true of this part. Numeric limits wait until resources exist to honour them -
+    * declaring a texture size the driver cannot allocate would be a lie the state
+    * tracker then builds tables on. Zeroed shader caps are safe: st_extensions.c
+    * skips a stage outright when max_instructions is 0. */
+   u_init_pipe_screen_caps(&screen->base, 1);
+   {
+      struct pipe_caps *caps = (struct pipe_caps *)&screen->base.caps;
+      const struct pvr_device_ident *ident = &screen->dev_info.ident;
+
+      /* Numeric limits. These describe what THIS DRIVER supports, not what the
+       * hardware could do, which is the distinction that keeps them honest:
+       *   - 2D size comes from the hardware (rogue_get_render_size_max, the same
+       *     helper the Vulkan driver uses) and the driver can back it, because
+       *     resource_create has no size limit;
+       *   - cube, 3D and array are refused by resource_create, so they are reported as
+       *     absent rather than advertised and then refused;
+       *   - one level because mipmaps are refused.
+       * Reporting the hardware's full texture capability here would be claiming
+       * features the resource code would reject. */
+      caps->max_texture_2d_size = rogue_get_render_size_max(&screen->dev_info);
+      /* Varying vec4 slots between stages. ES2 needs 8; each one is one DOUTI iterator of the
+       * coefficient program (pvr_draw.c), well under PVR_MAXIMUM_ITERATIONS. */
+      caps->max_varyings = 16;
+      caps->max_texture_cube_levels = util_logbase2(caps->max_texture_2d_size) + 1;
+      caps->max_texture_3d_levels = 0;
+      caps->max_texture_array_layers = 1;
+      /* Any extent samples and renders (twiddled levels are padded to powers of two). */
+      caps->npot_textures = true;
+      /* Instanced drawing: the index-list block carries the instance count and per-instance vertex
+       * attributes advance by their divisor (PDS instance-rate flag). ES2 GLSL has no
+       * gl_InstanceID, so the cap's system-value meaning only arises in ES3 shaders, which this
+       * driver does not expose yet. */
+      caps->vs_instanceid = true;
+      /* pco lowers ddx/ddy for the fragment stage (nir_intrinsic_ddx/ddy in pco_trans_nir), so
+       * GL_OES_standard_derivatives can be advertised. */
+      caps->fragment_shader_derivatives = true;
+      /* Half-float textures are filterable on this core (has_pbe_filterable_f16), so
+       * GL_OES_texture_half_float_linear can be advertised. 32-bit float filtering is not
+       * available and is not claimed. */
+      if (PVR_HAS_FEATURE(&screen->dev_info, pbe_filterable_f16))
+         caps->texture_half_float_linear = true;
+      caps->vertex_element_instance_divisor = true;
+      /* The TPU has FLIP_ONCE_THEN_CLAMP, which is exactly GL_MIRROR_CLAMP_TO_EDGE (mirror once past
+       * the edge, then clamp). Sampler state already maps PIPE_TEX_WRAP_MIRROR_CLAMP_TO_EDGE to it. */
+      caps->texture_mirror_clamp_to_edge = true;
+      /* TPU anisoctl supports x2..x16; the sampler descriptor previously hardcoded DISABLED. */
+      caps->anisotropic_filter = true;
+      caps->max_texture_anisotropy = 16.0f;
+      /* The emulated polygon offset applies the clamp value, so the clamped variant is honest. */
+      caps->polygon_offset_clamp = true;
+      /* Multiple render targets: the PBE writes one emit per attachment (EOT program) and the
+       * fragment variant maps data0..3. ES3 needs 4; v1 requires a shared format (see flush). */
+      caps->max_render_targets = 4;
+      caps->generate_mipmap = true; /* GPU box filter renders, pvr_generate_mipmap */
+
+      /* Separate RGB/alpha blend equations. Not a guess: Mesa's own ES2 requirement
+       * list (version.c compute_version_es2) is exactly three extensions -
+       * ARB_vertex_shader, ARB_fragment_shader and EXT_blend_equation_separate - and
+       * without this one no ES2 context can be created at all, which is why eglinfo
+       * offered only an ES1 one and glmark2-es2 could not make a canvas. ES2 mandates
+       * glBlendEquationSeparate, so any ES2-capable part supports it. */
+      caps->blend_equation_separate = true;
+
+      caps->device_type = PIPE_DEVICE_TYPE_INTEGRATED_GPU;
+      caps->uma = true;             /* the GPU shares system RAM on this SoC */
+      caps->vendor_id = 0x1010;     /* Imagination Technologies PCI vendor ID */
+      caps->device_id = ident->device_id;
+
+      /* Two Mesa caps default to true in u_init_pipe_screen_caps() on the assumption that a driver
+       * which does not clear them supports the feature. This one does not: a fragment shader
+       * writing gl_FragDepthEXT would be silently ignored (the variant builder has no depth
+       * output), and comparison sampling has no compare mode in the sampler descriptor. Clearing
+       * the caps withdraws GL_EXT_frag_depth and GL_EXT_shadow_samplers, which is the honest
+       * answer. (Border clamp cannot be withdrawn this way: Mesa's extension table marks it
+       * dummy_true for ES2, so it stays advertised - documented limitation, scoped as a
+       * sampler-border work item.) */
+      caps->fragment_shader_depth = false;
+      caps->texture_shadow_map = false;
+   }
+
+   /* Runtime info: free-list sizing and the shader limits, which pco needs before it
+    * can be created. Same dev-queries and the same translation the Vulkan driver
+    * performs (winsys/powervr/pvr_drm.c). */
+   {
+      struct drm_pvr_dev_query_runtime_info kmd = { 0 };
+      struct drm_pvr_ioctl_dev_query_args rt_args = {
+         .type = DRM_PVR_DEV_QUERY_RUNTIME_INFO_GET,
+         .size = sizeof(kmd),
+         .pointer = (__u64)&kmd,
+      };
+
+      if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &rt_args) == 0) {
+         screen->dev_runtime_info.min_free_list_size =
+            (uint64_t)kmd.free_list_min_pages << ROGUE_BIF_PM_PHYSICAL_PAGE_SHIFT;
+         screen->dev_runtime_info.max_free_list_size =
+            (uint64_t)kmd.free_list_max_pages << ROGUE_BIF_PM_PHYSICAL_PAGE_SHIFT;
+         screen->dev_runtime_info.reserved_shared_size =
+            kmd.common_store_alloc_region_size;
+         screen->dev_runtime_info.total_reserved_partition_size =
+            kmd.common_store_partition_space_size;
+         screen->dev_runtime_info.max_coeffs = kmd.max_coeffs;
+         screen->dev_runtime_info.cdm_max_local_mem_size_regs =
+            kmd.cdm_max_local_mem_size_regs;
+
+         /* The kernel has no core-count query yet; the Vulkan driver also pins this to
+          * 1 with a finishme, and matching that is more honest than inventing one. */
+         screen->dev_runtime_info.core_count = 1;
+         screen->dev_runtime_info.num_phantoms = screen->num_phantoms;
+      } else {
+         mesa_logi("pvr: runtime info query failed; the compiler will not be created");
+      }
+   }
+
+   /* The compiler. pco_ctx_create needs the device and runtime info; the USC library
+    * is a blob generated at build time from the OpenCL sources in pco/usclib. */
+   screen->pco_ctx = pco_ctx_create(&screen->dev_info, &screen->dev_runtime_info, NULL);
+   if (screen->pco_ctx != NULL)
+      pco_ctx_setup_usclib(screen->pco_ctx, pco_usclib_0_nir, sizeof(pco_usclib_0_nir));
+   else
+      mesa_logi("pvr: could not create the pco compiler context");
+
+   screen->region_header_dwords = rogue_get_region_header_size(&screen->dev_info);
+   screen->region_clip_align =
+      16u + 16u * !PVR_HAS_FEATURE(&screen->dev_info, tile_size_16x16);
+
+   /* GPU address space. Failure here is not fatal to enumeration - it only means no
+    * resource can be created, which is worth being able to see when probing a node
+    * this driver cannot actually drive. */
+   screen->vm_valid = pvr_vm_init(fd, &screen->vm);
+   if (!screen->vm_valid)
+      mesa_logi("pvr: no GPU address space; resources will not be creatable");
+
+   simple_mtx_init(&screen->bo_cache_lock, mtx_plain);
+   const char *dbg = getenv("PVR_NATIVE_DEBUG");
+   screen->no_twiddle = dbg != NULL && strstr(dbg, "no_twiddle") != NULL;
+   screen->no_fbc = dbg != NULL && strstr(dbg, "no_fbc") != NULL;
+
+   screen->base.destroy = pvr_destroy_screen;
+   screen->base.get_name = pvr_get_name;
+   screen->base.get_vendor = pvr_get_vendor;
+   screen->base.get_device_vendor = pvr_get_device_vendor;
+   screen->base.is_format_supported = pvr_is_format_supported;
+   /* Shader caps. A non-zero max_instructions is what makes a stage exist at all -
+       * with it zero the state tracker skips the stage and GL is pinned at 1.5.
+       *
+       * These values are deliberately conservative, and the distinction matters:
+       * max_texture_samplers/max_sampler_views (32) come from the limits the Vulkan
+       * driver declares for this same hardware, but the rest are under-claims rather
+       * than measured hardware limits. Under-claiming is safe - GL reports a smaller
+       * limit and nothing breaks - whereas over-claiming would have shaders accepted
+       * that the hardware then rejects. They must be replaced with real limits from
+       * the ISA/PDSC before any of these numbers are quoted as the hardware's.
+       *
+       * max_const_buffer0_size matters more than it looks: the state tracker divides
+       * it by 4 to get MaxUniformComponents, so leaving it zero would give shaders no
+       * uniforms at all. */
+   {
+      struct pipe_shader_caps *sc;
+
+      sc = (struct pipe_shader_caps *)&screen->base.shader_caps[MESA_SHADER_VERTEX];
+      sc->max_instructions = 4096;
+      sc->max_alu_instructions = 1024;
+      sc->max_tex_instructions = 512;
+      sc->max_tex_indirections = 8;
+      sc->max_inputs = 16;
+      /* Position, point size and the varyings. */
+      sc->max_outputs = 18;
+      sc->max_temps = 64;
+      sc->max_const_buffer0_size = 1024;
+      sc->max_const_buffers = 4;
+      sc->max_texture_samplers = 32;
+      sc->max_sampler_views = 32;
+      /* NIR only: pco is a NIR compiler, so the state tracker must hand over NIR. */
+      sc->supported_irs = 1 << PIPE_SHADER_IR_NIR;
+      /* pco compiles NIR integer operations natively; without this the state tracker stores int
+       * uniforms as floats while the shader reads them as integers (a loop bounded by uniform
+       * int 1 ran 0x3f800000 times). */
+      sc->integers = true;
+
+      sc = (struct pipe_shader_caps *)&screen->base.shader_caps[MESA_SHADER_FRAGMENT];
+      sc->max_instructions = 4096;
+      sc->max_alu_instructions = 1024;
+      sc->max_tex_instructions = 512;
+      sc->max_tex_indirections = 8;
+      sc->max_inputs = 16;
+      /* One colour target. */
+      sc->max_outputs = 1;
+      sc->max_temps = 64;
+      sc->max_const_buffer0_size = 1024;
+      sc->max_const_buffers = 4;
+      sc->max_texture_samplers = 32;
+      sc->max_sampler_views = 32;
+      sc->supported_irs = 1 << PIPE_SHADER_IR_NIR;
+      /* pco compiles NIR integer operations natively; without this the state tracker stores int
+       * uniforms as floats while the shader reads them as integers (a loop bounded by uniform
+       * int 1 ran 0x3f800000 times). */
+      sc->integers = true;
+   }
+
+   screen->base.fence_reference = pvr_fence_reference;
+   screen->base.fence_finish = pvr_fence_finish;
+   screen->base.context_create = pvr_context_create;
+   screen->base.resource_create = pvr_resource_create;
+   screen->base.resource_destroy = pvr_resource_destroy;
+   screen->base.resource_get_handle = pvr_resource_get_handle;
+   screen->base.resource_from_handle = pvr_resource_from_handle;
+
+   return &screen->base;
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_screen.h b/src/gallium/drivers/pvr_native/pvr_screen.h
new file mode 100644
index 00000000..0e05e6b5
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_screen.h
@@ -0,0 +1,84 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef PVR_SCREEN_H
+#define PVR_SCREEN_H
+
+#include "pipe/p_screen.h"
+#include "util/simple_mtx.h"
+
+#include "common/pvr_device_info.h"
+#include "pco/pco.h"
+#include "pvr_bo.h"
+#include "pvr_vm.h"
+
+struct pvr_screen {
+   struct pipe_screen base;
+
+   int fd;
+
+   /* Device identity, from the kernel UAPI query. Populated by pvr_screen_create.
+    * dev_info comes from src/imagination/common, which is generated from the .pdsc
+    * device descriptions - reused, not rewritten. */
+   struct pvr_device_info dev_info;
+
+   /* pco needs the runtime info as well as the device info - free-list sizes and the
+    * shader limits come from a separate dev-query. */
+   struct pvr_device_runtime_info dev_runtime_info;
+
+   /* The linked PowerVR compiler. Shared by every shader this screen compiles. */
+   pco_ctx *pco_ctx;
+   char name[64];
+   unsigned int gpu_id;
+
+   /* Dwords a geometry job's region header occupies, from rogue_get_region_header_size -
+    * 6 on devices with the simple internal parameter format at version 2, 5 otherwise.
+    * Computed here rather than in the CSB writer on purpose: the writer needs the number,
+    * not the device, and the generated csbgen headers and the hwdef headers cannot both
+    * be included in the same file (the latter makes __pvr_address_type pvr_dev_addr_t,
+    * which the generated packets then fail to compile against). */
+   uint32_t region_header_dwords;
+
+   /* TA clip-region alignment: 16 with 16x16 tiles, 32 otherwise. */
+   uint32_t region_clip_align;
+   unsigned int num_phantoms;
+
+   /* GPU address space. vm_valid is false when the heaps or VM context could not be
+    * set up, which leaves enumeration working but resource creation unavailable -
+    * a useful distinction when probing a node this driver cannot drive. */
+   struct pvr_vm vm;
+   bool vm_valid;
+
+   /* PVR_NATIVE_DEBUG=no_twiddle,no_fbc: linear (or uncompressed) render targets, read once. */
+   bool no_twiddle, no_fbc;
+
+   /* USC code and PDS bytes are uploaded once per program and then referenced by heap-relative
+    * address for the life of the context; bump-allocating them from a chunk keeps that at one
+    * mapping instead of a BO per program (terrain re-uploads an EOT program on most mip blits). */
+   struct pvr_prog_arena {
+      struct pvr_bo bo;
+      uint64_t addr, base;
+      uint32_t used, size;
+   } usc_arena, pds_arena;
+
+   /* Released buffer resources kept mapped (CPU and GPU) for reuse: the stream uploader replaces
+    * its 1 MiB buffer about once a frame with client arrays, and a new BO costs a kernel
+    * allocation, a VM map, an mmap and its page faults. A released resource is idle (renders hold
+    * references until they are waited for). */
+   simple_mtx_t bo_cache_lock;
+   struct pvr_bo_cache_entry {
+      struct pvr_bo bo;
+      uint64_t dev_addr, dev_size;
+   } bo_cache[8];
+   unsigned nr_bo_cache;
+};
+
+static inline struct pvr_screen *
+pvr_screen(struct pipe_screen *pscreen)
+{
+   return (struct pvr_screen *)pscreen;
+}
+
+struct pipe_fence_handle *pvr_fence_create(struct pvr_screen *screen, uint32_t render_sync);
+
+#endif /* PVR_SCREEN_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.c b/src/gallium/drivers/pvr_native/pvr_shader.c
new file mode 100644
index 00000000..c7c942e7
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_shader.c
@@ -0,0 +1,1015 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#include "pvr_shader.h"
+
+#include "pco/pco_data.h"
+#include "pco/pco_internal.h"
+#include "pco_uscgen_programs.h"
+#include "pvr_pds.h"
+
+#include "stdlib.h"
+
+#include "util/log.h"
+#include "util/format/u_format.h"
+
+bool pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir,
+                                    pco_data *data, pco_shader **shader_out,
+                                    const void **data_out, unsigned *size_out);
+
+/* Fills the driver half of pco's vertex-input interface. pco cannot discover either fact from the
+ * NIR alone: pco_nir_pvi() synthesises the fetch/convert instructions only for attribute locations
+ * whose attrib_formats[] entry is not NONE, and pco_trans_nir.c's trans_load_input_vs() names the
+ * vtxin registers through attribs[]. The Vulkan driver fills both from pipeline state; this is the
+ * same data from the same source, the shader's declared inputs.
+ *
+ * ponytail: the format is derived from the declared type instead of taken from vertex element
+ * state, so only 32-bit float attributes are described. A GL vertex element can disagree (half,
+ * int, normalised), which is a different format, not a different count - when the frontend feeds
+ * real vertex elements, pass their pipe_format in here instead of deriving it. */
+static enum pipe_format
+pvr_shader_attr_format(const struct glsl_type *type)
+{
+   const struct glsl_type *scalar = glsl_without_array(type);
+
+   if (!glsl_type_is_vector_or_scalar(scalar) || glsl_get_bit_size(scalar) != 32 ||
+       !glsl_base_type_is_float(glsl_get_base_type(scalar)))
+      return PIPE_FORMAT_NONE;
+
+   switch (glsl_get_vector_elements(scalar)) {
+   case 1: return PIPE_FORMAT_R32_FLOAT;
+   case 2: return PIPE_FORMAT_R32G32_FLOAT;
+   case 3: return PIPE_FORMAT_R32G32B32_FLOAT;
+   case 4: return PIPE_FORMAT_R32G32B32A32_FLOAT;
+   default: return PIPE_FORMAT_NONE;
+   }
+}
+
+static void
+pvr_shader_alloc_range(pco_range *ranges, unsigned *counter, nir_variable *var,
+                       unsigned dwords_each)
+{
+   unsigned slots = glsl_count_dword_slots(var->type, false);
+
+   ranges[var->data.location] =
+      (pco_range){ .start = *counter, .count = slots * dwords_each };
+   *counter += slots * dwords_each;
+}
+
+/* Before pco_preprocess/lower: only the formats. pco_nir_pvi() runs inside lowering and decides
+ * which attributes to synthesise from attrib_formats[]; a location with no format is skipped and
+ * its loads stay unlowered, which is the silent failure this project paid two rounds for. */
+static void
+pvr_shader_init_vs_formats(struct nir_shader *nir, pco_data *data)
+{
+   nir_foreach_shader_in_variable (var, nir) {
+      if (var->data.location < 0 || var->data.location >= VERT_ATTRIB_MAX)
+         continue;
+
+      data->vs.attrib_formats[var->data.location] =
+         pvr_shader_attr_format(var->type);
+   }
+}
+
+/* After lowering, before translation: the register map the translator reads.
+ *
+ * This runs after pco_lower_nir() and not before it for the same reason the Vulkan driver allocates
+ * here: pco's lowering adds outputs the shader did not declare (a vertex shader gets a gl_PointSize
+ * write), so a map built from the pre-lowering NIR would miss them and the translator would write
+ * them to register 0. */
+static uint64_t
+pvr_shader_vs_outputs_written(struct nir_shader *nir)
+{
+   uint64_t outputs = 0;
+
+   nir_foreach_variable_with_modes (var, nir, nir_var_shader_out) {
+      if (var->data.location >= 0 && var->data.location < VARYING_SLOT_MAX)
+         outputs |= BITFIELD64_BIT(var->data.location);
+   }
+
+   return outputs;
+}
+
+static void
+pvr_shader_alloc_sysval(pco_range *ranges, unsigned *counter, unsigned location,
+                        unsigned count)
+{
+   ranges[location] = (pco_range){ .start = *counter, .count = count };
+   *counter += count;
+}
+
+/* GL uniforms arrive as load_uniform with base and offset in vec4 slots (the state tracker's
+ * unpacked layout of constant buffer 0). pco has no load_uniform; it loads Vulkan push constants
+ * from shared registers, so each uniform load becomes a push-constant load at the byte offset. */
+static bool
+pvr_shader_lower_uniform(struct nir_builder *b, nir_intrinsic_instr *intr, UNUSED void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_uniform)
+      return false;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *offset = nir_imul_imm(b, nir_iadd_imm(b, intr->src[0].ssa, nir_intrinsic_base(intr)),
+                                  16);
+   nir_def *load = nir_load_push_constant(b, intr->def.num_components, intr->def.bit_size,
+                                          offset, .base = 0,
+                                          .range = nir_intrinsic_range(intr) * 16);
+   nir_def_replace(&intr->def, load);
+   return true;
+}
+
+/* GL texture and sampler indices are units; pco reads them as packed (set, binding), so unit u
+ * becomes set 0, binding u. */
+static bool
+pvr_shader_pack_tex_index(UNUSED struct nir_builder *b, nir_instr *instr, UNUSED void *data)
+{
+   if (instr->type != nir_instr_type_tex)
+      return false;
+   nir_tex_instr *tex = nir_instr_as_tex(instr);
+   tex->texture_index = pco_pack_desc(0, tex->texture_index);
+   tex->sampler_index = pco_pack_desc(0, tex->sampler_index);
+   return true;
+}
+
+/* Fragment inputs, as the Vulkan driver's pvr_alloc_fs_varyings: z/w first, then each varying slot
+ * in location order, ROGUE_USC_COEFFICIENT_SET_SIZE coefficient registers per component. */
+static void
+pvr_shader_init_fs_alloc(struct nir_shader *nir, pco_data *data)
+{
+   uint64_t vars_mask = nir->info.inputs_read & BITFIELD64_RANGE(VARYING_SLOT_VAR0, MAX_VARYING);
+   const unsigned zw_count = !!data->fs.uses.z + !!data->fs.uses.w;
+
+   pvr_shader_alloc_sysval(data->fs.varyings, &data->common.coeffs, VARYING_SLOT_POS,
+                           zw_count * ROGUE_USC_COEFFICIENT_SET_SIZE);
+   while (vars_mask) {
+      const int location = u_bit_scan64(&vars_mask);
+      unsigned slots = 0;
+      nir_foreach_variable_with_modes (var, nir, nir_var_shader_in) {
+         if (var->data.location == location)
+            slots += glsl_count_dword_slots(var->type, false);
+      }
+      pvr_shader_alloc_sysval(data->fs.varyings, &data->common.coeffs, location,
+                              slots * ROGUE_USC_COEFFICIENT_SET_SIZE);
+   }
+}
+
+/* The vertex-input and varying maps, ported from the Vulkan driver's
+ * pvr_alloc_vs_sysvals/pvr_alloc_vs_attribs/pvr_alloc_vs_varyings. The ordering there is
+ * load-bearing on this hardware - varyings are grouped by interpolation mode and the last slots
+ * come last - so this is a port, not a re-derivation. */
+static void
+pvr_shader_init_vs_alloc(struct nir_shader *nir, pco_data *data)
+{
+   pco_vs_data *vs = &data->vs;
+
+   /* Attributes: one contiguous vtxin range per declared input, in declaration order (the same
+    * order the attribute DMA is built in). */
+   nir_foreach_shader_in_variable (var, nir) {
+      if (var->data.location < 0 || var->data.location >= VERT_ATTRIB_MAX)
+         continue;
+
+      pvr_shader_alloc_range(vs->attribs, &data->common.vtxins, var, 1);
+   }
+
+   /* System values a vertex shader can read are pre-filled by the PDS program, also in vtxin
+    * registers, so they extend the same range. */
+   {
+      BITSET_DECLARE(system_values_read, SYSTEM_VALUE_MAX);
+      BITSET_COPY(system_values_read, nir->info.system_values_read);
+
+      const gl_system_value sys_vals[] = {
+         SYSTEM_VALUE_VERTEX_ID,   SYSTEM_VALUE_INSTANCE_ID,
+         SYSTEM_VALUE_BASE_INSTANCE, SYSTEM_VALUE_BASE_VERTEX,
+         SYSTEM_VALUE_DRAW_ID,     SYSTEM_VALUE_VIEW_INDEX,
+      };
+
+      for (unsigned u = 0; u < ARRAY_SIZE(sys_vals); ++u) {
+         if (!BITSET_TEST(system_values_read, sys_vals[u]))
+            continue;
+
+         const unsigned dwords =
+            nir_intrinsic_infos[nir_intrinsic_from_system_value(sys_vals[u])].dest_components;
+
+         pvr_shader_alloc_sysval(data->common.sys_vals, &data->common.vtxins,
+                                 sys_vals[u], dwords);
+      }
+   }
+
+   /* Outputs: position first, then generic varyings grouped by interpolation mode, then the
+    * special slots. */
+   nir_foreach_variable_with_modes (var, nir, nir_var_shader_out) {
+      if (var->data.location == VARYING_SLOT_POS)
+         pvr_shader_alloc_range(vs->varyings, &vs->vtxouts, var, 1);
+   }
+
+   uint64_t vars_mask = pvr_shader_vs_outputs_written(nir) &
+                        BITFIELD64_RANGE(VARYING_SLOT_VAR0, MAX_VARYING);
+
+   nir_foreach_variable_with_modes (var, nir, nir_var_shader_out) {
+      if (var->data.location < VARYING_SLOT_VAR0 ||
+          var->data.location >= VARYING_SLOT_VAR0 + MAX_VARYING)
+         continue;
+
+      ASSERTED bool f16 = glsl_type_is_16bit(glsl_without_array_or_matrix(var->type));
+      assert(!f16);
+      const unsigned components = glsl_get_components(var->type);
+
+      switch (var->data.interpolation) {
+      case INTERP_MODE_NONE:
+         /* pco's reverse-linking pass did not run; the reference overrides here too. */
+         var->data.interpolation = INTERP_MODE_SMOOTH;
+         FALLTHROUGH;
+      case INTERP_MODE_SMOOTH:
+         if (f16) vs->f16_smooth += components;
+         else vs->f32_smooth += components;
+         break;
+      case INTERP_MODE_FLAT:
+         if (f16) vs->f16_flat += components;
+         else vs->f32_flat += components;
+         break;
+      case INTERP_MODE_NOPERSPECTIVE:
+         if (f16) vs->f16_npc += components;
+         else vs->f32_npc += components;
+         break;
+      default:
+         UNREACHABLE("invalid interpolation mode");
+      }
+   }
+
+   for (unsigned f16 = 0; f16 <= 1; ++f16) {
+      for (enum glsl_interp_mode interp = INTERP_MODE_SMOOTH;
+           interp <= INTERP_MODE_NOPERSPECTIVE; ++interp) {
+         uint64_t skipped = 0;
+
+         while (vars_mask) {
+            const int location = u_bit_scan64(&vars_mask);
+            unsigned slots = 0;
+
+            nir_foreach_variable_with_modes (var, nir, nir_var_shader_out) {
+               if (var->data.location != location)
+                  continue;
+
+               if (glsl_type_is_16bit(glsl_without_array_or_matrix(var->type)) != f16 ||
+                   var->data.interpolation != interp) {
+                  /* Wrong group for this pass; retry after the current group. */
+                  skipped |= BITFIELD64_BIT(location);
+                  break;
+               }
+
+               slots = glsl_count_dword_slots(var->type, false);
+               break;
+            }
+
+            if (slots != 0)
+               pvr_shader_alloc_sysval(vs->varyings, &vs->vtxouts, location, slots);
+         }
+
+         vars_mask |= skipped;
+      }
+   }
+   assert(vars_mask == 0);
+
+   const gl_varying_slot last_slots[] = {
+      VARYING_SLOT_PSIZ,       VARYING_SLOT_VIEWPORT,   VARYING_SLOT_LAYER,
+      VARYING_SLOT_CLIP_DIST0, VARYING_SLOT_CLIP_DIST1,
+   };
+
+   for (unsigned u = 0; u < ARRAY_SIZE(last_slots); ++u) {
+      const uint64_t outputs = pvr_shader_vs_outputs_written(nir);
+      nir_variable *var = nir_find_variable_with_location(nir, nir_var_shader_out,
+                                                          last_slots[u]);
+      if (var == NULL || !(outputs & BITFIELD64_BIT(last_slots[u])))
+         continue;
+
+      pvr_shader_alloc_range(vs->varyings, &vs->vtxouts, var, 1);
+   }
+}
+
+static struct pvr_shader *
+pvr_shader_create_with(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_format *color_formats,
+                       unsigned nr_formats, const nir_lower_blend_options *blend)
+{
+   struct pvr_shader *shader = calloc(1, sizeof(*shader));
+   pco_data data = { 0 };
+   if (shader == NULL)
+      return NULL;
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      unsigned output_start = 0;
+      for (unsigned i = 0; i < MIN2(nr_formats, PVR_MAX_COLOR_ATTACHMENTS); i++) {
+         /* Take the next free pixel-output dwords: an 8-bit colour output is one dword, a 16F one
+          * is two. The EOT program's per-attachment PBE emit reads from this position (its
+          * source_pos), matching the reference's usc_mrt_resource output_reg allocation. */
+         const unsigned dwords = pvr_pbe_output_dwords(color_formats[i]);
+         data.fs.output_formats[FRAG_RESULT_DATA0 + i] = color_formats[i];
+         data.fs.outputs[FRAG_RESULT_DATA0 + i] = (pco_range){ .start = output_start,
+                                                              .count = dwords };
+         output_start += dwords;
+      }
+      /* Blending is lowered into the shader (pco runs nir_lower_blend with these). */
+      if (blend != NULL && nr_formats > 0 && color_formats[0] != PIPE_FORMAT_NONE) {
+         data.fs.blend_opts = *blend;
+         for (unsigned i = 0; i < MIN2(nr_formats, PVR_MAX_COLOR_ATTACHMENTS); i++)
+            data.fs.blend_opts.rt[i].format = color_formats[i];
+         data.fs.masked_outputs = blend->rt[0].colormask == 0;
+      }
+      /* No depth replication into a colour output: 0 would mean "replicate into output 0", which
+       * makes pco write the fragment's depth over the colour (the Vulkan driver sets ~0u too). */
+      data.fs.z_replicate = ~0u;
+      /* Single-sampled with sample 0 enabled and no alpha-to-coverage (all this driver renders):
+       * without these pco inserts runtime coverage checks that read a dynamic-state shared
+       * register nothing here fills, and the zero mask discards every fragment. */
+      data.fs.no_alpha_to_coverage = true;
+      data.fs.skip_sample_check = true;
+   }
+   if (!pvr_shader_compile_data(ctx, nir, &data, &shader->pco, &shader->binary,
+                                &shader->binary_size)) {
+      free(shader);
+      return NULL;
+   }
+
+   /* The entry function is the first in the list; its temps are what the PDS kick program is built
+    * from. The vtxin count is the driver-side attribute allocation: pco's register allocator
+    * currently allocates no vtxins of its own (pco_ra.c has a FIXME that disables it) because the
+    * attribute loads read the vtxin registers directly - so the function-level count is always 0
+    * and the range count is what the hardware state needs. */
+   if (shader->pco != NULL && !list_is_empty(&shader->pco->funcs)) {
+      struct _pco_func *entry = list_first_entry(&shader->pco->funcs, struct _pco_func, link);
+
+      shader->temps = entry->temps;
+      shader->vtxins = data.common.vtxins;
+   }
+   shader->vtxouts = data.vs.vtxouts;
+   shader->uniform_dwords = data.common.push_consts.range.count;
+   shader->uniform_dst = data.common.push_consts.range.start;
+   shader->tex_mask = 0;
+   shader->shared_dma_start = data.common.shareds;
+   if (shader->uniform_dwords)
+      shader->shared_dma_start = shader->uniform_dst;
+   if (data.common.desc_sets[0].used) {
+      const pco_descriptor_set_data *set = &data.common.desc_sets[0];
+      for (unsigned u = 0; u < set->binding_count; u++) {
+         if (!set->bindings[u].used)
+            continue;
+         shader->tex_mask |= BITFIELD_BIT(u);
+         shader->tex_dst[u] = set->bindings[u].range.start;
+      }
+      shader->shared_dma_start = MIN2(shader->shared_dma_start, set->range.start);
+   }
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      shader->discard = data.fs.uses.discard;
+      shader->fbfetch = data.fs.uses.fbfetch;
+      shader->masked = data.fs.masked_outputs;
+      if (data.fs.blend_consts.count) {
+         shader->blend_mask = data.fs.blend_consts_needed;
+         shader->blend_dst = data.fs.blend_consts.start;
+         shader->shared_dma_start = MIN2(shader->shared_dma_start, shader->blend_dst);
+      }
+   }
+   shader->shared_dma_dwords = data.common.shareds - shader->shared_dma_start;
+   shader->shareds = data.common.shareds;
+   if (nir->info.stage == MESA_SHADER_VERTEX) {
+      for (unsigned l = 0; l < ARRAY_SIZE(shader->varyings); l++) {
+         shader->varyings[l].start = data.vs.varyings[l].start;
+         shader->varyings[l].count = data.vs.varyings[l].count;
+      }
+      shader->f32_smooth = data.vs.f32_smooth;
+      shader->f32_flat = data.vs.f32_flat;
+      shader->f32_npc = data.vs.f32_npc;
+   }
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      shader->varyings_read =
+         nir->info.inputs_read & BITFIELD64_RANGE(VARYING_SLOT_VAR0, MAX_VARYING);
+      for (unsigned l = 0; l < ARRAY_SIZE(shader->varyings); l++) {
+         shader->varyings[l].start = data.fs.varyings[l].start;
+         shader->varyings[l].count = data.fs.varyings[l].count;
+      }
+      nir_foreach_variable_with_modes (var, nir, nir_var_shader_in) {
+         if (var->data.location >= 0 && var->data.location < ARRAY_SIZE(shader->varyings))
+            shader->varyings[var->data.location].interp = var->data.interpolation;
+      }
+      shader->uses_z = data.fs.uses.z;
+      shader->uses_w = data.fs.uses.w;
+   }
+
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      shader->shareds = data.common.shareds;
+      shader->coeffs = data.common.coeffs;
+      shader->phase_change = data.fs.uses.phase_change;
+   }
+
+   if (nir->info.stage == MESA_SHADER_VERTEX) {
+      nir_foreach_shader_in_variable (var, nir) {
+         const pco_range *r;
+         if (var->data.location < 0 || var->data.location >= VERT_ATTRIB_MAX ||
+             shader->nr_inputs >= ARRAY_SIZE(shader->inputs))
+            continue;
+         r = &data.vs.attribs[var->data.location];
+         shader->inputs[shader->nr_inputs].element = var->data.driver_location;
+         shader->inputs[shader->nr_inputs].vtxin = r->start;
+         shader->inputs[shader->nr_inputs].dwords = r->count;
+         shader->nr_inputs++;
+      }
+   }
+
+   return shader;
+}
+
+struct pvr_shader *
+pvr_shader_create(struct nir_shader *nir, pco_ctx *ctx)
+{
+   return pvr_shader_create_with(nir, ctx, NULL, 0, NULL);
+}
+
+struct pvr_shader *
+pvr_shader_create_fs(struct nir_shader *nir, pco_ctx *ctx, const enum pipe_format *color_formats,
+                     unsigned nr_formats, const nir_lower_blend_options *blend)
+{
+   return pvr_shader_create_with(nir, ctx, color_formats, nr_formats, blend);
+}
+
+/* The one-attribute vertex DMA both builders are generated from. Shared so the code and its data
+ * segment always describe the same fetch: a program patched against a different DMA than it was
+ * generated for is a mismatch nothing downstream would catch. */
+static void
+pvr_shader_vertex_primary_input(struct pvr_pds_vertex_primary_program_input *input,
+                                struct pvr_pds_vertex_dma *dma,
+                                uint32_t stride, uint32_t attrib_bytes,
+                                uint8_t destination, uint32_t usc_temps)
+{
+   *dma = (struct pvr_pds_vertex_dma){
+      .offset = 0,
+      .stride = stride,
+      .size_in_dwords = attrib_bytes / 4,
+      .attrib_size_in_bytes = attrib_bytes,
+      .destination = destination,
+      .binding_index = 0,
+      .divisor = 0,
+   };
+   *input = (struct pvr_pds_vertex_primary_program_input){
+      .dma_list = dma,
+      .dma_count = 1,
+   };
+
+   /* The DOUTU that ends the attribute program is what starts the vertex shader. Its execution
+    * address and temp count live in the DATA segment's DOUTU_ADDRESS entry (patched by
+    * pvr_shader_vertex_data), not in the code - so the code builder can pass 0 for usc_temps. */
+   pvr_pds_setup_doutu(&input->usc_task_control, 0, usc_temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, false);
+}
+
+/* PDS const-map offsets are in dwords (the Vulkan driver's PVR_WRITE indexes a typed buffer), not
+ * bytes: writing at a byte offset lands each value inside the previous one. */
+static void
+pvr_shader_data_write(void *data, uint32_t data_bytes, uint32_t const_offset_dw, const void *value,
+                      uint32_t value_bytes)
+{
+   const uint32_t at = const_offset_dw * sizeof(uint32_t);
+   if (at + value_bytes <= data_bytes)
+      memcpy((uint8_t *)data + at, value, value_bytes);
+}
+
+uint32_t
+pvr_shader_vertex_data(const struct pvr_device_info *dev_info,
+                       uint64_t vertex_buffer_addr, uint64_t usc_exec_addr,
+                       void *data_out, uint32_t data_size,
+                       uint32_t stride, uint32_t attrib_bytes,
+                       uint8_t destination, uint32_t usc_temps)
+{
+   struct pvr_pds_vertex_dma dma;
+   struct pvr_pds_vertex_primary_program_input input;
+   struct pvr_pds_info info = { 0 };
+   const uint8_t *entry;
+   const uint8_t *end;
+   uint32_t produced;
+
+   pvr_shader_vertex_primary_input(&input, &dma, stride, attrib_bytes, destination, usc_temps);
+
+   /* 512 was too small: the generator wrote past it and corrupted the heap (glibc reported
+    * "unaligned tcache chunk detected"). Sized for the largest entry set a vertex program can
+    * produce rather than for the one-attribute case that happened to fit. */
+   info.entries_size_in_bytes = 4096;
+   info.entries = calloc(1, info.entries_size_in_bytes);
+   if (info.entries == NULL)
+      return 0;
+
+   /* Generate the program into a scratch buffer purely to obtain its const map. */
+   pvr_pds_generate_vertex_primary_program(&input, NULL, &info, false, dev_info);
+   produced = info.data_size_in_dwords * sizeof(uint32_t);
+
+   if (produced == 0 || produced > data_size) {
+      free(info.entries);
+      return 0;
+   }
+
+   memset(data_out, 0, produced);
+
+   /* Walk the const map by entry TYPE. The entries are not all the same size, and advancing by one
+    * entry's size through a list of mixed types lands in the middle of the next entry - which
+    * silently patches the wrong dword or misses the one that matters. */
+   entry = (const uint8_t *)info.entries;
+   end = entry + MIN2(info.entries_written_size_in_bytes, info.entries_size_in_bytes);
+
+   while (entry + sizeof(struct pvr_const_map_entry) <= end) {
+      const struct pvr_const_map_entry *header = (const struct pvr_const_map_entry *)entry;
+
+      switch (header->type) {
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_DOUTU_ADDRESS: {
+         const struct pvr_const_map_entry_doutu_address *e = (const void *)entry;
+         uint64_t value = 0;
+
+         /* The shader's USC offset in the encoding DOUTU takes, ORed with the generator's control
+          * word (temp count, sample rate). */
+         pvr_set_usc_execution_address64(&value, usc_exec_addr);
+         value |= e->doutu_control;
+
+         pvr_shader_data_write(data_out, produced, e->const_offset, &value, sizeof(value));
+         entry += sizeof(*e);
+         break;
+      }
+
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_VERTEX_ATTRIBUTE_ADDRESS: {
+         const struct pvr_const_map_entry_vertex_attribute_address *e = (const void *)entry;
+         const uint64_t addr = vertex_buffer_addr + e->offset;
+
+         pvr_shader_data_write(data_out, produced, e->const_offset, &addr, sizeof(addr));
+         entry += sizeof(*e);
+         break;
+      }
+
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_VERTEX_ATTRIBUTE_STRIDE: {
+         const struct pvr_const_map_entry_vertex_attribute_stride *e = (const void *)entry;
+
+         /* The DMA computes address = buffer + (index * stride) + offset; the stride is the one
+          * fact here that comes from the draw, not from the shader. */
+         pvr_shader_data_write(data_out, produced, e->const_offset, &stride, sizeof(stride));
+         entry += sizeof(*e);
+         break;
+      }
+
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL32: {
+         /* Literals are values the generated code reads from the data segment (the DMA control
+          * word among them); skipping them leaves those constants zero. */
+         const struct pvr_const_map_entry_literal32 *e = (const void *)entry;
+         pvr_shader_data_write(data_out, produced, e->const_offset, &e->literal_value,
+                               sizeof(e->literal_value));
+         entry += sizeof(*e);
+         break;
+      }
+      case PVR_PDS_CONST_MAP_ENTRY_TYPE_LITERAL64: {
+         const struct pvr_const_map_entry_literal64 *e = (const void *)entry;
+         pvr_shader_data_write(data_out, produced, e->const_offset, &e->literal_value,
+                               sizeof(e->literal_value));
+         entry += sizeof(*e);
+         break;
+      }
+
+      default:
+         /* An entry type with no patch rule here would leave a data word zero that the generator
+          * expected a value in. Refuse the whole segment rather than return one that reads
+          * plausibly. */
+         mesa_loge("pvr: no patch rule for PDS const-map entry type %u", header->type);
+         free(info.entries);
+         return 0;
+      }
+   }
+
+   free(info.entries);
+   return produced;
+}
+
+uint32_t
+pvr_shader_vertex_program(const struct pvr_device_info *dev_info,
+                          void *dst, uint32_t dst_size,
+                          uint32_t stride, uint32_t attrib_bytes,
+                          uint8_t destination,
+                          struct pvr_shader_vertex_program_info *info_out)
+{
+   struct pvr_pds_vertex_dma dma;
+   struct pvr_pds_vertex_primary_program_input input;
+   struct pvr_pds_info info = { 0 };
+   uint32_t size_bytes = 0;
+
+   /* usc_temps = 0 is deliberate: the DOUTU control word (and therefore the temp count) is in the
+    * data segment, not the code, so the code is identical whatever the shader's temps are. */
+   pvr_shader_vertex_primary_input(&input, &dma, stride, attrib_bytes, destination, 0);
+
+   /* The const map is where the program's immediate/descriptor references are recorded. A vertex
+    * program with no uniform reads needs few or none, but the generator writes into this buffer, so it
+    * has to exist and be sized. */
+   /* 512 was too small: the generator wrote past it and corrupted the heap (glibc reported
+    * "unaligned tcache chunk detected"). Sized for the largest entry set a vertex program can
+    * produce rather than for the one-attribute case that happened to fit. */
+   info.entries_size_in_bytes = 4096;
+   info.entries = calloc(1, info.entries_size_in_bytes);
+   if (info.entries == NULL)
+      return 0;
+
+   /* First pass with no destination: the generator reports the size it would write. */
+   pvr_pds_generate_vertex_primary_program(&input, NULL, &info, false, dev_info);
+   size_bytes = info.code_size_in_dwords * sizeof(uint32_t);
+
+   if (info_out != NULL) {
+      info_out->temp_dwords = info.temps_required;
+      info_out->data_dwords = info.data_size_in_dwords;
+   }
+
+   if (size_bytes > 0 && size_bytes <= dst_size && dst != NULL) {
+      pvr_pds_generate_vertex_primary_program(&input, dst, &info, false, dev_info);
+   } else {
+      size_bytes = 0;
+   }
+
+   free(info.entries);
+   return size_bytes;
+}
+
+uint32_t
+pvr_shader_pds_launcher(const struct pvr_shader *shader, uint32_t usc_offset,
+                        void *dst, uint32_t dst_size,
+                        struct pvr_shader_pds_launcher_info *info_out)
+{
+   struct pvr_pds_kickusc_program program = { 0 };
+   uint32_t *end;
+   uint32_t total_bytes;
+
+   if (shader == NULL)
+      return 0;
+
+   pvr_pds_setup_doutu(&program.usc_task_control, usc_offset, shader->temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE,
+                       shader->phase_change);
+
+   /* Sizes first: the TA names the data segment and needs its length, and the caller has to place
+    * data+code contiguously in the PDS heap before generating into it. */
+   pvr_pds_kick_usc(&program, NULL, 0, false, PDS_GENERATE_SIZES);
+   total_bytes = PVR_DW_TO_BYTES(program.data_size + program.code_size);
+
+   if (info_out != NULL) {
+      info_out->data_dwords = program.data_size;
+      info_out->code_dwords = program.code_size;
+   }
+
+   if (dst == NULL || total_bytes == 0 || total_bytes > dst_size)
+      return 0;
+
+   end = pvr_pds_kick_usc(&program, (uint32_t *)dst, 0, false, PDS_GENERATE_CODEDATA_SEGMENTS);
+
+   return end == NULL ? 0 : total_bytes;
+}
+
+void
+pvr_shader_destroy(struct pvr_shader *shader)
+{
+   if (shader == NULL)
+      return;
+
+   for (unsigned i = 0; i < shader->nr_variants; i++)
+      pvr_shader_destroy(shader->variants[i].sh);
+   ralloc_free(shader->src_nir);
+   ralloc_free(shader->pco);
+   free(shader);
+}
+
+bool
+pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
+                        pco_shader **shader_out, const void **data_out,
+                        unsigned *size_out)
+{
+   pco_shader *shader;
+   unsigned size;
+
+   if (ctx == NULL) {
+      mesa_loge("pvr: no pco context; the compiler was never initialised");
+      return false;
+   }
+
+   /* Order matters and is copied from the Vulkan driver's pipeline creation. Getting it
+    * wrong yields a plausible binary rather than an error. The vertex maps are split around
+    * lowering because pco's lowering both consumes the formats and adds outputs. */
+   if (nir->info.stage == MESA_SHADER_VERTEX)
+      pvr_shader_init_vs_formats(nir, data);
+
+   /* GL's single colour output arrives as FRAG_RESULT_COLOR; pco and the output map work on
+    * DATA0..7, as the Vulkan driver's shaders do. */
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      nir_foreach_shader_out_variable (var, nir) {
+         if (var->data.location == FRAG_RESULT_COLOR)
+            var->data.location = FRAG_RESULT_DATA0;
+      }
+   }
+   NIR_PASS(_, nir, nir_shader_intrinsics_pass, pvr_shader_lower_uniform,
+            nir_metadata_control_flow, NULL);
+   /* Texture units as bindings of pco descriptor set 0, each a combined image sampler, as the
+    * reference's pvr_init_descriptors declares them. */
+   const uint32_t tex_mask = nir->info.textures_used[0] & BITFIELD_MASK(PVR_SHADER_MAX_TEX);
+   NIR_PASS(_, nir, nir_shader_instructions_pass, pvr_shader_pack_tex_index, nir_metadata_all,
+            NULL);
+   if (tex_mask) {
+      pco_descriptor_set_data *set = &data->common.desc_sets[0];
+      set->binding_count = util_last_bit(tex_mask);
+      set->bindings = rzalloc_array_size(nir, sizeof(*set->bindings), set->binding_count);
+      u_foreach_bit (u, tex_mask)
+         set->bindings[u].is_img_smp = true;
+   }
+   /* GL clip space has z in [-w, w]; the hardware clips to [0, w], as Vulkan does. Without this
+    * the near half of the depth range is clipped away (pvr_draw.c maps the depth viewport to
+    * match). */
+   if (nir->info.stage == MESA_SHADER_VERTEX)
+      NIR_PASS(_, nir, nir_lower_clip_halfz);
+   pco_preprocess_nir(ctx, nir, data);
+   pco_lower_nir(ctx, nir, data);
+   pco_postprocess_nir(ctx, nir, data);
+   /* Push constants (the lowered uniforms) live in shared registers after any the shader has. An
+    * indirect access reads the whole buffer the shader declares. */
+   if (data->common.push_consts.used > 0) {
+      const unsigned count = data->common.push_consts.used == ~0U ? nir->num_uniforms * 4
+                                                                  : data->common.push_consts.used;
+      data->common.push_consts.range = (pco_range){ .start = data->common.shareds, .count = count };
+      data->common.shareds += count;
+   }
+   /* Then the blend constants the lowered blending reads, one dword per needed channel. */
+   if (nir->info.stage == MESA_SHADER_FRAGMENT && data->fs.blend_consts_needed) {
+      data->fs.blend_consts = (pco_range){ .start = data->common.shareds,
+                                           .count = util_bitcount(data->fs.blend_consts_needed) };
+      data->common.shareds += data->fs.blend_consts.count;
+   }
+   /* Then the texture descriptors, as the reference's pvr_setup_descriptors places them. */
+   if (tex_mask) {
+      pco_descriptor_set_data *set = &data->common.desc_sets[0];
+      data->common.shareds = ALIGN_POT(data->common.shareds, 4);
+      set->used = true;
+      set->range = (pco_range){ .start = data->common.shareds,
+                                .count = set->binding_count * PVR_TEX_BINDING_DWORDS };
+      for (unsigned u = 0; u < set->binding_count; u++) {
+         set->bindings[u].used = (tex_mask >> u) & 1;
+         set->bindings[u].range = (pco_range){
+            .start = data->common.shareds + u * PVR_TEX_BINDING_DWORDS,
+            .count = PVR_TEX_BINDING_DWORDS,
+            .stride = PVR_TEX_BINDING_DWORDS,
+         };
+      }
+      data->common.shareds += set->range.count;
+   }
+
+   if (nir->info.stage == MESA_SHADER_VERTEX)
+      pvr_shader_init_vs_alloc(nir, data);
+   if (nir->info.stage == MESA_SHADER_FRAGMENT)
+      pvr_shader_init_fs_alloc(nir, data);
+
+   /* The colour output goes to output register 0, sized for the target format (Vulkan's
+    * pvr_setup_fs_outputs with one output-register MRT). */
+   if (nir->info.stage == MESA_SHADER_FRAGMENT &&
+       data->fs.output_formats[FRAG_RESULT_DATA0] != PIPE_FORMAT_NONE &&
+       nir_find_variable_with_location(nir, nir_var_shader_out, FRAG_RESULT_DATA0) != NULL) {
+      data->fs.outputs[FRAG_RESULT_DATA0] = (pco_range){
+         .start = 0,
+         .count = DIV_ROUND_UP(util_format_get_blocksize(
+                                  data->fs.output_formats[FRAG_RESULT_DATA0]), 4),
+      };
+   }
+   shader = pco_trans_nir(ctx, nir, data, NULL);
+   if (shader == NULL) {
+      mesa_loge("pvr: pco failed to translate %s", nir->info.name);
+      return false;
+   }
+
+   /* The shader now owns the NIR. This is the reference's rule (pvr_usc.c's build_shader does
+    * ralloc_steal(shader, nir)) and it is not optional: pco_shader keeps a pointer to the NIR, so
+    * a caller that frees it while the shader lives corrupts the heap at some later allocation -
+    * which shows up nowhere near the free. Callers must not free the NIR they hand over. */
+   ralloc_steal(shader, nir);
+
+   pco_process_ir(ctx, shader);
+   pco_encode_ir(ctx, shader);
+
+   size = pco_shader_binary_size(shader);
+   if (size == 0) {
+      mesa_loge("pvr: pco encoded no code for %s", nir->info.name);
+      return false;
+   }
+
+   *shader_out = shader;
+   *data_out = pco_shader_binary_data(shader);
+   *size_out = size;
+
+   return true;
+}
+
+
+/* Minimal compute compile: spirv_to_nir hands us the NIR, this runs the same pco pipeline as the
+ * reference (preprocess -> lower -> postprocess -> trans) with the driver-side data pco needs for a
+ * dispatch: descriptor bindings for the shader's resources, the compute system-value registers and
+ * the descriptor shared-register ranges the PDS descriptor program will fill. */
+struct pvr_compute_binding_desc {
+   unsigned desc_set;
+   unsigned binding;
+   unsigned size_in_dwords;
+};
+
+bool
+pvr_shader_compile_compute(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
+                           pco_shader **shader_out, const void **binary_out,
+                           unsigned *size_out)
+{
+   unsigned max_binding[ARRAY_SIZE(data->common.desc_sets)] = { 0 };
+   nir_variable *var;
+   unsigned set;
+   unsigned size;
+
+   data->common.literal_pool = true;
+
+   pco_preprocess_nir(ctx, nir, data);
+
+   nir_foreach_variable_with_modes (var, nir, nir_var_mem_ssbo | nir_var_mem_ubo |
+                                                 nir_var_mem_global | nir_var_image |
+                                                 nir_var_uniform) {
+      unsigned set_idx = var->data.descriptor_set;
+      unsigned bind = var->data.binding;
+
+      if (set_idx >= ARRAY_SIZE(data->common.desc_sets))
+         continue;
+      max_binding[set_idx] = MAX2(max_binding[set_idx], bind + 1);
+   }
+   for (set = 0; set < ARRAY_SIZE(data->common.desc_sets); set++) {
+      if (max_binding[set] == 0)
+         continue;
+      data->common.desc_sets[set].binding_count = max_binding[set];
+      data->common.desc_sets[set].bindings =
+         rzalloc_array_size(NULL, sizeof(pco_binding_data), max_binding[set]);
+   }
+
+   pco_lower_nir(ctx, nir, data);
+   pco_postprocess_nir(ctx, nir, data);
+
+   /* Compute system values: local invocation index lives in the vertex-input registers, workgroup
+    * id and workgroup count in the coefficients (the same split the reference uses). */
+   {
+      BITSET_DECLARE(system_values_read, SYSTEM_VALUE_MAX);
+      static const gl_system_value vtxin_sys_vals[] = { SYSTEM_VALUE_LOCAL_INVOCATION_INDEX };
+      static const gl_system_value coeff_sys_vals[] = { SYSTEM_VALUE_WORKGROUP_ID,
+                                                        SYSTEM_VALUE_NUM_WORKGROUPS };
+
+      BITSET_COPY(system_values_read, nir->info.system_values_read);
+      for (unsigned u = 0; u < ARRAY_SIZE(vtxin_sys_vals); u++) {
+         if (!BITSET_TEST(system_values_read, vtxin_sys_vals[u]))
+            continue;
+         {
+            unsigned dwords = nir_intrinsic_infos[nir_intrinsic_from_system_value(
+               vtxin_sys_vals[u])].dest_components;
+
+            data->common.sys_vals[vtxin_sys_vals[u]] =
+               (pco_range){ .start = data->common.vtxins, .count = dwords };
+            data->common.vtxins += dwords;
+         }
+         BITSET_CLEAR(system_values_read, vtxin_sys_vals[u]);
+      }
+      for (unsigned u = 0; u < ARRAY_SIZE(coeff_sys_vals); u++) {
+         if (!BITSET_TEST(system_values_read, coeff_sys_vals[u]))
+            continue;
+         {
+            unsigned dwords = nir_intrinsic_infos[nir_intrinsic_from_system_value(
+               coeff_sys_vals[u])].dest_components;
+
+            if (dwords > 1 && (data->common.coeffs & 1))
+               data->common.coeffs++;
+            data->common.sys_vals[coeff_sys_vals[u]] =
+               (pco_range){ .start = data->common.coeffs, .count = dwords };
+            data->common.coeffs += dwords;
+         }
+         BITSET_CLEAR(system_values_read, coeff_sys_vals[u]);
+      }
+
+      /* Workgroup-id components are the ones the PDS program must write. */
+      data->cs.workgroup_id_mask = 0;
+      nir_foreach_function_impl (impl, nir) {
+         nir_foreach_block (block, impl) {
+            nir_foreach_instr (instr, block) {
+               nir_intrinsic_instr *intr;
+
+               if (instr->type != nir_instr_type_intrinsic)
+                  continue;
+               intr = nir_instr_as_intrinsic(instr);
+               if (intr->intrinsic == nir_intrinsic_load_workgroup_id)
+                  data->cs.workgroup_id_mask |= nir_def_components_read(&intr->def);
+            }
+         }
+      }
+      data->cs.workgroup_id_mask = BITFIELD_MASK(util_last_bit(
+         data->cs.workgroup_id_mask ? data->cs.workgroup_id_mask : 3));
+   }
+
+   /* Shared memory handling (none for a shader that does not use it). */
+   data->cs.shmem.count = nir->info.shared_size;
+   data->cs.shmem.start = data->common.coeffs;
+   data->common.coeffs += data->cs.shmem.count >> 2;
+
+   /* Descriptor shared-register ranges: one buffer descriptor (16 B) per binding. */
+   data->common.shareds = ALIGN_POT(data->common.shareds, 4);
+   for (set = 0; set < ARRAY_SIZE(data->common.desc_sets); set++) {
+      pco_descriptor_set_data *desc_set = &data->common.desc_sets[set];
+      unsigned desc_set_size_dw = 0;
+
+      if (desc_set->binding_count == 0 || !desc_set->used)
+         continue;
+
+      for (unsigned b = 0; b < desc_set->binding_count; b++) {
+         pco_binding_data *bind = &desc_set->bindings[b];
+
+         if (!bind->used)
+            continue;
+         bind->range = (pco_range){ .start = desc_set_size_dw, .count = 4, .stride = 4 };
+         desc_set_size_dw += 4;
+      }
+      desc_set->range.start = data->common.shareds;
+      desc_set->range.count = desc_set_size_dw;
+      data->common.shareds += desc_set_size_dw;
+      for (unsigned b = 0; b < desc_set->binding_count; b++) {
+         pco_binding_data *bind = &desc_set->bindings[b];
+
+         if (!bind->used)
+            continue;
+         bind->range.start += desc_set->range.start;
+      }
+   }
+
+   *shader_out = pco_trans_nir(ctx, nir, data, NULL);
+   if (*shader_out == NULL) {
+      mesa_loge("pvr: pco failed to translate %s", nir->info.name);
+      return false;
+   }
+   ralloc_steal(*shader_out, nir);
+   pco_process_ir(ctx, *shader_out);
+   pco_encode_ir(ctx, *shader_out);
+   size = pco_shader_binary_size(*shader_out);
+   if (size == 0) {
+      mesa_loge("pvr: pco encoded no code for %s", nir->info.name);
+      return false;
+   }
+   *binary_out = pco_shader_binary_data(*shader_out);
+   *size_out = size;
+   return true;
+}
+
+bool
+pvr_shader_eot_create(pco_ctx *ctx, struct pvr_shader_eot *eot,
+                      unsigned nr_attachments, const uint32_t *state_words)
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, pco_nir_options(),
+                                                  "pvr_eot");
+   nir_intrinsic_instr *last = NULL;
+   /* One pixel-event emit per colour attachment, as the reference's pvr_usc_eot: a wop between
+    * emits so the PBE processes them in order, and the last one owns the pixel (freep). */
+   for (unsigned u = 0; u < nr_attachments; u++) {
+      if (u > 0)
+         nir_wop_pco(&b);
+      last = nir_emitpix_pco(&b, nir_imm_int(&b, state_words[2 * u]),
+                             nir_imm_int(&b, state_words[2 * u + 1]));
+   }
+   pco_data data = { .fs.uses.olchk_skip = true };
+
+   if (last != NULL)
+      nir_intrinsic_set_freep(last, true);
+   nir_jump(&b, nir_jump_return);
+
+   if (!pvr_shader_compile_data(ctx, b.shader, &data, &eot->pco, &eot->binary,
+                                &eot->binary_size))
+      return false;
+
+   eot->temps = pco_shader_data(eot->pco)->common.temps;
+   return true;
+}
+
+bool
+pvr_shader_compile(pco_ctx *ctx, struct nir_shader *nir, pco_shader **shader_out,
+                   const void **data_out, unsigned *size_out)
+{
+   pco_data data = { 0 };
+
+   /* The vertex maps are filled inside pvr_shader_compile_data, at the points in the pipeline
+    * where pco needs them. */
+   return pvr_shader_compile_data(ctx, nir, &data, shader_out, data_out, size_out);
+}
+
+uint8_t
+pvr_shader_frag_coord_usage(const struct nir_shader *nir)
+{
+   uint8_t used = 0;
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+
+            if (intr->intrinsic != nir_intrinsic_load_frag_coord)
+               continue;
+
+            /* The union of the writemasks actually written: a shader that loads .xy in one place
+             * and .z elsewhere reads z, and a declaration scan would find neither reliably. */
+            used |= nir_def_components_read(&intr->def);
+         }
+      }
+   }
+
+   return used;
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_shader.h b/src/gallium/drivers/pvr_native/pvr_shader.h
new file mode 100644
index 00000000..0748a4e3
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_shader.h
@@ -0,0 +1,251 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * GLSL/SPIR-V-independent shader entry points: this is where pco, the compiler the
+ * Vulkan driver also uses, is actually run. Nothing here invents a compiler; it runs
+ * the linked one over the NIR the state tracker hands us.
+ */
+#ifndef PVR_SHADER_H
+#define PVR_SHADER_H
+
+#include <stdbool.h>
+
+#include <stdint.h>
+
+#include "pco/pco.h"
+#include "common/pvr_limits.h"
+#include "nir/nir_lower_blend.h"
+
+#include "util/format/u_formats.h"
+
+struct nir_shader;
+
+/* The end-of-tile (pixel-event) program: a tiny USC shader whose only job is to emit the pixel at
+ * end of tile through the pixel backend, using the PBE state words (target address, format) it is
+ * compiled with. The reference builds this per render target with pco (pvr_usc.c's pvr_usc_eot);
+ * without it the fragment job's CR_EVENT_PIXEL_PDS_DATA names a program that never writes anything. */
+struct pvr_shader_eot {
+   pco_shader *pco;
+   const void *binary;
+   unsigned binary_size;
+   unsigned temps;
+};
+
+bool pvr_shader_eot_create(pco_ctx *ctx, struct pvr_shader_eot *eot,
+                           unsigned nr_attachments, const uint32_t *state_words);
+
+/* The pixel-output dwords one colour attachment takes: the PBE reads its source data in the
+ * "PBE source format" - an sRGB target's source is 16-bit float per channel (two dwords), everything
+ * else is the target format's own size in dwords. The fragment variant's output ranges and the EOT's
+ * source_pos are both built from this. */
+static inline unsigned
+pvr_pbe_output_dwords(enum pipe_format format)
+{
+   if (util_format_is_srgb(format))
+      return 2;
+   return DIV_ROUND_UP(util_format_get_blocksize(format), 4u);
+}
+
+/* One compiled shader: the pco shader and the microcode it encoded. */
+/* A combined image sampler in shared registers: image words, image meta, sampler words, sampler
+ * meta (ROGUE_NUM_TEXSTATE_DWORDS and PCO_*_META_COUNT, four each). */
+#define PVR_TEX_BINDING_DWORDS 16
+#define PVR_SHADER_MAX_TEX 16
+#define PVR_SHADER_MAX_VARIANTS 6
+
+struct pvr_shader {
+   pco_shader *pco;
+   const void *binary;
+   unsigned binary_size;
+
+   /* What the PDS kick program needs. temps is the entry function's temp count, copied out of
+    * pco's internal per-function record rather than reaching into pco from the callers.
+    *
+    * vtxins is the driver-side attribute register count (pco_data.common.vtxins), not the entry
+    * function's: pco's register allocator has vtxin allocation disabled upstream (see the FIXME in
+    * pco_ra.c) because the attribute loads address the vtxin registers directly, so the
+    * function-level count is 0 even for a shader that reads attributes. The range count is what the
+    * hardware state needs. */
+   unsigned temps;
+   unsigned vtxins;
+   /* Varying registers the vertex shader writes per vertex (pco_data.vs.vtxouts): the TA's
+    * output-select vtxsize and the VDM state's vs_output_size both take this number. */
+   unsigned vtxouts;
+
+   /* Fragment stage only: shared/coefficient register counts and whether the shader changes phase.
+    * The TA's PDS SIZEINFO2 and the fragment kick program's DOUTU control word take them. */
+   unsigned shareds;
+   unsigned coeffs;
+   bool phase_change;
+
+   /* Vertex shader: where each vertex element lands in the vtxin registers (filled from pco's
+    * attribute map). element is the pipe_vertex_element index (the input's driver_location). */
+   unsigned nr_inputs;
+   struct {
+      uint8_t element;
+      uint8_t vtxin;
+      uint8_t dwords;
+   } inputs[16];
+
+   /* Fragment shader created from pipe state: the NIR to build per-format variants from, and the
+    * last variant (owned here). */
+   struct nir_shader *src_nir;
+   struct {
+      enum pipe_format formats[PVR_MAX_COLOR_ATTACHMENTS];
+      unsigned nr_formats;
+      nir_lower_blend_options blend;
+      struct pvr_shader *sh;
+   } variants[PVR_SHADER_MAX_VARIANTS];
+   unsigned nr_variants;
+
+   /* Fragment variant: what the ISP pass type follows from (discard, framebuffer fetch from
+    * blending, a masked colour output), and its blend constants in shared registers. */
+   bool discard, fbfetch, masked;
+   uint8_t blend_mask;
+   unsigned blend_dst;
+
+   /* Draw-path upload of this shader (pvr_draw.c): USC code offset, FS kick program offset and
+    * sizes, 0 until uploaded. */
+   uint32_t usc_offset;
+   uint32_t pds_offset;
+   uint32_t pds_data_dwords;
+   uint32_t pds_temps;
+
+   /* Varyings. Vertex shader: per slot, the vtxout range (position at 0) and the f32 component
+    * counts the TA's VARYING0 word takes. Fragment shader: per slot, the coefficient range and
+    * interpolation, plus whether it reads z/w (both iterated ahead of the varyings). */
+   struct {
+      uint8_t start, count, interp;
+   } varyings[64];
+   uint64_t varyings_read;
+   unsigned f32_smooth, f32_flat, f32_npc;
+   bool uses_z, uses_w;
+
+   /* Uniforms (constant buffer 0, vec4 slots as the state tracker lays them out) are loaded as
+    * push constants: the first uniform_dwords dwords of the buffer go to shared registers from
+    * uniform_dst on, by a PDS descriptor program the draw path builds. */
+   unsigned uniform_dwords;
+   unsigned uniform_dst;
+
+   /* Textures: GL unit u is pco descriptor set 0, binding u, a combined image sampler of
+    * PVR_TEX_BINDING_DWORDS dwords (image words, image meta, sampler words, sampler meta) in shared
+    * registers from tex_dst[u]. The uniforms and these descriptors form one contiguous shared block,
+    * [shared_dma_start, shared_dma_start + shared_dma_dwords), filled by one DMA per draw. */
+   uint32_t tex_mask;
+   unsigned tex_dst[PVR_SHADER_MAX_TEX];
+   unsigned shared_dma_start;
+   unsigned shared_dma_dwords;
+
+   /* Draw-path coefficient program of this fragment variant, for the vertex shader it was built
+    * against (pvr_draw.c). */
+   const struct pvr_shader *coeff_vs;
+   uint32_t coeff_offset;
+   uint32_t coeff_data_dwords;
+   uint32_t coeff_temps;
+};
+
+struct pvr_shader *pvr_shader_create(struct nir_shader *nir, pco_ctx *ctx);
+/* A fragment shader built for one colour-buffer format: gl_FragColor/DATA0 is packed to that format
+ * in output register 0, which is what the end-of-tile program reads. */
+struct pvr_shader *pvr_shader_create_fs(struct nir_shader *nir, pco_ctx *ctx,
+                                        const enum pipe_format *color_formats,
+                                        unsigned nr_formats,
+                                        const nir_lower_blend_options *blend);
+
+/* Compile any stage and hand back pco's data section as well (the compute path needs it). */
+bool pvr_shader_compile_data(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
+                             pco_shader **shader_out, const void **binary_out,
+                             unsigned *size_out);
+bool pvr_shader_compile_compute(pco_ctx *ctx, struct nir_shader *nir, pco_data *data,
+                                pco_shader **shader_out, const void **binary_out,
+                                unsigned *size_out);
+void pvr_shader_destroy(struct pvr_shader *shader);
+
+/* The launcher's two halves. The buffer it is generated into is [data segment][code segment] -
+ * that is the layout pvr_pds_kick_usc() writes and what pvr_up_upload_pds expects - and the TA
+ * names the DATA segment as the PDS program base, with the code following it. */
+struct pvr_shader_pds_launcher_info {
+   uint32_t data_dwords;
+   uint32_t code_dwords;
+};
+
+/* Builds the PDS launcher for a compiled shader into a byte buffer: the program that makes the
+ * USC run. `usc_offset` is the shader's offset within the USC code heap, which is what the hardware's
+ * doutu instruction takes. Returns the number of bytes written, or 0.
+ *
+ * The temps count and phase-change flag come from the compiled shader. */
+uint32_t pvr_shader_pds_launcher(const struct pvr_shader *shader, uint32_t usc_offset,
+                                 void *dst, uint32_t dst_size,
+                                 struct pvr_shader_pds_launcher_info *info_out);
+
+/* What the VDM state's STATE5 needs from the attribute program: how many PDS temps it uses and how
+ * big its data segment is, both in dwords. The hardware allocates those regions from these counts,
+ * so a wrong count is an allocation the shader runs off the end of. */
+struct pvr_shader_vertex_program_info {
+   uint32_t temp_dwords;
+   uint32_t data_dwords;
+};
+
+/* Builds the PDS program that fetches vertex attributes into the USC registers, and the const-map
+ * entries that describe them. This is the piece that turns "the TA has a draw" into "the TA can read
+ * vertices". One attribute is all a triangle needs: a position as three floats at offset 0.
+ *
+ * dst receives the program; returns its size in bytes, or 0. */
+uint32_t pvr_shader_vertex_program(const struct pvr_device_info *dev_info,
+                                   void *dst, uint32_t dst_size,
+                                   uint32_t stride, uint32_t attrib_bytes,
+                                   uint8_t destination,
+                                   struct pvr_shader_vertex_program_info *info_out);
+
+/* Builds the PDS DATA the vertex program reads: the const-map entries generated alongside the program,
+ * with two things patched in at their const_offset:
+ *  - the vertex buffer's address, at each VERTEX_ATTRIBUTE_ADDRESS entry;
+ *  - the vertex shader's USC offset, at the DOUTU_ADDRESS entry - that is the instruction that
+ *    starts the shader after the fetch, so without it the attribute program runs and nothing draws.
+ * The VDM state's vs_data_addr names THIS block, not the vertex buffer.
+ *
+ * usc_exec_addr is the shader's offset within the USC heap (what DOUTU takes), usc_temps its temp
+ * count (which goes into the DOUTU control word). Returns the data size in bytes, or 0. */
+uint32_t pvr_shader_vertex_data(const struct pvr_device_info *dev_info,
+                                uint64_t vertex_buffer_addr, uint64_t usc_exec_addr,
+                                void *data_out, uint32_t data_size,
+                                uint32_t stride, uint32_t attrib_bytes,
+                                uint8_t destination, uint32_t usc_temps);
+
+/* Runs the full pco pipeline over a NIR shader and returns the encoded binary.
+ *
+ * The sequence is the one the Vulkan driver uses (pvr_usc.c build_shader): preprocess,
+ * lower, postprocess, translate, process, encode. Reordering it produces a binary that
+ * is wrong rather than an error, which is why it is copied rather than guessed.
+ *
+ * Returns false if the compiler produced nothing. On success *data_out points at the
+ * binary, owned by the returned shader, and *size_out is its size in bytes.
+ */
+bool pvr_shader_compile(pco_ctx *ctx, struct nir_shader *nir, pco_shader **shader_out,
+                        const void **data_out, unsigned *size_out);
+
+/* Which components of gl_FragCoord a fragment shader actually reads, as a 4-bit mask in gallium's
+ * usual order (x=1, y=2, z=4, w=8).
+ *
+ * This is the analysis TA_OUTPUT_SEL needs: the reference fills tsp_unclamped_z_pres from its
+ * shader's use of z, and its generated header documents that field as "an unclamped Z value is
+ * written out at the start of the TSP data" - i.e. the TA must write out what the fragment stage
+ * reads, so "does the FS read z" is the question.
+ *
+ * NOTE ON rhw_pres: the same header says it "should be set unless the object is of type viewport",
+ * which is NOT the rule the reference implements (it uses the shader's use of w). Those disagree,
+ * and this function only answers what the SHADER uses - deciding which rule fills the field is a
+ * separate question that needs resolving before it is set from here.
+ *
+ * Reading gl_FragCoord is an intrinsic load, so the answer is the union of its destination
+ * writemasks across the shader, not a declaration scan: a shader may load it twice with different
+ * writemasks and only one of them matters. */
+#define PVR_SHADER_FRAG_X 0x1
+#define PVR_SHADER_FRAG_Y 0x2
+#define PVR_SHADER_FRAG_Z 0x4
+#define PVR_SHADER_FRAG_W 0x8
+
+struct nir_shader;
+uint8_t pvr_shader_frag_coord_usage(const struct nir_shader *nir);
+
+#endif /* PVR_SHADER_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_static.c b/src/gallium/drivers/pvr_native/pvr_static.c
new file mode 100644
index 00000000..55819d50
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_static.c
@@ -0,0 +1,606 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ */
+#include "pvr_static.h"
+
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "drm-uapi/pvr_drm.h"
+
+#include "common/pvr_device_info.h"
+#include "pco/pco_data.h"
+#include "pco_uscgen_programs.h"
+#include "pvr_pds.h"
+
+/* The reference driver fills the firmware's YUV CSC table at device init
+ * (pvr_winsys_helper_fill_static_memory -> pvr_setup_static_yuv_csc_table); the firmware may read it
+ * during job setup, and zeroed coefficients are not the same as the reference's values. */
+#include "pvr_ycbcr.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+
+#include "pvr_csb.h"
+#include "pvr_vm.h"
+
+/* The three heaps that carry firmware carveouts, in the order the kernel numbers them. */
+static const uint16_t pvr_static_heaps[3] = {
+   DRM_PVR_HEAP_GENERAL,
+   DRM_PVR_HEAP_PDS_CODE_DATA,
+   DRM_PVR_HEAP_USC_CODE,
+};
+
+static unsigned
+pvr_heap_slot(uint16_t heap_id)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(pvr_static_heaps); i++) {
+      if (pvr_static_heaps[i] == heap_id)
+         return i;
+   }
+
+   return ARRAY_SIZE(pvr_static_heaps);
+}
+
+/* The VDM sync program: a precompiled USC binary, plus the PDS program that launches it.
+ * Both halves are needed - the USC code is what runs, the PDS program is what makes the
+ * PDS start it. */
+static bool
+pvr_fill_vdm_sync(struct pvr_vm *vm, struct pvr_static_memory *sm)
+{
+   const unsigned pds_slot = pvr_heap_slot(DRM_PVR_HEAP_PDS_CODE_DATA);
+   const unsigned usc_slot = pvr_heap_slot(DRM_PVR_HEAP_USC_CODE);
+   const uint64_t pds_offset = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].vdm_sync;
+   const uint64_t usc_offset = vm->offsets[DRM_PVR_HEAP_USC_CODE].vdm_sync;
+   const pco_precomp_data *precomp;
+   struct pvr_pds_kickusc_program program = { 0 };
+   uint32_t *pds_dst;
+   uint32_t size_dwords;
+   uint32_t size_bytes;
+
+   if (pds_offset == PVR_STATIC_ABSENT || usc_offset == PVR_STATIC_ABSENT) {
+      mesa_loge("pvr: no VDM sync area in the PDS or USC heap");
+      return false;
+   }
+
+   precomp = (const pco_precomp_data *)pco_usclib_common[VS_NOP_COMMON];
+   if (precomp == NULL) {
+      mesa_loge("pvr: the precompiled VDM sync program is missing");
+      return false;
+   }
+
+   size_dwords = precomp->size_dwords;
+   size_bytes = size_dwords * sizeof(uint32_t);
+
+   if (usc_offset + size_bytes > sm->bo[usc_slot].size ||
+       pds_offset + size_bytes > sm->bo[pds_slot].size) {
+      mesa_loge("pvr: the VDM sync program (%u bytes) does not fit its areas",
+                size_bytes);
+      return false;
+   }
+
+   memcpy((uint8_t *)sm->map[usc_slot] + usc_offset, precomp->binary, size_bytes);
+
+   /* The PDS side points at where the USC code was just written - an offset within the
+    * USC heap, which is what the hardware's doutu instruction takes. */
+   pvr_pds_setup_doutu(&program.usc_task_control, usc_offset, precomp->temps,
+                       ROGUE_PDSINST_DOUTU_SAMPLE_RATE_INSTANCE, false);
+
+   pds_dst = (uint32_t *)((uint8_t *)sm->map[pds_slot] + pds_offset);
+   pvr_pds_kick_usc(&program, pds_dst, 0, false, PDS_GENERATE_CODEDATA_SEGMENTS);
+
+   sm->program_bytes += size_bytes;
+
+   mesa_logd("pvr: VDM sync: %u bytes of USC at +0x%" PRIx64
+             ", PDS launcher at +0x%" PRIx64, size_bytes, usc_offset, pds_offset);
+
+   return true;
+}
+
+/* The pixel-event (end of tile) program the firmware runs when a tile completes. */
+static bool
+pvr_fill_pixel_event(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                     struct pvr_static_memory *sm)
+{
+   const unsigned pds_slot = pvr_heap_slot(DRM_PVR_HEAP_PDS_CODE_DATA);
+   const uint64_t eot_offset = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].eot;
+   struct pvr_pds_event_program program = { 0 };
+   uint32_t *dst;
+   uint32_t *end;
+   unsigned size;
+
+   if (eot_offset == PVR_STATIC_ABSENT) {
+      mesa_loge("pvr: no EOT area in the PDS heap");
+      return false;
+   }
+
+   dst = (uint32_t *)((uint8_t *)sm->map[pds_slot] + eot_offset);
+
+   /* Returns where the next constant would go, so the program's size is the distance
+    * from where it was written - there is no separate size out-parameter. */
+   end = pvr_pds_generate_pixel_event(&program, dst, PDS_GENERATE_CODE_SEGMENT,
+                                      dev_info);
+   size = (uint8_t *)end - (uint8_t *)dst;
+
+   if (size == 0) {
+      mesa_loge("pvr: could not generate the pixel-event program");
+      return false;
+   }
+
+   if (eot_offset + size > sm->bo[pds_slot].size) {
+      mesa_loge("pvr: the pixel-event program (%u bytes) does not fit the EOT area",
+                size);
+      return false;
+   }
+
+   sm->program_bytes += size;
+
+   mesa_logd("pvr: pixel-event program: %u bytes at PDS +0x%" PRIx64, size, eot_offset);
+
+   return true;
+}
+
+/* Upload a generated PDS program into the PDS heap as [data][code], returning heap-relative
+ * offsets. The hardware names the data segment and, where the route allows it, expects the code to
+ * follow it. */
+static bool
+pvr_static_pds_upload(struct pvr_vm *vm, const uint32_t *data, uint32_t data_dwords,
+                      const uint32_t *code, uint32_t code_dwords,
+                      struct pvr_pds_program *out)
+{
+   const struct pvr_heap *heap = &vm->heaps[DRM_PVR_HEAP_PDS_CODE_DATA];
+   struct pvr_bo bo = { 0 };
+   uint64_t addr = pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_PDS_CODE_DATA,
+                                     ((uint64_t)data_dwords + code_dwords) * 4, 16, &bo);
+
+   if (addr == 0 || !pvr_bo_map(vm->fd, &bo))
+      return false;
+
+   memcpy(bo.map, data, data_dwords * 4);
+   memcpy((uint8_t *)bo.map + data_dwords * 4, code, code_dwords * 4);
+
+   *out = (struct pvr_pds_program){
+      .data_offset = addr - heap->base,
+      .code_offset = addr - heap->base + (uint64_t)data_dwords * 4,
+      .data_dwords = data_dwords,
+      .code_dwords = code_dwords,
+   };
+   return true;
+}
+
+/* Upload one of the USC state save/restore binaries into the USC heap. They are precompiled (the
+ * pco USC library carries them), and their DOUTU execution address is a USC-heap offset. */
+static bool
+pvr_static_usc_upload(struct pvr_vm *vm, unsigned program,
+                      uint32_t *offset_out, unsigned *temps_out)
+{
+   const pco_precomp_data *precomp = (const pco_precomp_data *)pco_usclib_common[program];
+   const struct pvr_heap *heap = &vm->heaps[DRM_PVR_HEAP_USC_CODE];
+   const uint32_t size = precomp->size_dwords * 4;
+   struct pvr_bo bo = { 0 };
+   uint64_t addr;
+
+   if (precomp == NULL || size == 0)
+      return false;
+
+   addr = pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_USC_CODE, size, 16, &bo);
+   if (addr == 0 || !pvr_bo_map(vm->fd, &bo))
+      return false;
+
+   memcpy(bo.map, precomp->binary, size);
+   *offset_out = addr - heap->base;
+   *temps_out = precomp->temps;
+   return true;
+}
+
+/* The SR store/load programs: a DOUTW that writes the USC shared registers to the SR buffer, then a
+ * DOUTU that runs the precompiled USC store/load binary. `store` selects the USC target. */
+static bool
+pvr_static_sr_program(struct pvr_vm *vm, const struct pvr_device_info *dev_info, bool store,
+                      const struct pvr_ctx_switch *cs, struct pvr_pds_program *out)
+{
+   struct pvr_pds_shared_storing_program program = { 0 };
+   uint32_t staging[256];
+   uint32_t data_dwords, code_dwords, code_at;
+   uint32_t usc_offset = store ? cs->usc_store_offset : cs->usc_load_offset;
+   unsigned temps = store ? cs->usc_store_temps : cs->usc_load_temps;
+
+   memset(staging, 0, sizeof(staging));
+
+   program.doutw_control = (struct pvr_pds_doutw_control){
+      .dest_store = PDS_UNIFIED_STORE,
+      .num_const64 = 2,
+      .doutw_data = {
+         cs->sr_buffer_addr,
+         cs->sr_buffer_addr + ROGUE_LLS_SHARED_REGS_RESERVE_SIZE,
+      },
+      .last_instruction = false,
+   };
+   pvr_pds_setup_doutu(&program.usc_task.usc_task_control, usc_offset, temps,
+                       PVR_ROGUE_PDSINST_DOUT_FIELDS_DOUTU_SAMPLE_RATE_INSTANCE, false);
+
+   pvr_pds_generate_shared_storing_program(&program, staging, PDS_GENERATE_DATA_SEGMENT,
+                                           dev_info);
+   data_dwords = program.data_size;
+   code_at = ALIGN_POT(data_dwords,
+                       ROGUE_VDMCTRL_PDS_STATE0_PDS_DATA_SIZE_UNIT_SIZE / 4);
+   pvr_pds_generate_shared_storing_program(&program, staging + code_at,
+                                           PDS_GENERATE_CODE_SEGMENT, dev_info);
+   code_dwords = program.code_size;
+
+   return pvr_static_pds_upload(vm, staging, data_dwords, staging + code_at, code_dwords, out);
+}
+
+/* The PT store program: writes N persistent temps to the PT buffer and terminates stream out.
+ * The resume program initialises stream out from the same buffer. Both are PDS programs the
+ * context-switch state names directly. */
+static bool
+pvr_static_pt_programs(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                       const struct pvr_ctx_switch *cs, struct pvr_pds_program *store_out,
+                       struct pvr_pds_program *resume_out)
+{
+   const uint32_t pt_dwords = ROGUE_LLS_PDS_PERSISTENT_TEMPS_BUFFER_SIZE / 4;
+   uint32_t staging[256];
+   uint32_t *code;
+   uint32_t data_dwords, code_dwords, code_at;
+
+   /* Store. */
+   {
+      struct pvr_pds_stream_out_terminate_program program = {
+         .pds_persistent_temp_size_to_store = pt_dwords,
+         .dev_address_for_storing_persistent_temp = cs->pt_buffer_addr,
+      };
+
+      memset(staging, 0, sizeof(staging));
+      pvr_pds_generate_stream_out_terminate_program(&program, NULL, PDS_GENERATE_SIZES,
+                                                    dev_info);
+      data_dwords = program.stream_out_terminate_pds_data_size;
+      code_dwords = program.stream_out_terminate_pds_code_size;
+      pvr_pds_generate_stream_out_terminate_program(&program, staging,
+                                                    PDS_GENERATE_DATA_SEGMENT, dev_info);
+      pvr_pds_generate_stream_out_terminate_program(
+         &program, staging + data_dwords, PDS_GENERATE_CODE_SEGMENT, dev_info);
+
+      if (!pvr_static_pds_upload(vm, staging, data_dwords, staging + data_dwords,
+                                 code_dwords, store_out))
+         return false;
+   }
+
+   /* Resume. */
+   {
+      struct pvr_pds_stream_out_init_program program = { .num_buffers = 1 };
+
+      program.pds_buffer_data_size[0] = pt_dwords;
+      program.dev_address_for_buffer_data[0] = cs->pt_buffer_addr;
+
+      memset(staging, 0, sizeof(staging));
+      pvr_pds_generate_stream_out_init_program(&program, NULL, false, PDS_GENERATE_SIZES,
+                                               dev_info);
+      data_dwords = program.stream_out_init_pds_data_size;
+      code_dwords = program.stream_out_init_pds_code_size;
+
+      code_at = data_dwords;
+      pvr_pds_generate_stream_out_init_program(&program, staging, false,
+                                               PDS_GENERATE_DATA_SEGMENT, dev_info);
+      code = pvr_pds_generate_stream_out_init_program(&program, staging + code_at, false,
+                                                      PDS_GENERATE_CODE_SEGMENT, dev_info);
+      (void)code;
+
+      if (!pvr_static_pds_upload(vm, staging, data_dwords, staging + code_at,
+                                 code_dwords, resume_out))
+         return false;
+   }
+
+   return true;
+}
+
+/* One 256-byte staging buffer is enough for every PDS task program here: the reference asserts the
+ * same limit (ROGUE_PDS_TASK_PROGRAM_SIZE) for exactly these. */
+
+bool
+pvr_static_ctx_switch_init(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                           struct pvr_ctx_switch *cs)
+{
+   const struct pvr_heap *pds = &vm->heaps[DRM_PVR_HEAP_PDS_CODE_DATA];
+   const uint64_t sr_size =
+      ROGUE_LLS_USC_SHARED_REGS_BUFFER_SIZE + ROGUE_LLS_SHARED_REGS_RESERVE_SIZE;
+   struct pvr_bo sr_bo = { 0 }, pt_bo = { 0 };
+
+   memset(cs, 0, sizeof(*cs));
+
+   /* The firmware writes context state through DMA and reads it back after a switch; both buffers
+    * therefore have to bypass the device cache, as the reference marks them (GPU_UNCACHED|CPU_ACCESS).
+    * A cached buffer can hand the firmware stale state and stall the switch. */
+   const uint64_t state_flags =
+      DRM_PVR_BO_BYPASS_DEVICE_CACHE | DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS;
+
+   cs->vdm_state_addr = pvr_vm_alloc(vm, ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_SIZE,
+                                     ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_ALIGNMENT);
+   if (cs->vdm_state_addr == 0 ||
+       !pvr_bo_create_flags(vm->fd, ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_SIZE,
+                            ROGUE_LLS_VDM_CONTEXT_RESUME_BUFFER_ALIGNMENT, state_flags,
+                            &cs->vdm_state_bo) ||
+       !pvr_vm_map(vm, cs->vdm_state_addr, cs->vdm_state_bo.handle, cs->vdm_state_bo.size))
+      return false;
+
+   cs->geom_state_addr = pvr_vm_alloc(vm, ROGUE_LLS_TA_STATE_BUFFER_SIZE,
+                                      ROGUE_LLS_TA_STATE_BUFFER_ALIGNMENT);
+   if (cs->geom_state_addr == 0 ||
+       !pvr_bo_create_flags(vm->fd, ROGUE_LLS_TA_STATE_BUFFER_SIZE,
+                            ROGUE_LLS_TA_STATE_BUFFER_ALIGNMENT, state_flags,
+                            &cs->geom_state_bo) ||
+       !pvr_vm_map(vm, cs->geom_state_addr, cs->geom_state_bo.handle, cs->geom_state_bo.size))
+      return false;
+
+   /* The USC shared-register save buffer (DOUTW target) and the persistent-temps buffer. */
+   /* The buffer the SR store/load PDS programs DMA to/from is cache-line aligned in the
+    * reference (slc_cache_line_size_bits / 8, 64 on this device). */
+   cs->sr_buffer_addr =
+      pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_PDS_CODE_DATA, sr_size,
+                        PVR_GET_FEATURE_VALUE(dev_info, slc_cache_line_size_bits, 8U) / 8U,
+                        &sr_bo);
+   if (cs->sr_buffer_addr == 0)
+      return false;
+   cs->pt_buffer_addr = pvr_vm_heap_alloc(vm, DRM_PVR_HEAP_PDS_CODE_DATA,
+                                          ROGUE_LLS_PDS_PERSISTENT_TEMPS_BUFFER_SIZE,
+                                          ROGUE_LLS_PDS_PERSISTENT_TEMPS_BUFFER_ALIGNMENT,
+                                          &pt_bo);
+   if (cs->pt_buffer_addr == 0)
+      return false;
+
+   /* The state save/restore binaries. The 64-byte USC store/load workspace is expressed in
+    * VDMCTRL_PDS_STATE0 units (16 bytes), as the reference does. */
+   cs->usc_unified_size =
+      DIV_ROUND_UP(64, ROGUE_VDMCTRL_PDS_STATE0_USC_UNIFIED_SIZE_UNIT_SIZE);
+
+   if (!pvr_static_usc_upload(vm, CS_STORE_SR_1024_COMMON, &cs->usc_store_offset,
+                              &cs->usc_store_temps) ||
+       !pvr_static_usc_upload(vm, CS_LOAD_SR_256_COMMON, &cs->usc_load_offset,
+                              &cs->usc_load_temps))
+      return false;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(cs->programs); i++) {
+      struct pvr_ctx_switch_programs *p = &cs->programs[i];
+
+      if (!pvr_static_sr_program(vm, dev_info, true, cs, &p->sr_store) ||
+          !pvr_static_sr_program(vm, dev_info, false, cs, &p->sr_load) ||
+          !pvr_static_pt_programs(vm, dev_info, cs, &p->pt_store, &p->pt_resume))
+         return false;
+   }
+
+   /* Round-9 diagnostic: replace one of the context-switch task programs' data/code offsets with
+    * a deliberately unmapped PDS-heap offset. The firmware's BIF0 fault status then names the
+    * address it actually dereferenced, which identifies which of these pointers the TA follows. */
+   {
+      const char *what = getenv("PVR_PROBE_PATCH_PDS");
+      const uint64_t label = 0x500000;
+
+      if (what != NULL) {
+         for (unsigned i = 0; i < ARRAY_SIZE(cs->programs); i++) {
+            struct pvr_ctx_switch_programs *p = &cs->programs[i];
+
+            if (strcmp(what, "sr_store_data") == 0)
+               p->sr_store.data_offset = label;
+            else if (strcmp(what, "sr_store_code") == 0)
+               p->sr_store.code_offset = label;
+            else if (strcmp(what, "sr_load_data") == 0)
+               p->sr_load.data_offset = label;
+            else if (strcmp(what, "sr_load_code") == 0)
+               p->sr_load.code_offset = label;
+            else if (strcmp(what, "pt_store_data") == 0)
+               p->pt_store.data_offset = label;
+            else if (strcmp(what, "pt_resume_data") == 0)
+               p->pt_resume.data_offset = label;
+            else if (strcmp(what, "pt_resume_code") == 0)
+               p->pt_resume.code_offset = label;
+         }
+         mesa_logi("pvr: PATCH_PDS %s -> PDS+0x%" PRIx64, what, label);
+      }
+   }
+
+   (void)pds;
+   return true;
+}
+
+static void
+pvr_static_pds_state_words(const struct pvr_pds_program *program,
+                           enum ROGUE_VDMCTRL_USC_TARGET usc_target,
+                           unsigned usc_unified_size, uint32_t *state0_out,
+                           uint32_t *state1_out)
+{
+   struct ROGUE_VDMCTRL_PDS_STATE0 state0 = {
+      ROGUE_VDMCTRL_PDS_STATE0_header,
+      .dm_target = ROGUE_VDMCTRL_DM_TARGET_VDM,
+      .usc_target = usc_target,
+      .usc_common_size = 0,
+      .usc_unified_size = usc_unified_size,
+      .pds_temp_size = 0,
+      .pds_data_size = DIV_ROUND_UP(program->data_dwords * 4,
+                                    ROGUE_VDMCTRL_PDS_STATE0_PDS_DATA_SIZE_UNIT_SIZE),
+   };
+   struct ROGUE_VDMCTRL_PDS_STATE1 state1 = {
+      .pds_data_addr = program->data_offset,
+      .sd_type = ROGUE_VDMCTRL_SD_TYPE_PDS,
+      .sd_next_type = ROGUE_VDMCTRL_SD_TYPE_PDS,
+   };
+
+   ROGUE_VDMCTRL_PDS_STATE0_pack(state0_out, &state0);
+   ROGUE_VDMCTRL_PDS_STATE1_pack(state1_out, &state1);
+}
+
+uint32_t
+pvr_static_context_state(uint8_t *stream, uint32_t stream_size,
+                         const struct pvr_ctx_switch *cs)
+{
+   /* Layout, in 64-bit words:
+    *   0            length in bytes (written last, once it is known)
+    *   1            VDM context state base address (CR_VDM_CONTEXT_STATE_BASE)
+    *   2            unused, zeroed
+    *   3            GEOM context state base address (CR_TA_CONTEXT_STATE_BASE)
+    *   4..          two groups of ten words, per context-state entry:
+    *                store task0, task1, task2, 0, 0, resume task0, task1, task2, 0, 0
+    * The task words are the PDS programs the firmware runs to save and restore context state; a
+    * group with zero tasks is a context switch that saves nothing and restores from address zero. */
+   const uint32_t nr_groups = 2;
+   const uint32_t words = 4 + nr_groups * 10;
+   const uint32_t length = words * sizeof(uint64_t);
+   uint64_t *q = (uint64_t *)stream;
+
+   if (length > stream_size) {
+      mesa_loge("pvr: static context state needs %u bytes, have %u", length, stream_size);
+      return 0;
+   }
+
+   memset(stream, 0, length);
+
+   {
+      struct ROGUE_CR_VDM_CONTEXT_STATE_BASE vdm = { .addr = cs->vdm_state_addr };
+      struct ROGUE_CR_TA_CONTEXT_STATE_BASE geom = { .addr = cs->geom_state_addr };
+
+      ROGUE_CR_VDM_CONTEXT_STATE_BASE_pack(&q[1], &vdm);
+      ROGUE_CR_TA_CONTEXT_STATE_BASE_pack(&q[3], &geom);
+   }
+
+   for (unsigned i = 0; i < nr_groups; i++) {
+      const struct pvr_ctx_switch_programs *p = &cs->programs[i];
+      struct ROGUE_CR_VDM_CONTEXT_STORE_TASK0 store0 = { 0 };
+      struct ROGUE_CR_VDM_CONTEXT_STORE_TASK1 store1 = { 0 };
+      struct ROGUE_CR_VDM_CONTEXT_STORE_TASK2 store2 = { 0 };
+      struct ROGUE_CR_VDM_CONTEXT_RESUME_TASK0 resume0 = { 0 };
+      struct ROGUE_CR_VDM_CONTEXT_RESUME_TASK1 resume1 = { 0 };
+      struct ROGUE_CR_VDM_CONTEXT_RESUME_TASK2 resume2 = { 0 };
+      struct ROGUE_TA_STATE_STREAM_OUT1 store_so1 = {
+         .sync = true,
+         .pds_data_size = DIV_ROUND_UP(p->pt_store.data_dwords * 4,
+                                       ROGUE_TA_STATE_STREAM_OUT1_PDS_DATA_SIZE_UNIT_SIZE),
+         .pds_temp_size = 0,
+      };
+      struct ROGUE_TA_STATE_STREAM_OUT2 store_so2 = { .pds_data_addr = p->pt_store.data_offset };
+      struct ROGUE_TA_STATE_STREAM_OUT1 resume_so1 = {
+         .sync = true,
+         .pds_data_size = DIV_ROUND_UP(p->pt_resume.data_dwords * 4,
+                                       ROGUE_TA_STATE_STREAM_OUT1_PDS_DATA_SIZE_UNIT_SIZE),
+         .pds_temp_size = 0,
+      };
+      struct ROGUE_TA_STATE_STREAM_OUT2 resume_so2 = { .pds_data_addr = p->pt_resume.data_offset };
+
+      pvr_static_pds_state_words(&p->sr_store, ROGUE_VDMCTRL_USC_TARGET_ANY,
+                                 cs->usc_unified_size, &store0.pds_state0,
+                                 &store0.pds_state1);
+      ROGUE_VDMCTRL_PDS_STATE2_pack(&store1.pds_state2,
+                                    &(struct ROGUE_VDMCTRL_PDS_STATE2){
+                                       .pds_code_addr = p->sr_store.code_offset });
+      ROGUE_TA_STATE_STREAM_OUT1_pack(&store2.stream_out1, &store_so1);
+      ROGUE_TA_STATE_STREAM_OUT2_pack(&store2.stream_out2, &store_so2);
+
+      pvr_static_pds_state_words(&p->sr_load, ROGUE_VDMCTRL_USC_TARGET_ALL,
+                                 cs->usc_unified_size, &resume0.pds_state0,
+                                 &resume0.pds_state1);
+      ROGUE_VDMCTRL_PDS_STATE2_pack(&resume1.pds_state2,
+                                    &(struct ROGUE_VDMCTRL_PDS_STATE2){
+                                       .pds_code_addr = p->sr_load.code_offset });
+      ROGUE_TA_STATE_STREAM_OUT1_pack(&resume2.stream_out1, &resume_so1);
+      ROGUE_TA_STATE_STREAM_OUT2_pack(&resume2.stream_out2, &resume_so2);
+
+      ROGUE_CR_VDM_CONTEXT_STORE_TASK0_pack(&q[4 + i * 10], &store0);
+      ROGUE_CR_VDM_CONTEXT_STORE_TASK1_pack(&q[5 + i * 10], &store1);
+      ROGUE_CR_VDM_CONTEXT_STORE_TASK2_pack(&q[6 + i * 10], &store2);
+      ROGUE_CR_VDM_CONTEXT_RESUME_TASK0_pack(&q[9 + i * 10], &resume0);
+      ROGUE_CR_VDM_CONTEXT_RESUME_TASK1_pack(&q[10 + i * 10], &resume1);
+      ROGUE_CR_VDM_CONTEXT_RESUME_TASK2_pack(&q[11 + i * 10], &resume2);
+   }
+
+   q[0] = length;
+
+   return length;
+}
+
+bool
+pvr_static_memory_init(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                       struct pvr_static_memory *sm)
+{
+   memset(sm, 0, sizeof(*sm));
+
+   /* Reserve and map each carveout first: the programs are written through the CPU
+    * mapping and read by the GPU from the same memory, so it has to be mapped before
+    * anything is placed in it. */
+   for (unsigned i = 0; i < ARRAY_SIZE(pvr_static_heaps); i++) {
+      const uint16_t heap_id = pvr_static_heaps[i];
+
+      if (!pvr_vm_alloc_carveout(vm, heap_id, &sm->bo[i], &sm->base[i]))
+         goto fail;
+
+      if (!pvr_bo_map(vm->fd, &sm->bo[i]))
+         goto fail;
+
+      sm->map[i] = sm->bo[i].map;
+      sm->present[i] = true;
+   }
+
+   if (!pvr_fill_vdm_sync(vm, sm))
+      goto fail;
+
+   if (!pvr_fill_pixel_event(vm, dev_info, sm))
+      goto fail;
+
+   /* The YUV CSC table lives in the general heap's static area. */
+   {
+      const unsigned general_slot = pvr_heap_slot(DRM_PVR_HEAP_GENERAL);
+      const uint64_t yuv_offset = vm->offsets[DRM_PVR_HEAP_GENERAL].yuv_csc;
+
+      if (yuv_offset != PVR_STATIC_ABSENT) {
+         pvr_setup_static_yuv_csc_table((uint8_t *)sm->map[general_slot], yuv_offset);
+         mesa_logi("pvr: static memory: YUV CSC table at general+0x%llx",
+                   (unsigned long long)yuv_offset);
+      }
+   }
+
+   if (getenv("PVR_DUMP_STATIC_AREAS")) {
+      const unsigned pds_slot = pvr_heap_slot(DRM_PVR_HEAP_PDS_CODE_DATA);
+      const unsigned usc_slot = pvr_heap_slot(DRM_PVR_HEAP_USC_CODE);
+      const unsigned general_slot = pvr_heap_slot(DRM_PVR_HEAP_GENERAL);
+      const uint32_t *pds = sm->map[pds_slot];
+      const uint32_t *usc = sm->map[usc_slot];
+      const uint32_t *gen = sm->map[general_slot];
+      const uint64_t pds_vdm = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].vdm_sync;
+      const uint64_t pds_eot = vm->offsets[DRM_PVR_HEAP_PDS_CODE_DATA].eot;
+      const uint64_t usc_vdm = vm->offsets[DRM_PVR_HEAP_USC_CODE].vdm_sync;
+      const uint64_t yuv = vm->offsets[DRM_PVR_HEAP_GENERAL].yuv_csc;
+      unsigned i;
+
+      fprintf(stderr, "NSTATIC pds_vdm(128):");
+      for (i = 0; i < 32; i++) fprintf(stderr, " %08x", pds[pds_vdm / 4 + i]);
+      fprintf(stderr, "\nNSTATIC usc_vdm(128):");
+      for (i = 0; i < 32; i++) fprintf(stderr, " %08x", usc[usc_vdm / 4 + i]);
+      fprintf(stderr, "\nNSTATIC pds_eot(128):");
+      for (i = 0; i < 32; i++) fprintf(stderr, " %08x", pds[pds_eot / 4 + i]);
+      fprintf(stderr, "\nNSTATIC yuv(1024):");
+      for (i = 0; i < 256; i++) fprintf(stderr, " %08x", gen[yuv / 4 + i]);
+      fprintf(stderr, "\n");
+   }
+
+   mesa_logi("pvr: static memory: %u bytes of firmware programs in 3 carveouts",
+             sm->program_bytes);
+
+   return true;
+
+fail:
+   pvr_static_memory_fini(vm, sm);
+   return false;
+}
+
+void
+pvr_static_memory_fini(struct pvr_vm *vm, struct pvr_static_memory *sm)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(pvr_static_heaps); i++) {
+      if (!sm->present[i])
+         continue;
+
+      pvr_vm_unmap(vm, sm->base[i], sm->bo[i].size);
+      pvr_bo_destroy(vm->fd, &sm->bo[i]);
+      sm->present[i] = false;
+   }
+
+   sm->program_bytes = 0;
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_static.h b/src/gallium/drivers/pvr_native/pvr_static.h
new file mode 100644
index 00000000..8317cd94
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_static.h
@@ -0,0 +1,103 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The firmware's static memory.
+ *
+ * The GPU expects certain programs to already be sitting at fixed addresses inside the
+ * carveouts before a context can be created: a VDM sync program (USC code plus the PDS
+ * program that launches it) and the pixel-event/EOT program. Their addresses come from
+ * the kernel's static-data table, and a program written at the wrong one is executed as
+ * something else entirely - so the offsets are taken from the table rather than chosen.
+ *
+ * The PDS program generators come from libpowervr_pds and the USC binary from the pco
+ * USC library: both are reused, neither is restated here.
+ */
+#ifndef PVR_STATIC_H
+#define PVR_STATIC_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "pvr_bo.h"
+
+struct pvr_vm;
+struct pvr_device_info;
+
+struct pvr_static_memory {
+   /* One buffer per heap that has a carveout, kept mapped: firmware programs are written
+    * through the CPU mapping and read by the GPU from the same memory. */
+   struct pvr_bo bo[3];
+   void *map[3];
+   uint64_t base[3];
+   bool present[3];
+
+   unsigned program_bytes; /* total written, for the log and the check */
+};
+
+/* One firmware PDS program placed in the PDS heap, with the offsets the hardware state takes. */
+struct pvr_pds_program {
+   uint64_t data_offset;
+   uint64_t code_offset;
+   uint32_t data_dwords;
+   uint32_t code_dwords;
+};
+
+/* The four PDS programs and the two buffers a render context switches state with: USC shared
+ * registers are saved/restored by SR store/load programs, persistent temps by PT store/resume
+ * programs. The reference builds two identical sets (one per context-state group) and the static
+ * context state carries both; this driver follows that shape. */
+struct pvr_ctx_switch_programs {
+   struct pvr_pds_program sr_store;
+   struct pvr_pds_program sr_load;
+   struct pvr_pds_program pt_store;
+   struct pvr_pds_program pt_resume;
+};
+
+struct pvr_ctx_switch {
+   /* Context-state buffers, general heap (the firmware reads/writes them directly). */
+   struct pvr_bo vdm_state_bo;
+   uint64_t vdm_state_addr;
+   struct pvr_bo geom_state_bo;
+   uint64_t geom_state_addr;
+
+   /* State buffers in the PDS heap, addressed absolutely by the DOUTW/stream-out programs. */
+   uint64_t sr_buffer_addr;
+   uint64_t pt_buffer_addr;
+
+   /* USC code: heap-relative offsets and each program's temp count. */
+   uint32_t usc_store_offset;
+   unsigned usc_store_temps;
+   uint32_t usc_load_offset;
+   unsigned usc_load_temps;
+   unsigned usc_unified_size; /* in ROGUE_VDMCTRL_PDS_STATE0 units */
+
+   struct pvr_ctx_switch_programs programs[2];
+};
+
+/* Allocate the context-switch buffers/programs. Without them the static context state has no valid
+ * context to switch to, and every job for the context is accepted by the kernel and never run. */
+bool pvr_static_ctx_switch_init(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                                struct pvr_ctx_switch *cs);
+
+/* The static context state stream handed to DRM_IOCTL_PVR_CREATE_CONTEXT.
+ *
+ * The hardware's context switch reads the VDM and GEOM context-state buffer addresses from here, and
+ * the store/resume task programs. The addresses are the ones the driver allocated for this context;
+ * a stream of zeros claims both buffers live at address 0, which is not a context the firmware can
+ * switch to - the jobs are accepted by the kernel and never run, with no error anywhere.
+ *
+ * Layout, in 64-bit words: length, VDM state base, unused, GEOM state base, then two
+ * {store task0..2, 0, 0, resume task0..2, 0, 0} groups. The task words are the PDS load/store
+ * programs' state; this driver allocates the buffers but does not yet populate the task programs
+ * (see the handoff) - zeros there mean "no state to store/resume", which is honest, not an address.
+ *
+ * Returns the stream length in bytes, or 0 on failure. */
+uint32_t pvr_static_context_state(uint8_t *stream, uint32_t stream_size,
+                                  const struct pvr_ctx_switch *cs);
+
+bool pvr_static_memory_init(struct pvr_vm *vm,
+                            const struct pvr_device_info *dev_info,
+                            struct pvr_static_memory *sm);
+void pvr_static_memory_fini(struct pvr_vm *vm, struct pvr_static_memory *sm);
+
+#endif /* PVR_STATIC_H */
diff --git a/src/gallium/drivers/pvr_native/pvr_vm.c b/src/gallium/drivers/pvr_native/pvr_vm.c
new file mode 100644
index 00000000..d3dfdb4b
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_vm.c
@@ -0,0 +1,1113 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * GPU address space setup and mapping. Follows the Vulkan winsys
+ * (src/imagination/vulkan/winsys/powervr/pvr_drm.c, pvr_winsys_helper.c), which is
+ * the working reference for this UAPI.
+ */
+#include "pvr_vm.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <xf86drm.h>
+
+#include "drm-uapi/pvr_drm.h"
+
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/os_misc.h"
+#include "util/os_time.h"
+
+#include "pvr_static.h"
+#include "pvr_csb.h"
+
+/* Object-array queries are two calls: the first, with a null array, reports how many
+ * entries there are; the second fills a buffer of that size. The kernel silently
+ * clamps count to its own table size rather than failing, so the returned count is
+ * what gets trusted, not the requested one. */
+/* Waits for a syncobj to signal. The kernel's syncobj wait takes an absolute CLOCK_MONOTONIC deadline
+ * when WAIT_FOR_SUBMIT is used - the convention the reference winsys (and Mesa's Vulkan runtime) uses -
+ * and a relative timeout otherwise. Using the reference convention everywhere keeps the wait correct and
+ * lets the driver rely on the job actually being done when a submit returns. */
+static bool
+pvr_syncobj_wait(struct pvr_vm *vm, uint32_t syncobj, uint32_t timeout_ms)
+{
+   int64_t deadline = os_time_get_nano() + (int64_t)timeout_ms * 1000000LL;
+
+   return drmSyncobjWait(vm->fd, &syncobj, 1, deadline,
+                         DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL) == 0;
+}
+
+static bool
+pvr_syncobj_timeline_wait(struct pvr_vm *vm, uint32_t syncobj, uint64_t point,
+                          uint32_t timeout_ms)
+{
+   int64_t deadline = os_time_get_nano() + (int64_t)timeout_ms * 1000000LL;
+
+   return drmSyncobjTimelineWait(vm->fd, &syncobj, &point, 1, deadline,
+                                 DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL) == 0;
+}
+
+static bool
+pvr_query_heap_info(int fd, struct drm_pvr_heap **heaps_out, uint32_t *count_out)
+{
+   struct drm_pvr_dev_query_heap_info query = { 0 };
+   struct drm_pvr_ioctl_dev_query_args args = {
+      .type = DRM_PVR_DEV_QUERY_HEAP_INFO_GET,
+      .size = sizeof(query),
+      .pointer = (__u64)&query,
+   };
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) != 0) {
+      mesa_loge("pvr: heap info size query failed: %s", strerror(errno));
+      return false;
+   }
+
+   if (query.heaps.count == 0 || query.heaps.count > DRM_PVR_HEAP_COUNT) {
+      mesa_loge("pvr: kernel reports %u heaps, expected 1..%d", query.heaps.count,
+                DRM_PVR_HEAP_COUNT);
+      return false;
+   }
+
+   struct drm_pvr_heap *heaps = calloc(query.heaps.count, sizeof(*heaps));
+   if (!heaps)
+      return false;
+
+   query.heaps.array = (__u64)heaps;
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) != 0) {
+      mesa_loge("pvr: heap info array query failed: %s", strerror(errno));
+      free(heaps);
+      return false;
+   }
+
+   *heaps_out = heaps;
+   *count_out = query.heaps.count;
+
+   return true;
+}
+
+static bool
+pvr_query_static_data_areas(int fd, struct drm_pvr_static_data_area **areas_out,
+                            uint32_t *count_out)
+{
+   struct drm_pvr_dev_query_static_data_areas query = { 0 };
+   struct drm_pvr_ioctl_dev_query_args args = {
+      .type = DRM_PVR_DEV_QUERY_STATIC_DATA_AREAS_GET,
+      .size = sizeof(query),
+      .pointer = (__u64)&query,
+   };
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) != 0 || query.static_data_areas.count == 0)
+      return false;
+
+   struct drm_pvr_static_data_area *areas =
+      calloc(query.static_data_areas.count, sizeof(*areas));
+   if (!areas)
+      return false;
+
+   query.static_data_areas.array = (__u64)areas;
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) != 0) {
+      free(areas);
+      return false;
+   }
+
+   *areas_out = areas;
+   *count_out = query.static_data_areas.count;
+
+   return true;
+}
+
+/* Matched rather than indexed by heap id on purpose: location_heap_id is a u16 from
+ * the kernel, so a heap this userspace does not know about would be an out-of-bounds
+ * write if it were used as an array index. */
+static uint64_t
+pvr_static_data_total(const struct drm_pvr_static_data_area *areas, uint32_t count,
+                      uint32_t heap_id)
+{
+   uint64_t total = 0;
+
+   for (uint32_t i = 0; i < count; i++) {
+      if (areas[i].location_heap_id == heap_id)
+         total += areas[i].size;
+   }
+
+   return total;
+}
+
+bool
+pvr_vm_init(int fd, struct pvr_vm *vm)
+{
+   uint64_t host_page_size = 4096;
+   struct drm_pvr_heap *heaps = NULL;
+   uint32_t heap_count = 0;
+   struct drm_pvr_static_data_area *areas = NULL;
+   uint32_t area_count = 0;
+   uint64_t carveout;
+   const struct drm_pvr_heap *general;
+   bool ok = false;
+
+   memset(vm, 0, sizeof(*vm));
+   vm->fd = fd;
+
+   if (!os_get_page_size(&host_page_size) || host_page_size == 0)
+      host_page_size = 4096;
+
+   if (!pvr_query_heap_info(fd, &heaps, &heap_count))
+      return false;
+
+   /* Not fatal: without the carveout list the usable range is merely conservative,
+    * which costs a little address space and nothing else. */
+   if (!pvr_query_static_data_areas(fd, &areas, &area_count))
+      mesa_logi("pvr: static data areas unavailable; not reserving a carveout");
+
+   general = &heaps[DRM_PVR_HEAP_GENERAL];
+
+   if (general->size == 0) {
+      mesa_loge("pvr: the general heap is absent or empty");
+      goto out;
+   }
+
+   for (uint32_t i = 0; i < heap_count; i++) {
+      vm->heaps[i].base = heaps[i].base;
+      vm->heaps[i].size = heaps[i].size;
+      vm->heaps[i].page_size = 1u << heaps[i].page_size_log2;
+      vm->heaps[i].usable_base = heaps[i].base;
+      vm->heaps[i].usable_size = heaps[i].size;
+   }
+
+   vm->general.base = general->base;
+   vm->general.size = general->size;
+   vm->general.page_size = 1u << general->page_size_log2;
+
+   /* The first bytes of the heap are firmware-owned (fence, YUV CSC, sync programs).
+    * The kernel only checks that a mapping lies inside the heap, so it will happily
+    * let us map over them - the subtraction has to happen here. */
+   carveout = areas ? pvr_static_data_total(areas, area_count, DRM_PVR_HEAP_GENERAL) : 0;
+   if (carveout >= general->size) {
+      mesa_loge("pvr: static data carveout %" PRIu64 " >= general heap %" PRIu64,
+                carveout, (uint64_t)general->size);
+      goto out;
+   }
+
+   /* Keep the areas themselves, not just their total: the static context state has to
+    * name the firmware's fence area, YUV CSC coefficients and sync programs by address,
+    * and those addresses are only in this table. */
+   vm->nr_areas = 0;
+   for (uint32_t i = 0; i < area_count && vm->nr_areas < ARRAY_SIZE(vm->areas); i++)
+      vm->areas[vm->nr_areas++] = areas[i];
+
+   /* Per-heap offsets, straight out of the area table. A missing area keeps offset 0
+    * and is left to the caller to notice, rather than being invented. */
+   for (uint16_t h = 0; h < DRM_PVR_HEAP_COUNT; h++) {
+      vm->offsets[h].eot = PVR_STATIC_ABSENT;
+      vm->offsets[h].fence = PVR_STATIC_ABSENT;
+      vm->offsets[h].vdm_sync = PVR_STATIC_ABSENT;
+      vm->offsets[h].yuv_csc = PVR_STATIC_ABSENT;
+   }
+
+   for (unsigned i = 0; i < vm->nr_areas; i++) {
+      const struct drm_pvr_static_data_area *area = &vm->areas[i];
+
+      if (area->location_heap_id >= DRM_PVR_HEAP_COUNT)
+         continue;
+
+      mesa_logi("pvr: static area heap %u usage %u offset 0x%" PRIx64 " size %" PRIu64,
+                area->location_heap_id, area->area_usage, (uint64_t)area->offset,
+                (uint64_t)area->size);
+
+      switch (area->area_usage) {
+      case DRM_PVR_STATIC_DATA_AREA_EOT:
+         vm->offsets[area->location_heap_id].eot = area->offset;
+         break;
+      case DRM_PVR_STATIC_DATA_AREA_FENCE:
+         vm->offsets[area->location_heap_id].fence = area->offset;
+         break;
+      case DRM_PVR_STATIC_DATA_AREA_VDM_SYNC:
+         vm->offsets[area->location_heap_id].vdm_sync = area->offset;
+         break;
+      case DRM_PVR_STATIC_DATA_AREA_YUV_CSC:
+         vm->offsets[area->location_heap_id].yuv_csc = area->offset;
+         break;
+      default:
+         break;
+      }
+   }
+
+   vm->general.usable_base = general->base + carveout;
+   vm->general.usable_size = general->size - carveout;
+   vm->heaps[DRM_PVR_HEAP_GENERAL] = vm->general;
+
+   /* Every other heap with a carveout gets the same treatment, because the PDS and USC
+    * carveouts are where the sync and pixel-event programs live. */
+   for (uint32_t i = 0; i < heap_count; i++) {
+      uint64_t heap_carveout;
+
+      if (i == DRM_PVR_HEAP_GENERAL || vm->heaps[i].size == 0)
+         continue;
+
+      heap_carveout = areas ? pvr_static_data_total(areas, area_count, i) : 0;
+      if (heap_carveout >= vm->heaps[i].size)
+         continue;
+
+      vm->heaps[i].usable_base = vm->heaps[i].base + heap_carveout;
+      vm->heaps[i].usable_size = vm->heaps[i].size - heap_carveout;
+   }
+
+   if (vm->general.page_size != host_page_size) {
+      /* Not fatal, but VM_MAP aligns to the host page, so the two must not be
+       * confused when rounding sizes. */
+      mesa_logi("pvr: heap page size %u differs from host page size %" PRIu64,
+                vm->general.page_size, host_page_size);
+   }
+
+   /* Round-14 experiment: keep every device address low (like the working Vulkan driver's
+    * 0x8000_xxxx_xxxx allocations) instead of the VMA heap's top-down high addresses. Some of the
+    * hardware address fields the control stream carries have narrow bitfields, and a high address
+    * can be encodable but not usable. */
+   {
+      uint64_t vma_size = vm->general.usable_size;
+
+      if (getenv("PVR_PROBE_LOW_VA") != NULL)
+         vma_size = MIN2(vma_size, UINT64_C(256) << 20);
+
+      util_vma_heap_init(&vm->vma, vm->general.usable_base, vma_size);
+   }
+
+   /* Needed for VM_MAP only - buffer creation and CPU mapping do not require it. */
+   {
+      struct drm_pvr_ioctl_create_vm_context_args args = { 0 };
+      if (drmIoctl(fd, DRM_IOCTL_PVR_CREATE_VM_CONTEXT, &args) != 0) {
+         mesa_loge("pvr: CREATE_VM_CONTEXT failed: %s", strerror(errno));
+         util_vma_heap_finish(&vm->vma);
+         goto out;
+      }
+      vm->context_handle = args.handle;
+   }
+
+   if (getenv("PVR_DUMP_HEAPS") != NULL) {
+      for (uint32_t i = 0; i < heap_count; i++)
+         fprintf(stderr, "HEAP %u base=0x%" PRIx64 " size=%" PRIu64 "\n", i,
+                 (uint64_t)heaps[i].base, (uint64_t)heaps[i].size);
+   }
+   mesa_logi("pvr: %u heaps; general base 0x%" PRIx64 " size %" PRIu64
+             " carveout %" PRIu64 " usable 0x%" PRIx64 " (%" PRIu64 " bytes), page %u,"
+             " vm_context %u",
+             heap_count, (uint64_t)general->base, (uint64_t)general->size, carveout,
+             vm->general.usable_base, vm->general.usable_size, vm->general.page_size,
+             vm->context_handle);
+
+   ok = true;
+
+out:
+   free(heaps);
+   free(areas);
+   return ok;
+}
+
+/* One level of callstack, which is what the reference allocates. */
+#define PVR_VDM_CALLSTACK_SIZE (sizeof(uint64_t) * 1)
+
+bool
+pvr_gpu_context_create(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                       struct pvr_gpu_context *ctx)
+{
+   uint8_t static_state[192];
+   uint32_t static_state_len;
+   struct drm_pvr_ioctl_create_context_args args;
+
+   memset(ctx, 0, sizeof(*ctx));
+
+   /* Context-switch support first: the static context state handed to CREATE_CONTEXT names these
+    * programs and buffers. A context created without them has no valid state to switch to; jobs are
+    * accepted and never run, with no error reported anywhere. */
+   if (!pvr_static_ctx_switch_init(vm, dev_info, &ctx->cswitch))
+      return false;
+
+   static_state_len = pvr_static_context_state(static_state, sizeof(static_state),
+                                              &ctx->cswitch);
+   if (static_state_len == 0)
+      return false;
+
+   /* The callstack lives in the ordinary general heap, not the firmware carveout - it is
+    * a normal allocation the GPU happens to read. */
+   if (!pvr_bo_create(vm->fd, PVR_VDM_CALLSTACK_SIZE, 1, &ctx->callstack_bo))
+      return false;
+
+   ctx->callstack_addr =
+      pvr_vm_alloc(vm, ctx->callstack_bo.size, vm->general.page_size);
+   if (ctx->callstack_addr == 0) {
+      mesa_loge("pvr: no device address for the VDM callstack");
+      goto fail_bo;
+   }
+
+   if (!pvr_vm_map(vm, ctx->callstack_addr, ctx->callstack_bo.handle,
+                   ctx->callstack_bo.size))
+      goto fail_addr;
+
+   args = (struct drm_pvr_ioctl_create_context_args) {
+      .type = DRM_PVR_CTX_TYPE_RENDER,
+      /* Probe hook: try a different UAPI context priority (e.g. 512 = HIGH, -512 = LOW). */
+      .priority = getenv("PVR_PROBE_CTX_PRIORITY")
+                     ? (int32_t)strtol(getenv("PVR_PROBE_CTX_PRIORITY"), NULL, 0)
+                     : 0,
+      .static_context_state = (uint64_t)(uintptr_t)static_state,
+      .static_context_state_len = static_state_len,
+      .vm_context_handle = vm->context_handle,
+      .callstack_addr = ctx->callstack_addr,
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_CREATE_CONTEXT, &args) != 0) {
+      mesa_loge("pvr: CREATE_CONTEXT failed: %s", strerror(errno));
+      goto fail_addr;
+   }
+
+   ctx->handle = args.handle;
+
+   mesa_logi("pvr: GPU context %u (render), callstack 0x%" PRIx64 ", VDM state 0x%" PRIx64
+             ", GEOM state 0x%" PRIx64 ", static state %u bytes", ctx->handle,
+             ctx->callstack_addr, ctx->cswitch.vdm_state_addr,
+             ctx->cswitch.geom_state_addr, static_state_len);
+
+   return true;
+
+fail_addr:
+   pvr_vm_free(vm, ctx->callstack_addr, ctx->callstack_bo.size);
+   ctx->callstack_addr = 0;
+fail_bo:
+   pvr_bo_destroy(vm->fd, &ctx->callstack_bo);
+   return false;
+}
+
+void
+pvr_gpu_context_destroy(struct pvr_vm *vm, struct pvr_gpu_context *ctx)
+{
+   struct drm_pvr_ioctl_destroy_context_args args = {
+      .handle = ctx->handle,
+   };
+
+   if (ctx->handle != 0)
+      drmIoctl(vm->fd, DRM_IOCTL_PVR_DESTROY_CONTEXT, &args);
+
+   if (ctx->callstack_addr != 0) {
+      pvr_vm_unmap(vm, ctx->callstack_addr, ctx->callstack_bo.size);
+      pvr_vm_free(vm, ctx->callstack_addr, ctx->callstack_bo.size);
+   }
+
+   pvr_bo_destroy(vm->fd, &ctx->callstack_bo);
+   ctx->handle = 0;
+}
+
+bool
+pvr_job_submit(struct pvr_vm *vm, uint32_t context_handle, uint32_t job_type,
+               const void *cmd_stream, uint32_t cmd_stream_len,
+               uint32_t hwrt_set_handle, uint32_t hwrt_data_index)
+{
+   struct drm_pvr_job job = {
+      .type = job_type,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)cmd_stream,
+      .cmd_stream_len = cmd_stream_len,
+      .hwrt = {
+         .set_handle = hwrt_set_handle,
+         .data_index = hwrt_data_index,
+      },
+      /* The kernel checks sync_ops.stride BEFORE it looks at sync_ops.count, so a zero stride is
+       * rejected even when there are no sync operations at all. */
+      .sync_ops = {
+         .stride = sizeof(struct drm_pvr_sync_op),
+         .count = 0,
+      },
+   };
+   struct drm_pvr_ioctl_submit_jobs_args args = {
+      .jobs = {
+         .stride = sizeof(job),
+         .count = 1,
+         .array = (__u64)(uintptr_t)&job,
+      },
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+      mesa_loge("pvr: SUBMIT_JOBS type %u len %u at %p failed: %s", job_type,
+                cmd_stream_len, cmd_stream, strerror(errno));
+      return false;
+   }
+
+   return true;
+}
+
+/* A render pass is TWO jobs - geometry then fragment - in ONE submit. The kernel validates each job
+ * (pvr_job.c:411: a non-zero cmd_stream AND cmd_stream_len), so both streams have to be real. */
+bool
+pvr_job_submit_geom_sync(struct pvr_vm *vm, uint32_t context_handle,
+                         const void *geom_stream, uint32_t geom_len,
+                         uint32_t hwrt_set_handle, uint32_t hwrt_data_index,
+                         uint32_t timeout_ms)
+{
+   struct drm_pvr_sync_op sync_ops[2];
+   struct drm_pvr_job job = {
+      .type = DRM_PVR_JOB_TYPE_GEOMETRY,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)geom_stream,
+      .cmd_stream_len = geom_len,
+      .flags = getenv("PVR_PROBE_GEOM_FLAGS")
+                  ? (uint32_t)strtoul(getenv("PVR_PROBE_GEOM_FLAGS"), NULL, 0)
+                  : (DRM_PVR_SUBMIT_JOB_GEOM_CMD_FIRST | DRM_PVR_SUBMIT_JOB_GEOM_CMD_LAST),
+      .sync_ops = { .stride = sizeof(sync_ops[0]), .count = 1,
+                    .array = (__u64)(uintptr_t)sync_ops },
+      .hwrt = { .set_handle = hwrt_set_handle,
+                .data_index = getenv("PVR_PROBE_HWRT_IDX")
+                                 ? (uint32_t)strtoul(getenv("PVR_PROBE_HWRT_IDX"), NULL, 0)
+                                 : hwrt_data_index },
+   };
+   struct drm_pvr_ioctl_submit_jobs_args args = {
+      .jobs = { .stride = sizeof(job), .count = 1,
+                .array = (__u64)(uintptr_t)&job },
+   };
+   uint32_t sync = 0;
+   bool completed;
+
+   /* Probe hook: submit the geometry job with no sync ops at all (diagnostic: does the presence /
+    * absence of the signal dependency change the DM2 kick path?). */
+   if (getenv("PVR_PROBE_NO_SYNC_OPS")) {
+      job.sync_ops.count = 0;
+      if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+         mesa_loge("pvr: SUBMIT_JOBS geometry (no sync ops) failed: %s", strerror(errno));
+         return false;
+      }
+      usleep(300000);
+      return true;
+   }
+
+   if (drmSyncobjCreate(vm->fd, 0, &sync) != 0)
+      return false;
+
+   sync_ops[0] = (struct drm_pvr_sync_op){
+      .handle = sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+      .value = 0,
+   };
+
+   /* Round-52: the reference client's geometry job carries two signal sync ops (its render fence and
+    * the fragment fence it chains); give ours the same shape. */
+   if (getenv("PVR_PROBE_EXTRA_SIGNAL")) {
+      uint32_t sync2 = 0;
+
+      if (drmSyncobjCreate(vm->fd, 0, &sync2) == 0) {
+         sync_ops[1] = (struct drm_pvr_sync_op){
+            .handle = sync2,
+            .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+            .value = 0,
+         };
+         job.sync_ops.count = 2;
+      }
+   }
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+      mesa_loge("pvr: geometry-only submit failed: %s", strerror(errno));
+      drmSyncobjDestroy(vm->fd, sync);
+      return false;
+   }
+
+   completed = pvr_syncobj_wait(vm, sync, timeout_ms);
+   drmSyncobjDestroy(vm->fd, sync);
+   return completed;
+}
+
+bool
+pvr_job_submit_frag_sync(struct pvr_vm *vm, uint32_t context_handle,
+                         const void *frag_stream, uint32_t frag_len,
+                         uint32_t hwrt_set_handle, uint32_t hwrt_data_index,
+                         uint32_t timeout_ms)
+{
+   uint32_t done_sync = 0;
+   struct drm_pvr_sync_op ops[1];
+   struct drm_pvr_job job;
+   struct drm_pvr_ioctl_submit_jobs_args args = {
+      .jobs = { .stride = sizeof(job), .count = 1, .array = (__u64)(uintptr_t)&job },
+   };
+   bool completed;
+
+   if (drmSyncobjCreate(vm->fd, 0, &done_sync) != 0)
+      return false;
+
+   ops[0] = (struct drm_pvr_sync_op){
+      .handle = done_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   job = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_FRAGMENT,
+      .context_handle = context_handle,
+      /* Probe hook: submit fragment jobs with explicit UAPI flags (e.g. 0x40 = PARTIAL_RENDER). */
+      .flags = getenv("PVR_PROBE_FRAG_FLAGS")
+                  ? (uint32_t)strtoul(getenv("PVR_PROBE_FRAG_FLAGS"), NULL, 0) &
+                       DRM_PVR_SUBMIT_JOB_FRAG_CMD_FLAGS_MASK
+                  : 0,
+      .cmd_stream = (uint64_t)(uintptr_t)frag_stream,
+      .cmd_stream_len = frag_len,
+      .sync_ops = { .stride = sizeof(ops[0]), .count = 1, .array = (__u64)(uintptr_t)ops },
+      .hwrt = { .set_handle = hwrt_set_handle,
+                .data_index = getenv("PVR_PROBE_HWRT_IDX")
+                                 ? (uint32_t)strtoul(getenv("PVR_PROBE_HWRT_IDX"), NULL, 0)
+                                 : hwrt_data_index },
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+      mesa_loge("pvr: SUBMIT_JOBS fragment-only (%u B) failed: %s", frag_len, strerror(errno));
+      drmSyncobjDestroy(vm->fd, done_sync);
+      return false;
+   }
+
+   completed = pvr_syncobj_wait(vm, done_sync, timeout_ms);
+   if (!completed)
+      mesa_loge("pvr: fragment-only job did not signal completion within %u ms", timeout_ms);
+
+   drmSyncobjDestroy(vm->fd, done_sync);
+   return completed;
+}
+
+bool
+pvr_job_submit_transfer_sync(struct pvr_vm *vm, uint32_t context_handle,
+                             const void *stream, uint32_t stream_len, uint32_t timeout_ms)
+{
+   uint32_t done_sync = 0;
+   struct drm_pvr_sync_op ops[1];
+   struct drm_pvr_job job;
+   struct drm_pvr_ioctl_submit_jobs_args args = {
+      .jobs = { .stride = sizeof(job), .count = 1, .array = (__u64)(uintptr_t)&job },
+   };
+   bool completed;
+
+   if (drmSyncobjCreate(vm->fd, 0, &done_sync) != 0)
+      return false;
+
+   ops[0] = (struct drm_pvr_sync_op){
+      .handle = done_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL |
+               DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_TIMELINE_SYNCOBJ,
+      .value = 1,
+   };
+   job = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_TRANSFER_FRAG,
+      .context_handle = context_handle,
+      /* The reference submits every transfer job with SINGLE_CORE (the transfer-frag path sets
+       * use_single_core whenever the device has the multicore feature, which BXM-4-64 has); a
+       * multi-core dispatch of this job faults in the ISP data master. */
+      .flags = getenv("PVR_PROBE_TQ_FLAGS")
+                  ? (uint32_t)strtoul(getenv("PVR_PROBE_TQ_FLAGS"), NULL, 0) &
+                       DRM_PVR_SUBMIT_JOB_TRANSFER_CMD_FLAGS_MASK
+                  : DRM_PVR_SUBMIT_JOB_TRANSFER_CMD_SINGLE_CORE,
+      .cmd_stream = (uint64_t)(uintptr_t)stream,
+      .cmd_stream_len = stream_len,
+      .sync_ops = { .stride = sizeof(ops[0]), .count = 1, .array = (__u64)(uintptr_t)ops },
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+      mesa_loge("pvr: SUBMIT_JOBS transfer (%u B) failed: %s", stream_len, strerror(errno));
+      drmSyncobjDestroy(vm->fd, done_sync);
+      return false;
+   }
+
+   {
+      completed = pvr_syncobj_timeline_wait(vm, done_sync, 1, timeout_ms);
+      if (!completed)
+         mesa_loge("pvr: transfer job did not signal completion within %u ms", timeout_ms);
+   }
+
+   drmSyncobjDestroy(vm->fd, done_sync);
+   return completed;
+}
+
+bool
+pvr_job_submit_compute_async(struct pvr_vm *vm, uint32_t context_handle,
+                             const void *stream, uint32_t stream_len, uint32_t *sync_out)
+{
+   uint32_t done_sync = 0;
+   struct drm_pvr_sync_op ops[1];
+   struct drm_pvr_job job;
+
+   *sync_out = 0;
+   if (drmSyncobjCreate(vm->fd, 0, &done_sync) != 0)
+      return false;
+
+   ops[0] = (struct drm_pvr_sync_op){
+      .handle = done_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL,
+   };
+   job = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_COMPUTE,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)stream,
+      .cmd_stream_len = stream_len,
+      .sync_ops = { .stride = sizeof(ops[0]), .count = 1, .array = (__u64)(uintptr_t)ops },
+   };
+   {
+      struct drm_pvr_ioctl_submit_jobs_args args = {
+         .jobs = { .stride = sizeof(job), .count = 1, .array = (__u64)(uintptr_t)&job },
+      };
+
+      if (drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) != 0) {
+         mesa_loge("pvr: SUBMIT_JOBS compute (%u B) failed: %s", stream_len, strerror(errno));
+         drmSyncobjDestroy(vm->fd, done_sync);
+         return false;
+      }
+   }
+
+   *sync_out = done_sync;
+   return true;
+}
+
+bool
+pvr_compute_sync_wait(struct pvr_vm *vm, uint32_t sync, uint32_t timeout_ms)
+{
+   bool completed = pvr_syncobj_wait(vm, sync, timeout_ms);
+
+   if (!completed)
+      mesa_loge("pvr: compute job did not signal completion within %u ms", timeout_ms);
+   drmSyncobjDestroy(vm->fd, sync);
+   return completed;
+}
+
+bool
+pvr_job_submit_compute_sync(struct pvr_vm *vm, uint32_t context_handle,
+                            const void *stream, uint32_t stream_len, uint32_t timeout_ms)
+{
+   uint32_t done_sync = 0;
+
+   if (!pvr_job_submit_compute_async(vm, context_handle, stream, stream_len, &done_sync))
+      return false;
+
+   return pvr_compute_sync_wait(vm, done_sync, timeout_ms);
+}
+
+bool
+pvr_job_submit_render(struct pvr_vm *vm, uint32_t context_handle,
+                      const void *geom_stream, uint32_t geom_len,
+                      const void *frag_stream, uint32_t frag_len,
+                      uint32_t hwrt_set_handle, uint32_t hwrt_data_index, uint32_t frag_flags,
+                      uint32_t *done_out)
+{
+   /* Geometry and fragment jobs are different job types, so the kernel does not order them against
+    * each other; the reference chains them with syncobjs and submits THREE jobs: geometry, a
+    * partial-render fragment job, then the fragment job. The geometry and PR jobs pair into one
+    * combined kick (the kernel pairs them when the fragment job waits on the geometry job's
+    * scheduled fence). Submitting fewer than that leaves the firmware with a render it never
+    * completes: accepted by the kernel, no pixels, no error. */
+   uint32_t geom_sync = 0, pr_sync = 0, done_sync = 0;
+   struct drm_pvr_sync_op geom_ops[1], pr_ops[2], frag_ops[2];
+   struct drm_pvr_job jobs[3];
+   struct drm_pvr_ioctl_submit_jobs_args args = {
+      .jobs = { .stride = sizeof(jobs[0]), .count = ARRAY_SIZE(jobs),
+                .array = (__u64)(uintptr_t)jobs },
+   };
+   bool submitted, completed;
+
+   if (drmSyncobjCreate(vm->fd, 0, &geom_sync) != 0)
+      return false;
+   if (drmSyncobjCreate(vm->fd, 0, &pr_sync) != 0) {
+      drmSyncobjDestroy(vm->fd, geom_sync);
+      return false;
+   }
+   if (drmSyncobjCreate(vm->fd, 0, &done_sync) != 0) {
+      drmSyncobjDestroy(vm->fd, pr_sync);
+      drmSyncobjDestroy(vm->fd, geom_sync);
+      return false;
+   }
+
+   geom_ops[0] = (struct drm_pvr_sync_op){
+      .handle = geom_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   pr_ops[0] = (struct drm_pvr_sync_op){
+      .handle = geom_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_WAIT | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   pr_ops[1] = (struct drm_pvr_sync_op){
+      .handle = pr_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+   /* No wait on the partial-render job, as the reference: the kernel keeps fragment jobs of a
+    * context in submission order, and an explicit dependency costs a scheduler round trip between
+    * the geometry and fragment passes. done_sync is what the caller waits on. */
+   frag_ops[0] = (struct drm_pvr_sync_op){
+      .handle = done_sync,
+      .flags = DRM_PVR_SYNC_OP_FLAG_SIGNAL | DRM_PVR_SYNC_OP_FLAG_HANDLE_TYPE_SYNCOBJ,
+   };
+
+   jobs[0] = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_GEOMETRY,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)geom_stream,
+      .cmd_stream_len = geom_len,
+      .flags = DRM_PVR_SUBMIT_JOB_GEOM_CMD_FIRST | DRM_PVR_SUBMIT_JOB_GEOM_CMD_LAST,
+      .sync_ops = { .stride = sizeof(geom_ops[0]), .count = 1,
+                    .array = (__u64)(uintptr_t)geom_ops },
+      .hwrt = { .set_handle = hwrt_set_handle,
+                .data_index = getenv("PVR_PROBE_HWRT_IDX")
+                                 ? (uint32_t)strtoul(getenv("PVR_PROBE_HWRT_IDX"), NULL, 0)
+                                 : hwrt_data_index },
+   };
+   jobs[1] = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_FRAGMENT,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)frag_stream,
+      .cmd_stream_len = frag_len,
+      .flags = DRM_PVR_SUBMIT_JOB_FRAG_CMD_PARTIAL_RENDER |
+               DRM_PVR_SUBMIT_JOB_FRAG_CMD_DISABLE_PIXELMERGE | frag_flags,
+      .sync_ops = { .stride = sizeof(pr_ops[0]), .count = ARRAY_SIZE(pr_ops),
+                    .array = (__u64)(uintptr_t)pr_ops },
+      .hwrt = { .set_handle = hwrt_set_handle,
+                .data_index = getenv("PVR_PROBE_HWRT_IDX")
+                                 ? (uint32_t)strtoul(getenv("PVR_PROBE_HWRT_IDX"), NULL, 0)
+                                 : hwrt_data_index },
+   };
+   jobs[2] = (struct drm_pvr_job){
+      .type = DRM_PVR_JOB_TYPE_FRAGMENT,
+      .context_handle = context_handle,
+      .cmd_stream = (uint64_t)(uintptr_t)frag_stream,
+      .cmd_stream_len = frag_len,
+      /* As the reference, which always disables it ("enable pixel merging when it is safe"). */
+      .flags = DRM_PVR_SUBMIT_JOB_FRAG_CMD_DISABLE_PIXELMERGE | frag_flags,
+      .sync_ops = { .stride = sizeof(frag_ops[0]), .count = 1,
+                    .array = (__u64)(uintptr_t)frag_ops },
+      .hwrt = { .set_handle = hwrt_set_handle,
+                .data_index = getenv("PVR_PROBE_HWRT_IDX")
+                                 ? (uint32_t)strtoul(getenv("PVR_PROBE_HWRT_IDX"), NULL, 0)
+                                 : hwrt_data_index },
+   };
+
+   submitted = drmIoctl(vm->fd, DRM_IOCTL_PVR_SUBMIT_JOBS, &args) == 0;
+   if (!submitted)
+      mesa_loge("pvr: SUBMIT_JOBS render (geom %u B, frag %u B) failed: %s", geom_len,
+                frag_len, strerror(errno));
+
+   if (submitted && getenv("PVR_PROBE_TRACE_SYNC") != NULL) {
+      const bool geom_done = pvr_syncobj_wait(vm, geom_sync, 500);
+
+      mesa_logi("pvr: geometry job %s", geom_done ? "COMPLETED" : "did not complete in 500 ms");
+   }
+
+   /* With done_out the caller owns the completion syncobj and waits when it needs to. */
+   if (done_out != NULL) {
+      drmSyncobjDestroy(vm->fd, pr_sync);
+      drmSyncobjDestroy(vm->fd, geom_sync);
+      if (submitted)
+         *done_out = done_sync;
+      else
+         drmSyncobjDestroy(vm->fd, done_sync);
+      return submitted;
+   }
+   completed = submitted && pvr_syncobj_wait(vm, done_sync, 2000);
+   if (submitted && !completed)
+      mesa_loge("pvr: the render job did not signal completion within 2 s");
+   drmSyncobjDestroy(vm->fd, done_sync);
+   drmSyncobjDestroy(vm->fd, pr_sync);
+   drmSyncobjDestroy(vm->fd, geom_sync);
+
+   return completed;
+}
+
+/* Free lists and the HWRT data set are what a RENDER job needs beyond its command stream: the
+ * kernel refuses a geometry/fragment job without a hwrt reference (EINVAL), and the data set itself
+ * needs two free lists. Both are plain ioctls over addresses this driver allocates; the sizes are
+ * the caller's, because only the caller knows the target and the mtile layout. */
+bool
+pvr_free_list_create(struct pvr_vm *vm, uint64_t gpu_addr, uint32_t initial_num_pages,
+                     uint32_t max_num_pages, uint32_t grow_num_pages, uint32_t grow_threshold,
+                     uint32_t *handle_out)
+{
+   struct drm_pvr_ioctl_create_free_list_args args = {
+      .free_list_gpu_addr = gpu_addr,
+      .initial_num_pages = initial_num_pages,
+      .max_num_pages = max_num_pages,
+      .grow_num_pages = grow_num_pages,
+      .grow_threshold = grow_threshold,
+      .vm_context_handle = vm->context_handle,
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_CREATE_FREE_LIST, &args) != 0) {
+      mesa_loge("pvr: CREATE_FREE_LIST (%u..%u pages at 0x%" PRIx64 ") failed: %s",
+                initial_num_pages, max_num_pages, gpu_addr, strerror(errno));
+      return false;
+   }
+
+   *handle_out = args.handle;
+   return true;
+}
+
+void
+pvr_free_list_destroy(struct pvr_vm *vm, uint32_t handle)
+{
+   struct drm_pvr_ioctl_destroy_free_list_args args = { .handle = handle };
+   if (handle != 0 && drmIoctl(vm->fd, DRM_IOCTL_PVR_DESTROY_FREE_LIST, &args) != 0)
+      mesa_loge("pvr: DESTROY_FREE_LIST failed: %s", strerror(errno));
+}
+
+void
+pvr_hwrt_dataset_destroy(struct pvr_vm *vm, uint32_t handle)
+{
+   struct drm_pvr_ioctl_destroy_hwrt_dataset_args args = { .handle = handle };
+   if (handle != 0 && drmIoctl(vm->fd, DRM_IOCTL_PVR_DESTROY_HWRT_DATASET, &args) != 0)
+      mesa_loge("pvr: DESTROY_HWRT_DATASET failed: %s", strerror(errno));
+}
+
+bool
+pvr_hwrt_dataset_create(struct pvr_vm *vm, const struct pvr_hwrt_dataset_desc *desc,
+                        uint32_t *handle_out)
+{
+   struct drm_pvr_ioctl_create_hwrt_dataset_args args = {
+      .geom_data_args = {
+         .tpc_dev_addr = desc->tpc_dev_addr,
+         .tpc_size = desc->tpc_size,
+         .tpc_stride = desc->tpc_stride,
+         .vheap_table_dev_addr = desc->vheap_table_dev_addr,
+         .rtc_dev_addr = desc->rtc_dev_addr,
+      },
+      .rt_data_args = {
+         {
+            .pm_mlist_dev_addr = desc->pm_mlist_dev_addr[0],
+            .macrotile_array_dev_addr = desc->macrotile_array_dev_addr[0],
+            .region_header_dev_addr = desc->region_header_dev_addr[0],
+         }, {
+            .pm_mlist_dev_addr = desc->pm_mlist_dev_addr[1],
+            .macrotile_array_dev_addr = desc->macrotile_array_dev_addr[1],
+            .region_header_dev_addr = desc->region_header_dev_addr[1],
+         },
+      },
+      .free_list_handles = { desc->free_list_handles[0], desc->free_list_handles[1] },
+      .width = desc->width,
+      .height = desc->height,
+      .samples = desc->samples,
+      .layers = desc->layers,
+      .isp_merge_lower_x = desc->isp_merge_lower_x,
+      .isp_merge_lower_y = desc->isp_merge_lower_y,
+      .isp_merge_scale_x = desc->isp_merge_scale_x,
+      .isp_merge_scale_y = desc->isp_merge_scale_y,
+      .isp_merge_upper_x = desc->isp_merge_upper_x,
+      .isp_merge_upper_y = desc->isp_merge_upper_y,
+      .region_header_size = desc->region_header_size,
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_CREATE_HWRT_DATASET, &args) != 0) {
+      mesa_loge("pvr: CREATE_HWRT_DATASET (%ux%u, %u sample(s), %u layer(s)) failed: %s",
+                desc->width, desc->height, desc->samples, desc->layers, strerror(errno));
+      return false;
+   }
+
+   *handle_out = args.handle;
+   return true;
+}
+
+/* The device's own free-list page limits. A guessed range is refused with EINVAL, so the numbers come
+ * from the kernel rather than from a plausible-looking constant. */
+bool
+pvr_free_list_page_limits(int fd, uint32_t *min_pages_out, uint32_t *max_pages_out)
+{
+   struct drm_pvr_dev_query_runtime_info kmd = { 0 };
+   struct drm_pvr_ioctl_dev_query_args args = {
+      .type = DRM_PVR_DEV_QUERY_RUNTIME_INFO_GET,
+      .size = sizeof(kmd),
+      .pointer = (__u64)&kmd,
+   };
+
+   if (drmIoctl(fd, DRM_IOCTL_PVR_DEV_QUERY, &args) != 0) {
+      mesa_loge("pvr: runtime-info query failed: %s", strerror(errno));
+      return false;
+   }
+
+   *min_pages_out = kmd.free_list_min_pages;
+   *max_pages_out = kmd.free_list_max_pages;
+   return true;
+}
+
+void
+pvr_vm_finish(struct pvr_vm *vm)
+{
+   struct drm_pvr_ioctl_destroy_vm_context_args args = {
+      .handle = vm->context_handle,
+   };
+
+   util_vma_heap_finish(&vm->vma);
+
+   if (vm->context_handle != 0)
+      drmIoctl(vm->fd, DRM_IOCTL_PVR_DESTROY_VM_CONTEXT, &args);
+
+   vm->context_handle = 0;
+}
+
+const struct drm_pvr_static_data_area *
+pvr_vm_static_area(const struct pvr_vm *vm, uint16_t usage, uint16_t heap_id)
+{
+   for (unsigned i = 0; i < vm->nr_areas; i++) {
+      if (vm->areas[i].area_usage == usage && vm->areas[i].location_heap_id == heap_id)
+         return &vm->areas[i];
+   }
+
+   return NULL;
+}
+
+uint64_t
+pvr_vm_heap_alloc(struct pvr_vm *vm, uint16_t heap_id, uint64_t size,
+                  uint64_t align, struct pvr_bo *bo_out)
+{
+   struct pvr_heap *heap;
+   uint64_t at;
+
+   if (heap_id >= DRM_PVR_HEAP_COUNT)
+      return 0;
+
+   heap = &vm->heaps[heap_id];
+   if (heap->size == 0 || size == 0)
+      return 0;
+
+   /* VM_MAP is page-granular, so every object starts on a page. The first object starts at the
+    * first page of the usable area: the firmware's carveout may not end on a page boundary. */
+   if (vm->heap_next[heap_id] == 0)
+      vm->heap_next[heap_id] = ALIGN_POT(heap->usable_base, (uint64_t)heap->page_size);
+
+   at = ALIGN_POT(vm->heap_next[heap_id], MAX2(align, (uint64_t)heap->page_size));
+   if (at + size > heap->base + heap->size) {
+      mesa_loge("pvr: heap %u is full (wanted 0x%" PRIx64 " at 0x%" PRIx64 ", ends 0x%"
+                PRIx64 ")", heap_id, size, at, heap->base + heap->size);
+      return 0;
+   }
+
+   if (!pvr_bo_create(vm->fd, size, MAX2(align, (uint64_t)heap->page_size), bo_out))
+      return 0;
+
+   if (!pvr_vm_map(vm, at, bo_out->handle, bo_out->size)) {
+      pvr_bo_destroy(vm->fd, bo_out);
+      return 0;
+   }
+
+   vm->heap_next[heap_id] = at + bo_out->size;
+   return at;
+}
+
+bool
+pvr_vm_alloc_carveout(struct pvr_vm *vm, uint16_t heap_id, struct pvr_bo *bo_out,
+                      uint64_t *base_out)
+{
+   const struct pvr_heap *heap;
+   uint64_t carveout_size;
+
+   if (heap_id >= DRM_PVR_HEAP_COUNT || vm->heaps[heap_id].size == 0) {
+      mesa_loge("pvr: heap %u is absent", heap_id);
+      return false;
+   }
+
+   heap = &vm->heaps[heap_id];
+   carveout_size = heap->size - heap->usable_size;
+
+   if (carveout_size == 0) {
+      mesa_logi("pvr: heap %u has no firmware carveout", heap_id);
+      return false;
+   }
+
+   if (!pvr_bo_create(vm->fd, carveout_size, 1, bo_out))
+      return false;
+
+   if (!pvr_vm_map(vm, heap->base, bo_out->handle, bo_out->size)) {
+      pvr_bo_destroy(vm->fd, bo_out);
+      return false;
+   }
+
+   *base_out = heap->base;
+
+   return true;
+}
+
+uint64_t
+pvr_vm_alloc_at(struct pvr_vm *vm, uint64_t addr, uint64_t size)
+{
+   const uint64_t aligned_size = ALIGN_POT(size, (uint64_t)vm->general.page_size);
+
+   if (!util_vma_heap_alloc_addr(&vm->vma, addr, aligned_size))
+      return 0;
+
+   return addr;
+}
+
+uint64_t
+pvr_vm_alloc(struct pvr_vm *vm, uint64_t size, uint64_t alignment)
+{
+   const uint64_t align = MAX2(alignment, (uint64_t)vm->general.page_size);
+   const uint64_t aligned_size = ALIGN_POT(size, align);
+
+   /* The heap was seeded with an absolute address, so the value that comes back is an
+    * absolute device address and can be handed to VM_MAP as-is. 0 means failure, which
+    * is exactly why a heap must never start at 0. */
+   /* `align` was computed and then ignored - the heap was always given page_size, so every
+      * caller's alignment request was silently dropped. The PBE render-target encoding depends on
+      * this: its address needs bits 32/33 clear, which a 16 GiB alignment guarantees. */
+     return util_vma_heap_alloc(&vm->vma, aligned_size, align);
+}
+
+void
+pvr_vm_free(struct pvr_vm *vm, uint64_t dev_addr, uint64_t size)
+{
+   const uint64_t align = MAX2((uint64_t)1, (uint64_t)vm->general.page_size);
+   const uint64_t aligned_size = ALIGN_POT(size, align);
+
+   util_vma_heap_free(&vm->vma, dev_addr, aligned_size);
+}
+
+bool
+pvr_vm_map(struct pvr_vm *vm, uint64_t dev_addr, uint32_t handle, uint64_t size)
+{
+   /* Whole-buffer mapping only, so the "virtual offset" is zero and the address the
+    * GPU sees is dev_addr. Mapping at a sub-page offset would move the GPU's view to
+    * dev_addr + offset_in_page, which is a silent-wrong-bytes trap for later. */
+   struct drm_pvr_ioctl_vm_map_args args = {
+      .vm_context_handle = vm->context_handle,
+      .device_addr = dev_addr,
+      .handle = handle,
+      .offset = 0,
+      .size = size,
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_VM_MAP, &args) != 0) {
+      mesa_loge("pvr: VM_MAP addr 0x%" PRIx64 " handle %u size %" PRIu64 " failed: %s",
+                dev_addr, handle, size, strerror(errno));
+      return false;
+   }
+   /* A buffer mapped at a chosen address inside a code heap has to move that heap's bump pointer
+    * past it. Otherwise a later pvr_vm_heap_alloc() hands out the same pages, and VM_MAP silently
+    * replaces the earlier mapping (drm_gpuvm unmaps what a new mapping overlaps): the GPU then
+    * runs whatever the newer buffer holds instead of the program that was placed there. */
+   for (uint16_t h = 0; h < DRM_PVR_HEAP_COUNT; h++) {
+      const struct pvr_heap *heap = &vm->heaps[h];
+      if (h == DRM_PVR_HEAP_GENERAL || heap->size == 0 || dev_addr < heap->base ||
+          dev_addr >= heap->base + heap->size)
+         continue;
+      if (vm->heap_next[h] < dev_addr + size)
+         vm->heap_next[h] = dev_addr + size;
+   }
+   return true;
+}
+
+bool
+pvr_vm_unmap(struct pvr_vm *vm, uint64_t dev_addr, uint64_t size)
+{
+   /* The kernel keys removal on the size, so this must be the exact size that was
+    * mapped - a smaller value would leave part of the mapping behind. */
+   struct drm_pvr_ioctl_vm_unmap_args args = {
+      .vm_context_handle = vm->context_handle,
+      .device_addr = dev_addr,
+      .size = size,
+   };
+
+   if (drmIoctl(vm->fd, DRM_IOCTL_PVR_VM_UNMAP, &args) != 0) {
+      mesa_loge("pvr: VM_UNMAP addr 0x%" PRIx64 " size %" PRIu64 " failed: %s",
+                dev_addr, size, strerror(errno));
+      return false;
+   }
+
+   return true;
+}
diff --git a/src/gallium/drivers/pvr_native/pvr_vm.h b/src/gallium/drivers/pvr_native/pvr_vm.h
new file mode 100644
index 00000000..31270d93
--- /dev/null
+++ b/src/gallium/drivers/pvr_native/pvr_vm.h
@@ -0,0 +1,201 @@
+/* Copyright 2026 The Mesa authors
+ * SPDX-License-Identifier: MIT
+ *
+ * The GPU address space, as far as this driver uses it: one general-purpose heap,
+ * a bump-free allocator over it, and a VM context to map buffer objects into.
+ *
+ * Queried from the kernel, never hardcoded - the heap bases and sizes come from
+ * DRM_PVR_DEV_QUERY_HEAP_INFO_GET and may differ per device.
+ */
+#ifndef PVR_VM_H
+#define PVR_VM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "util/vma.h"
+
+#include "pvr_bo.h"
+#include "pvr_static.h"
+
+#include "drm-uapi/pvr_drm.h"
+
+struct pvr_heap {
+   uint64_t base;        /* as the kernel reports it */
+   uint64_t size;
+   uint64_t usable_base; /* base + the firmware's static-data carveout */
+   uint64_t usable_size;
+   uint32_t page_size;   /* the heap's own page size, from page_size_log2 */
+};
+
+/* Up to DRM_PVR_STATIC_DATA_AREA_MAX entries, kept because the firmware addresses for
+ * the fence area, the YUV CSC coefficients and the sync programs live in the first
+ * bytes of the heaps and the static context state has to point at them. Summing their
+ * sizes (all an earlier round needed) is not enough to write that state. */
+struct pvr_vm {
+   int fd;
+   uint32_t context_handle; /* from DRM_IOCTL_PVR_CREATE_VM_CONTEXT */
+   /* All heaps, because the firmware's static memory is not all in the general heap:
+    * the PDS and USC carveouts hold the sync and pixel-event programs. Only the general
+    * heap has a free-space allocator (ordinary buffers), but every heap's carveout has
+    * to be reserved before firmware structures can be placed in it. */
+   struct pvr_heap heaps[DRM_PVR_HEAP_COUNT];
+   struct pvr_heap general; /* alias for heaps[DRM_PVR_HEAP_GENERAL] */
+   struct util_vma_heap vma;
+
+   /* Bump allocation inside each non-general heap's usable area. Programs the firmware names by
+    * heap-relative offset (PDS programs, USC code, context-switch state buffers) live at chosen
+    * addresses in their heap, so a shared bump pointer per heap is what keeps them from overlapping. */
+   uint64_t heap_next[DRM_PVR_HEAP_COUNT];
+
+   /* The UAPI has four areas (EOT, FENCE, VDM_SYNC, YUV_CSC) but does not export a
+  * count, so the array is sized with room to spare and nr_areas is what is trusted. */
+   struct drm_pvr_static_data_area areas[8];
+   unsigned nr_areas;
+
+   /* Where each firmware structure sits inside its heap, as byte offsets from the heap
+    * base, or PVR_STATIC_ABSENT when the heap does not have that area at all.
+    *
+    * The sentinel is not decoration: offset 0 is a real address (the general heap's
+    * fence area is at 0), so a zero-initialised table cannot distinguish "this heap has
+    * no EOT area" from "the EOT area is first". Treating the former as the latter writes
+    * a program over whatever the heap does begin with. */
+#define PVR_STATIC_ABSENT UINT64_MAX
+   struct {
+      uint64_t eot;
+      uint64_t fence;
+      uint64_t vdm_sync;
+      uint64_t yuv_csc;
+   } offsets[DRM_PVR_HEAP_COUNT];
+};
+
+/* Returns the area serving `usage`, or NULL. The kernel's table is authoritative for
+ * where these live - the driver only reads it. */
+const struct drm_pvr_static_data_area *
+pvr_vm_static_area(const struct pvr_vm *vm, uint16_t usage, uint16_t heap_id);
+
+/* Reserves the firmware carveout: one buffer mapped over the whole reserved region.
+ *
+ * Deliberately ONE mapping, not one per area. The areas are packed inside a single
+ * page - fence 128 bytes at offset 0 and YUV CSC 1024 bytes at offset 128 on this
+ * hardware - while VM_MAP is page-granular, so mapping a page-sized buffer at each area
+ * makes them overlap and the kernel rejects it with EINVAL. That is how this was
+ * found: the per-area version passed against the DRM shim and failed against the real
+ * kernel question. Structures are placed at offsets inside this one mapping, addressed
+ * as carveout_base + area->offset().
+ *
+ * pvr_vm_alloc() never returns an address inside the carveout, which is what keeps
+ * ordinary buffers from overwriting firmware state. */
+bool pvr_vm_alloc_carveout(struct pvr_vm *vm, uint16_t heap_id,
+                           struct pvr_bo *bo_out, uint64_t *base_out);
+
+/* Allocate and map a buffer at the next free address in a heap's usable area, returning its device
+ * address. For heaps whose contents are named by heap-relative offsets; the general heap has a real
+ * allocator (pvr_vm_alloc) instead. `align` is raised to the heap's page size because VM_MAP is
+ * page-granular. Returns 0 on failure. */
+uint64_t pvr_vm_heap_alloc(struct pvr_vm *vm, uint16_t heap_id, uint64_t size,
+                           uint64_t align, struct pvr_bo *bo_out);
+
+/* A kernel GPU context: the handle every job is submitted against. Creating it needs the
+ * static context state and a VDM callstack, which is eight bytes (one level) allocated
+ * from the ordinary general heap rather than the firmware carveout. */
+struct pvr_gpu_context {
+   uint32_t handle;
+   struct pvr_bo callstack_bo;
+   uint64_t callstack_addr;
+   /* Context-switch programs and state buffers. They must outlive the context: the firmware reads
+    * the programs and the static context state names them. */
+   struct pvr_ctx_switch cswitch;
+};
+
+bool pvr_gpu_context_create(struct pvr_vm *vm, const struct pvr_device_info *dev_info,
+                            struct pvr_gpu_context *ctx);
+void pvr_gpu_context_destroy(struct pvr_vm *vm, struct pvr_gpu_context *ctx);
+
+/* Submit one job. `cmd_stream` is the DEVICE address of the control stream the GPU will
+ * execute, not a CPU pointer and not a buffer handle - the kernel takes the address the
+ * GPU sees. A job with no sync operations is submitted without any: the driver has no
+ * fences yet, and inventing a wait it cannot signal would be worse than submitting
+ * unsynchronised work it cannot yet produce. */
+/* Everything a render job needs besides its command stream: the kernel refuses a geometry or
+ * fragment job whose drm_pvr_job.hwrt does not reference a created data set. */
+struct pvr_hwrt_dataset_desc {
+   uint64_t tpc_dev_addr;
+   uint32_t tpc_size;
+   uint32_t tpc_stride;
+   uint64_t vheap_table_dev_addr;
+   uint64_t rtc_dev_addr;
+   uint64_t pm_mlist_dev_addr[2];
+   uint64_t macrotile_array_dev_addr[2];
+   uint64_t region_header_dev_addr[2];
+   uint32_t free_list_handles[2];
+   uint32_t width, height, samples, layers;
+   uint32_t isp_merge_lower_x, isp_merge_lower_y;
+   uint32_t isp_merge_scale_x, isp_merge_scale_y;
+   uint32_t isp_merge_upper_x, isp_merge_upper_y;
+   uint32_t region_header_size;
+};
+
+bool pvr_free_list_page_limits(int fd, uint32_t *min_pages_out, uint32_t *max_pages_out);
+bool pvr_free_list_create(struct pvr_vm *vm, uint64_t gpu_addr, uint32_t initial_num_pages,
+                          uint32_t max_num_pages, uint32_t grow_num_pages,
+                          uint32_t grow_threshold, uint32_t *handle_out);
+/* Destroy ioctls for a free list and an HWRT data set; the caller frees their buffers after. */
+void pvr_free_list_destroy(struct pvr_vm *vm, uint32_t handle);
+void pvr_hwrt_dataset_destroy(struct pvr_vm *vm, uint32_t handle);
+
+bool pvr_hwrt_dataset_create(struct pvr_vm *vm, const struct pvr_hwrt_dataset_desc *desc,
+                             uint32_t *handle_out);
+
+/* Submit ONE geometry job and wait for it on the CPU. Used to find out whether the firmware
+ * accepts a stream at all: a job that never signals means the firmware stalled or rejected the
+ * command stream, and the kernel reports neither. */
+bool pvr_job_submit_geom_sync(struct pvr_vm *vm, uint32_t context_handle,
+                              const void *geom_stream, uint32_t geom_len,
+                              uint32_t hwrt_set_handle, uint32_t hwrt_data_index,
+                              uint32_t timeout_ms);
+
+/* Submit one fragment job and wait for its completion syncobj. Used to tell whether a context can
+ * dispatch jobs at all when no geometry kick is involved. */
+bool pvr_job_submit_transfer_sync(struct pvr_vm *vm, uint32_t context_handle,
+                                  const void *stream, uint32_t stream_len, uint32_t timeout_ms);
+bool pvr_job_submit_compute_sync(struct pvr_vm *vm, uint32_t context_handle,
+                                 const void *stream, uint32_t stream_len, uint32_t timeout_ms);
+
+/* Submit a compute job and return its completion syncobj without waiting, plus the matching wait. */
+bool pvr_job_submit_compute_async(struct pvr_vm *vm, uint32_t context_handle,
+                                  const void *stream, uint32_t stream_len, uint32_t *sync_out);
+bool pvr_compute_sync_wait(struct pvr_vm *vm, uint32_t sync, uint32_t timeout_ms);
+
+bool pvr_job_submit_frag_sync(struct pvr_vm *vm, uint32_t context_handle,
+                              const void *frag_stream, uint32_t frag_len,
+                              uint32_t hwrt_set_handle, uint32_t hwrt_data_index,
+                              uint32_t timeout_ms);
+
+bool pvr_job_submit_render(struct pvr_vm *vm, uint32_t context_handle,
+                            const void *geom_stream, uint32_t geom_len,
+                            const void *frag_stream, uint32_t frag_len,
+                            uint32_t hwrt_set_handle, uint32_t hwrt_data_index, uint32_t frag_flags,
+                           uint32_t *done_out);
+bool pvr_job_submit(struct pvr_vm *vm, uint32_t context_handle, uint32_t job_type,
+                    const void *cmd_stream, uint32_t cmd_stream_len,
+                    uint32_t hwrt_set_handle, uint32_t hwrt_data_index);
+
+bool pvr_vm_init(int fd, struct pvr_vm *vm);
+void pvr_vm_finish(struct pvr_vm *vm);
+
+/* Returns an absolute device address, or 0 on failure. */
+uint64_t pvr_vm_alloc(struct pvr_vm *vm, uint64_t size, uint64_t alignment);
+
+/* Reserve a specific device address in the VM heap (used to reproduce another client's address
+ * layout). Returns the address on success, 0 if the range is already taken. */
+uint64_t pvr_vm_alloc_at(struct pvr_vm *vm, uint64_t addr, uint64_t size);
+/* size must be the same page-aligned size that was allocated. */
+void pvr_vm_free(struct pvr_vm *vm, uint64_t dev_addr, uint64_t size);
+
+/* Map a whole buffer object at dev_addr. size must be host-page aligned, and whole-BO
+ * mappings (no sub-page offset) are all v1 needs. */
+bool pvr_vm_map(struct pvr_vm *vm, uint64_t dev_addr, uint32_t handle, uint64_t size);
+bool pvr_vm_unmap(struct pvr_vm *vm, uint64_t dev_addr, uint64_t size);
+
+#endif /* PVR_VM_H */
