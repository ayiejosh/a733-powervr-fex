diff --git a/src/imagination/pco/pco_nir_16bit_io.c b/src/imagination/pco/pco_nir_16bit_io.c
new file mode 100644
index 0000000..0a447d7
--- /dev/null
+++ b/src/imagination/pco/pco_nir_16bit_io.c
@@ -0,0 +1,182 @@
+/*
+ * Copyright © 2026 Imagination Technologies Ltd.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "pco_internal.h"
+#include "nir_builder.h"
+
+/**
+ * \file pco_nir_16bit_io.c
+ *
+ * \brief Lowers 16-bit shader inputs and outputs to 32 bits.
+ *
+ * VK_KHR_16bit_storage's `storageInputOutput16` allows 16-bit *types* in the
+ * shader input and output interfaces. pco has no 16-bit I/O: the two places that
+ * would have to know are `trans_load_input_vs()` and `trans_store_output_vs()`,
+ * both of which say "TODO: f16 support" and both of which assert the type is
+ * 32-bit - and both asserts are compiled out here, because this build is
+ * `buildtype=release`, so a 16-bit varying does not fail loudly, it translates as
+ * a whole 32-bit register.
+ *
+ * Rather than teach the translator a packing convention, this promotes the
+ * interface to 32 bits and converts at the boundary. That is exact: f16 -> f32 ->
+ * f16 and u16 -> u32 -> u16 round-trip without loss. It is also the cheaper of
+ * the two options, because it leaves every consumer of the interface alone - the
+ * varying allocation in `pvr_arch_pipeline.c`, the PPP/PDS varying state, and the
+ * VDM's attribute formats all then see the 32-bit types they already handle. The
+ * only interfaces that leave the driver are the vertex input and the framebuffer,
+ * and both are format-driven conversions the hardware does anyway.
+ *
+ * The two halves have to happen together. Rewriting the intrinsics without the
+ * variable types would leave the varying allocation sizing a f16vec2 as one dword
+ * (`glsl_count_dword_slots()` returns DIV_ROUND_UP(components, 2) for 16-bit
+ * types) while the shader now stores two f32 components into it.
+ *
+ * The intrinsics are rewritten *in place*, the way `nir_lower_mediump_io()` does
+ * it, rather than duplicated with a different width. That matters for
+ * `load_interpolated_input`, whose second source is a barycentric instruction
+ * rather than an SSA def: a naive copy of `src[i].ssa` there builds a load with a
+ * null source, and the NIR is invalid enough to crash `nir_opt_copy_prop()` a
+ * few passes later - which is exactly what happened the first time.
+ *
+ * This runs after `nir_lower_io()` and `nir_lower_io_to_scalar()`, so what it
+ * sees is one scalar intrinsic per component. It is a no-op for any shader that
+ * does not use 16-bit I/O, which is every shader until the feature is advertised.
+ */
+
+static enum glsl_base_type
+widen_16bit_base_type(enum glsl_base_type base_type)
+{
+   switch (base_type) {
+   case GLSL_TYPE_FLOAT16:
+      return GLSL_TYPE_FLOAT;
+   case GLSL_TYPE_UINT16:
+      return GLSL_TYPE_UINT;
+   case GLSL_TYPE_INT16:
+      return GLSL_TYPE_INT;
+   default:
+      return base_type;
+   }
+}
+
+static const glsl_type *
+widen_16bit_type(const glsl_type *type)
+{
+   if (glsl_type_is_array(type)) {
+      return glsl_array_type(widen_16bit_type(glsl_get_array_element(type)),
+                             glsl_get_length(type),
+                             glsl_get_explicit_stride(type));
+   }
+
+   if (glsl_type_is_matrix(type)) {
+      return glsl_matrix_type(widen_16bit_base_type(glsl_get_base_type(type)),
+                              glsl_get_matrix_columns(type),
+                              glsl_get_vector_elements(type));
+   }
+
+   if (glsl_type_is_vector_or_scalar(type)) {
+      return glsl_vector_type(widen_16bit_base_type(glsl_get_base_type(type)),
+                              glsl_get_components(type));
+   }
+
+   return type;
+}
+
+/** Widens a 16-bit value to 32 bits, preserving the base type. */
+static nir_def *
+widen_to_32(nir_builder *b, nir_def *value, nir_alu_type type)
+{
+   switch (nir_alu_type_get_base_type(type)) {
+   case nir_type_float:
+      return nir_f2f32(b, value);
+   case nir_type_int:
+      return nir_i2i32(b, value);
+   default:
+      return nir_u2u32(b, value);
+   }
+}
+
+/** Narrows a 32-bit value back to 16 bits, preserving the base type. */
+static nir_def *
+narrow_to_16(nir_builder *b, nir_def *value, nir_alu_type type)
+{
+   switch (nir_alu_type_get_base_type(type)) {
+   case nir_type_float:
+      return nir_f2f16(b, value);
+   case nir_type_int:
+      return nir_i2i16(b, value);
+   default:
+      return nir_u2u16(b, value);
+   }
+}
+
+/** Rewrites the interface type of a 16-bit value to its 32-bit equivalent. */
+static nir_alu_type
+widen_alu_type(nir_alu_type type)
+{
+   return (type & ~16) | 32;
+}
+
+static bool
+lower_16bit_io_instr(nir_builder *b, nir_intrinsic_instr *intr, UNUSED void *data)
+{
+   nir_variable_mode mode;
+   nir_intrinsic_instr *io =
+      nir_get_io_intrinsic(&intr->instr, nir_var_shader_in | nir_var_shader_out,
+                           &mode);
+   nir_alu_type type;
+
+   if (!io)
+      return false;
+
+   if (nir_intrinsic_has_src_type(io)) {
+      /* Stores: widen the value, then say so on the store. */
+      type = nir_intrinsic_src_type(io);
+      if (nir_alu_type_get_type_size(type) != 16)
+         return false;
+
+      b->cursor = nir_before_instr(&io->instr);
+      nir_src_rewrite(&io->src[0], widen_to_32(b, io->src[0].ssa, type));
+      nir_intrinsic_set_src_type(io, widen_alu_type(type));
+   } else if (nir_intrinsic_has_dest_type(io)) {
+      /* Loads: widen the result, then narrow it back for the shader's own use.
+       * The rewrite has to skip the conversion just inserted, which reads the
+       * wide def itself - hence _after and not nir_def_rewrite_uses(). */
+      type = nir_intrinsic_dest_type(io);
+      if (nir_alu_type_get_type_size(type) != 16)
+         return false;
+
+      b->cursor = nir_after_instr(&io->instr);
+      io->def.bit_size = 32;
+      nir_intrinsic_set_dest_type(io, widen_alu_type(type));
+      nir_def_rewrite_uses_after(&io->def, narrow_to_16(b, &io->def, type));
+   } else {
+      return false;
+   }
+
+   return true;
+}
+
+bool
+pco_nir_lower_16bit_io(nir_shader *nir)
+{
+   bool progress = false;
+
+   NIR_PASS(progress,
+            nir,
+            nir_shader_intrinsics_pass,
+            lower_16bit_io_instr,
+            nir_metadata_control_flow,
+            NULL);
+
+   nir_foreach_variable_with_modes (var, nir, nir_var_shader_in | nir_var_shader_out) {
+      if (!glsl_type_is_16bit(glsl_without_array_or_matrix(var->type)))
+         continue;
+
+      var->type = widen_16bit_type(var->type);
+      progress = true;
+   }
+
+   return progress;
+}
diff --git a/src/imagination/pco/pco_trans_nir.c b/src/imagination/pco/pco_trans_nir.c
index 6dde9d2..922bfd8 100644
--- a/src/imagination/pco/pco_trans_nir.c
+++ b/src/imagination/pco/pco_trans_nir.c
@@ -80,7 +80,22 @@ static void split_dest_comps(trans_ctx *tctx, pco_instr *instr, pco_ref dest)
  */
 static inline pco_ref pco_ref_nir_def(const nir_def *def)
 {
-   return pco_ref_ssa(def->index, def->bit_size, def->num_components);
+   unsigned bits = def->bit_size;
+   unsigned chans = def->num_components;
+
+   /* A 64-bit component is two 32-bit channels in this backend - see the 64-bit
+    * multiply cases, which build their result as a vector of two 32-bit
+    * registers - and this is the one place every NIR value is mapped to a
+    * reference, so doing it here is what keeps producers and consumers agreeing.
+    * Without it a 64-bit value stays one channel wide, so both halves of it
+    * resolve to the same dword.
+    */
+   if (bits == 64) {
+      bits = 32;
+      chans *= 2;
+   }
+
+   return pco_ref_ssa(def->index, bits, chans);
 }
 
 /**
@@ -4145,6 +4160,81 @@ static pco_instr *trans_alu(trans_ctx *tctx, nir_alu_instr *alu)
       instr = pco_mov(&tctx->b, dest, src[0]);
       break;
 
+   /* The two halves of a 64-bit value, which this backend holds as a pair of
+    * 32-bit channels (see pco_ref_nir_def). The component must be taken with
+    * pco_comp: a mov carrying an element modifier does not select a channel, so
+    * reading the high half that way returns the low half again - which is what
+    * a uint64_t push constant used to do.
+    *
+    * These are translated here rather than lowered away because the rewrite
+    * nir_opt_algebraic() applies instead - u2u32(ushr(a, 32)) - leaves a 64-bit
+    * shift behind, and nir_lower_int64() turns that straight back into this
+    * intrinsic. The two passes never converge (pco_nir_opt() gives up after 1000
+    * iterations), and the 64-bit shift then reaches trans_shift(), whose
+    * bits == 32 assert is compiled out in a release build.
+    */
+   case nir_op_unpack_64_2x32_split_x:
+      instr = pco_comp(&tctx->b, dest, src[0], pco_ref_val16(0));
+      break;
+
+   case nir_op_unpack_64_2x32_split_y:
+      instr = pco_comp(&tctx->b, dest, src[0], pco_ref_val16(1));
+      break;
+
+   case nir_op_pack_64_2x32_split:
+      instr = pco_trans_nir_vec(tctx, dest, 2, src);
+      break;
+
+   /* The two 16-bit halves of a 32-bit register. This backend holds every value
+    * in a 32-bit register, so a 16-bit half is a mask and a shift rather than a
+    * reinterpretation - the same shape as the 64-bit handling above, one size
+    * down. Both operands are masked on the way in because a 16-bit NIR value's
+    * upper bits are only defined by whatever produced it: the narrowing
+    * conversions in trans_conv() are plain movs, so `b << 16` would otherwise OR
+    * the second operand's leftovers into the result.
+    *
+    * These arrive from two directions and neither can be lowered away earlier.
+    * nir_opt_algebraic() forms them from f2f16 and from pairs of shifts, and the
+    * push-constant half of the 8/16-bit storage work produces them directly when
+    * it widens a 16-bit load and narrows it back.
+    */
+   case nir_op_pack_32_2x16_split: {
+      pco_ref mask = pco_ref_new_ssa32(tctx->func);
+      pco_ref lo = pco_ref_new_ssa32(tctx->func);
+      pco_ref shift = pco_ref_new_ssa32(tctx->func);
+      pco_ref hi = pco_ref_new_ssa32(tctx->func);
+
+      pco_movi32(&tctx->b, mask, pco_ref_imm32(0xffff));
+      trans_logical(tctx, nir_op_iand, lo, src[0], mask);
+
+      pco_movi32(&tctx->b, shift, pco_ref_imm32(16));
+      trans_shift(tctx, nir_op_ishl, hi, src[1], shift);
+
+      dest = pco_ref_bits(dest, 32);
+      instr = trans_logical(tctx, nir_op_ior, dest, lo, hi);
+      break;
+   }
+
+   case nir_op_unpack_32_2x16_split_x: {
+      pco_ref mask = pco_ref_new_ssa32(tctx->func);
+
+      pco_movi32(&tctx->b, mask, pco_ref_imm32(0xffff));
+
+      dest = pco_ref_bits(dest, 32);
+      instr = trans_logical(tctx, nir_op_iand, dest, src[0], mask);
+      break;
+   }
+
+   case nir_op_unpack_32_2x16_split_y: {
+      pco_ref shift = pco_ref_new_ssa32(tctx->func);
+
+      pco_movi32(&tctx->b, shift, pco_ref_imm32(16));
