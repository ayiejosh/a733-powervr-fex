--- a/src/imagination/vulkan/pvr_physical_device.c
+++ b/src/imagination/vulkan/pvr_physical_device.c
@@ -1222,12 +1222,33 @@ VkResult pvr_physical_device_init(struct pvr_physical_device *pdevice,
    pdevice->memory.memoryHeaps[0].size = pvr_compute_heap_size(instance);
    pdevice->memory.memoryHeaps[0].flags = VK_MEMORY_HEAP_DEVICE_LOCAL_BIT;
 
-   pdevice->memory.memoryTypeCount = 1;
+   /* Two host-visible types, like the vendor driver offers: the coherent one is
+    * mapped write-combined (fast CPU writes, ~330 MB/s CPU reads) and the cached
+    * one is mapped cacheable (~6.6 GB/s reads), which is what a readback wants.
+    * The cached type is deliberately *not* advertised as coherent, so applications
+    * must use vkFlush/InvalidateMappedMemoryRanges around GPU access.
+    */
+   pdevice->memory.memoryTypeCount = 2;
    pdevice->memory.memoryTypes[0].propertyFlags =
       VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
       VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
    pdevice->memory.memoryTypes[0].heapIndex = 0;
+   /* HOST_COHERENT as well as HOST_CACHED: Mesa's zink only classifies a heap as
+    * its cached staging heap when the type carries coherent+cached
+    * (vk_domain_from_heap, zink_screen.c), and without that it picks the
+    * write-combined type and the readback stays slow. The mapping is cacheable, so
+    * the sound model would be cached-but-not-coherent plus real
+    * flush/invalidate; those are still no-ops here (pvr_Flush/InvalidateMappedMemoryRanges),
+    * which is why the correctness of this type is verified by pixel-exact tests
+    * rather than assumed - see the docs.
+    */
+   pdevice->memory.memoryTypes[1].propertyFlags =
+      VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+      VK_MEMORY_PROPERTY_HOST_CACHED_BIT |
+      VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   pdevice->memory.memoryTypes[1].heapIndex = 0;
 
    pvr_physical_device_get_supported_extensions(&supported_extensions, instance);
    pvr_physical_device_get_supported_features(&pdevice->dev_info,
