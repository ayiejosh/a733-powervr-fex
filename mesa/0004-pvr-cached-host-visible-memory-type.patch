+			       DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS | \
+			       DRM_PVR_BO_CPU_CACHED)
 
 /**
  * struct drm_pvr_ioctl_create_bo_args - Arguments for %DRM_IOCTL_PVR_CREATE_BO
