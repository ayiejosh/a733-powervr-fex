@@ -9939,8 +9939,28 @@ void PVR_PER_ARCH(CmdWriteTimestamp2)(VkCommandBuffer commandBuffer,
    UNREACHABLE("Timestamp queries are not supported.");
 }
 
+extern uint64_t pvr_alloc_count, pvr_alloc_bytes;
+
 VkResult PVR_PER_ARCH(EndCommandBuffer)(VkCommandBuffer commandBuffer)
 {
+   /* Report what this command buffer allocated, for PVR_ALLOC_TRACE=1. A driver that
+    * allocates buffers per command buffer pays for them every frame. */
+   {
+      static uint64_t last_count, last_bytes;
+      static int last_frames;
+      extern uint64_t pvr_alloc_count, pvr_alloc_bytes;
+
+      if (getenv("PVR_ALLOC_TRACE")) {
+         uint64_t dcount = pvr_alloc_count - last_count;
+         uint64_t dbytes = pvr_alloc_bytes - last_bytes;
+         last_count = pvr_alloc_count;
+         last_bytes = pvr_alloc_bytes;
+         if (++last_frames <= 5 || last_frames % 50 == 0)
+            fprintf(stderr, "[alloc] command buffer %d: %llu bo(s), %llu KiB\n", last_frames,
+                    (unsigned long long)dcount, (unsigned long long)(dbytes / 1024));
+      }
+   }
+
    VK_FROM_HANDLE(pvr_cmd_buffer, cmd_buffer, commandBuffer);
    struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
    VkResult result;
