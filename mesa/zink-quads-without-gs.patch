diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index bc0cc58..5df0bf3 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -2902,7 +2902,17 @@ init_driver_workarounds(struct zink_screen *screen)
 
    if (zink_driverid(screen) ==
        VK_DRIVER_ID_IMAGINATION_PROPRIETARY) {
-      assert(screen->info.feats.features.geometryShader);
+      /* The blob advertises geometryShader but cannot execute one: asked to build
+       * a GS pipeline its shader compiler calls abort() (BILParseStream in
+       * libufwriter.so), which kills the process. zink only ever generates a GS
+       * itself - for GL_QUADS, quad strips, polygons, line stipple and smooth
+       * lines - so the feature is unusable in practice on this driver. Report it
+       * as absent so no GS is ever created, and let the primitives that needed it
+       * fall through to primconvert, which expands them to triangles on the CPU
+       * and still draws them on the GPU.
+       */
+      screen->info.feats.features.geometryShader = false;
+      screen->driver_workarounds.no_geometry_shader = true;
       screen->driver_workarounds.no_linesmooth = true;
    }
 
@@ -3454,11 +3464,11 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
       goto fail;
    }
 
-   if (zink_driverid(screen) == VK_DRIVER_ID_IMAGINATION_PROPRIETARY && !screen->info.feats.features.geometryShader) {
-      if (!screen->driver_name_is_inferred)
-         mesa_loge("zink: Imagination proprietary driver w/o geometryShader is unsupported");
-      goto fail;
-   }
+   /* There used to be a gate here refusing VK_DRIVER_ID_IMAGINATION_PROPRIETARY
+    * without geometryShader. That driver's GS is not usable (see
+    * init_driver_workarounds), so the feature is now forced off for it and the
+    * primitives that needed a GS are lowered by primconvert instead.
+    */
 
    if (zink_debug & ZINK_DEBUG_MEM) {
       simple_mtx_init(&screen->debug_mem_lock, mtx_plain);
