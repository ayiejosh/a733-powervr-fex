index 7284016..eb463ee 100644
--- a/src/gallium/drivers/zink/zink_draw.cpp
+++ b/src/gallium/drivers/zink/zink_draw.cpp
@@ -17,6 +17,7 @@
 #include "util/u_helpers.h"
 #include "util/u_inlines.h"
 #include "util/u_prim.h"
+#include "util/u_upload_mgr.h"
 #include "util/u_prim_restart.h"
 
 static void
@@ -941,6 +942,178 @@ zink_draw(struct pipe_context *pctx,
       pctx->flush(pctx, NULL, 0);
 }
 
+/* Wireframe emulation for drivers without fillModeNonSolid.
+ *
+ * Vulkan has no "draw these triangles as lines" other than polygonMode = LINE,
+ * which this driver does not implement. So each triangle's three edges are
+ * written out as an index buffer and the draw is reissued as a line list. The
+ * geometry still runs on the GPU; only index generation is on the CPU.
+ *
+ * Returns false for a non-triangle mode, so the caller falls through.
+ */
+static bool
+zink_expand_wireframe(struct zink_context *ctx,
+                      const struct pipe_draw_info *info,
+                      unsigned drawid_offset,
+                      const struct pipe_draw_start_count_bias *draws,
+                      unsigned num_draws)
+{
+   struct pipe_context *pctx = &ctx->base;
+
+   switch (info->mode) {
+   case MESA_PRIM_TRIANGLES:
+   case MESA_PRIM_TRIANGLE_STRIP:
+   case MESA_PRIM_TRIANGLE_FAN:
+      break;
+   default:
+      return false;
+   }
+
+   /* Transform feedback would capture the lines this generates rather than the
+    * triangles the app asked for, so leave the draw alone while it is active. */
+   if (ctx->num_so_targets)
+      return false;
+
+   unsigned total = 0;
+   for (unsigned i = 0; i < num_draws; i++) {
+      unsigned n = draws[i].count;
+      unsigned tris = info->mode == MESA_PRIM_TRIANGLES ? n / 3 : (n >= 3 ? n - 2 : 0);
+      total += tris * 6;
+   }
+   if (total == 0)
+      return true;   /* nothing to draw, and nothing to fall back to */
+
+   struct pipe_transfer *src_transfer = NULL;
+   const void *src = NULL;
+   if (info->index_size) {
+      if (info->has_user_indices)
+         src = info->index.user;
+      else
+         src = pipe_buffer_map(pctx, info->index.resource, PIPE_MAP_READ, &src_transfer);
+      if (!src)
+         return false;
+   }
+
+   /* Per-vertex edge flags, when the shader reads them. st/mesa appends the edge
+    * flag as the last vertex input, so it is the last element. An edge is drawn
+    * only when the flag of its first vertex is set. */
+   const uint8_t *ef = NULL;
+   unsigned ef_stride = 1;
+   struct pipe_transfer *ef_transfer = NULL;
+   if (ctx->gfx_stages[MESA_SHADER_VERTEX] && ctx->gfx_stages[MESA_SHADER_VERTEX]->has_edgeflags &&
+       ctx->element_state && ctx->element_state->num_elements) {
+      const struct pipe_vertex_element *el =
+         &ctx->element_state->elements[ctx->element_state->num_elements - 1];
+      const struct pipe_vertex_buffer *vb = &ctx->vertex_buffers[el->vertex_buffer_index];
+      const void *base = NULL;
+      if (vb->is_user_buffer)
+         base = vb->buffer.user;
+      else if (vb->buffer.resource)
+         base = pipe_buffer_map(pctx, vb->buffer.resource, PIPE_MAP_READ, &ef_transfer);
+      if (base) {
+         ef = (const uint8_t *)base + vb->buffer_offset + el->src_offset;
+         ef_stride = el->src_stride ? el->src_stride : 1;
+      }
+   }
+
+   struct pipe_resource *ib = NULL;
+   unsigned ib_offset = 0;
+   void *map = NULL;
+   u_upload_alloc(pctx->stream_uploader, 0, total * 4, 4, &ib_offset, &ib, &map);
+   uint32_t *dst = (uint32_t *)map;
+   if (!dst) {
+      if (src_transfer)
+         pipe_buffer_unmap(pctx, src_transfer);
+      return false;
+   }
+
+   auto idx_at = [&](unsigned d, unsigned k) -> uint32_t {
+      unsigned at = draws[d].start + k;
+      if (src == NULL) return at;
+      if (info->index_size == 4) return ((const uint32_t *)src)[at];
+      if (info->index_size == 2) return ((const uint16_t *)src)[at];
+      return ((const uint8_t *)src)[at];
+   };
+
+   unsigned w = 0;
+   auto emit_edge = [&](uint32_t a, uint32_t b) {
+      dst[w++] = a; dst[w++] = b;
+   };
+   auto emit = [&](uint32_t a, uint32_t b, uint32_t c) {
+      if (!ef) {
+         emit_edge(a, b);
+         emit_edge(b, c);
+         emit_edge(c, a);
+         return;
+      }
+      if (ef[a * ef_stride]) emit_edge(a, b);
+      if (ef[b * ef_stride]) emit_edge(b, c);
+      if (ef[c * ef_stride]) emit_edge(c, a);
+   };
+
+   for (unsigned i = 0; i < num_draws; i++) {
+      unsigned n = draws[i].count;
+
+      if (info->mode == MESA_PRIM_TRIANGLES) {
+         for (unsigned j = 0; j + 3 <= n; j += 3)
+            emit(idx_at(i, j), idx_at(i, j + 1), idx_at(i, j + 2));
+         continue;
+      }
+
+      /* Strips and fans walk their vertices, starting a new primitive at every
+       * restart index, so a restart never draws an edge across the break. */
+      uint32_t prev1 = 0, prev2 = 0, anchor = 0;
+      unsigned seg = 0;
+      for (unsigned j = 0; j < n; j++) {
+         uint32_t id = idx_at(i, j);
+         if (info->primitive_restart && id == info->restart_index) {
+            seg = 0;
+            continue;
+         }
+         if (info->mode == MESA_PRIM_TRIANGLE_STRIP) {
+            if (seg >= 2)
+               emit(prev2, prev1, id);
+            prev2 = prev1;
+            prev1 = id;
+         } else {
+            if (seg == 0)
+               anchor = id;
+            else if (seg >= 2)
+               emit(anchor, prev1, id);
+            prev1 = id;
+         }
+         seg++;
+      }
+   }
+   u_upload_unmap(pctx->stream_uploader);
+   if (src_transfer)
+      pipe_buffer_unmap(pctx, src_transfer);
+   if (ef_transfer)
+      pipe_buffer_unmap(pctx, ef_transfer);
+
+   struct pipe_draw_info linfo = {};
+   linfo.mode = MESA_PRIM_LINES;
+   linfo.index_size = 4;
+   linfo.index.resource = ib;
+   linfo.index_bounds_valid = false;
+   linfo.min_index = 0;
+   linfo.max_index = UINT32_MAX;
+   linfo.instance_count = info->instance_count;
+   linfo.start_instance = info->start_instance;
+   struct pipe_draw_start_count_bias ldraw = {};
+   /* u_upload_alloc hands back a byte offset into a shared buffer, so the draw
+    * has to start there rather than at index 0. */
+   ldraw.start = ib_offset / 4;
+   ldraw.count = w;
+
+   ctx->expanding_wireframe = true;
+   pctx->draw_vbo(pctx, &linfo, drawid_offset, NULL, &ldraw, 1);
+   ctx->expanding_wireframe = false;
+
+   pipe_resource_reference(&ib, NULL);
+   return true;
+}
+
 template <zink_multidraw HAS_MULTIDRAW, zink_dynamic_state DYNAMIC_STATE, bool BATCH_CHANGED>
 static void
 zink_draw_vbo(struct pipe_context *pctx,
@@ -950,6 +1123,31 @@ zink_draw_vbo(struct pipe_context *pctx,
               const struct pipe_draw_start_count_bias *draws,
               unsigned num_draws)
 {
+   /* No fillModeNonSolid on this driver: expand a wireframe draw into an indexed
+    * line list rather than hand it a polygon mode the driver ignores. */
+   struct zink_context *ctx = zink_context(pctx);
+   if (!ctx->expanding_wireframe && ctx->rast_state &&
+       ctx->rast_state->base.fill_front == PIPE_POLYGON_MODE_LINE &&
+       zink_screen(pctx->screen)->driver_workarounds.no_hw_gl_wireframe) {
+      if (zink_expand_wireframe(ctx, info, drawid_offset, draws, num_draws))
+         return;
+   }
+
+   /* Polygon point mode: the vertex stream is already the polygon's vertices, so
+    * only the topology is wrong. This needs the vertex shader to write
+    * gl_PointSize - the driver has largePoints and takes the size from there -
+    * and st/mesa now exports it whenever the polygon mode is POINT. */
+   if (!ctx->expanding_wireframe && ctx->rast_state && ctx->num_so_targets == 0 &&
+       ctx->rast_state->base.fill_front == PIPE_POLYGON_MODE_POINT &&
+       zink_screen(pctx->screen)->driver_workarounds.no_hw_gl_point) {
+      struct pipe_draw_info pinfo = *info;
+      pinfo.mode = MESA_PRIM_POINTS;
+      ctx->expanding_wireframe = true;
+      pctx->draw_vbo(pctx, &pinfo, drawid_offset, indirect, draws, num_draws);
+      ctx->expanding_wireframe = false;
+      return;
+   }
+
    zink_draw<HAS_MULTIDRAW, DYNAMIC_STATE, BATCH_CHANGED, false>(pctx, info, drawid_offset, indirect, draws, num_draws, NULL, 0);
 }
 
