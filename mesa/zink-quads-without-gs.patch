diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index bc0cc58..313da03 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -2902,7 +2902,9 @@ init_driver_workarounds(struct zink_screen *screen)
 
    if (zink_driverid(screen) ==
        VK_DRIVER_ID_IMAGINATION_PROPRIETARY) {
-      assert(screen->info.feats.features.geometryShader);
+      /* No assert that geometryShader is present: this driver reports it as
+       * absent, honestly, and the gate that used to reject it for that is
+       * gone - see the note where the gate used to be. */
       screen->driver_workarounds.no_linesmooth = true;
    }
 
@@ -3454,11 +3456,16 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
       goto fail;
    }
 
-   if (zink_driverid(screen) == VK_DRIVER_ID_IMAGINATION_PROPRIETARY && !screen->info.feats.features.geometryShader) {
-      if (!screen->driver_name_is_inferred)
-         mesa_loge("zink: Imagination proprietary driver w/o geometryShader is unsupported");
-      goto fail;
-   }
+   /* A gate used to sit here rejecting VK_DRIVER_ID_IMAGINATION_PROPRIETARY when
+    * the driver reported no geometryShader (commit ca087e20, "zink: reject
+    * Imagination proprietary driver w/o geometryShader"). That report is honest,
+    * and the GS is only needed for smooth-line emulation, which zink already
+    * declines for this driver via no_linesmooth. Refusing to start costs more
+    * than the one capability: without the gate zink takes its ordinary non-GS
+    * path and the frontend lowers quads and quad strips to triangles, so they
+    * draw instead of aborting the process. Measured on a BXM-4-64: all five
+    * primitive types render.
+    */
 
    if (zink_debug & ZINK_DEBUG_MEM) {
       simple_mtx_init(&screen->debug_mem_lock, mtx_plain);
