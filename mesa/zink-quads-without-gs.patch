 }
 
+/* Wireframe emulation for drivers without fillModeNonSolid.
+ *
+ * Vulkan has no "draw these triangles as lines" other than polygonMode = LINE,
+ * which this driver does not implement. So each triangle's three edges are
+ * written out as an index buffer and the draw is reissued as a line list. The
+ * geometry still runs on the GPU; only index generation is on the CPU.
+ *
+ * Returns false for a non-triangle mode, so the caller falls through.
+ */
+static bool
+zink_expand_wireframe(struct zink_context *ctx,
+                      const struct pipe_draw_info *info,
+                      unsigned drawid_offset,
+                      const struct pipe_draw_start_count_bias *draws,
+                      unsigned num_draws)
+{
+   struct pipe_context *pctx = &ctx->base;
+   unsigned step;
+   switch (info->mode) {
+   case MESA_PRIM_TRIANGLES:      step = 3; break;
+   case MESA_PRIM_TRIANGLE_STRIP: step = 1; break;
+   case MESA_PRIM_TRIANGLE_FAN:   step = 1; break;
+   default:
+      return false;
+   }
+
+   unsigned total = 0;
+   for (unsigned i = 0; i < num_draws; i++) {
+      unsigned n = draws[i].count;
+      unsigned tris = step == 3 ? n / 3 : (n >= 3 ? n - 2 : 0);
+      total += tris * 6;
+   }
+   if (total == 0)
+      return true;   /* nothing to draw, and nothing to fall back to */
+
+   struct pipe_transfer *src_transfer = NULL;
+   const void *src = NULL;
+   if (info->index_size) {
+      if (info->has_user_indices)
+         src = info->index.user;
+      else
+         src = pipe_buffer_map(pctx, info->index.resource, PIPE_MAP_READ, &src_transfer);
+      if (!src)
+         return false;
+   }
+
+   struct pipe_resource *ib = NULL;
+   unsigned ib_offset = 0;
+   void *map = NULL;
+   u_upload_alloc(pctx->stream_uploader, 0, total * 4, 4, &ib_offset, &ib, &map);
+   uint32_t *dst = (uint32_t *)map;
+   if (!dst) {
+      if (src_transfer)
+         pipe_buffer_unmap(pctx, src_transfer);
+      return false;
+   }
+
+   unsigned w = 0;
+   for (unsigned i = 0; i < num_draws; i++) {
+      unsigned n = draws[i].count;
+      for (unsigned j = 0; j + 3 <= n; j += step) {
+         /* a fan's triangles all share vertex 0; a strip's slide by one */
+         unsigned v[3] = { info->mode == MESA_PRIM_TRIANGLE_FAN ? 0u : j, j + 1, j + 2 };
+         uint32_t idx[3];
+         for (unsigned k = 0; k < 3; k++) {
+            unsigned at = draws[i].start + v[k];
+            if (src == NULL)
+               idx[k] = at;
+            else if (info->index_size == 4)
+               idx[k] = ((const uint32_t *)src)[at];
+            else if (info->index_size == 2)
+               idx[k] = ((const uint16_t *)src)[at];
+            else
+               idx[k] = ((const uint8_t *)src)[at];
+         }
+         dst[w++] = idx[0]; dst[w++] = idx[1];
+         dst[w++] = idx[1]; dst[w++] = idx[2];
+         dst[w++] = idx[2]; dst[w++] = idx[0];
+      }
+   }
+   u_upload_unmap(pctx->stream_uploader);
+   if (src_transfer)
+      pipe_buffer_unmap(pctx, src_transfer);
+
+   struct pipe_draw_info linfo = {};
+   linfo.mode = MESA_PRIM_LINES;
+   linfo.index_size = 4;
+   linfo.index.resource = ib;
+   linfo.index_bounds_valid = false;
+   linfo.min_index = 0;
+   linfo.max_index = UINT32_MAX;
+   linfo.instance_count = info->instance_count;
+   linfo.start_instance = info->start_instance;
+   struct pipe_draw_start_count_bias ldraw = {};
+   /* u_upload_alloc hands back a byte offset into a shared buffer, so the draw
+    * has to start there rather than at index 0. */
+   ldraw.start = ib_offset / 4;
+   ldraw.count = w;
+
+   ctx->expanding_wireframe = true;
+   pctx->draw_vbo(pctx, &linfo, drawid_offset, NULL, &ldraw, 1);
+   ctx->expanding_wireframe = false;
+
+   pipe_resource_reference(&ib, NULL);
+   return true;
+}
+
 template <zink_multidraw HAS_MULTIDRAW, zink_dynamic_state DYNAMIC_STATE, bool BATCH_CHANGED>
 static void
 zink_draw_vbo(struct pipe_context *pctx,
@@ -950,6 +1058,16 @@ zink_draw_vbo(struct pipe_context *pctx,
               const struct pipe_draw_start_count_bias *draws,
               unsigned num_draws)
 {
+   /* No fillModeNonSolid on this driver: expand a wireframe draw into an indexed
+    * line list rather than hand it a polygon mode the driver ignores. */
+   struct zink_context *ctx = zink_context(pctx);
+   if (!ctx->expanding_wireframe && ctx->rast_state &&
+       ctx->rast_state->base.fill_front == PIPE_POLYGON_MODE_LINE &&
+       zink_screen(pctx->screen)->driver_workarounds.no_hw_gl_wireframe) {
+      if (zink_expand_wireframe(ctx, info, drawid_offset, draws, num_draws))
+         return;
+   }
+
    zink_draw<HAS_MULTIDRAW, DYNAMIC_STATE, BATCH_CHANGED, false>(pctx, info, drawid_offset, indirect, draws, num_draws, NULL, 0);
 }
 
