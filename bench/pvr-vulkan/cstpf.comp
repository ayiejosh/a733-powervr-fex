#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { float v[]; } outb;
layout(push_constant) uniform PC { uint n; } pc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    /* FLOAT version of cstp: same integer work first, then a float ALU chain of the
     * same shape as vkalu - so float-compute can be compared with integer-compute. */
    uint x = i * 2654435761u;
    x ^= x >> 13; x *= 2246822519u; x ^= x >> 15;
    float f = float(x) * 1e-9 + float(pc.n) * 1e-9;
    for (int k = 0; k < 32; k++) {
        f = f * 1.0001 + 0.001;
        f = min(f, 1.0);
        f = max(f, 0.0);
        f = fract(f + f);
    }
    outb.v[i & 0xFFFFu] = f;
}
