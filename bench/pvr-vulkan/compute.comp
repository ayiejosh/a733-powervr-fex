#version 450
// GPU-side work for the PowerVR Vulkan test: a per-element xorshift the host can
// predict exactly, so a wrong result is a real mismatch, not a fuzzy comparison.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer Data {
    uint out_data[];
} d;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint x = i;
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    d.out_data[i] = x + 1u;
}
