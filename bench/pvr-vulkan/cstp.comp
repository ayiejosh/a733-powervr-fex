#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { uint v[]; } outb;
layout(push_constant) uniform PC { uint n; } pc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    /* A few dependent ALU ops per invocation, then one store: the compute analogue of a fill. */
    uint x = i * 2654435761u;
    x ^= x >> 13; x *= 2246822519u; x ^= x >> 15;
    x += pc.n;
    outb.v[i & 0xFFFFu] = x;
}
