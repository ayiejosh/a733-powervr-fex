#version 450
layout(local_size_x = 1) in;
layout(binding = 0) uniform sampler2D tex[NSAMP];
layout(std430, binding = 1) buffer Out { uint v[]; };
void main() {
    /* Constant trip count so each index is a constant -> sampler array indexable. */
    for (int i = 0; i < NSAMP; ++i) {
        vec4 c = texture(tex[i], vec2(0.5));
        v[i] = uint(c.r * 255.0 + 0.5) | (uint(c.g * 255.0 + 0.5) << 8) |
               (uint(c.b * 255.0 + 0.5) << 16) | (uint(c.a * 255.0 + 0.5) << 24);
    }
}
