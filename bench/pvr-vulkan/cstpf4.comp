#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { float v[]; } outb;
layout(push_constant) uniform PC { uint n; } pc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint x = i * 2654435761u;
    x ^= x >> 13; x *= 2246822519u; x ^= x >> 15;
    /* FOUR INDEPENDENT float chains - same op count as cstpf but no carried
     * dependency, so this is throughput-bound rather than latency-bound. */
    float a = float(x) * 1e-9 + float(pc.n) * 1e-9;
    float b = a + 0.1, c = a + 0.2, d = a + 0.3;
    for (int k = 0; k < 32; k++) {
        a = fract(min(max(a * 1.0001 + 0.001, 0.0), 1.0) + a);
        b = fract(min(max(b * 1.0001 + 0.001, 0.0), 1.0) + b);
        c = fract(min(max(c * 1.0001 + 0.001, 0.0), 1.0) + c);
        d = fract(min(max(d * 1.0001 + 0.001, 0.0), 1.0) + d);
    }
    outb.v[i & 0xFFFFu] = a + b + c + d;
}
