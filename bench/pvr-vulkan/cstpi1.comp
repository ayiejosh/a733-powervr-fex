#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { uint v[]; } outb;
layout(push_constant) uniform PC { uint n; } pc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    /* Same 32-iteration loop and same 4 ops per iteration as cstpi, but every
     * operation uses the SAME single register operand - minimum distinct operands. */
    uint x = i * 2654435761u + pc.n;
    uint a = pc.n | 1u;
    for (int k = 0; k < 32; k++) {
        x = x * a;
        x = x + a;
        x = x ^ a;
        x = x | a;
    }
    outb.v[i & 0xFFFFu] = x;
}
