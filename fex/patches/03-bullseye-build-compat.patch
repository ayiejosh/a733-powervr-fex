diff --git a/Data/CMake/toolchain_x86_64.cmake b/Data/CMake/toolchain_x86_64.cmake
index 9aa856a..a5381c3 100644
--- a/Data/CMake/toolchain_x86_64.cmake
+++ b/Data/CMake/toolchain_x86_64.cmake
@@ -12,6 +12,15 @@ if (ENABLE_CLANG_THUNKS)
   set(CMAKE_CXX_COMPILER clang++)
   set(CLANG_FLAGS "-target x86_64-linux-gnu")
 
+  # Cross-compiling from a non-x86 host: point clang at the x86 sysroot + its gcc
+  # (for the C runtime crt*.o, libgcc, libc). X86_DEV_ROOTFS is passed by the parent build.
+  if (X86_DEV_ROOTFS AND NOT X86_DEV_ROOTFS STREQUAL "/")
+    set(CLANG_FLAGS "${CLANG_FLAGS} --sysroot=${X86_DEV_ROOTFS} --gcc-toolchain=${X86_DEV_ROOTFS}/usr")
+    set(CMAKE_EXE_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT} --sysroot=${X86_DEV_ROOTFS}")
+    set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_SHARED_LINKER_FLAGS_INIT} --sysroot=${X86_DEV_ROOTFS}")
+    set(CMAKE_MODULE_LINKER_FLAGS_INIT "${CMAKE_MODULE_LINKER_FLAGS_INIT} --sysroot=${X86_DEV_ROOTFS}")
+  endif()
+
   set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${CLANG_FLAGS}")
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${CLANG_FLAGS}")
 else()
