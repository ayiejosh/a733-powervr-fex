+// On-demand JIT-context reuse: hand out a cleared LookupCache from the pool if one is
+// available, else allocate fresh. Pooled caches are always cleared (empty) on release, so
+// reuse carries no stale mappings; the per-thread Shared pointer + L1/L2 CPUState pointers
+// are (re)wired by the normal thread-init path below, identically to a fresh cache.
+FEXCore::LookupCache* ContextImpl::AcquirePooledLookupCache() {
+  std::scoped_lock lk {LookupCachePoolLock};
+  if (!LookupCachePool.empty()) {
+    FEXCore::LookupCache* Cache = LookupCachePool.back();
+    LookupCachePool.pop_back();
+    return Cache;
+  }
+  return nullptr;
+}
+
+void ContextImpl::ReleaseLookupCacheToPool(FEXCore::LookupCache* Cache) {
+  std::scoped_lock lk {LookupCachePoolLock};
+  LookupCachePool.emplace_back(Cache);
+}
+
+void ContextImpl::DrainLookupCachePool() {
+  std::scoped_lock lk {LookupCachePoolLock};
+  for (FEXCore::LookupCache* Cache : LookupCachePool) {
+    fextl::default_delete<FEXCore::LookupCache> {}(Cache);
+  }
+  LookupCachePool.clear();
+}
