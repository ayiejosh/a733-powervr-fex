+
+// Acquire a per-thread signal alt-stack (SIGSTKSZ*16): reuse one from the pool or mmap fresh.
+// Returns a region whose FIRST page is writable (the caller writes the thread ptr there, then
+// re-protects it read-only). A pooled region's first page was left read-only, so re-open it.
+void* SignalDelegator::AcquireAltStack() {
+  {
+    std::scoped_lock lk {AltStackPoolLock};
+    if (!AltStackPool.empty()) {
+      void* Ptr = AltStackPool.back();
+      AltStackPool.pop_back();
+      ::mprotect(Ptr, FEXCore::Utils::FEX_PAGE_SIZE, PROT_READ | PROT_WRITE);
+      return Ptr;
+    }
+  }
+  void* Ptr = FEXCore::Allocator::mmap(nullptr, SIGSTKSZ * 16, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  FEXCore::Allocator::VirtualName("FEXMem_Misc", Ptr, SIGSTKSZ * 16);
+  return Ptr;
+}
+
+void SignalDelegator::ReleaseAltStack(void* Ptr) {
+  // No clear: the alt-stack is only used during signal handling, which resets its SP each entry.
+  std::scoped_lock lk {AltStackPoolLock};
+  AltStackPool.emplace_back(Ptr);
+}
+
+void SignalDelegator::DrainAltStackPool() {
+  std::scoped_lock lk {AltStackPoolLock};
+  for (void* Ptr : AltStackPool) {
+    FEXCore::Allocator::munmap(Ptr, SIGSTKSZ * 16);
+  }
+  AltStackPool.clear();
 }
 
