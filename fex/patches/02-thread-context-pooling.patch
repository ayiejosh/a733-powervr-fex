+  void ClearThreadLocalForPooling() {
+    // Precise clear: zero exactly the L2 page-pointer entries this thread set (tracked in
+    // TouchedL2Indices), then DONTNEED only the block-backing actually allocated and the live
+    // L1 slots. Cost scales with the thread's working set, not with VirtualMemSize.
+    // Correctness: TouchedL2Indices lists every page-pointer entry that was set (the sole set
+    // site is the new-backing allocation below); zeroing them + zeroing the block region +
+    // zeroing L1 makes every subsequent lookup miss and re-resolve from the shared map, so no
+    // stale guest->host mapping can survive into the next thread that reuses this cache.
+    // madvise(DONTNEED) requires page alignment, so sizes are rounded up (block region and L1
+    // both start page-aligned; over-clearing already-zero pages is safe).
+    constexpr size_t PageSize = FEXCore::Utils::FEX_PAGE_SIZE;
+    if (!TouchedL2Indices.empty()) {
+      uintptr_t* Pointers = reinterpret_cast<uintptr_t*>(PagePointer);
+      for (uint32_t Idx : TouchedL2Indices) {
+        Pointers[Idx] = 0;
+      }
+      TouchedL2Indices.clear();
+    }
+    // Note: we do NOT zero the block-backing region or reset AllocateOffset. Once the L2 entries
+    // above are zeroed, the old block pages are unreferenced; the next thread allocates FRESH
+    // (already-zero) pages beyond the current high-water mark, so no stale block data is ever
+    // read. AllocateOffset keeps climbing across reuses until the existing overflow path
+    // (AllocateBackingForPage -> ClearL2Cache) resets it. This avoids an O(working-set) madvise
+    // over the block region on every thread exit, which dominated the release cost.
+    // Decommit the currently-active L1 region, then reset dynamic L1 sizing back to MIN. Without
+    // this reset, CurrentL1Entries carries over on reuse and ratchets up to MAX (16MB) across many
+    // pooled reuses, making every release clear a 16MB region. Resetting keeps it small so the
+    // clear stays cheap; a reused thread re-grows L1 on demand if it actually needs it.
+    // Reset dynamic L1 sizing to MIN first (breaks the ratchet-to-MAX across reuses). If this
+    // thread had grown L1 beyond MIN, decommit the now-unreachable upper region to reclaim it;
+    // for the common case (never grew) this madvise is skipped entirely.
+    const size_t OldL1Bytes = CurrentL1Entries * sizeof(LookupCacheEntry);
+    if (DynamicL1Cache()) {
+      CurrentL1Entries = MIN_L1_ENTRIES;
+      L1PointerMask = MIN_L1_ENTRIES - 1;
+    }
+    const size_t ActiveL1Bytes = CurrentL1Entries * sizeof(LookupCacheEntry);
+    if (OldL1Bytes > ActiveL1Bytes) {
+      FEXCore::Allocator::VirtualDontNeed(reinterpret_cast<void*>(L1Pointer + ActiveL1Bytes),
+                                          FEXCore::AlignUp(OldL1Bytes - ActiveL1Bytes, PageSize), false);
+    }
+    // Clear the (small) active L1 region with memset: no syscall, stays resident for reuse.
+    memset(reinterpret_cast<void*>(L1Pointer), 0, ActiveL1Bytes);
+    CachedCodePages.clear();
+  }
